return function(t, H)
	local BrowserHistory = H.server("Race/BrowserHistory")

	t.test("back/forward follow browser semantics", function()
		local history = BrowserHistory.new("a")
		history:push("b")
		history:push("c")
		history:push("d")
		t.eq(history:current(), "d")
		t.eq(history:back(), "c", "back 1")
		t.eq(history:back(), "b", "back 2")
		t.eq(history:forward(), "c", "forward 1")
		t.eq(history:forward(), "d", "forward 2")
		t.eq(history:forward(), nil, "no more forward")
	end)

	t.test("new navigation after going back clears forward history", function()
		local history = BrowserHistory.new("a")
		history:push("b")
		history:push("c")
		history:push("d")
		history:back()
		history:back()
		history:push("x")
		t.eq(history:current(), "x")
		t.ok(not history:canForward(), "forward cleared")
		t.eq(history:back(), "b")
		t.eq(history:back(), "a")
		t.ok(not history:canBack(), "at start")
	end)

	t.test("recent list is unique and most-recent-first", function()
		local history = BrowserHistory.new("a")
		history:push("b")
		history:push("a")
		local recent = history:recentList()
		t.eq(recent[1], "a")
		t.eq(recent[2], "b")
		t.eq(#recent, 2)
	end)
end
