	{
		title = "Henri Matisse",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "French artist (1869–1954)",
		tags = { "Western painters and illustrators", "Modern era" },
		aliases = { "Henri Émile Benoît Matisse" },
		summary = "**Henri Émile Benoît Matisse** was a French [[Visual arts|visual artist]], known for both his use of colour and his fluid and original draughtsmanship. He was a [[Drawing|draughtsman]], [[Printmaking|printmaker]], and [[Sculpture|sculptor]], but is known primarily as a painter.",
		sections = {
			{
				"Overview",
				'Matisse is commonly regarded, along with [[Pablo Picasso]], as one of the artists who best helped to define the revolutionary developments in the visual arts throughout the opening decades of the twentieth century, responsible for significant developments in painting and sculpture. The intensity of colour in the works he painted between 1900 and 1905 brought him notoriety as one of the [[Fauvism|Fauves]] ([[French language|French]] for "wild beasts"). Many of his finest works were created in the decade or so after 1906, when he developed a rigorous style that emphasized flattened forms and decorative pattern. In 1917, he relocated to a suburb of [[Nice]] on the French Riviera, and the more relaxed style of his work during the 1920s gained him critical acclaim as an upholder of the classical tradition in French painting. After 1930, he adopted a bolder simplification of form.',
			},
		},
		related = { "Edvard Munch", "Ilya Repin", "Marc Chagall" },
		infobox = {
			{ "Born", "31 December 1869" },
			{ "Birthplace", "Le Cateau-Cambrésis, France" },
			{ "Died", "3 November 1954" },
			{ "Movement", "[[Fauvism]], [[Modernism]], [[Post-Impressionism]]" },
			{ "Field", "Painting, [[Printmaking|printmaking]], sculpture, drawing, [[Collage|collage]]" },
		},
	},
	{
		title = "Henri Poincaré",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French mathematician, physicist and engineer (1854–1912)",
		tags = { "Mathematicians", "Modern" },
		aliases = { "Jules Henri Poincaré" },
		summary = '**Jules Henri Poincaré** was a French [[Mathematician|mathematician]], [[Theoretical physics|theoretical physicist]], engineer, and [[Philosophy of science|philosopher of science]]. He is often described as a [[Polymath|polymath]], and in mathematics as "The Last Universalist", since he excelled in all fields of the discipline as it existed during his lifetime. He has further been called "the [[Carl Friedrich Gauss|Gauss]] of [[History of mathematics|modern mathematics]]". Due to his success in science, along with his influence in philosophy, he has also been called "the philosopher par excellence of modern science".',
		sections = {
			{
				"Overview",
				"As a mathematician and [[Physicist|physicist]], he made many original fundamental contributions to [[Pure mathematics|pure]] and [[Applied mathematics|applied mathematics]], [[Mathematical physics|mathematical physics]], and [[Celestial mechanics|celestial mechanics]]. In his research on the three-body problem, Poincaré became the first person to discover a chaotic deterministic system which laid the foundations of modern [[Chaos theory|chaos theory]]. Poincaré is regarded as the creator of the field of [[Algebraic topology|algebraic topology]], and is further credited with introducing automorphic forms. He also made important contributions to [[Algebraic geometry|algebraic geometry]], [[Number theory|number theory]], [[Complex analysis|complex analysis]] and Lie theory. He famously introduced the concept of the Poincaré recurrence theorem, which states that a state will eventually return arbitrarily close to its initial state after a sufficiently long time, which has far-reaching consequences.",
			},
		},
		infobox = {
			{ "Born", "29 April 1854" },
			{ "Birthplace", "Nancy, Meurthe-et-Moselle, France" },
			{ "Died", "17 July 1912" },
			{ "Fields", "Mathematics [[Physics|physics]]" },
			{
				"Worked at",
				"Corps des Mines Caen University [[University of Paris|La Sorbonne]] Bureau des Longitudes",
			},
			{ "Teacher", "[[Charles Hermite]]" },
		},
	},
	{
		title = "Henri Rousseau",
		category = "Person",
