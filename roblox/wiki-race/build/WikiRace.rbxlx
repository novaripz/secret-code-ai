	{
		title = "One Thousand and One Nights",
		category = "Book",
		fame = 2,
		emoji = "🌙",
		source = "wikipedia",
		description = "Collection of Middle Eastern folk tales",
		tags = { "Specific works of fiction", "Fiction of antiquity" },
		aliases = { "The Thousand and One Nights" },
		summary = "**One Thousand and One Nights** or **The Thousand and One Nights** is a collection of [[History of the Middle East|Middle Eastern]] folktales compiled in the Arabic language during the [[Islamic Golden Age]]. It is often known in English as **The Arabian Nights**, from the first English-language edition (c. 1706–1721), which rendered the title as **The Arabian Nights' Entertainments**.",
		sections = {
			{
				"Overview",
				"The work was collected over many centuries by various authors, translators, and scholars across [[West Asia]], [[Central Asia]], [[South Asia]], and [[North Africa]]. Some tales trace their roots back to ancient and medieval [[Arabic literature|Arabic]], [[Persian literature|Persian]], and Mesopotamian literature. Most tales, however, were originally folk stories from the [[Abbasid Caliphate|Abbasid]] and [[Mamluk Sultanate|Mamluk eras]], while others, especially the frame story, are probably drawn from the Pahlavi Persian work Hezār Afsān, which in turn relied partly on [[Indian literature|Indian elements]]. If there was ever a canonical text with all the stories in a specific order, that text is no longer extant. But remaining editions of the Nights have some things in common, including the story's framing device. In the frame story, the ruler Shahryar is told the tales by his wife Scheherazade, with one tale told over each night of storytelling.",
			},
		},
		related = { "Candide", "Gulliver's Travels" },
		infobox = {
			{ "Language", "[[Classical Arabic|Arabic]]" },
			{ "Genre", "Frame story, [[Folklore|folklore]]" },
			{ "Setting", "[[Middle Ages]]" },
		},
	},
