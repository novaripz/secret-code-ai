	{
		title = "Nail (fastener)",
		category = "Invention",
		fame = 3,
		emoji = "💡",
		source = "wikipedia",
		description = "Sharp object of hard metal used as a fastener",
		tags = { "Machinery and tools", "Components" },
		aliases = { "Nail" },
		summary = 'In [[Woodworking|woodworking]] and [[Construction|construction]], a **nail** is a small object made of [[Metal|metal]] (or wood, called a tree nail or "trunnel") which is used as a [[Fastener|fastener]], as a peg to hang something, or sometimes as a decoration. Usually, nails have a sharp point on one end and a flattened head on the other, but headless nails are available. Nails are made in a great variety of forms for specialized purposes. The most common is a wire nail. Other types of nails include pins, tacks, brads, spikes, and cleats.',
		sections = {
