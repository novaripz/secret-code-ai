		description = "Geographic and climate zone",
		tags = { "More articles" },
		aliases = { "Subtropical zones", "Subtropical" },
		summary = "The **subtropical zones** or **subtropics** are geographical and [[Köppen climate classification|climate zones]] immediately to the [[Northern Hemisphere|north]] and [[Southern Hemisphere|south]] of the [[Tropics|tropics]]. The horse latitudes lie within this range.",
		sections = {
			{
				"Overview",
				"Subtropical climates are often characterized by hot summers and mild winters with infrequent frost. Most subtropical climates fall into two basic types: [[Humid subtropical climate|humid subtropical]] ([[Köppen climate classification]]: Cfa/Cwa), where rainfall is often concentrated in the warmest months, for example Southeast China and the [[Southeastern United States]], and [[Mediterranean climate|dry summer]] or [[Mediterranean climate]] ([[Köppen climate classification]]: Csa/Csb), where seasonal rainfall is concentrated in the cooler months, such as the [[Mediterranean basin|Mediterranean Basin]] or [[California]]. Subtropical climates can also occur at high elevations within the [[Tropics|tropics]], such as in the southern end of the Mexican Plateau and in Da Lat of the Vietnamese Central Highlands. The six climate classifications use the term to help define the various [[Temperature|temperature]] and [[Precipitation|precipitation]] regimes for planet [[Earth]].",
			},
		},
	},
