		category = "Concept",
		fame = 3,
		emoji = "🗣️",
		source = "wikipedia",
		description = "Mande language",
		tags = { "More articles" },
		aliases = { "Mandingo" },
		summary = "The **Mandinka language** (Mandinka kaŋo; Ajami: ), also known as **Mandingo**, is a Mande language spoken by the [[Mandinka people]] of northern [[Guinea-Bissau]], the Casamance region of [[Senegal]], and [[The Gambia]], where it is one of the principal languages.",
