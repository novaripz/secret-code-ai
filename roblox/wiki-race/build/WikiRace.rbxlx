		tags = { "More articles" },
		aliases = { "Before the Common Era", "BCE" },
		summary = '**Common Era** (**CE**) and **Before the Common Era** (**BCE**) are conventions used in the [[Gregorian calendar|Gregorian]] or [[Julian calendar]] to specify whether the year is before or after the epoch. They correspond exactly to [[Anno Domini|Anno Domini (AD) and Before Christ (BC)]]: "2026 CE" is the same year as "AD 2026", as are "400 BCE" and "400 BC". BCE/CE are used to avoid religious associations by not referring to Jesus as (\'Lord\').',
		related = { "Pliny the Younger" },
