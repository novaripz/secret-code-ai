				"[[Kandahar]] (1747–1776), [[Kabul]] (1776–1823), [[Peshawar]] (1776–1823), [[Herat]] (1793–1863)",
			},
			{ "Official languages", "[[Pashto]] (1747–1776), [[Dari|Persian]] (1776–1823)" },
			{ "Government", "Confederal [[Elective monarchy|elective monarchy]]" },
			{ "Area", "2,000,000 km²" },
		},
