		fame = 2,
		emoji = "🎆",
		source = "wikipedia",
		description = "American stock exchange",
		tags = { "Business and economics" },
		aliases = { "NYSE", "The Big Board" },
		summary = 'The **New York Stock Exchange** (**NYSE**, nicknamed "**the Big Board**") is an American [[Stock exchange|stock exchange]] headquartered at the New York Stock Exchange Building in the Financial District of Lower Manhattan in [[New York City]]. It is the largest stock exchange in the world by [[Market capitalization|market capitalization]], exceeding $44 trillion in January 2026. The NYSE is owned by Intercontinental Exchange, an American [[Holding company|holding company]] that it also lists (ticker symbol ICE). Previously, it was part of NYSE Euronext (NYX), which was formed by the NYSE\'s 2007 merger with Euronext. __FORCETOC__',
