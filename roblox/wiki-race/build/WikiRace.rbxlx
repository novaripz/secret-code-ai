	{
		title = "Milkfish",
		category = "Animal",
		fame = 3,
		emoji = "🐟",
		source = "wikipedia",
		description = "Species of fish",
		tags = { "Vertebrates", "Fishes" },
		aliases = { "Chanos chanos" },
		summary = "The **milkfish** (**Chanos chanos**) is a widespread species of [[Actinopterygii|ray-finned fish]] found throughout the [[Indo-Pacific]]. It is the sole living [[Species|species]] in the [[Family (taxonomy)|family]] Chanidae, and the only living member of the genus **Chanos**. The repeating scientific name (tautonym) is from Greek khanos. They are grouped in the order Gonorhynchiformes and are most closely related to the Ostariophysi—freshwater fishes such as carps, [[Catfish|catfish]], and loaches.",
		sections = {
			{
				"Overview",
				"The species has many common names. The Hawaiian name for the fish is awa, and in Tahitian it is ava. It is called bangús in the [[Philippines]], where it is popularly known as the national fish, although the National Commission for Culture and the Arts has stated that this is not the case as it has no basis in Philippine law. In the Nauruan language, it is referred to as ibiya. Milkfish is also called bandeng or bolu in [[Indonesia]].",
			},
