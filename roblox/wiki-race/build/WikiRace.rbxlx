		fame = 3,
		emoji = "💭",
		source = "wikipedia",
		description = "German zoologist (1801–1858)",
		tags = { "More articles" },
		summary = "**Johannes Peter Müller** (14 July 1801 – 28 April 1858) was a German physiologist, comparative anatomist, ichthyologist, and herpetologist, known not only for his discoveries but also for his ability to synthesize knowledge. The paramesonephric duct (Müllerian duct) was named in his honor.",
