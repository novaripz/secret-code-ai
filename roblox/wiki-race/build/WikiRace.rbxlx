	{
		title = "Liquorice",
		category = "Plant",
		fame = 3,
		emoji = "🌿",
		source = "wikipedia",
		description = "Root of Glycyrrhiza glabra",
		tags = { "Eudicots", "Fabales" },
		aliases = { "Licorice", "Glycyrrhiza glabra" },
		summary = "**Liquorice** ([[English in the Commonwealth of Nations|Commonwealth English]]) or **licorice** is the [[Common name|common name]] of **Glycyrrhiza glabra**, a [[Flowering plant|flowering plant]] of the bean family [[Fabaceae]], from the root of which a sweet, aromatic flavouring is extracted.",
		sections = {
			{
				"Overview",
				"The liquorice plant is an herbaceous [[Perennial|perennial]] [[Legume|legume]] native to [[West Asia]], Tropical Asia, [[North Africa]], and [[Southern Europe]]. Liquorice extracts have been used in herbalism and [[Traditional medicine|traditional medicine]]. Excessive consumption of liquorice (more than 2 mg/kg per day of pure glycyrrhizinic acid, a key component of liquorice) can lead to undesirable consequences. Consuming liquorice root extract should be avoided during pregnancy.",
