	},
	{
		title = "Synonym",
		category = "Concept",
		fame = 2,
		emoji = "🔤",
		source = "wikipedia",
		description = "Words or phrases of the same meaning",
		tags = { "More articles" },
		summary = "A **synonym** is a [[Word|word]], [[Morpheme|morpheme]], or [[Phrase|phrase]] that has a similar or identical meaning to another word, morpheme, or phrase in a given language. For example, in [[English language|English]], words like begin, start, commence, and initiate are synonyms: they are synonymous. The standard test for synonymy is substitution: one form can be used interchangeably without changing the meaning of the sentence.",
		sections = {
			{
				"Overview",
				"Words may be synonymous in only one particular sense: for example, long and extended in the context of long time or extended time are synonymous, but long cannot be used in the phrase extended family. Synonyms with identical meanings share a seme or denotational sememe, whereas those with inexactly similar meanings share a broader denotational or connotational sememe and overlap within a semantic field. The former are sometimes known as cognitive synonyms, and the latter are referred to as near-synonyms, plesionyms, or poecilonyms.",
			},
		},
	},
	{
		title = "Syntax",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "System responsible for combining morphemes into complex structures",
		tags = { "Basics", "Grammar" },
		summary = "In [[Linguistics|linguistics]], **syntax** is the study of how words and [[Morpheme|morphemes]] combine to form well-formed larger units such as [[Phrase|phrases]] and [[Sentence (linguistics)|sentences]]. Central concerns in this area of linguistics include word order, grammatical relations, hierarchical sentence structure (constituency), agreement, cross-linguistic variation, and the relationship between form and meaning ([[Semantics|semantics]]). Diverse approaches, such as generative grammar and functional grammar, offer unique perspectives on syntax, reflecting its complexity and centrality to understanding human language.",
		sections = {
			{
				"Overview",
				"In logic, syntax is the study of how strings of symbols form well-formed formulas in [[Formal language|formal languages]].",
			},
		},
	},
