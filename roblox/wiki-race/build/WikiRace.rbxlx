		fame = 2,
		emoji = "🏔️",
		source = "wikipedia",
		description = "Geographical region of China",
		tags = { "More articles" },
		summary = "**Southwestern China** is a region in the [[China|People's Republic of China]]. It consists of five provincial administrative regions, namely [[Chongqing]], [[Sichuan]], Guizhou, [[Yunnan]], and [[Tibet]].",
		related = { "Postmodern literature" },
