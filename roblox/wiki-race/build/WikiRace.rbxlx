		fame = 2,
		emoji = "🗣️",
		source = "wikipedia",
		description = "East Slavic language",
		tags = { "Indo-European languages", "Slavic languages" },
		aliases = { "Ukrainian" },
		summary = "**Ukrainian** is an East Slavic language, spoken primarily in [[Ukraine]]. It is the [[First language|first (native) language]] of a large majority of [[Ukrainians]].",
		sections = {
			{
				"Overview",
				"Written Ukrainian uses the Ukrainian alphabet, a variant of the [[Cyrillic script]]. The [[Standard language|standard language]] is studied by the National Academy of Sciences of Ukraine and Potebnia Institute of Linguistics. Comparisons are often made between Ukrainian and [[Russian language|Russian]], another East Slavic language, yet there is more [[Mutual intelligibility|mutual intelligibility]] with [[Belarusian language|Belarusian]], and a closer lexical distance to West Slavic [[Polish language|Polish]] and South Slavic [[Bulgarian language|Bulgarian]]. Ukrainian is a descendant of Old East Slavic, a language spoken in the [[Middle Ages|medieval]] state of Kievan Rus{{softsign}}. In the [[Grand Duchy of Lithuania]], the language developed into [[Ruthenian language|Ruthenian]], where it became an official language, before a process of Polonization began in the [[Polish–Lithuanian Commonwealth]]. By the 18th century, Ruthenian diverged into regional variants, and the modern Ukrainian language developed in the territory of present-day Ukraine.",
			},
		},
		infobox = {
			{ "Spoken in", "[[Ukraine]]" },
			{ "Date", "2023" },
