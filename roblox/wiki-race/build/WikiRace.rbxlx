		fame = 3,
		emoji = "🐺",
		tags = { "Legendary creatures", "Horror" },
		aliases = { "Werewolves" },
		summary = "A **werewolf** is a person who turns into a [[Wolf|wolf]] under a full [[Moon]] in European folklore.",
		sections = { { "Weakness", "Legends say only silver can harm a werewolf." } },
		infobox = { { "Trigger", "Full [[Moon]]" }, { "Related", "[[Vampire]]" } },
	},
	{
		title = "King Arthur",
		category = "Mythology",
		fame = 2,
		emoji = "👑",
		tags = { "Legendary kings", "British folklore" },
		summary = "**King Arthur** is a legendary British king who led the [[Knight|Knights]] of the Round Table from the [[Castle|castle]] of Camelot.",
		sections = {
			{
				"Sword",
				"He proved his right to rule by pulling a sword from a stone; his famous blade is [[Excalibur]].",
			},
		},
		infobox = { { "Court", "Camelot" }, { "Sword", "[[Excalibur]]" } },
	},
	{
		title = "Excalibur",
		category = "Mythology",
		fame = 3,
		emoji = "🗡️",
		tags = { "Legendary weapons" },
		summary = "**Excalibur** is the legendary sword of [[King Arthur]], given to him by the Lady of the Lake.",
		sections = {
			{
				"Legacy",
				"It inspired countless fictional swords, including [[Link (The Legend of Zelda)|Link]]'s Master Sword.",
			},
		},
		infobox = { { "Owner", "[[King Arthur]]" }, { "Given by", "Lady of the Lake" } },
	},
	{
		title = "Atlantis",
		category = "Mythology",
		fame = 2,
		emoji = "🌊",
		tags = { "Legendary places" },
		summary = "**Atlantis** is a legendary [[Island|island]] civilization that, according to the Greek philosopher Plato, sank into the sea in a single day.",
		sections = {
			{
				"Search",
				"No evidence has been found, but the story has inspired many books and films. Plato was a student of [[Socrates]].",
			},
