	{
		title = "Gymnosperm",
		category = "Plant",
		fame = 1,
		emoji = "🌿",
		source = "wikipedia",
		tags = { "Non-flowering plants", "Gymnosperms" },
		aliases = { "Gymnosperms", "Gymnospermae" },
		summary = "The **gymnosperms** are a group of woody, [[Perennial|perennial]] seed-producing plants, typically lacking the protective outer covering which surrounds the seeds in flowering plants, that include [[Conifer|conifers]], [[Cycad|cycads]], ginkgos, and gnetophytes, forming the clade **Gymnospermae**. The name is based on the unenclosed condition of their seeds (called ovules in their unfertilized state). The non-encased condition of their seeds contrasts with the seeds and ovules of flowering plants (angiosperms), which are enclosed within an ovary. Gymnosperm seeds develop either on the surface of scales or [[Leaf|leaves]], which are often modified to form cones, or on their own as in yew, Torreya, and Ginkgo.",
		sections = {
			{
				"Overview",
				'The life cycle of a gymnosperm involves [[Alternation of generations|alternation of generations]], with a dominant diploid [[Sporophyte|sporophyte]] phase, and a reduced haploid [[Gametophyte|gametophyte]] phase, which is dependent on the sporophytic phase. The term "gymnosperm" is often used in paleobotany to refer to (the [[Paraphyly|paraphyletic]] group of) all non-angiosperm seed plants. In that case, to specify the modern [[Monophyly|monophyletic]] group of gymnosperms, the term **Acrogymnospermae** is sometimes used. The gymnosperms and angiosperms together constitute the spermatophytes or seed plants. The spermatophytes are subdivided into five divisions, the angiosperms and four divisions of gymnosperms: the Cycadophyta, Ginkgophyta, Gnetophyta, and [[Conifer|Pinophyta]] (also known as Coniferophyta). Newer classification place the gnetophytes among the conifers.',
			},
		},
		related = { "Cupressus", "Sequoioideae" },
		infobox = {
			{ "Scientific name", "Gymnosperms" },
		},
	},
	{
		title = "Hazelnut",
		category = "Plant",
		fame = 3,
		emoji = "🥜",
		source = "wikipedia",
		description = "Nut of the hazel tree",
		tags = { "Eudicots", "Fagales" },
		summary = "The **hazelnut** is the [[Nut (fruit)|fruit]] of the hazel tree and therefore includes any of the nuts deriving from species of the genus Corylus, especially the nuts of the species Corylus avellana. They are also known as **cobnuts** or **filberts** according to species.",
		sections = {
			{
				"Overview",
				"Hazelnuts are used as a [[Snack|snack]] food, in [[Baking|baking]] and desserts, and in breakfast cereals such as muesli. In confectionery, they are used to make praline, and also used in combination with [[Chocolate|chocolate]] for chocolate truffles and products such as chocolate bars and hazelnut cocoa spreads such as Nutella. They are also used in Frangelico liqueur. **Hazelnut oil**, pressed from hazelnuts, is strongly flavored and high in monounsaturated fat. It is used as a [[Cooking oil|cooking oil]] and as a salad or vegetable dressing. In 2023, [[Turkey]] was the world's largest producer of hazelnuts, accounting for 57.7% of total production.",
			},
		},
		related = { "Birch" },
	},
	{
		title = "Hedera",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of flowering plants",
		tags = { "Eudicots", "Apiales" },
		aliases = { "Ivy", "Ivies" },
		summary = '**Hedera**, commonly called **ivy** (plural **ivies**), is a genus of 12–15 species of [[Evergreen|evergreen]] climbing or ground-creeping [[Woody plant|woody plants]] in the family Araliaceae, native to [[Western Europe]], [[Central Europe]], [[Southern Europe]], Macaronesia, northwestern Africa and across central-southern [[Asia]] east to [[Japan]] and [[Taiwan]]. Several species are cultivated as climbing ornamentals, and the name ivy especially denotes common ivy (Hedera helix), known in North America as "English ivy", which is frequently planted to clothe brick walls.',
		related = { "Parsnip", "Apiaceae" },
