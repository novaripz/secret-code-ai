		description = "1957 novel by Jack Kerouac",
		tags = { "Specific works of fiction", "Fiction of modern era" },
		summary = "**On the Road** is a 1957 novel by American author [[Jack Kerouac]], inspired by his travels across the United States. It is widely regarded as a defining work of the postwar Beat Generation, following a group of friends living for the moment against a backdrop of jazz, poetry, and rebellion.",
		sections = {
