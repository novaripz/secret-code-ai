	{
		title = "Nepali language",
		category = "Concept",
		fame = 2,
		emoji = "🗣️",
		source = "wikipedia",
		description = "Indo-Aryan Language",
		tags = { "Indo-European languages", "Indo-Aryan languages" },
		aliases = { "Nepali" },
		summary = "**Nepali** is the official and most-widely spoken language of Nepal, where it also serves as a [[Lingua franca|lingua franca]]. It is an [[Indo-Aryan languages|Indo-Aryan language]], belonging to the [[Indo-Iranian languages|Indo-Iranian]] branch within the [[Indo-European languages|Indo-European]] [[Language family|language family]], native to the [[Himalayas|Himalayan region]] of [[South Asia]].",
		sections = {
			{
				"Overview",
				"Nepali has [[Languages with official recognition in India|official status]] in the Indian state of [[Sikkim]] and in the Gorkhaland Territorial Administration, a semi-autonomous region of [[West Bengal]], where it is the majority language. It is also spoken by about a quarter of [[Bhutan]]. Nepali also has a significant number of speakers in the Indian states of Arunachal Pradesh, [[Assam]], [[Himachal Pradesh]], [[Manipur]], Meghalaya, Mizoram and [[Uttarakhand]]. In [[Myanmar]], it is spoken by the Burmese Gurkhas community. The Nepali diaspora in the [[Middle East]], [[Brunei]], [[Australia]] and around the world also use the language. Overall, Nepali is spoken by approximately 19 million [[First language|native speakers]] and additional 14 million as a [[Second language|second language]]. Nepali is commonly classified within the Eastern Pahari group of the Northern zone of Indo-Aryan.",
			},
		},
		infobox = {
			{ "Region", "[[Himalayas]]" },
			{ "Date", "2011–2021" },
			{ "Writing system", "*[[Devanagari]], Devanagari Braille, Ranjana Script" },
		},
	},
	{
		title = "Neurology",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Medical specialty dealing with disorders of the nervous system",
		tags = { "More articles" },
		summary = "Neurological practice relies heavily on the field of [[Neuroscience|neuroscience]], the scientific study of the [[Nervous system|nervous system]], using various techniques of neurotherapy.",
		sections = {
			{
				"Overview",
				"A **neurologist** is a physician specializing in neurology and trained to investigate, diagnose and treat neurological disorders. Neurologists may also have roles in clinical research, clinical trials, and basic or translational research. Neurology is a nonsurgical specialty; its corresponding surgical specialty is neurosurgery.",
			},
		},
