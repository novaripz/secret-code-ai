  <Item class="StarterPlayer" referent="117">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="118">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="119">
        <Properties>
          <string name="Name">WikiRaceClient</string>
        </Properties>
        <Item class="Folder" referent="120">
