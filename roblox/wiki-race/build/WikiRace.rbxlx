	{
		title = "Kandahar",
		category = "City",
		fame = 3,
		emoji = "🏙️",
		source = "wikipedia",
		description = "City in Kandahar Province, Afghanistan",
		tags = { "Asia", "Southern Asia" },
		summary = "**Kandahar** is a city in southern [[Afghanistan]], serving as the [[Capital city|capital]] and largest city of Kandahar Province. It is within the jurisdiction of Kandahar District and has an estimated population of 732,629 settled residents. Mullah Hekmatullah is the current [[Mayor|mayor]] of the city. His predecessor was Haji Nimatullah Hassan.",
		sections = {
			{
				"Overview",
				"Kandahar is located between the Arghandab River and the Tarnak River, at an elevation of approximately 1010 m above [[Sea level|sea level]]. It is the center of the larger cultural region called Loy Kandahar. The [[Municipality|Kandahar Municipality]] is administratively divided into 15 city districts (nahias), covering a land area of 273 km². It has a number of industrial parks, public parks, bazaars, business centers, banks, hotels, restaurants, mosques, hospitals, universities, tourist sites, and places to play sports or just relax. The Ayno Maina township is located in the northeastern part of the city, next to the Kabul–Kandahar Highway. The region around Kandahar is one of the oldest known areas of human settlement.",
			},
