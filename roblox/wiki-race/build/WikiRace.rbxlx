      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Mythology</string>
          <string name="Source"><![CDATA[-- Mythology, legends and folklore creatures.
return {
	{
		title = "Mythology",
		category = "Mythology",
		fame = 1,
		emoji = "🐉",
		tags = { "Religion", "Folklore" },
		aliases = { "Myth", "Myths", "Legend" },
		summary = "**Mythology** is a collection of traditional stories, or myths, that a culture tells about gods, heroes and the origins of the world.",
		sections = {
			{
				"Traditions",
				"Famous traditions include [[Greek mythology|Greek]], [[Norse mythology|Norse]] and [[Egyptian mythology|Egyptian]] mythology.",
			},
			{
				"Creatures",
				"Myths are full of creatures like the [[Dragon|dragon]], the [[Unicorn|unicorn]] and the [[Phoenix|phoenix]].",
			},
		},
		infobox = { { "Studied by", "Mythologists" }, { "Related", "[[History]], [[Literature]]" } },
		related = { "History", "Bigfoot", "Mermaid" },
	},
	{
		title = "Greek mythology",
		category = "Mythology",
		fame = 1,
		emoji = "⚡",
		tags = { "Mythologies" },
		summary = "**Greek mythology** is the body of myths of [[Ancient Greece]], about gods who lived on Mount Olympus and the heroes they helped or punished.",
		sections = {
			{
				"Gods",
				"The gods included [[Zeus]], [[Poseidon]], [[Hades]] and [[Athena]]. Heroes included [[Hercules]] and [[Achilles]].",
			},
		},
		infobox = { { "King of gods", "[[Zeus]]" }, { "Home of gods", "Mount Olympus" } },
		related = { "Mythology", "Minotaur" },
	},
	{
		title = "Zeus",
		category = "Mythology",
		fame = 1,
		emoji = "⚡",
		tags = { "Greek gods" },
		summary = "**Zeus** is the king of the gods in [[Greek mythology]], ruler of the sky who hurls thunderbolts of [[Lightning|lightning]].",
		sections = {
			{
				"Family",
				"His brothers are [[Poseidon]] and [[Hades]]; among his many children are [[Athena]] and [[Hercules]]. The Romans called him Jupiter, like the planet [[Jupiter]].",
			},
		},
		infobox = { { "Domain", "Sky, thunder" }, { "Symbol", "Thunderbolt" } },
	},
	{
		title = "Poseidon",
		category = "Mythology",
		fame = 2,
		emoji = "🔱",
		tags = { "Greek gods" },
		summary = "**Poseidon** is the god of the sea, earthquakes and horses in [[Greek mythology]]. He carries a three-pronged trident.",
		sections = { { "Myths", "He tormented Odysseus throughout the [[Odyssey]]. The Romans called him Neptune." } },
		infobox = { { "Domain", "[[Ocean|Sea]]" }, { "Brother", "[[Zeus]]" } },
	},
	{
		title = "Hades",
		category = "Mythology",
		fame = 3,
		emoji = "💀",
		tags = { "Greek gods" },
		summary = "**Hades** is the god of the underworld in [[Greek mythology]] and brother of [[Zeus]]. His realm is guarded by the three-headed dog Cerberus.",
		sections = { { "Name", "The dwarf planet [[Pluto]] is named after his Roman equivalent." } },
		infobox = { { "Domain", "Underworld" }, { "Pet", "Cerberus" } },
	},
	{
		title = "Athena",
		category = "Mythology",
		fame = 2,
		emoji = "🦉",
		tags = { "Greek gods" },
		summary = "**Athena** is the Greek goddess of wisdom and warfare, who sprang fully armored from the head of [[Zeus]].",
		sections = {
			{
				"City",
				"The city of [[Athens]] is named after her, and the [[Parthenon]] was her temple. Her symbol is the [[Owl|owl]].",
			},
		},
		infobox = { { "Domain", "Wisdom" }, { "Symbol", "[[Owl]]" } },
	},
	{
		title = "Hercules",
		category = "Mythology",
		fame = 2,
		emoji = "💪",
		tags = { "Greek heroes" },
		aliases = { "Heracles" },
		summary = "**Hercules** is the strongest hero of [[Greek mythology]], a son of [[Zeus]] who completed twelve impossible labors.",
		sections = {
			{
				"Labors",
				"His labors included slaying the Nemean [[Lion|lion]] and capturing Cerberus, the guard dog of [[Hades]].",
			},
		},
		infobox = { { "Father", "[[Zeus]]" }, { "Greek name", "Heracles" } },
	},
	{
		title = "Medusa",
		category = "Mythology",
		fame = 2,
		emoji = "🐍",
		tags = { "Greek mythological creatures" },
		summary = "**Medusa** is a Gorgon in [[Greek mythology]] with [[Snake|snakes]] for hair, whose gaze turned people to stone.",
		sections = {
			{
				"Defeat",
				"The hero Perseus beheaded her using a polished shield as a [[Mirror|mirror]]; the winged horse [[Pegasus]] sprang from her blood.",
			},
		},
		infobox = { { "Type", "Gorgon" }, { "Power", "Petrifying gaze" } },
	},
	{
		title = "Pegasus",
		category = "Mythology",
		fame = 3,
		emoji = "🦄",
		tags = { "Greek mythological creatures" },
		summary = "**Pegasus** is a winged [[Horse|horse]] in [[Greek mythology]], born from the blood of [[Medusa]].",
		sections = { { "Sky", "[[Zeus]] placed him among the [[Star|stars]] as a constellation." } },
		infobox = { { "Type", "Winged horse" }, { "Related", "[[Unicorn]]" } },
	},
	{
		title = "Minotaur",
		category = "Mythology",
		fame = 3,
		emoji = "🐂",
		tags = { "Greek mythological creatures" },
		summary = "The **Minotaur** is a creature with the head of a bull and the body of a man, kept in a labyrinth on Crete in [[Greek mythology]].",
		sections = { { "Defeat", "The hero Theseus killed it and escaped the maze by following a thread." } },
		infobox = { { "Home", "Labyrinth of Crete" }, { "Slain by", "Theseus" } },
	},
	{
		title = "Achilles",
		category = "Mythology",
		fame = 2,
		emoji = "🛡️",
		tags = { "Greek heroes" },
		summary = "**Achilles** is the greatest Greek warrior of the [[Trojan War]]. He was invulnerable everywhere except his heel.",
		sections = {
			{ "Legacy", "An 'Achilles' heel' means a small but fatal weakness. His story is told by [[Homer]]." },
		},
		infobox = { { "War", "[[Trojan War]]" }, { "Weakness", "Heel" } },
	},
	{
		title = "Trojan War",
		category = "Mythology",
		fame = 2,
		emoji = "⚔️",
		tags = { "Greek mythology", "Legendary wars" },
		summary = "The **Trojan War** is the legendary ten-year war between the Greeks and the city of Troy, told by [[Homer]].",
		sections = {
			{
				"End",
				"The Greeks won by hiding soldiers inside the [[Trojan Horse]]. Heroes included [[Achilles]] and Odysseus, whose trip home is the [[Odyssey]].",
			},
		},
		infobox = { { "Length", "10 years" }, { "Ended by", "[[Trojan Horse]]" } },
	},
	{
		title = "Trojan Horse",
		category = "Mythology",
		fame = 2,
		emoji = "🐴",
		tags = { "Greek mythology" },
		summary = "The **Trojan Horse** was a giant wooden [[Horse|horse]] the Greeks left as a 'gift' outside Troy, with soldiers hidden inside, ending the [[Trojan War]].",
		sections = {
			{
				"Today",
				"A disguised malicious program is called a Trojan, a kind of [[Computer virus|computer virus]].",
			},
		},
		infobox = { { "War", "[[Trojan War]]" }, { "Made of", "Wood" } },
	},
	{
		title = "Norse mythology",
		category = "Mythology",
		fame = 2,
		emoji = "🪓",
		tags = { "Mythologies" },
		summary = "**Norse mythology** is the mythology of the [[Vikings]] and other Scandinavian peoples, with gods like [[Odin]], [[Thor]] and [[Loki]].",
		sections = {
			{
				"Legacy",
				"Several English weekdays are named after Norse gods — Thursday is 'Thor's day'. Many stories survive from [[Iceland]].",
			},
		},
		infobox = { { "Chief god", "[[Odin]]" }, { "Home of gods", "Asgard" } },
		related = { "Mythology" },
	},
	{
		title = "Odin",
		category = "Mythology",
		fame = 3,
		emoji = "🐦‍⬛",
		tags = { "Norse gods" },
		summary = "**Odin** is the one-eyed chief god of [[Norse mythology]], a god of wisdom who gave up an eye to drink from the well of knowledge.",
		sections = { { "Companions", "Two ravens fly around the world and bring him news. His son is [[Thor]]." } },
		infobox = { { "Domain", "Wisdom, war" }, { "Son", "[[Thor]]" } },
	},
	{
		title = "Thor",
		category = "Mythology",
		fame = 1,
		emoji = "🔨",
		tags = { "Norse gods", "Marvel characters" },
		summary = "**Thor** is the Norse god of thunder, who wields the hammer Mjölnir. He is a son of [[Odin]].",
		sections = {
			{
				"Pop culture",
				"Thor became a [[Marvel Comics]] superhero and a member of [[The Avengers]]. Thursday is named after him.",
			},
		},
		infobox = { { "Weapon", "Mjölnir" }, { "Domain", "Thunder, [[Lightning|lightning]]" } },
	},
	{
		title = "Loki",
		category = "Mythology",
		fame = 2,
		emoji = "🐍",
		tags = { "Norse gods" },
		summary = "**Loki** is the shape-shifting trickster god of [[Norse mythology]], sometimes helping and often troubling the gods.",
		sections = {
			{
				"Transformations",
				"He once turned into a mare and gave birth to [[Odin]]'s eight-legged horse. He is [[Thor]]'s troublesome companion.",
			},
		},
		infobox = { { "Domain", "Mischief" }, { "Powers", "Shape-shifting" } },
	},
	{
		title = "Egyptian mythology",
		category = "Mythology",
		fame = 2,
		emoji = "𓂀",
		tags = { "Mythologies" },
		summary = "**Egyptian mythology** is the collection of myths of [[Ancient Egypt]], with gods often shown with animal heads, like [[Anubis]].",
		sections = { { "Sun god", "[[Ra]], the sun god, sailed across the sky each day in a boat." } },
		infobox = { { "Chief god", "[[Ra]]" }, { "Afterlife guide", "[[Anubis]]" } },
		related = { "Mythology" },
	},
	{
		title = "Ra",
		category = "Mythology",
		fame = 3,
		emoji = "☀️",
		tags = { "Egyptian gods" },
		aliases = { "Re" },
		summary = "**Ra** is the sun god of [[Egyptian mythology]], often shown with the head of a falcon and a [[Sun|sun]] disk above him.",
		sections = {
			{
				"Journey",
				"Each night Ra traveled through the underworld and fought a giant [[Snake|serpent]] so the sun could rise again.",
			},
		},
		infobox = { { "Domain", "[[Sun]]" }, { "Head", "Falcon" } },
	},
	{
		title = "Anubis",
		category = "Mythology",
		fame = 3,
		emoji = "🐺",
		tags = { "Egyptian gods" },
		summary = "**Anubis** is the jackal-headed god of [[Egyptian mythology]] who guided souls and protected the dead during [[Mummy|mummification]].",
		sections = { { "Judgment", "He weighed the hearts of the dead against a feather to judge them." } },
		infobox = { { "Domain", "Afterlife" }, { "Head", "Jackal" } },
	},
	{
		title = "Dragon",
		category = "Mythology",
		fame = 1,
		emoji = "🐉",
		tags = { "Legendary creatures" },
		aliases = { "Dragons" },
		summary = "A **dragon** is a giant legendary reptile found in myths all over the world. European dragons breathe fire; Chinese dragons bring rain and luck.",
		sections = {
			{
				"Fiction",
				"Dragons appear in [[The Hobbit]], [[Dragon Ball]] and countless [[Video game|video games]]. Legends may have been inspired by [[Dinosaur|dinosaur]] fossils.",
			},
		},
		infobox = { { "Found in", "European and Asian myths" }, { "Related", "[[Phoenix]]" } },
		related = { "Mythology" },
	},
	{
		title = "Unicorn",
		category = "Mythology",
		fame = 2,
		emoji = "🦄",
		tags = { "Legendary creatures" },
		aliases = { "Unicorns" },
		summary = "A **unicorn** is a legendary [[Horse|horse]]-like creature with a single spiraling horn. It is the national animal of [[Scotland]].",
		sections = { { "Origin", "Medieval traders sold narwhal tusks as unicorn horns." } },
		infobox = { { "Horns", "1" }, { "National animal of", "[[Scotland]]" } },
	},
	{
		title = "Phoenix",
		category = "Mythology",
		fame = 2,
		emoji = "🔥",
		tags = { "Legendary creatures" },
		summary = "The **phoenix** is a mythical [[Bird|bird]] that bursts into flames and is reborn from its own ashes.",
		sections = {
			{
				"Fiction",
				"A phoenix named Fawkes appears in [[Harry Potter]]. The myth may come from [[Egyptian mythology]].",
			},
		},
		infobox = { { "Symbol of", "Rebirth" }, { "Related", "[[Dragon]]" } },
	},
	{
		title = "Mermaid",
		category = "Mythology",
		fame = 2,
		emoji = "🧜",
		tags = { "Legendary creatures" },
		aliases = { "Mermaids" },
		summary = "A **mermaid** is a legendary sea creature with the upper body of a woman and the tail of a [[Fish|fish]].",
		sections = {
			{
				"Sightings",
				"Sailors may have mistaken manatees for mermaids. [[Christopher Columbus]] reported seeing three.",
			},
		},
		infobox = { { "Lives in", "[[Ocean]]" }, { "Related", "[[Kraken]]" } },
	},
	{
		title = "Kraken",
		category = "Mythology",
		fame = 3,
		emoji = "🦑",
		tags = { "Legendary creatures" },
		summary = "The **Kraken** is a legendary sea monster of Scandinavian folklore, said to be large enough to drag down [[Ship|ships]].",
		sections = {
			{ "Real inspiration", "Stories may have been inspired by real giant squid and the [[Octopus|octopus]]." },
		},
		infobox = { { "Origin", "Norway" }, { "Real relative", "Giant squid" } },
	},
	{
		title = "Loch Ness Monster",
		category = "Mythology",
		fame = 2,
		emoji = "🦕",
		tags = { "Cryptids", "Scottish folklore" },
		aliases = { "Nessie" },
		summary = "The **Loch Ness Monster**, or Nessie, is a creature said to live in Loch Ness in [[Scotland]].",
		sections = {
			{
				"Photo",
				"A famous 1934 photo, later revealed to be a toy [[Submarine|submarine]] with a fake head, showed a long neck like a [[Dinosaur|plesiosaur]].",
			},
		},
		infobox = { { "Location", "Loch Ness, [[Scotland]]" }, { "First reported", "AD 565" } },
	},
	{
		title = "Bigfoot",
		category = "Mythology",
		fame = 2,
		emoji = "🦶",
		tags = { "Cryptids" },
		aliases = { "Sasquatch" },
		summary = "**Bigfoot** is a legendary ape-like creature said to roam the forests of [[North America]].",
		sections = {
			{
				"Evidence",
				"Despite many blurry photos and giant footprints, no convincing evidence has ever been found.",
			},
		},
		infobox = { { "Region", "[[North America]]" }, { "Relative (claimed)", "[[Gorilla]]" } },
	},
	{
		title = "Vampire",
		category = "Mythology",
		fame = 2,
		emoji = "🧛",
		tags = { "Legendary creatures", "Horror" },
		aliases = { "Vampires" },
		summary = "A **vampire** is a creature of folklore that drinks [[Blood|blood]] and fears sunlight and garlic. The most famous is Count [[Dracula]].",
		sections = { { "Halloween", "Vampires are among the most popular [[Halloween]] costumes." } },
		infobox = { { "Weakness", "Sunlight, garlic" }, { "Related", "[[Werewolf]]" } },
	},
	{
		title = "Werewolf",
