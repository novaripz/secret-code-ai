	{
		title = "Ramsar Convention",
		category = "Concept",
		fame = 3,
		emoji = "💭",
		source = "wikipedia",
		description = "International treaty for the conservation and sustainable utilization of wetlands",
		tags = { "More articles" },
		summary = "The **Ramsar Convention on Wetlands of International Importance Especially as Waterfowl Habitat** is an international [[Treaty|treaty]] for the conservation and sustainable use of Ramsar sites ([[Wetland|wetlands]]). It is also known as the **Convention on Wetlands**. It is named after the city of Ramsar in [[Iran]], where the convention was signed in 1971.",
		sections = {
			{
				"Overview",
