	{
		title = "Edgar Allan Poe",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "American writer and critic (1809–1849)",
		tags = { "Americas", "US and Canada" },
		summary = "**Edgar Allan Poe** (January 19, 1809 – October 7, 1849) was an American [[Writer|writer]], [[Poet|poet]], editor, and [[Literary criticism|literary critic]] who is best known for his poetry and short stories, particularly his tales involving mystery and the macabre. He is widely regarded as one of the central figures of [[Romanticism]] and [[Gothic fiction]] in the United States and of early [[American literature]].",
		sections = {
			{
				"Overview",
				"Poe was one of the country's first successful practitioners of the [[Short story|short story]], and is generally considered to be one of the pioneers of the [[Detective fiction|detective fiction]] genre. In addition, he is credited with contributing significantly to the emergence of [[Science fiction|science fiction]]. He is the first well-known American writer to earn a living exclusively through writing, which resulted in a financially difficult life and career. Poe was born in [[Boston]]. He was the second child of actors David and Eliza Poe. His father abandoned the family in 1810, and when Eliza died the following year, Poe was taken in by John and Frances Allan of Richmond, Virginia. They never formally [[Adoption|adopted]] him, but he lived with them well into young adulthood. Poe attended the University of Virginia, but left after only a year due to a lack of money.",
			},
		},
		related = { "Edith Wharton", "Maya Angelou" },
		infobox = {
			{ "Born", "19 January 1809" },
			{ "Birthplace", "[[Boston]], Massachusetts, US" },
			{ "Died", "7 October 1849" },
			{ "Occupation", "Writer, poet, editor, literary critic" },
		},
