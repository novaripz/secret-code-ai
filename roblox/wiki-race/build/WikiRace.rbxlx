	{
		title = "Journalism",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Production of reports on current events",
		tags = { "Mass media" },
		summary = '**Journalism** is the production and distribution of reports on events, facts, ideas, and people that constitute the "news of the day" and inform society with a commitment to accuracy and verification. The word, a [[Noun|noun]], applies to the [[Journalist|occupation]] (professional or not), the methods of gathering information, and the organizing literary styles.',
		sections = {
			{
				"Overview",
				"The role of journalism varies across countries, as do perceptions of the profession and its status. In some nations, [[News|news]] [[Mass media|media]] are controlled by the [[Government|government]] and lack independence. In others, [[News media|news media]] operate independently of government influence and function as private enterprises. Legal frameworks also differ, particularly regarding [[Freedom of speech|freedom of speech]], [[Freedom of the press|freedom of the press]], slander, and libel. Scholars have also examined journalism’s role in globalization, highlighting its contribution to increasing global interconnectedness. In recent years, the rise of the [[Internet|internet]] and [[Digital media|digital]] media has significantly changed how people access and consume information, with a growing preference for online sources. In some regions, this shift has contributed to the decline or disappearance of traditional print [[Newspaper|newspapers]].",
			},
		},
	},
	{
		title = "Journalist",
		category = "Concept",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Person who collects, writes and distributes news and similar information",
		tags = { "More articles" },
		summary = "A **journalist** is a person who gathers information in the form of text, audio or pictures, processes it into a newsworthy form and disseminates it to the public. This process is called [[Journalism|journalism]].",
		infobox = {
			{ "Type", "[[Journalism]], [[Mass media|mass media]]" },
		},
	},
	{
		title = "Judge",
		category = "Concept",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Person who is going to decide a decision according to the law in the court",
		tags = { "Law", "Institutions and professions" },
		summary = "A **judge** is a public official who presides over [[Court|court]] proceedings, either alone or as a part of a judicial panel. In an adversarial system, the judge hears all the [[Witness|witnesses]] and any other [[Evidence (law)|evidence]] presented by the barristers or solicitors of the case, assesses the credibility and [[Argument|arguments]] of the parties, and then issues a ruling in the case based on their interpretation of the law and their own personal judgment. A judge is expected to conduct the trial impartially and, typically, in an open court.",
		sections = {
			{
				"Overview",
				"The powers, functions, method of appointment, discipline, and training of judges vary widely across different [[Jurisdiction|jurisdictions]]. In some jurisdictions, the judge's powers may be shared with a [[Jury|jury]]. In inquisitorial systems of criminal investigation, a judge might also be an examining magistrate. The presiding judge ensures that all court proceedings are lawful and orderly.",
			},
		},
		infobox = {
			{ "Type", "[[Profession]]" },
		},
	},
	{
		title = "Judiciary",
		category = "Concept",
		fame = 2,
		emoji = "⚖️",
		source = "wikipedia",
		description = "System of courts that interprets and applies the law",
		tags = { "Law", "Institutions and professions" },
		aliases = { "Judicial system", "Judicial power", "Judicature" },
		summary = "The **judiciary** (also known as the **judicial system**, **judicial power**, **judicature**, **judicial branch**, **judiciative branch**, and **court or judiciary system**) is the system of [[Court|courts]] that adjudicates legal disputes/disagreements and interprets, defends, and applies the [[Law|law]] in legal cases.",
	},
	{
		title = "Julian year (astronomy)",
		category = "Concept",
		fame = 3,
		emoji = "📅",
		source = "wikipedia",
		description = "Interval of exactly 365.25 Earth days",
		tags = { "More articles" },
		aliases = { "Julian year" },
		summary = "In [[Astronomy|astronomy]], a **Julian year** (symbol: **a** or **aj**) is a [[Unit of measurement|unit of measurement]] of [[Time|time]] defined as exactly 365.25 [[Day|days]] of 86400 [[International System of Units|SI]] [[Second|seconds]] each. The length of the Julian year is the average length of the [[Year|year]] in the [[Julian calendar]] that was used in Western societies until the adoption of the Gregorian Calendar, and from which the unit is named. Nevertheless, because astronomical Julian years are measuring duration rather than designating dates, this Julian year does not correspond to years in the Julian calendar or any other calendar, nor does it correspond to the many other ways of defining a year.",
	},
	{
		title = "July Monarchy",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Monarchy of France from 1830 to 1848",
		tags = { "More articles" },
		summary = "The **July Monarchy**, officially the **Kingdom of France**, was a liberal [[Constitutional monarchy|constitutional monarchy]] in [[France]] under, starting on 9 August 1830, with the revolutionary victory in the [[July Revolution]] of 1830, and ending on 24 February 1848, with the Revolution of 1848. It marks the end of the [[Bourbon Restoration in France|Bourbon Restoration]] (1814–1830). It began with the overthrow of the conservative government of Charles X, the last king of the main line [[House of Bourbon]].",
		sections = {
			{
				"Overview",
				'Louis Philippe I, a member of the more liberal Orléans branch of the House of Bourbon, proclaimed himself as ("King of the French") rather than "King of France", emphasizing the popular origins of his reign. The king promised to follow the juste milieu, or the middle-of-the-road, avoiding the extremes of both the conservative supporters of Charles X and radicals on the left. The July Monarchy was dominated by wealthy [[Bourgeoisie|bourgeoisie]] and numerous former [[Napoleon|Napoleonic]] officials. It followed conservative policies, especially under the influence of. The king promoted friendship with the [[United Kingdom of Great Britain and Ireland|United Kingdom]] and sponsored colonial expansion, notably the French conquest of Algeria. By 1848, Louis Philippe I\'s popularity had collapsed, and he abdicated following the successful February Revolution, part of the larger [[Revolutions of 1848|revolutions of 1848]].',
			},
		},
		related = { "Padma Bhushan" },
		infobox = {
			{ "Government", "[[Constitutional monarchy|Parliamentary constitutional monarchy]]" },
			{ "Capital", "[[Paris]]" },
			{ "Currency", "French franc" },
			{ "People are called", "French" },
		},
	},
	{
		title = "Jure uxoris",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Title of nobility used by a man because his wife holds it in her own right",
		tags = { "More articles" },
		aliases = { "Iure uxoris" },
		summary = '**Jure uxoris** (**iure uxoris**; a [[Latin]] phrase meaning "by right of (his) wife") describes a title of [[Nobility|nobility]] used by a man because his wife holds the office or title suo jure ("in her own right"). Similarly, the husband of an heiress could become the legal possessor of her lands. For example, married women in England and Wales were legally prohibited from owning real estate until the Married Women\'s Property Act 1882.',
	},
	{
		title = "Jurisdiction",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "Authority granted to a legal body or political leader to deal with legal matters",
		tags = { "More articles" },
		summary = "**Jurisdiction** is the legal term for the legal authority held by a legal entity to enact [[Justice|justice]]. Jurisdiction is rarely claimed to be complete: rather it is limited for example by geography, subject matter, or other factor. It is only within the scope (inside the limits) of such jurisdiction that, for example, the parties to a dispute have standing to bring the matter (a legal question) before a judge, who has power (or 'jurisdiction') to decide it authoritatively.",
		sections = {
			{
				"Overview",
				'A "jurisdiction" can also be understood as a category name for any separate [[Polity|polity]] legally [[Constitution|constituted]] as such — for any government with legislative and other legal power over a particular territory, whether that area is a [[Nation state|nation state]] or some smaller [[Region|region]]. Thus, [[Australia]], [[Arizona]], North Yorkshire and [[New York City]] are each "a jurisdiction". In [[Federation|federations]] like the [[United States]], jurisdiction in this polity sense applies at multiple levels (e.g., local, [[Federated state|state]], and national/federal). Jurisdiction draws its substance from [[International law|international law]], conflict of laws, constitutional law, and is often thought to include the powers of the [[Executive (government)|executive]] and [[Legislature|legislative branches]] of government to pursue policies and allocate resources so as to best serve the needs of [[Society|society]].',
			},
		},
	},
	{
		title = "Jurisprudence",
		category = "Concept",
		fame = 1,
		emoji = "⚖️",
		source = "wikipedia",
		description = "Theoretical study of law",
		tags = { "Law", "Basics" },
		aliases = { "Legal theory", "Legal science", "Philosophy of law" },
		summary = "**Jurisprudence**, also known as **legal theory** or **legal science**, is the **philosophy of law**. As a field of [[Knowledge|knowledge]], it applies philosophical methods to legal questions, such as what the [[Law|law]] is or how it ought to be.",
		sections = {
			{
				"Overview",
				"Evidence of jurisprudential thought can be found in the writings of [[Ancient philosophy|ancient philosophers]], including [[Confucius|Confucius (c. 551 – c. 479 BCE)]], [[Aristotle|Aristotle (384–322 BCE)]], and [[Augustine of Hippo|St Augustine (354–430 CE)]], who wrote broadly on moral and political philosophy. Among the oldest conceptions of law are [[Natural law|natural law theories]], instrumental theories of law, and law as reflective of [[Social norm|social norms]] and [[Customary law|custom]]. Contemporary mainstream academic jurisprudence traces its origin to the early [[17th century]] and the [[Age of Enlightenment]], which saw [[Empiricism|empiricist]] philosophers such as [[Thomas Hobbes|Hobbes]], [[David Hume|Hume]], [[John Locke|Locke]], [[Montesquieu]], and [[Jean-Jacques Rousseau|Rousseau]] rejecting religious conceptions of law and developing early concepts of the [[Rule of law|rule of law]], [[Justice|justice]], and constitutionalism.",
			},
		},
		related = { "Appeal" },
	},
	{
		title = "Jurist",
		category = "Concept",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Person with expert knowledge of law",
		tags = { "More articles" },
		summary = 'A **jurist** is a person with expert knowledge of [[Law|law]]. Depending on jurisdiction, the term "jurist" can refer to a **legal scholar**, a judge, or a lawyer.',
		related = { "The Right Honourable" },
	},
	{
		title = "Jury",
		category = "Concept",
		fame = 2,
		emoji = "👥",
		source = "wikipedia",
		description = "Group of people to render a verdict in a court",
		tags = { "Law", "Institutions and professions" },
		aliases = { "Jurors" },
		summary = 'A **jury** is a sworn body of people (**jurors**) convened to hear [[Evidence|evidence]], make findings of fact, and render an [[Impartiality|impartial]] verdict officially submitted to them by a [[Court|court]], or to set a penalty or judgment. Most trial juries are "petit juries", and consist of up to 15 people. Primarily in the United States, a larger jury known as a grand jury is used to investigate potential crimes and render indictments against suspects, and consists of between 16 and 23 jurors.',
		sections = {
			{
				"Overview",
				"The jury system developed in [[England]] during the [[Middle Ages]] and is a hallmark of the English [[Common law|common law]] system. Juries are commonly used in countries whose legal systems derive from the [[British Empire]], such as the [[United Kingdom]], the [[United States]], [[Canada]], [[Australia]], and [[Republic of Ireland|Ireland]]. They are not used in most other countries, whose legal systems are based upon European [[Civil law (legal system)|civil law]] or Islamic sharia law, although their use has been spreading. Instead, typically guilt is determined by a single person, usually a professional [[Judge|judge]]. Civil law systems that do not use juries may use lay judges instead. The word jury has also been applied to randomly-selected bodies with other purposes, such as citizen's assemblies, otherwise known as policy juries.",
			},
		},
	},
	{
		title = "Justice",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Concept of moral fairness and administration of the law",
		tags = { "Law", "Basics" },
		summary = 'In its broadest sense, **justice** is the treatment of individuals fairly. According to the [[Stanford Encyclopedia of Philosophy]], the most plausible candidate for a core definition comes from the Institutes of [[Justinian I|Justinian]], a 6th-century codification of [[Roman law]], where justice is defined as "the constant and perpetual will to render to each his due".',
		related = { "Alternative dispute resolution" },
	},
	{
		title = "Justification (epistemology)",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Concept in epistemology",
		tags = { "More articles" },
		aliases = { "Justification", "Epistemic justification" },
		summary = "**Justification** (also called **epistemic justification**) is a property of [[Belief|beliefs]] that fulfill certain norms about what a person should believe. [[Epistemology|Epistemologists]] often identify justification as a component of knowledge distinguishing it from mere true opinion. They study the reasons why someone holds a belief. Epistemologists are concerned with various features of belief, which include the ideas of warrant (a proper justification for holding a belief), [[Knowledge|knowledge]], rationality, and [[Probability|probability]], among others.",
		sections = {
			{
				"Overview",
				"Debates surrounding epistemic justification often involve the structure of justification, including whether there are foundational justified beliefs or whether mere coherence is sufficient for a system of beliefs to qualify as justified. Another major subject of debate is the sources of justification, which might include [[Perception|perceptual experience]] (the evidence of the senses), [[Reason|reason]], and authoritative [[Testimony|testimony]], among others.",
			},
		},
	},
	{
		title = "Kalmar Union",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Personal union in Scandinavia",
		tags = { "More articles" },
		summary = "The **Kalmar Union** was a [[Personal union|personal union]] in [[Scandinavia]], agreed at Kalmar in [[Sweden]] as designed by Queen [[Margaret I of Denmark|Margaret]] of Denmark. From 1397 to 1523, it joined under a single monarch the three kingdoms of [[Denmark]], [[Sweden]] (then including much of present-day [[Finland]]), and [[Norway]], together with Norway's maritime colonies (then including [[Iceland]], [[Greenland]], the [[Faroe Islands]], and the Northern Isles of Orkney and Shetland).",
		sections = {
			{
				"Overview",
				"The union was not quite continuous; there were several short interruptions. Legally, the countries remained separate [[Sovereign state|sovereign states]], but their domestic and foreign policies were directed by a common monarch. Gustav Vasa's election as King of Sweden on 6 June 1523, and his triumphant entry into Stockholm 11 days later, marked Sweden's final secession from the Kalmar Union. Frederick I formally renounced his claim to Sweden in 1524 at the Treaty of Malmö.",
			},
		},
		related = { "Verve Records" },
		infobox = {
