			{
				"Ancient world",
				"Early civilizations include [[Ancient Egypt]], [[Ancient Greece]] and the [[Roman Empire]].",
			},
			{
				"Modern era",
				"The [[Industrial Revolution]], [[World War I]], [[World War II]] and the [[Cold War]] shaped the modern world.",
			},
		},
		infobox = { { "Studied by", "Historians" }, { "Periods", "Ancient, [[Middle Ages|medieval]], modern" } },
		related = { "Mythology", "World War I" },
	},
	{
		title = "Ancient Egypt",
		category = "History",
		fame = 1,
		emoji = "𓂀",
		tags = { "Ancient civilizations" },
		summary = "**Ancient Egypt** was a civilization along the [[Nile]] that lasted about 3,000 years. It was ruled by kings called [[Pharaoh|pharaohs]].",
		sections = {
			{
				"Achievements",
				"Egyptians built the [[Great Pyramid of Giza]], invented [[Hieroglyphs|hieroglyphic]] writing and preserved their dead as [[Mummy|mummies]].",
			},
			{ "Religion", "They worshipped gods of [[Egyptian mythology]] such as [[Ra]] and [[Anubis]]." },
		},
		infobox = { { "Period", "~3100–30 BC" }, { "Last ruler", "[[Cleopatra]]" } },
	},
	{
