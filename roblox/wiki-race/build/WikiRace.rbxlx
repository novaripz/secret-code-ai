		tags = { "Mechanics", "Fluid mechanics" },
		aliases = { "Drag", "Fluid resistance", "Viscous force" },
		summary = "In [[Fluid dynamics|fluid dynamics]], **drag**, sometimes referred to as **fluid resistance**, and also known as **viscous force**, is a [[Force|force]] acting opposite to the direction of motion of any object moving with respect to a surrounding [[Fluid|fluid]]. This can exist between two fluid layers, or between a fluid and a solid surface. Drag forces tend to decrease fluid velocity relative to the solid object in the fluid's path.",
		sections = {
			{
				"Overview",
