			{ "Worked at", "[[Royal Botanic Gardens, Kew]]" },
			{ "Education", "Christ Church, [[University of Oxford|Oxford]]" },
			{ "Known for", "Voyage of HMS Endeavour, exploration of Botany Bay" },
		},
