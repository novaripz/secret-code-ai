        <Properties>
          <string name="Name">Inventions</string>
          <string name="Source"><![CDATA[-- Inventions, engineering, vehicles and everyday objects.
return {
	{
		title = "Invention",
		category = "Invention",
		fame = 1,
		emoji = "💡",
		tags = { "Technology", "History of technology" },
		aliases = { "Inventions", "Inventor" },
		summary = "An **invention** is a new device, method or process. Some inventions, like the [[Wheel|wheel]] and the [[Printing press|printing press]], changed the course of history.",
		sections = {
			{
				"Famous inventors",
				"[[Thomas Edison]], [[Nikola Tesla]] and the [[Wright brothers]] are among the best-known inventors.",
			},
			{
				"Accidents",
				"Some inventions, like [[Penicillin|penicillin]] and the [[Popcorn|microwave popcorn]] trick, were discovered by accident.",
			},
		},
		infobox = { { "Protected by", "Patents" }, { "Oldest tools", "Stone tools, ~3.3 million years ago" } },
		related = { "Engineering", "Transport", "Refrigerator", "Umbrella", "Zipper" },
	},
	{
		title = "Wheel",
		category = "Invention",
		fame = 2,
		emoji = "☸️",
		tags = { "Ancient inventions" },
		summary = "The **wheel** is a circular device that turns on an axle. It was invented around 3500 BC in Mesopotamia, first for making pottery.",
		sections = {
			{
				"Impact",
				"Wheels made carts, the [[Bicycle|bicycle]], the [[Car|car]] and the [[Train|train]] possible. Its shape is a [[Circle|circle]].",
			},
		},
		infobox = { { "Invented", "~3500 BC" }, { "Shape", "[[Circle]]" } },
	},
	{
		title = "Printing press",
		category = "Invention",
		fame = 2,
		emoji = "🖨️",
		tags = { "Inventions", "Printing" },
		summary = "The **printing press** is a machine that presses inked type onto [[Paper|paper]]. [[Johannes Gutenberg]]'s press of about 1440 made [[Book|books]] cheap for the first time.",
		sections = {
			{ "Impact", "It spread knowledge quickly and helped fuel the [[Renaissance]] and modern science." },
		},
		infobox = { { "Inventor", "[[Johannes Gutenberg]]" }, { "Year", "~1440" } },
	},
	{
		title = "Johannes Gutenberg",
		category = "Person",
		fame = 3,
		emoji = "🖨️",
		tags = { "Inventors", "German people" },
		aliases = { "Gutenberg" },
		summary = "**Johannes Gutenberg** was a German goldsmith who invented movable-type [[Printing press|printing]] in Europe around 1440.",
		sections = {
			{ "Bible", "His Gutenberg Bible was one of the first major [[Book|books]] printed with movable type." },
		},
		infobox = { { "Born", "~1400, [[Germany]]" }, { "Invention", "[[Printing press]]" } },
	},
	{
