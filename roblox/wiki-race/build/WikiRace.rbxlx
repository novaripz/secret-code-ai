			{ "Population", "537,952" },
		},
	},
	{
		title = "Vienna",
		category = "City",
		fame = 1,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Capital and largest city of Austria",
		tags = { "Europe and Russia", "Western Europe" },
		summary = "**Vienna** is the [[Capital city|capital]], most populous city, and one of the nine states of [[Austria]]. It is Austria's [[Primate city|primate city]], with just over two million inhabitants. Its larger [[Metropolitan area|metropolitan area]] has a population of nearly 2.9 million, representing nearly one-third of the country's population. Vienna is the cultural, economic, and political centre of the country, the fifth-largest city by population in the [[European Union]], and the most populous of the cities on the river Danube.",
		sections = {
			{
				"Overview",
				"The city lies on the eastern edge of the Vienna Woods (Wienerwald), the northeasternmost foothills of the [[Alps]], that separate Vienna from the more western parts of Austria, at the transition to the Pannonian Basin. It sits on the [[Danube]], and is traversed by the highly regulated Wienfluss (Vienna River). Vienna is completely surrounded by Lower Austria, and lies around 50 km (31 mi) west of [[Slovakia]] and its capital [[Bratislava]], 50 km (31 mi) northwest of [[Hungary]], and 60 km (37 mi) south of [[Moravia]] ([[Czech Republic]]). The Romans founded a castrum at Vienna, which they called Vindobona, in the 1st century, when the region belonged to the province of [[Pannonia]]. It was elevated to a municipium with Roman city rights in 212.",
			},
		},
		infobox = {
			{ "Area", "414.78 km²" },
			{ "Elevation", "151–542 m" },
			{ "Population", "2,028,499" },
		},
	},
	{
		title = "Vientiane",
		category = "City",
		fame = 2,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Capital of Laos",
		tags = { "Asia", "Southeast Asia" },
		summary = "**Vientiane** is the [[Capital city|capital]] and largest city of [[Laos]]. Comprising the 5 [[Metropolitan area|urban]] districts of Vientiane Prefecture, the city is located on the banks of the [[Mekong]], close to the border with [[Thailand]]. Vientiane was the administrative capital during French rule. The city had a population of 840,000 as of the 2023 census. Pha That Luang, an icon of Buddhism, is located in Vientiane. Other Buddhist temples can be found there, such as Haw Phra Kaew, which formerly housed the Emerald Buddha.",
		related = { "Mandalay" },
		infobox = {
			{ "Area", "3,920 km²" },
			{ "Elevation", "174 m" },
