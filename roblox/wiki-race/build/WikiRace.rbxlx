			{ "People are called", "Bermudian" },
			{ "Capital", "Hamilton" },
			{ "Largest city", "St. George's" },
			{ "Government", "[[Representative democracy|Parliamentary democracy]]" },
			{ "Area", "53.2 km²" },
		},
	},
	{
		title = "Bihar",
		category = "Geography",
		fame = 1,
		emoji = "🏔️",
		source = "wikipedia",
		description = "State in Eastern India",
		tags = { "Asia", "India" },
		summary = "**Bihar** is a [[States and union territories of India|state]] in eastern India. It borders [[Uttar Pradesh]] to its west, [[Nepal]] to the north, the northern part of [[West Bengal]] to the east, and [[Jharkhand]] to the south. Bihar is split by the river [[Ganges]], which flows from west to east. It is the second largest state by population, the 12th largest by area, and the 14th largest by GDP in 2024. The official language on Bihar is [[Hindi]], which shares official status alongside that of [[Urdu]]. The main native languages are [[Maithili language|Maithili]], Magahi and [[Bhojpuri language|Bhojpuri]], but there are several other languages being spoken at smaller levels.",
		sections = {
			{
				"Overview",
				"Bihar played a central role in the history and development of Buddhism. According to Buddhist tradition, the Buddha attained enlightenment in Bodh Gaya at the Mahabodhi Temple, a [[World Heritage Site|UNESCO World Heritage Site]]. Early Buddhist schools, such as Nalanda and Vikramashila emerged in Bihar as major centres of Buddhist learning, attracting students and scholars from across Asia. Under dynasties including the Mauryas and [[Gupta Empire|Guptas]], Buddhism received royal patronage and expanded from the region to other parts of Asia. Since the late 1970s, Bihar has lagged far behind other Indian states in terms of social and economic development. Economists and social scientists claim that this is a direct result of the policies of the [[Government of India|central government]]: such as the freight equalisation policy, its apathy towards Bihar, lack of Bihari sub-nationalism, and the Permanent Settlement of 1793 by the [[East India Company|British East India Company]].",
			},
		},
		infobox = {
			{ "Type", "State" },
			{ "Region", "East India" },
			{ "Capital", "Patna" },
			{ "Area", "98940 km²" },
			{ "Length", "345 km" },
			{ "Elevation", "53 m" },
		},
	},
	{
		title = "Black Sea",
		category = "Geography",
		fame = 1,
		emoji = "🌊",
		source = "wikipedia",
		description = "Eurasian sea northeast of the Mediterranean",
		tags = { "Bodies of water", "Oceans and seas" },
		summary = "The **Black Sea** is a marginal sea located between [[Europe]] and [[Asia]], east of the [[Balkans]], south of the [[East European Plain]], west of the [[Caucasus]], and north of [[Anatolia]]. It is bordered by [[Bulgaria]], [[Georgia (country)|Georgia]], [[Romania]], [[Russia]], [[Turkey]], and [[Ukraine]]. The Black Sea is supplied by major rivers, principally the [[Danube]], [[Dnieper]] and Dniester. Consequently, while six countries have a coastline on the sea, its [[Drainage basin|drainage basin]] includes parts of 24 countries in Europe.",
		sections = {
			{
				"Overview",
				"The Black Sea, not including the [[Sea of Azov]], covers 436400 km², has a maximum depth of 2212 m, and a volume of 547000 km³. Most of its coasts ascend rapidly. These rises are the Pontic Mountains to the south, the southwest-facing peninsulas, the [[Caucasus Mountains]] to the east, and the Crimean Mountains to the mid-north. In the west, the coast is generally small [[Floodplain|floodplains]] below foothills such as the Strandzha; Cape Emine, a dwindling of the east end of the [[Balkan Mountains]]; and the Dobruja Plateau considerably farther north. The longest east–west extent is about 1175 km. Important cities along the coast include (clockwise from the [[Bosporus]]) the northern suburbs of [[Istanbul]], Burgas, Varna, Constanța, [[Odesa]], Yevpatoria, Sevastopol, Yalta, Kerch, Novorossiysk, Sochi, Poti, Batumi, Rize, Trabzon, Ordu, Samsun and Zonguldak.",
			},
		},
		infobox = {
			{ "Location", "[[Eastern Europe]] and [[West Asia]]" },
			{ "Type", "[[Ocean|Sea]]" },
			{ "Length", "1175 km" },
			{ "Area", "436400 km²" },
			{ "Deepest point", "2212 m" },
			{ "Depth", "1253 m" },
			{ "Volume", "547000 km³" },
		},
	},
	{
		title = "Blue Nile",
		category = "Geography",
		fame = 2,
		emoji = "🏞️",
		source = "wikipedia",
		description = "Major river flowing across Ethiopia and Sudan",
		tags = { "Rivers", "Africa" },
		summary = "The **Blue Nile** is a [[River|river]] originating at Lake Tana in [[Ethiopia]]. It travels for approximately 1,450 km through Ethiopia and [[Sudan]]. Along with the [[White Nile]], it is one of the two major [[Tributary|tributaries]] of the [[Nile]] and supplies about 85.6% of the water to the Nile during the [[Wet season|rainy season]].",
		infobox = {
			{ "Mouth", "[[Nile|Nile River]]" },
