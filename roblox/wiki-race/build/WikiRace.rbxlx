	{
		title = "Geopolitics",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Study of geography's effects on politics",
		tags = { "More articles" },
		summary = "**Geopolitics** is the study of the effects of Earth's [[Geography|geography]] on [[Politics|politics]] and [[International relations|international relations]]. Geopolitics usually refers to countries and relations between them; it may also focus on two other kinds of [[State (polity)|states]]: de facto independent states with limited international recognition and relations between [[Administrative division|sub-national geopolitical entities]], such as the [[Federated state|federated states]] that make up a [[Federation|federation]], [[Confederation|confederation]], or a quasi-federal system.",
		sections = {
			{
				"Overview",
				"At the level of international relations, geopolitics is a method of studying foreign policy to understand, explain, and predict international political behavior through geographical variables. These include area studies, [[Climate|climate]], [[Topography|topography]], [[Demography|demography]], natural resources, and [[Applied science|applied science]] of the region being evaluated. Geopolitics focuses on [[Power (political science)|political power]] linked to geographic space, in particular, territorial waters, land territory and [[Wealth|wealth]] of [[Natural resource|natural resources]], in correlation with diplomatic history, in particular the context of a larger power relative to its neighboring states of smaller or similar power.",
			},
