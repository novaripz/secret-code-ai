	{
		title = "Billy Wilder",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Austrian and American filmmaker (1906–2002)",
		tags = { "Directors", "US and Canada" },
		summary = "**Billy Wilder** was an Austrian and American film director and screenwriter. His career in Hollywood spanned five decades, and he is regarded as one of America's most versatile filmmakers. He received seven [[Academy Awards]] (among 21 nominations), a BAFTA Award and the [[Palme d'Or]].",
		sections = {
			{
				"Overview",
				"Wilder was born into a Polish-Jewish family in Sucha, Galicia, Austria-Hungary. In 1916, he moved to Vienna, where he worked as a journalist instead of attending university. Wilder's career as a screenwriter started in Berlin, where he relocated in his early adulthood. Wilder moved to Hollywood in 1934, and had a major hit when he, Charles Brackett and Walter Reisch wrote the screenplay for Ninotchka (1939). He established a reputation as a director and received his first nomination for the Academy Award for Best Director with Double Indemnity (1944), a film noir he cowrote with [[Raymond Chandler]]. Wilder won Academy Awards for Best Director, Best Screenplay and Best Picture for The Lost Weekend (1945).",
			},
		},
		related = { "Francis Ford Coppola", "Martin Scorsese" },
		infobox = {
			{ "Born", "22 June 1906" },
			{ "Birthplace", "Sucha, Austria-Hungary (now in Poland)" },
			{ "Died", "27 March 2002" },
			{ "Citizenship", "U.S. (from 1939)" },
			{ "Occupation", "Film director, screenwriter, producer" },
			{ "Years active", "1929–1981" },
		},
