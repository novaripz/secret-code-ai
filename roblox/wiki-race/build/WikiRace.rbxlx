return {
	{
		title = "Synonym (taxonomy)",
		category = "Science",
		fame = 2,
		emoji = "🔬",
		source = "wikipedia",
		description = "Scientific name that also applies to a taxon",
		tags = { "More articles" },
		summary = "In [[Taxonomy (biology)|biological taxonomy]], a **synonym** is one of two or more scientific names that apply to the same [[Taxon|taxon]]. The botanical and zoological codes of nomenclature treat the concept of synonymy differently.",
		sections = {
			{
				"Overview",
				"In botanical nomenclature, a synonym is a [[Binomial nomenclature|scientific name]] that applies to a taxon that now goes by a different scientific name. For example, [[Carl Linnaeus|Linnaeus]] was the first to give a scientific name (under the currently used system of scientific nomenclature) to the Norway spruce, which he called Pinus abies. This name is no longer in use, so it is now a synonym of the current scientific name, Picea abies. In zoology, moving a species from one genus to another results in a different [[Binomial nomenclature|binomen]], but the name is considered an alternative combination rather than a synonym.",
			},
		},
	},
	{
		title = "Synthetic element",
		category = "Science",
		fame = 2,
		emoji = "🧪",
		source = "wikipedia",
		description = "Chemical elements that do not occur naturally",
		tags = { "Chemical elements", "Chemical element groups" },
		summary = "The synthetic elements are those with atomic numbers 95–118, as shown in purple on the accompanying [[Periodic table|periodic table]]: these 24 elements were first created between 1944 and 2010. The mechanism for the creation of a synthetic element is to force additional protons into the [[Atomic nucleus|nucleus]] of an element with an [[Atomic number|atomic number]] lower than 95. All known (see: Island of stability) synthetic elements are unstable, but they [[Radioactivity|decay]] at widely varying rates; the half-lives of their longest-lived isotopes range from microseconds to millions of years.",
		sections = {
			{
				"Overview",
				"Six more elements that were first created artificially are strictly speaking not synthetic because they were later found in nature in trace quantities: [[Technetium|technetium]] (43Tc), [[Promethium|promethium]] (61Pm), [[Astatine|astatine]] (85At), [[Neptunium|neptunium]] (93Np), [[Plutonium|plutonium]] (94Pu), and [[Curium|curium]] (96Cm); although they are sometimes classified as synthetic alongside exclusively artificial elements. The first, technetium, was created in 1937. Plutonium, first synthesized in 1940, is another such element. It is the element with the largest number of protons (atomic number) to occur in nature, but it does so in such tiny quantities that it is far more practical to synthesize it. No elements with atomic numbers greater than 99 have any uses outside of scientific research, since they have extremely short half-lives, and thus have never been produced in large quantities.",
			},
		},
	},
	{
		title = "Tadpole",
		category = "Science",
		fame = 2,
		emoji = "🔬",
		source = "wikipedia",
		description = "Larval stage in the life cycle of an amphibian",
		tags = { "Biological processes and physiology", "Animal ontogeny" },
		aliases = { "Polliwog", "Porwigle" },
		summary = "A **tadpole** or **polliwog** (also **porwigle**) is the [[Larva|larval stage]] in the [[Biological life cycle|biological life cycle]] of an [[Amphibian|amphibian]]. Most tadpoles are fully [[Aquatic animal|aquatic]], though some species of amphibians have tadpoles that are [[Terrestrial animal|terrestrial]]. Tadpoles have some [[Fish|fish]]-like features that may not be found in adult amphibians, such as a lateral line, [[Gill|gills]] and swimming [[Tail|tails]]. As they undergo [[Metamorphosis|metamorphosis]], they start to develop functional [[Lung|lungs]] for breathing air, and the diet of tadpoles changes drastically.",
		sections = {
			{
				"Overview",
				'A few amphibians, such as some members of the [[Frog|frog]] family Brevicipitidae, undergo direct development – i.e., they do not undergo a free-living larval stage as tadpoles – instead emerging from eggs as fully formed "froglet" miniatures of the adult [[Morphology (biology)|morphology]]. Some other species hatch into tadpoles underneath the skin of the female adult or are kept in a pouch until after metamorphosis. Having no hard skeletons, it might be expected that tadpole [[Fossil|fossils]] would not exist. However, traces of biofilms have been preserved and fossil tadpoles have been found dating back to the [[Middle Jurassic]]. Tadpoles are eaten as [[Human food|human food]] in some parts of the world and are mentioned in various [[Folklore|folk tales]] from around the world.',
			},
		},
	},
	{
		title = "Taiga",
		category = "Science",
		fame = 2,
		emoji = "🌲",
		source = "wikipedia",
		description = "Biome characterized by coniferous forests",
		tags = { "Biomes", "Forests" },
		aliases = { "Tayga", "Boreal forest", "Snow forest" },
		summary = "**Taiga** or **tayga**, also known as **boreal forest** or **snow forest**, is a [[Biome|biome]] characterized by [[Conifer|coniferous]] [[Forest|forests]] consisting mostly of [[Pine|pines]], [[Spruce|spruces]], and larches.",
		sections = {
			{
				"Overview",
				"The taiga, or boreal forest, is the world's largest land [[Biome|biome]]. In North America, it covers most of inland [[Canada]], [[Alaska]], and parts of the northern contiguous United States. In [[Eurasia]], it covers most of [[Sweden]], [[Finland]], much of [[Russia]] from Karelia in the west to the [[Pacific Ocean]] (including much of [[Siberia]]), much of [[Norway]], some lowland/coastal areas of [[Iceland]], and areas of northern [[Kazakhstan]], northern [[Mongolia]], and northern [[Japan]] (on the island of [[Hokkaido]]). The principal tree species, depending on the length of the growing season and summer temperatures, vary across the world. The taiga of North America is mostly [[Spruce|spruce]]; [[Scandinavia|Scandinavian]] and [[Finland|Finnish]] taiga consists of a mix of spruce, [[Pine|pines]], and birch; Russian taiga has spruces, pines, and larches depending on the region; and the Eastern Siberian taiga is a vast larch forest.",
			},
		},
	},
	{
		title = "Talc",
		category = "Science",
		fame = 3,
		emoji = "💎",
		source = "wikipedia",
		description = "Phyllosilicate mineral in the pyrophyllite-talc group",
		tags = { "Geology", "Mineralogy" },
		aliases = { "Talcum" },
		summary = "**Talc**, or **talcum**, is a clay mineral composed of [[Hydrate|hydrated]] [[Magnesium|magnesium]] [[Silicate|silicate]], with the [[Chemical formula|chemical formula]] Mg3Si4O10(OH)2. Talc in powdered form, often combined with corn starch, is used as baby powder. This mineral is used as a thickening agent and [[Lubricant|lubricant]]. It is an ingredient in [[Ceramic|ceramics]], [[Paint|paints]], and roofing material. It is a main ingredient in many [[Cosmetics|cosmetics]]. It occurs as foliated to [[Fiber|fibrous]] masses, and in an exceptionally rare [[Crystal|crystal]] form. It has a perfect basal cleavage and an uneven flat fracture, and it is foliated with a two-dimensional platy form.",
		sections = {
			{
				"Overview",
				"The Mohs scale of mineral hardness, based on scratch hardness comparison, defines value 1 as the hardness of talc, the softest mineral. When scraped on a streak plate, talc produces a white streak, though this indicator is of little importance, because most silicate minerals produce a white streak. Talc is translucent to opaque, with colors ranging from whitish grey to green with a vitreous and pearly [[Lustre (mineralogy)|luster]]. Talc is not soluble in water, and is slightly soluble in dilute mineral acids. Soapstone is a [[Metamorphic rock|metamorphic rock]] composed predominantly of talc.",
			},
		},
		infobox = {
			{ "Category", "Phyllosilicate minerals" },
			{ "Formula", "Mg3Si4O10(OH)2" },
			{ "Colour", "Light to dark green, brown, white, grey, colorless" },
		},
	},
	{
		title = "Tannin",
		category = "Science",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Class of astringent, bitter plant polyphenolic chemical compounds",
		tags = { "Chemical compounds", "Carbon–oxygen bond" },
		aliases = { "Tannins", "Tannoids" },
		summary = "**Tannins** (or **tannoids**) are a class of astringent, polyphenolic [[Biomolecule|biomolecules]] that bind to and precipitate [[Protein|proteins]] and various other organic compounds including [[Amino acid|amino acids]] and [[Alkaloid|alkaloids]]. The term tannin is widely applied to any large polyphenolic compound containing sufficient hydroxyls and other suitable groups (such as carboxyls) to form strong compounds with various [[Macromolecule|macromolecules]].",
		sections = {
			{
				"Overview",
				"The term tannin refers to the abundance of these compounds in [[Oak|oak]] [[Bark (botany)|bark]], which was used in tanning animal [[Hide (skin)|hides]] into [[Leather|leather]]. The tannin compounds are widely distributed in many species of plants, where they play a role in protection from [[Predation|predation]] (acting as [[Pesticide|pesticides]]) and might help in regulating plant growth. Likewise, the destruction or modification of tannins with time plays an important role when determining harvesting times. Tannins have molecular weights ranging from 500 to over 3,000 (gallic acid [[Ester|esters]]) and up to 20,000 [[Dalton (unit)|daltons]] (proanthocyanidins).",
			},
		},
	},
	{
		title = "Tantalum",
		category = "Science",
		fame = 2,
		emoji = "🧪",
		source = "wikipedia",
		description = "Chemical element with atomic number 73",
		tags = { "Chemical elements" },
		aliases = { "Ta" },
		summary = "**Tantalum** is a [[Chemical element|chemical element]]; it has [[Chemical symbol|symbol]] **Ta** and [[Atomic number|atomic number]] 73. It is named after Tantalus, a figure in Greek mythology. Tantalum is a very hard, [[Ductility|ductile]], [[Lustre (mineralogy)|lustrous]], blue-gray [[Transition metal|transition metal]] that is highly corrosion-resistant. It is part of the refractory metals group, which are widely used as components of strong high-melting-point alloys. It is a group 5 element, along with [[Vanadium|vanadium]] and [[Niobium|niobium]], and it always occurs in geologic sources together with the chemically similar niobium, mainly in the [[Mineral|mineral]] groups tantalite and columbite (coltan).",
		sections = {
			{
				"Overview",
				"The chemical inertness and very high melting point of tantalum make it valuable for laboratory and industrial equipment such as reaction vessels and vacuum furnaces. It is used in tantalum capacitors for electronic equipment such as computers. It is being investigated for use as a material for high-quality [[Superconductivity|superconducting]] resonators in quantum processors.",
			},
		},
		related = { "Aluminium", "Uranium" },
	},
	{
		title = "Tau (particle)",
		category = "Science",
		fame = 3,
		emoji = "🔬",
		source = "wikipedia",
		description = "Elementary subatomic particle with negative electric charge",
		tags = { "Subatomic particles", "Fermions" },
		aliases = { "Tau", "Tau lepton", "Tauon" },
		summary = 'The **tau**, also called the **tau lepton**, **tau particle** or **tauon**, is an [[Elementary particle|elementary particle]] similar to the electron, with negative [[Electric charge|electric charge]] and a spin of 1/2. Like the [[Electron|electron]], the [[Muon|muon]], and the three [[Neutrino|neutrinos]], the tau is a [[Lepton|lepton]], and like all elementary particles with half-integer spin, the tau has a corresponding [[Antiparticle|antiparticle]] of opposite charge but equal [[Mass|mass]] and spin. In the tau\'s case, this is the "antitau" (also called the positive tau). Tau particles are denoted by the symbol − and the antitaus by +.',
		sections = {
			{
				"Overview",
				"Because their interactions are very similar to those of the electron, a tau can be thought of as a much heavier version of the electron. Due to their greater mass, tau particles do not emit as much [[Bremsstrahlung|bremsstrahlung (braking radiation)]] as electrons; consequently they are potentially much more highly penetrating than electrons. Because of its short lifetime, the range of the tau is mainly set by its decay length, which is too small for bremsstrahlung to be noticeable. Its penetrating power appears only at ultra-high velocity and energy (above [[Electronvolt|petaelectronvolt]] energies), when time dilation extends its otherwise very short path-length. As with the case of the other charged leptons, the tau has an associated tau neutrino, denoted by.",
			},
		},
		infobox = {
			{ "Discovered", "Martin Lewis Perl et al. (1975)" },
		},
	},
	{
		title = "Taxonomy (biology)",
		category = "Science",
		fame = 1,
		emoji = "🧬",
		source = "wikipedia",
		description = "Science of classifying organisms",
		tags = { "Genetics and taxonomy" },
		aliases = { "Taxonomy" },
		summary = "In [[Biology|biology]], **taxonomy** is the [[Science|scientific]] study of naming, defining (circumscribing) and classifying groups of biological [[Organism|organisms]] based on shared characteristics. Modern approaches prioritize common ancestry and evolutionary relationships. Organisms are grouped into [[Taxon|taxa]] (singular: taxon), and these groups are given a [[Taxonomic rank|taxonomic rank]]; groups of a given rank can be aggregated to form a more inclusive group of higher rank, thus creating a taxonomic hierarchy. The principal ranks in modern use are [[Domain (taxonomy)|domain]], [[Kingdom (taxonomy)|kingdom]], [[Phylum|phylum]] (division is sometimes used in botany in place of phylum), [[Class (taxonomy)|class]], [[Order (taxonomy)|order]], [[Family (taxonomy)|family]], [[Genus|genus]], and [[Species|species]].",
		sections = {
			{
				"Overview",
				"The Swedish botanist [[Carl Linnaeus]] is regarded as the founder of the current system of taxonomy, having developed a ranked system known as Linnaean taxonomy for categorizing organisms. With advances in the theory, data and analytical technology of biological systematics, the Linnaean system has transformed into a system of modern biological classification intended to reflect the [[Evolution|evolutionary]] relationships among organisms, both living and extinct.",
			},
		},
	},
	{
		title = "Technetium",
		category = "Science",
		fame = 3,
		emoji = "🔬",
		source = "wikipedia",
		tags = { "Chemical elements" },
		aliases = { "Tc" },
		summary = "**Technetium** is a [[Chemical element|chemical element]]; it has [[Chemical symbol|symbol]] **Tc** and [[Atomic number|atomic number]] 43. It is the lightest element whose [[Isotope|isotopes]] are all radioactive. Technetium is one of only two radioactive elements both preceded and succeeded in the periodic table by elements with stable forms, the other being [[Promethium|promethium]]. All available technetium is produced as a [[Synthetic element|synthetic element]]. Naturally occurring technetium is a spontaneous fission product in uranium ore and [[Thorium|thorium]] ore (the most common source), or the product of neutron capture in [[Molybdenum|molybdenum]] ores.",
		sections = {
			{
				"Overview",
				"This silvery gray, crystalline [[Transition metal|transition metal]] lies between [[Manganese|manganese]] and [[Rhenium|rhenium]] in group 7 of the [[Periodic table|periodic table]], and its chemical properties are intermediate between the two. The most common naturally occurring isotope is 99Tc, in traces only. Many of technetium's properties had been predicted by [[Dmitri Mendeleev]] before it was discovered; Mendeleev noted a gap in his periodic table and gave the undiscovered element the provisional name ekamanganese (Em). In 1937, technetium became the first predominantly artificial element to be produced, hence its name. One short-lived [[Gamma ray|gamma-ray]]–emitting nuclear isomer, technetium-99m, is used in nuclear medicine for a wide variety of tests, such as bone cancer diagnoses. The ground state of the [[Nuclide|nuclide]] technetium-99 is used as a gamma-ray–free source of [[Beta particle|beta particles]].",
			},
		},
		related = { "Holmium" },
	},
	{
		title = "Tellurium",
		category = "Science",
		fame = 2,
		emoji = "🔬",
		source = "wikipedia",
		tags = { "Chemical elements" },
		aliases = { "Te" },
		summary = "**Tellurium** is a [[Chemical element|chemical element]]; it has the [[Chemical symbol|symbol]] **Te** and [[Atomic number|atomic number]] 52. Tellurium is chemically related to [[Selenium|selenium]] and [[Sulfur|sulfur]], all three of which are [[Chalcogen|chalcogens]]. It is occasionally found in its native form as elemental crystals. Tellurium is far more common in the universe as a whole than on Earth. Its extreme [[Abundance of the chemical elements|rarity]] in the Earth's crust, comparable to that of [[Platinum|platinum]], is due partly to its formation of a volatile hydride that caused tellurium to be lost to space as a gas during the [[Nebular hypothesis|hot nebular]] formation of Earth.",
		sections = {
			{
				"Overview",
				"Tellurium-bearing compounds were first discovered in 1782 in a gold mine in Kleinschlatten, [[Transylvania]] (now Zlatna, [[Romania]]) by Austrian mineralogist Franz-Joseph Müller von Reichenstein, although it was Martin Heinrich Klaproth who named the new element in 1798 after the Latin 'earth'. Gold telluride minerals are the most notable natural gold compounds. However, they are not a commercially significant source of tellurium itself, which is normally extracted as a by-product of [[Copper|copper]] and [[Lead|lead]] production. Commercially, the primary use of tellurium is CdTe solar panels and thermoelectric devices. A more traditional application in copper (tellurium copper) and steel [[Alloy|alloys]], where tellurium improves machinability, also consumes a considerable portion of tellurium production.",
			},
		},
	},
	{
		title = "Temperate broadleaf and mixed forests",
		category = "Science",
