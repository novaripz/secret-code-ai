			{ "Languages", "[[English language|English]], Papiamento, West Frisian" },
			{ "People are called", "Dutch" },
			{ "Government", "[[Constitutional monarchy]] comprising four autonomous constituent countries" },
		},
	},
	{
		title = "Korea Strait",
		category = "Geography",
		fame = 3,
		emoji = "🌊",
		source = "wikipedia",
		description = "Sea passage between Japan and South Korea",
		tags = { "Bodies of water", "Straits" },
		summary = "The **Korea Strait** is a [[Strait|sea passage]] in [[East Asia]] between the Korean Peninsula and [[Japan]]. It connects the [[East China Sea]], the [[Yellow Sea]] and the [[Sea of Japan]] in the northwest [[Pacific Ocean]]. The strait is split by Tsushima Island into two parts: the Western Channel, and the Tsushima Strait or Eastern Channel. It is economically important, as many shipping lanes pass through the strait, and both Japan and South Korea allow free passage through it.",
		sections = {
			{
				"Overview",
				"In ancient times, both Buddhism and Mongol invaders passed over the strait to reach Japan. More recently, it was the site of the 1950 Battle of Korea Strait during the Korean War. A tunnel running underneath the strait connecting Japan and Korea, the Japan–Korea Undersea Tunnel, has been proposed to connect the two countries.",
			},
		},
