		emoji = "🎶",
		tags = { "Reggae musicians", "Jamaican people" },
		summary = "**Bob Marley** was a Jamaican singer and songwriter who made [[Reggae|reggae]] famous worldwide with songs like 'One Love' and 'Three Little Birds'.",
		sections = { { "Legacy", "He remains a symbol of [[Jamaica]] and of peace." } },
		infobox = { { "Born", "1945, [[Jamaica]]" }, { "Genre", "[[Reggae]]" } },
	},
	{
