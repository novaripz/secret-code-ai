		emoji = "🏔️",
		tags = { "Mountains", "Himalayas" },
		aliases = { "Everest", "Chomolungma" },
		summary = "**Mount Everest** is the highest mountain above sea level on [[Earth]], standing 8,849 m tall in the [[Himalayas]].",
		sections = {
			{
				"First ascent",
				"Edmund Hillary and Tenzing Norgay first reached the summit in 1953. Climbers often carry bottled [[Oxygen|oxygen]].",
			},
		},
		infobox = { { "Height", "8,849 m" }, { "Range", "[[Himalayas]]" } },
	},
	{
		title = "Himalayas",
		category = "Geography",
		fame = 2,
		emoji = "⛰️",
		tags = { "Mountain ranges" },
		aliases = { "Himalaya" },
		summary = "The **Himalayas** are a mountain range in [[Asia]] separating [[India]] from the Tibetan Plateau. They contain [[Mount Everest]].",
		sections = {
			{
				"Formation",
				"They are still rising because the Indian plate keeps pushing into Asia, causing [[Earthquake|earthquakes]].",
			},
		},
		infobox = { { "Highest peak", "[[Mount Everest]]" }, { "Length", "2,400 km" } },
	},
	{
