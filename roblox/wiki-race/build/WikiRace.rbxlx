			{ "Language", "[[Latin]]" },
			{ "Genre", "[[Lyric poetry]]" },
			{ "Notable works", 'Odes "The Art of Poetry"' },
		},
	},
	{
		title = "Horace Greeley",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American politician and publisher (1811–1872)",
		tags = { "Journalists" },
		summary = "**Horace Greeley** (February 3, 1811 – November 29, 1872) was an American newspaper editor and publisher who was the founder and editor of the New-York Tribune. Long active in politics, he served briefly as a congressman from New York and was the unsuccessful candidate of the new Liberal Republican Party in the 1872 presidential election against incumbent President Ulysses S. Grant.",
		sections = {
			{
				"Overview",
				'Greeley was born to a poor family in Amherst, New Hampshire. He was apprenticed to a printer in Vermont and went to New York City in 1831 to seek his fortune. He wrote for or edited several publications, involved himself in Whig Party politics, and took a significant part in William Henry Harrison\'s successful 1840 presidential campaign. The following year, Greeley founded the Tribune, which became the highest-circulating newspaper in the country through weekly editions sent by mail. Among many other issues, he urged the settlement of the American Old West, seeing it as a land of opportunity for the young and the unemployed. Greeley popularized the slogan "Go West, young man, and grow up with the country." He endlessly promoted radical reforms such as [[Socialism|socialism]], [[Vegetarianism|vegetarianism]], agrarianism, [[Feminism|feminism]], and temperance and hired a wide variety of people.',
			},
		},
		related = { "William Randolph Hearst", "Joseph Pulitzer" },
		infobox = {
			{ "Born", "3 February 1811" },
			{ "Birthplace", "Amherst, New Hampshire, U.S." },
			{ "Died", "29 November 1872" },
		},
	},
	{
		title = "Howard Hawks",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American film director (1896–1977)",
		tags = { "Directors", "US and Canada" },
		aliases = { "Howard Winchester Hawks" },
		summary = '**Howard Winchester Hawks** (May 30, 1896 – December 26, 1977) was an American film director, producer, and screenwriter of the [[Classical Hollywood cinema|classic Hollywood era]]. The critic Leonard Maltin called him "the greatest American director who is not a household name." Roger Ebert called Hawks "one of the greatest American directors of pure movies, and a hero of auteur critics because he found his own laconic values in so many different kinds of genre material." He was nominated for the Academy Award for Best Director for Sergeant York (1941) and earned the Honorary Academy Award in 1974.',
		sections = {
			{
				"Overview",
				'A versatile director, Hawks explored many genres such as comedies, dramas, gangster films, science fiction, film noir, war films and Westerns. His most popular films include Scarface (1932), Bringing Up Baby (1938), Only Angels Have Wings (1939), His Girl Friday (1940), To Have and Have Not (1944), The Big Sleep (1946), Red River (1948), The Thing from Another World (1951), Gentlemen Prefer Blondes (1953), and Rio Bravo (1959). His frequent portrayals of strong, tough-talking female characters came to define the "Hawksian woman". His work has influenced such directors as Peter Bogdanovich, [[Martin Scorsese]], Robert Altman, John Carpenter, Rainer Werner Fassbinder, [[Clint Eastwood]], Quentin Tarantino, Greta Gerwig and Michael Mann.',
			},
		},
		related = { "Billy Wilder", "Fritz Lang", "John Ford", "William Wyler" },
		infobox = {
