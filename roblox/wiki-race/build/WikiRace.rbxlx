		tags = { "Condensed matter physics", "Phase transitions" },
		summary = "**Freezing** is a [[Phase transition|phase transition]] in which a [[Liquid|liquid]] turns into a [[Solid|solid]] when its [[Temperature|temperature]] is lowered below its freezing point.",
		sections = {
			{
				"Overview",
				"For most substances, the melting and freezing points are the same temperature; however, certain substances possess differing solid-liquid transition temperatures. For example, agar displays a hysteresis in its [[Melting point|melting point]] and freezing point. It melts at 85 °C and solidifies from 32 to 40 °C.",
