	{
		title = "Smart Cities Mission",
		category = "Concept",
		fame = 3,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Indian government plan for urban development",
		tags = { "More articles" },
		summary = "**Smart Cities Mission** is an urban renewal and retrofitting program by the [[Government of India]] with the mission to develop smart cities across the country, making them citizen-friendly and sustainable. The Union Ministry of Urban Development was responsible for implementing the mission in collaboration with the state governments of the respective cities. In 2017, the ministry was merged with the ministry of housing and urban poverty alleviation to form the Ministry of Housing and Urban Affairs.",
		sections = {
			{
				"Overview",
				"The mission was planned to include 100 cities, with an initial project completion deadline of 2019, later revised to 2023. As of January 2025, 7,479 out of a total of 8,058 tendered projects had been completed, utilizing ₹1500.05 of the total allocated amount of ₹1643.68. The project was officially shut down on 31 March 2025.",
			},
		},
		infobox = {
			{ "Country", "India" },
		},
