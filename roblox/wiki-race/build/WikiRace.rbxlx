	{
		title = "École normale supérieure (Paris)",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Institution of higher learning in Paris, France",
		tags = { "More articles" },
		aliases = { "PSL", "École Normale Supérieure" },
		summary = "The – **PSL** is a grande école in [[Paris]], [[France]]. It is one of the constituent members of Paris Sciences et Lettres University (PSL). Due to its selectivity, historical role, and influence within French society, the ENS is generally considered the most prestigious of the grandes écoles, as well as one of the most prestigious higher education institutions in France. Its pupils are generally referred to as normaliens, while its alumni are sometimes referred to as archicubes.",
		sections = {
			{
				"Overview",
				"The school was founded in 1794 during the [[French Revolution]], to provide homogeneous training of high-school [[Teacher|teachers]] in France, but it later closed. The school was subsequently reestablished by Napoleon I as pensionnat normal from 1808 to 1822, before being recreated in 1826 and taking the name École normale in 1830. When other institutes called écoles normales were created in 1845, the word supérieure was added to form the current name. In 1936, the institution started providing university-level education. As a grande école, the vast majority of the academic staff hosted at the ENS also belong to external institutions such as one of the Parisian universities, the CNRS and the EHESS. Generalistic in its recruitment and organisation, the ENS is the only grande école in France to have departments of research in all the natural, social, and human sciences.",
			},
		},
		infobox = {
			{ "Established", "1794" },
			{ "Part of", "PSL University" },
			{ "Type", "École normale supérieure, grande école, EPSCP" },
			{ "Director", "Frédéric Worms" },
			{ "Country", "[[France]]" },
		},
	},
	{
		title = "Étienne Geoffroy Saint-Hilaire",
		category = "Concept",
		fame = 3,
		emoji = "💭",
		source = "wikipedia",
		description = "French naturalist (1772–1844)",
		tags = { "More articles" },
		summary = "**Étienne Geoffroy Saint-Hilaire** was a French [[Natural history|naturalist]] who established the principle of \"unity of composition\". He was a colleague of [[Jean-Baptiste Lamarck]] and expanded and defended Lamarck's evolutionary theories. Geoffroy's scientific views had a transcendental flavor (unlike Lamarck's materialistic views) and were similar to those of German morphologists like Lorenz Oken. He believed in the underlying unity of organismal design, and the possibility of the transmutation of species in time, amassing evidence for his claims through research in comparative anatomy, paleontology, and embryology. He is considered as a predecessor of the evo-devo evolutionary concept.",
		infobox = {
			{ "Born", "15 April 1772" },
			{ "Birthplace", "Étampes, [[Kingdom of France|France]]" },
			{ "Died", "19 June 1844" },
			{ "Field", "[[Natural history]]" },
			{ "Worked at", "Muséum National d'Histoire Naturelle" },
		},
	},
	{
		title = "Abkhazia",
		category = "Country",
		fame = 3,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Partially recognised state in the South Caucasus",
		tags = { "Countries", "Asia" },
		aliases = { "Republic of Abkhazia" },
		summary = "**Abkhazia**, officially the **Republic of Abkhazia**, is a partially recognised state in the [[South Caucasus]], which is internationally recognised by most countries as part of [[Georgia (country)|Georgia]]. It sits on the eastern coast of the [[Black Sea]] in [[West Asia]]. It covers 8665 km² and has a population of around 245,000. Its capital and largest city is Sukhumi.",
		sections = {
			{
				"Overview",
				"The region had autonomy as the Abkhaz Autonomous Soviet Socialist Republic within the Georgian Soviet Socialist Republic at the time when the [[Dissolution of the Soviet Union|Soviet Union began to disintegrate]] in the late 1980s. The political status of Abkhazia is the central issue of the Abkhazia conflict and Georgia–Russia relations. Abkhazia is formally recognised as an independent state by four UN member states ([[Russia]], [[Venezuela]], [[Nicaragua]], and [[Syria]]), with three other states having previously recognised but withdrawn their recognition ([[Tuvalu]], [[Vanuatu]] and [[Nauru]]). The remainder of the international community recognises Abkhazia as [[De facto and de jure|de jure]] part of [[Georgia (country)|Georgia]]. Lacking effective control over the Abkhazian territory, Georgia maintains an Abkhaz government-in-exile.",
			},
		},
		infobox = {
			{ "Capital", "Sukhumi" },
			{ "Largest city", "capital" },
			{ "Official languages", "Abkhaz, [[Russian language|Russian]]" },
