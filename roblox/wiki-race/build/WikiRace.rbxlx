	},
	{
		title = "Orion Nebula",
		category = "Space",
		fame = 2,
		emoji = "🌌",
		source = "wikipedia",
		description = "Diffuse nebula in the constellation Orion",
		tags = { "Astronomical objects", "Notable nebulae" },
		aliases = { "Messier 42", "M42", "NGC 1976" },
		summary = 'The **Orion Nebula** (also known as **Messier 42**, **M42**, or **NGC 1976**) is a diffuse nebula in the [[Milky Way]] situated south of Orion\'s Belt in the [[Constellation|constellation]] of [[Orion (constellation)|Orion]], and is known as the middle "star" in the "sword" of Orion. It is 1,267.0 ± 5.4 light-years away and is the closest region of massive [[Star formation|star formation]] to [[Earth]]. M42 is estimated to be 25 light-years across (so its apparent size from Earth is approximately 1 degree). It has a mass of about 2,000 times that of the [[Sun]]. Older texts frequently refer to the Orion Nebula as the **Great Nebula** in Orion or the **Great Orion Nebula**.',
		sections = {
			{
				"Overview",
				"The Orion Nebula is one of the most scrutinized and photographed objects in the night sky and is among the most intensely studied celestial features. The nebula has revealed much about the process of how [[Star|stars]] and [[Planet|planetary]] systems are formed from collapsing clouds of gas and dust. Astronomers have directly observed protoplanetary disks and [[Brown dwarf|brown dwarfs]] within the nebula, intense and [[Turbulence|turbulent motions]] of the gas, and the photo-ionizing effects of massive nearby stars in the nebula.",
			},
