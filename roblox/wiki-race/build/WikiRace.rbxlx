			{
				"Style",
				"[[Romanesque architecture|Romanesque]], [[Gothic architecture|Gothic]], [[Renaissance architecture|Renaissance]]",
			},
			{ "Completed", "1436 (except 19th century façade)" },
			{ "Length", "153 m" },
		},
	},
