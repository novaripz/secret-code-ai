		emoji = "🚗",
		source = "wikipedia",
		description = "Motorsport involving the racing of cars for competition",
		tags = { "Sports", "Other individual sports" },
		aliases = { "Car racing", "Motor racing", "Automobile racing" },
		summary = "**Auto racing** (also known as **car racing**, **motor racing**, or **automobile racing**) is a motorsport involving the racing of automobiles for competition. In North America, the term is commonly used to describe all forms of automobile sport including non-racing disciplines.",
		sections = {
			{
				"Overview",
