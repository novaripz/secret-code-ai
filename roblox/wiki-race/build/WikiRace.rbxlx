		aliases = { "Online Etymology Dictionary" },
		summary = "The **Online Etymology Dictionary**, also known by its domain name **Etymonline**, is an American online dictionary of the [[Etymology|origins]] and historical development of [[English language|English]] words, compiled and written primarily by Douglas R. Harper. Harper founded the project in 2001. Since 2021, Talia Felix has served as associate editor.",
		infobox = {
