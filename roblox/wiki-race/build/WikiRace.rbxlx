		fame = 2,
		emoji = "🌍",
		source = "wikipedia",
		description = "Online taxonomic plant database",
		tags = { "More articles" },
		aliases = { "POWO" },
		summary = "**Plants of the World Online** (**POWO**) is an online [[Taxonomy (biology)|taxonomic]] [[Database|database]] published by the [[Royal Botanic Gardens, Kew]].",
		infobox = {
