		description = "Family of ray-finned fish",
		tags = { "Vertebrates", "Fishes" },
		aliases = { "Sticklebacks", "Gasterosteidae" },
		summary = "The **sticklebacks** are a [[Family (taxonomy)|family]] of [[Actinopterygii|ray-finned fishes]], the **Gasterosteidae** which have a Holarctic distribution in fresh, brackish and marine waters. They were thought to be related to the pipefish and [[Seahorse|seahorses]] but are now thought to be more closely related to the eelpouts and sculpins.",
		related = { "Osteichthyes", "Coelacanth" },
		infobox = {
