		tags = { "More articles" },
		aliases = { "Prefecture" },
		summary = "In [[France]], a **prefecture** may be: the, the [[Communes of France|commune]] in which the administration of a [[Departments of France|department]] is located; the, the commune in which the administration of a [[Regions of France|region]] is located; the jurisdiction of a prefecture; the official residence or headquarters of a prefect.",
		sections = {
			{
				"Overview",
