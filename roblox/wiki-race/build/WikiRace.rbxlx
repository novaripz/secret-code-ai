	{
		title = "Ernest Hemingway",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American author and journalist (1899–1961)",
		tags = { "Americas", "US and Canada" },
		aliases = { "Ernest Miller Hemingway" },
		summary = "**Ernest Miller Hemingway** was an American novelist, short-story writer, and journalist. Known for an economical, understated style that influenced later 20th-century writers, he has been romanticized for his adventurous lifestyle and outspoken, blunt public image. Some of his seven novels, six short-story collections and two non-fiction works have become classics of [[American literature]], and he was awarded the 1954 Nobel Prize in Literature.",
		sections = {
			{
				"Overview",
				'Hemingway was raised in Oak Park, Illinois. After high school, he spent six months as a reporter for The Kansas City Star before enlisting in the Red Cross. In 1921, Hemingway moved to Paris, where he worked as a foreign correspondent for the Toronto Star and was influenced by the modernist writers and artists of the "Lost Generation" expatriate community. His debut novel, The Sun Also Rises, was published in 1926. In 1928, Hemingway returned to the U.S., where he settled in Key West, Florida. His experiences during the war supplied material for his 1929 novel A Farewell to Arms. In 1937, Hemingway went to Spain to cover the Spanish Civil War, which formed the basis for his 1940 novel For Whom the Bell Tolls, written in [[Havana]], Cuba. During [[World War II]], Hemingway was present with Allied troops as a journalist at the Normandy landings and the liberation of Paris.',
			},
		},
		related = { "Jack London", "Stephen King" },
		infobox = {
			{ "Born", "21 July 1899" },
			{ "Birthplace", "Oak Park, Illinois, U.S." },
			{ "Died", "2 July 1961" },
		},
	},
	{
		title = "Ernest Lawrence",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American physicist (1901–1958)",
		tags = { "Physics", "Modern" },
		aliases = { "Ernest Orlando Lawrence" },
		summary = "**Ernest Orlando Lawrence** (August 8, 1901 – August 27, 1958) was an American [[Physicist|physicist]] who received the [[Nobel Prize in Physics]] in 1939 for his invention of the [[Cyclotron|cyclotron]]. He is known for his work on uranium-isotope separation for the Manhattan Project, as well as for founding the Lawrence Berkeley National Laboratory and the Lawrence Livermore National Laboratory.",
		sections = {
			{
				"Overview",
				"A graduate of the University of South Dakota and University of Minnesota, Lawrence obtained a PhD in physics at Yale in 1925. In 1928, he was hired as an associate professor of physics at the [[University of California, Berkeley]], becoming the youngest full professor there two years later. In its library one evening, Lawrence was intrigued by a diagram of an accelerator that produced [[Particle physics|high-energy particles]]. He contemplated how it could be made compact, and came up with an idea for a circular accelerating chamber between the poles of an [[Electromagnet|electromagnet]]. The result was the first cyclotron. Lawrence went on to build a series of ever larger and more expensive cyclotrons. His Radiation Laboratory became an official department of the University of California in 1936, with Lawrence as its director.",
			},
		},
		related = { "Amedeo Avogadro" },
		infobox = {
			{ "Born", "8 August 1901" },
			{ "Birthplace", "Canton, South Dakota, U.S." },
			{ "Died", "27 August 1958" },
			{ "Known for", "Invention of the [[Cyclotron|cyclotron]]" },
		},
	},
	{
		title = "Ernest Rutherford",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "New Zealand physicist and chemist (1871–1937)",
		tags = { "Physics", "Modern" },
		aliases = { "Ernest Rutherford, 1st Baron Rutherford of Nelson" },
		summary = '**Ernest Rutherford, 1st Baron Rutherford of Nelson** (30 August 1871 – 19 October 1937), was a New Zealand [[Physicist|physicist]] and [[Chemist|chemist]] who was a pioneering researcher in both [[Atomic physics|atomic]] and [[Nuclear physics|nuclear physics]]. He has been described as "the father of nuclear physics" and "the greatest experimentalist since [[Michael Faraday]]." In 1908, he was awarded the [[Nobel Prize in Chemistry]] "for his investigations into the disintegration of the elements, and the chemistry of radioactive substances."',
		sections = {
			{
				"Overview",
				"Rutherford's discoveries include the concept of radioactive [[Half-life|half-life]], the radioactive element [[Radon|radon]], and the differentiation and naming of [[Alpha decay|alpha]] and [[Beta particle|beta radiation]]. Together with Thomas Royds, Rutherford is credited with proving that alpha radiation is composed of [[Helium|helium]] nuclei. In 1911, he theorised that [[Atom|atoms]] have their [[Electric charge|charge]] concentrated in a very small [[Atomic nucleus|nucleus]]. He arrived at this theory through his discovery and interpretation of Rutherford scattering during the gold foil experiment performed by Hans Geiger and Ernest Marsden. In 1912, he invited [[Niels Bohr]] to join his lab, leading to the [[Bohr model]] of the atom. In 1917, he performed the first artificially induced [[Nuclear reaction|nuclear reaction]] by conducting experiments in which nitrogen nuclei were bombarded with alpha particles.",
			},
		},
		infobox = {
			{ "Born", "30 August 1871" },
			{ "Birthplace", "Brightwater, Nelson Province, Colony of New Zealand" },
			{ "Died", "19 October 1937" },
		},
	},
	{
		title = "Ernest Shackleton",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Anglo-Irish Antarctic explorer (1874–1922)",
		tags = { "Explorers", "Modern" },
		aliases = { "Sir Ernest Henry Shackleton" },
		summary = "**Sir Ernest Henry Shackleton** (15 February 1874 – 5 January 1922) was an Anglo-Irish Antarctic explorer who led three British expeditions to the [[Antarctic]]. He was one of the principal figures of the period known as the Heroic Age of Antarctic Exploration.",
		sections = {
			{
				"Overview",
				"Born in Kilkea, County Kildare, Ireland, Shackleton and his Anglo-Irish family moved to Sydenham in suburban south London when he was ten. Also, members of his team climbed Mount Erebus, the most active Antarctic volcano. On returning home, Shackleton was knighted for his achievements by King Edward VII. After the race to the South Pole ended in December 1911, with [[Roald Amundsen]]'s conquest, Shackleton turned his attention to the crossing of Antarctica from sea to sea, via the pole. The expedition was struck by disaster when its ship, became trapped in pack ice and finally sank in the Weddell Sea off Antarctica on 21 November 1915. The crew escaped by camping on the sea ice until it disintegrated, then by launching the lifeboats to reach Elephant Island and ultimately the South Atlantic island of South Georgia, enduring a stormy ocean voyage of 720 nmi in Shackleton's most famous exploit.",
			},
		},
		related = { "Edmund Hillary", "Valentina Tereshkova" },
		infobox = {
			{ "Born", "15 February 1874" },
			{ "Birthplace", "Kilkea, County Kildare, Ireland" },
			{ "Died", "5 January 1922" },
			{ "Education", "Dulwich College" },
		},
	},
	{
		title = "Ernst Haeckel",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "German zoologist (1834–1919)",
		tags = { "Biology", "Modern" },
		aliases = { "Ernst Heinrich Philipp August Haeckel" },
		summary = '**Ernst Heinrich Philipp August Haeckel** was a German zoologist, [[Natural history|naturalist]], [[Eugenics|eugenicist]], [[Philosophy|philosopher]], physician, professor, marine biologist and artist. He discovered, described and named thousands of new species, mapped a genealogical tree relating all life forms and coined many terms in [[Biology|biology]], including [[Ecology|ecology]], [[Phylum|phylum]], [[Phylogenetic tree|phylogeny]], [[Ontogeny|ontogeny]], and Protista. Haeckel promoted and popularised [[Charles Darwin]]\'s work in Germany and developed the disproven but influential recapitulation theory (summed up by the dictum "ontogeny recapitulates phylogeny"), later generalizing it into the so called "Biogenetic Law".',
		sections = {
			{
				"Overview",
				'He wrongly claimed that an individual organism\'s biological development, or [[Ontogeny|ontogeny]], parallels and summarizes its species\' evolutionary development, or [[Phylogenetic tree|phylogeny]], using incorrectly drawn images of human embryonic development to derive the law. Whether they were intentionally falsified, or drawn poorly by accident is a matter of debate. The published artwork of Haeckel includes over 100 detailed, multi-colour illustrations of animals and sea creatures, collected in his [[Kunstformen der Natur]] ("Art Forms in Nature"), a book which would go on to influence the [[Art Nouveau]] artistic movement. As a philosopher, Ernst Haeckel wrote Die Welträthsel (1895–1899; in English: The Riddles of the Universe, 1900), the genesis for the term "world riddle" (Welträtsel); and Freedom in Science and Teaching to support teaching evolution. He also coined the "Biogenetic Law".',
			},
		},
		related = { "Jane Goodall" },
		infobox = {
			{ "Born", "16 February 1834" },
			{ "Birthplace", "Potsdam, [[Kingdom of Prussia]]" },
			{ "Died", "9 August 1919" },
			{ "Worked at", "[[University of Jena]]" },
			{
				"Education",
				"[[Humboldt University of Berlin|University of Berlin]], University of Würzburg, [[University of Jena]]",
			},
			{ "Citizenship", "German Empire" },
			{ "Fields", "Zoology, Natural History, Eugenics, Philosophy, Marine Biology" },
		},
	},
	{
		title = "Ernst Mach",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Austrian physicist, philosopher and university educator (1838–1916)",
		tags = { "Physics", "Modern" },
		aliases = { "Ernst Waldfried Josef Wenzel Mach" },
		summary = "**Ernst Waldfried Josef Wenzel Mach** was an Austrian [[Physicist|physicist]] and [[Philosophy|philosopher]] who contributed to the understanding of the physics of shock waves. The ratio of the speed of a flow or object to [[Speed of sound|that of sound]] is named the Mach number in his honor. As a [[Philosophy of science|philosopher of science]], he was a major influence on logical positivism and American pragmatism. Through his criticism of [[Isaac Newton]]'s theories of space and time, he foreshadowed [[Albert Einstein]]'s [[Theory of relativity|theory of relativity]].",
		infobox = {
			{ "Born", "18 February 1838" },
