	{
		title = "Maritime history",
		category = "History",
		fame = 3,
		emoji = "🧍",
		source = "wikipedia",
		description = "Study of human activity at sea",
		tags = { "History by subject matter", "History of science and technology" },
		summary = "**Maritime history** is the study of human interaction with and activity at sea. It covers a broad thematic element of [[History|history]] that often uses a global approach, although national and regional histories remain predominant. As an academic subject, it often crosses the boundaries of standard [[Academic discipline|disciplines]], focusing on understanding humankind's various relationships to the oceans, seas, and major [[Waterway|waterways]] of the globe. Nautical history records and interprets past events involving ships, shipping, navigation, and seafarers.",
		sections = {
			{
				"Overview",
				"Maritime history is the broad overarching subject that includes [[Fishing|fishing]], [[Whaling|whaling]], international maritime law, naval history, the history of [[Ship|ships]], ship design, [[Shipbuilding|shipbuilding]], the history of [[Navigation|navigation]], the history of the various maritime-related sciences ([[Oceanography|oceanography]], [[Cartography|cartography]], [[Hydrography|hydrography]], etc.), sea exploration, maritime economics and trade, shipping, yachting, seaside resorts, the history of [[Lighthouse|lighthouses]] and aids to navigation, maritime themes in literature, maritime themes in art, the social history of sailors and passengers and sea-related communities. There are a number of approaches to the field, sometimes divided into two broad categories: Traditionalists, who seek to engage a small audience of other academics, and Utilitarians, who seek to influence policy makers and a wider audience.",
			},
		},
		related = { "History of sport" },
	},
}
