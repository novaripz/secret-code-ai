		description = "French polymath (1596–1650)",
		tags = { "Philosophers", "Early modern" },
		summary = "**René Descartes** was a French [[Polymath|polymath]], active across philosophy, including [[Metaphysics|metaphysics]], [[Epistemology|epistemology]], ethics, and the philosophy of science; theology; mathematics, in which he connected the previously separate fields of [[Geometry|geometry]] and [[Algebra|algebra]] into [[Analytic geometry|analytic geometry]]; science, including physics, [[Optics|optics]], mechanics, cosmology, and meteorology; physiology; and medicine. He has been credited as the father of [[Modern philosophy|modern philosophy]], particularly due to his transformation of methodology by introducing a systematic, method-based approach to pursuing knowledge.",
		sections = {
			{
				"Overview",
				'Refusing to accept the authority of previous philosophers, Descartes frequently set his views apart from the philosophers who preceded him. In the opening section of the Passions of the Soul, an [[Early modern period|early modern]] treatise on emotions, Descartes goes so far as to assert that he will write on this topic "as if no one had written on these matters before." His best-known philosophical statement is "" ("I think, therefore I am", ). He was one of the key figures in the [[Scientific Revolution]], and his Meditations on First Philosophy and other philosophical works continue to be studied. His influence in mathematics is equally apparent: the [[Cartesian coordinate system]] is named after him. Descartes is also credited as the father of analytic geometry, which facilitated the discovery of infinitesimal [[Calculus|calculus]] and [[Mathematical analysis|analysis]].',
			},
		},
		related = { "Gotthold Ephraim Lessing" },
		infobox = {
			{ "Era", "17th-century philosophy [[Age of Enlightenment]]" },
			{ "Birthplace", "La Haye-en-Touraine, France" },
			{ "Died", "11 February 1650" },
			{
				"Main interests",
				"[[Epistemology]], [[Metaphysics|metaphysics]], [[Mathematics|mathematics]], [[Physics|physics]], [[Cosmology|cosmology]], [[Ethics|ethics]]",
			},
		},
	},
