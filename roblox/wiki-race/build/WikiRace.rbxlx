		tags = { "Family members" },
		aliases = { "Twins" },
		summary = "**Twins** are two [[Offspring|offspring]] produced by the same pregnancy. Twins can be either monozygotic ('identical'), meaning that they develop from one [[Zygote|zygote]], which splits and forms two [[Embryo|embryos]], or dizygotic ('non-identical' or 'fraternal'), meaning that each twin develops from a separate egg and each egg is fertilized by its own sperm cell. In very rare cases, fraternal or (semi-) identical twins can have the same mother and different fathers.",
		sections = {
