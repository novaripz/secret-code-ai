		tags = { "Bodies of water", "Canals" },
		aliases = { "Grand Canal" },
		summary = "The **Grand Canal** is a system of interconnected [[Canal|canals]] linking various major [[River|rivers]] and [[Lake|lakes]] in [[North China|North]] and [[East China]], serving as an important [[Maritime transport|waterborne transport]] [[Infrastructure|infrastructure]] between the north and the south during [[History of China|Medieval]] and [[Post-classical history|premodern]] [[China]]. It is the longest artificial [[Waterway|waterway]] in the world and a [[World Heritage Site]].",
		sections = {
			{
				"Overview",
