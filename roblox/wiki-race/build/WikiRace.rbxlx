			{ "Birthplace", "Kufa, [[Abbasid Caliphate]]" },
			{ "Died", "c. 873 (aged approximately 72)" },
		},
	},
	{
		title = "Al-Nasir Muhammad",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Mamluk Sultan of Egypt from 1293 to 1294",
		tags = { "Post-classical", "Africa" },
		aliases = { "Al-Malik an-Nasir Nasir ad-Din Muhammad ibn Qalawun", "An-Nasir Muhammad", "Abu al-Ma'ali" },
		summary = "**Al-Malik an-Nasir Nasir ad-Din Muhammad ibn Qalawun**, commonly known as **an-Nasir Muhammad**, or by his kunya: **Abu al-Ma'ali** or as **Ibn Qalawun** (1285–1341) was the ninth Mamluk sultan of the Bahri dynasty who ruled [[Egypt]] between 1293–1294, 1299–1309, and 1310 until his death in 1341. During his first reign, he was overthrown by Kitbugha and al-Shuja‘i, and during his second reign by Baybars I and Sayf al-Din Salar.",
		sections = {
			{
				"Overview",
				"An-Nasir appointed loyal non-Mamluks to senior military positions and removed officers whose loyalty he doubted. He annulled taxes and surcharges imposed on commoners for the benefit of the emirs and officials. He appointed Emir Ibn al-Waziri as the head of the Court of Justice to fight corruption.",
			},
		},
		related = { "Baybars", "Askia Muhammad I" },
