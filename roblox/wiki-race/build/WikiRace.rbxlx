			{ "Education", "[[University of Paris]]" },
			{ "Occupation", "Industrial designer" },
			{ "Years active", "1909–1980" },
		},
	},
	{
		title = "Rembrandt",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Dutch painter and printmaker (1606–1669)",
		tags = { "Western painters and illustrators", "Renaissance to early modern era" },
		summary = "He is generally considered one of the greatest visual artists in the history of [[Art of Europe|Western art]]. It is estimated that Rembrandt's surviving works amount to about three hundred paintings, three hundred etchings, and several hundred drawings.",
		sections = {
			{
				"Overview",
				"Unlike most Dutch painters of the 17th century, Rembrandt's works depict a wide range of styles and subject matter, from portraits and self-portraits to landscapes, genre scenes, allegorical and historical scenes, biblical and mythological subjects and animal studies. His contributions to art came in a period that historians call the [[Dutch Golden Age]]. Rembrandt never went abroad, but was considerably influenced by the work of the Italian Old Masters and Dutch and Flemish artists who had studied in Italy. After he achieved youthful success as a portrait painter, Rembrandt's later years were marked by personal tragedy and financial hardships. Yet his etchings and paintings were popular throughout his lifetime; his reputation as an artist remained high, and for twenty years he taught many important Dutch painters.",
			},
		},
		related = { "Nicolas Poussin", "Jacques-Louis David" },
		infobox = {
			{ "Born", "15 July 1606" },
			{ "Birthplace", "[[Leiden]], [[Dutch Republic]]" },
			{ "Died", "4 October 1669" },
			{ "Field", "[[Painting]], [[Printmaking|printmaking]], [[Drawing|drawing]]" },
			{ "Movement", "Dutch Golden Age Baroque" },
		},
	},
