	{
		title = "European Space Agency",
		category = "Space",
		fame = 2,
		emoji = "🧭",
		source = "wikipedia",
		description = "European organisation dedicated to space exploration",
		tags = { "Space", "Programs" },
		summary = "The **European Space Agency** is a 23-member [[International organization|international organisation]] devoted to [[Space exploration|space exploration]]. It has its headquarters in Paris and a staff of around 3,000 people globally as of 2025. ESA was founded in 1975 in the context of [[European integration]]. Its 2026 annual budget was around €8.3 billion.",
		sections = {
			{
				"Overview",
				"The ESA [[Human spaceflight|human spaceflight]] programme includes participation in the [[International Space Station]] (ISS) and collaboration with [[NASA]] on the [[Artemis program|Artemis]] programme, especially manufacturing of the Orion spacecraft's European Service Module (ESM). ESA launches and operates uncrewed missions to the Moon, Mars, Jupiter, Venus, Mercury, the Sun, and various comets and asteroids. Other activities include space telescopes, Earth observation satellites, asteroid impact avoidance, [[Communications satellite|telecommunication]] and [[Satellite navigation|navigation]] satellites, designing [[Launch vehicle|launch vehicles]] (e.g. Ariane 6 is operated through Arianespace with ESA sharing in the costs), and maintaining Europe's spaceport (the Guiana Space Centre in Kourou, French Guiana), as well as space safety and commercialisation.",
			},
		},
		infobox = {
			{ "Headquarters", "Paris, France" },
			{ "Language", "English, French and German (working languages)" },
		},
