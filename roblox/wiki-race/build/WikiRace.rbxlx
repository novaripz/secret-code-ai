	{
		title = "Gottlob Frege",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German philosopher, logician, and mathematician (1848–1925)",
		tags = { "Mathematicians", "Modern" },
		aliases = { "Friedrich Ludwig Gottlob Frege" },
		summary = "**Friedrich Ludwig Gottlob Frege** was a German philosopher, logician, and mathematician. He was a mathematics professor at the [[University of Jena]], and is understood by many to be the father of [[Analytic philosophy|analytic philosophy]], concentrating on the [[Philosophy of language|philosophy of language]], logic, and [[Philosophy of mathematics|mathematics]]. Though he was largely ignored during his lifetime, Giuseppe Peano (1858–1932), [[Bertrand Russell]] (1872–1970), and, to some extent, [[Ludwig Wittgenstein]] (1889–1951) introduced his work to later generations of philosophers. Frege is widely considered to be one of the greatest logicians since [[Aristotle]], and one of the most profound philosophers of mathematics ever.",
		sections = {
			{
				"Overview",
				'His contributions include the development of modern logic in the Begriffsschrift and work in the [[Foundations of mathematics|foundations of mathematics]]. His book the Foundations of Arithmetic is the seminal text of the logicist project, and is cited by Michael Dummett as where to pinpoint the [[Linguistic turn|linguistic turn]]. His philosophical papers "On Sense and Reference" and "The Thought" are also widely cited. The former argues for two different types of meaning and descriptivism. In Foundations and "The Thought", Frege argues for Platonism against psychologism or formalism, concerning [[Number|numbers]] and [[Proposition|propositions]] respectively.',
			},
		},
		infobox = {
			{ "Region", "[[Western philosophy]]" },
			{ "Era", "[[19th-century philosophy|19th-]]/[[Contemporary philosophy|20th-century philosophy]]" },
			{ "Born", "8 November 1848" },
			{ "Birthplace", "Wismar, Grand Duchy of Mecklenburg-Schwerin, [[German Confederation]]" },
			{ "Died", "26 July 1925" },
			{
				"Education",
				"[[University of Göttingen]] ([[Doctor of Philosophy|PhD]], 1873) [[University of Jena]] ([[Habilitation|Dr. phil. hab.]], 1874)",
			},
