	{
		title = "Americas",
		category = "Geography",
		fame = 1,
		emoji = "🏔️",
		source = "wikipedia",
		description = "Landmass comprising North and South America",
		tags = { "Basics", "Continents" },
		aliases = { "The Americas" },
		summary = 'The **Americas**, sometimes collectively called **America**, are a landmass comprising the totality of [[North America]] and [[South America]]. When viewed as a single continent, the Americas are the second largest continent by area after Asia and the third largest continent by population. The Americas make up most of the land in Earth\'s [[Western Hemisphere]] and constitute the "[[New World]]", in contrast to the "[[Old World]]" of [[Afro-Eurasia]].',
		sections = {
			{
				"Overview",
				"Along with their associated islands, the Americas cover 8% of Earth's total surface area and 28.4% of its land area. The topography is dominated by the American Cordillera, a long chain of mountains that runs the length of the west coast. The flatter eastern side of the Americas is dominated by large river basins, such as the [[Amazon basin|Amazon]], [[St. Lawrence River]]–[[Great Lakes]], Mississippi, and La Plata basins. Since the Americas extend 14000 km from north to south, the climate and ecology vary widely, from the arctic [[Tundra|tundra]] of [[Northern Canada]], [[Greenland]], and [[Alaska]], to the [[Tropical rainforest|tropical rainforests]] in [[Central America]] and South America. Humans first settled the Americas from Asia between 20,000 and 16,000 years ago. A second migration of Na-Dene speakers followed later from Asia.",
			},
		},
		infobox = {
			{ "Area", "42,549,000 km2 (16,428,000 sq mi)" },
			{ "People are called", "American (see usage)" },
		},
	},
	{
		title = "Amu Darya",
		category = "Geography",
		fame = 2,
		emoji = "🏞️",
		source = "wikipedia",
		description = "River in Central Asia",
		tags = { "Rivers", "Asia" },
		aliases = { "Oxus" },
		summary = "The **Amu Darya**, historically known as the **Oxus**, is a major river in [[Central Asia]] which flows through [[Afghanistan]], [[Tajikistan]], [[Turkmenistan]], and [[Uzbekistan]]. Rising in the [[Pamir Mountains]], north of the [[Hindu Kush]], the Amu Darya is formed by the confluence of the Vakhsh and Panj rivers, in the Tigrovaya Balka Nature Reserve on the border between Afghanistan and [[Tajikistan]], and flows from there north-westwards into the southern remnants of the [[Aral Sea]]. However, today the Amu Darya does not reach the Aral Sea, and its mouth is in a dried-up area, of what was once the Aral Sea.",
		sections = {
			{
				"Overview",
				"In its upper course, the river forms part of Afghanistan's northern border with Tajikistan, Uzbekistan, and Turkmenistan. In [[Ancient history|ancient history]], the river was regarded as the boundary of [[Greater Iran]] with Turan, which roughly corresponded to present-day Central Asia. The Amu Darya has a flow of about 70 cubic kilometres per year on average.",
			},
		},
		infobox = {
			{ "Name origin", "Named for the city of Amul (now Türkmenabat)" },
			{ "Length", "2400 km" },
			{ "Source", "Pamir River/Panj River" },
			{ "Mouth", "[[Aral Sea]]" },
		},
	},
	{
		title = "Amur",
		category = "Geography",
		fame = 3,
		emoji = "🏞️",
		source = "wikipedia",
		description = "Major river in the Russian Far East and Northeast Asia",
		tags = { "Rivers", "Asia" },
		aliases = { "Amur River", "Heilong River" },
		summary = "The **Amur River** or **Heilong River** is a perennial river in Northeast Asia, forming the natural border between the [[Russian Far East]] and [[Northeast China]] (historically the Outer and Inner Manchuria). The Amur proper is 2824 km long, and has a [[Drainage basin|drainage basin]] of 1,855,000 km². If including its [[Main stem|main stem]] tributary, the Argun, the Amur is 4,444 km long, making it the world's tenth longest river.",
		sections = {
			{
				"Overview",
				"The Amur is an important river for the [[Aquatic animal|aquatic]] [[Animal|fauna]] of Northeast Asia. The river basin is home to a variety of large predatory fish such as northern snakehead, Amur pike, taimen, Amur catfish, predatory carp and yellowcheek, as well as several species of [[Trout|trout]] and [[Fish migration|anadromous]] salmonids. The largest fish species in the Amur is the kaluga, a [[Sturgeon|sturgeon]] that is one of the largest [[Freshwater fish|freshwater fish]] in the world, attaining a length as great as 5.6 m. The Amur is also home to the northernmost populations of the Amur softshell turtle and Indian lotus.",
			},
		},
		infobox = {
