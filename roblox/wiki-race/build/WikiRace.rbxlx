        <Properties>
          <string name="Name">Games</string>
          <string name="Source"><![CDATA[-- Video games, consoles and characters.
return {
	{
		title = "Video game",
		category = "Video Game",
		fame = 1,
		emoji = "🎮",
		tags = { "Video games", "Entertainment" },
		aliases = { "Video games", "Gaming", "Computer game" },
		summary = "A **video game** is an interactive game played on a [[Computer|computer]], console or [[Smartphone|phone]]. Games are now one of the biggest forms of entertainment.",
		sections = {
			{
				"History",
				"Early hits like [[Pong]] and [[Pac-Man]] filled arcades in the 1970s and 80s. [[Nintendo]] revived home gaming with [[Super Mario]].",
			},
			{
				"Today",
				"[[Minecraft]] is the best-selling game ever, while [[Roblox]] and [[Fortnite]] are huge online platforms. Competitive gaming is called [[Esports|esports]].",
			},
		},
		infobox = { { "First commercial game", "1971" }, { "Best-selling", "[[Minecraft]]" } },
		related = { "Game controller", "Grand Theft Auto", "Sega", "Sonic the Hedgehog" },
