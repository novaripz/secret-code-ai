	{
		title = "Albert A. Michelson",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American physicist (1852–1931)",
		tags = { "Physics", "Modern" },
		aliases = { "Albert Abraham Michelson" },
		summary = "**Albert Abraham Michelson** (December 19, 1852 – May 9, 1931) was an American experimental [[Physicist|physicist]] known for his work on measuring the [[Speed of light|speed of light]] and especially for the [[Michelson–Morley experiment]]. In 1907, he received the [[Nobel Prize in Physics]], becoming the first American to win the Nobel Prize in a science. He was the founder and the first head of the physics departments of the Case School of Applied Science and the [[University of Chicago]].",
		related = { "Satyendra Nath Bose", "Michael Faraday" },
		infobox = {
