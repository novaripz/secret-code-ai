	{
		title = "Domestic turkey",
		category = "Animal",
		fame = 3,
		emoji = "🦃",
		source = "wikipedia",
		description = "Species of bird",
		tags = { "Birds", "Galliformes" },
		aliases = { "Meleagris gallopavo domesticus" },
		summary = "The **domestic turkey** (**Meleagris gallopavo domesticus**) is a large fowl, one of the two [[Species|species]] in the [[Genus|genus]] Meleagris and the same species as the wild turkey. Turkey domestication was thought to have occurred in central Mesoamerica at least 2,000 years ago,. The main domestic turkey varieties today descend from the turkey raised in central Mexico that was subsequently imported into Europe by the Spanish in the 16th century.",
		sections = {
			{
				"Overview",
				'The domestic turkey is a popular form of [[Poultry|poultry]]. It is raised throughout temperate parts of the world, partially because industrialized farming has made it very cheap for the amount of meat it produces. Female domestic turkeys are called hens, and the chicks are poults or turkeylings. In Canada and the United States, male turkeys are called toms. In the United Kingdom and Ireland, they are stags. The fleshy protuberance atop the beak is the snood and the one attached to the underside of the beak is known as a wattle. The [[Turkey (bird)|English-language name for this species]] results likely from an early misidentification of the bird with an unrelated species, guineafowl, which was imported to England through [[Turkey|the country of Turkey]]. The Latin species name gallopāvō means "chicken peacock".',
			},
		},
		related = { "Common quail" },
		infobox = {
			{ "Scientific name", "Meleagris gallopavo" },
			{ "Conservation status", "Domesticated" },
		},
	},
	{
		title = "Dominance (ecology)",
		category = "Animal",
		fame = 2,
		emoji = "🐾",
		source = "wikipedia",
		description = "Measure of species' ecological influence",
		tags = { "More articles" },
		aliases = { "Ecological dominance" },
		summary = "**Ecological dominance** is the degree to which one or several species have a major influence controlling the other species in their ecological community (because of their large size, population, productivity, or related factors) or make up more of the [[Biomass (ecology)|biomass]]. Both the composition and abundance of species within an ecosystem can be affected by the dominant species present.",
		sections = {
			{
				"Overview",
				'In most of the world\'s ecosystems, biologists have repeatedly observed a rank-abundance curve in which ecosystems comprise a handful of incredibly abundant species, but more numerous, rarer species that are few in number. Danish botanist Christen C. Raunkiær described this phenomenon as his "law of frequency" in 1918, in which he recognized that in communities with a single species accounting for most of the biomass, species diversity was often lower. Understandably, biologists expect to see more profound effects from those species greater in number. First formalized as the mass ratio hypothesis in a 1998 paper by English ecologist J. Philip Grime, ecologically dominant species are predicted to have overwhelming effects on ecosystem function and ecological processes due to their relatively high biomass and ubiquity. Most ecological communities are defined by their dominant species.',
			},
		},
	},
	{
		title = "Donkey",
		category = "Animal",
		fame = 3,
		emoji = "🐴",
		source = "wikipedia",
		description = "Domesticated animal primarily used for transportation",
		tags = { "Mammals", "Perissodactyla" },
		aliases = { "Ass" },
		summary = "The **donkey** or **ass** is a domesticated equine. It derives from the African wild ass, Equus africanus, and may be classified either as a subspecies thereof, **Equus africanus asinus**, or as a separate [[Species|species]], **Equus asinus**. It was domesticated in Africa some 5,000 years ago, and has been used mainly as a [[Working animal|working animal]] since that time.",
		sections = {
			{
				"Overview",
				"There are more than 40 million donkeys in the world, mostly in underdeveloped countries, where they are used principally as draught or pack animals. While [[Working animal|working]] donkeys are often associated with those living at or below subsistence, small numbers of donkeys or asses are kept for breeding, as pets, and for livestock protection in developed countries. Jacks are often mated with female [[Horse|horses]] (mares) to produce mules; the less common hybrid of a male horse (stallion) and jenny is a hinny.",
			},
