	{
		title = "Italian Renaissance",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "Italian cultural movement from the 14th to 17th century",
		tags = { "More articles" },
		summary = 'The **Italian Renaissance** is a period in [[History of Italy|Italian history]] covering the 15th and 16th centuries. It is the initial development of the broader [[Renaissance]] culture that spread from Italy to the rest of Europe (and also to extra-European territories ruled by colonial powers or where Christian missionaries and/or traders were active). The period marked the transition from the [[Middle Ages]] to the [[Modernity|modern era]]. Proponents of a "long Renaissance" argue that it started around the year 1300 and lasted until about 1600. In some fields, a Proto-Renaissance, beginning around 1250, is also accepted.',
		sections = {
			{
				"Overview",
				"The French word (corresponding to in Italian) means 'rebirth', and defines the period as one of cultural revival and renewed interest in [[Classical antiquity|classical antiquity]] after the centuries during what [[Renaissance humanism|Renaissance humanists]] labelled as the \"Dark Ages\". The Italian Renaissance historian [[Giorgio Vasari]] used the term ('rebirth') in his Lives of the Most Excellent Painters, Sculptors, and Architects in 1550, but the concept became widespread only in the 19th century, after the work of scholars such as Jules Michelet and Jacob Burckhardt. The Renaissance began in [[Tuscany]] in Central Italy and centered in the city of [[Florence]]. The Florentine Republic, one of the several city-states of the [[Italian Peninsula|peninsula]], rose to economic and political prominence by providing credit to European monarchs and by laying the groundwork for developments in [[Capitalism|capitalism]] and banking.",
			},
		},
		infobox = {
			{ "Participants", "[[Italians|Italian society]]" },
			{ "Location", "Italian city-states" },
			{ "Date", "14th century – 17th century" },
		},
