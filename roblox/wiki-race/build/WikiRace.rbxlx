	{
		title = "Joseph-Louis Lagrange",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Italian-French scientist (1736–1813)",
		tags = { "Mathematicians", "Early modern" },
		aliases = { "Giuseppe Luigi Lagrange", "Lagrangia" },
		summary = "**Joseph-Louis Lagrange**, also reported as **Giuseppe Luigi Lagrange** or **Lagrangia**, was an Italian and naturalized French [[Mathematician|mathematician]], [[Physicist|physicist]] and [[Astronomer|astronomer]]. He made significant contributions to the fields of [[Mathematical analysis|analysis]], [[Number theory|number theory]], and both [[Classical mechanics|classical]] and [[Celestial mechanics|celestial mechanics]].",
		sections = {
			{
				"Overview",
				"In 1766, on the recommendation of [[Leonhard Euler]] and [[Jean Le Rond d'Alembert|d'Alembert]], Lagrange succeeded Euler as the director of mathematics at the Prussian Academy of Sciences in Berlin, [[Prussia]], where he stayed for over twenty years, producing many volumes of work and winning several prizes of the [[French Academy of Sciences]]. Lagrange's treatise on analytical mechanics (Mécanique analytique, 4. ed., 2 vols. Paris: Gauthier-Villars et fils, 1788–89), which was written in Berlin and first published in 1788, offered the most comprehensive treatment of classical mechanics since [[Isaac Newton]] and formed a basis for the development of [[Mathematical physics|mathematical physics]] in the nineteenth century. In 1787, at age 51, he moved from Berlin to Paris and became a member of the French Academy of Sciences. He remained in France until the end of his life.",
			},
		},
		infobox = {
			{ "Born", "25 January 1736" },
			{ "Birthplace", "[[Turin]], Kingdom of Sardinia" },
			{ "Died", "10 April 1813" },
			{ "Citizenship", "Sardinia, [[First French Empire|French Empire]]" },
			{ "Field", "Mathematics, [[Astronomy]], [[Mechanics]]" },
			{ "Worked at", "École Normale, [[École polytechnique|École Polytechnique]]" },
			{ "Education", "University of Turin" },
		},
	},
	{
		title = "Josephus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Roman–Jewish historian and military leader (c. 37 – c. 100)",
		tags = { "Historians and archaeologists", "Ancient" },
		aliases = { "Flavius Josephus" },
		summary = "**Flavius Josephus** was a Roman–Jewish historian and military leader. Best known for writing The Jewish War, he was born in [[Jerusalem]]—then part of the Roman province of Judea—to a father of priestly descent and a mother who claimed Hasmonean royal ancestry.",
		sections = {
			{
				"Overview",
				"He initially fought against the [[Roman Empire]] during the First Jewish–Roman War as general of the Jewish forces in Galilee, until surrendering in AD 67 to the Roman army led by Vespasian after the six-week siege of Yodfat. Josephus claimed the Jewish messianic prophecies that initiated the First Jewish–Roman War made reference to Vespasian becoming [[Roman emperor]]. After Vespasian became emperor in AD 69, he granted Josephus his freedom, at which time Josephus assumed the Emperor's family name of Flavius. Flavius Josephus fully defected to the Roman side and was granted Roman citizenship. He became an advisor and close associate of Vespasian's son Titus, serving as his translator during Titus's protracted siege of Jerusalem in AD 70, which resulted in the near-total razing of the city and the destruction of the [[Second Temple]].",
			},
		},
		related = { "Tacitus", "Herodotus" },
		infobox = {
			{ "Born", "c. AD 36" },
			{ "Birthplace", "[[Jerusalem]], Roman Judea" },
			{ "Died", "c. AD 100 (aged 63–64)" },
			{ "Era", "Hellenistic Judaism" },
			{ "Notable works", "The Jewish War Antiquities of the Jews" },
		},
	},
	{
		title = "Josiah Wedgwood",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English entrepreneur and abolitionist; founder, Wedgwood pottery (1730–1795)",
		tags = { "Businesspeople" },
		summary = "**Josiah Wedgwood** (12 July 1730 – 3 January 1795) was an English [[Pottery|potter]], entrepreneur and abolitionist. Founding the Wedgwood company in 1759, he developed improved pottery bodies by systematic experimentation, and was the leader in the industrialisation of the manufacture of European [[Pottery|pottery]].",
		sections = {
			{
				"Overview",
				"The renewed classical enthusiasms of the late 1760s and early 1770s were of major importance to his sales promotion. His expensive goods were in much demand from the upper classes, while he used emulation effects to market cheaper sets to the rest of society. Every new invention that Wedgwood produced – green glaze, creamware, black basalt, and jasperware – was quickly copied. Having once achieved efficiency in production, he obtained efficiencies in sales and distribution. His showrooms in London gave the public the chance to see his complete range of [[Tableware|tableware]]. Wedgwood's company never made [[Porcelain|porcelain]] during his lifetime, but specialised in fine earthenwares and stonewares that had many of the same qualities, but were considerably cheaper. He made great efforts to keep the designs of his wares in tune with current fashion.",
			},
		},
		related = { "Jakob Fugger", "Leland Stanford" },
		infobox = {
			{ "Born", "12 July 1730" },
			{ "Birthplace", "Burslem, Staffordshire, England" },
			{ "Died", "3 January 1795" },
			{ "Known for", "Founding Wedgwood, devising a number of sales methods" },
			{ "Occupation", "Potter, entrepreneur" },
		},
	},
	{
		title = "Josiah Willard Gibbs",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American scientist (1839–1903)",
		tags = { "Chemistry", "Modern" },
		summary = "**Josiah Willard Gibbs** was an American mechanical engineer and scientist who made fundamental theoretical contributions to [[Physics|physics]], [[Chemistry|chemistry]], and [[Mathematics|mathematics]]. His work on the applications of [[Thermodynamics|thermodynamics]] was instrumental in transforming [[Physical chemistry|physical chemistry]] into a rigorous deductive science. Together with [[James Clerk Maxwell]] and [[Ludwig Boltzmann]], he created [[Statistical mechanics|statistical mechanics]] (a term that he coined), explaining the [[Laws of thermodynamics|laws of thermodynamics]] as consequences of the statistical properties of ensembles of the possible states of a physical system composed of many particles. Gibbs also worked on the application of [[Maxwell's equations]] to problems in physical optics.",
		sections = {
			{
				"Overview",
				'As a mathematician, he created modern [[Vector calculus|vector calculus]] (independently of the British scientist Oliver Heaviside, who carried out similar work during the same period) and described the Gibbs phenomenon in the theory of Fourier analysis. In 1863, [[Yale University]] awarded Gibbs the first American [[Doctor of Philosophy|doctorate]] in [[Engineering|engineering]]. After a three-year sojourn in Europe, Gibbs spent the rest of his career at Yale, where he was a professor of [[Mathematical physics|mathematical physics]] from 1871 until his death in 1903. Working in relative isolation, he became the earliest theoretical scientist in the United States to earn an international reputation and was praised by [[Albert Einstein]] as "the greatest mind in American history".',
			},
		},
		related = { "Peter Debye" },
		infobox = {
			{ "Born", "11 February 1839" },
			{ "Birthplace", "[[New Haven, Connecticut]], U.S." },
			{ "Died", "28 April 1903" },
			{ "Fields", "[[Chemistry]], [[Mathematics]], [[Physics]]" },
			{ "Worked at", "Yale College" },
			{ "Education", "Yale College ([[Bachelor of Arts|BA]], [[Doctor of Philosophy|PhD]])" },
			{ "Teacher", "Hubert Anson Newton" },
		},
	},
	{
		title = "José Martí",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Cuban national hero (1853–1895)",
		tags = { "Americas", "Latin America" },
		summary = 'He was also an important figure in [[Latin American literature]]. He was a political activist and is considered an important [[Philosophy|philosopher]] and [[Political philosophy|political theorist]]. Through his writings and political activity, he became a symbol of Cuba\'s bid for [[Independence|independence]] from the [[Spanish Empire]] in the 19th century and is referred to as the "Apostle of Cuban Independence". From adolescence on, he dedicated his life to the promotion of [[Liberty|liberty]], political independence for Cuba, and intellectual independence for all [[Hispanic America|Spanish Americans]]; his death was used as a cry for Cuban independence from Spain by both the Cuban revolutionaries and those Cubans previously reluctant to start a revolt.',
		sections = {
			{
				"Overview",
				"Born in [[Havana]], [[Spanish Empire]], Martí began his political activism at an early age. He traveled extensively in Spain, [[Latin America]], and the [[United States]], raising awareness and support for the cause of Cuban independence. His unification of the Cuban émigré community, particularly in [[Florida]], was crucial to the success of the Cuban War of Independence against Spain. He died in military action during the Battle of Dos Ríos on 19 May 1895. Martí is considered one of the great turn-of-the-century Latin American intellectuals. His written works include a series of poems, essays, [[Letter (message)|letters]], lectures, a novel, and a [[Children's literature|children's magazine]]. He wrote for numerous Latin American and American newspapers; he also founded a number of newspapers. One of those newspapers, Patria, was an important instrument in his campaign for Cuban independence.",
			},
		},
		related = { "Jorge Luis Borges", "Carlos Fuentes" },
		infobox = {
			{ "Born", "28 January 1853" },
			{ "Birthplace", "[[Havana]], Cuba, [[Spanish Empire]]" },
			{ "Died", "19 May 1895" },
			{ "Notable works", "Ismaelillo (1882), Versos sencillos (1891)" },
			{ "Movement", "Modernismo" },
		},
	},
	{
		title = "José Saramago",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Portuguese novelist (1922–2010)",
		tags = { "Europe", "Western Europe" },
		aliases = { "José de Sousa Saramago" },
		summary = '**José de Sousa Saramago** was a [[Portuguese people|Portuguese]] writer. He was the recipient of the 1998 Nobel Prize in Literature for his "parables sustained by imagination, compassion and irony [with which he] continually enables us once again to apprehend an elusory reality." His works, some of which can be seen as [[Allegory|allegories]], commonly present subversive perspectives on historic events, emphasizing the theopoetic human factor.',
		sections = {
			{
				"Overview",
				'In 2003 Harold Bloom described Saramago as "the most gifted novelist alive in the world today" and in 2010 said he considers Saramago to be "a permanent part of the [[Western canon]]", while James Wood praises "the distinctive tone to his fiction because he narrates his novels as if he were someone both wise and ignorant." More than two million copies of Saramago\'s books have been sold in Portugal alone and his work has been translated into 25 languages. A proponent of libertarian communism, Saramago criticized institutions such as the Catholic Church, the [[European Union]] and the [[International Monetary Fund]]. An [[Atheism|atheist]], he defended [[Love|love]] as an instrument to improve the [[Human condition|human condition]].',
			},
		},
		related = { "Tristan Tzara", "Adam Mickiewicz" },
		infobox = {
			{ "Born", "16 November 1922" },
			{ "Birthplace", "Azinhaga, Santarém, Portugal" },
			{ "Died", "18 June 2010" },
			{ "Occupation", "Writer" },
		},
	},
	{
		title = "Juan Ponce de León",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Spanish explorer and conquistador (1474–1521)",
		tags = { "Explorers", "Early modern" },
		summary = '**Juan Ponce de León** (c. 1474 – July 1521) was a Spanish explorer and [[Conquistador|conquistador]] known for leading the first European expeditions to [[Puerto Rico]] in 1508 and [[Florida]] in 1513. He was born in Santervás de Campos, Valladolid, Spain, in 1474. Though little is known about his family, he was of noble birth and served in the Spanish military from a young age. He first came to the Americas as a "gentleman volunteer" with [[Christopher Columbus]]\'s second expedition in 1493.',
		sections = {
			{
				"Overview",
				"By the early 1500s, Ponce de León was a top military official in the colonial government of [[Hispaniola]], where he helped crush a rebellion of the native [[Taíno]] people. He was authorized to explore the neighboring island of Puerto Rico in 1508 and to take office as the first governor of Puerto Rico by appointment of the [[Monarchy of Spain|Spanish crown]] in 1509. While Ponce de León grew quite wealthy from his plantations and mines, he faced an ongoing legal conflict with Diego Colón, the late Christopher Columbus's son, over the right to govern Puerto Rico. After a long court battle, Colón replaced Ponce de León as governor in 1511. Ponce de León decided to follow the advice of the sympathetic [[Ferdinand II of Aragon|King Ferdinand]] and explore more of the [[Caribbean Sea]]. In 1513, Ponce de León led the first European expedition to La Florida, which he named during his first voyage to the area.",
			},
		},
		related = { "Fred Rogers", "Sesshū Tōyō" },
		infobox = {
			{ "Born", "c. 1474" },
			{ "Birthplace", "Santervás de Campos, [[Crown of Castile|Castile]]" },
			{ "Died", "July 1521" },
		},
	},
