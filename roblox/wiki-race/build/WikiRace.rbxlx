		tags = { "Biomes" },
		aliases = { "Deserts" },
		summary = "A **desert** is a region that receives very little rain. The largest hot desert is the [[Sahara]], while [[Antarctica]] is the largest cold one.",
		sections = {
			{
				"Life",
				"Desert life includes the [[Camel|camel]] and the [[Cactus|cactus]], both experts at storing water.",
