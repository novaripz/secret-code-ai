		tags = { "Individual sports", "Boxing" },
		aliases = { "Joseph Louis Barrow" },
		summary = '**Joseph Louis Barrow** (May 13, 1914 – April 12, 1981) was an American professional boxer who competed from 1934 to 1951. Nicknamed "**the Brown Bomber**", Louis is widely regarded as one of the greatest and most influential boxers of all time. He reigned as the world heavyweight champion from 1937 until his temporary retirement in 1949. He was victorious in 25 consecutive title defenses, a record for all weight classes. Louis has the longest single reign as champion of any boxer in history.',
		sections = { { "Overview", "Louis's cultural impact was felt well outside the ring." } },
