		summary = "The **Great Barrier Reef** off the coast of [[Australia]] is the world's largest [[Coral reef|coral reef]] system, visible from space.",
		sections = { { "Life", "It is home to 1,500 species of [[Fish|fish]], sea turtles and [[Shark|sharks]]." } },
		infobox = { { "Country", "[[Australia]]" }, { "Length", "2,300 km" } },
