		title = "Extratropical cyclone",
		category = "Science",
		fame = 3,
		emoji = "🌀",
		source = "wikipedia",
		description = "Type of cyclone",
		tags = { "Meteorology", "Atmospheric circulation" },
		aliases = { "Extratropical cyclones", "Mid-latitude cyclones", "Wave cyclones" },
		summary = "**Extratropical cyclones**, sometimes called **mid-latitude cyclones** or **wave cyclones** are [[Low-pressure area|low-pressure areas]] which, along with anticyclones, drive the weather over much of the mid-latitudes of the Earth. Extratropical cyclones are capable of producing a range of weather conditions from wind, cloudiness and mild [[Rain|showers]] to severe [[Hail|hail]], [[Thunderstorm|thunderstorms]], [[Blizzard|blizzards]], and [[Tornado|tornadoes]]. This type of [[Cyclone|cyclone]] is thus defined as a large scale (synoptic) [[Low-pressure area|low pressure]] weather system occurring in the [[Middle latitudes|middle latitudes]] of the Earth.",
		sections = {
			{
