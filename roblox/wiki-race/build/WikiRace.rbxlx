			{ "Headquarters", "Cleveland, Ohio (1870–1885) [[New York City]], New York (1885–1911)" },
			{ "Industry", "Oil and gas" },
			{ "Products", "[[Fuel]], [[Lubricant|lubricant]], petrochemicals" },
		},
	},
	{
		title = "Statista",
		category = "Company",
		fame = 3,
		emoji = "🌐",
		source = "wikipedia",
		description = "German Internet company (founded 2007)",
		tags = { "More articles" },
		summary = "**Statista** (styled in all lower case) is a German online platform that specializes in data gathering and [[Data and information visualization|visualization]]. In addition to publicly available third-party data, Statista also provides exclusive data via the platform, which is collected through its team's surveys and analysis.",
		sections = {
			{
				"Overview",
				"According to its own publications, Statista offers more than 1,000,000 [[Statistics|statistics]] on over 80,000 topics from more than 22,500 sources in over 150 countries and is accessed 31 million times a month (as of December 2022). The company claims to cover around 170 industries with its content. In 2024, Statista reported more than four million registered users, with which the company generated around 167 million euros in revenue. Statista has been owned by Ströer Media since 2015, with an 81.3% stake. The company provides [[Statistics|statistics]] and survey results, which are presented in charts and tables. Its main target groups are business customers, lecturers, and researchers. The data provided by the company covers, among other things, advertisements, buying behavior, or specific industries.",
