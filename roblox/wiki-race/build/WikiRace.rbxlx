      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Mathematics</string>
          <string name="Source"><![CDATA[-- Mathematics, numbers, shapes and puzzles.
return {
	{
		title = "Mathematics",
		category = "Mathematics",
		fame = 1,
		emoji = "➗",
		tags = { "Formal sciences" },
		aliases = { "Math", "Maths" },
		summary = "**Mathematics** is the study of [[Number|numbers]], shapes, patterns and logic. It is the language of [[Physics|physics]] and [[Engineering|engineering]].",
		sections = {
			{
				"Branches",
				"Major branches include [[Algebra|algebra]], [[Geometry|geometry]], [[Calculus|calculus]] and [[Statistics|statistics]].",
			},
			{
				"History",
				"Mathematicians of [[Ancient Greece]] such as [[Pythagoras]] and [[Euclid]] laid its foundations.",
			},
		},
		infobox = { { "Symbols", "+ − × ÷ =" }, { "Related", "[[Algorithm|Algorithms]]" } },
		related = { "Physics", "Fractal", "Rubik's Cube", "Sudoku" },
	},
	{
		title = "Number",
		category = "Mathematics",
		fame = 2,
		emoji = "🔢",
		tags = { "Mathematics" },
		aliases = { "Numbers" },
		summary = "A **number** is a mathematical object used to count, measure and label. Special numbers include [[Zero|zero]], [[Pi|pi]] and [[Infinity|infinity]].",
		sections = {
			{
				"Kinds",
				"There are whole numbers, fractions, [[Prime number|primes]] and numbers written in [[Binary number|binary]].",
			},
		},
		infobox = { { "Smallest prime", "2" }, { "Related", "[[Zero]]" } },
		related = { "Sudoku" },
	},
	{
		title = "Zero",
		category = "Mathematics",
		fame = 2,
		emoji = "0️⃣",
		tags = { "Numbers" },
		aliases = { "0" },
		summary = "**Zero** is the [[Number|number]] representing nothing. Treating zero as a number was developed by mathematicians in [[India]] around the 5th century.",
		sections = {
			{
				"Importance",
				"Zero makes place-value notation possible and is one of the two digits of [[Binary number|binary]].",
			},
		},
		infobox = { { "Symbol", "0" }, { "Origin", "[[India]]" } },
	},
	{
		title = "Pi",
		category = "Mathematics",
		fame = 2,
		emoji = "🥧",
		tags = { "Mathematical constants" },
		aliases = { "π" },
		summary = "**Pi** (π) is the ratio of a [[Circle|circle]]'s circumference to its diameter, about 3.14159. Its digits go on forever without repeating.",
		sections = { { "Pi Day", "Pi Day is celebrated on March 14 (3/14), often by eating pie." } },
		infobox = { { "Value", "3.14159…" }, { "Related", "[[Circle]]" } },
	},
	{
		title = "Infinity",
		category = "Mathematics",
		fame = 2,
		emoji = "♾️",
		tags = { "Mathematical concepts" },
		summary = "**Infinity** (∞) is the idea of something without end. Mathematicians have shown that some infinities are bigger than others.",
		sections = {
			{
				"Examples",
				"There are infinitely many [[Prime number|prime numbers]], and the digits of [[Pi|pi]] never end.",
			},
		},
		infobox = { { "Symbol", "∞" }, { "Related", "[[Number]]" } },
	},
	{
		title = "Prime number",
		category = "Mathematics",
		fame = 3,
		emoji = "🔢",
		tags = { "Number theory" },
		aliases = { "Prime", "Primes" },
		summary = "A **prime number** is a whole [[Number|number]] greater than 1 divisible only by 1 and itself: 2, 3, 5, 7, 11, 13…",
		sections = {
			{
				"Proof",
				"[[Euclid]] proved there are [[Infinity|infinitely]] many primes. Primes protect online banking through encryption on the [[Internet]].",
			},
		},
		infobox = { { "Smallest", "2" }, { "Count", "[[Infinity|Infinite]]" } },
	},
	{
		title = "Fibonacci number",
		category = "Mathematics",
		fame = 3,
		emoji = "🐚",
		tags = { "Number sequences" },
		aliases = { "Fibonacci sequence", "Fibonacci" },
		summary = "The **Fibonacci numbers** form a sequence in which each number is the sum of the two before it: 0, 1, 1, 2, 3, 5, 8, 13…",
		sections = {
			{
				"Nature",
				"They appear in [[Sunflower|sunflower]] seed spirals and pinecones. Their ratios approach the [[Golden ratio|golden ratio]].",
			},
		},
		infobox = { { "Named after", "Leonardo of Pisa" }, { "Related", "[[Golden ratio]]" } },
	},
	{
		title = "Golden ratio",
		category = "Mathematics",
		fame = 3,
		emoji = "🐚",
		tags = { "Mathematical constants" },
		aliases = { "Golden mean", "φ" },
		summary = "The **golden ratio** (φ ≈ 1.618) is a proportion that appears in [[Geometry|geometry]], [[Art|art]] and nature.",
		sections = {
			{ "Connection", "Successive [[Fibonacci number|Fibonacci numbers]] get closer and closer to it." },
		},
		infobox = { { "Value", "≈ 1.618" }, { "Symbol", "φ" } },
	},
	{
		title = "Geometry",
		category = "Mathematics",
		fame = 2,
		emoji = "📐",
		tags = { "Mathematics" },
		summary = "**Geometry** is the branch of [[Mathematics|mathematics]] about shapes, sizes and space, such as the [[Triangle|triangle]] and the [[Circle|circle]].",
		sections = { { "History", "[[Euclid]]'s book Elements taught geometry for over 2,000 years." } },
		infobox = { { "Founder", "[[Euclid]]" }, { "Shapes", "[[Triangle]], [[Circle]]" } },
		related = { "Fractal" },
	},
	{
		title = "Triangle",
		category = "Mathematics",
		fame = 3,
		emoji = "🔺",
		tags = { "Shapes", "Geometry" },
		aliases = { "Triangles" },
		summary = "A **triangle** is a [[Geometry|geometric]] shape with three sides and three angles that always add up to 180°.",
		sections = {
			{
				"Uses",
				"Triangles are rigid, so engineers use them in [[Bridge|bridges]] and roofs. Right triangles obey the [[Pythagorean theorem]].",
			},
		},
		infobox = { { "Sides", "3" }, { "Angle sum", "180°" } },
	},
	{
		title = "Circle",
