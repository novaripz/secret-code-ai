		category = "Art",
		fame = 2,
		emoji = "😂",
		source = "wikipedia",
		description = "Genre of dramatic works intended to be humorous",
		tags = { "Forms", "Theatre" },
		summary = "**Comedy** is a [[Genre|genre]] of dramatic works intended to be humorous or amusing by inducing laughter, especially in [[Theatre|theatre]], [[Film|film]], [[Stand-up comedy|stand-up comedy]], [[Television|television]], [[Radio|radio]], [[Book|books]], or any other [[Entertainment|entertainment]] medium.",
