	{
		title = "Nuclear power plant",
		category = "Plant",
		fame = 2,
		emoji = "🌱",
		source = "wikipedia",
		description = "Thermal power station where the heat source is a nuclear reactor",
		tags = { "More articles" },
		aliases = { "NPP", "Nuclear power station", "Nuclear generating station" },
		summary = "A **nuclear power plant** (**NPP**), also known as a **nuclear power station** (**NPS**), **nuclear generating station** (**NGS**) or **atomic power station** (**APS**) is a thermal power station in which the [[Heat|heat]] source is a [[Nuclear reactor|nuclear reactor]]. As is typical of thermal power stations, heat is used to generate [[Steam|steam]] that drives a [[Steam turbine|steam turbine]] connected to a [[Electric generator|generator]] that produces [[Electricity|electricity]]. As of 2025, the [[International Atomic Energy Agency]] reported that there were 416 nuclear power reactors in operation in 31 countries around the world, and 62 nuclear power reactors under construction.",
		sections = {
			{
				"Overview",
				"Most nuclear power plants use thermal reactors with enriched uranium in a once-through fuel cycle. Fuel is removed when the percentage of neutron absorbing atoms becomes so large that a chain reaction can no longer be sustained, typically three years. It is then cooled for several years in on-site spent fuel pools before being transferred to long-term storage. The spent fuel, though low in volume, is high-level radioactive waste. While its radioactivity decreases exponentially, it must be isolated from the biosphere for hundreds of thousands of years, though newer technologies (like fast reactors) have the potential to significantly reduce this.",
			},
		},
	},
	{
		title = "Nut (fruit)",
		category = "Plant",
		fame = 1,
		emoji = "🍎",
		source = "wikipedia",
		description = "Fruit with outer shell protecting kernel",
		tags = { "Anatomy and morphology", "Plant anatomy" },
		aliases = { "Nut" },
		summary = "A **nut** is a [[Fruit|fruit]] consisting of a hard or tough nutshell protecting a single seed. In [[Botany|botany]], the use of the term nut implies that the shell does not open to release the [[Seed|seed]] (a property known as indehiscence).",
		sections = {
			{
				"Overview",
				"Whereas most seeds come from fruit that naturally free themselves from their shell, this is not the case in true nuts (such as [[Hazelnut|hazelnuts]], [[Chestnut|chestnuts]], and acorns), which have hard shell walls and originate from a compound ovary. Because nuts do not open of their own accord, they rely on external vectors of seed dispersal, such as consumption and excretion by herbivores.",
			},
		},
	},
	{
		title = "Nutmeg",
		category = "Plant",
		fame = 2,
		emoji = "🌶️",
		source = "wikipedia",
		description = "Spice from tree seed",
		tags = { "Flowering plants", "Magnoliids" },
		aliases = { "Fragrant nutmeg", "True nutmeg" },
		summary = "**Nutmeg** is the [[Seed|seed]], or the ground [[Spice|spice]] derived from the seed, of several tree species of the genus Myristica; **fragrant nutmeg** or **true nutmeg** (M. fragrans) is a dark-leaved [[Evergreen|evergreen]] tree cultivated for two spices derived from its [[Fruit|fruit]]: nutmeg, from its seed, and **mace**, from the seed covering. It is also a commercial source of nutmeg [[Essential oil|essential oil]] and nutmeg [[Butter|butter]]. The Banda Islands, in Maluku, [[Indonesia]], are the main producer of nutmeg and mace, and the true nutmeg tree is native to the islands.",
		sections = {
			{
				"Overview",
				"[[Conifer|Conifers]] of the genus Torreya, commonly known as the nutmeg yews, have edible seeds of similar appearance, but are not closely related to M. fragrans, and are not used as a spice.",
			},
