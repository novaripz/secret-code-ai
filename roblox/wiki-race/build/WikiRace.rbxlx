			{ "Education", "Reading Abbey Girls' School (1785–1786)" },
			{ "Years active", "1787–1817" },
			{ "Genre", "[[Literary realism]], [[Romance novel|Romantic fiction]], [[Satire]]" },
		},
	},
	{
		title = "Jane Goodall",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English zoologist (1934–2025)",
		tags = { "Biology", "Modern" },
		aliases = { "Dame Valerie Jane Morris Goodall" },
		summary = '**Dame Valerie Jane Morris Goodall** was an English primatologist and [[Anthropologist|anthropologist]]. Regarded as a pioneer in primate [[Ethology|ethology]], and described by many publications as "the world\'s preeminent [[Chimpanzee|chimpanzee]] expert", she was best known for more than six decades of [[Field research|field research]] on the social and family life of wild chimpanzees in the Kasakela chimpanzee community at Gombe Stream National Park in [[Tanzania]].',
		sections = {
			{
				"Overview",
				"In 1965 Goodall was awarded a PhD in ethology from the [[University of Cambridge]]. In the 1960s Goodall published several accounts of her research in Tanzania, including a series of articles in [[National Geographic]]. Her first book-length study, In the Shadow of Man (1971), was later translated into 48 languages. She founded the Jane Goodall Institute in 1977 to promote [[Wildlife conservation|wildlife conservation]], followed by the Roots & Shoots youth programme in 1991, which grew into a global network. Goodall also established wildlife sanctuaries and reforestation projects in Africa and campaigned for the ethical treatment of animals in animal testing, [[Animal husbandry|animal husbandry]] and captivity. Goodall was appointed a United Nations Messenger of Peace in 2002, and advised organisations such as Save the Chimps and the Society for the Protection of Underground Networks.",
			},
		},
		related = { "Ernst Haeckel", "Louis Agassiz" },
		infobox = {
			{ "Born", "3 April 1934" },
			{ "Birthplace", "London, England" },
			{ "Died", "1 October 2025" },
			{ "Education", "Newnham College, Cambridge ([[Doctor of Philosophy|PhD]])" },
			{ "Fields", "[[Ethology]]" },
			{ "Teacher", "Robert Hinde" },
			{ "Known for", "Study of [[Chimpanzee|chimpanzees]], conservation, animal welfare" },
		},
	},
	{
		title = "Jane Jacobs",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American–Canadian journalist, author, and activist (1916–2006)",
		tags = { "Other visual arts", "Urban planners and landscape architects" },
		summary = 'Her book The Death and Life of Great American Cities (1961) argued that "urban renewal" and "slum clearance" did not respect the needs of city-dwellers.',
		sections = {
			{
				"Overview",
				"Jacobs organized grassroots efforts to protect neighborhoods from urban renewal and slum clearance, in particular plans by Robert Moses to overhaul her own Greenwich Village neighborhood. She was instrumental in the eventual cancellation of the Lower Manhattan Expressway, which would have passed directly through the area of Manhattan that would later become known as SoHo, as well as part of Little Italy and Chinatown. She was arrested in 1968 for inciting a crowd at a public hearing on that project. After moving to Toronto in 1968, she joined the opposition to the Spadina Expressway and the associated network of expressways in Toronto that were planned and under construction. Jacobs was often criticized as a woman and a writer who criticized experts in the male-dominated field of [[Urban planning|urban planning]].",
			},
		},
		related = { "Antonio Stradivari", "Edward Weston", "Frederick Law Olmsted" },
		infobox = {
