		emoji = "🎼",
		tags = { "Composers", "German people" },
		aliases = { "Bach", "J. S. Bach" },
		summary = "**Johann Sebastian Bach** was a German composer of the Baroque era, famous for his complex, mathematical music for organ and choir.",
		sections = {
			{ "Legacy", "His music was sent into space on the Voyager Golden Record. He was born in [[Germany]]." },
		},
		infobox = { { "Born", "1685, [[Germany]]" }, { "Era", "Baroque" } },
	},
	{
		title = "Wolfgang Amadeus Mozart",
		category = "Musician",
		fame = 1,
		emoji = "🎹",
		tags = { "Composers", "Austrian people" },
		aliases = { "Mozart" },
		summary = "**Wolfgang Amadeus Mozart** was an Austrian composer who wrote more than 600 works, including symphonies, concertos and [[Opera|operas]].",
		sections = {
			{
				"Child prodigy",
				"He began composing at five and toured Europe playing the [[Piano|keyboard]] as a child.",
			},
		},
		infobox = { { "Born", "1756, Salzburg" }, { "Famous work", "The Magic Flute" } },
	},
	{
		title = "Ludwig van Beethoven",
		category = "Musician",
		fame = 1,
		emoji = "🎼",
		tags = { "Composers", "German people" },
		aliases = { "Beethoven" },
		summary = "**Ludwig van Beethoven** was a German composer and pianist whose nine symphonies are among the most performed music in the world.",
		sections = {
			{
				"Deafness",
				"He kept composing after losing his hearing; his Ninth [[Symphony]] includes the 'Ode to Joy', now the anthem of the [[European Union]].",
			},
		},
		infobox = { { "Born", "1770, Bonn, [[Germany]]" }, { "Symphonies", "9" } },
	},
	{
		title = "Symphony",
		category = "Music",
		fame = 3,
		emoji = "🎼",
		tags = { "Musical forms" },
		aliases = { "Symphonies" },
		summary = "A **symphony** is a long piece of [[Classical music|classical music]] for [[Orchestra|orchestra]], usually in four movements.",
		sections = { { "Famous examples", "[[Ludwig van Beethoven]]'s Fifth begins with the famous 'da-da-da-DUM'." } },
		infobox = { { "Movements", "Usually 4" }, { "Performed by", "[[Orchestra]]" } },
	},
	{
