			{ "Birthplace", "Waukegan, Illinois, U.S." },
			{ "Died", "5 June 2012" },
			{ "Occupation", "Writer" },
			{
				"Genre",
				"Fantasy, [[Science fiction|science fiction]], [[Horror fiction|horror fiction]], mystery fiction, magic realism",
			},
		},
