	{
		title = "Astronomer",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "Scientist in the field of astronomy",
		tags = { "More articles" },
		summary = "An **astronomer** is a [[Scientist|scientist]] in the field of [[Astronomy|astronomy]] who focuses on a specific question or field outside the scope of [[Earth]]. Astronomers study [[Astronomical object|astronomical objects]], such as [[Star|stars]], [[Planet|planets]], [[Natural satellite|moons]], [[Comet|comets]] and [[Galaxy|galaxies]], by some combination of observation and the application of [[Astrophysics|astrophysical]] models. Examples of topics or fields astronomers study include [[Planetary science|planetary science]], [[Sun|solar astronomy]], the [[Star formation|origin]] or [[Stellar evolution|evolution of stars]], or the [[Galaxy formation and evolution|formation of galaxies]]. A related but distinct subject is [[Physical cosmology|physical cosmology]], which studies the [[Universe|universe]] as a whole.",
	},
