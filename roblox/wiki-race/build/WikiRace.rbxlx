	{
		title = "Gilbert N. Lewis",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American physical chemist (1875–1946)",
		tags = { "Chemistry", "Modern" },
		aliases = { "Gilbert Newton Lewis" },
		summary = '**Gilbert Newton Lewis** (October 23 or October 25, 1875 – March 23, 1946) was an American [[Physical chemistry|physical chemist]] and a dean of the college of chemistry at [[University of California, Berkeley]]. Lewis was best known for his discovery of the [[Covalent bond|covalent bond]] and his concept of electron pairs; his Lewis dot structures and other contributions to [[Valence bond theory|valence bond theory]] have shaped modern theories of [[Chemical bond|chemical bonding]]. Lewis successfully contributed to [[Chemical thermodynamics|chemical thermodynamics]], [[Photochemistry|photochemistry]], and isotope separation, and is also known for his concept of acids and bases. Lewis also researched on [[Theory of relativity|relativity]] and [[Quantum mechanics|quantum physics]], and in 1926 he coined the term "[[Photon|photon]]" for the smallest unit of radiant energy.',
		sections = {
			{
				"Overview",
				"G. N. Lewis was born in 1875 in Weymouth, Massachusetts. After receiving his [[Doctor of Philosophy|PhD]] in [[Chemistry|chemistry]] from [[Harvard University]] and studying abroad in Germany and the [[Philippines]], Lewis moved to [[California]] in 1912 to teach chemistry at the University of California, Berkeley, where he became the dean of the college of chemistry and spent the rest of his life. As a professor, he incorporated thermodynamic principles into the chemistry curriculum and reformed [[Chemical thermodynamics|chemical thermodynamics]] in a mathematically rigorous manner accessible to ordinary chemists. He began measuring the [[Thermodynamic free energy|free energy]] values related to several chemical processes, both organic and inorganic. In 1916, he also proposed his theory of bonding and added information about electrons in the [[Periodic table|periodic table]] of the [[Chemical element|chemical elements]]. In 1933, he started his research on isotope separation.",
			},
		},
		infobox = {
			{ "Born", "October 23 or 25, 1875" },
			{ "Birthplace", "Weymouth, Massachusetts, US" },
			{ "Died", "23 March 1946" },
			{ "Field", "[[Physical chemistry]]" },
			{ "Teacher", "Theodore William Richards" },
			{ "Education", "[[Harvard University]]" },
		},
	},
