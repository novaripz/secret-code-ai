			{ "Birthplace", "New York City, U.S." },
			{ "Died", "28 September 1891" },
			{ "Occupation", "Writer teacher sailor lecturer customs inspector" },
			{ "Movement", "[[Romanticism]]" },
			{ "Education", "The Albany Academy (Albany, New York)" },
		},
	},
