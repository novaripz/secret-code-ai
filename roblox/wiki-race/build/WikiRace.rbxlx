		tags = { "History by subject matter", "History of science and technology" },
		summary = "The **history of chemistry** represents a time span from [[Ancient history|ancient history]] to the present. By 1000 BC, civilizations used technologies that would eventually form the basis of the various branches of chemistry.",
		sections = {
			{
				"Overview",
