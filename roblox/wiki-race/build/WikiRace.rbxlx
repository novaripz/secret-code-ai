		source = "wikipedia",
		description = "Scientific and professional organization",
		tags = { "More articles" },
		aliases = { "APA" },
		summary = "The **American Psychological Association** (**APA**) is the main professional organization of [[Psychologist|psychologists]] in the [[United States]], and the largest psychological association in the world. It has over 190,000 members, including scientists, educators, clinicians, consultants, and students. It has 54 divisions, which function as interest groups for different subspecialties of [[Psychology|psychology]] or topical areas. The APA has an annual budget of nearly $134 million.",
