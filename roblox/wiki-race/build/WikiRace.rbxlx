		aliases = { "Patronym", "Avonymic" },
		summary = "A **patronymic**, or **patronym**, is a [[Personal name|personal name]], or component of a personal name, based on the [[Given name|given name]] of one's father, grandfather (more specifically an **avonymic**), or an earlier male ancestor. It is the male equivalent of a matronymic.",
