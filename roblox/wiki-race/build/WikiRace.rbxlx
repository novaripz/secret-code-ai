				"Spoken in",
				"[[Serbia]] [[Bosnia and Herzegovina|Bosnia-Herzegovina]] [[Montenegro]] [[Kosovo]] [[Croatia]]",
			},
			{ "Region", "[[Southeastern Europe]]" },
			{ "Date", "2022–23" },
			{
				"Writing system",
