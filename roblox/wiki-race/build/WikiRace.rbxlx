	{
		title = "Stream",
		category = "Concept",
		fame = 1,
		emoji = "💧",
		source = "wikipedia",
		description = "Body of surface water flowing down a channel",
		tags = { "More articles" },
		summary = "A **stream** is a continuous [[Body of water|body]] of surface water flowing within the bed and banks of a [[Channel (geography)|channel]]. The channel is a **watercourse**, although the watercourse may be seasonally or periodically dry. Depending on its location or certain characteristics, a stream may be referred to by a variety of local or regional names. Long, large streams are usually called [[River|rivers]], while smaller, less voluminous and more intermittent streams are known, amongst others, as **brook**, **creek**, **rivulet**, **rill**, **run**, **tributary**, **feeder**, **freshet**, **narrow river**, and **streamlet**.",
		sections = {
			{
				"Overview",
				"The flow of a stream is controlled by three inputs – [[Surface runoff|surface runoff]] (from [[Precipitation|precipitation]] or meltwater), daylighted subterranean water, and surface [[Groundwater|groundwater]] ([[Spring (hydrology)|spring water]]). The surface and subterranean water are highly variable between periods of rainfall. Groundwater, on the other hand, has a relatively constant input and is controlled more by long-term patterns of precipitation. The stream encompasses surface, subsurface and groundwater fluxes that respond to geological, geomorphological, hydrological and biotic controls. Streams are important as conduits in the [[Water cycle|water cycle]], instruments in groundwater recharge, and corridors for fish and wildlife migration. The biological [[Habitat|habitat]] in the immediate vicinity of a stream is called a riparian zone.",
			},
		},
	},
	{
		title = "Stream of consciousness",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
