		aliases = { "Kingdom", "Kingdom (biology)" },
		summary = "In [[Biology|biology]], a **kingdom** is the second highest [[Taxonomic rank|taxonomic rank]], just below [[Domain (taxonomy)|domain]]. Kingdoms are divided into smaller groups called [[Phylum|phyla]] (singular phylum).",
		sections = {
			{
				"Overview",
				"Traditionally, textbooks from the United States and some of Canada have used a system of six kingdoms ([[Animal|Animalia]], [[Plant|Plantae]], [[Mushroom|Fungi]], [[Protist|Protista]], [[Archaea]] or Archaebacteria, and [[Bacteria]] or Eubacteria), while textbooks in other parts of the world, such as Bangladesh, Brazil, Greece, India, Pakistan, Spain, and the United Kingdom have used five kingdoms (Animalia, Plantae, Fungi, Protista and Monera). Some recent classifications based on modern [[Cladistics|cladistics]] have explicitly abandoned the term kingdom, noting that some traditional kingdoms are not [[Monophyly|monophyletic]], meaning that they do not consist of all the descendants of a common ancestor. The terms [[Plant|flora]] (for plants), [[Animal|fauna]] (for animals), and, in the 21st century, funga (for fungi) are also used for life present in a particular region or time.",
			},
		},
	},
