	{
		title = "Muskox",
		category = "Animal",
		fame = 3,
		emoji = "🐾",
		source = "wikipedia",
		description = "Species of arctic land mammal",
		tags = { "Mammals", "Artiodactyla" },
		aliases = { "Ovibos moschatus" },
		summary = 'The **muskox** (**Ovibos moschatus**) is a [[Ungulate|hoofed mammal]] of the family [[Bovidae]]. Native to the [[Arctic]], it is noted for its thick coat and for the strong odor emitted by males during the seasonal rut, from which its name derives. This musky odor has the effect of attracting females during mating season. Its Inuktitut name translates to "the bearded one".',
		sections = {
			{
				"Overview",
				'Its Woods Cree names and translate to "ugly moose" and "ugly bison", respectively. In historic times, muskoxen primarily lived in [[Greenland]] and the [[Northern Canada|Canadian Arctic]] of the [[Northwest Territories]] and [[Nunavut]]. They were formerly present in [[Eurasia]], with their youngest natural records in the region dating to around 2,700 years ago, with reintroduced populations in the [[U.S. state]] of [[Alaska]], the [[Provinces and territories of Canada|Canadian territory]] of [[Yukon]], and [[Siberia]], and an introduced population in [[Norway]], part of which emigrated to [[Sweden]], where a small population now lives.',
			},
		},
		related = { "Antelope", "Water buffalo" },
		infobox = {
			{ "Scientific name", "Ovibos moschatus" },
			{ "Conservation status", "Least Concern" },
