	{
		title = "Metropolis",
		category = "City",
		fame = 1,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Large city or conurbation",
		tags = { "More articles" },
		summary = "A **metropolis** is a large [[City|city]] or [[Conurbation|conurbation]] which is a significant economic, political, and cultural area for a country or region, and an important hub for regional or international connections, commerce, and communications.",
		sections = {
			{
				"Overview",
				'A big city belonging to a larger [[Urban area|urban agglomeration]], but which is not the core of that agglomeration, is not generally considered a metropolis but a part of it. The plural of the word is metropolises, although the Latin plural is, from the Greek. For urban areas outside metropolitan areas that generate a similar attraction on a smaller scale for their region, the concept of the regiopolis ("regio" for short) was introduced by urban and regional planning researchers in Germany in 2006.',
			},
		},
