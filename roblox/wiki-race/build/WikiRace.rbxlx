		description = "Indian news magazine",
		tags = { "More articles" },
		summary = "**India Today** is a weekly Indian English-language news [[Magazine|magazine]] published by Living Media India Limited. It is the most widely circulated magazine in [[India]], with a readership of close to 8 million. In 2014, India Today launched a new online opinion-orientated site called the DailyO.",
		sections = {
			{
				"Overview",
				"As per the Indian Readership Survey 2019, the India Today magazine's English edition had a readership of 9.24 million and the Hindi edition 7.02 million, making them among the most read magazines in India. As of 2026, India Today has published 2,006 issues.",
			},
