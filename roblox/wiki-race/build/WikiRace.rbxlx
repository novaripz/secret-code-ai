      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Brainrot</string>
          <string name="Source"><![CDATA[-- Brainrot, memes and Roblox hits: kid-safe internet culture, written for Wiki Race.
-- `funny` sets the layers and caption of the page's meme card (see client FunnyCard).
-- Records with `patch` add "See also" links to an existing page instead of creating one.
return {
	{
		title = "Brainrot",
		category = "Meme",
		fame = 1,
		emoji = "🧠",
		tags = { "Internet slang", "Brainrot" },
		aliases = { "Brain rot", "Brain-rot", "Brainrot content" },
		summary = '**Brainrot** (also **brain rot**) is internet slang for silly, chaotic, super-repetitive online content — and the fuzzy feeling you get after scrolling through too much of it. The [[Oxford English Dictionary|Oxford]] dictionary team picked "brain rot" as its Word of the Year for 2024.',
		sections = {
			{
				"Origins",
				'The phrase is surprisingly old: the writer [[Henry David Thoreau]] used "brain-rot" in his 1854 book Walden. It came back on [[Social media|social media]] in the 2020s to describe endless short videos on apps like [[TikTok]] and [[YouTube]].',
			},
			{
				"Famous brainrot",
