	{
		title = "Virgil",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "1st-century-BC Roman poet",
		tags = { "Europe", "Ancient Rome" },
		aliases = { "Publius Vergilius Maro", "Vergil" },
		summary = "**Publius Vergilius Maro**, usually called **Virgil** or **Vergil** in English, was an [[Roman Empire|ancient Roman]] poet of the Augustan period. He composed three of the most famous poems in [[Latin literature]]: the Eclogues (or Bucolics), the Georgics, and the [[Epic poetry|epic]] [[Aeneid]]. Some minor poems, collected in the Appendix Vergiliana, were attributed to him in ancient times, but modern scholars regard these as spurious, with the possible exception of some short pieces.",
		sections = {
			{
				"Overview",
				'Already acclaimed in his lifetime as a classic author, Virgil rapidly replaced Ennius and other earlier authors as a standard school text, and stood as the most popular Latin poet through late antiquity, the Middle Ages, and early modernity, exerting major influence on [[Western literature]]. I.86–7) ("thou art alone the one from whom I took the beautiful style that has done honour to me"). In the 20th century, [[T. S. Eliot]] famously began a lecture on the subject "What Is a Classic?" by asserting as self-evidently true that "whatever the definition we arrive at, it cannot be one which excludes Virgil – we may say confidently that it must be one which will expressly reckon with him".',
			},
		},
		infobox = {
			{ "Born", "15 October 70 BC" },
			{ "Birthplace", "Andes, Cisalpine Gaul, [[Roman Republic]]" },
			{ "Died", "21 September 19 BC (aged 50)" },
			{ "Occupation", "Poet" },
			{ "Genre", "[[Epic poetry]], didactic poetry, pastoral poetry" },
			{ "Movement", "Augustan poetry" },
			{ "Notable works", "Eclogues Georgics [[Aeneid]]" },
		},
	},
	{
		title = "Virginia Woolf",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English modernist writer (1882–1941)",
		tags = { "Western Europe", "UK and Ireland" },
		aliases = { "Adeline Virginia Woolf" },
		summary = '**Adeline Virginia Woolf** ( "wolf"; 25 January 1882 – 28 March 1941) was an English writer and one of the most influential 20th-century [[Literary modernism|modernist]] authors. She helped to pioneer the use of [[Stream of consciousness|stream of consciousness]] narration as a literary device.',
		sections = {
			{
				"Overview",
				"Virginia Woolf was born in South Kensington, London, into an affluent and intellectual family as the seventh child of Julia Prinsep Jackson and Leslie Stephen. She grew up in a blended household of eight children, including her sister, the painter Vanessa Bell. Educated at home in English classics and Victorian literature, Woolf later attended [[King's College London]], where she studied [[Classics|classics]] and [[History|history]] and encountered early advocates for [[Women's rights|women's rights]] and education. After the death of her father in 1904, Woolf and her siblings moved to the bohemian Bloomsbury district, where she became a founding member of the influential Bloomsbury Group. She married Leonard Woolf in 1912, and together they established the Hogarth Press in 1917, which published much of her work.",
			},
		},
		related = { "C. S. Lewis" },
		infobox = {
			{ "Born", "25 January 1882" },
