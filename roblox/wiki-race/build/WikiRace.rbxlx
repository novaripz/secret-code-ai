      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Science</string>
          <string name="Source"><![CDATA[-- Physics, chemistry and biology.
return {
	{
		title = "Physics",
		category = "Science",
		fame = 1,
		emoji = "⚛️",
		tags = { "Natural sciences" },
		summary = "**Physics** is the science of matter, [[Energy|energy]], motion and force. It explains everything from [[Gravity|gravity]] to [[Light|light]] to the [[Atom|atom]].",
		sections = {
			{
				"Famous physicists",
				"[[Isaac Newton]] described the laws of motion, and [[Albert Einstein]] developed the [[Theory of relativity|theory of relativity]].",
			},
			{ "Modern physics", "[[Quantum mechanics]] describes the strange behavior of tiny particles." },
		},
		infobox = { { "Branch of", "Science" }, { "Uses", "[[Mathematics]]" } },
		related = { "Chemistry" },
	},
	{
		title = "Albert Einstein",
		category = "Person",
		fame = 1,
		emoji = "🧑‍🔬",
		tags = { "Physicists", "Nobel laureates" },
		aliases = { "Einstein" },
		summary = "**Albert Einstein** was a German-born physicist who developed the [[Theory of relativity|theory of relativity]]. His equation E = mc² is the world's most famous formula.",
		sections = {
			{
				"Nobel Prize",
				"He won the 1921 Nobel Prize in [[Physics]] for explaining how [[Light|light]] knocks [[Electron|electrons]] out of metals, a key step toward [[Quantum mechanics|quantum theory]].",
			},
		},
		infobox = { { "Born", "1879, [[Germany]]" }, { "Known for", "[[Mass–energy equivalence|E = mc²]]" } },
		related = { "Refrigerator" },
	},
	{
		title = "Isaac Newton",
		category = "Person",
		fame = 1,
		emoji = "🍎",
		tags = { "Physicists", "Mathematicians", "English people" },
		aliases = { "Newton", "Sir Isaac Newton" },
		summary = "**Isaac Newton** was an English scientist who described [[Gravity|gravity]] and the three laws of motion. He also co-invented [[Calculus|calculus]].",
		sections = {
			{
				"The apple",
				"According to a famous story, a falling [[Apple|apple]] inspired his thinking about gravity.",
			},
			{ "Optics", "He showed that white [[Light|light]] is a mix of all the colors of the [[Rainbow|rainbow]]." },
		},
		infobox = { { "Born", "1643, England" }, { "Known for", "Laws of motion" } },
	},
	{
		title = "Galileo Galilei",
		category = "Person",
		fame = 2,
		emoji = "🔭",
		tags = { "Astronomers", "Italian people" },
		aliases = { "Galileo" },
		summary = "**Galileo Galilei** was an Italian astronomer who improved the [[Telescope|telescope]] and discovered four moons of [[Jupiter]].",
		sections = {
			{
				"Controversy",
				"He supported the idea that [[Earth]] orbits the [[Sun]], which put him on trial in [[Rome]] in 1633.",
			},
		},
		infobox = { { "Born", "1564, [[Italy]]" }, { "Field", "[[Physics]], astronomy" } },
		related = { "Leaning Tower of Pisa" },
	},
	{
		title = "Gravity",
		category = "Science",
		fame = 1,
		emoji = "🍎",
		tags = { "Physics", "Forces" },
		aliases = { "Gravitation" },
		summary = "**Gravity** is the force that pulls objects with mass toward each other. It keeps our feet on [[Earth]] and the planets in orbit around the [[Sun]].",
		sections = {
			{
				"Theories",
				"[[Isaac Newton]] described gravity as a force; [[Albert Einstein]] explained it as the bending of space and time.",
			},
		},
		infobox = { { "Described by", "[[Isaac Newton]]" }, { "On Earth", "9.8 m/s²" } },
	},
	{
		title = "Theory of relativity",
		category = "Science",
		fame = 2,
		emoji = "🌀",
		tags = { "Physics theories" },
		aliases = { "Relativity", "General relativity", "Special relativity" },
		summary = "The **theory of relativity** is [[Albert Einstein]]'s description of space, time and [[Gravity|gravity]]. It shows that time runs slower at high speeds.",
		sections = {
			{
				"Predictions",
				"It predicted [[Black hole|black holes]] and gravitational waves, and it is why [[GPS]] satellites must correct their clocks.",
			},
		},
		infobox = { { "Developed by", "[[Albert Einstein]]" }, { "Years", "1905, 1915" } },
	},
	{
		title = "Mass–energy equivalence",
		category = "Science",
		fame = 3,
		emoji = "💡",
		tags = { "Physics", "Equations" },
		aliases = { "E=mc2", "E = mc²", "Mass-energy equivalence" },
		summary = "**Mass–energy equivalence** is the principle, written E = mc², that mass can be turned into [[Energy|energy]] and back.",
		sections = {
			{
				"Meaning",
				"Because the [[Speed of light|speed of light]] is so large, a tiny amount of mass holds a vast amount of energy.",
			},
		},
		infobox = { { "Discovered by", "[[Albert Einstein]]" }, { "Year", "1905" } },
	},
	{
		title = "Speed of light",
		category = "Science",
		fame = 2,
		emoji = "⚡",
		tags = { "Physical constants" },
		summary = "The **speed of light** is about 300,000 km per second — the fastest anything can travel according to the [[Theory of relativity|theory of relativity]].",
		sections = { { "Scale", "[[Light]] from the [[Sun]] takes about 8 minutes to reach Earth." } },
		infobox = { { "Value", "299,792,458 m/s" }, { "Symbol", "c" } },
	},
	{
		title = "Light",
		category = "Science",
		fame = 1,
		emoji = "💡",
		tags = { "Physics", "Electromagnetism" },
		summary = "**Light** is a form of [[Energy|energy]] that travels as waves and as particles called [[Photon|photons]]. It lets us see the world.",
		sections = {
			{
				"Color",
				"White light splits into the colors of a [[Rainbow|rainbow]] when it passes through a prism. The [[Light bulb|light bulb]] made artificial light cheap.",
			},
		},
		infobox = { { "Speed", "[[Speed of light]]" }, { "Made of", "[[Photon|Photons]]" } },
	},
	{
		title = "Photon",
		category = "Science",
		fame = 3,
		emoji = "✨",
		tags = { "Particles", "Quantum mechanics" },
		summary = "A **photon** is a tiny packet of [[Light|light]] energy. Photons have no mass and always travel at the [[Speed of light|speed of light]].",
		sections = {
			{
				"Discovery",
				"[[Albert Einstein]] proposed in 1905 that light comes in packets, founding [[Quantum mechanics|quantum physics]].",
			},
		},
		infobox = { { "Mass", "0" }, { "Type", "Elementary particle" } },
	},
	{
		title = "Electricity",
		category = "Science",
		fame = 1,
		emoji = "⚡",
		tags = { "Physics", "Energy" },
		summary = "**Electricity** is the flow of electric charge, usually carried by [[Electron|electrons]]. It powers homes, [[Computer|computers]] and [[Light bulb|light bulbs]].",
		sections = {
			{
				"History",
