		fame = 2,
		emoji = "🏔️",
		tags = { "Mountain ranges" },
		aliases = { "Andes Mountains" },
		summary = "The **Andes** are the longest continental mountain range in the world, running 7,000 km along the western edge of [[South America]].",
		sections = {
			{
				"Life",
				"[[Llama|Llamas]] were domesticated in the Andes, and the [[Inca Empire]] built its cities high in its valleys.",
			},
		},
		infobox = { { "Countries", "7 incl. [[Argentina]], [[Peru]]" }, { "Highest peak", "Aconcagua" } },
	},
	{
