			{ "Known for", "[[Painting|Painter]], engraver, [[Satire|satirist]]" },
			{ "Notable works", "A Harlot's Progress, A Rake's Progress" },
		},
	},
	{
		title = "William III of England",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "King of England, Scotland, and Ireland from 1689 to 1702",
		tags = { "Western Europe", "Great Britain and United Kingdom" },
		aliases = { "William III and II" },
		summary = "**William III and II** (William Henry; 4 November 1650 – 8 March 1702), also known as **William of Orange**, was the sovereign Prince of Orange from birth, Stadtholder of Holland, Zeeland, Utrecht, Guelders, and Overijssel in the [[Dutch Republic]] from 1672, and King of England, Ireland, and Scotland from 1689 until his death in 1702. He ruled England, Scotland, and Ireland with his wife, Queen Mary II, until her death in 1694; their joint reign is known as that of **William and Mary**.",
		sections = {
			{
				"Overview",
				"William was the only child of William II, Prince of Orange, and Mary, Princess Royal, the daughter of King Charles I of England, Scotland, and Ireland. His father died before his birth, making William III the prince of Orange from birth. In 1677, he married his first cousin Mary, the elder daughter of his maternal uncle James, Duke of York (later King James II). When the Catholic French king [[Louis XIV]] attacked the Dutch Republic in 1672, William rose to power and became Louis's greatest obstacle. He made it his life's mission to oppose Louis and waged many campaigns against Louis's armies. He reorganised the Dutch army, restoring its effectiveness after the disasters of the Rampjaar and transforming it into one of the most experienced and professional forces in Europe.",
			},
		},
		related = { "Robert Walpole" },
		infobox = {
			{ "Birthplace", "Binnenhof, The Hague, Dutch Republic" },
		},
	},
	{
		title = "William James",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American philosopher and psychologist (1842–1910)",
		tags = { "Philosophers", "Modern" },
		summary = '**William James** (January 11, 1842 – August 26, 1910) was an American [[Philosophy|philosopher]] and [[Psychologist|psychologist]]. The first educator to offer a [[Psychology|psychology]] course in the United States, he is considered to be one of the leading thinkers of the late 19th century, one of the most influential philosophers and is often dubbed the "father of American psychology".',
		sections = {
			{
				"Overview",
				"Born into a wealthy family, James was the son of the Swedenborgian theologian Henry James Sr. and the brother of both the prominent novelist [[Henry James]] and the diarist Alice James. James trained as a physician and taught anatomy at Harvard, but never practiced medicine. Instead, he pursued his interests in psychology and then philosophy. James wrote widely on many topics, including [[Epistemology|epistemology]], education, [[Metaphysics|metaphysics]], [[Psychology|psychology]], religion, and mysticism. Among his most influential books are The Principles of Psychology, a groundbreaking text in the field of psychology; Essays in Radical Empiricism, an important text in philosophy; and The Varieties of Religious Experience, an investigation of different forms of religious experience, including theories on mind-cure.",
			},
		},
