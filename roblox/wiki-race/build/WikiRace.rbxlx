	{
		title = "Hughes Medal",
		category = "Concept",
		fame = 3,
		emoji = "💭",
		source = "wikipedia",
		description = "Award presented by the Royal Society since 1902",
		tags = { "More articles" },
		summary = 'The **Hughes Medal** is awarded by the [[Royal Society]] "in recognition of an original discovery in the physical sciences, particularly electricity and magnetism or their applications." The medal is named after British–American scientist David E. Hughes. It was first awarded in 1902 to [[J. J. Thomson]] "for his numerous contributions to electric science, especially in reference to the phenomena of electric discharge in gases," and has since been awarded over one hundred times. Unlike other Royal Society medals, the Hughes Medal has never been awarded to the same individual more than once.',
		related = { "Terrestrial animal", "Filter feeder" },
