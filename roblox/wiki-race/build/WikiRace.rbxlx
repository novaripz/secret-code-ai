	{
		title = "Epidermis (botany)",
		category = "Plant",
		fame = 3,
		emoji = "🦠",
		source = "wikipedia",
		description = "Layer of cells that covers leaves, flowers, roots of plants",
		tags = { "Plant anatomy", "Plant tissues" },
		aliases = { "Epidermis" },
		summary = "The **epidermis** is a single layer of cells that covers the [[Leaf|leaves]], [[Flower|flowers]], [[Root|roots]] and [[Plant stem|stems]] of [[Plant|plants]]. It forms a boundary between the plant and the external environment. The epidermis serves several functions: it protects against water loss, regulates gas exchange, secretes metabolic compounds, and (especially in roots) absorbs water and mineral nutrients. The epidermis of most leaves shows dorsoventral anatomy: the upper (adaxial) and lower (abaxial) surfaces have somewhat different construction and may serve different functions.",
		sections = {
			{
				"Overview",
				"Woody stems and some other stem structures such as [[Potato|potato]] [[Tuber|tubers]] produce a secondary covering called the periderm that replaces the epidermis as the protective covering.",
			},
		},
	},
	{
		title = "Epiphyte",
		category = "Plant",
		fame = 2,
		emoji = "🌱",
		source = "wikipedia",
		description = "Surface organism that grows upon another plant but is not nourished by it",
		tags = { "More articles" },
		summary = "An **epiphyte** is a plant or plant-like organism that grows on the surface of another plant or plant-like organism such as [[Kelp|kelp]]. It derives its moisture and nutrients from the air, rain, water (in marine environments) or from debris accumulating around it. The plants on which epiphytes grow are called phorophytes. Epiphytes take part in nutrient cycles and add to both the diversity and biomass of the ecosystem in which they occur, like any other organism. In some cases, a rainforest tree's epiphytes may weigh several tonnes. An organism that grows on another organism that is not a plant may be called an epibiont.",
		sections = {
			{
				"Overview",
				'Epiphytes are usually found in the temperate zone (e.g., many [[Moss|mosses]], liverworts, [[Lichen|lichens]], and algae) or in the tropics (e.g., many [[Fern|ferns]], [[Cactus|cacti]], [[Orchid|orchids]], and bromeliads). Epiphyte species make good houseplants due to their minimal water and soil requirements. Epiphytes provide a rich and diverse habitat for other organisms including animals, fungi, bacteria, and myxomycetes. Epiphyte is one of the subdivisions of the Raunkiær system. Epiphytic plants are sometimes called "air plants" because they do not root in soil. However, that term is inaccurate, as there are many aquatic species of [[Algae|algae]] that are epiphytes on other aquatic plants (seaweeds or aquatic angiosperms).',
			},
		},
	},
