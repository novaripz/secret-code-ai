		emoji = "👑",
		tags = { "Ancient Egypt", "Monarchs" },
		aliases = { "Pharaohs" },
		summary = "A **pharaoh** was a king of [[Ancient Egypt]], believed to be a living god.",
		sections = {
			{
				"Famous pharaohs",
				"[[Tutankhamun]] is the most famous; [[Cleopatra]] was the last. Many were buried in pyramids or the Valley of the Kings.",
			},
		},
		infobox = { { "Crown", "Double crown" }, { "Title means", "'Great house'" } },
	},
	{
		title = "Great Pyramid of Giza",
		category = "Landmark",
		fame = 1,
		emoji = "🔺",
		tags = { "Pyramids", "Seven Wonders of the Ancient World" },
		aliases = { "Pyramids of Giza", "Great Pyramid", "Pyramids" },
		summary = "The **Great Pyramid of Giza** is the largest of the pyramids near [[Cairo]], [[Egypt]], built around 2560 BC as a tomb for a [[Pharaoh|pharaoh]].",
		sections = {
			{
				"Records",
				"It was the tallest human-made structure for about 3,800 years and is the only Ancient Wonder still standing. The [[Great Sphinx of Giza]] guards it.",
			},
		},
		infobox = { { "Built", "~2560 BC" }, { "Blocks", "~2.3 million" } },
	},
	{
		title = "Great Sphinx of Giza",
		category = "Landmark",
		fame = 3,
		emoji = "🦁",
		tags = { "Ancient Egyptian monuments" },
		aliases = { "Sphinx", "Great Sphinx" },
		summary = "The **Great Sphinx of Giza** is a colossal limestone statue with the body of a [[Lion|lion]] and the head of a [[Pharaoh|pharaoh]], near the [[Great Pyramid of Giza]].",
		sections = { { "Nose", "Its nose is missing; it was damaged centuries ago." } },
		infobox = { { "Length", "73 m" }, { "Country", "[[Egypt]]" } },
	},
	{
		title = "Cleopatra",
		category = "Person",
		fame = 1,
		emoji = "👸",
		tags = { "Pharaohs", "Ancient Egyptians" },
		summary = "**Cleopatra** was the last active ruler of [[Ancient Egypt]]. She formed alliances with [[Julius Caesar]] and Mark Antony of Rome.",
		sections = {
			{
				"Time",
				"She lived closer in time to the [[Moon]] landing than to the building of the [[Great Pyramid of Giza|Great Pyramid]].",
			},
		},
		infobox = { { "Reign", "51–30 BC" }, { "Languages", "At least 9" } },
	},
	{
