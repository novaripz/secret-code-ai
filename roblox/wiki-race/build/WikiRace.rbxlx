	{
		title = "Ansel Adams",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American photographer and environmentalist (1902–1984)",
		tags = { "Other visual arts", "Photographers" },
		aliases = { "Ansel Easton Adams" },
		summary = '**Ansel Easton Adams** (February 20, 1902 – April 22, 1984) was an American landscape photographer and environmentalist known for his black-and-white images of the American West. He helped found Group f/64, an association of photographers advocating "pure" photography which favored sharp focus and the use of the full tonal range of a photograph. He and Fred Archer developed a system of image-making called the Zone System, a method of achieving a desired final print through a technical understanding of how the tonal range of an image is the result of choices made in exposure, negative development, and printing.',
		sections = {
			{
				"Overview",
				"Adams was a life-long advocate for environmental conservation, and his photographic practice was deeply entwined with this advocacy. At age 14, he was given his first camera during his first visit to [[Yosemite National Park]]. He developed his early photographic work as a member of the Sierra Club. He was later contracted with the United States Department of the Interior to make photographs of national parks. For his work and his persistent advocacy, which helped expand the National Park system, he was awarded the [[Presidential Medal of Freedom]] in 1980. In the founding and establishment of the photography department at the [[Museum of Modern Art]] in New York City, an important landmark in securing photography's institutional legitimacy, Adams was a key advisor.",
			},
		},
		related = { "Marcel Duchamp", "Philip Johnson" },
		infobox = {
			{ "Born", "20 February 1902" },
			{ "Birthplace", "[[San Francisco]], California, U.S." },
			{ "Died", "22 April 1984" },
			{ "Known for", "Photography and conservationism" },
			{ "Movement", "Group f/64" },
		},
	},
	{
		title = "Antigonus I Monophthalmus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Macedonian general, founder of Antigonid dynasty (382–301 BC)",
		tags = { "Western Asia", "Hellenistic Kingdoms" },
		summary = "**Antigonus I Monophthalmus** ( Antigonos Monophthalmos, \"Antigonus the One-Eyed\"; 382–301 BC) was a [[Ancient Macedonians|Macedonian Greek]] general and [[Diadochi|successor of]] [[Alexander the Great]] who founded the Antigonid dynasty, which ruled over Macedonia until its conquest by the [[Roman Republic]] in 168 BC. A prominent military leader in Alexander's army, he went on to control large parts of Alexander's former empire. He assumed the title of [[Basileus|basileus]] (king) in 306 BC and reigned until his death.",
		sections = {
			{
				"Overview",
				"Antigonus likely served under [[Philip II of Macedon]]. He took part in Alexander's invasion of Achaemenid Persia and was named [[Satrap|satrap]] of [[Phrygia]]. After Alexander's death in 323 BC, he also received Pamphylia and Lycia in accordance with the Partition of Babylon. However, he later incurred the enmity of Perdiccas, the regent of Alexander's empire, and was driven from Phrygia. He fled to Greece and formed an alliance with Antipater, later joined by [[Ptolemy I Soter|Ptolemy]], against Perdiccas. During a series of wars between Alexander's successors, Antigonus briefly emerged as the most powerful of the [[Diadochi]], ruling over Greece, Asia Minor, [[Syria (region)|Syria]], [[Phoenicia]] and northern [[Mesopotamia]].",
			},
		},
		infobox = {
			{ "Born", "382 BC" },
			{ "Birthplace", "[[Macedonia (ancient kingdom)|Macedonia]]" },
			{ "Died", "301 BC (aged 80–81)" },
		},
	},
	{
		title = "Antiochus III the Great",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "King of the Seleucid Empire from 222 to 187 BC",
		tags = { "Western Asia", "Hellenistic Kingdoms" },
		summary = "**Antiochus III the Great** was the sixth ruler of the [[Seleucid Empire]], reigning from 223 BC to 187 BC.",
		sections = {
			{
				"Overview",
				"Ascending to the throne at the age of eighteen, Antiochus inherited an empire in turmoil after the death of his brother, Seleucus III Ceraunus. While his initial campaigns against [[Ptolemaic Kingdom|Ptolemaic Egypt]] ended in failure, he spent the decade that followed successfully reasserting Seleucid authority over territory such as central [[Anatolia|Asia Minor]], Parthia and [[Greco-Bactrian Kingdom|Bactria]]. Pressing as far as the [[Kabul]] valley, he renewed a friendship with the Indian king Sophagasenus and earned himself the epithet \"the Great\" (Antiochos Megas). He also assumed the title Basileus Megas (Greek for 'Great King'), the [[Achaemenid Empire|traditional title of the Persian kings]]. Upon his return to the west, Antiochus launched another campaign against the Ptolemies and brought Coele-Syria, [[Phoenicia]] and Judea under Seleucid control. Antiochus's designs on the Greek city-states earned him the antagonism of the [[Roman Republic]].",
			},
		},
		infobox = {
			{ "Born", "c. 241 BC" },
			{ "Birthplace", "[[Susa]], [[Seleucid Empire]]" },
			{ "Died", "3 July 187 BC (aged 54)" },
		},
	},
	{
		title = "Antoine Lavoisier",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French nobleman and chemist (1743–1794)",
		tags = { "Chemistry", "Early modern" },
		aliases = { "Antoine-Laurent de Lavoisier" },
		summary = "**Antoine-Laurent de Lavoisier**, also **Antoine Lavoisier** after the [[French Revolution]], was a French nobleman and [[Chemist|chemist]] who was central to the 18th-century chemical revolution and who had a large influence on both the [[History of chemistry|history of chemistry]] and the [[History of biology|history of biology]].",
		sections = {
			{
				"Overview",
				"It is generally accepted that Lavoisier's great accomplishments in chemistry stem largely from his changing the science from a [[Analytical chemistry|qualitative]] to a quantitative one. Lavoisier is noted for his discovery of the role [[Oxygen|oxygen]] plays in [[Combustion|combustion]], opposing the prior phlogiston theory of combustion. He named oxygen (1778), recognizing it as an element, and also recognized [[Hydrogen|hydrogen]] as an element (1783). By using more precise measurements than previous experimenters, he confirmed the developing theory that, although [[Matter|matter]] in a closed system may change its form or shape, [[Conservation of mass|its mass always remains the same]] (now known as [[Conservation of mass|the law of conservation of mass]]), which led to the development of the balanced physical and chemical reaction equations that we still use today.",
			},
		},
		infobox = {
			{ "Born", "26 August 1743" },
