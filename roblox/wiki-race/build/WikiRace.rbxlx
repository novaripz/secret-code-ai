	{
		title = "Republic (Plato)",
		category = "Book",
		fame = 2,
		emoji = "📚",
		source = "wikipedia",
		description = "Philosophical work by Plato around 375 BC",
		tags = { "Specific works of nonfiction", "Nonfiction of antiquity" },
		summary = "The **Republic** is a [[Socratic dialogue]] authored by [[Plato]] around 375 BC, concerning [[Justice|justice]] (dikaiosúnē), the order and character of the just [[City-state|city-state]], and the just man. It is Plato's best-known work, and one of the world's most influential works of [[Philosophy|philosophy]] and [[Political philosophy|political theory]], both intellectually and historically.",
		sections = {
			{
				"Overview",
				"In the dialogue, [[Socrates]] discusses with various [[Classical Athens|Athenians]] and foreigners the meaning of justice and whether the just man is happier than the unjust man. He considers the natures of existing regimes and then proposes a series of hypothetical cities in comparison, culminating in Kallipolis, a [[Utopia|utopian]] city-state ruled by a class of philosopher-kings. They also discuss ageing, [[Love|love]], [[Theory of forms|theory of forms]], the immortality of the soul, and the role of the philosopher and of [[Poetry|poetry]] in [[Society|society]]. The dialogue's setting seems to be the time of the Peloponnesian War.",
			},
		},
		related = { "Anabasis (Xenophon)", "The Incoherence of the Philosophers" },
		infobox = {
			{ "Author", "[[Plato]]" },
			{ "Language", "[[Ancient Greek]]" },
			{ "Country", "[[Ancient Greece]]" },
			{ "Published", "c. 375 BC" },
		},
	},
	{
		title = "Rhyme",
		category = "Book",
		fame = 3,
		emoji = "🔊",
		source = "wikipedia",
		description = "Repetition of similar vowel sounds in language",
		tags = { "Literature", "Basics" },
		summary = "A **rhyme** is a repetition of similar sounds (usually the same [[Phoneme|phonemes]]) in the final [[Stress (linguistics)|stressed syllables]] and any following syllables of two or more words. Most often, this kind of rhyming (perfect rhyming) is consciously used for a musical or aesthetic effect in the final position of lines within poems or [[Song|songs]]. More broadly, a rhyme may also variously refer to other types of similar sounds near the ends of two or more words. Furthermore, the word rhyme has come to be sometimes used as a shorthand term for any brief poem, such as a nursery rhyme or Balliol rhyme.",
		related = { "Narration" },
	},
	{
		title = "Robinson Crusoe",
		category = "Book",
		fame = 3,
		emoji = "📖",
		source = "wikipedia",
		description = "1719 novel by Daniel Defoe",
		tags = { "Specific works of fiction", "Fiction of early printed book era" },
		summary = "**Robinson Crusoe** is an English adventure novel by [[Daniel Defoe]], first published on 25 April 1719. It is often credited as marking the beginning of realistic fiction as a literary genre, and has been described as the first [[Book|novel]], or at least the first English novel – although these labels are disputed.",
		sections = {
			{
				"Overview",
				'The story has been thought to be based on the life of Alexander Selkirk, a Scottish castaway who lived for four years on a Pacific island called "Más a Tierra" (now part of [[Chile]]) which was renamed Robinson Crusoe Island in 1966. Pedro Serrano is another real-life castaway whose story might have inspired the novel. The first edition credited the work\'s protagonist Robinson Crusoe as its author, leading many readers to believe he was a real person and that the book was a non-fiction travelogue. Despite its simple narrative style, Robinson Crusoe was well received in the literary world. Before the end of 1719, the book had already run through four editions, and it has gone on to become one of the most widely published books in history, spawning so many imitations, not only in literature but also in film, television, and radio, that its name is used to define a genre, the Robinsonade.',
			},
		},
		related = { "Candide", "Gulliver's Travels" },
		infobox = {
			{ "Author", "[[Daniel Defoe]]" },
			{ "Country", "[[Kingdom of Great Britain|Great Britain]]" },
			{ "Language", "English" },
			{ "Genre", "Adventure, historical fiction" },
			{ "Publisher", "William Taylor" },
			{ "Released", "25 April 1719" },
			{ "Setting", "England, the [[Caribbean]] and the [[Pyrenees]], 1651–1687" },
		},
	},
	{
		title = "Romance novel",
		category = "Book",
		fame = 2,
		emoji = "📖",
		source = "wikipedia",
		description = "Literary genre",
		tags = { "Literature", "Basics" },
		aliases = { "Romance", "Romance fiction" },
		summary = "**Romance**, or **romance fiction** (most famously in the form of a **romance novel**), is the [[Genre|genre]] of [[Narrative|narrative]] [[Fiction|fiction]] whose works focus on the romantic love and budding relationship between two or more characters, often concluding with an emotionally satisfying or optimistic ending. As a type of conventional [[Genre fiction|genre fiction]], its early major pioneering authors writing in Modern English include: Samuel Richardson, Frances Burney, Maria Edgeworth, [[Jane Austen]], Charlotte Brontë, Emily Brontë, and Anne Brontë.",
		sections = {
			{
				"Overview",
				"Romance novels can encompass various subgenres, such as bodice ripper, [[Fantasy|fantasy]], contemporary, historical romance, paranormal fiction, sapphic, and [[Science fiction|science fiction]]. While women have traditionally been considered the primary readers of romance novels, a 2017 study commissioned by the Romance Writers of America found that men accounted for 18% of romance book buyers. The genre of works retroactively referred to as \"romance novels\" existed as far back as Greece in the Roman era. Precursors can also be found in the literary fiction of the 18th and 19th centuries, including Samuel Richardson's sentimental novel Pamela, or Virtue Rewarded (1740) and the novels of [[Jane Austen]]. Austen inspired Georgette Heyer, the British author of historical romance set around Austen's lifetime, as well as [[Detective fiction|detective fiction]]. Heyer's first romance novel, The Black Moth (1921), was set in 1751.",
			},
		},
		related = { "Poetry" },
	},
	{
		title = "Romance of the Three Kingdoms",
		category = "Book",
		fame = 3,
		emoji = "👑",
		source = "wikipedia",
		description = "14th-century Chinese historical novel",
		tags = { "Specific works of fiction", "Fiction of antiquity" },
		summary = "**Romance of the Three Kingdoms** is a 14th-century Chinese historical novel attributed to Luo Guanzhong. Its narrative covers events from the decline of the [[Han dynasty]] and the Yellow Turban Rebellion to the reunification of China under the [[Jin dynasty (266–420)|Western Jin]] in 280.",
		sections = {
			{
				"Overview",
				'Romance of the Three Kingdoms is acclaimed as one of the Four Great Classic Novels of [[Chinese literature]]; it has a total of 800,000 words and nearly a thousand dramatic characters (mostly historical) in 120 chapters. The novel is among the most beloved works of literature in [[East Asia]], and its literary influence in the region has been compared to that of the works of [[William Shakespeare|Shakespeare]] on [[English literature]]. Its impact is also extensive and eminent in [[Southeast Asia]], with many of its characters becoming household names there. It has influenced literature, drama, games, and popular accounts of the Three Kingdoms throughout the regions. It is arguably the most widely read historical novel in late imperial and modern China. Herbert Giles stated that for the Chinese themselves, this is regarded as the "greatest among their countless novels".',
			},
		},
		related = { "Candide", "Gulliver's Travels" },
		infobox = {
			{ "Author", "Luo Guanzhong" },
