	{
		title = "Burundi",
		category = "Country",
		fame = 2,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Country in East Africa",
		tags = { "Africa", "East Africa" },
		aliases = { "Republic of Burundi" },
		summary = "**Burundi**, officially the **Republic of Burundi**, is a [[Landlocked country|landlocked country]] in [[East Africa]]. It is located in the [[Great Rift Valley]] at the junction between the [[African Great Lakes]] region and southeastern Africa, with a population of over 14 million people. It is bordered by [[Rwanda]] to the north, [[Tanzania]] to the east and southeast, and the [[Democratic Republic of the Congo]] to the west; [[Lake Tanganyika]] lies along its southwestern border. The political [[Capital city|capital city]] is Gitega and the economic capital and largest city is Bujumbura.",
		sections = {
			{
				"Overview",
				"The Twa, Hutu, and Tutsi peoples have lived in Burundi for at least 500 years. For more than 200 of those years, Burundi was an independent kingdom. In 1885, it became part of German East Africa. After the [[World War I|First World War]] and Germany's defeat, the [[League of Nations]] mandated the territories of Burundi and Rwanda to Belgium in a combined territory called Ruanda-Urundi. After the [[World War II|Second World War]], this transformed into a United Nations trust territory. Burundi gained independence in 1962 and initially retained the monarchy. In 1993, Melchior Ndadaye became Burundi's first Hutu president following the country's first multi-party presidential election. In 2000, the Arusha Agreement was adopted, which was largely integrated in a new constitution in 2005.",
			},
		},
		infobox = {
			{ "Official languages", "Kirundi, French, [[English language|English]]" },
