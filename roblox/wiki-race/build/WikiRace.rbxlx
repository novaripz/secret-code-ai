	{
		title = "Doll",
		category = "Concept",
		fame = 2,
		emoji = "🪆",
		source = "wikipedia",
		description = "Model, typically of a humanoid character",
		tags = { "Entertainment", "Toys" },
		summary = "A **doll** is a model typically of a [[Human|human]] or humanoid character, often used as a [[Toy|toy]] for children. Dolls have also been used in traditional religious rituals throughout the world. Traditional dolls made of materials such as clay and wood are found in the Americas, Asia, Africa and Europe. The earliest documented dolls go back to the ancient civilizations of [[Ancient Egypt|Egypt]], [[Ancient Greece|Greece]], and [[Roman Empire|Rome]]. They have been made as crude, rudimentary playthings as well as elaborate [[Art|art]]. Modern doll manufacturing has its roots in Germany, from the 15th century. With [[Industrialisation|industrialization]] and new materials such as [[Porcelain|porcelain]] and [[Plastic|plastic]], dolls were increasingly mass-produced.",
		sections = { { "Overview", "During the 20th century, dolls became increasingly popular as collectibles." } },
