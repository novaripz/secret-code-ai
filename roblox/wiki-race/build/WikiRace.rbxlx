	{
		title = "Electrical wiring",
		category = "Engineering",
		fame = 2,
		emoji = "⚙️",
		source = "wikipedia",
		description = "Electrical installation of cabling",
		tags = { "Infrastructure by type", "Other components" },
		summary = "**Electrical wiring** is an electrical installation of [[Electrical cable|cabling]] and associated devices such as [[Nintendo Switch|switches]], distribution boards, receptacles, outlets, and light fittings in a structure.",
		sections = {
			{
				"Overview",
				"Wiring is subject to safety standards for design and installation. Allowable [[Wire|wire]] and [[Electrical cable|cable]] types and sizes are specified according to the circuit operating [[Voltage|voltage]] and [[Electric current|electric current]] capability, with further restrictions on the environmental conditions, such as ambient temperature range, moisture levels, and exposure to sunlight and chemicals. Associated circuit protection, control, and distribution devices within a building's wiring system are subject to voltage, current, and functional specifications. Wiring safety codes (including wiring wiring colours) vary by locality, country, or region. The [[International Electrotechnical Commission]] (IEC) is attempting to harmonise wiring standards among member countries, but significant variations in design and installation requirements still exist.",
			},
