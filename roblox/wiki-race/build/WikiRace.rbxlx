		infobox = { { "First photo", "1826" }, { "Related", "[[Photography]]" } },
	},
	{
		title = "GPS",
		category = "Technology",
		fame = 2,
		emoji = "📍",
		tags = { "Navigation" },
		aliases = { "Global Positioning System" },
		summary = "**GPS** is a navigation system that uses [[Satellite|satellites]] to pinpoint your location anywhere on [[Earth]].",
		sections = {
			{
				"Relativity",
				"GPS satellites must correct for [[Theory of relativity|relativity]], or maps would drift by kilometers a day.",
			},
		},
		infobox = { { "Satellites", "31" }, { "Operated by", "[[United States]]" } },
	},
}
]]></string>
