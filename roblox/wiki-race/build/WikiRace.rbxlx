			{ "Occupation", "Novelist journalist short story writer essayist" },
			{ "Movement", "American Realism, [[Naturalism (literature)|Naturalism]]" },
		},
	},
	{
		title = "Jackson Pollock",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American painter (1912–1956)",
		tags = { "Western painters and illustrators", "Modern era" },
		aliases = { "Paul Jackson Pollock" },
		summary = '**Paul Jackson Pollock** was an American painter. A major figure in the abstract expressionist movement, he was widely noticed for his "drip technique" of pouring or splashing liquid household paint onto a horizontal surface, enabling him to view and paint his canvases from all angles. It was called all-over painting and action painting, because Pollock covered the entire canvas and used the force of his whole body to paint, often in a frenetic dancing style. This extreme form of abstraction divided critics: some praised the immediacy of the creation, while others derided the random effects.',
		sections = {
			{
				"Overview",
				"In 1945, he married artist Lee Krasner, who became an important influence on his career and on his legacy. Four months after his death, Pollock was given a memorial retrospective exhibition at the [[Museum of Modern Art]] (MoMA) in New York City. A larger, more comprehensive exhibition of his work was held there in 1967. In 1998 and 1999, Pollock's work was honored with large-scale retrospective exhibitions at MoMA and the Tate Gallery in London.",
			},
		},
		related = { "Edgar Degas", "Henri Rousseau", "Piet Mondrian" },
		infobox = {
			{ "Born", "28 January 1912" },
			{ "Birthplace", "Cody, Wyoming, U.S." },
			{ "Died", "11 August 1956" },
			{ "Known for", "[[Painting]]" },
			{ "Education", "Art Students League of New York" },
			{ "Movement", "[[Abstract expressionism]]" },
		},
	},
	{
		title = "Jacob Bernoulli",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Swiss mathematician (1655–1705)",
		tags = { "Mathematicians", "Early modern" },
		summary = "He sided with [[Gottfried Wilhelm Leibniz]] during the Leibniz–Newton calculus controversy and was an early proponent of Leibnizian [[Calculus|calculus]], to which he made numerous contributions. A member of the Bernoulli family, he, along with his brother [[Johann Bernoulli|Johann]], was one of the founders of the [[Calculus of variations|calculus of variations]]. He also discovered the fundamental mathematical constant [[E (mathematical constant)|e]]. However, his most important contribution was in the field of [[Probability|probability]], where he derived the first version of the [[Law of large numbers|law of large numbers]] in his work Ars Conjectandi.",
		sections = {
			{
				"Overview",
				"Bernoulli's [[Given name|given name]] is also sometimes given as **Jakob** (which was his name in [[German language|German]]). He was also known as **James** in English or **Jacques** in French. When publishing in [[Latin]], as he often did, his name was given as Jacobus Bernoullius. To distinguish him from his relative Jakob II Bernoulli, Bernoulli is sometimes given the generational suffix I, as in **Jacob I Bernoulli**.",
			},
		},
		related = { "Gerolamo Cardano" },
		infobox = {
			{ "Born", "6 January 1655" },
			{ "Birthplace", "[[Basel]], [[Old Swiss Confederacy|Switzerland]]" },
			{ "Died", "16 August 1705" },
			{ "Field", "[[Mathematics]], [[Mechanics|mechanics]]" },
			{ "Worked at", "[[University of Basel]]" },
			{ "Education", "[[University of Basel]] (D.Th., 1676; Dr. phil. hab., 1684)" },
			{ "Teacher", "Peter Werenfels (1676 thesis advisor)" },
		},
	},
	{
		title = "Jacobus Henricus van 't Hoff",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Dutch physical and organic chemist (1852–1911)",
		tags = { "Chemistry", "Modern" },
		aliases = { "Jacobus Henricus van 't Hoff Jr." },
		summary = "**Jacobus Henricus van 't Hoff Jr.** was a Dutch [[Physical chemistry|physical chemist]]. A highly influential theoretical chemist, in 1901 Van 't Hoff won the first [[Nobel Prize in Chemistry]] \"[for his] discovery of the laws of chemical dynamics and osmotic pressure in solutions\". His pioneering work helped found the modern theory of chemical affinity, [[Chemical equilibrium|chemical equilibrium]], [[Chemical kinetics|chemical kinetics]], and [[Chemical thermodynamics|chemical thermodynamics]]. In his 1874 pamphlet, Van 't Hoff formulated the theory of the tetrahedral carbon atom and laid the foundations of stereochemistry. In 1875, he predicted the correct structures of allenes and cumulenes as well as their axial chirality.",
		sections = {
			{
				"Overview",
				"He is also widely considered one of the three co-founders of [[Physical chemistry|physical chemistry]] as the discipline is known today. The Zeitschrift für physikalische Chemie (Journal of Physical Chemistry) was founded in 1887 by Van ’t Hoff, [[Svante Arrhenius]] and Wilhelm Ostwald, at Leipzig University as the first dedicated scientific journal for the discipline.",
			},
		},
		related = { "Harold Urey" },
		infobox = {
			{ "Born", "30 August 1852" },
			{ "Birthplace", "[[Rotterdam]], Netherlands" },
			{ "Died", "1 March 1911" },
			{ "Field", "[[Physical chemistry]] [[Organic chemistry]] Theoretical chemistry" },
			{
				"Worked at",
				"Veterinary College in Utrecht University of Amsterdam [[Humboldt University of Berlin|University of Berlin]]",
			},
			{ "Teacher", "Eduard Mulder" },
		},
	},
	{
		title = "Jacques Cartier",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French maritime explorer of North America (1491–1557)",
		tags = { "Explorers", "Early modern" },
		summary = '**Jacques Cartier** was a French maritime explorer from [[Brittany]]. Jacques Cartier was the first [[European people|European]] to describe and map the Gulf of Saint Lawrence and the shores of the Saint Lawrence River, which he named "Canada" after the Iroquoian names for the two big settlements he saw at Stadacona (Quebec City) and at Hochelaga (Montreal Island).',
		sections = {
			{
				"Overview",
				"Jacques Cartier, author of now-lost maps and accounts of his voyages, was the first European to describe and name this region and its inhabitants—at a time when the Spanish had already settled in the [[Caribbean]], [[Mexico]], and [[Central America]], and were beginning their conquest of Peru.",
			},
		},
		related = { "Fred Rogers", "Samuel Goldwyn" },
