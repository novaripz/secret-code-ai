        <Properties>
          <string name="Name">ArtsAndLiterature</string>
          <string name="Source"><![CDATA[-- Visual art, artists, books and writers.
return {
	{
		title = "Art",
		category = "Art",
		fame = 1,
		emoji = "🎨",
		tags = { "Arts" },
		aliases = { "Visual art", "Artwork" },
		summary = "**Art** is the creation of works that express ideas, beauty or emotion. Visual arts include [[Painting|painting]], [[Sculpture|sculpture]] and [[Photography|photography]].",
		sections = {
			{
				"Movements",
				"Major movements include the [[Renaissance]], [[Impressionism]], [[Cubism]] and [[Pop art|pop art]].",
			},
			{ "Where to see it", "Great art is displayed in [[Museum|museums]] like the [[Louvre]]." },
		},
		infobox = { { "Oldest cave art", "~51,000 years old" }, { "Related", "[[Literature]], [[Music]]" } },
		related = { "Literature" },
	},
	{
		title = "Painting",
		category = "Art",
		fame = 2,
		emoji = "🖌️",
		tags = { "Visual arts" },
		aliases = { "Paintings", "Painter" },
		summary = "**Painting** is the art of applying paint to a surface such as canvas, wood or walls.",
		sections = {
			{
				"Famous paintings",
				"The [[Mona Lisa]], [[The Starry Night]] and [[The Scream]] are among the most famous paintings ever made.",
			},
		},
		infobox = { { "Media", "Oil, watercolor, acrylic" }, { "Related", "[[Color]]" } },
		related = { "Frida Kahlo" },
	},
	{
		title = "Sculpture",
		category = "Art",
		fame = 2,
		emoji = "🗿",
		tags = { "Visual arts" },
		aliases = { "Sculptures", "Statue", "Statues" },
		summary = "**Sculpture** is art made in three dimensions by carving stone, modeling clay or casting metal.",
		sections = {
			{
				"Masterpieces",
				"[[Michelangelo]]'s [[David (Michelangelo)|David]] and the [[Statue of Liberty]] are world-famous sculptures.",
			},
		},
		infobox = { { "Materials", "Marble, bronze, clay" }, { "Related", "[[Painting]]" } },
	},
	{
		title = "Leonardo da Vinci",
		category = "Person",
		fame = 1,
		emoji = "🎨",
		tags = { "Renaissance artists", "Inventors", "Italian people" },
		aliases = { "Leonardo", "Da Vinci" },
		summary = "**Leonardo da Vinci** was an Italian [[Renaissance]] painter, scientist and inventor. He painted the [[Mona Lisa]] and [[The Last Supper]].",
		sections = {
			{
				"Inventor",
				"His notebooks contain designs for a flying machine, a [[Helicopter|helicopter]]-like screw and armored vehicles, written in mirror script.",
			},
		},
		infobox = { { "Born", "1452, [[Italy]]" }, { "Famous work", "[[Mona Lisa]]" } },
	},
	{
		title = "Mona Lisa",
		category = "Art",
		fame = 1,
		emoji = "🖼️",
		tags = { "Paintings", "Renaissance art" },
		aliases = { "La Gioconda" },
		summary = "The **Mona Lisa** is a portrait by [[Leonardo da Vinci]] and probably the most famous painting in the world. It hangs in the [[Louvre]] in [[Paris]].",
		sections = {
			{
				"Theft",
				"It was stolen from the Louvre in 1911 and recovered two years later, which made it even more famous.",
			},
		},
		infobox = { { "Artist", "[[Leonardo da Vinci]]" }, { "Location", "[[Louvre]]" } },
	},
	{
		title = "The Last Supper",
		category = "Art",
		fame = 3,
		emoji = "🍞",
		tags = { "Paintings", "Renaissance art" },
		summary = "**The Last Supper** is a mural painted by [[Leonardo da Vinci]] in the 1490s on a wall in Milan, [[Italy]].",
		sections = {
			{
				"Technique",
				"Leonardo experimented with painting on dry plaster, so the mural began flaking within his lifetime.",
			},
		},
		infobox = { { "Artist", "[[Leonardo da Vinci]]" }, { "Completed", "~1498" } },
	},
	{
		title = "Michelangelo",
		category = "Person",
		fame = 2,
		emoji = "🗿",
		tags = { "Renaissance artists", "Italian people" },
		summary = "**Michelangelo** was an Italian [[Renaissance]] sculptor, painter and architect who carved [[David (Michelangelo)|David]] and painted the ceiling of the [[Sistine Chapel]].",
		sections = { { "Rivalry", "He was a rival of [[Leonardo da Vinci]]. He considered himself a sculptor first." } },
		infobox = { { "Born", "1475, [[Italy]]" }, { "Famous work", "[[David (Michelangelo)|David]]" } },
	},
	{
		title = "David (Michelangelo)",
		category = "Art",
		fame = 3,
		emoji = "🗿",
		tags = { "Sculptures", "Renaissance art" },
