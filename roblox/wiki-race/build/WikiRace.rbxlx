		fame = 1,
		emoji = "💡",
		tags = { "Inventions", "Lighting" },
		aliases = { "Lightbulb", "Incandescent light bulb" },
		summary = "The **light bulb** produces [[Light|light]] from [[Electricity|electricity]]. [[Thomas Edison]] made the first long-lasting practical bulb in 1879.",
		sections = {
			{ "Symbol", "A glowing bulb has become the universal symbol of a new idea or [[Invention|invention]]." },
		},
		infobox = { { "Practical version", "1879" }, { "Inventor", "[[Thomas Edison]]" } },
	},
	{
		title = "Thomas Edison",
		category = "Person",
