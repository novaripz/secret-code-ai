		},
		infobox = { { "Era", "~800–146 BC" }, { "Famous leader", "[[Alexander the Great]]" } },
		related = { "History" },
	},
	{
		title = "Socrates",
		category = "Person",
		fame = 2,
		emoji = "🤔",
		tags = { "Philosophers", "Ancient Greeks" },
		summary = "**Socrates** was a philosopher of [[Athens]] who taught by asking endless questions. He wrote nothing himself.",
