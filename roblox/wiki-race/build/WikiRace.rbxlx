			{ "Birthplace", "[[Damascus]], [[Umayyad Caliphate]] (present-day [[Syria]])" },
			{ "Died", "30 September 788 (aged 57)" },
		},
	},
	{
		title = "Abd al-Rahman III",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Final Emir of Córdoba (r. 912–929); founder and 1st Caliph of Córdoba (r. 929–961)",
		tags = { "Western Europe", "Iberia" },
		aliases = { "Or simply" },
		summary = "**ʿAbd al-Raḥmān ibn Muḥammad ibn ʿAbd Allāh ibn Muḥammad ibn ʿAbd al-Raḥmān ibn al-Ḥakam al-Rabdī ibn Hishām ibn [[Abd al-Rahman I|ʿAbd al-Raḥmān al-Dākhil]] al-Marwānī al-Umawī al-Qurashī**, or simply **ʿAbd al-Raḥmān III**, was the [[Umayyad dynasty|Umayyad]] Emir of Córdoba from 912 to 929, at which point he founded the Caliphate of Córdoba, serving as its first caliph until his death. Abd al-Rahman won the laqab (sobriquet) **al-Nāṣir li-Dīn Allāh** in his early 20s when he supported the Maghrawa [[Berbers]] in [[North Africa]] against Fatimid expansion and later claimed the title of Caliph for himself. His half-century reign was known for its [[Freedom of religion|religious tolerance]].",
		related = { "Afonso I of Portugal" },
		infobox = {
			{ "Born", "18 December 890" },
			{ "Birthplace", "[[Córdoba, Spain|Córdoba]]" },
			{ "Died", "15 October 961" },
