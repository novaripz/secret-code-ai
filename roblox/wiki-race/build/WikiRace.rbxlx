		category = "Geography",
		fame = 1,
		emoji = "🌋",
		tags = { "Landforms" },
		aliases = { "Volcanoes" },
		summary = "A **volcano** is an opening in [[Earth]]'s crust where molten rock, ash and gas escape. Famous examples include [[Mount Vesuvius]] and [[Mount Fuji]].",
		sections = {
			{
				"Effects",
				"Eruptions can bury cities, trigger [[Tsunami|tsunamis]] and even create new [[Island|islands]], like those of [[Hawaii]].",
			},
		},
		infobox = { { "Active volcanoes", "About 1,350" }, { "Related", "[[Earthquake]]" } },
	},
