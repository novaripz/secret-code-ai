	{
		title = "São Tomé and Príncipe",
		category = "Country",
		fame = 2,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Island country in Central Africa",
		tags = { "Africa", "Central Africa" },
		aliases = { "Democratic Republic of Sao Tome and Principe" },
		summary = "**São Tomé and Príncipe**, officially the **Democratic Republic of Sao Tome and Principe**, is an [[Island country|island country]] in the [[Gulf of Guinea]], off the western equatorial coast of [[Central Africa]]. It consists of two [[Archipelago|archipelagos]] around the two main islands of São Tomé and Príncipe, about 81 nmi apart and about 135 and 121 nmi off the northwestern coast of [[Gabon]]. With a population of 201,800 (2018 official estimate), São Tomé and Príncipe is the second-smallest and second-least populous African [[Sovereign state|sovereign state]] after [[Seychelles]].",
		sections = {
			{
				"Overview",
				"The islands were uninhabited until Portuguese explorers João de Santarém and Pedro Escobar discovered them on 21 December 1470. The rich volcanic soil and proximity to the equator made São Tomé and Príncipe ideal for sugar cultivation, followed later by other cash crops such as coffee and [[Cocoa bean|cocoa]]. Cycles of social unrest and economic instability throughout the 19th and 20th centuries culminated in peaceful independence in 1975 as a one-party [[Communist state|communist state]], which would remain in place until 1990. São Tomé and Príncipe has since remained one of Africa's most stable and democratic countries. São Tomé and Príncipe is a developing economy with a medium [[Human Development Index]]. The people of São Tomé and Príncipe are predominantly of African and mestiço (mixed European and African) descent, with most practicing Christianity.",
			},
		},
		infobox = {
			{ "Languages", "Portuguese" },
