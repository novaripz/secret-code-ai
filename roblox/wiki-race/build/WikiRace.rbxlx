		fame = 3,
		emoji = "⏳",
		source = "wikipedia",
		description = "Unit of time equal to 60 minutes",
		tags = { "Units of measurement", "Time" },
		aliases = { "Also abbreviated" },
		summary = "An **hour** (symbol: **h**; also abbreviated **hr**) is a [[Unit of measurement|unit]] of [[Time|time]] historically reckoned as 1/24 of a [[Day|day]] and defined contemporarily as exactly 3,600 [[Second|seconds]]. There are 60 minutes in an hour, and 24 hours in a day. As defined by a second, an hour is equal to 33,093,474,372,000 periods of radiation, or vibrations, of the cesium-133 atom.",
		sections = {
			{
				"Overview",
				"The hour was initially established in the [[Ancient Near East|ancient Near East]] as a variable measure of 1/12 of the [[Night|night]] or [[Daytime|daytime]]. Such **seasonal hours**, also known as **temporal hours** or unequal hours, varied by [[Season|season]] and [[Latitude|latitude]]. **Equal hours** or **equinoctial hours** were taken as 1/24 of the day as measured from noon to noon; the minor seasonal variations of this unit were eventually smoothed by making it 1/24 of the mean solar day. Since this unit was not constant due to long-term variations in the Earth's rotation, the hour was finally separated from the Earth's rotation and defined in terms of the [[Second|atomic or physical second]].",
			},
		},
		infobox = {
			{ "Symbol", "h" },
		},
