		summary = "**Impartiality** (also called **evenhandedness** or **fair-mindedness**) is a principle of [[Justice|justice]] holding that decisions should be based on objective criteria, rather than on the basis of [[Bias|bias]], [[Prejudice|prejudice]], or preferring the benefit to one person over another for improper reasons.",
		related = { "Equity (law)" },
