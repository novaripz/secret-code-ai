	{
		title = "Peter Kropotkin",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Russian anarchist (1842–1921)",
		tags = { "Political writers", "Modern" },
		summary = "Born into an aristocratic land-owning family, Kropotkin attended the Page Corps and later served as an officer in [[Siberia]], where he participated in several geological expeditions. He was imprisoned for his activism in 1874 and managed to escape two years later. He spent the next 41 years in exile in [[Switzerland]], [[France]] (where he was imprisoned for almost four years), and [[England]]. While in exile, he gave lectures and published widely on anarchism and geography. Kropotkin returned to Russia after the [[Russian Revolution]] in 1917, but he was disappointed by the Bolshevik state.",
		sections = {
			{
				"Overview",
				"Kropotkin was a proponent of the idea of decentralized communist society free from central government and based on voluntary associations of self-governing communities and worker-run enterprises. He wrote many books, pamphlets and articles, the most prominent being The Conquest of Bread (1892) and Fields, Factories, and Workshops (1899), with Mutual Aid: A Factor of Evolution (1902) being his principal scientific offering. He contributed the article on anarchism to the eleventh edition of the Encyclopædia Britannica and left an unfinished work on anarchist ethical philosophy.",
			},
		},
		related = { "Antonio Gramsci", "Friedrich Engels" },
