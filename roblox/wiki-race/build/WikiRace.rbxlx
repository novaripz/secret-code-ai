	{
		title = "Summa Theologica",
		category = "Book",
		fame = 3,
		emoji = "📚",
		source = "wikipedia",
		description = "Theological treatise by Thomas Aquinas",
		tags = { "Specific works of nonfiction", "Nonfiction of antiquity" },
		aliases = { "Summa Theologiae", "Summa" },
		summary = "The **Summa Theologiae** or **Summa Theologica**, often referred to simply as the **Summa**, is the best-known work of [[Thomas Aquinas]] (1225–1274), a [[Scholasticism|scholastic]] theologian and Doctor of the Church. It is a compendium of all of the main theological teachings of the Catholic Church. Presenting the reasoning for almost all points of Christian theology in the West, topics of the Summa follow the following cycle: God; Creation, Man; [[Teleology|Man's purpose]]; Christ; the Sacraments; and back to God.",
		sections = {
			{
				"Overview",
				'[[Thomas Aquinas|Although unfinished]], it is "one of the classics of the history of philosophy and one of the most influential works of Western literature". It remains Aquinas\'s "most perfect work, the fruit of his mature years, in which the thought of his whole life is condensed". The Summa is a more structured and expanded version of Aquinas\'s earlier Summa contra Gentiles, though the two were written for different purposes. Throughout the Summa, Aquinas aims to reconcile Aristotelian philosophy with Catholic theology. Although he broadly cites the Bible, patristic, [[Scholasticism|scholastic]], [[Islamic philosophy|Islamic]], Jewish, and pre-Christian [[Ancient Greek philosophy|Greek]] and Roman sources, his most referenced non-scriptural authors are [[Aristotle]] (who he calls "the philosopher") and [[Augustine of Hippo|Augustine]]. The Summa Theologiae was one of the main intellectual inspirations for [[Thomism|Thomistic philosophy]].',
			},
		},
		related = { "Anabasis (Xenophon)", "The Incoherence of the Philosophers" },
		infobox = {
			{ "Author", "[[Thomas Aquinas]]" },
			{ "Publisher", "Benziger Brothers Printers to the Holy Apostolic See" },
			{ "Published", "Unfinished at his death in 1274" },
			{ "Language", "[[Latin]]" },
		},
	},
	{
		title = "Superhero",
		category = "Book",
		fame = 2,
		emoji = "📚",
		source = "wikipedia",
		description = "Type of character",
		tags = { "Literature", "Basics" },
		aliases = { "Superheroine" },
		summary = "A **superhero** or **superheroine** is a character who typically possesses superpowers or abilities beyond those of ordinary people; is frequently costumed, concealing their identity; and fits the role of the [[Hero|hero]], typically using their powers to help the world become a better place, or dedicating themselves to protecting the public and fighting crime. Superhero fiction is the genre of [[Fiction|fiction]] that is centered on such characters, especially, since the 1930s, in American comic books (and later in Hollywood films, film serials, television and [[Video game|video games]]), as well as in Japanese media (including kamishibai, tokusatsu, [[Manga|manga]], [[Anime|anime]] and video games).",
		sections = {
			{
				"Overview",
				"Superheroes come from a wide array of different backgrounds and origins. Most superheroes (for example, [[Superman]] and [[Spider-Man]]) usually possess non-human or superhuman biology, while others (such as [[Batman]] and [[Iron Man]]) derive their status from advanced [[Technology|technology]] they create and use; others may use or possess objects that have superhuman, mystical, or alien powers (such as Green Lantern and He-Man), or study and practice [[Magic (supernatural)|magic]] to achieve their abilities (such as Doctor Fate and Doctor Strange).",
			},
		},
	},
