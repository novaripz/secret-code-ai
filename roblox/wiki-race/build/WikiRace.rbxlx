	{
		title = "July Revolution",
		category = "History",
		fame = 2,
		emoji = "📜",
		source = "wikipedia",
		description = "1830 overthrow of the Bourbon monarchy in France",
		tags = { "Europe", "Western Europe" },
		aliases = { "French Revolution of 1830", "Second French Revolution" },
		summary = 'The **July Revolution**, also known as the **French Revolution of 1830**, **Second French Revolution**, or ("the Three Glorious [Days]"), was a second French Revolution after [[French Revolution|the first]] of 1789–99. It led to the overthrow of King Charles X, the French [[House of Bourbon|Bourbon]] monarch, and the ascent of his cousin Louis Philippe, Duke of Orléans, who governed for 18 years as the last king of France.',
		sections = {
			{
				"Overview",
				"The 1830 Revolution marked a shift from that point on as the [[Constitutional monarchy|constitutional monarchy]] was restored with the [[July Monarchy]]; the definite fall of the House of Bourbon in favour of its [[Cadet branch|cadet branch]], the House of Orléans; and the replacement of the principle of hereditary right by that of popular sovereignty. Supporters of the Bourbons would be called Legitimists, and supporters of Louis Philippe were known as Orléanists. In addition, there continued to be Bonapartists supporting the return of [[Napoleon|Napoleon's]] heirs. After 18 precarious years on the throne, Louis-Philippe was overthrown in the French Revolution of 1848, and [[Napoleon III|Louis Napoleon]] returned the Bonapartists to power the same year.",
			},
		},
		infobox = {
			{ "Location", "[[Paris]], [[Bourbon Restoration in France|Kingdom of France]]" },
			{ "Date", "26–29 July 1830" },
		},
