			{ "Government", "[[Semi-presidential system|Semi-presidential republic]]" },
			{ "Established", "12 July 1975" },
			{ "Area", "964 km²" },
		},
	},
	{
		title = "Taiwan",
		category = "Country",
		fame = 1,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Country in East Asia",
		tags = { "Countries", "Asia" },
		aliases = { "Republic of China", "ROC" },
		summary = "**Taiwan**, officially the **Republic of China** (**ROC**), is a country in [[East Asia]]. The main island of Taiwan, also known as Formosa, lies between the [[East China Sea|East]] and [[South China Sea|South China Seas]] in the northwestern [[Pacific Ocean]], with the [[China|People's Republic of China]] (PRC) to the northwest, [[Japan]] to the northeast, and the [[Philippines]] to the south. It has an area of 35,808 km², with mountain ranges dominating the eastern two-thirds and plains in the western third, where its highly urbanized population is concentrated. The combined territories under ROC control consist of 168 islands in total covering 36193 km². The largest metropolitan area is formed by [[Taipei]] (the capital), New Taipei City, and Keelung.",
		sections = {
			{
				"Overview",
				"With around 23.9 million inhabitants, Taiwan is among the most densely populated countries. Taiwan has been settled for at least 25,000 years. Ancestors of Taiwanese indigenous peoples settled the island around 6,000 years ago. In the 17th century, large-scale [[Han Chinese]] immigration began under Dutch colonial rule and continued under the Kingdom of Tungning, the first predominantly Han Chinese state in Taiwanese history. The island was annexed in 1683 by the [[Qing dynasty]] and ceded to the [[Empire of Japan]] in 1895. The Republic of China, controlled by Chiang Kai-shek and the [[Kuomintang]] (KMT), assumed control following the [[Surrender of Japan|surrender of Japan]] in [[World War II]]. With the loss of [[Mainland China|mainland China]] to the Communists in the Chinese Civil War, the [[Retreat of the government of the Republic of China to Taiwan|government of the Republic of China moved to Taiwan in 1949]].",
			},
		},
		infobox = {
			{ "Largest city", "New Taipei City" },
			{ "Capital", "[[Taipei]]" },
			{ "Official languages", "[[Standard Chinese]]" },
			{ "Languages", "[[Traditional Chinese characters|Traditional Chinese]]" },
			{ "People are called", "Taiwanese" },
			{ "Government", "Unitary [[Semi-presidential system|semi-presidential republic]]" },
			{ "Established", "1624" },
		},
	},
	{
		title = "Tajikistan",
		category = "Country",
		fame = 1,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Landlocked country in Central Asia",
		tags = { "Asia", "Central Asia" },
		aliases = { "Republic of Tajikistan" },
		summary = "**Tajikistan**, officially the **Republic of Tajikistan**, is a [[Landlocked country|landlocked country]] located in [[Central Asia]]. Dushanbe is the [[Capital city|capital]] and largest city of the country, with a population of over 1.2 million. Tajikistan borders [[Afghanistan]] to the south, [[Uzbekistan]] to the west, [[Kyrgyzstan]] to the north, and [[China]] to the east; it is narrowly separated from [[Pakistan]] by Afghanistan's Wakhan Corridor. Its total population exceeds 11million.",
		sections = {
			{
				"Overview",
				"The territory was previously home to cultures of the [[Neolithic]] and the [[Bronze Age]], including the Oxus civilisation in the west. Parts of the country were part of the [[Sogdia|Sogdian]] and [[Bactria|Bactrian]] civilisations, and were ruled by the [[Achaemenid Empire|Achaemenids]], [[Alexander the Great]], the [[Greco-Bactrian Kingdom|Greco‑Bactrians]], the [[Kushan Empire|Kushans]], the Kidarites, the Hephthalites, the First Turkic Khaganate, the [[Umayyad Caliphate|Umayyad]] and [[Abbasid Caliphate|Abbasid Caliphates]], the [[Samanid Empire]], the Kara‑Khanids, the [[Seljuk Empire|Seljuks]], the [[Khwarazmian Empire|Khwarazmians]], the [[Mongol Empire|Mongols]], the [[Timurid Empire|Timurids]], and the [[Khanate of Bukhara]]. The region was later conquered by the [[Russian Empire]], before becoming part of the [[Soviet Union]]. Within the Soviet Union, the country's borders were drawn when it was part of Uzbekistan as an autonomous republic, before becoming a constituent republic of the Soviet Union on 5 December 1929.",
			},
		},
		infobox = {
			{ "Capital", "Dushanbe" },
