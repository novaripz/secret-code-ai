		tags = { "More articles" },
		aliases = { "Space-grant colleges" },
		summary = "The **space-grant colleges** are educational institutions in the United States that comprise a network of fifty-three consortia established in 1988 for the purpose of outer space-related research. Each consortium is based in one of the fifty states, the District of Columbia, [[Puerto Rico]], and [[Guam]]. Each consists of multiple independent space-grant institutions, with one of the institutions acting as lead.",
		sections = {
			{
				"Overview",
				"Similar programs include sea-grant colleges (instituted in 1966) and sun-grant colleges (instituted in 2003).",
