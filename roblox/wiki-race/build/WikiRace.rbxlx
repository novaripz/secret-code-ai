	{
		title = "Nezha",
		category = "Fictional Character",
		fame = 3,
		emoji = "🕯️",
		source = "wikipedia",
		description = "Protection deity in Chinese folk religion",
		tags = { "Fictional and legendary characters", "Eastern folklore" },
		aliases = { "Nezha the Crown Prince" },
		summary = '**Nezha** or sometimes **Nezha the Crown Prince**, or Natha, is a protection deity in Taoism, Buddhism, [[Confucianism]], and Chinese folk religion. His official Taoist name is "Marshal of the Central Altar". He was then given the title "Third Lotus Prince" after he became a deity.',
