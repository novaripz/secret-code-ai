	{
		title = "Philip V of Spain",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "King of Spain (1700–1724; 1724–1746)",
		tags = { "Western Europe", "Southern Europe" },
		aliases = { "Philip V" },
		summary = "**Philip V** was [[Monarchy of Spain|king of Spain]] from 1 November 1700 to 14 January 1724 and again from 6 September 1724 to his death in 1746. His total reign (45 years, 9 months and 8 days) is the longest in the history of the Spanish monarchy, surpassing Philip IV. Although his ascent to the throne precipitated the War of the Spanish Succession, Philip V instigated many important reforms in Spain, most especially the centralization of power of the monarchy and the suppression of regional privileges, via the Nueva Planta decrees, and restructuring of the administration of the [[Spanish Empire]] on the [[Iberian Peninsula]] and its overseas regions.",
		sections = {
			{
				"Overview",
				"Philip was born into the French [[House of Bourbon]] during the reign of his paternal grandfather King [[Louis XIV]]. He was the second son of Louis, Grand Dauphin, and was third in line to the French throne after his father and his elder brother, Louis, Duke of Burgundy. Philip was not expected to become a monarch, but his great-uncle King Charles II of Spain was childless. Philip's father had a strong claim to the Spanish throne, but since he and his elder brother were expected to inherit the French throne, Charles named Philip as his heir in his [[Will and testament|will]]. Philip succeeded in 1700 as the first Spanish monarch of the House of Bourbon. Philip's accession in Spain provoked the 13-year War of the Spanish Succession, which continued until the Treaty of Utrecht forbade any future possibility of unifying the French and Spanish crowns while confirming his accession to the throne of Spain.",
			},
		},
		related = { "Sebastião José de Carvalho e Melo, 1st Marquis of Pombal" },
		infobox = {
			{ "Born", "19 December 1683" },
			{ "Birthplace", "[[Palace of Versailles]], France" },
			{ "Died", "9 July 1746" },
		},
	},
	{
		title = "Philo Farnsworth",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American inventor (1906–1971)",
		tags = { "Inventors and engineers", "Modern" },
		aliases = { "Philo Taylor Farnsworth" },
		summary = "**Philo Taylor Farnsworth** (August 19, 1906 – March 11, 1971) was an American inventor who was granted the first patent for the [[Television|television]] by the United States government. He also invented a video camera tube and the image dissector. He sold a fully functioning television system—complete with receiver and camera—which he produced commercially through the Farnsworth Television and Radio Corporation from 1938 to 1951, in Fort Wayne, Indiana.",
		sections = {
			{
				"Overview",
				"In later life, Farnsworth invented a small [[Nuclear fusion|nuclear fusion]] device, the Farnsworth Fusor, employing inertial electrostatic confinement (IEC). Like many fusion devices, it was not a practical device for generating [[Nuclear power|nuclear power]], although it provides a viable source of [[Neutron|neutrons]]. The design of this device has been the inspiration for other fusion approaches, including the Polywell reactor concept. Farnsworth held 300 patents, mostly in radio and television.",
			},
		},
		related = { "Isambard Kingdom Brunel", "Robert H. Goddard" },
		infobox = {
			{ "Born", "19 August 1906" },
			{ "Birthplace", "Beaver, Utah, U.S." },
			{ "Died", "11 March 1971 (aged 64)" },
			{ "Occupation", "Scientist" },
		},
	},
	{
		title = "Pierre Bourdieu",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French sociologist, anthropologist, and philosopher (1930–2002)",
		tags = { "Social scientists" },
		summary = "**Pierre Bourdieu** was a French [[Sociology|sociologist]] and [[Intellectual|public intellectual]]. Bourdieu's contributions to the sociology of education, the [[Sociological theory|theory of sociology]], and sociology of [[Aesthetics|aesthetics]] have achieved wide influence in several related academic fields (e.g. anthropology, media and [[Cultural studies|cultural studies]], education, [[Popular culture|popular culture]], and [[The arts|the arts]]). During his academic career he was primarily associated with the School for Advanced Studies in the Social Sciences in Paris and the [[Collège de France]].",
		sections = {
			{
				"Overview",
				"Bourdieu's work was primarily concerned with the dynamics of power in society, especially the diverse and subtle ways in which power is transferred and social order is maintained within and across generations. In conscious opposition to the idealist tradition of much of [[Western philosophy]], his work often emphasized the corporeal nature of social life and stressed the role of practice and embodiment in social dynamics. Another notable influence on Bourdieu was [[Blaise Pascal]], after whom Bourdieu titled his Pascalian Meditations. Bourdieu was a prolific author, producing hundreds of articles and three dozen books, nearly all of which are now available in English. His best-known book is Distinction: A Social Critique of the Judgment of Taste (1979), in which he argues that judgments of taste are acts of social positioning.",
			},
		},
		related = { "Theodor W. Adorno", "Max Weber" },
		infobox = {
			{ "Born", "1 August 1930" },
			{ "Birthplace", "Denguin, France" },
			{ "Died", "23 January 2002" },
			{ "Education", "[[École normale supérieure (Paris)|École Normale Supérieure]]" },
			{ "Main interests", "[[Sociology]], power" },
		},
	},
