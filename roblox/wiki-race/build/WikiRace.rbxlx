	{
		title = "Hero of Alexandria",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "1st-century AD Hellenistic mathematician and engineer",
		tags = { "Pre-modern figures", "Ancient history" },
		summary = "**Hero of Alexandria** was a [[Ancient Greek mathematics|Greek mathematician]] and engineer who was active in [[Alexandria]] during the [[Roman Egypt|Roman era]]. He has been described as the greatest experimentalist of antiquity and a representative of the Hellenistic scientific tradition.",
		sections = {
			{
				"Overview",
				"Hero published a well-recognized description of a [[Steam engine|steam-powered device]] called an aeolipile, also known as \"Hero's engine\". Among his most famous inventions was a [[Windmill|windwheel]], constituting the earliest instance of [[Wind power|wind harnessing]] on land. In his work Mechanics, he described pantographs. Some of his ideas were derived from the works of Ctesibius. In mathematics, he wrote a commentary on [[Euclid's Elements]] and a work on applied geometry known as the Metrica. He is mostly remembered for Heron's formula; a way to calculate the area of a triangle using only the lengths of its sides. Much of Hero's original writings and designs have been lost, but some of his works were preserved in manuscripts from the [[Byzantine Empire]] and, to a lesser extent, in Latin or Arabic translations.",
			},
		},
		related = { "Zhang Heng" },
		infobox = {
