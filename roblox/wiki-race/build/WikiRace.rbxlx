	{
		title = "Theodor W. Adorno",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "German philosopher, sociologist, and theorist (1903–1969)",
		tags = { "Social scientists" },
		summary = "**Theodor W. Adorno** was a German [[Philosophy|philosopher]], [[Critical theory|cultural]], and music critic. He was a leading member of the Frankfurt School of [[Critical theory|critical theory]], whose work has come to be associated with thinkers such as Ernst Bloch, Walter Benjamin, Max Horkheimer, Erich Fromm, and Herbert Marcuse, for whom the works of [[Sigmund Freud]], [[Karl Marx]], and G. W. F. Hegel were essential to a critique of modern society. As a critic of both fascism and what he called the culture industry, he authored numerous works—such as Dialectic of Enlightenment (1947), Minima Moralia (1951), and Negative Dialectics (1966)—that strongly influenced the European New Left.",
		sections = {
			{
				"Overview",
				"In an intellectual climate shaped by [[Existentialism|existentialism]] and logical positivism, Adorno developed a [[Dialectic|dialectical]] conception of [[History|history]] and [[Philosophy|philosophy]] that challenged the foundations of both, anticipating the divide that would later emerge between the [[Analytic philosophy|analytic]] and [[Continental philosophy|continental]] traditions. As a classically trained musician, Adorno studied composition with Alban Berg of the Second Viennese School, influenced by his early admiration for the music of [[Arnold Schoenberg]]. Adorno's commitment to [[Avant-garde music|avant-garde music]] formed the backdrop of his subsequent writings and led to his collaboration with [[Thomas Mann]] on the latter's novel Doctor Faustus (1947), while the two men lived in California as exiles during the [[World War II|Second World War]].",
			},
		},
		related = { "Edward Bernays", "Margaret Mead" },
		infobox = {
			{ "Born", "11 September 1903" },
			{ "Birthplace", "[[Frankfurt]], Hesse-Nassau, [[Kingdom of Prussia|Prussia]], [[German Empire]]" },
			{ "Died", "6 August 1969" },
			{ "Era", "[[Contemporary philosophy|20th-century philosophy]]" },
			{ "Region", "[[Western philosophy]]" },
			{ "Teacher", "Hans Cornelius" },
		},
	},
	{
		title = "Theodora (wife of Justinian I)",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Roman empress from 527 to 548",
		tags = { "Eastern Europe", "Byzantine Empire" },
		aliases = { "Theodora" },
		summary = "**Theodora** was the wife of emperor [[Justinian I]] and Eastern Roman empress from 527 until her death. Theodora was one of Justinian's chief political advisers. She is recognized as a saint in the Eastern Orthodox and Oriental Orthodox Churches, and commemorated on 14 November.",
		sections = {
			{
				"Overview",
				"She was of humble origins, having been born to a circus keeper in Constantinople. She worked as a courtesan and actress in her youth. She likely met Justinian sometime before 524, when Justinian's first wife died. They subsequently married and Theodora was crowned empress when Justinian became emperor in 527. She proved an able advisor and empress. She played a crucial role in the suppression of the Nika riots in 532. Theodora and Justinian ordered construction of many grand public works, including the [[Hagia Sophia]]. She engaged in court intrigues, such as the exile of John the Cappadocian, and the exile and death of Pope Silverius and the elevation of Pope Vigilius.",
			},
		},
		related = { "Sviatoslav I" },
		infobox = {
			{ "Born", "c. 490–500" },
			{ "Died", "28 June 548" },
		},
	},
	{
		title = "Theodoric the Great",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "King of Italy from 493 to 526",
		tags = { "Europe", "Western Europe" },
		aliases = { "Theodoric", "Theoderic", "The Great" },
		summary = "**Theodoric** (or **Theoderic**) **the Great** (about 454 – 30 August 526), also called **the Amal**, was king of the [[Ostrogoths]] (471–526), and ruler of the Ostrogothic Kingdom of Italy between 493 and 526, [[Regent|regent]] of the [[Visigoths]] (511–526), and a patrician of the [[Byzantine Empire|Eastern Roman Empire]]. As ruler of the combined Gothic realms, Theodoric controlled an empire stretching from the [[Atlantic Ocean]] to the [[Adriatic Sea]]. Though Theodoric himself only used the title 'king' (rex), some scholars characterize him as a [[Roman emperor|Western Roman emperor]] in all but name, since he ruled a large part of the former [[Western Roman Empire]].",
		sections = {
			{
				"Overview",
				"He also received and used the former Western imperial regalia from [[Constantinople]] in 497, and exercised imperial powers recognized in the East, such as naming consuls. The Italian aristocracy referred to him using the imperial title princeps. Theodoric returned to [[Pannonia]] around 470, and throughout the 470s he campaigned against the [[Sarmatians]] and competed for influence among the Goths of the Roman Balkans, gaining recognition as king in 471. The emperor Zeno made him commander of the Eastern Roman forces in 483 and [[Roman consul|consul]] in 484. Nevertheless, Theodoric remained in constant hostilities with the emperor and frequently raided East Roman territory. At the behest of Zeno, in 489 Theodoric attacked Odoacer, the king of Italy, emerging victorious in 493.",
			},
		},
		related = { "Vercingetorix" },
		infobox = {
			{ "Born", "c. 454" },
			{ "Birthplace", "near Carnuntum (now in Lower Austria), [[Western Roman Empire]]" },
			{ "Died", "30 August 526" },
		},
	},
	{
		title = "Theodosius I",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Roman emperor from 379 to 395",
		tags = { "Europe", "Rome" },
		aliases = { "Theodosius the Great" },
		summary = "**Theodosius I** ( Theodósios; 11 January 347 – 17 January 395), also known as **Theodosius the Great**, was [[Roman emperor]] from 379 to 395. He won two civil wars and was instrumental in establishing the Nicene Creed as the orthodox doctrine for Nicene Christianity. Theodosius was the last emperor to rule the entire Roman Empire. After his death, his sons Arcadius and Honorius ruled from separate courts in [[Byzantine Empire|the east]] and [[Western Roman Empire|the west]], continuing the late Roman practice of rule by multiple emperors. He ended the Gothic War (376–382) with the Goths remaining politically autonomous within Roman territory, albeit as nominal allies.",
		sections = {
			{
				"Overview",
				"Born in [[Hispania]], Theodosius was the son of a high-ranking general of the same name, Theodosius the Elder, under whose guidance he rose through the ranks of the Roman army. Theodosius held independent command in Moesia in 374, where he had some success against the invading [[Sarmatians]]. The new emperor's resources and depleted armies were not sufficient to drive the invaders out; in 382 the Goths were allowed to settle south of the [[Danube]] as autonomous allies of the empire. In 386, Theodosius signed a treaty with the [[Sasanian Empire]] which partitioned the long-disputed [[Kingdom of Armenia (antiquity)|Kingdom of Armenia]] and secured a durable peace between the two powers. Theodosius was a strong adherent of the Christian doctrine of consubstantiality and an opponent of [[Arianism]].",
			},
		},
		related = { "Decebalus" },
		infobox = {
			{ "Born", "11 January 347" },
			{ "Birthplace", "Cauca or Italica, in [[Hispania]] (present-day [[Spain]])" },
			{ "Died", "17 January 395 (aged 48)" },
		},
	},
	{
		title = "Thomas Aquinas",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Italian Dominican friar and philosopher (1225–1274)",
		tags = { "Philosophers", "Post-classical" },
		summary = "**Thomas Aquinas** was an Italian Dominican friar and priest, theologian, and philosopher. He is considered one of the most influential thinkers in the history of Catholic theology and [[Western philosophy]]. He is the father of a school of thought (encompassing both theology and philosophy) known as [[Thomism]].",
		sections = {
			{
				"Overview",
				"A proponent of natural theology, Thomas argued that God is the source of the light of natural reason and the light of faith. He embraced several ideas put forward by [[Aristotle]] and sought to synthesize [[Aristotelianism|Aristotelian philosophy]] with the principles of Christianity. Among his best-known ideas include his Five Ways for proving the existence of God, his virtue ethics, and his sacramental theology. In addition to its vast influence on Catholic thought, his philosophy has influenced modern [[Virtue ethics|virtue ethics]], [[Aesthetics|aesthetics]], and cognitive theory. Thomas's best-known work is the unfinished [[Summa Theologica]], or Summa Theologiae (1265–1274), which is a comprehensive guide to the theology of the Catholic Church. His body of work also includes the Disputed Questions on Truth (1256–1259), the Summa contra Gentiles (1259–1265), and numerous commentaries on Christian Scripture and on Aristotle.",
			},
		},
		related = { "Peter Abelard" },
		infobox = {
			{ "Born", "c. 1225" },
			{ "Birthplace", "Roccasecca, [[Kingdom of Sicily]]" },
			{ "Died", "7 March 1274" },
		},
	},
	{
		title = "Thomas Hardy",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English novelist and poet (1840–1928)",
		tags = { "Western Europe", "UK and Ireland" },
		summary = "**Thomas Hardy** (2 June 1840 – 11 January 1928) was an English novelist, poet and architect. A [[Literary realism|Victorian realist]] in the tradition of [[George Eliot]], he was influenced both in his novels and in his poetry by [[Romanticism]], including the poetry of [[William Wordsworth]]. He was highly critical of much in [[Victorian era|Victorian]] society, especially on the declining status of rural people in Britain such as those from his native South West England.",
		sections = {
			{
				"Overview",
				"While Hardy wrote poetry throughout his life and regarded himself primarily as a poet, his first collection was not published until 1898. Initially, he gained fame as the author of novels such as Far from the Madding Crowd (1874), The Return of the Native (1878), The Mayor of Casterbridge (1886), Tess of the d'Urbervilles (1891) and Jude the Obscure (1895). During his lifetime, Hardy's poetry was acclaimed by younger poets (particularly the Georgians) who viewed him as a mentor. After his death his poems were lauded by [[Ezra Pound]], W. H. Auden and Philip Larkin.",
			},
		},
		related = { "Agatha Christie" },
		infobox = {
			{ "Born", "2 June 1840" },
			{ "Birthplace", "Stinsford, Dorset, England" },
			{ "Died", "11 January 1928" },
			{ "Occupation", "Novelist, poet, short story writer, architect" },
			{ "Education", "[[King's College London]]" },
			{ "Movement", "[[Naturalism (literature)|Naturalism]], Victorian literature" },
		},
	},
	{
		title = "Thomas Henry Huxley",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English biologist (1825–1895)",
		tags = { "Biology", "Modern" },
		summary = "**Thomas Henry Huxley** (4 May 1825 – 29 June 1895) was an English [[Biologist|biologist]] and [[Anthropologist|anthropologist]] who specialised in comparative anatomy. He has become known as \"**Darwin's Bulldog**\" for his advocacy of [[Charles Darwin]]'s theory of [[Evolution|evolution]].",
		sections = {
			{
				"Overview",
				"The stories regarding Huxley's famous 1860 Oxford evolution debate with Samuel Wilberforce were a key moment in the wider acceptance of [[Evolution|evolution]] and in his own career, although some historians think that aspects of the surviving story of the debate are a later fabrication. Huxley had been planning to leave [[Oxford]] on the previous day, but, after an encounter with Robert Chambers, the author of Vestiges, he changed his mind and decided to join the debate. Wilberforce was coached by [[Richard Owen]], against whom Huxley also debated about whether humans were closely related to apes. Huxley was slow to accept some of Darwin's ideas, such as gradualism, and was undecided about [[Evolution|natural selection]], but despite this, he was wholehearted in his public support of Darwin. Instrumental in developing scientific [[Education|education]] in Britain, he fought against the more extreme versions of religious tradition.",
			},
		},
		related = { "Louis Agassiz", "Ernst Haeckel" },
		infobox = {
			{ "Born", "4 May 1825" },
			{ "Birthplace", "Ealing, London, England" },
			{ "Died", "29 June 1895" },
			{ "Education", "Sydenham College, London Charing Cross Hospital" },
			{ "Known for", "[[Evolution]], science education, agnosticism" },
			{ "Field", "[[Zoology]]; comparative anatomy" },
		},
	},
	{
		title = "Thomas Hobbes",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English philosopher and political theorist (1588–1679)",
		tags = { "Political writers", "Early modern" },
		summary = "**Thomas Hobbes** was an English [[Philosophy|philosopher]] and [[Political philosophy|political theorist]], best known for his 1651 book [[Leviathan (Hobbes book)|Leviathan]], in which he expounds an influential formulation of [[Social contract|social contract]] theory. He is considered to be one of the founders of modern [[Political philosophy|political philosophy]].",
		sections = {
			{
				"Overview",
				"In his early life, overshadowed by his father's departure following a fight, he was taken under the care of his wealthy uncle. Hobbes's academic journey began in Westport, leading him to the [[University of Oxford]], where he was exposed to classical literature and mathematics. He then graduated from the [[University of Cambridge]] in 1608. He became a tutor to the Cavendish family, which connected him to intellectual circles and initiated his extensive travels across Europe. These experiences, including meetings with figures like [[Galileo Galilei|Galileo]], shaped his intellectual development. Aside from social contract theory, Leviathan also popularised ideas such as the state of nature (\"war of all against all\") and [[Natural law|laws of nature]]. His other major works include the trilogy De Cive (1642), De Corpore (1655), and De Homine (1658) as well as the posthumous work Behemoth (1681).",
			},
		},
		related = { "Hugo Grotius" },
		infobox = {
			{ "Region", "[[Western philosophy]]" },
			{ "Era", "17th-century philosophy" },
			{ "Born", "5 April 1588" },
			{ "Birthplace", "Westport, Wiltshire, England" },
			{ "Died", "4 December 1679" },
			{ "Education", "Magdalen Hall, Oxford, [[St John's College, Cambridge]] ([[Bachelor of Arts|BA]])" },
			{
				"Main interests",
				"[[Political philosophy]], [[History|history]], [[Ethics|ethics]], [[Geometry|geometry]]",
			},
		},
	},
	{
		title = "Thomas Jefferson",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Founding Father, U.S. president from 1801 to 1809",
		tags = { "Americas", "United States" },
		summary = "From 1797 to 1801, he served as the second vice president under John Adams. A prolific writer and philosopher, Jefferson was the primary author of the [[United States Declaration of Independence|Declaration of Independence]]. His political philosophy, defined by republicanism, individual liberty, agrarianism, and limited government, formed the basis for Jeffersonian democracy.",
		sections = {
			{
				"Overview",
				"He was born into the [[Colony of Virginia]]'s planter class. During the [[American Revolution]], Jefferson represented Virginia in the [[Second Continental Congress]]. His advocacy for individual rights, including the freedoms of thought, [[Freedom of speech|speech]], and [[Freedom of religion|religion]], helped shape the ideological foundations of the revolution. Jefferson served as the second governor of Virginia from 1779 to 1781. In 1785, Congress appointed him as U.S. Minister to France, where he served from 1785 to 1789. President [[George Washington]] then appointed Jefferson the nation's first secretary of state, where he served from 1790 to 1793. In 1792, Jefferson and political ally James Madison organized the Democratic-Republican Party to oppose the Federalist Party during the formation of the nation's First Party System. Jefferson and Federalist John Adams became both personal friends and political rivals.",
			},
		},
		related = { "Toussaint Louverture", "Túpac Amaru" },
		infobox = {
			{ "Born", "13 April 1743" },
			{ "Birthplace", "Shadwell Plantation, Virginia, British America" },
			{ "Died", "4 July 1826" },
			{ "Occupation", "Politician, lawyer, revolutionary" },
			{ "Education", "College of William & Mary" },
		},
	},
	{
		title = "Thomas Mann",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German novelist (1875–1955)",
		tags = { "Western Europe", "Germany and Austria" },
		aliases = { "Paul Thomas Mann" },
		summary = "**Paul Thomas Mann** (6 June 1875 – 12 August 1955) was a German novelist, short story writer, social critic, philanthropist, essayist, and the 1929 Nobel Prize in Literature laureate. His highly symbolic and ironic epic novels and novellas are noted for their insight into the psychology of the artist and the intellectual. His analysis and critique of the European and German soul used modern versions of German and Biblical stories, as well as the ideas of [[Johann Wolfgang von Goethe]], [[Friedrich Nietzsche]], and [[Arthur Schopenhauer]].",
		sections = {
			{
				"Overview",
				"The Mann family was part of the Hanseatic class. He portrayed both his family and the influential class in his first novel, Buddenbrooks (1901). Other major novels include The Magic Mountain (1924), the tetralogy Joseph and His Brothers (1933–1943), and Doctor Faustus (1947). He also wrote short stories and [[Novella|novellas]], including Death in Venice (1912). His older brother was novelist Heinrich Mann. Three of Mann's six children – Erika Mann, Klaus Mann and Golo Mann – also became significant German writers. When [[World War II]] broke out in 1939, he moved to the United States, returning to Switzerland after the war in 1952.",
			},
		},
		related = { "Bertolt Brecht", "Brothers Grimm", "Heinrich Heine", "Hermann Hesse", "Rainer Maria Rilke" },
		infobox = {
			{ "Born", "6 June 1875" },
			{ "Birthplace", "Lübeck, [[German Empire]]" },
			{ "Died", "12 August 1955" },
			{ "Occupation", "Writer, journalist, [[Literary criticism|literary critic]]" },
			{ "Citizenship", "Germany (until 1936), Czechoslovakia (1936–1944), United States (from 1944)" },
			{ "Education", "[[LMU Munich|Ludwig-Maximilians-Universität München]], Technische Hochschule München" },
			{ "Movement", "[[Literary modernism|Modernism]]" },
		},
	},
	{
		title = "Thomas More",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English politician, author and philosopher (1478–1535)",
		tags = { "Europe", "Great Britain and Ireland" },
		aliases = { "Sir Thomas More" },
		summary = "**Sir Thomas More** (7 February 1478 – 6 July 1535), venerated in the Catholic Church as a martyr and saint, was an English lawyer, judge, social philosopher, author, statesman, theologian and Renaissance humanist. He also served [[Henry VIII]] as Lord Chancellor from October 1529 to May 1532. He wrote [[Utopia (book)|Utopia]], published in 1516, which describes the political system of an imaginary island state.",
		sections = {
			{
				"Overview",
				"More opposed the [[Reformation|Protestant Reformation]], directing polemics against the theology of [[Martin Luther]], Huldrych Zwingli and William Tyndale. More also opposed Henry VIII's separation from the Catholic Church, refusing to acknowledge Henry as supreme head of the Church of England and the annulment of his marriage to Catherine of Aragon. Pope Pius XI canonised More in 1935 as a martyr. Pope John Paul II in 2000 declared him the [[Patron saint|patron saint]] of statesmen and politicians. even if, in his actions against heretics, he reflected the limits of the culture of his time\".",
			},
		},
		related = { "Christopher Marlowe", "John Dryden" },
		infobox = {
			{ "Born", "7 February 1478" },
			{ "Died", "6 July 1535 (aged 57)" },
			{ "Birthplace", "[[City of London]], England" },
			{ "Education", "[[University of Oxford]], Lincoln's Inn" },
		},
	},
	{
		title = "Thomas Paine",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English-born philosopher and author (1737–1809)",
		tags = { "Political writers", "Early modern" },
		summary = "**Thomas Paine** was an English-born American [[Founding Fathers of the United States|Founding Father]], inventor, [[Political philosophy|political philosopher]], and statesman. His pamphlets [[Common sense|Common Sense]] (1776) and The American Crisis (1776–1783) framed the Patriot argument for independence from Great Britain at the outset of the [[American Revolution]]. Paine advanced [[Age of Enlightenment|Enlightenment-era]] arguments for [[Human rights|human rights]] that shaped revolutionary discourse on both sides of the Atlantic.",
		sections = {
			{
				"Overview",
				"Born in Thetford, Norfolk, Paine immigrated to the [[Thirteen Colonies|British American colonies]] in 1774 with the help of [[Benjamin Franklin]], arriving in time to participate in the American Revolution. Virtually every American Patriot read his 47-page pamphlet Common Sense, which catalyzed the call for independence from Great Britain. He followed that breakthrough with the pro-independence American Crisis pamphlet series. Paine returned to Britain in 1787 and wrote Rights of Man (1791) to rebut critics of the [[French Revolution]], particularly the Anglo-Irish conservative writer [[Edmund Burke]]. His authorship of the tract led to a trial and conviction in absentia in England in 1792 for the crime of seditious libel.",
			},
		},
		related = { "Cesare Beccaria" },
		infobox = {
			{ "Born", "9 February 1737 ([[Old Style and New Style dates|N.S.]])" },
			{ "Birthplace", "Thetford, Norfolk, England" },
			{ "Died", "8 June 1809" },
		},
	},
	{
		title = "Thomas Robert Malthus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "British political economist (1766–1834)",
		tags = { "Economists" },
		summary = "**Thomas Robert Malthus** was an English economist, cleric, and scholar influential in the fields of [[Political economy|political economy]] and [[Demography|demography]].",
		sections = {
			{
				"Overview",
				'In his 1798 book An Essay on the Principle of Population, Malthus observed that an increase in a nation\'s food production improved the well-being of the population, but the improvement was temporary because it led to [[Population growth|population growth]], which in turn restored the original [[Per capita|per capita]] production level. In other words, humans had a propensity to use abundance for population growth rather than for maintaining a high [[Standard of living|standard of living]], a view and stance that has become known as the "Malthusian trap" or the "Malthusian spectre". Malthus wrote in opposition to the popular view in 18th-century Europe that saw society as improving and in principle as perfectible.',
			},
		},
		related = { "John Kenneth Galbraith", "Paul Samuelson" },
		infobox = {
			{ "Born", "13/14 February 1766" },
			{ "Birthplace", "Westcott, Surrey, [[England]]" },
			{ "Died", "29 December 1834" },
			{ "Field", "[[Demography]], [[Macroeconomics|macroeconomics]]" },
			{ "Education", "Jesus College, Cambridge (MA)" },
			{ "Notable works", "An Essay on the Principle of Population" },
		},
	},
	{
		title = "Thomas Young (scientist)",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "English polymath (1773–1829)",
		tags = { "Physics", "Modern" },
		aliases = { "Thomas Young" },
		summary = "**Thomas Young** (13 June 1773 – 10 May 1829) was a British [[Polymath|polymath]] who made notable contributions to the fields of [[Visual perception|vision]], [[Light|light]], [[Solid mechanics|solid mechanics]], [[Energy|energy]], [[Physiology|physiology]], [[Language|language]], [[Harmony|musical harmony]], and Egyptology. He was instrumental in the decipherment of Egyptian hieroglyphs, specifically the [[Rosetta Stone]].",
		sections = {
			{
				"Overview",
				"Young's work influenced that of [[William Herschel]], [[Hermann von Helmholtz]], [[James Clerk Maxwell]], and [[Albert Einstein]]. Young is credited with establishing [[Christiaan Huygens]]' wave theory of light, in contrast to the corpuscular theory of [[Isaac Newton]]. Young's work was subsequently supported by the work of [[Augustin-Jean Fresnel]].",
			},
