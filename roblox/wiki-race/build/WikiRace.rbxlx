	{
		title = "Molecular cloud",
		category = "Space",
		fame = 2,
		emoji = "☁️",
		source = "wikipedia",
		description = "Type of interstellar cloud",
		tags = { "Astronomy", "Basics" },
		aliases = { "Stellar nursery" },
		summary = "A **molecular cloud**—sometimes called a **stellar nursery** if [[Star formation|star formation]] is occurring within—is a type of interstellar cloud of which the density and size permit absorption nebulae, the formation of molecules (most commonly molecular hydrogen, H2), and the formation of [[H II region|H II regions]]. This is in contrast to other areas of the [[Interstellar medium|interstellar medium]] that contain predominantly ionized gas.",
		sections = {
			{
				"Overview",
				"Molecular hydrogen is difficult to detect by infrared and radio observations, so the molecule most often used to determine the presence of H2 is [[Carbon monoxide|carbon monoxide]] (CO). The ratio between CO [[Luminosity|luminosity]] and H2 [[Mass|mass]] is thought to be constant, although there are reasons to doubt this assumption in observations of some other galaxies. Within molecular clouds are regions with higher density, where much dust and many gas cores reside, called clumps. These clumps are the beginning of star formation if gravitational forces are sufficient to cause the dust and gas to collapse.",
			},
		},
		related = { "Stellar black hole" },
