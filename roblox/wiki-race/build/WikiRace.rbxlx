		tags = { "Roman Empire" },
		aliases = { "Gladiators" },
		summary = "A **gladiator** was an armed fighter who battled in arenas like the [[Colosseum]] to entertain crowds in the [[Roman Empire]].",
		sections = {
			{
				"Celebrities",
				"Popular gladiators were celebrities whose images appeared on graffiti, like modern athletes.",
