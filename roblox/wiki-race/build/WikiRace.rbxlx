		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "British evolutionary biologist (1936–2000)",
		tags = { "Biology", "Modern" },
		aliases = { "William Donald Hamilton" },
		summary = "**William Donald Hamilton** (1 August 1936 – 7 March 2000) was a British evolutionary biologist, recognised as one of the most significant [[Evolution|evolutionary]] theorists of the 20th century. Hamilton became known for his theoretical work expounding a rigorous [[Genetics|genetic]] basis for the existence of altruism, an insight that was a key part of the development of the gene-centered view of evolution. He is considered one of the forerunners of sociobiology. From 1984 to his death in 2000, he was a [[Royal Society]] Research Professor at [[University of Oxford|Oxford University]].",
		sections = {
			{ "Overview", 'Richard Dawkins has written that Hamilton was "the greatest Darwinian of my lifetime".' },
