	{
		title = "History of philosophy",
		category = "History",
		fame = 2,
		emoji = "🤔",
		source = "wikipedia",
		description = "Study of the development of philosophy",
		tags = { "History by subject matter", "History of philosophy and religion" },
		summary = "The **history of philosophy** is the systematic study of the development of [[Philosophy|philosophical]] thought. It focuses on philosophy as rational inquiry based on argumentation, but some theorists also include [[Mythology|myth]], religious traditions, and proverbial lore.",
		sections = {
			{
				"Overview",
				"[[Western philosophy]] originated with an [[Metaphysics|inquiry into the fundamental nature]] of the cosmos in [[Ancient Greece]]. Subsequent philosophical developments covered a wide range of topics including the nature of [[Reality|reality]] and the [[Mind|mind]], [[Ethics|how people should act]], and [[Epistemology|how to arrive at knowledge]]. The [[Middle Ages|medieval]] period was focused more on theology. The [[Renaissance]] period saw a renewed interest in [[Ancient Greek philosophy]] and the emergence of [[Renaissance humanism|humanism]]. The modern period was characterized by an increased focus on how philosophical and scientific knowledge is created. Its new ideas were used during the [[Age of Enlightenment|Enlightenment period]] to challenge traditional authorities. Influential developments in the 19th and 20th centuries included [[German idealism]], [[Pragmatism|pragmatism]], [[Positivism|positivism]], formal logic, linguistic analysis, [[Phenomenology (philosophy)|phenomenology]], [[Existentialism|existentialism]], and [[Postmodernism|postmodernism]].",
			},
		},
		related = { "History of atheism" },
