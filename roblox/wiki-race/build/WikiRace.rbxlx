			{ "Died", "10 May 1849" },
			{ "Field", "[[Ukiyo-e]] painting, [[Manga]] and woodblock printing" },
		},
	},
	{
		title = "Hong Taiji",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Founding emperor of the Qing dynasty",
		tags = { "Asia and Oceania", "China" },
		aliases = { "Huang Taiji", "Abahai", "Emperor Taizong of Qing" },
		summary = "**Hong Taiji** (28 November 1592 – 21 September 1643), sometimes rendered as **Huang Taiji** and occasionally referred to as **Abahai** in Western literature, also known by his [[Temple name|temple name]] **Emperor Taizong of Qing**, was the second khan of the Later Jin dynasty and the founding [[Emperor of China|emperor]] of the [[Qing dynasty]]. He was responsible for consolidating the empire that his father [[Nurhaci]] had founded and laid the groundwork for the conquest of the [[Ming dynasty]], although he died before this was accomplished. He conquered [[Inner Mongolia]] and the remainder of [[Manchuria]] and invaded Korea, which became a Qing tributary state.",
		sections = {
			{
				"Overview",
