			{ "Official languages", "Genoese [[Latin]] [[Italian language|Italian]]" },
			{ "Population", "650,000 in the early 17th century" },
		},
	},
	{
		title = "Republic of Venice",
		category = "History",
		fame = 1,
		emoji = "📜",
		source = "wikipedia",
		description = "Maritime republic in Italy (697–1797)",
		tags = { "Western Europe", "Italy" },
		aliases = { "Most Serene Republic of Venice", "La Serenissima" },
		summary = "The **Republic of Venice**, officially the **Most Serene Republic of Venice** and traditionally known as **La Serenissima**, was a maritime republic with its capital in [[Venice]], on the northeastern coast of [[Italy]]. Founded, according to tradition, in 697 by Paolo Lucio Anafesto, over the course of its 1,100 years of history it established itself as one of the major European commercial and naval powers.",
		sections = {
			{
				"Overview",
				"Initially extended in the Dogado area (a territory currently comparable to the Metropolitan City of Venice), during its history it annexed a large part of Northeast Italy, Istria, Dalmatia, the coasts of present-day [[Montenegro]] and [[Albania]] as well as numerous islands in the [[Adriatic Sea|Adriatic]] and eastern [[Ionian Sea|Ionian]] seas. At the height of its expansion, between the 13th and 16th centuries, it also governed [[Crete]], [[Cyprus]], the [[Peloponnese]], a number of Greek islands, as well as several cities and ports in the eastern [[Mediterranean Sea|Mediterranean]]. The islands of the Venetian Lagoon in the 7th century, after having experienced a period of substantial increase in population, were organized into Maritime Venice, a [[Byzantine Empire|Byzantine]] duchy dependent on the Exarchate of Ravenna.",
			},
		},
		infobox = {
			{ "Era", "[[Middle Ages]], [[Early modern period]]" },
			{ "Official languages", "[[Italian language|Italian]], Venetian [[Latin]]" },
			{ "Capital", "Eraclea (697–742) Malamocco (742–810) [[Venice]] (810–1797)" },
			{ "Currency", "Venetian ducat Venetian lira" },
			{ "Government", "Classical republic under an [[Oligarchy|oligarchy]]" },
			{ "People are called", "[[Venice|Venetian]]" },
