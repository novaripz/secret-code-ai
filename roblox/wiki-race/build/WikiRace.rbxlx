	{
		title = "Ionosphere",
		category = "Concept",
		fame = 2,
		emoji = "🌍",
		source = "wikipedia",
		description = "Ionized part of Earth's upper atmosphere",
		tags = { "More articles" },
		summary = "The **ionosphere** is the [[Ionization|ionized]] part of the upper atmosphere of Earth, from about 48 km to 965 km above sea level, a region that includes the thermosphere and parts of the mesosphere and exosphere. The ionosphere is ionized by solar radiation. It plays an important role in atmospheric electricity and forms the inner edge of the [[Magnetosphere|magnetosphere]]. It has practical importance because, among other functions, it influences radio propagation to distant places on [[Earth]]. Travel through this layer also affects GPS signals, deflecting their paths and delaying their arrival.",
