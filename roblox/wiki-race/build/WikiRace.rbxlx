		description = "Annual ranking of corporations",
		tags = { "More articles" },
		aliases = { "Global 500" },
		summary = "The **Fortune Global 500**, also known as **Global 500**, is an annual ranking of the top 500 [[Corporation|corporations]] worldwide as measured by [[Revenue|revenue]]. The list is compiled and published annually by [[Fortune (magazine)|Fortune]] magazine. It was first published in 1955.",
