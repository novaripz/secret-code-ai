	{
		title = "Shrub",
		category = "Plant",
		fame = 1,
		emoji = "🌱",
		source = "wikipedia",
		description = "Small- to medium-sized perennial woody plant",
		tags = { "Anatomy and morphology", "Plant anatomy" },
		aliases = { "Bush" },
		summary = "A **shrub** or **bush** is a small to medium-sized [[Perennial|perennial]] [[Woody plant|woody plant]]. Unlike [[Herbaceous plant|herbaceous plants]], shrubs have persistent woody stems above the ground. Shrubs can be either deciduous or evergreen. They are distinguished from [[Tree|trees]] by their multiple [[Plant stem|stems]] and shorter [[Height|height]], less than 6–10 m tall, the cutoff point varying within this range for any one species due to suitability of growing conditions in any one environment. Some tree species never achieve their mature height because of hostile, less than ideal growing conditions in certain areas, and can resemble shrub-sized plants. Small shrubs, less than 2 m tall are sometimes termed as subshrubs.",
		sections = {
			{
				"Overview",
				"Some shrub species only last about five years in good conditions, while others, usually larger and more woody, live beyond 70 years; on average, shrub species die after about eight years. [[Shrubland]] is the natural landscape dominated by various shrubs; there are many distinct types around the world, including fynbos, maquis, shrub-steppe, shrub swamp and moorland. In gardens and parks, an area largely dedicated to shrubs (now somewhat less fashionable than a century ago) is called a shrubbery, shrub border or shrub garden. There are many garden [[Cultivar|cultivars]] of shrubs, bred for flowering, for example [[Rhododendron|rhododendrons]], and sometimes even leaf colour or shape. Apart from the several berry-bearing shrub species (using the culinary rather than botanical definition), few are eaten directly, and they are generally too small for much [[Lumber|timber]] use unlike trees.",
			},
		},
	},
	{
		title = "Sister group",
		category = "Plant",
		fame = 1,
		emoji = "🌿",
		source = "wikipedia",
		description = "Closest relative(s) of a given taxon in a phylogenetic tree",
		tags = { "More articles" },
		aliases = { "Adelphotaxon", "Sister taxon" },
		summary = "In [[Phylogenetics|phylogenetics]], a **sister group** or **sister taxon**, also called an **adelphotaxon**, comprises the closest relative(s) of another given unit in an evolutionary tree.",
	},
	{
		title = "Solanaceae",
		category = "Plant",
		fame = 3,
		emoji = "👪",
		source = "wikipedia",
		description = "Family of flowering plants",
		tags = { "Eudicots", "Solanales" },
		aliases = { "Nightshades" },
		summary = "**Solanaceae**, commonly known as the **nightshades**, is a [[Family (taxonomy)|family]] of [[Flowering plant|flowering plants]] in the order Solanales. The family contains approximately 2,700 species, several of which are used as [[Agriculture|agricultural]] crops, medicinal plants, and [[Ornamental plant|ornamental plants]].",
		sections = {
			{
				"Overview",
				"Originating in [[South America]], Solanaceae now inhabit every continent on Earth with the sole exception of [[Antarctica]]. After the [[Cretaceous–Paleogene extinction event|K–Pg extinction event]] they rapidly diversified and have adapted to live in deserts, tundras, rainforests, plains, and highlands, and taken on wide range of forms including trees, vines, shrubs, and [[Epiphyte|epiphytes]]. Nearly 80% of all nightshades are included in the subfamily Solanoideae, most of which are members of the type genus Solanum. Most taxonomists recognize six other subfamilies: Cestroideae, Goetzeoideae, Nicotianoideae, Petunioideae, Schizanthoideae, and Schwenkioideae, although nightshade taxonomy is still controversial. The genus Duckeodendron is sometimes placed in its own subfamily, Duckeodendroideae. The high alkaloid content in some species has made them valuable for recreational, medicinal, and culinary use.",
			},
		},
		infobox = {
			{ "Scientific name", "Solanaceae" },
		},
	},
	{
		title = "Solidago",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of flowering plants",
		tags = { "Eudicots", "Asterales" },
		aliases = { "Goldenrod" },
		summary = "**Solidago**, commonly called **goldenrod**, is a genus of about 100 to 120 species of [[Flowering plant|flowering plants]] in the family [[Asteraceae]]. Most are herbaceous [[Perennial|perennial]] species found in open areas such as meadows, prairies, and savannas. They are mostly native to [[North America]], including Mexico; a few species are native to South America and Eurasia. Some American species have also been introduced into [[Europe]] and other parts of the world.",
		related = { "Chicory", "Dahlia" },
		infobox = {
			{ "Scientific name", "Solidago" },
		},
	},
	{
		title = "Sonchus",
