		fame = 2,
		emoji = "🔬",
		source = "wikipedia",
		description = "Study of the Earth's atmosphere",
		tags = { "Air", "Atmosphere" },
		summary = "**Atmospheric science** is the study of the [[Atmosphere of Earth|Earth's atmosphere]] and its various inner-working physical processes. [[Meteorology]] includes [[Atmospheric chemistry|atmospheric chemistry]] and atmospheric physics with a major focus on [[Weather forecasting|weather forecasting]]. [[Climatology]] is the study of atmospheric conditions over timescales longer than those of [[Weather|weather]], focusing on average climate conditions and their [[Climate variability and change|variability over time]]. Aeronomy is the study of the upper layers of the atmosphere, where dissociation and [[Ionization|ionization]] are important. Atmospheric science has been extended to the field of [[Planetary science|planetary science]] and the study of the atmospheres of the [[Planet|planets]] and [[Natural satellite|natural satellites]] of the [[Solar System]].",
		sections = {
			{
				"Overview",
				"Experimental instruments used in atmospheric science include [[Satellite|satellites]], rocketsondes, radiosondes, weather balloons, [[Radar|radars]], and [[Laser|lasers]]. The term **aerology** is sometimes used as an alternative term for the study of Earth's atmosphere; in other definitions, aerology is restricted to the free atmosphere, the region above the planetary boundary layer. Early pioneers in the field include Léon Teisserenc de Bort and Richard Assmann.",
			},
		},
		related = { "Ozone depletion" },
