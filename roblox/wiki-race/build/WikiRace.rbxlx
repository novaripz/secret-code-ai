			"Paco de Lucía",
			"Shakira",
			"Vladimir Vysotsky",
		},
		infobox = {
			{ "Born", "18 June 1942" },
			{ "Birthplace", "[[Liverpool]], England" },
			{ "Occupation", "Singer songwriter musician record and film producer businessman" },
			{ "Years active", "1957–present" },
		},
	},
	{
		title = "Philip Glass",
		category = "Musician",
		fame = 2,
		emoji = "🥛",
		source = "wikipedia",
		description = "American composer (born 1937)",
		tags = { "Composers", "Avant-garde/postmodern" },
		aliases = { "Philip Morris Glass" },
		summary = '**Philip Morris Glass** is an American [[Composer|composer]] and pianist. He is widely regarded as one of the most influential composers of the late 20th century. Glass\'s work has been associated with minimalism, being built up from repetitive phrases and shifting layers. He described himself as a composer of "music with repetitive structures", which he has helped to evolve stylistically.',
		sections = {
			{
				"Overview",
				"Glass founded the Philip Glass Ensemble in 1968. He has written 15 [[Opera|operas]], numerous chamber operas and [[Musical theatre|musical theatre]] works, 15 [[Symphony|symphonies]], 12 [[Concerto|concertos]], nine [[String quartet|string quartets]], various other [[Chamber music|chamber music]] pieces, and many [[Film score|film scores]]. He has received nominations for four Grammy Awards, including two for Best Contemporary Classical Composition for Satyagraha (1987) and String Quartet No. 2 (1988). He has received three Academy Award for Best Original Score nominations for [[Martin Scorsese]]'s Kundun (1997), Stephen Daldry's The Hours (2002), and Richard Eyre's Notes on a Scandal (2006). He also composed the scores for Koyaanisqatsi (1982), Mishima: A Life in Four Chapters (1985), Hamburger Hill (1987), The Thin Blue Line (1988), Candyman (1992), The Truman Show (1998), and The Illusionist (2006).",
			},
		},
		related = { "Joan Sutherland", "Pierre Boulez" },
		infobox = {
			{ "Born", "31 January 1937" },
			{ "Birthplace", "[[Baltimore]], [[Maryland]], U.S." },
			{ "Known for", "Minimal music" },
			{ "Occupation", "Composer, pianist" },
			{ "Education", "Peabody Institute, A.B., [[University of Chicago]], Diploma and M.M. Juilliard" },
		},
	},
	{
		title = "Pierre Boulez",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "French composer and conductor (1925–2016)",
		tags = { "Composers", "Avant-garde/postmodern" },
		aliases = { "Pierre Louis Joseph Boulez" },
		summary = "**Pierre Louis Joseph Boulez** was a French composer, conductor and writer, and the founder of several musical institutions. He was one of the dominant figures of post-war [[Contemporary classical music|contemporary classical music]].",
		sections = {
			{
				"Overview",
				"Born in Montbrison, in the Loire department of France, the son of an engineer, Boulez studied at the [[Conservatoire de Paris]] with Olivier Messiaen, and privately with Andrée Vaurabourg and René Leibowitz. He began his professional career in the late 1940s as music director of the Renaud-Barrault theatre company in Paris. He was a leading figure in [[Avant-garde music|avant-garde music]], playing an important role in the development of integral serialism in the 1950s, controlled chance music in the 1960s and the electronic transformation of instrumental music in real time from the 1970s onwards. His tendency to revise earlier compositions meant that his body of work was relatively small, but it included pieces considered landmarks of twentieth-century music, such as Le Marteau sans maître, Pli selon pli and Répons.",
			},
		},
		related = { "Philip Glass", "György Ligeti" },
	},
	{
		title = "Pink Floyd",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "English rock band",
		tags = { "Popular music", "Rock" },
		summary = "**Pink Floyd** are an English [[Rock music|rock]] band formed in London in 1965 by Syd Barrett (guitar, vocals), Nick Mason (drums), Roger Waters (bass guitar, vocals) and Richard Wright (keyboards, vocals), with David Gilmour (guitar, vocals) joining at the end of 1967. Gaining an early underground following as one of the first British [[Psychedelic music|psychedelic]] groups, they were distinguished by their extended compositions, sonic experiments, philosophical lyrics, and elaborate live performances, becoming a leading [[Progressive rock|progressive rock]] band.",
		sections = {
			{
				"Overview",
				'With Barrett as their main songwriter, Pink Floyd released two hit singles, "Arnold Layne" and "See Emily Play", and the successful debut album The Piper at the Gates of Dawn (all 1967). Barrett left in 1968 due to deteriorating mental health. After a period of musical experimentation with albums including A Saucerful of Secrets (1968) and Meddle (1971), Waters became the primary lyricist and thematic leader, devising the concepts behind Pink Floyd\'s most successful albums, The Dark Side of the Moon (1973), Wish You Were Here (1975), Animals (1977) and The Wall (1979). The musical film based on The Wall, Pink Floyd – The Wall (1982), won two BAFTAs. Pink Floyd also composed several [[Film score|film scores]]. Personal tensions led to Wright leaving in 1981, followed by Waters in 1985. Gilmour and Mason continued as Pink Floyd, rejoined later by Wright.',
			},
		},
		related = { "Paul McCartney", "Led Zeppelin" },
		infobox = {
			{ "Origin", "London, England" },
			{
				"Genre",
				"[[Progressive rock]], [[Art rock|art rock]], [[Psychedelic rock|psychedelic rock]], experimental rock",
			},
			{ "Years active", "1965–1994, 2005, 2007, 2013–2014, 2022" },
			{
				"Label",
				"EMI, EMI Columbia, Tower, Harvest, [[Capitol Records|Capitol]], [[Columbia Records|Columbia]], Sony Music, [[Parlophone]]",
			},
		},
