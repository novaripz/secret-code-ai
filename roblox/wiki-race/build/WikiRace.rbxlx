		category = "Music",
		fame = 2,
		emoji = "🎻",
		tags = { "Music genres" },
		summary = "**Classical music** is the formal art-music tradition of Europe, performed by an [[Orchestra|orchestra]] or soloists.",
		sections = {
			{
				"Composers",
				"Great composers include [[Johann Sebastian Bach]], [[Wolfgang Amadeus Mozart]] and [[Ludwig van Beethoven]]. Big works include the [[Symphony|symphony]] and the [[Opera|opera]].",
			},
		},
		infobox = { { "Golden age", "1750–1900" }, { "Performed by", "[[Orchestra]]" } },
	},
	{
		title = "Johann Sebastian Bach",
