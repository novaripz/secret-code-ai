		fame = 1,
		emoji = "🎹",
		tags = { "Musical instruments" },
		aliases = { "Pianos" },
		summary = "The **piano** is a keyboard instrument in which keys make felt hammers strike strings. A standard piano has 88 keys.",
		sections = {
			{
