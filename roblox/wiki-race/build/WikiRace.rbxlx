	{
		title = "Saint Lucia",
		category = "Country",
		fame = 3,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Country in the West Indies in the eastern Caribbean Sea",
		tags = { "North America", "Caribbean" },
		summary = "**Saint Lucia** (also written as **St. Lucia**) is an [[Island country|island country]] in the eastern and southern [[Caribbean]]. Part of the Windward Islands of the [[Lesser Antilles]], it is located north/northeast of the island of Saint Vincent, northwest of [[Barbados]] and south of [[Martinique]]. It covers a land area of 617 km² with an officially estimated population of over 184,100 people as of mid 2023. The nation's capital and largest city is Castries.",
		sections = {
			{
				"Overview",
				'The first proven inhabitants of the island, the Arawaks, are believed to have been the first to settle on the island in 200–400 AD. In 800 AD, the island was taken over by the Kalinago. The [[French people|French]] were the first [[European colonization of the Americas|European colonists]] to settle on the island, and they signed a treaty with the native Caribs in 1660. The English took control of the island in 1663. In ensuing years, [[Kingdom of England|England]] and [[Kingdom of France|France]] fought 14 times for control of the island; consequently control over this immensely valuable geopolitical position changed frequently. Eventually, the [[British Empire|British]] took complete control in 1814, shortly after the victory over French Emperor [[Napoleon|Napoleon I]]. Because the island switched so often between British and French control, Saint Lucia was also known as the "Helen of the West" after the Greek mythological character, Helen of Troy.',
			},
		},
		infobox = {
			{ "Official languages", "[[English language|English]]" },
			{ "Languages", "Saint Lucian French Creole" },
			{ "People are called", "Saint Lucian" },
			{ "Capital", "Castries" },
			{ "Government", "Unitary parliamentary [[Constitutional monarchy|constitutional monarchy]]" },
			{ "Established", "1 March 1967" },
			{ "Area", "617 km²" },
		},
	},
	{
		title = "Saint Vincent and the Grenadines",
		category = "Country",
		fame = 3,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Archipelagic country in the Caribbean",
		tags = { "North America", "Caribbean" },
		aliases = { "Saint Vincent" },
		summary = "**Saint Vincent and the Grenadines**, sometimes known simply as **Saint Vincent**, is an [[Archipelagic state|archipelagic country]] in the eastern [[Caribbean]]. It is located in the southeast Windward Islands of the [[Lesser Antilles]], which lie in the [[West Indies]], at the southern end of the eastern border between the [[Caribbean Sea]] and the [[Atlantic Ocean]]. To the north lies [[Saint Lucia]], to the east is [[Barbados]] and [[Grenada]] lies to the south.",
		sections = {
			{
				"Overview",
				"Spanning a land area of 389 km², most of its territory consists of the northernmost island of Saint Vincent, which includes the capital and largest city, Kingstown. To the south lie the northern two-thirds of the Grenadines, a chain of 32 smaller islands; the remaining southern third make up Grenada. Seven of the islands are inhabited, of which the largest and most populous are Bequia, Mustique, Canouan and Union Island. With a population of around 109,296, Saint Vincent and the Grenadines has a population density of 281 inhabitants/km2 (730 per sq mi). SVG remained a colony of the British Empire from 1783 until 1979, when it peacefully achieved independence; the country's culture, language, government and legal system reflect the long legacy of British rule. It is part of the [[Commonwealth of Nations]] and is a [[Commonwealth realm]], with King Charles III as its official head of state.",
			},
		},
		infobox = {
			{ "Languages", "Vincentian Creole" },
