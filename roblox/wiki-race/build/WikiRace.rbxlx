	{
		title = "Raphael",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Italian painter and architect (1483–1520)",
		tags = { "Western painters and illustrators", "Renaissance to early modern era" },
		aliases = { "Raffaello Sanzio da Urbino" },
		summary = "**Raffaello Sanzio da Urbino**, now generally known in English as **Raphael**, was an Italian painter and [[Architect|architect]] of the [[High Renaissance]]. His work is admired for its clarity of form, ease of composition, and visual achievement of the Neoplatonic ideal of human grandeur. Together with [[Leonardo da Vinci]] and [[Michelangelo]], he forms the traditional trinity of great masters of that period.",
		sections = {
			{
				"Overview",
				'His father Giovanni Santi was court painter to the ruler of the small but highly cultured city of Urbino. He died when Raphael was eleven, and Raphael seems to have played a role in managing the family workshop from this point. He probably trained in the workshop of Pietro Perugino, and was described as a fully trained "master" by 1500. He worked in or for several cities in north Italy until in 1508 he moved to Rome at the invitation of [[Pope Julius II]], to work on the Apostolic Palace at the Vatican. He was given a series of important commissions there and elsewhere in the city, and began to work as an architect. He was still at the height of his powers at his death in 1520. Raphael was enormously productive, running an unusually large workshop and, despite his early death at 37, leaving a large body of work.',
			},
		},
		related = { "Artemisia Gentileschi", "Rembrandt" },
		infobox = {
			{ "Born", "28 March or 6 April 1483" },
			{ "Birthplace", "Urbino, Duchy of Urbino" },
			{ "Died", "6 April 1520" },
			{ "Field", "[[Painting]], [[Architecture|architecture]]" },
			{ "Movement", "[[High Renaissance]]" },
			{ "Notable works", "Raphael Rooms Sistine Madonna [[The School of Athens]] Transfiguration" },
		},
	},
	{
		title = "Ray Bradbury",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American writer (1920–2012)",
		tags = { "Americas", "US and Canada" },
		aliases = { "Ray Douglas Bradbury" },
		summary = "**Ray Douglas Bradbury** was an American author and screenwriter. One of the most celebrated 20th-century American writers, he worked in a variety of genres, including [[Fantasy|fantasy]], [[Science fiction|science fiction]], [[Horror fiction|horror]], mystery, and realistic fiction.",
		sections = {
			{
				"Overview",
				'Bradbury is best known for his novel Fahrenheit 451 (1953) and his short-story collections The Martian Chronicles (1950), The Illustrated Man (1951), and The October Country (1955). He also wrote and consulted on screenplays and television scripts, including Moby Dick and It Came from Outer Space. Many of his works were adapted into television and film productions as well as comic books. Bradbury also wrote poetry which has been published in several collections, such as They Have Not Seen the Stars (2001). [[The New York Times]] called Bradbury "An author whose fanciful imagination, poetic prose, and mature understanding of human character have won him an international reputation" and "the writer most responsible for bringing modern science fiction into the literary mainstream".',
			},
		},
		related = { "Edgar Allan Poe", "Isaac Asimov" },
		infobox = {
