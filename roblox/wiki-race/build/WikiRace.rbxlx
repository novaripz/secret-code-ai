	{
		title = "Pseudoscience",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Unscientific claims presented as scientific",
		tags = { "Philosophy", "Philosophy of science" },
		summary = "**Pseudoscience** consists of statements, [[Belief|beliefs]], or practices that claim to be [[Science|scientific]] but are inherently incompatible with the [[Scientific method|scientific method]]. Pseudoscience is often characterized by contradictory, exaggerated or [[Falsifiability|unfalsifiable claims]]; reliance on confirmation bias rather than rigorous attempts at refutation; lack of openness to evaluation by other experts; absence of systematic practices when developing [[Hypothesis|hypotheses]]; and continued adherence long after the pseudoscientific hypotheses have been experimentally discredited. It is not the same as junk science, which is spurious or fraudulent scientific work.",
		sections = {
			{
				"Overview",
				"The demarcation between science and pseudoscience has scientific, [[Philosophy|philosophical]], and political implications. Recent empirical research has shown that individuals who indulge in pseudoscientific beliefs generally show lower evidential criteria, meaning they often require significantly less evidence before coming to conclusions. This can be coined as a 'jump-to-conclusions' bias that can increase the spread of pseudoscientific beliefs. Addressing pseudoscience is part of science education and developing scientific literacy. Pseudoscience can have dangerous effects. The term pseudoscience is often considered pejorative, because it suggests something is being presented as science inaccurately or even deceptively. Therefore, practitioners and advocates of pseudoscience frequently dispute the characterization.",
			},
		},
	},
	{
		title = "Psychiatry",
		category = "Concept",
		fame = 2,
		emoji = "💊",
		source = "wikipedia",
		description = "Branch of medicine devoted to mental disorders",
		tags = { "More articles" },
		summary = "**Psychiatry** is the medical specialty devoted to the diagnosis, treatment, and prevention of deleterious mental conditions. These include matters related to [[Cognition|cognition]], [[Perception|perceptions]], [[Mood (psychology)|mood]], [[Emotion|emotion]], and [[Behavior|behavior]].",
		sections = {
			{
				"Overview",
