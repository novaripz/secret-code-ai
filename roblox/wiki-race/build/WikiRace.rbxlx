		emoji = "🎻",
		tags = { "Musical instruments", "String instruments" },
		aliases = { "Fiddle" },
		summary = "The **violin** is a four-stringed instrument played with a bow. It is the highest-pitched member of the string family in the [[Orchestra|orchestra]].",
