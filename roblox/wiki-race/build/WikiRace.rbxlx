	{
		title = "Beetroot",
		category = "Plant",
		fame = 3,
		emoji = "🥕",
		source = "wikipedia",
		description = "Vegetable",
		tags = { "Eudicots", "Caryophyllales" },
		aliases = { "Beet" },
		summary = "**Beetroot** or **beet** is the taproot portion of a Beta vulgaris subsp. vulgaris plant in the Conditiva Group. The plant is a [[Root vegetable|root vegetable]] also known as the **table beet**, **garden beet**, or dinner beet, or else categorized by color as **red beet** or golden beet. Its leaves constitute a [[Leaf vegetable|leaf vegetable]] called **beet greens**. It is native to the [[Azores]], [[Western Europe]] to the [[Mediterranean Sea|Mediterranean]] and [[India]]. Beetroot can be eaten raw, roasted, steamed, or boiled. Beetroot can also be canned, either whole or cut up, and often are [[Pickling|pickled]], spiced, or served in a sweet-and-sour sauce.",
		sections = {
			{
				"Overview",
				"It is one of several cultivated varieties of Beta vulgaris subsp. vulgaris grown for their edible taproots or leaves, [[Taxonomy (biology)|classified]] as belonging to the Conditiva Group. Other cultivars of the same subspecies include the [[Sugar beet|sugar beet]], the leaf vegetable known as spinach beet (Swiss [[Chard|chard]]), and the [[Fodder|fodder]] crop mangelwurzel.",
			},
