	{
		title = "Fig",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Species of flowering plant, or its fruit",
		tags = { "Eudicots", "Rosales" },
		aliases = { "Ficus carica", "Common fig" },
		summary = "The **fig** is the edible fruit of **Ficus carica** (the **common fig**), a species of tree or shrub in the [[Flowering plant|flowering plant]] family [[Moraceae]], [[Native species|native]] to the [[Mediterranean basin|Mediterranean]] region, and to western and southern Asia. It has been cultivated since ancient times and is now widely grown throughout the world. Ficus carica is the [[Type species|type species]] of the genus Ficus, which comprises over 800 tropical and subtropical plant species.",
		sections = {
			{
				"Overview",
				"The fig plant is a [[Deciduous|deciduous]] tree or large shrub, growing up to 7-10 m tall, with smooth white bark. Its large leaves have three to five deep lobes. Its fruit (a syconium) is teardrop-shaped, 3-5 cm long, initially green but may ripen toward purple or brown, and has sweet soft reddish flesh containing numerous small seeds. In the Northern Hemisphere, fresh figs are in season from early August to early October. They tolerate moderate seasonal drought and can be grown even in hot-summer continental climates. In 2020, world production of raw figs was 1.26 million [[Tonne|tonnes]], led by [[Turkey]] (with 25% of the world total), [[Egypt]], [[Morocco]], and [[Algeria]], collectively accounting for 62% of the total. Although the milky sap of the green parts of the plant is an irritant to human skin, figs can be eaten fresh or dried.",
			},
		},
		related = { "Rosaceae", "Peach" },
		infobox = {
			{ "Scientific name", "Ficus carica" },
			{ "Conservation status", "Least Concern" },
		},
	},
	{
		title = "Fir",
		category = "Plant",
		fame = 3,
		emoji = "🌳",
		source = "wikipedia",
		description = "Genus of coniferous trees",
		tags = { "Non-flowering plants", "Gymnosperms" },
		aliases = { "Firs", "Abies" },
		summary = "**Firs** are [[Evergreen|evergreen]] [[Conifer|coniferous]] trees belonging to the [[Genus|genus]] **Abies** in the family Pinaceae. There are approximately 48–65 extant species, found on mountains throughout much of North and [[Central America]], [[Eurasia]], and [[North Africa]]. The genus is most closely related to Keteleeria, a small genus confined to eastern Asia.",
		sections = {
			{
				"Overview",
				"They are tall trees that can be distinguished from other members of the pine family by the way in which their needle-like [[Leaf|leaves]] are attached singly to the branches with a circular base, and by their cones, which, like those of [[Cedrus|cedars]], stand upright on the branches like candles and disintegrate at maturity. The wood of firs is used for pulp to make paper, for plywood, and for indoor construction. Some species serve as Christmas trees, while others are used as decorative trees with their brightly coloured cones. In art, Lucas Cranach the Elder painted Madonna under the fir tree for Wrocław Cathedral in 1510.",
			},
