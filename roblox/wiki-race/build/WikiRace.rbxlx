		tags = { "Specific works of poetry", "Poetic works of antiquity" },
		summary = "The **Masnavi** is an extensive Persian masnavi (a poetic form) written by [[Rumi]], and one of the most influential works in the history of Sufism. It is a series of six books of poetry that together amount to around 25,000 verses or 50,000 lines.",
		sections = {
			{
				"Overview",
