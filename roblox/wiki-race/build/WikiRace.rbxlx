		tags = { "Fishes", "Acanthomorpha" },
		aliases = { "Pacific pollock", "Walleye pollock", "Gadus chalcogrammus" },
		summary = "The **Alaska pollock** also known as **Pacific pollock** or **walleye pollock** (**Gadus chalcogrammus**) is a marine fish species of the [[Cod|cod]] genus Gadus and family Gadidae.",
		sections = {
			{
				"Overview",
				"It is a semi-[[Pelagic zone|pelagic]] [[Shoaling and schooling|schooling]] fish widely distributed in the North Pacific, with largest concentrations found in the eastern [[Bering Sea]].",
