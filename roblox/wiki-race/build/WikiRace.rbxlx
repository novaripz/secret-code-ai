	{
		title = "Polymath",
		category = "Concept",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "Gifted person with broad knowledge",
		tags = { "More articles" },
		aliases = { "Polyhistor" },
		summary = "A **polymath** or **polyhistor** is an individual whose knowledge spans many different subjects, known to draw on complex bodies of knowledge to solve specific problems. Polymaths often prefer a specific context in which to explain their knowledge, but some are gifted at explaining abstractly and creatively.",
		sections = {
			{
				"Overview",
				"Embodying a basic tenet of [[Renaissance humanism]] that humans are limitless in their capacity for development, the concept led to the notion that people should embrace all knowledge and develop their capacities as fully as possible. This is expressed in the term **Renaissance man**, often applied to the gifted people of that age who sought to develop their abilities in all areas of accomplishment: intellectually, artistically, socially, physically, and spiritually.",
			},
