	{
		title = "Henri Bergson",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French philosopher (1859–1941)",
		tags = { "Philosophers", "Modern" },
		aliases = { "Henri-Louis Bergson" },
		summary = "**Henri-Louis Bergson** was a French philosopher who was influential in the traditions of [[Analytic philosophy|analytic philosophy]] and [[Continental philosophy|continental philosophy]], especially during the first half of the 20th century until the [[World War II|Second World War]], but also after 1966 when Gilles Deleuze published Le Bergsonisme.",
		sections = {
			{
				"Overview",
				'Bergson is known for his arguments that processes of immediate experience and intuition are more significant than abstract [[Rationalism|rationalism]] and science for understanding reality. Bergson was awarded the 1927 [[Nobel Prize in Literature]] "in recognition of his rich and vitalizing ideas and the brilliant skill with which they have been presented". In 1930, France awarded him its highest honour, the Grand-Croix de la Legion d\'honneur. Bergson\'s great popularity created a controversy in France, where his views were seen as opposing the "secular and scientific" attitude adopted by the [[French Third Republic|Republic]]\'s officials.',
			},
		},
