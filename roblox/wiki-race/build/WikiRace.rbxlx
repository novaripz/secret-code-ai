			{ "Listing", "[[Seven Summits]]" },
			{ "Country", "[[Russia]], [[Georgia (country)|Georgia]], [[Azerbaijan]], [[Armenia]]" },
			{ "Length", "1200 km" },
		},
	},
	{
		title = "Cayman Islands",
		category = "Geography",
		fame = 2,
		emoji = "🏝️",
		source = "wikipedia",
		description = "British Overseas Territory in the Caribbean",
		tags = { "North America", "Caribbean" },
		summary = "The **Cayman Islands** is a self-governing [[British Overseas Territories|British Overseas Territory]] in the western [[Caribbean]]. With a population of over 90,000, it is the most populated of all the British Overseas Territories. The 264 km² territory comprises the three islands of Grand Cayman, Cayman Brac and Little Cayman, which are located south of [[Cuba]] and north-east of [[Honduras]], between [[Jamaica]] and Mexico's [[Yucatán Peninsula]]. The capital city is George Town on Grand Cayman, which is the most populous of the three islands.",
		sections = {
			{
				"Overview",
				"The Cayman Islands is considered to be part of the geographic Western Caribbean zone as well as the [[Greater Antilles]]. The territory is a major offshore financial centre for international businesses and wealthy individuals mainly due to the state charging no tax on income earned or stored. With a GDP per capita of $97,750 in 2023, the Cayman Islands has the highest standard of living in the Caribbean, and one of the highest in the world. Despite its population of almost 90,000, immigrants from over 140 countries and territories reside in the Cayman Islands.",
