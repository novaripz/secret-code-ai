		aliases = { "Web site" },
		summary = "A **website**, or **web site**, is any [[Web page|web page]] whose content is identified by a common domain name and is published on at least one [[Web server|web server]]. Websites are typically dedicated to a particular topic or purpose, such as news, education, commerce, entertainment, or [[Social media|social media]]. Hyperlinking between web pages guides the navigation of the site, which often starts with a home page. The most-visited sites are Google, [[YouTube]], and [[Facebook]].",
		sections = {
			{
				"Overview",
				"All publicly-accessible websites collectively constitute the [[World Wide Web]], which is accessed via the [[Internet]]. There are also private websites that can only be accessed on a private network, such as a company's internal website for its employees. Users can access websites on a range of devices, including desktops, [[Laptop|laptops]], [[Tablet computer|tablets]], and [[Smartphone|smartphones]]. The app used on these devices is called a [[Web browser|web browser]].",
			},
