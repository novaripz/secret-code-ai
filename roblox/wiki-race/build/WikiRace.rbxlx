			{ "Birthplace", "Retiro, [[Madrid]], [[Spain]]" },
			{ "Education", "National Conservatory of Music, Mexico City" },
			{ "Occupation", "Opera singer ([[Tenor|tenor]]), [[Conducting|conductor]], arts administrator" },
			{ "Years active", "1957–present" },
		},
