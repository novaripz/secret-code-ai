		tags = { "More articles" },
		summary = "In [[Mathematics|mathematics]], a **product** is the result of [[Multiplication|multiplication]], or an expression that identifies [[Mathematical object|objects]] (numbers or [[Variable (mathematics)|variables]]) to be multiplied, called factors. When one factor is an [[Integer|integer]], the product is called a multiple.",
		sections = {
