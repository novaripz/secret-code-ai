	{
		title = "J. M. W. Turner",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English painter (1775–1851)",
		tags = { "Western painters and illustrators", "Modern era" },
		aliases = { "Joseph Mallord William Turner", "William Turner" },
		summary = "**Joseph Mallord William Turner** (London, 23 April 1775 – London, 19 December 1851), known in his time as **William Turner**, was an English [[Romanticism|Romantic]] and regarded as one of the greatest and most influential British painters. He elevated the status of [[Landscape painting|landscape painting]] and is considered a precursor of [[Impressionism]].",
		sections = {
			{
				"Overview",
				"Turner started his career as a [[Watercolor painting|watercolourist]], achieved fame and financial success as an [[Oil painting|oil painter]] and was also an expert [[Printmaking|printmaker]]. His later paintings challenged [[Classicism|classicisist]] artistic conventions and were rejected by critics but are considered today his most important works. Their expressionistic renditions of light and atmosphere inspired the early impressionists [[Claude Monet|Monet]] and [[Camille Pissarro|Pissarro]] when they saw them in London in 1870, 20 years after Turner's death. A child prodigy, Turner was accepted as a student at the Royal Academy of Arts when he was only 14 years old and had a rapid ascent to recognition, fame and financial success. He exhibited his first work in the Academy's Annual Exhibition at 15 and when he was 18 he received a prize recognizing him as a master watercolourist.",
			},
		},
		related = { "Jean-Auguste-Dominique Ingres", "Henri Matisse" },
		infobox = {
			{ "Born", "23 April 1775" },
			{ "Birthplace", "London, England" },
			{ "Died", "19 December 1851" },
			{ "Field", "Paintings" },
			{ "Movement", "[[Romanticism]]" },
		},
	},
	{
		title = "J. P. Morgan",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American financier, banker, and art collector (1837–1913)",
		tags = { "Businesspeople" },
		aliases = { "John Pierpont Morgan Sr." },
		summary = "**John Pierpont Morgan Sr.** (April 17, 1837 – March 31, 1913) was an American financier and investment banker who dominated corporate finance on Wall Street throughout the Gilded Age and Progressive Era. As the head of the banking firm that ultimately became known as JPMorgan Chase & Co., he was the driving force behind a wave of industrial consolidations in the United States at the turn of the twentieth century.",
		sections = {
			{
				"Overview",
				"Over the course of his career on Wall Street, Morgan spearheaded the formation of several prominent multinational corporations including U.S. Steel, International Harvester, and [[General Electric]]. He and his partners also held controlling interests in numerous other American businesses including Aetna, Western Union, the Pullman Car Company, and 21 railroads. His grandfather Joseph Morgan was one of the co-founders of Aetna. Through his holdings, Morgan exercised enormous influence over capital markets in the United States. During the Panic of 1907, he organized a coalition of financiers that saved the American monetary system from collapse. As the Progressive Era's leading banker, Morgan's dedication to efficiency and modernization helped transform the shape of the [[Economy of the United States|American economy]]. Adrian Wooldridge characterized Morgan as America's \"greatest banker\".",
			},
		},
		related = {
