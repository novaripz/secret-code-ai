	{
		title = "Vanuatu",
		category = "Country",
		fame = 2,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Country in Oceania",
		tags = { "Oceania", "Melanesia" },
		aliases = { "Republic of Vanuatu" },
		summary = "**Vanuatu**, officially the **Republic of Vanuatu**, is an [[Archipelagic state|archipelagic country]] in [[Melanesia]] located in the South Pacific Ocean. The [[Archipelago|archipelago]], which is of volcanic origin, is 1750 km east of northern Australia, 540 km northeast of [[New Caledonia]], east of [[New Guinea]], southeast of [[Solomon Islands]], and west of [[Fiji]].",
		sections = {
			{
				"Overview",
				"Vanuatu was first inhabited by [[Melanesians|Melanesian]] people. The first Europeans to visit the islands were a Spanish expedition led by Portuguese navigator Fernandes de Queirós, who arrived on the largest island, Espíritu Santo, in 1606. Queirós claimed the archipelago for Spain, as part of the colonial Spanish East Indies and named it. In the 1880s, [[French Third Republic|France]] and the [[United Kingdom of Great Britain and Ireland|United Kingdom]] claimed parts of the archipelago, and in 1906, they agreed on a framework for jointly managing the archipelago as the New Hebrides – through an Anglo-French condominium. In the 1970s, an independence movement arose, and the Republic of Vanuatu was founded in 1980. Since its independence, the country has become a member of the [[United Nations]], the [[Commonwealth of Nations]], the, and the [[Pacific Islands Forum]].",
			},
		},
		infobox = {
