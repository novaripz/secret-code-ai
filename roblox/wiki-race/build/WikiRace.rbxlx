	{
		title = "Du Fu",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Tang dynasty Chinese poet (712–770)",
		tags = { "Asia", "Eastern Asia" },
		summary = "**Du Fu** was a Chinese poet and government official of the [[Tang dynasty]]. Together with his older contemporary and friend [[Li Bai]], he is one of the principal poets associated with Tang poetry. Nearly 1,500 poems attributed to him survive.",
		sections = {
			{
				"Overview",
				'Du Fu pursued an official career and briefly served as a remonstrance official at the imperial court. The An Lushan rebellion, which began in 755, displaced him and his family and shaped much of his later writing. He subsequently lived in Qinzhou and Chengdu before traveling through the middle Yangtze region. Du Fu died in 770; accounts differ on the place and cause of his death. Later Chinese critics called him the "Poet-Historian" and the "Poet-Sage". His poetry records war, displacement, official life, family experience, and everyday observation, and it became influential in both Chinese and Japanese literary traditions.',
			},
		},
		related = { "Amir Khusrau", "Ferdowsi" },
		infobox = {
			{ "Born", "712" },
			{ "Birthplace", "possibly Gong County, Henan, Tang China" },
			{ "Died", "770 (aged 57–58)" },
			{ "Occupation", "Poet, government official" },
		},
	},
}
