	{
		title = "Lycurgus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Traditional founder of Sparta's institutions",
		tags = { "Eastern Europe", "Greece" },
		summary = "**Lycurgus** was the legendary lawgiver of [[Sparta]], credited with the formation of its eunomia (good order), involving political, economic, and social reforms to produce a military-oriented Spartan society in accordance with the Delphic oracle. The Spartans in the historical period honoured him as a god.",
		sections = {
			{
				"Overview",
				"As a historical figure, almost nothing is known for certain about him, including when he lived and what he did in life. The stories about him place him at multiple times. Nor is it clear when the political reforms attributed to him, called the Great Rhetra, occurred. Ancient dates range from – putting aside the implausibly early [[Xenophon|Xenophonic]] 11th century BC – the early ninth century (c. 885 BC) to as late as early eighth century (c. 776 BC). There remains no consensus as to when he lived; some modern scholars deny he existed at all. The reforms at various times attributed to him touch all aspects of Spartan society.",
			},
		},
		related = { "Philip II of Macedon", "Demosthenes" },
	},
	{
		title = "Lê Lợi",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Founding Emperor of the Later Lê dynasty",
		tags = { "Asia", "Southeastern Asia" },
		aliases = { "Lê Thái Tổ", "Bình Định vương" },
		summary = "**Lê Lợi**, also known by his [[Temple name|temple name]] as **Lê Thái Tổ** and by his royal title **Bình Định vương**, was a [[Demographics of Vietnam|Vietnamese]] rebel leader who founded the [[Lê dynasty|Later Lê dynasty]] and became the first emperor of the restored kingdom of [[Đại Việt]] following the conquest of Đại Ngu by the [[Ming dynasty]]. In 1418, Lê Lợi and his followers rose up against Ming rule. He was known for his effective guerrilla tactics, including constantly moving his camps and using small bands of irregulars to ambush the larger Ming forces. In 1427, Lê Lợi's resistance movement successfully drove the Ming armies out of Vietnam and restored Vietnamese independence.",
		sections = {
			{
				"Overview",
				"Lê Lợi is among the most famous figures of Vietnamese history and often considered one of its greatest national heroes.",
			},
		},
		related = { "Svatopluk I of Moravia" },
		infobox = {
			{ "Born", "10 September 1385" },
			{ "Birthplace", "Lam Sơn, Thanh Hóa" },
			{ "Died", "5 October 1433 (aged 48)" },
		},
	},
	{
		title = "M. C. Escher",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Dutch graphic artist (1898–1972)",
		tags = { "Visual artists", "Western painters and illustrators" },
		aliases = { "Maurits Cornelis Escher" },
		summary = "**Maurits Cornelis Escher** was a Dutch graphic artist who made [[Woodcut|woodcuts]], [[Lithography|lithographs]], and mezzotints, many of which were inspired by mathematics. Despite wide popular interest, for most of his life Escher was neglected in the art world, even in his native Netherlands. He was 70 before a retrospective exhibition was held. In the late twentieth century, he became more widely appreciated, and in the twenty-first century he has been celebrated in exhibitions around the world.",
		sections = {
			{
				"Overview",
				"His work features mathematical objects and operations including impossible objects, explorations of infinity, reflection, [[Symmetry|symmetry]], [[Perspective (graphical)|perspective]], truncated and stellated polyhedra, [[Hyperbolic geometry|hyperbolic geometry]], and [[Tessellation|tessellations]]. Although Escher believed he had no mathematical ability, he interacted with the mathematicians George Pólya, Roger Penrose, and Donald Coxeter, and the [[Crystallography|crystallographer]] Friedrich Haag, and conducted his own research into tessellation. Early in his career, he drew inspiration from nature, making studies of insects, landscapes, and plants such as [[Lichen|lichens]], all of which he used as details in his artworks. He traveled in Italy and Spain, sketching buildings, townscapes, architecture and the tilings of the [[Alhambra]] and the Mezquita of Cordoba, and became steadily more interested in their [[Mathematical structure|mathematical structure]].",
			},
		},
		related = { "Hergé", "Will Eisner" },
		infobox = {
			{ "Born", "17 June 1898" },
			{ "Birthplace", "Leeuwarden, Netherlands" },
			{ "Died", "27 March 1972" },
