	{
		title = "Opinion poll",
		category = "Concept",
		fame = 3,
		emoji = "🧍",
		source = "wikipedia",
		description = "Human research survey of public opinion",
		tags = { "Politics and government", "Politics" },
		aliases = { "Survey", "Poll" },
		summary = "An **opinion poll**, often simply referred to as a **survey** or a **poll**, is a human research survey of [[Public opinion|public opinion]] from a particular [[Sampling (statistics)|sample]]. Opinion polls are usually designed to represent the opinions of a population by conducting a series of questions and then extrapolating generalities in ratio or within confidence intervals. A person who conducts polls is referred to as a **pollster**.",
	},
	{
		title = "Oral literature",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Spoken or sung literature",
		tags = { "More articles" },
		aliases = { "Folk literature" },
		summary = "**Oral literature**, **orature**, or **folk literature** is a [[Genre|genre]] of [[Literature|literature]] that is spoken or sung in contrast to that which is [[Writing|written]], though much oral literature has been transcribed. There is no standard definition, as [[Anthropologist|anthropologists]] have used varying descriptions for oral literature or folk literature. A broad conceptualization refers to it as literature characterized by oral transmission and the absence of any fixed form. It includes the stories, legends, and history passed through generations in a spoken form.",
		related = { "Conservatoire de Paris" },
	},
	{
		title = "Oral tradition",
		category = "Concept",
		fame = 1,
		emoji = "🎶",
		source = "wikipedia",
		description = "Culture preserved through speech or song",
		tags = { "Culture", "Basics" },
		aliases = { "Oral lore" },
		summary = '**Oral tradition**, or **oral lore**, is a form of human communication in which knowledge, art, beliefs, ideas and [[Culture|culture]] are received, preserved, and transmitted orally from one generation to another. The transmission is through [[Speech|speech]] or song and may include [[Folklore|folktales]], [[Ballad|ballads]], chants, [[Prose|prose]] or [[Poetry|poetry]]. The information is mentally recorded by oral repositories, sometimes termed "walking libraries", who are usually also performers. Oral tradition is a [[Means of communication|medium of communication]] for a society to transmit oral history, [[Oral literature|oral literature]], oral law and other knowledge across generations without a [[Writing system|writing system]], or in parallel to a writing system. It is the [[History of communication|most widespread]] medium of human communication.',
		sections = {
			{
				"Overview",
				"They often remain in use in the [[Modern era|modern era]] throughout for cultural preservation. Religions such as Buddhism, Hinduism, Catholicism, and Jainism have used oral tradition, in parallel to writing, to transmit their canonical scriptures, [[Ritual|rituals]], [[Hymn|hymns]] and mythologies. African societies have broadly been labelled oral civilisations, contrasted with literate civilisations, due to their reverence for the oral word and widespread use of oral tradition. Oral tradition is memories, knowledge, and expression held in common by a group over many generations: it is the long preservation of immediate or contemporaneous [[Testimony|testimony]]. It may be defined as the recall and transmission of specific, preserved textual and cultural knowledge through vocal utterance. Oral tradition is usually popular, and can be exoteric or esoteric.",
			},
		},
	},
	{
		title = "Oratorio",
		category = "Concept",
		fame = 2,
		emoji = "🎻",
		source = "wikipedia",
		description = "Large musical composition including an orchestra, a choir, and soloists",
		tags = { "More articles" },
		summary = "An **oratorio** is a [[Musical composition|musical composition]] with [[Drama|dramatic]] or [[Narrative|narrative]] text for [[Choir|choir]], soloists and [[Orchestra|orchestra]] or other [[Musical ensemble|ensemble]].",
		sections = {
			{
				"Overview",
				"Similar to [[Opera|opera]], an oratorio includes the use of a choir, soloists, an instrumental ensemble, various distinguishable characters (e.g. soloists), and [[Aria|arias]]. However, opera is [[Musical theatre|musical theatre]], and typically involves significant theatrical spectacle, including sets, props, and [[Costume|costuming]], as well as staged interactions between characters. In an oratorio, there is generally minimal staging, with the chorus often assuming a more central dramatic role, and the work is typically presented as a concert piece – though oratorios are sometimes staged as operas, and operas are not infrequently presented in concert form. A particularly important difference between opera and oratorio is in the typical subject matter of the text.",
			},
		},
	},
	{
		title = "Orbital eccentricity",
