	},
	{
		title = "Arabian Desert",
		category = "Geography",
		fame = 3,
		emoji = "🏜️",
		source = "wikipedia",
		description = "Desert located in Western Asia",
		tags = { "Physical geography", "Deserts" },
		summary = "The **Arabian Desert** is a vast [[Desert|desert]] wilderness in [[West Asia]] that occupies almost the entire [[Arabian Peninsula]] with an area of 2,330,000 km². It stretches from [[Yemen]] to the [[Persian Gulf]] and [[Oman]] to [[Jordan]] and [[Iraq]]. It is the fourth largest desert in the world and the largest in Asia. At its southern end is Ar-Rub' al-Khali (The Empty Quarter), the largest continuous body of [[Sand|sand]] in the world. It is an extension of the [[Sahara|Sahara Desert]].",
		sections = {
			{
				"Overview",
				"The climate is mostly dry (the major part receives around 100 mm of rain per year, but some very rare places receive as little as 50 mm), and temperatures oscillate between very high heat and seasonal night time freezes. It is part of the deserts and xeric shrublands [[Biome|biome]] and lie in [[Biogeography|biogeographical]] realms of the Palearctic (northern part) and Afrotropical (southern part). The Arabian Desert [[Ecoregion|ecoregion]] has little [[Biodiversity|biodiversity]], although a few endemic plants grow here. Many species, such as the striped hyena, [[Jackal|jackal]] and [[Honey badger|honey badger]], have died out as a result of [[Hunting|hunting]], [[Habitat destruction|habitat destruction]], overgrazing by livestock, off-road [[Driving|driving]], and human encroachment on their habitat. Other species, such as the Arabian sand gazelle, have been successfully re-introduced and are protected at reserves.",
			},
		},
		infobox = {
			{ "Area", "1,855,470" },
			{ "Country", "Saudi Arabia" },
