		emoji = "🕳️",
		tags = { "Oceanic trenches" },
		summary = "The **Mariana Trench** in the western [[Pacific Ocean]] is the deepest place on [[Earth]], almost 11 km below the surface.",
		sections = {
			{
				"Exploration",
				"Only a handful of people have reached its bottom in special submersibles similar to a [[Submarine|submarine]].",
			},
		},
		infobox = { { "Max depth", "10,935 m" }, { "Ocean", "[[Pacific Ocean]]" } },
	},
	{
