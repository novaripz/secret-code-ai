		emoji = "📄",
		tags = { "Ancient inventions", "Materials" },
		summary = "**Paper** is a thin material made from plant fibers, usually wood pulp from [[Tree|trees]]. It was invented in [[China]] around AD 105.",
		sections = {
			{
				"Uses",
				"Paper made [[Book|books]] and [[Money|banknotes]] possible and can be folded into [[Origami|origami]].",
			},
		},
		infobox = { { "Invented", "~AD 105, [[China]]" }, { "Made from", "Wood pulp" } },
		related = { "Paper clip" },
	},
