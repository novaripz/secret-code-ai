	{
		title = "Hungarian People's Republic",
		category = "Geography",
		fame = 2,
		emoji = "👥",
		source = "wikipedia",
		description = "Country in Central Europe (1949–1989)",
		tags = { "More articles" },
		summary = "The **Hungarian People's Republic** was the Hungarian [[State (polity)|state]] from 20 August 1949 until the establishment of the current [[Hungary|Republic of Hungary]] on 23 October 1989. It was a professed [[Communist state|communist state]], governed first by the Hungarian Working People's Party and after the [[Hungarian Revolution of 1956]], the Hungarian Socialist Workers' Party. Both governments were closely tied to the [[Soviet Union]] as part of the [[Eastern Bloc]].",
		sections = {
			{
				"Overview",
				'The state considered itself the heir to the Hungarian Soviet Republic, which was formed in 1919 as one of the first [[Communist state|communist states]] created after the [[Russian Soviet Federative Socialist Republic]] (Russian SFSR). It was designated a "people\'s democratic republic" by the Soviet Union in the 1940s. Geographically, it bordered [[Socialist Republic of Romania|Romania]] and the [[Soviet Union]] (via the [[Ukrainian Soviet Socialist Republic|Ukrainian SSR]]) to the east; [[Socialist Federal Republic of Yugoslavia|Yugoslavia]] (via SRs Croatia, Serbia, and Slovenia) to the southwest; Czechoslovakia to the north and [[Austria]] to the west. The Communists spent consolidating their hold on power and weakening the other parties. This culminated in October 1947, when the Communists told their non-Communist coalition partners that they had to cooperate with a reconfigured coalition government if they wanted to stay in the country.',
			},
		},
		infobox = {
			{ "Symbol", "Coat of arms of Hungary" },
			{
				"Conservation status",
