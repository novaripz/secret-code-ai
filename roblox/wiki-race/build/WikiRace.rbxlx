			{ "Date", "2021" },
			{ "Family", "[[Language isolate]] (Vasconic?)" },
			{
				"Writing system",
				"* [[Latin script|Latin]] (Basque alphabet) Basque Braille Northeastern Iberian script (c. 80 BC)",
			},
		},
