			{ "Government", "Unitary [[Presidential system|presidential republic]]" },
			{ "Established", "1750–1884" },
		},
	},
	{
		title = "South Ossetia",
		category = "Country",
		fame = 3,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Partially recognised state in the South Caucasus",
		tags = { "Countries", "Asia" },
		aliases = { "State of Alania", "Republic of South Ossetia" },
		summary = "**South Ossetia**, formally known as the **State of Alania** since 2017, or originally the **Republic of South Ossetia**, is a partially recognised state in the [[South Caucasus]]. It has an officially stated population of just over 56,500 people (2022), who live in an area of 3,900 km², with 33,000 living in the capital city, Tskhinvali. It de facto borders only Russia and Georgia.",
		sections = {
			{
				"Overview",
				"As of 2026, four members of the [[United Nations]] (UN) recognise South Ossetia as a sovereign state – [[Russia]], [[Venezuela]], [[Nicaragua]], and [[Syria]]. The Georgian government and all other UN member states regard South Ossetia as sovereign territory of [[Georgia (country)|Georgia]]. Georgia and the European Court of Human Rights have ruled the region to be under the Russian occupation due to the nature of Russia's military, political and economic presence in South Ossetia. The political status of South Ossetia is a central issue of the Georgian–Ossetian conflict and Georgia–Russia relations. The Georgian government informally refers to the area as the **Tskhinvali region** and considers it a part of Georgia's Imereti, Mtskheta-Mtianeti, Racha-Lechkhumi and Kvemo Svaneti and Shida Kartli regions.",
			},
		},
		infobox = {
			{ "Conservation status", "State with limited recognition" },
