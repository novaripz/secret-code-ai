		description = "French historian and leader of the Annales School (1902–1985)",
		tags = { "Historians and archaeologists", "Modern" },
		aliases = { "Fernand Paul Achille Braudel" },
		summary = "**Fernand Paul Achille Braudel** was a French historian. His scholarship focused on three main projects: The Mediterranean (1923–49, then 1949–66), Civilization and Capitalism (1955–79), and the unfinished Identity of France (1970–85). He was a member of the Annales School of French [[Historiography|historiography]] and [[Social history|social history]] in the 1950s and 1960s.",
		sections = {
			{
				"Overview",
				"Braudel emphasized the role of large-scale socioeconomic factors in the making and writing of history. In a 2011 poll by History Today magazine, he was named the most important historian of the previous 60 years.",
