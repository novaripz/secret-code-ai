	{
		title = "Black pepper",
		category = "Plant",
		fame = 2,
		emoji = "🌶️",
		source = "wikipedia",
		description = "Ground fruit of the family Piperaceae",
		tags = { "Flowering plants", "Magnoliids" },
		aliases = { "Piper nigrum", "Peppercorn" },
		summary = "**Black pepper** (**Piper nigrum**) is a [[Flowering plant|flowering]] [[Vine|vine]] in the family Piperaceae, cultivated for its [[Fruit|fruit]] (the **peppercorn**), which is usually dried and used as a [[Spice|spice]] and [[Seasoning|seasoning]]. The fruit is a [[Drupe|drupe]] (stonefruit) which is about 5 mm in diameter (fresh and fully mature), dark red, and contains a stone which encloses a single pepper [[Seed|seed]]. Peppercorns and the ground pepper derived from them may be described simply as pepper, or more precisely as black pepper (cooked and dried unripe fruit), green pepper (dried unripe fruit), or white pepper (ripe fruit seeds).",
		sections = {
			{
				"Overview",
				"Black pepper is native to [[South Asia]]. Ground, dried, and cooked peppercorns have been used since antiquity, both for flavour and as a [[Traditional medicine|traditional medicine]]. Black pepper is one of the most commonly traded spices in the world. Its spiciness is due to the chemical compound piperine, which is a different kind of spiciness from that of capsaicin characteristic of [[Chili pepper|chilli peppers]]. It is ubiquitous in the Western world as a seasoning and is often paired with [[Salt|salt]] and available on dining tables in shakers or mills.",
			},
		},
		infobox = {
			{ "Scientific name", "Piper nigrum" },
		},
	},
	{
