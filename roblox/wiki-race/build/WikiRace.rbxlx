		summary = "**Northwestern Europe**, or **Northwest Europe**, is a loosely defined [[Subregion|subregion]] of [[Europe]], overlapping [[Northern Europe|Northern]] and [[Western Europe]]. The term is used in geographic, history, and military contexts.",
