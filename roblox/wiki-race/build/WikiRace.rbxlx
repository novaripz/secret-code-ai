	{
		title = "Muthuswami Dikshitar",
		category = "Musician",
		fame = 2,
		emoji = "🎤",
		source = "wikipedia",
		description = "Indian composer (1776–1835)",
		tags = { "Non-Western art music", "Carnatic classical" },
		aliases = { "Mudduswamy Dikshitar", "Dikshitar", "Guruguha" },
		summary = "**Muthuswami Dikshitar** (24 March 1776–21 October 1835; also known as **Mudduswamy Dikshitar** and, mononymously, as **Dikshitar**, and sometimes **Guruguha**), was a [[South India|South Indian]] Hindu poet, singer, veena player, and prolific composer of [[Indian classical music]]. He was the youngest member of the Trinity of Carnatic music, alongside [[Tyagaraja]] (1767–1847), and [[Syama Sastri]] (1762–1827).",
		sections = {
			{
				"Overview",
				"Dikshitar is credited with around 500 compositions, widely recognised for their elaborate poetic descriptions of Hindu deities and detailed architectural depictions of temples. Continuing to be widely performed in [[Carnatic music]] concerts, his music is notable for capturing the essence of ragas in the vainika (veena) style, which highlights the use of gamakas. His works are usually composed in a slower tempo (chowka kala), often incorporating middle tempo stanzas (madhyama kala sahitya). Unlike the predominantly [[Telugu language|Telugu]] compositions of his Carnatic contemporaries Tyagaraja and Syama Sastri, Dikshitar's works are mostly in [[Sanskrit]]. He also composed a few kritis in Manipravalam, a literary style combining Sanskrit and [[Tamil language|Tamil]].",
			},
		},
		related = { "Bing Crosby", "Ray Charles" },
		infobox = {
			{ "Born", "24 March 1776" },
			{ "Birthplace", "Thiruvarur, near Thanjavur, [[Tamil Nadu]]" },
			{ "Died", "21 October 1835" },
			{ "Occupation", "[[Carnatic music]] [[Composer|composer]], Vainika" },
		},
	},
	{
		title = "Nadia Boulanger",
		category = "Musician",
		fame = 2,
		emoji = "🎤",
		source = "wikipedia",
		description = "French musician and teacher (1887–1979)",
		tags = { "Western art music", "Pedagogues" },
		aliases = { "Juliette Nadia Boulanger" },
		summary = "**Juliette Nadia Boulanger** was a French music teacher, conductor and composer. She taught many of the leading composers and musicians of the twentieth century, and also performed occasionally as a pianist and organist.",
		sections = {
			{
				"Overview",
				"Born into a musical family (her father Ernest and sister Lili were acclaimed composers), Boulanger entered the [[Conservatoire de Paris]] at an early age but, believing that she lacked particular compositional talent, she forsook writing music and became a teacher. In that capacity, she influenced generations of young composers, especially those from the United States and other English-speaking countries. Among her students were many important composers, soloists, arrangers, and conductors, including Grażyna Bacewicz, Daniel Barenboim, İdil Biret, Elliott Carter, [[Aaron Copland]], David Diamond, John Eliot Gardiner, [[Philip Glass]], Roy Harris, Quincy Jones, Dinu Lipatti, Igor Markevitch, [[Astor Piazzolla]], Julia Perry, George Walker, and over 250 others.",
			},
		},
		related = { "Bing Crosby", "Ray Charles" },
		infobox = {
			{ "Birthplace", "[[Paris]], France" },
			{ "Born", "16 September 1887" },
			{ "Died", "22 October 1979" },
			{ "Occupation", "Music teacher, conductor, composer" },
		},
	},
	{
		title = "Niccolò Paganini",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "Italian violinist and composer (1782–1840)",
		tags = { "Performers", "Violinists" },
		aliases = { "Niccolò", "Nicolò", "Paganini" },
		summary = "**Niccolò** (or **Nicolò**) **Paganini** was an Italian [[Violin|violinist]], guitarist and composer. He was the most celebrated violin [[Virtuoso|virtuoso]] of his time, and left his mark as one of the pillars of modern violin technique. His 24 Caprices for Solo Violin Op. 1 are among the best known of his compositions and have served as an inspiration for many prominent composers.",
		sections = {
			{
				"Overview",
				"Son of a ship chandler from [[Genoa]], Paganini showed great gifts for music from an early age and studied under Alessandro Rolla, Ferdinando Paer and Gasparo Ghiretti. Accompanied by his father, he toured northern Italy extensively as a teenager. By 1805 he had come into the service of Napoleon's sister, Elisa Bonaparte, who then ruled Lucca where Paganini was first violin. From 1809 on he returned to touring and achieved continental fame in the subsequent two and a half decades, developing a reputation for his technical brilliance and showmanship, as well as his extravagant, philandering lifestyle. He retired and died in [[Nice]] (at that time still part of the Kingdom of Sardinia) in 1840 at the age of 57.",
			},
		},
		related = { "John Williams", "Johannes Brahms" },
		infobox = {
			{ "Born", "27 October 1782" },
			{ "Birthplace", "[[Genoa]], Republic of Genoa" },
			{ "Died", "27 May 1840" },
			{ "Occupation", "Violinist, guitarist, composer" },
		},
	},
	{
		title = "Nikolai Rimsky-Korsakov",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "Russian composer (1844–1908)",
		tags = { "Composers", "Romantic" },
		summary = "His best-known orchestral compositions—Capriccio Espagnol, the Russian Easter Festival Overture, and the symphonic suite Scheherazade—are staples of the classical music repertoire, along with suites and excerpts from some of his fifteen operas. Scheherazade is an example of his frequent use of [[Fairy tale|fairy-tale]] and [[Folklore|folk subjects]]. He was the husband of the composer Nadezhda Rimskaya-Korsakova.",
		sections = {
			{
				"Overview",
				"Rimsky-Korsakov believed in developing a nationalistic style of classical music, employing Russian folk song and lore along with exotic harmonic, [[Melody|melodic]] and [[Rhythm|rhythmic]] elements in a practice known as musical [[Orientalism|orientalism]], and eschewing traditional Western compositional methods. Rimsky-Korsakov appreciated Western musical techniques after he became a professor of musical composition, [[Harmony|harmony]], and orchestration at the Saint Petersburg Conservatory in 1871. He undertook a rigorous three-year program of self-education and became a master of Western methods, incorporating them alongside the influences of Mikhail Glinka and fellow members of The Five. Rimsky-Korsakov's techniques of composition and orchestration were further enriched by his exposure to the works of [[Richard Wagner]].",
			},
		},
		related = { "Giuseppe Verdi", "Modest Mussorgsky" },
		infobox = {
			{ "Born", "18 March 1844" },
			{ "Birthplace", "Tikhvin, Russia" },
			{ "Died", "21 June 1908" },
		},
	},
	{
		title = "Nusrat Fateh Ali Khan",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "Pakistani singer-songwriter (1948–1997)",
		tags = { "Non-Western art music", "Qawwali" },
		aliases = { "NFAK" },
		summary = '**Nusrat Fateh Ali Khan** (13 October 1948 – 16 August 1997), also known as **NFAK**, was a Pakistani singer, songwriter, multi-instrumentalist, composer, and music director, primarily associated with qawwali, a form of Sufi devotional music from [[Pakistan]] and [[India]]. He ranks as one of the most influential South Asian singers of all time. Widely recognised as the **"Shahanshah-e-Qawwali"**, he has been recognised as one of the 50 Great Voices by [[NPR]] and [[Rolling Stone\'s 200 Greatest Singers of All Time|200 Greatest Singers of All Time]] by [[Rolling Stone]]. [[The New York Times]] named Khan the greatest qawwali singer of his generation.',
		sections = {
			{
				"Overview",
				"Credited with introducing Qawwali music to international audiences, he was known for his vocal abilities and could perform at a high level of intensity for several hours. Born in West Punjab, Khan had his first public performance at the age of 15 at his father's chelum. He became the head of the family qawwali party in 1971 and added his unique style of sargam, khayal, and [[Rhythm|rhythm]] to his family's legacy. He was signed by Oriental Star Agencies, based in [[Birmingham|Birmingham, England]], in the early 1980s. Khan went on to release movie scores and albums in Europe, India, Japan, Pakistan, and the United States. He engaged in collaborations and experiments with Western artists, becoming a well-known world music artist. He toured extensively, performing in over 40 countries.",
			},
		},
		related = { "Bing Crosby", "Ray Charles" },
		infobox = {
			{ "Born", "13 October 1948" },
			{ "Birthplace", "Lyallpur, West Punjab, Pakistan" },
			{ "Died", "16 August 1997" },
			{ "Occupation", "Singer, songwriter, musician, music director" },
		},
	},
	{
		title = "Pablo Casals",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "Catalan cellist and conductor (1876–1973)",
		tags = { "Performers", "Cellists" },
		aliases = { "Pau Casals i Defilló" },
		summary = "**Pablo Casals** (29 December 1876 – 22 October 1973), also known by his birth name, **Pau Casals i Defilló** (Catalan: ), was a [[Catalonia|Catalan]] cellist, composer, and conductor, born in Spain. He made many recordings throughout his career of solo, chamber, and orchestral music, including some as conductor, but he is perhaps best remembered for the recordings he made of the Cello Suites by [[Johann Sebastian Bach|Bach]].",
		sections = {
			{
				"Overview",
				"Casals had an international career and traveled and performed widely. With the fall of Republican Spain to the Nationalist forces of Francisco Franco in 1939, Casals went into self-exile, refusing to return to Spain until democracy was restored. He lived in Prades, France from 1939 to 1956, and then in Ceiba, Puerto Rico from 1956 until his death in 1973. One of his last compositions was the Hymn to the United Nations, which he conducted at the United Nations in 1971. At that event, he was awarded the U.N. Peace Medal in recognition of his stance for peace, justice and freedom. In accepting the award, he gave a short speech I Am a Catalan and performed the traditional Catalan song, El Cant dels Ocells.",
			},
		},
		related = { "Johannes Brahms", "John Williams" },
		infobox = {
			{ "Born", "29 December 1876" },
			{ "Birthplace", "El Vendrell, Catalonia" },
			{ "Died", "22 October 1973" },
			{ "Occupation", "Cellist, Composer, Conductor" },
		},
	},
	{
		title = "Paco de Lucía",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "Spanish flamenco, classical, jazz guitarist and musician (1947–2014)",
		tags = { "Popular music", "Non-English language popular music" },
		aliases = { "Francisco Gustavo Sánchez Gómez" },
		summary = '**Francisco Gustavo Sánchez Gómez**, known as **Paco de Lucía**, was a Spanish [[Virtuoso|virtuoso]] [[Flamenco|flamenco]] guitarist, [[Composer|composer]], and record producer. A leading proponent of the new flamenco style, he was one of the first flamenco guitarists to branch into classical and jazz. Richard Chapman and Eric Clapton, authors of Guitar: Music, History, Players, describe de Lucía as a "titanic figure in the world of flamenco guitar", and Dennis Koster, author of Guitar Atlas, Flamenco, has referred to de Lucía as "one of history\'s greatest guitarists".',
		sections = {
			{
				"Overview",
				'De Lucía was noted for his fast and fluent picados (fingerstyle runs). A master of contrast, he often juxtaposed picados and rasgueados (flamenco strumming) with more sensitive playing and was known for adding abstract chords and scale tones to his compositions with jazz influences. These innovations played a key role in the development of traditional flamenco and the evolution of new flamenco and Latin jazz fusion from the 1970s. He received acclaim for his recordings with flamenco singer Camarón de la Isla in the 1970s, recording ten albums which are considered some of the most important and influential in flamenco history. Some of de Lucía\'s best known recordings include "Río Ancho" (later fused with Al Di Meola\'s "Mediterranean Sundance"), "Entre dos aguas", "La Barrosa", "Ímpetu", "Cepa Andaluza" and "Gloria al Niño Ricardo".',
			},
		},
		related = { "Paul McCartney", "Bing Crosby" },
		infobox = {
			{ "Born", "21 December 1947" },
			{ "Birthplace", "Algeciras, Province of Cádiz, Spain" },
			{ "Died", "25 February 2014" },
			{ "Instruments", "Flamenco guitar" },
			{ "Genre", "Flamenco, [[Classical music|classical]]" },
			{ "Occupation", "Guitarist [[Composer|composer]]" },
			{ "Years active", "1958–2014" },
		},
	},
	{
		title = "Paul McCartney",
		category = "Musician",
		fame = 1,
		emoji = "🎤",
		source = "wikipedia",
		description = "English musician and songwriter (born 1942)",
		tags = { "Popular music", "Rock" },
		aliases = { "Sir James Paul McCartney" },
		summary = "**Sir James Paul McCartney** is an English musician and songwriter. He gained global fame with [[The Beatles|the Beatles]], for whom he was the bassist and keyboardist, and shared primary songwriting and lead vocal duties with [[John Lennon]]. McCartney is known for his melodic approach to bass-playing, versatile [[Tenor|tenor]] vocal range and musical eclecticism, exploring genres ranging from pre–rock and roll pop to classical, ballads and electronica. His songwriting partnership with Lennon was the most successful in music history.",
		sections = {
			{
				"Overview",
				'Born in [[Liverpool]], McCartney taught himself piano, guitar, and songwriting as a teenager, having been influenced by his father, a jazz player, and rock and roll performers such as [[Little Richard]] and [[Buddy Holly]]. He began his career when he joined Lennon\'s skiffle group, the Quarrymen, in 1957, which evolved into the Beatles in 1960. Sometimes called "the cute Beatle", McCartney later immersed himself in the London [[Avant-garde|avant-garde]] scene and played a key role in incorporating [[Experimental music|experimental]] aesthetics into the Beatles\' studio productions. Starting with the 1967 album [[Sgt. Pepper\'s Lonely Hearts Club Band]], he gradually became the band\'s de facto leader, providing creative impetus for most of their music and film projects. Many of his Beatles songs, including "And I Love Her", "Yesterday", "Eleanor Rigby" and "Blackbird", rank among the most covered songs in history.',
			},
		},
		related = {
			"Ali Akbar Khan",
			"Charles Aznavour",
