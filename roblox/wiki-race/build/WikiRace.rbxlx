	{
		title = "Geologist",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Scientist who studies geology",
		tags = { "More articles" },
		summary = "A **geologist** is a [[Scientist|scientist]] who studies the structure, composition, and [[History of Earth|history]] of [[Earth]]. Geologists incorporate techniques from [[Physics|physics]], [[Chemistry|chemistry]], [[Biology|biology]], [[Mathematics|mathematics]], and [[Geography|geography]] to perform [[Research|research]] in the [[Field research|field]] and the [[Laboratory|laboratory]]. Geologists work in the [[Energy industry|energy]] and [[Mining|mining]] sectors to exploit [[Natural resource|natural resources]]. They monitor environmental hazards such as [[Earthquake|earthquakes]], [[Volcano|volcanoes]], [[Tsunami|tsunamis]] and [[Landslide|landslides]]. Geologists are also important contributors to [[Climate change|climate change]] discussions.",
		related = { "Bycatch" },
		infobox = {
			{ "Type", "[[Profession]]" },
		},
