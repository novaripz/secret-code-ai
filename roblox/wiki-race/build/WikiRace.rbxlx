		description = "Ethnic group native to the Basque Country",
		tags = { "Ethnology", "Ethnic groups" },
		summary = "**Basques** are a Southwestern European ethnic group, characterised by the [[Basque language]], a common culture, shared genetic ancestry to the ancient Vascones and Aquitanians, and are considered among the last remaining direct descendants of Neolithic European populations in Europe.",
		sections = {
