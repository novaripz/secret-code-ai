			{ "Capital", "[[Quito]]" },
			{ "Largest city", "[[Guayaquil]]" },
			{ "Government", "Unitary [[Presidential system|presidential republic]]" },
			{ "Area", "283,561 km²" },
			{ "Population", "16,938,986" },
		},
