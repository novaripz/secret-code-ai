			{ "Currency", "* [[Gold]] dust Cowry shell (shell currency), Mperedwan, Benda" },
			{ "People are called", "Asantefoɔ" },
		},
	},
	{
		title = "Assyria",
		category = "History",
		fame = 1,
		emoji = "📜",
		source = "wikipedia",
		description = "Major Mesopotamian civilization",
		tags = { "Asia", "West Asia" },
		summary = "**Assyria** was a major ancient [[Mesopotamia|Mesopotamian]] civilization that existed from the 21st to 7th centuries BC which conquered and administered most of [[West Asia]] from the Assyrian heartland in [[Upper Mesopotamia]]. Assyria is called the first true [[Superpower|military superpower]] in human history, and pioneered major inventions and advancements in the first [[Library|libraries]] and large-scale preservation and accumulation of [[Knowledge|knowledge]], statecraft, [[Centralized government|centralised government]], [[Bureaucracy|bureaucracy]], warfare, military organisation, propaganda, [[Art|art]], and [[Architecture|architecture]].",
		sections = {
			{
				"Overview",
				"Assyrian imperial history spans the early [[Bronze Age]] to the late [[Iron Age]], from its beginning as small [[Akkadian Empire|Akkadian]] settlements in northern Mesopotamia to its zenith and collapse as the largest empire to date at the time, and is typically divided into the Early Assyrian (c. 2600–2025 BC), Old Assyrian (c. 2025–1364 BC), Middle Assyrian (c. 1363–912 BC), [[Neo-Assyrian Empire|Neo-Assyrian]] (911–609 BC), and post-imperial (609 BC–c. 240 AD) periods. The [[Assyrians|Assyrian people]] survive to this day and continue to live and practice their culture in their ancient heartland and in the diaspora. Assur, the first Assyrian capital, was founded c. 2600 BC, but there is no evidence that the city was independent until the collapse of the [[Third Dynasty of Ur]], in the 21st century BC, when a line of independent kings starting with Puzur-Ashur I began ruling the city.",
			},
		},
		infobox = {
			{ "Official languages", "[[Akkadian language|Akkadian]] [[Sumerian language|Sumerian]] [[Aramaic]]" },
			{ "Government", "[[Monarchy]]" },
			{ "Era", "[[Bronze Age]] to [[Iron Age]]" },
		},
	},
	{
		title = "Atropatene",
		category = "History",
		fame = 3,
		emoji = "👑",
		source = "wikipedia",
		description = "Ancient Iranian kingdom (c. 323 BC – 226 AD)",
		tags = { "Asia", "Central Asia, Iran, Caucasus" },
		aliases = { "Atropatia", "Atropatian Media" },
		summary = '**Atropatene**, also known as **Atropatia** or **Atropatian Media**, was an ancient [[Iranian peoples|Iranian]] kingdom established in c. 323 BC by the Persian [[Satrap|satrap]] Atropates. The kingdom, mostly centered around the present-day Azerbaijan region in northwestern [[Iran]], was ruled by Atropates\' descendants until the early 1st-century AD, when the Parthian Arsacid dynasty supplanted them. It was conquered by the Sasanians in 226, and turned into a province governed by a marzban ("margrave"). Atropatene was the only Iranian region to remain under Zoroastrian authority from the Achaemenids to the Arab conquest without interruption, aside from being briefly ruled by the [[Macedonia (ancient kingdom)|Macedonian]] king [[Alexander the Great]].',
