		tags = { "More articles" },
		aliases = { "NIST" },
		summary = "The **National Institute of Standards and Technology** (**NIST**) is an agency of the United States Department of Commerce whose mission is to promote American innovation and industrial competitiveness. NIST's activities are organized into physical science laboratory programs that include [[Nanotechnology|nanoscale science and technology]], [[Engineering|engineering]], [[Information technology|information technology]], [[Neutron|neutron]] research, material measurement, and physical measurement. From 1901 to 1988, the agency was named the **National Bureau of Standards**.",
		sections = {
			{ "Overview", "The NIST Historic District was listed on the National Register of Historic Places in 2021." },
		},
		infobox = {
			{ "Headquarters", "100 Bureau Drive Gaithersburg, Maryland, U.S." },
		},
	},
	{
		title = "National Medal of Arts",
		category = "Concept",
		fame = 2,
		emoji = "🎨",
		source = "wikipedia",
		description = "Award and title created by the U.S. Congress",
		tags = { "More articles" },
		summary = "The **National Medal of Arts** is an award and title created by the [[United States Congress]] in 1984, for the purpose of honoring [[Artist|artists]] and patrons of [[The arts|the arts]]. A prestigious American honor, it is the highest honor given to artists and arts patrons by the United States government. Nominations are submitted to the National Council on the Arts, the advisory committee of the National Endowment for the Arts (NEA), who then submits its recommendations to the [[White House]] for the [[President of the United States|president of the United States]] to award. The medal was designed for the NEA by sculptor Robert Graham.",
		related = { "Terrestrial animal", "Filter feeder" },
		infobox = {
			{ "Country", "[[United States]]" },
			{ "Established", "1984 by the [[United States Congress]]" },
		},
	},
	{
		title = "National Medal of Science",
		category = "Concept",
		fame = 2,
		emoji = "🔬",
		source = "wikipedia",
		description = "US science award",
		tags = { "More articles" },
		summary = "The **National Medal of Science** is an honor bestowed by the [[President of the United States|president of the United States]] to individuals in [[Science|science]] and [[Engineering|engineering]] who have made important contributions to the advancement of knowledge in the fields of behavioral and [[Social science|social sciences]], [[Biology|biology]], [[Chemistry|chemistry]], [[Engineering|engineering]], [[Mathematics|mathematics]] and [[Physics|physics]]. The twelve member presidential Committee on the National Medal of Science is responsible for selecting award recipients and is administered by the National Science Foundation (NSF). It is the highest science award in the [[United States]].",
