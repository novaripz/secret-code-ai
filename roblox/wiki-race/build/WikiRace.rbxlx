	{
		title = "Sequoyah",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Cherokee polymath and creator of the Cherokee syllabary",
		tags = { "Linguists" },
		aliases = { "George Gist", "George Guess" },
		summary = "**Sequoyah**, also known as **George Gist** or **George Guess**, was a Native American [[Polymath|polymath]] and neographer of the Cherokee Nation.",
		sections = {
			{
				"Overview",
				"In 1821, Sequoyah completed his Cherokee syllabary, enabling reading and writing in the Cherokee language. One of the first North American Indigenous groups to gain a written language, the Cherokee Nation officially adopted the syllabary in 1825, helping to unify a forcibly divided nation with new ways of communication and a sense of independence. Within a quarter-century, the Cherokee Nation had reached a [[Literacy|literacy]] rate of almost 100%, surpassing that of surrounding European-American settlers. Sequoyah's creation of the Cherokee syllabary is among the few times in [[Recorded history|recorded history]] that an individual member of a pre-literate group created an original, effective [[Writing system|writing system]]. It is believed to have inspired the development of 21 scripts or writing systems used in 65 languages in North America, Africa, and Asia.",
			},
		},
		related = { "Ferdinand de Saussure", "Noam Chomsky" },
		infobox = {
