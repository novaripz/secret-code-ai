		summary = "A **quarry** is a place where [[Rock (geology)|rock]] and earth materials – such as [[Limestone|limestone]], [[Marble|marble]], [[Granite|granite]], [[Gravel|gravel]], and [[Sand|sand]] – are excavated. The operation of quarries is regulated in some jurisdictions to manage their safety risks and reduce their environmental impact.",
		related = { "Scaffolding" },
	},
	{
		title = "Reservoir",
		category = "Engineering",
		fame = 2,
		emoji = "💧",
		source = "wikipedia",
		description = "Storage space for water",
		tags = { "Infrastructure by type", "Hydraulic infrastructure" },
		summary = "A **reservoir** is an enlarged [[Lake|lake]] behind a [[Dam|dam]], usually built to store [[Fresh water|fresh water]], often doubling for hydroelectric power generation.",
		sections = {
			{
				"Overview",
				"Reservoirs are created by controlling a watercourse that drains an existing body of water, interrupting a watercourse to form an [[Bay|embayment]] within it, excavating, or building any number of retaining walls or [[Levee|levees]] to enclose any area to store water.",
			},
		},
		related = { "Pagoda" },
