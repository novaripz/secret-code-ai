	{
		title = "Matter of Britain",
		category = "Concept",
		fame = 3,
		emoji = "💭",
		source = "wikipedia",
		description = "Body of medieval literature",
		tags = { "More articles" },
		summary = "The **Matter of Britain** is the body of [[Medieval literature|medieval literature]] and [[Mythology|legendary]] material associated with [[United Kingdom|Great Britain]] and [[Brittany]] and the legendary kings and heroes associated with it, particularly [[King Arthur]]. (’‘History of the Kings of Britain’’), a 12th-century work by Geoffrey of Monmouth, is a central component of the Matter of Britain.",
		sections = {
			{
				"Overview",
				"It was one of the three great Western story cycles recalled repeatedly in medieval literature, together with the Matter of France, which concerned the legends of [[Charlemagne]] and his companions, as well as the Matter of Rome, which included material derived from or inspired by classical mythology and [[Classical antiquity|classical history]]. Its pseudo-chronicle and chivalric romance works, written both in prose and verse, flourished from the 12th to the 16th century.",
			},
