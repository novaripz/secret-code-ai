		emoji = "🏛️",
		tags = { "Ancient Romans", "Military leaders" },
		aliases = { "Caesar" },
		summary = "**Julius Caesar** was a Roman general and statesman whose rise to power ended the Roman Republic and led to the [[Roman Empire]].",
		sections = {
			{
				"Death",
				"He was assassinated on the Ides of March, 44 BC. The month of July and the Julian [[Calendar|calendar]] are named after him.",
			},
