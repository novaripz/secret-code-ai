			{ "Language", "English" },
			{ "Genre", "[[Tragedy]]" },
			{ "Publisher", "Charles Scribner's Sons" },
			{ "Published", "April 10, 1925" },
		},
	},
	{
		title = "The History of the Decline and Fall of the Roman Empire",
		category = "Book",
		fame = 3,
		emoji = "👑",
		source = "wikipedia",
		description = "1776–1789 work of history by Edward Gibbon",
		tags = { "Specific works of nonfiction", "Nonfiction of early printed book era" },
		aliases = { "Decline and Fall of the Roman Empire" },
		summary = "**The History of the Decline and Fall of the Roman Empire**, sometimes shortened to **Decline and Fall of the Roman Empire**, is a six-volume work by the English historian [[Edward Gibbon]]. The six volumes cover, from 98 to 1590, the [[Nerva–Antonine dynasty|peak]] of the [[Roman Empire]], the history of early Christianity and its emergence as the Roman state religion, the [[Fall of the Western Roman Empire|fall of the Western Roman Empire]], the rise of [[Genghis Khan]] and Tamerlane and the fall of Byzantium, as well as discussions on the ruins of Ancient Rome.",
		sections = {
			{
				"Overview",
				"Volume I was first published in February 1776 by William Strahan and Thomas Cadell. It was reissued in a succession of six revised editions between 1776 and 1789. Volumes II and III appeared in 1781, and the final three volumes (IV–VI) were issued together in 1788. All six volumes of the first edition were published in quarto; later octavo reprints followed from 1783 onward.",
			},
		},
		related = { "Critique of Pure Reason", "Philosophiæ Naturalis Principia Mathematica" },
		infobox = {
			{ "Country", "England" },
			{ "Language", "English" },
			{ "Author", "[[Edward Gibbon]]" },
			{ "Publisher", "Strahan & Cadell, London" },
			{ "Released", "1776–1789" },
		},
	},
	{
		title = "The Hunchback of Notre-Dame",
		category = "Book",
		fame = 1,
		emoji = "📖",
		source = "wikipedia",
		description = "1831 novel by Victor Hugo",
		tags = { "Specific works of fiction", "Fiction of modern era" },
		summary = "**The Hunchback of Notre-Dame** is a French [[Gothic fiction|Gothic]] [[Book|novel]] by [[Victor Hugo]], published in 1831. The title refers to [[Notre-Dame de Paris|the Notre-Dame Cathedral]], which features prominently throughout the novel. It focuses on the unfortunate story of Quasimodo, the [[Romani people|Romani]] street dancer Esmeralda, and Quasimodo's guardian the Archdeacon Claude Frollo in 15th-century [[Paris]]. All its elements—the [[Renaissance]] setting, impossible love affairs and marginalised characters—make the work a model of the literary themes of [[Romanticism]].",
		sections = {
			{
				"Overview",
				"The novel is considered a classic of French literature and has been adapted repeatedly for film, stage and television. Some prominent examples include a 1923 silent film with Lon Chaney, a 1939 sound film with Charles Laughton, a 1956 film with Anthony Quinn, and a 1996 animated film with Tom Hulce. Written during a time of cultural upheaval, the novel champions historical preservation. Hugo solidified Notre-Dame de Paris as a national icon, arguing for the preservation of Gothic architecture as an element of France's cultural heritage.",
			},
		},
		related = { "A Christmas Carol", "Little Women", "The Catcher in the Rye", "Wuthering Heights" },
		infobox = {
			{ "Author", "[[Victor Hugo]]" },
