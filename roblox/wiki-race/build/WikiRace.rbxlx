		description = "French mathematician (1822–1901)",
		tags = { "Mathematicians", "Modern" },
		summary = "**Charles Hermite** was a French [[Mathematician|mathematician]] who studied analysis, number theory, and algebra. One of his most remarkable achievements was the proof of the transcendence of the number [[E (mathematical constant)|e]].",
		infobox = {
