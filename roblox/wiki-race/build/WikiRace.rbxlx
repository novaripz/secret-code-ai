	{
		title = "National Statistics Institute (Spain)",
		category = "Concept",
		fame = 3,
		emoji = "📊",
		source = "wikipedia",
		description = "Spanish Statistical Office",
		tags = { "More articles" },
		aliases = { "National Statistics Institute" },
		summary = "The **National Statistics Institute** is the official government agency in Spain that collects [[Statistics|statistics]] about [[Spain|demography]], the economy, and Spanish [[Society|society]]. It is an autonomous organization responsible for overall coordination of statistical services of the General State Administration in monitoring, control and supervision of technical procedures. Every 10 years, the institute conducts a national census.",
