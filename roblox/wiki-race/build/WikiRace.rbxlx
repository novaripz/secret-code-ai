	{
		title = "Decorative arts",
		category = "Art",
		fame = 1,
		emoji = "🎨",
		source = "wikipedia",
		description = "Design and manufacture of functional, beautiful objects",
		tags = { "Visual arts", "Concepts and forms" },
		summary = "The **decorative arts** are arts or crafts whose aim is the [[Design|design]] and manufacture of objects that are both [[Beauty|beautiful]] and functional. This includes most of the objects for the interiors of buildings, as well as [[Interior design|interior design]], but typically excludes [[Architecture|architecture]]. [[Ceramic art]], metalwork, [[Furniture|furniture]], [[Jewellery|jewellery]], [[Fashion|fashion]], various forms of the [[Textile arts|textile arts]] and glassware are major groupings.",
		sections = {
			{
				"Overview",
				'[[Applied arts]] largely overlap with the decorative arts, and in modern parlance they are both often placed under the umbrella category of [[Design|design]]. The decorative arts are often categorized in distinction to the "fine arts", namely [[Painting|painting]], [[Drawing|drawing]], [[Photography|photography]], and large-scale [[Sculpture|sculpture]], which generally produce objects solely for their [[Aesthetics|aesthetic quality]] and capacity to stimulate the intellect.',
			},
		},
	},
	{
		title = "Design",
		category = "Art",
		fame = 1,
		emoji = "📐",
		source = "wikipedia",
		description = "Plan for the construction of an object or system",
		tags = { "Visual arts", "Concepts and forms" },
		summary = "A **design** is the concept or proposal for an object, process, or [[System|system]]. The word design refers to something that is or has been intentionally created by a thinking agent, and is sometimes used to refer to the inherent nature of something – its design. The verb to design expresses the process of developing a design. In some cases, the direct construction of an object without an explicit prior plan may also be considered to be a design, such as in arts and crafts. A design is expected to have a purpose within a specific context, typically aiming to satisfy certain goals and constraints while taking into account [[Aesthetics|aesthetic]], functional and experiential considerations.",
		sections = {
			{
				"Overview",
				"Traditional examples of designs are [[Architectural drawing|architectural]] and engineering drawings, circuit diagrams, sewing patterns, and less tangible artefacts such as business process models.",
			},
		},
	},
	{
		title = "Digital art",
		category = "Art",
		fame = 3,
		emoji = "🎨",
		source = "wikipedia",
		description = "Art created digitally with a computer",
		tags = { "Visual arts", "Concepts and forms" },
		aliases = { "Digital arts" },
		summary = "**Digital art**, or the **digital arts**, is [[Art|artistic]] work that uses [[Digital electronics|digital technology]] as part of the creative or presentational process. It can also refer to computational art that uses and engages with digital media. Since the 1960s, various names have been used to describe digital art, including computer art, electronic art, multimedia art, and new media art. Digital art includes pieces stored on physical media, such as with digital painting, as well as digital galleries on [[Website|websites]]. Digital art also extends to the field of visual computing.",
