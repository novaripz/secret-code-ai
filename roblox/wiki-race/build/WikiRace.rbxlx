	{
		title = "Lord Kelvin",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "British physicist, engineer and mathematician (1824–1907)",
		tags = { "Physics", "Modern" },
		aliases = { "William Thomson, 1st Baron Kelvin" },
		summary = "**William Thomson, 1st Baron Kelvin** (26 June 1824 – 17 December 1907) was a Scottish mathematician, [[Mathematical physics|mathematical physicist]] and engineer.",
		sections = {
			{
				"Overview",
				"Born in Belfast, he was the professor of Natural Philosophy at the [[University of Glasgow]] for 53 years. There he undertook significant research on the [[Mathematical analysis|mathematical analysis]] of electricity, and was instrumental in the formulation of the first and second [[Laws of thermodynamics|laws of thermodynamics]], He contributed significantly to unifying [[Physics|physics]], which was then in its infancy of development as an emerging academic discipline. He received the [[Royal Society]]'s [[Copley Medal]] in 1883 and served as its president from 1890 to 1895. In 1892 he became the first scientist to be elevated to the [[House of Lords]]. Absolute temperatures are stated in units of [[Kelvin|kelvin]] in Lord Kelvin's honour. While the existence of a coldest possible temperature, [[Absolute zero|absolute zero]], was known before his work, Kelvin determined its correct value as approximately −273.15 degrees [[Celsius]] or −459.67 degrees [[Fahrenheit]].",
			},
		},
		infobox = {
			{ "Born", "26 June 1824" },
			{ "Birthplace", "[[Belfast]], Ireland" },
			{ "Died", "17 December 1907" },
		},
	},
	{
		title = "Lorenzo de' Medici",
		category = "Person",
		fame = 2,
