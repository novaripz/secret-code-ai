	{
		title = "West Germanic languages",
		category = "Concept",
		fame = 2,
		emoji = "🗣️",
		source = "wikipedia",
		description = "Group of languages",
		tags = { "More articles" },
		summary = "The **West Germanic languages** constitute the largest of the three branches of the [[Germanic languages|Germanic]] family of [[Indo-European languages]] (the others being the [[North Germanic languages|North Germanic]] and the extinct East Germanic languages). The West Germanic branch is classically subdivided into three branches: North Sea Germanic, which includes [[English language|English]], [[Scots language|Scots]], the [[Low German|Low German languages]], and the [[Frisian languages]]; Weser–Rhine Germanic, which encompasses [[Dutch language|Dutch]] and its close relatives; and Elbe Germanic, which includes [[German language|German]] and its close relatives and variants.",
		sections = {
			{
				"Overview",
				"English is by far the most widely spoken West Germanic language, with over one billion speakers worldwide. Within Europe, the three most prevalent West Germanic languages are English, German, and Dutch. Frisian, spoken by about 450,000 people, constitutes a fourth distinct variety of West Germanic. The language family also includes [[Afrikaans]], Yiddish, Low Saxon, Luxembourgish, Hunsrik, and [[Scots language|Scots]]. Additionally, several [[Creole language|creoles]], patois, and pidgins are based on Dutch, English, or German.",
			},
		},
		infobox = {
			{ "Region", "Originally between the [[Rhine]], [[Alps]], [[Elbe]], and [[North Sea]]; today worldwide" },
