	{
		title = "ASEAN",
		category = "Organization",
		fame = 2,
		emoji = "🏛️",
		source = "wikipedia",
		description = "Intergovernmental forum of Southeast Asian nations",
		tags = { "International organizations", "Governmental organizations" },
		aliases = { "Association of Southeast Asian Nations" },
		summary = "The **Association of Southeast Asian Nations** (**ASEAN**, ) is an [[International organization|intergovernmental forum]] of all 11 states in Southeast Asia. ASEAN primarily focuses on Southeast Asian [[Economic development|economic development]], peaceful coexistence and adherence to international norms. ASEAN operates on the principle of consensus and respecting national [[Sovereignty|sovereignty]], meaning that ASEAN as a whole cannot force another member state to change its domestic laws.",
		sections = {
			{
				"Overview",
				"ASEAN has a population of more than 680 million people and a [[Purchasing power parity|purchasing power parity]]-adjusted gross domestic product (GDP) of around 6.3% global GDP. ASEAN member states represent a diverse set of economies: the [[Least developed countries|least developed countries]] like Laos, to emerging economies like Vietnam, to developed economies like Singapore. Many Southeast Asian projects have originated from decentralised initiatives between member states, such as the ASEAN Power Grid, ASEAN Free Trade Area, ASEAN Integrated QR Code Payment System, or the mutual ASEAN visa-free policies. Every two years, it organises a sporting event to promote cultural exchange known as SEA Games. ASEAN has strong ties with [[East Asia|East Asian]] and [[South Asia|South Asian]] countries. It has a vested interest in the security of the [[South China Sea]] and the greater [[Indo-Pacific]] region.",
			},
		},
		infobox = {
			{ "Languages", "English" },
