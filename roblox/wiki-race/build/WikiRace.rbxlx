		description = "Writing system",
		tags = { "Language", "Writing systems" },
		summary = "The **Arabic script** is the [[Writing system|writing system]] used for [[Arabic]] ([[Arabic alphabet]]) and several other languages of Asia and Africa. It is the second-most widely used [[Alphabet|alphabetic]] writing system in the world (after the [[Latin script]]), the second-most widely used writing system in the world by number of countries using it, and the third-most by number of users (after the Latin and [[Chinese characters|Chinese scripts]]).",
		sections = {
