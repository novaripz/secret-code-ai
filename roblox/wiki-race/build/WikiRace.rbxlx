	{
		title = "Claude Lévi-Strauss",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French anthropologist and ethnologist (1908–2009)",
		tags = { "Social scientists" },
		summary = "**Claude Lévi-Strauss** was a Belgian-born French [[Anthropologist|anthropologist]] and ethnologist whose work was key in the development of the theories of [[Structuralism|structuralism]] and structural anthropology. He held the chair of Social Anthropology at the [[Collège de France]] between 1959 and 1982, was elected a member of the [[Académie Française|Académie française]] in 1973 and was a member of the School for Advanced Studies in the Social Sciences in Paris. He received numerous honors from universities and institutions throughout the world.",
		sections = {
			{
				"Overview",
				'Lévi-Strauss argued that the "savage" mind had the same structures as the "civilized" mind and that human characteristics are the same everywhere. These observations culminated in his famous book Tristes Tropiques (1955) which established his position as one of the central figures in the structuralist school of thought. As well as [[Sociology|sociology]], his ideas reached into many fields in the [[Humanities|humanities]], including [[Philosophy|philosophy]]. Structuralism has been defined as "the search for the underlying patterns of thought in all forms of human activity." He won the 1986 International Nonino Prize in Italy.',
			},
		},
		related = { "Theodor W. Adorno", "Max Weber" },
		infobox = {
			{ "Born", "28 November 1908" },
			{ "Birthplace", "[[Brussels]], Belgium" },
			{ "Died", "30 October 2009" },
			{ "Education", "[[University of Paris]] (DrE, 1948)" },
			{ "Main interests", "[[Anthropology]], [[Society]], [[Linguistics]], [[Kinship]]" },
		},
	},
	{
		title = "Claude Shannon",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American mathematician (1916–2001)",
		tags = { "Mathematicians", "Modern" },
		aliases = { "Claude Elwood Shannon" },
		summary = '**Claude Elwood Shannon** (April 30, 1916 – February 24, 2001) was an American [[Polymath|polymath]] who was a mathematician, electrical engineer, computer scientist, cryptographer, and inventor known as the "father of [[Information theory|information theory]]", and the man who laid the foundations of the [[Information Age]].',
		sections = {
			{
				"Overview",
				'Shannon was among the first to describe the use of Boolean algebra—essential to all digital electronic circuits—and helped found the field of [[Artificial intelligence|artificial intelligence]]. The roboticist Rodney Brooks declared Shannon the 20th century engineer who contributed the most to 21st century technologies, and the mathematician Solomon W. Golomb described his intellectual achievement as "one of the greatest of the twentieth century". At the [[University of Michigan]], Shannon graduated with Bachelor of Science degrees in electrical engineering and mathematics, both in 1936. Called by some the most important master\'s thesis of all time, it is the "birth certificate of the digital revolution", and started him in a lifetime of work that led him to win a Kyoto Prize in 1985.',
			},
		},
		infobox = {
			{ "Born", "30 April 1916" },
			{ "Birthplace", "Petoskey, Michigan, U.S." },
			{ "Died", "24 February 2001" },
