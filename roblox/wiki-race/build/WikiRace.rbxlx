		source = "wikipedia",
		description = "Enthusiastically devoted person",
		tags = { "Entertainment", "Entertainment and leisure" },
		aliases = { "Fan", "Fanatic", "Aficionado" },
		summary = "A **fan** or **fanatic**, sometimes also termed an **aficionado** or **enthusiast**, is a person who exhibits strong interest or admiration for something or somebody, such as a [[Celebrity|celebrity]], a sport, a sports team, a [[Genre|genre]], a politician, a book, a television show, a movie, a video game or an entertainer. Collectively, the fans of a particular object or person constitute its fanbase or [[Fandom|fandom]]. They may show their enthusiasm in a variety of ways, such as by promoting the object of their interest, being members of a related fan club, holding or participating in fan conventions or writing fan mail.",
		sections = {
			{
				"Overview",
