	{
		title = "Syria (region)",
		category = "Geography",
		fame = 1,
		emoji = "🌊",
		source = "wikipedia",
		description = "Region east of the Mediterranean Sea",
		tags = { "More articles" },
		aliases = { "Greater Syria", "Syria-Palestine" },
		summary = '**Syria** ( or Shām), also known as **Greater Syria** or **Syria-Palestine**, is a [[Historical region|historical region]] located east of the [[Mediterranean Sea]] in [[West Asia]], broadly synonymous with the [[Levant]]. Historically, the term "Syria" referred to the area between the Taurus Mountains in the north, [[Sinai Peninsula|Sinai]] in the south-west, and [[Arabian Peninsula|Arabia]] in the south-east; however, in modern times it is used to refer solely to the [[Syria|Syrian Arab Republic]].',
		sections = {
			{
				"Overview",
				"The term is originally derived from [[Assyria]], an ancient Semitic-speaking civilization centered in northern [[Mesopotamia]], modern-day [[Iraq]]. During the [[Hellenistic period]], the term Syria was applied to the entire Levant as Coele-Syria. Under [[Roman Empire|Roman rule]], the term was used to refer to the [[Roman Syria|province of Syria]], later divided into Syria Phoenicia and Coele Syria, and to the province of Syria Palaestina. Under the [[Byzantine Empire|Byzantines]], the provinces of Syria Prima and Syria Secunda emerged out of Coele Syria. After the Muslim conquest of Syria, the term was superseded by the Arabic equivalent Shām, and under the Rashidun, [[Umayyad Caliphate|Umayyad]], [[Abbasid Caliphate|Abbasid]], and [[Fatimid Caliphate|Fatimid caliphates]], Bilad al-Sham was the name of the metropolitan province encompassing most of the region.",
			},
		},
	},
	{
		title = "São Francisco River",
		category = "Geography",
		fame = 3,
		emoji = "🏞️",
		source = "wikipedia",
		description = "River in Brazil",
		tags = { "Rivers", "South America" },
		aliases = { "San Francisco River" },
		summary = "The **São Francisco River**, known in English as the **San Francisco River**, is a large river in Brazil. With a length of 2914 km, it is the longest river that runs entirely in Brazilian territory, and the fourth longest in [[South America]] and overall in Brazil (after the [[Amazon River|Amazon]], the [[Paraná River|Paraná]] and the [[Madeira River|Madeira]]). It is also locally known as the **Velho Chico**, and was once known as the **Opara** by the Indigenous people before colonization.",
		sections = {
			{
				"Overview",
				'The São Francisco originates in the Canastra mountain range in the central-western part of the state of [[Minas Gerais]]. It runs generally north in the states of Minas Gerais and [[Bahia]], behind the coastal range, draining an area of over 630000 km², before turning east to form the border between Bahia on the right bank and the states of Pernambuco and Alagoas on the left one. After that, it ends on the boundaries between the states of Alagoas and Sergipe and washes into the [[Atlantic Ocean]]. In addition to the five states which the São Francisco directly traverses or borders, its [[Drainage basin|drainage basin]] also includes tributaries from the state of Goiás and the Federal District. It is an important river for Brazil, called "the river of national integration" because it unites diverse climates and regions of the country, in particular the Southeast with the Northeast.',
			},
		},
		infobox = {
			{ "Length", "2830 km" },
			{ "Source", "Canastra Mountains" },
			{ "Mouth", "[[Atlantic Ocean]]" },
		},
	},
	{
		title = "São Paulo (state)",
