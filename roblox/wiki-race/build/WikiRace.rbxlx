	{
		title = "Seneca the Younger",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Roman Stoic philosopher, statesman and dramatist (c. 4 BC–AD 65)",
		tags = { "Philosophers", "Ancient" },
		aliases = { "Lucius Annaeus Seneca the Younger", "Seneca" },
		summary = "**Lucius Annaeus Seneca the Younger**, usually known mononymously as **Seneca**, was a [[Stoicism|Stoic]] philosopher of [[Roman Empire|Ancient Rome]], a statesman, a [[Playwright|dramatist]], and in one work, a satirist, from the post-Augustan age of [[Latin literature]].",
		sections = {
			{
				"Overview",
				"Seneca was born in [[Córdoba, Spain|Colonia Patricia Corduba]] in [[Hispania]], and was trained in [[Rhetoric|rhetoric]] and [[Philosophy|philosophy]] in [[Greece]]. His father was Seneca the Elder, his elder brother was Lucius Junius Gallio Annaeanus, and his nephew was the poet Lucan. In AD 41, Seneca was exiled to the island of [[Corsica]] under emperor [[Claudius]], but was allowed to return in 49 to become a tutor to Nero. When Nero became emperor in 54, Seneca became his advisor and, together with the praetorian prefect Sextus Afranius Burrus, provided competent government for the first five years of Nero's reign. As a writer, Seneca is known for his philosophical works, and for his plays, which are all [[Tragedy|tragedies]]. His prose works include 12 essays and 124 letters dealing with moral issues. These writings constitute one of the most important bodies of primary material for ancient [[Stoicism]].",
			},
		},
		related = { "Heraclitus", "Cicero" },
		infobox = {
			{ "Born", "c. 4 BC" },
