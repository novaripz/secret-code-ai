			{ "Occupation", "Author engineer lieutenant USN" },
			{ "Education", "United States Naval Academy [[University of California, Los Angeles]] (incomplete)" },
			{ "Genre", "[[Science fiction]], [[Fantasy|fantasy]]" },
		},
