			},
			{ "Capital", "Palikir" },
			{ "Languages", "[[English language|English]]" },
			{ "People are called", "Micronesian" },
			{ "Established", "May 10, 1979" },
			{ "Area", "702 km²" },
			{ "Population", "75,817" },
		},
