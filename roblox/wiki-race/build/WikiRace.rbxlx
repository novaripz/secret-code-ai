		fame = 2,
		emoji = "🤴",
		source = "wikipedia",
		description = "Monarch of the Kingdom of Hungary (1000–1918)",
		tags = { "More articles" },
		summary = 'The **King of Hungary** was the [[Monarchy|ruling]] [[Head of state|head of state]] of the [[Kingdom of Hungary]] from 1000 (or 1001) to 1918. The style of title "**Apostolic King of Hungary**" (Magyarország apostoli királya) was endorsed by Pope Clement XIII in 1758 and used afterwards by all monarchs of Hungary.',
		infobox = {
			{ "Style", "His Apostolic Majesty" },
