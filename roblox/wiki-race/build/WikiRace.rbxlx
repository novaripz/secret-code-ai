      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Earth</string>
          <string name="Source"><![CDATA[-- Physical geography, continents and weather.
return {
	{
		title = "Earth",
		category = "Geography",
		fame = 1,
		emoji = "🌍",
		tags = { "Planets", "Solar System" },
		aliases = { "The Earth", "Planet Earth", "The World" },
		summary = "**Earth** is the third planet from the [[Sun]] and the only place known to host life. About 71% of its surface is covered by [[Ocean|oceans]].",
		sections = {
			{
				"Structure",
				"Its crust is split into plates whose movement causes [[Earthquake|earthquakes]] and builds mountains like [[Mount Everest]].",
			},
			{
				"Place in space",
				"Earth is part of the [[Solar System]] and is orbited by one natural satellite, the [[Moon]].",
			},
		},
		infobox = { { "Age", "4.54 billion years" }, { "Continents", "7 — see [[Continent]]" } },
		related = { "Weather", "Animal" },
	},
	{
		title = "Continent",
		category = "Geography",
		fame = 2,
		emoji = "🗺️",
		tags = { "Geography terms" },
		aliases = { "Continents" },
		summary = "A **continent** is one of Earth's largest landmasses. The seven continents are [[Asia]], [[Africa]], [[North America]], [[South America]], [[Antarctica]], [[Europe]] and Australia.",
		sections = {
			{
				"Drift",
				"Millions of years ago the continents were joined in one supercontinent called Pangaea, which is why [[Fossil|fossils]] of the same animals appear on different continents.",
			},
		},
		infobox = { { "Count", "7" }, { "Largest", "[[Asia]]" } },
	},
	{
		title = "Asia",
		category = "Geography",
		fame = 1,
		emoji = "🌏",
		tags = { "Continents" },
		summary = "**Asia** is the largest and most populous [[Continent|continent]]. It includes [[China]], [[India]], [[Japan]] and the world's highest peak, [[Mount Everest]].",
		sections = { { "Trade", "The ancient [[Silk Road]] connected Asia with Europe for more than 1,500 years." } },
		infobox = { { "Area", "44.6 million km²" }, { "Highest point", "[[Mount Everest]]" } },
	},
	{
		title = "Africa",
		category = "Geography",
		fame = 1,
		emoji = "🌍",
		tags = { "Continents" },
		summary = "**Africa** is the second-largest [[Continent|continent]]. It contains the world's longest river, the [[Nile]], and its largest hot desert, the [[Sahara]].",
		sections = {
			{ "Wildlife", "Its savannas are home to [[Lion|lions]], [[Elephant|elephants]] and [[Giraffe|giraffes]]." },
			{ "Origins", "Scientists believe the first [[Human|humans]] evolved in Africa." },
		},
		infobox = { { "Countries", "54" }, { "Longest river", "[[Nile]]" } },
		related = { "Kenya" },
	},
	{
		title = "Europe",
		category = "Geography",
		fame = 1,
		emoji = "🏰",
		tags = { "Continents" },
		summary = "**Europe** is a [[Continent|continent]] in the Northern Hemisphere that includes [[France]], [[Germany]], [[Italy]] and the [[United Kingdom]].",
		sections = {
			{
				"History",
				"Europe was the birthplace of [[Ancient Greece]], the [[Roman Empire]] and the [[Industrial Revolution]]. Many of its countries are members of the [[European Union]].",
			},
		},
		infobox = { { "Countries", "44" }, { "Largest city", "Istanbul" } },
	},
	{
		title = "North America",
		category = "Geography",
		fame = 2,
		emoji = "🌎",
		tags = { "Continents" },
		summary = "**North America** is a [[Continent|continent]] made up mostly of [[Canada]], the [[United States]] and [[Mexico]].",
		sections = { { "Nature", "It has the [[Grand Canyon]], the Great Lakes and the Rocky Mountains." } },
		infobox = { { "Largest country", "[[Canada]]" }, { "Largest city", "Mexico City" } },
		related = { "Bigfoot" },
	},
	{
		title = "South America",
		category = "Geography",
		fame = 2,
		emoji = "🌎",
		tags = { "Continents" },
		summary = "**South America** is a [[Continent|continent]] containing [[Brazil]], [[Argentina]], [[Peru]] and nine other countries.",
		sections = {
			{
				"Nature",
				"It has the world's largest rainforest, the [[Amazon rainforest|Amazon]], and the longest mountain range, the [[Andes]].",
			},
		},
		infobox = { { "Countries", "12" }, { "Largest country", "[[Brazil]]" } },
	},
	{
		title = "Antarctica",
		category = "Geography",
		fame = 2,
		emoji = "🧊",
		tags = { "Continents", "Polar regions" },
		summary = "**Antarctica** is Earth's southernmost [[Continent|continent]], almost entirely covered by ice more than 1.9 km thick. It is the coldest, driest and windiest continent.",
		sections = {
			{
				"Life",
				"No people live there permanently, but [[Penguin|penguins]] and seals breed on its coasts. Huge [[Iceberg|icebergs]] break off its ice shelves.",
			},
		},
		infobox = { { "Lowest temperature", "−89.2 °C" }, { "Population", "~1,000–5,000 researchers" } },
	},
	{
		title = "Ocean",
