	{
		title = "Gerolamo Cardano",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Italian Renaissance polymath (1501–1576)",
		tags = { "Mathematicians", "Early modern" },
		summary = "He became one of the most influential mathematicians of the [[Renaissance]] and one of the key figures in the foundation of [[Probability|probability]]; he introduced the binomial coefficients and the binomial theorem in the Western world. He wrote more than 200 works on science.",
		sections = {
			{
				"Overview",
				'Cardano partially invented and described several mechanical devices including the combination lock, the gimbal consisting of three concentric rings allowing a supported [[Compass|compass]] or [[Gyroscope|gyroscope]] to rotate freely, and the Cardan shaft with universal joints, which allows the transmission of rotary motion at various angles and is used in vehicles to this day. He made significant contributions to hypocycloids - published in De proportionibus, in 1570. The generating circles of these hypocycloids, later named "Cardano circles" or "cardanic circles", were used for the construction of the first high-speed [[Printing press|printing presses]]. Today, Cardano is well known for his achievements in [[Algebra|algebra]].',
			},
		},
		related = { "Gottfried Wilhelm Leibniz", "Leonhard Euler" },
