	{
		title = "Skunk",
		category = "Animal",
		fame = 3,
		emoji = "🦨",
		source = "wikipedia",
		description = "Common name of mammals",
		tags = { "Mammals", "Carnivora" },
		aliases = { "Skunks" },
		summary = "**Skunks** are [[New World]] [[Mammal|mammals]] in the family Mephitidae. They are known for their ability to spray a liquid with a strong, unpleasant scent from their anal glands. Different species of skunk vary in appearance from black-and-white to brown, cream or ginger colored, but all have [[Aposematism|warning coloration]].",
		sections = {
			{
				"Overview",
				"While related to polecats and other members of the weasel family, skunks have as their closest relatives the Old World stink badgers.",
