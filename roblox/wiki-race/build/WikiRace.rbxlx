        <Properties>
          <string name="Name">Space</string>
          <string name="Source"><![CDATA[-- Astronomy and space exploration.
return {
	{
		title = "Solar System",
		category = "Space",
		fame = 1,
		emoji = "☀️",
		tags = { "Astronomy" },
		aliases = { "The Solar System" },
		summary = "The **Solar System** is the [[Sun]] and everything that orbits it, including eight planets such as [[Earth]], [[Mars]], [[Jupiter]] and [[Saturn]].",
		sections = {
			{
