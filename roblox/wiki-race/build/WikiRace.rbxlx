		infobox = {
			{ "Spoken in", "Albania Kosovo Greece Italy Montenegro North Macedonia Serbia" },
			{ "Speakers", "7.5 million" },
			{ "Date", "2017" },
			{ "Writing system", "[[Latin script|Latin]] (Albanian alphabet), Albanian Braille" },
		},
