	{
		title = "Goods",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "Things or services that satisfy human wants",
		tags = { "Business and economics" },
		summary = "In [[Economics|economics]], **goods** are anything that is good, usually in the sense that it provides [[Well-being|welfare]] or utility to someone. Goods can be contrasted with **bads**, i.e. things that provide negative value for users, like chores or [[Waste|waste products]]. A bad lowers a consumer's overall welfare.",
		sections = {
			{
				"Overview",
				"Economics focuses on the study of **economic goods**, i.e. goods that are scarce; in other words, producing the good requires expending effort or resources. Economic goods contrast with **free goods** such as [[Atmosphere of Earth|air]], for which there is an unlimited supply. Goods are the result of the secondary sector of the economy which involves the transformation of [[Raw material|raw materials]] or intermediate goods into goods.",
			},
		},
		related = { "Property tax" },
	},
	{
		title = "Goods and services",
		category = "Concept",
		fame = 1,
		emoji = "👥",
		source = "wikipedia",
		description = "Things made and done for people",
		tags = { "More articles" },
		summary = "**Goods** are items that are usually (but not always) tangible, such as pens or [[Pear|pears]]. **Services** are activities provided by other people, such as [[Teacher|teachers]] or barbers. Taken together, it is the [[Production (economics)|production]], distribution, and [[Consumption (economics)|consumption]] of [[Goods|goods]] and [[Service (economics)|services]] which underpins all economic activity and [[Trade|trade]]. According to [[Economics|economic theory]], consumption of goods and services is assumed to provide utility (satisfaction) to the consumer or end-user, although [[Business|businesses]] also consume goods and services in the course of producing their own.",
	},
	{
		title = "Google Books",
