	{
		title = "Hipparchus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Greek astronomer, geographer and mathematician (c. 190 – c. 120 BCE)",
		tags = { "Pre-modern figures", "Ancient history" },
		summary = "**Hipparchus** was a Greek astronomer, [[Geographer|geographer]], and [[Mathematician|mathematician]]. He is considered the founder of [[Trigonometry|trigonometry]], but is most famous for his incidental discovery of the precession of the equinoxes. Hipparchus was born in Nicaea, Bithynia, and probably died on the island of Rhodes, Greece. He is known to have been a working astronomer between 162 and 127 BC.",
		sections = {
			{
				"Overview",
				"Hipparchus is considered the greatest ancient astronomical observer and, by some, the greatest overall astronomer of [[Classical antiquity|antiquity]]. He was the first whose quantitative and accurate models for the motion of the [[Sun]] and [[Moon]] survive. For this he certainly made use of the observations and perhaps the mathematical techniques accumulated over centuries by the [[Babylonia|Babylonians]] and by Meton of Athens (fifth century BC), Timocharis, Aristyllus, Aristarchus of Samos, and [[Eratosthenes]], among others. He developed trigonometry and constructed trigonometric tables, and he solved several problems of spherical trigonometry.",
			},
		},
		infobox = {
			{ "Born", "c. 190 BC" },
			{ "Birthplace", "Nicaea, Kingdom of Bithynia (modern-day İznik, Bursa, Turkey)" },
			{ "Died", "c. 120 BC (around age 70)" },
			{ "Occupation", "[[Astronomer]], [[Mathematician]], [[Geographer]]" },
		},
	},
	{
		title = "Hippocrates",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Ancient Greek physician (c. 460 – c. 370 BCE)",
		tags = { "Pre-modern figures", "Ancient history" },
		aliases = { "Hippocrates of Kos", "Hippocrates II" },
		summary = "**Hippocrates of Kos**, also known as **Hippocrates II,** named after his grandfather Hippocrates I (also Hippocrates of Kos or Hippocrates I of Kos) was a Greek physician and [[Philosophy|philosopher]] of the [[Classical Greece|classical period]] who is considered one of the most outstanding figures in the [[History of medicine|history of medicine]]. His studies set out the basic ideas of modern-day specialties, including surgery, urology, [[Neurology|neurology]], acute medicine and orthopedics, and advanced the systematic study of clinical medicine.",
		sections = {
			{
				"Overview",
				"The Hippocratic school of medicine revolutionized ancient Greek medicine, establishing it as a discipline distinct from other fields with which it had traditionally been associated (theurgy and [[Philosophy|philosophy]]), thus establishing medicine as a profession. Hippocrates is also widely recognized for his contributions to medical ethics, being credited with the Hippocratic Oath that remains in use today. Works associated with Hippocrates, called the Hippocratic Corpus, also summed up the medical knowledge of previous schools, and prescribed acceptable practices for physicians. Nevertheless, very little is known concretely about what Hippocrates himself thought, wrote and did, because his achievements were often conflated with those of the practitioners of Hippocratic medicine and the writers of the Hippocratic Corpus.",
			},
		},
		related = { "Hypatia" },
		infobox = {
