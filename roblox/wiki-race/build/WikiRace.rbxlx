	{
		title = "Bertrand Russell",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English philosopher and logician (1872–1970)",
		tags = { "Philosophers", "Modern" },
		aliases = { "Bertrand Arthur William Russell, 3rd Earl Russell" },
		summary = "**Bertrand Arthur William Russell, 3rd Earl Russell** (18 May 1872 – 2 February 1970), was an English [[Philosophy|philosopher]], [[Logic|logician]], and social reformer.",
		sections = {
			{
				"Overview",
				'Russell was born into the prominent Russell family, to Viscount and Viscountess Amberley. He was orphaned at the age of four and moved into Pembroke Lodge to live with his grandparents, the Earl and Countess Russell. The Earl Russell had twice been Prime Minister of the United Kingdom (1846–1852; 1865–1866) and died in 1878, leaving Russell in the care of his grandmother. He won a scholarship to [[Trinity College, Cambridge]], in 1890 and graduated in 1893 with a [[Bachelor of Arts]]. At Cambridge, Russell was introduced to philosophy through figures such as G. E. Moore and [[Alfred North Whitehead]]. Russell also came to oppose British idealism and led the "revolt against idealism" with Moore.',
			},
		},
		related = { "Marshall McLuhan" },
		infobox = {
