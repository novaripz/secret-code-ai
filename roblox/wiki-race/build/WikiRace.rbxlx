	{
		title = "Art music",
		category = "Music",
		fame = 2,
		emoji = "🎵",
		source = "wikipedia",
		description = "Serious music, as opposed to popular or folk music",
		tags = { "More articles" },
		aliases = { "Cultivated music", "Serious music", "Canonic music" },
		summary = '**Art music** (alternatively called **[[Classical music|classical music]]**, **cultivated music**, **serious music**, and **canonic music**) is music considered to be of [[High culture|high phonoaesthetic value]]. It typically implies advanced structural and theoretical considerations or a written musical tradition. In this context, the terms "serious" or "cultivated" are frequently used to present a contrast with ordinary, everyday music (i.e. [[Popular music|popular]] and [[Folk music|folk music]], also called "vernacular music"). Many cultures have art music traditions; in the [[Western world]], the term typically refers to Western classical music.',
		related = { "Performance" },
	},
	{
		title = "Art rock",
		category = "Music",
		fame = 2,
		emoji = "🪨",
		source = "wikipedia",
		description = "Subgenre of rock music",
		tags = { "More articles" },
		summary = '**Art rock** is [[Rock music|rock music]] that aims to distinguish the genre from popular entertainment, with the term typically being applied as the middle ground between mainstream and experimental rock. Art rock primarily draws influences from the wider art world and [[Academic art|academia]]; which includes [[Contemporary art|contemporary art]], [[Art music|art music]], [[Avant-garde|avant-garde art]], [[Experimental music|experimental music]], [[Avant-garde music|avant-garde music]], alongside [[Classical music|classical music]] and [[Jazz|jazz]]. The term is sometimes deployed interchangeably with "[[Progressive rock|progressive rock]]" and to refer to some experimental rock acts.',
		sections = {
			{
				"Overview",
				'Critics have defined art rock as a "rejection" of rock music intended solely for the purpose of popular entertainment or [[Dance music|dancing]]. The term was closely associated with a specific period beginning over 1966 and 1967. Its usage waned after the late-1970s while elements of the style were infused into various popular music genres through the 1990s.',
			},
