		aliases = { "Fernando de Noronha time", "Brasília time", "Amazon time" },
		summary = "**Time in Brazil** is calculated using standard time, and the country (including its offshore islands) is divided into four standard [[Time zone|time zones]]: **Fernando de Noronha time** (UTC−02:00), **Brasília time** (UTC−03:00), **Amazon time** (UTC−04:00), and **Acre time** (UTC−05:00). About 93% of the Brazilian population live in Brasília time (UTC−03:00).",
		related = { "Terrestrial animal", "Filter feeder" },
