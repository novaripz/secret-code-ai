	border = rgb(225, 225, 225),
	text = rgb(17, 17, 17),
	textDim = rgb(90, 90, 90),
	textFaint = rgb(140, 140, 140),
	accent = rgb(17, 17, 17),
	accent2 = rgb(80, 80, 80),
