		tags = { "Lakes", "Europe" },
		summary = "**Lake Onega** is a lake in northwestern [[Russia]], on the territory of the Republic of Karelia, Leningrad Oblast and Vologda Oblast. It belongs to the basin of the [[Baltic Sea]], and is the second-largest lake in Europe after [[Lake Ladoga]], slightly smaller than [[Lebanon]]. The lake is fed by about 50 rivers and is drained by the Svir.",
		sections = {
			{
				"Overview",
