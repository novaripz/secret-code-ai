		category = "Animal",
		fame = 2,
		emoji = "🐾",
		source = "wikipedia",
		description = "IUCN conservation category",
		tags = { "More articles" },
		summary = "A **threatened species** is any [[Species|species]] (including [[Animal|animals]], [[Plant|plants]] and [[Mushroom|fungi]]) which is vulnerable to [[Extinction|extinction]] in the near future. Species that are threatened are sometimes characterised by the population dynamics measure of critical depensation, a mathematical measure of biomass related to population growth rate. This quantitative metric is one method of evaluating the degree of endangerment without direct reference to human activity.",
		related = { "European University Association" },
