	{
		title = "The Catcher in the Rye",
		category = "Book",
		fame = 3,
		emoji = "📖",
		source = "wikipedia",
		description = "1951 American novel by J. D. Salinger",
		tags = { "Specific works of fiction", "Fiction of modern era" },
		summary = "**The Catcher in the Rye** is a 1951 American coming-of-age [[Book|novel]] by American author J. D. Salinger. It was partially published in serial form in 1945–1946 before being novelized in 1951.",
		sections = {
			{
				"Overview",
				"Originally intended for adults, it is often read by adolescents for its themes of [[Angst|angst]] and alienation, and as a critique of superficiality in society. The main character, Holden Caulfield, has become an icon for teenage rebellion. Caulfield, nearly of age, gives his opinion on a wide variety of topics as he narrates his recent life events. The Catcher in the Rye has been translated widely. About one million copies are sold each year, with total sales of more than 65 million books. The novel was included on [[Time (magazine)|Time]]'s 2005 list of the 100 best English-language novels written since 1923, and it was named by [[Modern Library]] and its readers as one of the 100 best English-language novels of the 20th century. In 2003, it was listed at number 15 on the BBC's survey \"[[The Big Read]]\".",
			},
		},
		related = { "The Hunchback of Notre-Dame", "One Hundred Years of Solitude" },
