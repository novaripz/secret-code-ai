	{
		title = "Rosaceae",
		category = "Plant",
		fame = 2,
		emoji = "🌹",
		source = "wikipedia",
		description = "Rose family of flowering plants",
		tags = { "Eudicots", "Rosales" },
		aliases = { "Rose family" },
		summary = "**Rosaceae**, the **rose family**, is a [[Family (taxonomy)|family]] of [[Flowering plant|flowering plants]] that includes 4,828 known species in 91 [[Genus|genera]].",
		sections = {
			{
				"Overview",
				"The name is derived from the [[Type genus|type genus]] [[Rose|Rosa]]. The family includes herbs, shrubs, and trees. Most species are [[Deciduous|deciduous]], but some are [[Evergreen|evergreen]]. They have a worldwide range but are most diverse in the [[Northern Hemisphere]]. Many economically important products come from the Rosaceae, including various edible fruits, such as [[Apple|apples]], [[Pear|pears]], quinces, [[Apricot|apricots]], [[Plum|plums]], [[Cherry|cherries]], [[Peach|peaches]], raspberries, [[Blackberry|blackberries]], loquats, strawberries, rose hips, hawthorns, and almonds. The family also includes popular ornamental trees and shrubs, such as [[Rose|roses]], meadowsweets, rowans, firethorns, and photinias. Among the most species-rich genera in the family are Alchemilla (270), Sorbus (260), Crataegus (260), Cotoneaster (260), Rubus (250), and Prunus (340), which contains the [[Plum|plums]], cherries, [[Peach|peaches]], [[Apricot|apricots]], and [[Almond|almonds]]. However, all of these numbers should be seen as estimates—much taxonomic work remains.",
			},
		},
		related = { "Elm" },
		infobox = {
			{ "Scientific name", "Rosaceae" },
		},
	},
	{
		title = "Rubiaceae",
		category = "Plant",
		fame = 3,
		emoji = "👪",
		source = "wikipedia",
		description = "Family of flowering plants",
		tags = { "Eudicots", "Others" },
		aliases = { "Madder", "Bedstraw family" },
		summary = "**Rubiaceae** is a [[Family (taxonomy)|family]] of [[Flowering plant|flowering plants]], commonly known as the **coffee**, **madder**, or **bedstraw family**. It consists of terrestrial trees, shrubs, lianas, or herbs that are recognizable by simple, opposite leaves with interpetiolar stipules and sympetalous actinomorphic flowers. The family contains about 14,200 [[Species|species]] in about 615 [[Genus|genera]], which makes it the fourth-largest [[Flowering plant|angiosperm]] family by number of species. Rubiaceae has a [[Cosmopolitan distribution|cosmopolitan distribution]]; however, the largest species diversity is concentrated in the [[Tropics|tropics]] and [[Subtropics|subtropics]].",
		sections = {
			{
				"Overview",
				"Economically important genera include Coffea, the source of [[Coffee|coffee]]; Cinchona, the source of the antimalarial alkaloid quinine; ornamental cultivars (e.g., [[Gardenia]], Ixora, Pentas); and historically some dye plants (e.g., Rubia).",
