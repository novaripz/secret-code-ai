			{ "Died", "8 December 1980" },
			{ "Education", "Liverpool College of Art" },
			{ "Occupation", "Singer, songwriter, musician, author, artist, peace activist" },
			{ "Years active", "1956–1980" },
		},
	},
	{
		title = "John Williams",
		category = "Musician",
		fame = 1,
		emoji = "🎤",
		source = "wikipedia",
		description = "American composer and conductor (born 1932)",
		tags = { "Composers", "20th century modern" },
		aliases = { "John Towner Williams" },
		summary = "**John Towner Williams** is an American [[Composer|composer]] and [[Conducting|conductor]]. Over his seven-decade career, he has composed many of the best known [[Film score|scores]] in film history. His style blends [[Romantic music|romanticism]] and impressionism with complex [[Orchestration|orchestration]]. Best known for his collaborations with [[George Lucas]] and [[Steven Spielberg]], he has received numerous accolades, including 27 Grammy Awards, five [[Academy Awards]], seven BAFTA Awards, three Emmy Awards and four Golden Globe Awards. With a total of 54 Academy Award nominations, he is the second-most nominated person in the award's history, after [[Walt Disney]]. He is also the oldest Academy Award nominee in any category, receiving a nomination at 91 years old.",
		sections = {
			{
				"Overview",
				"Williams's early work as a film composer includes None but the Brave (1965), Valley of the Dolls (1967), Goodbye, Mr. Chips (1969), Images (1972), The Long Goodbye (1973) and The Towering Inferno (1974). His work with Spielberg began on The Sugarland Express (1974), and he has composed music for all but five of his feature films. He received Academy Awards for Fiddler on the Roof (1971; arrangement of the original score by Jerry Bock), Jaws (1975), Star Wars (1977), E.T. the Extra-Terrestrial (1982) and Schindler's List (1993). Other memorable collaborations with Spielberg include Close Encounters of the Third Kind (1977), Raiders of the Lost Ark (1981), [[Jurassic Park]] (1993), Saving Private Ryan (1998), Catch Me If You Can (2002), Lincoln (2012) and The Fabelmans (2022).",
			},
		},
		related = { "Aaron Copland", "Benjamin Britten", "Dmitri Shostakovich", "George Gershwin", "Sergei Prokofiev" },
		infobox = {
			{ "Born", "8 February 1932" },
			{ "Birthplace", "New York City, U.S." },
			{ "Occupation", "Composer, conductor, orchestrator, arranger" },
			{ "Years active", "1952–present" },
		},
