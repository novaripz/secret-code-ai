	{
		title = "H II region",
		category = "Space",
		fame = 2,
		emoji = "☁️",
		source = "wikipedia",
		description = "Large, low-density interstellar cloud of partially ionized gas",
		tags = { "Astronomy", "Basics" },
		summary = "An **H II region** is a region of interstellar atomic hydrogen that is ionized. It is typically in a [[Molecular cloud|molecular cloud]] of partially ionized [[Gas|gas]] in which [[Star formation|star formation]] has recently taken place, with a size ranging from one to hundreds of light years, and density from a few to about a million particles per cubic centimetre. The [[Orion Nebula]], now known to be an H II region, was observed in 1610 by Nicolas-Claude Fabri de Peiresc by telescope, the first such object discovered.",
		sections = {
			{
				"Overview",
				"The regions may be of any shape because the distribution of the stars and gas inside them is irregular. [[Hertzsprung–Russell diagram|The short-lived blue stars]] created in these regions emit copious amounts of [[Ultraviolet|ultraviolet]] light that ionize the surrounding gas. H II regions—sometimes several hundred [[Light-year|light-years]] across—are often associated with giant molecular clouds. They often appear clumpy and filamentary, sometimes showing intricate shapes such as the [[Horsehead Nebula]]. H II regions may give birth to thousands of stars over a period of several million years. [[Supernova]] explosions and strong [[Stellar wind|stellar winds]] from the most massive stars in the resulting [[Star cluster|star cluster]] ultimately disperse the remaining gas of the H II region.",
			},
		},
	},
	{
		title = "Hertzsprung–Russell diagram",
		category = "Space",
		fame = 2,
		emoji = "✨",
		source = "wikipedia",
		description = "Scatter plot of stars showing the relationship of luminosity to stellar classification",
		tags = { "Astronomy", "Stellar astronomy" },
		aliases = { "H–R diagram", "HR diagram", "HRD" },
		summary = "A **Hertzsprung–Russell diagram** (abbreviated as **H–R diagram**, **HR diagram** or **HRD**) is a scatter plot of [[Star|stars]] showing the relationship between the stars' [[Absolute magnitude|absolute magnitudes]] or [[Luminosity|luminosities]] and their [[Stellar classification|stellar classifications]] or [[Effective temperature|effective temperatures]]. It is also sometimes called a **color magnitude diagram**. The diagram was created independently in 1911 by Ejnar Hertzsprung and by Henry Norris Russell in 1913, and represented a major step towards an understanding of [[Stellar evolution|stellar evolution]].",
	},
	{
		title = "Horizon",
		category = "Space",
		fame = 2,
		emoji = "🌍",
		source = "wikipedia",
		description = "Apparent curve that separates earth from sky",
		tags = { "Celestial mechanics and astrometry", "Celestial sphere" },
		summary = "Most commonly, the **horizon** is the border between the surface of a celestial body and its [[Sky|sky]] when viewed from the perspective of an observer on or above the surface of the celestial body. This concept is further refined as:",
		sections = {
			{
				"Overview",
				'The **true** or **geometric** horizon, which an observer would see if there was no alteration from refraction or from obstruction by intervening objects. The geometric horizon assumes a spherical earth. The true horizon takes into account the fact that the earth is an irregular ellipsoid. When refraction is minimal, the visible **sea** or **ocean** horizon is the closest an observer can get to seeing the true horizon. The **refracted** or **apparent** horizon, which is the true horizon viewed through atmospheric refraction. Refraction can make distant objects seem higher or, less often, lower than they actually are. An unusually large refraction may cause a distant object to appear ("loom") above the refracted horizon or disappear ("sink") below it. The **visible** horizon, which is the refracted horizon obscured by [[Terrain|terrain]] and, on Earth, by life forms such as trees and/or human constructs such as buildings.',
			},
		},
	},
