		summary = "The **farad** (symbol: **F**) is the unit of electrical [[Capacitance|capacitance]], the ability of a body to store an electrical charge, in the [[International System of Units|International System of Units (SI)]], equivalent to 1 [[Coulomb|coulomb]] per [[Volt|volt]] (C/V). It is named after the English physicist [[Michael Faraday]] (1791–1867). In SI base units 1 F = 1 [[Kilogram|kg]]−1⋅m−2⋅[[Second|s]]4⋅[[Ampere|A]]2.",
		infobox = {
