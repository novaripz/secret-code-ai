	{
		title = "Lope de Vega",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "Spanish playwright and poet (1562–1635)",
		tags = { "Early modern", "Europe" },
		aliases = { "Félix Lope de Vega y Carpio" },
		summary = "**Félix Lope de Vega y Carpio** was a Spanish playwright, poet, and novelist who was a key figure in the [[Spanish Golden Age]] (1492–1659) of Baroque literature. In the literature of Spain, Lope de Vega is often considered second only to [[Miguel de Cervantes]]. Cervantes said that Lope de Vega was “The Phoenix of Wits” (Fénix de los ingenios) and “Monster of Nature” (Monstruo de naturaleza).",
		sections = {
			{
				"Overview",
				"Lope de Vega renewed the literary life of Spanish theatre when it became mass culture, and with the playwrights [[Pedro Calderón de la Barca]] and Tirso de Molina defined the characteristics of Spanish Baroque theatre with great insight into the human condition. The literary production of Lope de Vega includes 3,000 [[Sonnet|sonnets]], three novels, four [[Novella|novellas]], nine [[Epic poetry|epic poems]], and approximately 500 [[Play (theatre)|stageplays]]. Personally and professionally, Lope de Vega was friend to the writer Francisco de Quevedo and arch-enemy of the dramatist Juan Ruiz de Alarcón. The volume of literary works produced by Lope de Vega earned him the envy of his contemporaries, such as Cervantes and Luis de Góngora, and the admiration of [[Johann Wolfgang von Goethe]] for such a vast and colourful oeuvre.",
			},
		},
		related = { "Enheduanna", "Luís de Camões", "Mirabai" },
		infobox = {
			{ "Born", "25 November 1562" },
			{ "Birthplace", "[[Madrid]], [[Crown of Castile|Castile]]" },
			{ "Died", "27 August 1635" },
			{ "Occupation", "Poet, playwright, novelist" },
			{ "Language", "[[Spanish language|Spanish]]" },
			{ "Movement", "Baroque" },
		},
