			{ "Birthplace", "Kath, Khwarezm (modern-day [[Uzbekistan]])" },
			{ "Died", "c. 1050 (aged 77)" },
			{ "Era", "[[Islamic Golden Age]]" },
			{ "Region", "Khwarezm, Central Asia Buyid dynasty (Rey), [[Ghaznavid Empire|Ghaznavid dynasty]] (Ghazni)" },
