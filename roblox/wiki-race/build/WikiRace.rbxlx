return {
	{
		title = "Feeling",
		category = "Concept",
		fame = 1,
		emoji = "😊",
		source = "wikipedia",
		description = "Conscious subjective experience of emotion",
		tags = { "Psychology", "Concepts" },
		summary = 'According to the [[American Psychological Association|APA]] Dictionary of Psychology, a **feeling** is "a self-contained phenomenal [[Experience|experience]]"; feelings are "subjective, evaluative, and independent of the sensations, thoughts, or images evoking them". The term feeling is closely related to, but not the same as, [[Emotion|emotion]]. Feeling may, for instance, refer to the conscious subjective experience of emotions. The study of subjective experiences is called [[Phenomenology (philosophy)|phenomenology]]. [[Psychotherapy]] generally involves a therapist helping a client understand, articulate, and learn to effectively regulate the client\'s own feelings, and ultimately to take responsibility for the client\'s experience of the world.',
		sections = {
			{
				"Overview",
				"Feelings are sometimes held to be characteristic of embodied consciousness. The English noun feelings may generally refer to any degree of subjectivity in perception or sensation. However, feelings often refer to an individual sense of [[Well-being|well-being]] (perhaps of wholeness, safety, or being loved). Feelings have a semantic field extending from the individual and spiritual to the social and political. The word feeling may refer to any of a number of psychological characteristics of experience, or even to reflect the entire inner life of the individual (see [[Mood (psychology)|mood]]). As self-contained phenomenal experiences, evoked by sensations and perceptions, feelings can strongly influence the character of a person's subjective reality. Feelings can sometimes harbor bias or otherwise distort veridical perception, in particular through projection, wishful thinking, among many other such effects.",
			},
		},
	},
	{
		title = "Fellow of the Royal Society",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Award by the Royal Society of London",
		tags = { "More articles" },
		aliases = { "Fellowship of the Royal Society", "FRS", "ForMemRS" },
		summary = '**Fellowship of the Royal Society** (**FRS**, **ForMemRS** and **HonFRS**) is an award granted by the Fellows of the [[Royal Society]] of London to individuals who have made a "substantial contribution to the improvement of [[Natural science|natural knowledge]], including [[Mathematics|mathematics]], engineering science, and medical science".',
		related = { "Lexico" },
		infobox = {
			{ "Date", "1663" },
			{ "Location", "[[London]]" },
			{ "Country", "United Kingdom" },
		},
	},
	{
		title = "Feminism",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Range of socio-political movements and ideologies",
		tags = { "Society", "Social status" },
		summary = "**Feminism** is a range of socio-political movements and [[Ideology|ideologies]] that aim to define and establish the political, economic, personal, and social [[Gender equality|equality of the sexes]]. Feminism holds the position that modern societies are patriarchal—they prioritize the male point of view—and that women are treated unjustly in these societies. Efforts to change this include fighting against gender stereotypes, breaking down traditional gender roles, and improving educational, professional, and interpersonal opportunities and outcomes for women. A person who advocates for feminism is known as a **feminist**.",
		sections = {
			{
				"Overview",
				"Originating in late 18th-century Europe, feminist movements have campaigned and continue to campaign for [[Women's rights|women's rights]], including the right to [[Women's suffrage|vote]], run for public office, work, earn equal pay, own property, receive education, enter into [[Contract|contracts]], have equal rights within [[Marriage|marriage]], and maternity leave. Changes in female dress standards and acceptable physical activities for women have also been part of feminist movements. Many scholars consider feminist campaigns to be a main force behind major historical [[Social change|societal changes]] for women's rights, particularly in [[Western world|the West]], where they are near-universally credited with achieving [[Women's suffrage|women's suffrage]], gender-neutral language, reproductive rights for women (including access to contraceptives and abortion), and the right to enter into contracts and own property.",
			},
		},
	},
	{
		title = "Fertilisation",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		tags = { "More articles" },
		aliases = { "Generative fertilisation", "Syngamy", "Impregnation", "Fertilization" },
		summary = "**Fertilisation** or **fertilization** (see [[American and British English spelling differences|spelling differences]]), also known as **generative fertilisation**, **syngamy** and **impregnation**, is the fusion of gametes to give rise to a [[Zygote|zygote]] and initiate its development into a new individual organism or offspring. While processes such as insemination or [[Pollination|pollination]], which happen before the fusion of gametes, are also sometimes informally referred to as fertilisation, these are technically separate processes. During double fertilisation in angiosperms, the haploid male gamete combines with two haploid polar nuclei to form a triploid primary endosperm nucleus by the process of vegetative fertilisation.",
		related = { "Geographic Names Information System" },
	},
	{
		title = "Fiberglass",
		category = "Concept",
		fame = 2,
		emoji = "♻️",
		source = "wikipedia",
		description = "Type of plastic reinforced by glass fiber",
		tags = { "More articles" },
		aliases = { "Fibreglass" },
		summary = "**Fiberglass** ([[American English]]) or **fibreglass** ([[English in the Commonwealth of Nations|Commonwealth English]]) is a common type of fiber-reinforced plastic using glass fiber. The fibers may be randomly arranged, flattened into a sheet called a chopped strand mat, or woven into glass cloth. The [[Plastic|plastic]] matrix may be a thermoset polymer matrix—most often based on thermosetting polymers such as epoxy, polyester resin, or vinyl ester resin—or a thermoplastic.",
		sections = {
			{
				"Overview",
				'Cheaper and more flexible than carbon fiber, it is stronger than many metals by weight, non-magnetic, non-conductive, transparent to [[Electromagnetic radiation|electromagnetic radiation]], can be molded into complex shapes, and is chemically inert under many circumstances. Applications include aircraft, boats, automobiles, bath tubs and enclosures, swimming pools, hot tubs, septic tanks, water tanks, roofing, pipes, cladding, orthopedic casts, surfboards, and external door skins. Other common names for fiberglass are **glass-reinforced plastic** (**GRP**), **glass-fiber reinforced plastic** (**GFRP**) or **GFK** (from ). Because glass fiber itself is sometimes referred to as "fiberglass", the composite is also called **fiberglass-reinforced plastic** (**FRP**). This article uses "fiberglass" to refer to the complete fiber-reinforced composite material, rather than only to the glass fiber within it.',
			},
		},
		infobox = {
			{ "Category", "Composite material" },
			{ "Type", "Fiber-reinforced plastic" },
			{ "Invented", "1932" },
			{ "Inventor", "Games Slayter (Owens-Illinois)" },
		},
	},
	{
		title = "Figurine",
		category = "Concept",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Small item resembling something, usually a person",
		tags = { "More articles" },
		aliases = { "Statuette" },
		summary = "A **figurine** (a diminutive form of the word figure) or **statuette** is a small, three-dimensional [[Sculpture|sculpture]] that represents a human, deity or animal, or, in practice, a pair or small group of them. Figurines have been made in many media, with [[Clay|clay]], metal, wood, glass, and today plastic or resin the most significant. Ceramic figurines not made of [[Porcelain|porcelain]] are called terracottas in historical contexts.",
		sections = {
			{
				"Overview",
				'Figures with movable parts, allowing limbs to be posed, are more likely to be called [[Doll|dolls]], mannequins, or [[Action figure|action figures]]; or [[Robot|robots]] or automata, if they can move on their own. Figurines and miniatures are sometimes used in [[Board game|board games]], such as [[Chess|chess]], and tabletop [[Role-playing game|role playing games]]. The main difference between a figurine and a [[Sculpture|statue]] is size. There is no agreed limit, but typically objects are called "figurines" up to a height of perhaps 2 ft, though most types are less than 1 ft high.',
			},
		},
	},
	{
		title = "Filipino language",
		category = "Concept",
		fame = 2,
		emoji = "🗣️",
		source = "wikipedia",
		description = "National language of the Philippines",
		tags = { "More articles" },
		aliases = { "Filipino" },
		summary = "**Filipino** is the [[National language|national language]] of the [[Philippines]], the main [[Lingua franca|lingua franca]], and one of the two [[Official language|official languages]] of the country, along with English. It is a [[De facto and de jure|de facto]] [[Standard language|standardized form]] of the [[Tagalog language]], as spoken and written in Metro Manila and in other urban centers of the archipelago. The 1987 Constitution mandates that Filipino be further enriched and developed by the other languages of the Philippines. This constitutional framework reflects an effort to develop the national language while recognizing the contribution of the Philippines' many regional languages.",
		related = { "Greenwood Publishing Group" },
		infobox = {
			{ "Spoken in", "[[Philippines]]" },
			{ "Writing system", "[[Latin script|Latin]] (Filipino alphabet) Philippine Braille" },
