	{
		title = "Georges-Eugène Haussmann",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French official who renovated Paris (1809–1891)",
		tags = { "Other visual arts", "Urban planners and landscape architects" },
		aliases = { "Baron Haussmann" },
		summary = "**Georges-Eugène Haussmann**, known as **Baron Haussmann**, was a French official who supervised a radical urban renewal programme of new boulevards, parks, and public works in Paris, referred to as Haussmann's renovation of Paris, aimed at introducing grandeur in the city. First a prefect in Var (1849–1850), Yonne (1850–1851), and Gironde (1851–1853), his skills as an administrator led to his appointment in Paris by Emperor [[Napoleon III]] in 1853.",
		sections = {
			{
				"Overview",
				"The signature architectural landmark of his works was the Paris Opera, the largest theatre in the world, designed by Charles Garnier, crowning the centre of Napoleon III's new Paris. Haussmann completely rebuilt Paris above and below ground; on his own estimation by 1870 one in five streets in central Paris were his creation, while revamped sewers now ran alongside miles of pipes to distribute gas for thousands of new streetlights. With his right-hand Adolphe Alphand and at the Emperor's direction, a plan was laid out for four major parks at the cardinal points of the compass around the city: the Bois de Boulogne to the west, Bois de Vincennes to the east, Parc des Buttes Chaumont to the north, and Parc Montsouris to the south. The major parks and their smaller counterparts in the city were an immediate success with all classes of Parisians.",
			},
		},
		related = { "Antonio Stradivari", "Frederick Law Olmsted", "Raymond Loewy" },
		infobox = {
			{ "Born", "27 March 1809" },
			{ "Birthplace", "[[Paris]], France" },
			{ "Died", "11 January 1891" },
			{ "Education", "[[Conservatoire de Paris]]" },
		},
	},
	{
		title = "Georgia O'Keeffe",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American modernist artist (1887–1986)",
		tags = { "Western painters and illustrators", "Modern era" },
		aliases = { "Georgia Totto O'Keeffe" },
		summary = '**Georgia Totto O\'Keeffe** (November 15, 1887 – March 6, 1986) was an American [[Modernism|modernist]] painter and draftswoman whose career spanned seven decades and whose work remained largely independent of major [[Art movement|art movements]]. Called the "Mother of American modernism", O\'Keeffe gained international recognition for her paintings of natural forms, particularly flowers, hills and desert-inspired landscapes, which were often drawn from and related to places and environments in which she lived. Although she was a figure associated with interpretations regarding feminism, she did not want to be seen as a "woman artist", she wanted to be seen as an artist.',
		sections = {
			{
				"Overview",
				"From 1905, when O'Keeffe began her studies at the School of the Art Institute of Chicago, until about 1920, she studied art or earned money as a commercial illustrator or teacher to pay for further education. Influenced by Arthur Wesley Dow, she began to develop her unique style through her [[Watercolor painting|watercolors]] during her studies at the University of Virginia and, more dramatically, through the charcoal drawings she produced in 1915 that marked her move toward abstraction. Alfred Stieglitz, an art dealer and photographer, held an exhibit of her works in 1916. Over the next couple of years, she taught and continued her studies at the Teachers College, Columbia University. In June of 1918 O’Keeffe was invited by Stieglitz to live and work in New York City and accepted this invitation as well as his offer to underwrite her year of painting in the city.",
			},
		},
		related = { "Jean-Auguste-Dominique Ingres", "Henri Matisse" },
		infobox = {
