		source = "wikipedia",
		description = "Recreational activity and sport using snow skis",
		tags = { "Sports", "Other individual sports" },
		summary = "**Skiing** is the use of skis to glide on [[Snow|snow]] for basic transport, a recreational activity, or a competitive [[Winter sports|winter sport]]. Many types of competitive skiing events are recognized by the [[International Olympic Committee]] (IOC), and the International Ski and Snowboard Federation (FIS).",
