			{ "Died", "4 January 1960" },
			{ "Education", "University of Algiers" },
			{ "Notable works", "The Stranger / The Outsider The Myth of Sisyphus The Rebel The Plague" },
			{ "Known for", "Absurdism" },
		},
	},
	{
		title = "Albert Ellis",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American psychologist (1913–2007)",
		tags = { "Psychologists" },
		summary = "**Albert Ellis** (September 27, 1913 – July 24, 2007) was an American [[Psychologist|psychologist]] and [[Psychotherapy|psychotherapist]] who founded rational emotive behavior therapy (REBT). He held MA and PhD degrees in [[Clinical psychology|clinical psychology]] from [[Columbia University]], and was certified by the American Board of Professional Psychology (ABPP). He also founded, and was the President of, the New York City-based Albert Ellis Institute. He is generally considered to be one of the originators of the cognitive revolutionary paradigm shift in [[Psychotherapy|psychotherapy]] and an early proponent and developer of cognitive-behavioral therapies.",
		sections = {
			{
				"Overview",
				'Based on a 1982 professional survey of American and Canadian psychologists, he was considered the second most influential psychotherapist in history ([[Carl Rogers]] ranked first in the survey; [[Sigmund Freud]] was ranked third). Psychology Today noted that, "No individual—not even Freud himself—has had a greater impact on modern psychotherapy."',
			},
