	{
		title = "Auguste Comte",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French philosopher, mathematician and sociologist (1798–1857)",
		tags = { "Philosophers", "Modern" },
		aliases = { "Isidore Auguste Marie François Xavier Comte" },
		summary = "**Isidore Auguste Marie François Xavier Comte** was a French philosopher and writer who formulated the doctrine of [[Positivism|positivism]]. He is often regarded as the first [[Philosophy of science|philosopher of science]] in the [[Modernity|modern sense]] of the term. Comte's ideas were fundamental to the development of [[Sociology|sociology]], as he coined the term and treated the discipline as the crowning achievement of the sciences.",
		sections = {
			{
				"Overview",
				"Influenced by Henri de Saint-Simon, Comte's work attempted to remedy the social disorder caused by the [[French Revolution]], which he believed indicated an imminent transition to a new form of society. He sought to establish a new [[Social theory|social doctrine]] based on science, which he labeled positivism. He had a major impact on 19th-century thought, influencing the work of social thinkers such as [[John Stuart Mill]] and [[George Eliot]]. His concept of Sociology and social evolutionism set the tone for early social theorists and [[Anthropologist|anthropologists]] such as Harriet Martineau and [[Herbert Spencer]], evolving into modern academic sociology presented by [[Émile Durkheim]] as practical and objective [[Social research|social research]]. Comte's social theories culminated in his \"Religion of Humanity\", which presaged the development of non-theistic religious humanist and secular humanist organizations in the 19th century.",
			},
		},
		related = { "Marshall McLuhan" },
		infobox = {
			{ "Region", "[[Western philosophy]] French philosophy" },
			{ "Era", "[[19th-century philosophy]]" },
			{ "Born", "19 January 1798" },
			{ "Birthplace", "Montpellier, French First Republic" },
			{ "Died", "5 September 1857" },
			{ "Education", "University of Montpellier, [[École polytechnique|École Polytechnique]]" },
			{ "Worked at", "École Polytechnique" },
		},
	},
	{
		title = "Auguste Rodin",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French sculptor (1840–1917)",
		tags = { "Other visual arts", "Sculptors" },
		aliases = { "François Auguste René Rodin" },
		summary = "**François Auguste René Rodin** was a French sculptor generally considered the founder of modern sculpture. He was schooled traditionally and took a craftsman-like approach to his work. Rodin possessed a unique ability to model a complex, turbulent, and deeply pocketed surface in [[Clay|clay]].",
		sections = {
			{
				"Overview",
				"Many of Rodin's most notable sculptures were criticized, as they clashed with predominant figurative sculpture traditions in which works were decorative, formulaic, or highly thematic. Rodin's most original work departed from traditional themes of mythology and [[Allegory|allegory]]. He modeled the human body with naturalism, and his sculptures celebrate individual character and physicality. Although Rodin was sensitive to the controversy surrounding his work, he refused to change his style, and his continued output brought increasing favor from the government and the artistic community. From the unexpected naturalism of Rodin's first major figure – inspired by his 1875 trip to Italy – to the unconventional memorials whose commissions he later sought, his reputation grew, and Rodin became the preeminent French sculptor of his time. By 1900, he was a world-renowned artist.",
			},
		},
		related = { "Marcel Duchamp", "Gian Lorenzo Bernini" },
		infobox = {
			{ "Born", "12 November 1840" },
			{ "Birthplace", "[[Paris]], France" },
			{ "Died", "17 November 1917" },
			{ "Field", "Sculpture and drawing" },
			{ "Education", "École nationale supérieure des arts décoratifs" },
		},
	},
	{
		title = "Augustin-Jean Fresnel",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French optical physicist (1788–1827)",
		tags = { "Physics", "Modern" },
		summary = 'He is perhaps better known for inventing the catadioptric (reflective/refractive) Fresnel lens and for pioneering the use of "stepped" lenses to extend the visibility of [[Lighthouse|lighthouses]], saving countless lives at sea.',
		sections = {
			{
				"Overview",
				"Fresnel gave the first satisfactory explanation of [[Diffraction|diffraction]] by straight edges, including the first satisfactory wave-based explanation of rectilinear propagation. By further supposing that light waves are purely transverse, Fresnel explained the nature of [[Polarization (waves)|polarization]]. He then worked on double refraction. Fresnel had a lifelong battle with tuberculosis, to which he succumbed at the age of 39. He lived just long enough to receive recognition from his peers, including (on his deathbed) the [[Rumford Medal]] of the [[Royal Society]], and his name is ubiquitous in the modern terminology of optics and waves. After the wave theory of light was subsumed by [[James Clerk Maxwell|Maxwell]]'s [[Electromagnetism|electromagnetic]] theory in the 1860s, some attention was diverted from the magnitude of Fresnel's contribution.",
			},
		},
		related = { "Thomas Young (scientist)" },
		infobox = {
			{ "Born", "10 May 1788" },
			{ "Birthplace", "Broglie, Normandy, France" },
			{ "Died", "14 July 1827" },
			{ "Fields", "[[Physics]], engineering" },
		},
	},
	{
		title = "Augustin-Louis Cauchy",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French mathematician (1789–1857)",
		tags = { "Mathematicians", "Modern" },
		summary = "[[Baron]] **Augustin-Louis Cauchy** (21 August 1789 – 23 May 1857) was a French [[Mathematician|mathematician]], engineer, and [[Physicist|physicist]]. He was one of the first to rigorously state and prove the key theorems of [[Calculus|calculus]] (thereby creating [[Real analysis|real analysis]]), pioneered the field of [[Complex analysis|complex analysis]], and the study of permutation groups in [[Abstract algebra|abstract algebra]]. Cauchy also contributed to a number of topics in mathematical physics, notably [[Continuum mechanics|continuum mechanics]].",
		sections = {
			{
				"Overview",
				"A profound mathematician, Cauchy had a great influence over his contemporaries and successors; Hans Freudenthal stated: Cauchy was a prolific worker; he wrote approximately eight hundred research articles and five complete textbooks on a variety of topics in the fields of mathematics and [[Mathematical physics|mathematical physics]].",
			},
		},
		infobox = {
			{ "Born", "21 August 1789" },
