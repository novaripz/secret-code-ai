	{
		title = "Contemporary classical music",
		category = "Music",
		fame = 3,
		emoji = "🎵",
		source = "wikipedia",
		description = "Post-1945 period in classical music",
		tags = { "Music genres and forms", "Western classical music" },
		summary = "**Contemporary classical music** is Western art music composed close to the present day. At the beginning of the 21st century, it commonly referred to the post-1945 [[Modernism (music)|post-tonal]] music after the death of Anton Webern, and included serial music, [[Electronic music|electronic music]], [[Experimental music|experimental music]], and minimalist music. Newer forms include spectral music and post-minimalism.",
