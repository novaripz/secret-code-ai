		emoji = "🔭",
		source = "wikipedia",
		description = "Amount of energy transferred or converted per unit time",
		tags = { "Mechanics", "Classical mechanics" },
		summary = "**Power** is the amount of [[Energy|energy]] transferred or converted per unit time. In the [[International System of Units]], the unit of power is the [[Watt|watt]] (symbol W), equal to one [[Joule|joule]] per [[Second|second]] (J/s). Power is a [[Scalar (physics)|scalar]] quantity.",
		sections = {
			{
				"Overview",
