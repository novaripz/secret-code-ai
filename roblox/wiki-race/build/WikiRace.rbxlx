	{
		title = "Buddy Holly",
		category = "Musician",
		fame = 3,
		emoji = "🎤",
		source = "wikipedia",
		description = "American musician (1936–1959)",
		tags = { "Popular music", "Rock" },
		aliases = { "Charles Hardin Holley" },
		summary = "**Charles Hardin Holley** (September 7, 1936 – February 3, 1959), known professionally by his stage name **Buddy Holly**, was an American singer, songwriter, and guitarist who was a central and pioneering figure of [[Rock music|rock and roll]]. He was born to a musical family in Lubbock, Texas, during the [[Great Depression]], and learned to play guitar and sing alongside his two siblings.",
		sections = {
			{
				"Overview",
				"Holly made his first appearance on local television in 1952, and the following year he formed the group Buddy and Bob with his friend Bob Montgomery. In 1955, after opening once for [[Elvis Presley]], Holly decided to pursue a music career. He played with Presley three times that year, and his band's style shifted from country and western to [[Rock music|rock and roll]]. In October that year, when Holly opened for Bill Haley & His Comets, he was spotted by [[Nashville, Tennessee|Nashville]] scout Eddie Crandall, who helped him get a contract with [[Decca Records]]. Holly's recording sessions at Decca were produced by Owen Bradley, who had become famous for producing orchestrated country hits for stars like Patsy Cline. Unhappy with Bradley's musical style and control in the studio, Holly went to producer Norman Petty in Clovis, New Mexico, and recorded a demo of \"That'll Be the Day\", among other songs.",
			},
		},
		related = { "Brian Eno", "Irving Berlin", "Nusrat Fateh Ali Khan", "Shakira", "Umm Kulthum" },
