		emoji = "🗣️",
		source = "wikipedia",
		description = "Semitic language",
		tags = { "Specific languages", "Afroasiatic languages" },
		summary = "**Aramaic** is a Northwest Semitic language that originated in the ancient region of [[Syria (region)|Syria]] and quickly spread to [[Mesopotamia]], the [[Southern Levant|southern Levant]], [[Sinai Peninsula|Sinai]], southeastern Anatolia, the [[Caucasus]], and [[Eastern Arabia]], where it has been continually written and spoken in different [[Variety (linguistics)|varieties]] for over 3,000 years.",
		sections = {
			{
				"Overview",
				"Aramaic served as a language of public life and administration of ancient kingdoms and empires—particularly the [[Neo-Assyrian Empire]], [[Neo-Babylonian Empire]], and [[Achaemenid Empire]]—and as a language of divine worship and religious study within Christianity and Gnosticism; it also has appeared to a limited degree in Judaism, where Hebrew remains primary. Several modern varieties of Aramaic are still spoken. The modern eastern branch is spoken by [[Assyrians]], Mandeans, and a small contingent of Mizrahi Jews. Western Aramaic is still spoken by the Muslim and Christian Aramean inhabitants of the towns of Maaloula, Bakh'a and Jubb'adin in [[Syria]].",
			},
		},
	},
