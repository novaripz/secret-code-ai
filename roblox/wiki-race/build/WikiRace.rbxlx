		tags = { "More articles" },
		aliases = { "Formula fiction", "Commercial fiction" },
		summary = "In the book-trade, **genre fiction**, also known as **formula fiction**, or **commercial fiction**, encompasses [[Fiction|fictional works]] written with the intent of fitting into a specific literary genre in order to appeal to readers and fans already familiar with that genre. These labels commonly imply that this type of fiction places more value on plot and entertainment than on character development, philosophical themes, or artistic depth. This distinguishes genre fiction from literary fiction.",
		sections = {
			{
				"Overview",
