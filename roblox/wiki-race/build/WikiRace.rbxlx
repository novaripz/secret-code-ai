			{ "Died", "31 October 1993" },
			{ "Occupation", "Film director, screenwriter" },
			{ "Years active", "1945–1993" },
		},
	},
	{
		title = "Federico García Lorca",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Spanish poet, dramatist and theatre director (1898–1936)",
		tags = { "Europe", "Western Europe" },
		aliases = { "Federico del Sagrado Corazón de Jesús García Lorca" },
		summary = "**Federico del Sagrado Corazón de Jesús García Lorca** (5 June 1898 – 19 August 1936) was a Spanish poet, playwright, and theatre director. García Lorca achieved international recognition as an emblematic member of the Generation of '27, a group consisting mostly of poets who introduced the tenets of European movements (such as [[Artistic symbol|symbolism]], [[Futurism|futurism]], and [[Surrealism|surrealism]]) into [[Spanish literature]].",
		sections = {
			{
				"Overview",
				"He initially rose to fame with Romancero gitano (Gypsy Ballads, 1928), a book of poems depicting life in his native [[Andalusia]]. His poetry incorporated traditional Andalusian motifs and [[Avant-garde|avant-garde]] styles. García Lorca was homosexual and suffered from depression after the end of his relationship with sculptor Emilio Aladrén Perojo. His remains have never been found, and the motive remains in dispute; some theorize he was targeted for being gay, a socialist, or both, while others view a personal dispute as the more likely cause.",
			},
		},
