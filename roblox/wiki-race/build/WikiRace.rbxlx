		tags = { "More articles" },
		aliases = { "MA" },
		summary = "The **Master of Arts** ( or Artium Magister; abbreviated **MA** or **AM**) is a [[Master's degree|master's degree]] awarded by [[University|universities]] in many countries. The degree is usually contrasted with that of [[Master of Science]]. Those admitted to the degree have typically studied subjects within the scope of the [[Humanities|humanities]] and [[Social science|social sciences]], such as [[History|history]], [[Economics|economics]], [[Literature|literature]], [[Language|languages]], [[Linguistics|linguistics]], [[Public administration|public administration]], [[Political science|political science]], [[Communication studies|communication studies]], [[Law|law]] or [[Diplomacy|diplomacy]]; however, different universities have different conventions and may also offer the degree for fields typically considered within the [[Natural science|natural sciences]] and mathematics.",
		sections = {
			{
				"Overview",
