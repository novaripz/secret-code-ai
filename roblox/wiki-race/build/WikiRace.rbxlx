	{
		title = "West Germany",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "Federal Republic of Germany (1949–1990)",
		tags = { "More articles" },
		aliases = { "Federal Republic of Germany", "FRG" },
		summary = "**West Germany** was the common English name for the **Federal Republic of Germany** (**FRG**) from its formation on 23 May 1949 until [[German reunification|its reunification]] with [[East Germany]] on 3 October 1990. It was sometimes known as the **Bonn Republic** after its capital city of [[Bonn]], or as the **Second German Republic**. During the [[Cold War]], the western portion of Germany and the associated territory of West Berlin were parts of the [[Western Bloc]]. West Germany was formed as a political entity during the Allied occupation of Germany after [[World War II]], established from twelve [[States of Germany|states]] formed in the three Allied zones of occupation held by the [[United States]], the [[United Kingdom]], and France.",
		sections = {
			{
				"Overview",
				"At the onset of the Cold War, [[Europe]] was divided between the Western and [[Eastern Bloc|Eastern blocs]]. Germany was divided into the two countries. Initially, West Germany claimed an exclusive mandate for all of Germany, representing itself as the sole democratically reorganised continuation of the 1871–1945 German Reich. Three southwestern states of West Germany merged to form Baden-Württemberg in 1952, and the Saarland joined West Germany as a state in 1957 after it had been separated as the Saar Protectorate from [[Allied-occupied Germany]] by France (the separation had not been legal as it had not been recognised by the Allied Control Council). In addition to the resulting ten states, West Berlin was considered an unofficial eleventh state.",
			},
		},
		related = { "Princeton University Press" },
		infobox = {
			{ "Government", "Federal [[Parliamentary republic|parliamentary republic]]" },
