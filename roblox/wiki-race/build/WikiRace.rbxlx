	{
		title = "Mount Kenya",
		category = "Geography",
		fame = 3,
		emoji = "⛰️",
		source = "wikipedia",
		description = "Highest mountain in Kenya",
		tags = { "Mountain peaks", "Africa" },
		summary = '**Mount Kenya** (Meru: Kĩrĩmaara, Kikuyu: Kĩrĩmanyaga, or "Kīrī-nyaga", Kamba: Ki nyaa, Embu: Kĩ nyaga, or "Kirinyaga") is the second highest mountain in Africa and the namesake of the country [[Kenya]]. Located about 150 km (90 mi) north-northeast of the capital of [[Nairobi]] and just 16.5 kilometres (10.3 miles) south of the equator, the mountain\'s highest peaks are Batian (5,199 m), Nelion (5,188 m), and Point Lenana (4,985 m). Historically situated in the former Eastern and Central provinces, the massif now serves as the intersection of Meru, Embu, Kirinyaga, Nyeri, and Tharaka Nithi counties.',
		sections = {
			{
				"Overview",
				"The area was officially gazetted as the Mount Kenya National Park in 1949 and was later designated a [[World Heritage Site|UNESCO World Heritage Site]] in 1997 for its outstanding natural beauty and ecological significance. Today, the park and its surrounding forest reserve are managed by the Kenya Wildlife Service and the Kenya Forest Service as a critical sanctuary for endangered species and a primary water tower for the region. Mount Kenya is a [[Volcano|volcano]] created approximately 3 million years after the opening of the [[East African Rift]]. Before glaciation, it was 7000 m high. It was covered by an [[Ice cap|ice cap]] for thousands of years. This has resulted in very [[Erosion|eroded]] slopes and numerous valleys radiating from the peak. There are currently 11 small [[Glacier|glaciers]], which are shrinking rapidly, and may disappear by 2050. The forested slopes are an important source of water for much of Kenya.",
			},
		},
		related = { "Mont Blanc", "Aconcagua" },
		infobox = {
			{ "Elevation", "5199 m" },
			{ "Prominence", "3825 m" },
			{ "Listing", "Seven Second Summits Country high point [[Ultra-prominent peak|Ultra]]" },
			{ "Location", "[[Kenya]]" },
			{ "Range", "The Eastern Rift mountains" },
			{ "Type", "[[Stratovolcano]] (extinct)" },
			{ "First climbed", "13 September 1899 by Mackinder, Ollier, and Brocherel." },
		},
	},
	{
		title = "Mount Kilimanjaro",
		category = "Geography",
		fame = 3,
		emoji = "⛰️",
		source = "wikipedia",
		description = "Mountain in Tanzania, highest in Africa",
		tags = { "Mountain peaks", "Africa" },
		summary = "**Mount Kilimanjaro** is a large [[Volcano|dormant volcano]] in [[Tanzania]]. It is the highest mountain in Africa and the highest free-standing mountain above sea level in the world, at 5,895 m above sea level and 4900 m above its plateau base. It is also the highest volcano in the [[Eastern Hemisphere]] and the fourth most prominent peak on [[Earth]].",
		sections = {
			{
				"Overview",
				"Kilimanjaro's southern and eastern slopes served as the home of the Chagga Kingdoms until their abolition in 1963 by Julius Nyerere. The origin and meaning of the name Kilimanjaro is unknown, but may mean \"mountain of greatness\" or \"unclimbable\". Although it is described in [[Classical antiquity|classical]] sources, German missionary Johannes Rebmann is credited as the first European to report the mountain's existence, in 1848. After several European attempts, Hans Meyer reached Kilimanjaro's highest summit in 1889. The mountain was incorporated into Kilimanjaro National Park in 1973. As one of the [[Seven Summits]], Kilimanjaro is a major hiking and climbing destination. There are seven established routes to Uhuru Peak, the mountain's highest point. Although not as technically challenging as similar mountains, the prominence of Kilimanjaro poses a serious risk of altitude sickness.",
			},
		},
		related = { "Mont Blanc", "Aconcagua" },
		infobox = {
			{ "Location", "Kilimanjaro Region, [[Tanzania]]" },
			{ "Listing", "[[Seven Summits]], Country high point, [[Ultra-prominent peak|Ultra]]" },
			{ "Range", "The Eastern Rift mountains" },
			{ "Type", "[[Stratovolcano]]" },
			{ "Age", "4 million years" },
			{ "First climbed", "6 October 1889 by Hans Meyer and Ludwig Purtscheller" },
		},
	},
