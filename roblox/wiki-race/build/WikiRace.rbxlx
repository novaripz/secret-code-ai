		tags = { "More articles" },
		aliases = { "Tubers" },
		summary = "**Tubers** are a type of enlarged structure that [[Plant|plants]] use as storage organs for [[Nutrient|nutrients]], derived from stems or roots. Tubers help plants perennate (survive winter or dry months), provide energy and nutrients, and are a means of [[Asexual reproduction|asexual reproduction]].",
		sections = {
			{
				"Overview",
				"**Stem tubers** manifest as thickened [[Rhizome|rhizomes]] (underground stems) or stolons (horizontal connections between organisms); examples include the [[Potato|potato]] and [[Yam (vegetable)|yam]]. The term **root tuber** describes modified lateral [[Root|roots]], as in [[Sweet potato|sweet potato]], [[Cassava|cassava]], and [[Dahlia|dahlia]].",
			},
