			{ "Birthplace", "near Les Andelys, [[Normandy]], [[Kingdom of France]]" },
			{ "Died", "19 November 1665" },
			{ "Field", "[[Painting]]" },
			{ "Movement", "[[Classicism]], [[Baroque]]" },
		},
	},
	{
		title = "Nicolaus Copernicus",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Mathematician and astronomer (1473–1543)",
		tags = { "Astronomy" },
		summary = "**Nicolaus Copernicus** (19 February 1473 – 24 May 1543) was a [[Renaissance]] [[Polymath|polymath]] who formulated a [[Mathematical model|model]] of the universe that placed the Sun rather than Earth at its center. The publication of Copernicus's model in his book (On the Revolutions of the Celestial Spheres), just before his death in 1543, was a major event in the [[History of science|history of science]], triggering the Copernican Revolution and making a pioneering contribution to the [[Scientific Revolution]]. Though a similar heliocentric model had been developed eighteen centuries earlier by Aristarchus of Samos, an ancient Greek astronomer, Copernicus likely arrived at his model independently.",
		sections = {
			{
				"Overview",
				"Copernicus was born and died in Royal Prussia, a semi-autonomous and multilingual region created within the [[Crown of the Kingdom of Poland]] from lands regained from the [[Teutonic Order]] after the Thirteen Years' War. A polyglot and [[Polymath|polymath]], he obtained a doctorate in canon law and was a mathematician, astronomer, physician, classics scholar, translator, governor, diplomat, and economist. From 1497 he was a Warmian Cathedral chapter canon. In 1517 he derived a quantity theory of money—a key concept in economics—and in 1519 he formulated an economic principle that later came to be called Gresham's law.",
			},
		},
		related = { "Carl Sagan" },
		infobox = {
			{ "Born", "19 February 1473" },
			{ "Birthplace", "Thorn, Royal Prussia, Poland" },
			{ "Died", "24 May 1543 (aged 70)" },
			{ "Field", "Astronomy, Canon law, Economics, Mathematics, Medicine, Politics" },
		},
	},
