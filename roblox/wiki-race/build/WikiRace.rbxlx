	{
		title = "BBC",
		category = "Concept",
		fame = 1,
		emoji = "💭",
		source = "wikipedia",
		description = "British public service broadcaster",
		tags = { "Mass media", "Television" },
		aliases = { "British Broadcasting Corporation" },
		summary = "The **British Broadcasting Corporation** (**BBC**) is a British public service broadcaster headquartered at Broadcasting House in [[London]], England. Originally established in 1922 as the British Broadcasting Company, it evolved into its current state with its current name on 1 January 1927. It is the oldest and largest local and global broadcaster by stature and by number of employees, with a total staff of 22,000.",
		sections = {
			{
				"Overview",
				"The BBC was established under a royal charter, and operates under an agreement with the secretary of state for culture, media and sport. Its work is funded principally by an annual television licence fee which is charged to all British households, companies, and organisations using any type of equipment to receive or record live television broadcasts or to use the BBC's streaming service, iPlayer. The fee is set by the British government, agreed by [[Parliament of the United Kingdom|Parliament]], and is used to fund the BBC's radio, TV, and online services covering the nations and regions of the UK. Since 1 April 2014, it has also funded the BBC World Service (launched in 1932 as the BBC Empire Service), which broadcasts in 43 languages as of 2026.",
			},
		},
		infobox = {
			{ "Type", "Chartered corporation, public broadcaster" },
			{ "Industry", "Mass media" },
			{ "Founder", "[[Government of the United Kingdom]]" },
			{ "Products", "Broadcasting Web portals" },
			{ "Headquarters", "Broadcasting House London, England, UK" },
		},
	},
	{
		title = "Bachelor of Arts",
		category = "Concept",
		fame = 1,
		emoji = "🎨",
		source = "wikipedia",
		description = "Type of undergraduate qualification",
		tags = { "More articles" },
		summary = "A **Bachelor of Arts** is the holder of a [[Bachelor's degree|bachelor's degree]] awarded for an [[Undergraduate education|undergraduate]] program in the liberal arts, or, in some cases, other disciplines.",
		sections = {
			{
				"Overview",
				"A Bachelor of Arts degree course is generally completed in three, four, or five years or more, depending on the country and institution.",
			},
		},
		related = { "Spotted hyena" },
		infobox = {
			{ "Type", "[[Bachelor's degree]]" },
