        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">BrowserHistory</string>
            <string name="Source"><![CDATA[-- Browser-style navigation stack.
--   push(x) truncates any forward history, like following a new link after going back.
--   A → B → C → D, back → C, back → B, forward → C, forward → D.

local BrowserHistory = {}
BrowserHistory.__index = BrowserHistory

local MAX_STACK = 250
local MAX_RECENT = 25

function BrowserHistory.new(startId: string)
	local self = setmetatable({
		stack = { startId },
		index = 1,
		recent = { startId }, -- most recent first, unique
	}, BrowserHistory)
	return self
end

function BrowserHistory:current(): string
	return self.stack[self.index]
end

function BrowserHistory:_touchRecent(id: string)
	local existing = table.find(self.recent, id)
	if existing then
		table.remove(self.recent, existing)
	end
	table.insert(self.recent, 1, id)
	while #self.recent > MAX_RECENT do
		table.remove(self.recent)
	end
end

function BrowserHistory:push(id: string)
	-- Choosing a new page after going back clears the forward history.
	for i = #self.stack, self.index + 1, -1 do
		table.remove(self.stack, i)
	end
	table.insert(self.stack, id)
	self.index = #self.stack
	if #self.stack > MAX_STACK then
		table.remove(self.stack, 1)
		self.index -= 1
	end
	self:_touchRecent(id)
end

function BrowserHistory:canBack(): boolean
	return self.index > 1
end

function BrowserHistory:canForward(): boolean
	return self.index < #self.stack
end

function BrowserHistory:peekBack(): string?
	return self.stack[self.index - 1]
end

function BrowserHistory:peekForward(): string?
	return self.stack[self.index + 1]
end

function BrowserHistory:back(): string?
	if not self:canBack() then
		return nil
	end
	self.index -= 1
	self:_touchRecent(self.stack[self.index])
	return self.stack[self.index]
end

function BrowserHistory:forward(): string?
	if not self:canForward() then
		return nil
	end
	self.index += 1
	self:_touchRecent(self.stack[self.index])
	return self.stack[self.index]
end

function BrowserHistory:hasVisited(id: string): boolean
	return table.find(self.recent, id) ~= nil or table.find(self.stack, id) ~= nil
end

function BrowserHistory:recentList(limit: number?)
	local out = {}
	for i = 1, math.min(limit or MAX_RECENT, #self.recent) do
		out[i] = self.recent[i]
	end
	return out
end

return BrowserHistory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Match</string>
            <string name="Source"><![CDATA[-- One multiplayer match: a sequence of rounds for the players in a lobby.
--
-- The match is fully server-authoritative: it generates and validates each challenge, owns the
-- clock (workspace:GetServerTimeNow), validates every navigation through RaceSession, decides
-- completion, placement and score, and persists stats/records. Clients only render.
--
-- Round lifecycle: Generating → Reveal (start roll, target roll, 3-2-1) → Racing → Results.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Net = require(Shared.Net)

local Services = script.Parent.Parent.Services
local Router = require(Services.Router)
local WikiService = require(Services.WikiService)
local DataService = require(Services.DataService)
local AchievementService = require(Services.AchievementService)
local RecordService = require(Services.RecordService)
local LeaderboardService = require(Services.LeaderboardService)
local CosmeticService = require(Services.CosmeticService)
local ChaosState = require(Services.ChaosState)

local RaceSession = require(script.Parent.RaceSession)
local Scoring = require(script.Parent.Scoring)

local Match = {}
Match.__index = Match

local ERRORS = {
	NotALink = "That link isn't on this page.",
	NoRedos = "You're out of redos!",
	NoBack = "Nothing to go back to.",
	NoForward = "Nothing to go forward to.",
	NotInHistory = "You haven't visited that page this round.",
	AlreadyAtStart = "You're already on the starting page.",
	Finished = "You've already finished this round.",
	NotStarted = "The race hasn't started yet!",
	TooManyClicks = "Click limit reached for this round.",
	BadOp = "Unknown action.",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function timerSeconds(settings): number?
	if settings.timer == "unlimited" then
		return nil
	elseif settings.timer == "custom" then
		return math.clamp(
			math.floor(settings.customSeconds or Config.Race.DefaultCustomSeconds),
			Config.Race.CustomTimerMin,
			Config.Race.CustomTimerMax
		)
	end
	return tonumber(settings.timer) or 300
end

-- lobby: the owning lobby table. hooks: { onEnded = fn(match), onChanged = fn() }
function Match.new(lobby, hooks, options)
	options = options or {}
	local self = setmetatable({
		lobby = lobby,
		hooks = hooks,
		settings = table.clone(lobby.settings), -- snapshot: the rig never mutates lobby settings
		solo = options.solo == true,
		fixedStart = options.fixedStart,
		roundIndex = 0,
		totalRounds = lobby.settings.rounds,
		participants = {}, -- [userId] = totals
		rounds = {},
		phase = "Idle",
		ended = false,
		endRequested = false,
		rng = Random.new(),
		recentTargets = {},
		recentStarts = {},
		recentOrder = {},
		round = nil,
		lastRigId = 0,
	}, Match)
	return self
end

function Match:_players(): { Player }
	local list = {}
	for _, userId in self.lobby.members do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			table.insert(list, player)
		end
	end
	return list
end

function Match:_roundPlayers(): { Player }
	local list = {}
	if not self.round then
		return list
	end
	for _, userId in self.round.order do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			table.insert(list, player)
		end
	end
	return list
end

function Match:_card(player: Player)
	return {
		userId = player.UserId,
		name = player.Name,
		displayName = player.DisplayName,
		look = CosmeticService.look(player),
	}
end

function Match:_participant(player: Player)
	local entry = self.participants[player.UserId]
	if not entry then
		entry = {
			userId = player.UserId,
			name = player.Name,
			displayName = player.DisplayName,
			score = 0,
			completedRounds = 0,
			totalTime = 0,
			totalClicks = 0,
			totalRedos = 0,
			roundsPlayed = 0,
			left = false,
		}
		self.participants[player.UserId] = entry
	end
	entry.left = false
	return entry
end

function Match:start()
	self.phase = "Starting"
	task.spawn(function()
		local ok, err = pcall(self._run, self)
		if not ok then
			warn("[WikiRace] Match crashed: " .. tostring(err))
			Router.pushMany(
				self:_players(),
				Net.Events.MatchAborted,
				{ reason = "The server hit an error. Returning to the lobby." }
			)
			self.ended = true
			self.phase = "Ended"
			self.hooks.onEnded(self)
		end
	end)
end

function Match:_run()
	while not self.ended do
		self.roundIndex += 1
		self:_runRound()
		if self.ended then
			break
		end
		if self.endRequested then
			break
		end
		if self.totalRounds > 0 and self.roundIndex >= self.totalRounds then
			break
		end
		if #self:_players() == 0 then
			self.ended = true
			break
		end
	end
	self:_finish()
end

function Match:_waitUntil(deadline: number, breakOn)
	while now() < deadline do
		if self.ended or (breakOn and breakOn()) then
			return false
		end
		task.wait(0.1)
	end
	return true
end

function Match:_remember(challenge)
	self.recentTargets[challenge.target] = true
	self.recentStarts[challenge.start] = true
	table.insert(self.recentOrder, challenge)
	if #self.recentOrder > 25 then
		local oldest = table.remove(self.recentOrder, 1)
		self.recentTargets[oldest.target] = nil
		self.recentStarts[oldest.start] = nil
	end
end

function Match:_generate(difficulty: string)
	local generator = WikiService.generator
	for _ = 1, 6 do
		local challenge = generator:generate(difficulty, {
			rng = self.rng,
			excludeTargets = self.recentTargets,
			excludeStarts = self.recentStarts,
			fixedStart = (self.roundIndex == 1 and self.fixedStart) or nil,
		})
		-- Discard anything that fails validation and regenerate.
		if challenge and generator:validate(challenge, difficulty) then
			return challenge
		end
	end
	-- Last resort: forget recent history (tiny wikis) but never relax the distance rules.
	local challenge = generator:generate(difficulty, { rng = self.rng })
	if challenge and generator:validate(challenge, difficulty) then
		return challenge
	end
	return nil
end

function Match:_runRound()
	local players = self:_players()
	if #players == 0 then
		self.ended = true
		return
	end
	local repo = WikiService.repo

	-- Server Rig window: rounds that start while the server is rigged run in Give Up Mode.
	-- Each rig applies to a lobby at most once; later rounds use the host's settings again.
	local difficulty = self.settings.difficulty
	local rigged, rigBy = false, nil
	local t0 = now()
	if ChaosState.isRigActive(t0) and ChaosState.rigId ~= self.lastRigId then
		difficulty = "GiveUp"
		rigged = true
		rigBy = ChaosState.riggedBy
		self.lastRigId = ChaosState.rigId
	end

	self.phase = "Generating"
	Router.pushMany(players, Net.Events.RoundGenerating, { round = self.roundIndex, totalRounds = self.totalRounds })
	local challenge = self:_generate(difficulty)
	if not challenge then
		error("could not generate a valid challenge")
	end
	self:_remember(challenge)

	local def = Difficulty.get(difficulty)
	local revealStartAt = now() + 0.75
	local targetRevealAt = revealStartAt + Config.Race.RevealStartSeconds
	local countdownAt = targetRevealAt + Config.Race.RevealTargetSeconds
	local raceStartAt = countdownAt + Config.Race.CountdownSeconds
	local limit = timerSeconds(self.settings)

	local round = {
		index = self.roundIndex,
		difficulty = difficulty,
		challenge = challenge,
		target = challenge.target,
		rigged = rigged,
		rigBy = rigBy,
		raceStartAt = raceStartAt,
		limit = limit,
		endsAt = limit and (raceStartAt + limit) or nil,
		sessions = {},
		order = {},
		left = {},
		finishedCount = 0,
		closingAt = nil,
		skip = false,
		lastOpponentPush = 0,
	}
	self.round = round

	local cards = {}
	for _, player in players do
		self:_participant(player)
		round.sessions[player.UserId] = RaceSession.new({
			graph = WikiService.graph,
			start = challenge.start,
			target = challenge.target,
			redos = def.redos,
			mode = "race",
			startTime = raceStartAt,
			maxClicks = Config.Race.MaxClicksPerRound,
		})
		table.insert(round.order, player.UserId)
		table.insert(cards, self:_card(player))
	end

	local startPayload = repo:payload(challenge.start)
	local common = {
		round = self.roundIndex,
		totalRounds = self.totalRounds,
		difficulty = difficulty,
		rigged = rigged,
		rigBy = rigBy,
		start = repo:preview(challenge.start),
		target = repo:preview(challenge.target),
		rollTitles = repo:sampleTitles(
			Config.Race.RollTitleCount,
			self.rng,
			{ [challenge.start] = true, [challenge.target] = true }
		),
		revealStartAt = revealStartAt,
		targetRevealAt = targetRevealAt,
		countdownAt = countdownAt,
		raceStartAt = raceStartAt,
		endsAt = round.endsAt,
		redos = def.redos,
		showMeters = self.settings.showMeters,
		showPages = self.settings.showPages,
		players = cards,
		solo = self.solo,
	}
	for _, player in players do
		local payload = table.clone(common)
		payload.page = startPayload
		payload.state = round.sessions[player.UserId]:snapshot()
		Router.push(player, Net.Events.RoundStart, payload)
	end
	self.phase = "Reveal"
	self.hooks.onChanged()

	self:_waitUntil(raceStartAt)
	if self.ended then
		return
	end
	self.phase = "Racing"
	self.hooks.onChanged()
	self:_pushOpponents(true)

	-- Race loop: cheap 4 Hz tick. Navigation itself is event-driven through :navigate().
	local tickInterval = 1 / Config.Race.OpponentUpdateHz
	while not self.ended do
		task.wait(tickInterval)
		local t = now()
		if self.pendingRig then
			self:_applyRig()
		end
		local active = 0
		for userId, session in round.sessions do
			if not session.finished and not round.left[userId] then
				active += 1
			end
		end
		if active == 0 or round.skip or self.endRequested then
			break
		end
		if round.endsAt and t >= round.endsAt then
			break
		end
		if not round.endsAt and #round.order > 1 then
			local needed = math.ceil(#round.order / 2)
			if not round.closingAt and round.finishedCount >= needed then
				round.closingAt = t + Config.Race.UnlimitedClosingSeconds
				Router.pushMany(self:_roundPlayers(), Net.Events.RoundClosing, { closesAt = round.closingAt })
			end
			if round.closingAt and t >= round.closingAt then
				break
			end
		end
		self:_pushOpponents(false)
	end

	self:_endRound()
end

-- Live standings for the sidebar. Temperature/page visibility honors the host's toggles; a
-- player always sees their own details.
function Match:_opponentsFor(viewerId: number, rows)
	local visible = {}
	for _, row in rows do
		local entry = table.clone(row)
		local isSelf = row.userId == viewerId
		if not (self.settings.showMeters or isSelf) then
			entry.temperature = nil
		end
		if not (self.settings.showPages or isSelf) then
			entry.page = nil
		end
		table.insert(visible, entry)
	end
	return visible
end

function Match:_liveRows()
	local round = self.round
	local rows = {}
	for _, userId in round.order do
		local session = round.sessions[userId]
		local participant = self.participants[userId]
		table.insert(rows, {
			userId = userId,
			displayName = participant and participant.displayName or "?",
			clicks = session.clicks,
			redos = session.redosUsed,
			temperature = session:temperature(),
			page = WikiService.repo:title(session:current()),
			finished = session.finished,
			completed = session.completed,
			gaveUp = session.gaveUp,
			left = round.left[userId] == true,
			time = session.finishTime,
			finishOrder = session.finishOrder,
		})
	end
	table.sort(rows, function(a, b)
		if a.completed ~= b.completed then
			return a.completed
		end
		if a.completed then
			return (a.finishOrder or 0) < (b.finishOrder or 0)
		end
		if a.gaveUp ~= b.gaveUp then
			return not a.gaveUp
		end
		return a.userId < b.userId
	end)
	for index, row in rows do
		row.placement = row.completed and index or nil
	end
	return rows
end

function Match:_pushOpponents(force: boolean)
	local round = self.round
	if not round then
		return
	end
	local t = os.clock()
	if not force and (not self.opponentsDirty or t - round.lastOpponentPush < 1 / Config.Race.OpponentUpdateHz) then
		return
	end
	self.opponentsDirty = false
	round.lastOpponentPush = t
	local rows = self:_liveRows()
	for _, player in self:_roundPlayers() do
		Router.push(
			player,
			Net.Events.Opponents,
			{ rows = self:_opponentsFor(player.UserId, rows), endsAt = round.endsAt, closingAt = round.closingAt }
		)
	end
end

-- Called by LobbyService for Navigate requests. Returns the new page + state or an error.
function Match:navigate(player: Player, op: string, argument: any)
	local round = self.round
	if not round or (self.phase ~= "Racing" and self.phase ~= "Reveal") then
		return nil, "There's no race running right now."
	end
	local session = round.sessions[player.UserId]
	if not session then
		return nil, "You'll join at the next round."
	end
	local t = now()
	if round.endsAt and t >= round.endsAt then
		return nil, "Time's up!"
	end
	local ok, err = session:apply(op, argument, t)
	if not ok then
		return nil, ERRORS[err] or "That move isn't allowed."
	end
	self.opponentsDirty = true
	if session.reachedBurning and not session.burningAwarded then
		session.burningAwarded = true
		AchievementService.unlock(player, "burning")
	end
	if session.completed and not session.finishOrder then
		round.finishedCount += 1
		session.finishOrder = round.finishedCount
		self:_announceFinish(player, session)
	end
	return {
		page = WikiService.repo:payload(session:current()),
		state = session:snapshot(),
	}
end

function Match:giveUp(player: Player)
	local round = self.round
	if not round or self.phase ~= "Racing" then
		return nil, "There's no race running right now."
	end
	local session = round.sessions[player.UserId]
	if not session or not session:giveUp(now()) then
		return nil, "You can't give up right now."
	end
	round.finishedCount += 1
	self.opponentsDirty = true
	for _, other in self:_roundPlayers() do
		if other ~= player then
			Router.toast(other, ("🏳️ %s gave up!"):format(player.DisplayName), "info")
		end
	end
	return { state = session:snapshot() }
end

function Match:_announceFinish(player: Player, session)
	local place = session.finishOrder
	for _, other in self:_roundPlayers() do
		if other ~= player then
			Router.toast(
				other,
				("🏁 %s reached the target in %.1fs (%s place)"):format(
					player.DisplayName,
					session.finishTime,
					place == 1 and "1st" or (place == 2 and "2nd" or (place == 3 and "3rd" or place .. "th"))
				),
				"finish"
			)
		end
	end
end

function Match:onPlayerLeft(userId: number)
	local participant = self.participants[userId]
	if participant then
		participant.left = true
	end
	if self.round and self.round.sessions[userId] then
		self.round.left[userId] = true
		self.opponentsDirty = true
	end
	if #self:_players() == 0 then
		self.ended = true
	end
end

-- Server Rig ------------------------------------------------------------------------------

function Match:requestRig(byName: string, rigId: number)
	if rigId == self.lastRigId then
		return
	end
	if self.phase == "Racing" or self.phase == "Reveal" or self.phase == "Generating" then
		self.lastRigId = rigId
		self.pendingRig = byName
	end
	-- Idle / Results / Starting: the ChaosState window rigs this lobby's next round instead.
end

function Match:_applyRig()
	local by = self.pendingRig
	self.pendingRig = nil
	local round = self.round
	if not round or round.rigged then
		return
	end
	local currentPages, targets = {}, {}
	for userId, session in round.sessions do
		if not session.finished and not round.left[userId] then
			table.insert(currentPages, session:current())
		end
	end
	if #currentPages == 0 then
		return
	end
	for _, challenge in self.recentOrder do
		targets[challenge.target] = true
	end
	local newTarget =
		WikiService.generator:generateRigTarget(currentPages, { rng = self.rng, excludeTargets = targets })
	if not newTarget then
		return
	end
	round.rigged = true
	round.rigBy = by
	round.difficulty = "GiveUp"
	round.target = newTarget
	for userId, session in round.sessions do
		if not session.finished and not round.left[userId] then
			session:retarget(newTarget, Difficulty.get("GiveUp").redos)
			session.clicksBase = session.clicks
		end
	end
	local t = now()
	if round.endsAt and round.endsAt - t < Config.Chaos.ServerRigMinRemainingSeconds then
		round.endsAt = t + Config.Chaos.ServerRigMinRemainingSeconds
	end
	local preview = WikiService.repo:preview(newTarget)
	for _, player in self:_roundPlayers() do
		local session = round.sessions[player.UserId]
		Router.push(player, Net.Events.RoundRigged, {
			by = by,
			difficulty = "GiveUp",
			target = preview,
			endsAt = round.endsAt,
			state = session and session:snapshot() or nil,
		})
	end
	self.opponentsDirty = true
end

-- Round end ------------------------------------------------------------------------------

function Match:_endRound()
	local round = self.round
	local repo = WikiService.repo
	local endedAt = now()
	self.phase = "Results"

	local results = {}
	for _, userId in round.order do
		local session = round.sessions[userId]
		session:timeOut()
		local left = round.left[userId] == true
		local finalDistance = WikiService.graph:distance(session:current(), round.target)
		local spent = session.finishTime
			or session.giveUpTime
			or math.max(0, math.min(endedAt, round.endsAt or endedAt) - round.raceStartAt)
		table.insert(results, {
			userId = userId,
			completed = session.completed and not left,
			gaveUp = session.gaveUp or left,
			left = left,
			time = session.completed and session.finishTime or nil,
			spent = spent,
			clicks = session.clicks,
			effectiveClicks = session.clicks - (session.clicksBase or 0),
			redos = session.redosUsed,
			startDistance = session.startDistance,
			optimal = session.startDistance,
			bestDistance = session.bestDistance,
			finalDistance = finalDistance,
			reachedBurning = session.reachedBurning,
			route = session.route,
		})
	end
	Scoring.scoreRound(results, {
		difficulty = round.difficulty,
		timeLimit = round.limit,
		referenceSeconds = Config.Race.UnlimitedReferenceSeconds,
	})

	local playerCount = #results
	local startTitle, targetTitle = repo:title(round.challenge.start), repo:title(round.target)
	local rows = {}
	for _, result in results do
		local participant = self.participants[result.userId]
		local player = Players:GetPlayerByUserId(result.userId)
		if participant then
			participant.score += result.score
			participant.roundsPlayed += 1
			participant.totalClicks += result.clicks
			participant.totalRedos += result.redos
			participant.totalTime += result.spent
			if result.completed then
				participant.completedRounds += 1
			end
		end
		if player and not result.left then
			self:_persistRound(player, result, round, playerCount, startTitle, targetTitle)
		end
		local routeTitles = {}
		local route = result.route
		for i = math.max(1, #route - 11), #route do
			table.insert(routeTitles, repo:title(route[i]))
		end
		table.insert(rows, {
			userId = result.userId,
			displayName = participant and participant.displayName or "?",
			name = participant and participant.name or "?",
			look = player and CosmeticService.look(player) or nil,
			placement = result.placement,
			completed = result.completed,
			gaveUp = result.gaveUp,
			left = result.left,
			time = result.time,
			clicks = result.clicks,
			redos = result.redos,
			score = result.score,
			breakdown = result.breakdown,
			route = routeTitles,
			routeLength = #route,
			totalScore = participant and participant.score or result.score,
		})
	end

	table.insert(self.rounds, results)

	local optimalTitles = {}
	for _, id in round.challenge.path or {} do
		table.insert(optimalTitles, repo:title(id))
	end
	if round.target ~= round.challenge.target then
		optimalTitles = {} -- the rig changed the target; the original optimal route is moot
	end

	local isFinal = self.endRequested or (self.totalRounds > 0 and self.roundIndex >= self.totalRounds) or self.ended
	local nextAt = now() + Config.Race.RoundResultsSeconds
	local payload = {
		round = self.roundIndex,
		totalRounds = self.totalRounds,
		isFinal = isFinal,
		difficulty = round.difficulty,
		rigged = round.rigged,
		rigBy = round.rigBy,
		start = repo:preview(round.challenge.start),
		target = repo:preview(round.target),
		optimalPath = optimalTitles,
		shortestDistance = round.target == round.challenge.target and round.challenge.distance or nil,
		rows = rows,
		nextAt = nextAt,
	}
	Router.pushMany(self:_players(), Net.Events.RoundResults, payload)
	self.hooks.onChanged()

	self.skipResults = false
	self:_waitUntil(nextAt, function()
		return self.skipResults
	end)
	self.round = nil
end

function Match:_persistRound(
	player: Player,
	result,
	round,
	playerCount: number,
	startTitle: string,
	targetTitle: string
)
	local difficulty = round.difficulty
	DataService.update(player, function(data)
		local stats = data.stats
		stats.races += 1
		stats.totalClicks += result.clicks
		stats.totalRedos += result.redos
		stats.totalScore += result.score
		stats.bestRoundScore = math.max(stats.bestRoundScore, result.score)
		if result.reachedBurning then
			stats.burningReached += 1
		end
		if round.rigged then
			stats.rigsSurvived += 1
		end
		if result.gaveUp then
			stats.giveUps += 1
		end
		if result.completed then
			stats.completions += 1
			stats.difficultyCompletions[difficulty] = (stats.difficultyCompletions[difficulty] or 0) + 1
			if not stats.fastestTime or result.time < stats.fastestTime then
				stats.fastestTime = result.time
			end
			if not stats.fewestClicks or result.clicks < stats.fewestClicks then
				stats.fewestClicks = result.clicks
			end
			data.coins += Config.Coins.RoundComplete
			if result.placement == 1 and playerCount >= 2 then
				stats.roundWins += 1
				data.coins += Config.Coins.RoundFirstPlace
			end
		end
	end)
	AchievementService.onRoundResult(player, result, {
		difficulty = difficulty,
		optimal = result.optimal,
		rigged = round.rigged,
	})
	RecordService.submit(player, result, {
		difficulty = difficulty,
		rigged = round.rigged,
		startTitle = startTitle,
		targetTitle = targetTitle,
		pairKey = round.challenge.start .. ">" .. round.target,
	})
end

-- Final results ----------------------------------------------------------------------------

function Match:_finish()
	if self.phase == "Ended" then
		return
	end
	self.phase = "Ended"
	local players = self:_players()
	local totals = {}
	for userId, participant in self.participants do
		if not participant.left and Players:GetPlayerByUserId(userId) then
			table.insert(totals, table.clone(participant))
		end
	end
	if #totals > 0 and #self.rounds > 0 then
		Scoring.standings(totals)
		local awards = Scoring.awards(self.rounds, totals)
		local byId = {}
		for _, entry in totals do
			local player = Players:GetPlayerByUserId(entry.userId)
			entry.look = player and CosmeticService.look(player) or nil
			byId[entry.userId] = entry
			if player then
				local won = entry.placement == 1 and #totals >= 2
				DataService.update(player, function(data)
					data.stats.matches += 1
					data.coins += Config.Coins.MatchPlayed
					if won then
						data.stats.wins += 1
						data.coins += Config.Coins.MatchWin
					end
				end)
				if won then
					AchievementService.onMatchWon(player)
				end
				AchievementService.onStatsChanged(player)
				LeaderboardService.submit(player)
				task.spawn(DataService.saveNow, player)
			end
		end
		local function named(award)
			if not award then
				return nil
			end
			local entry = byId[award.userId]
			local copy = table.clone(award)
			copy.displayName = entry and entry.displayName or "?"
			copy.look = entry and entry.look or nil
			return copy
		end
		Router.pushMany(players, Net.Events.MatchResults, {
			standings = totals,
			awards = {
				fastestTime = named(awards.fastestTime),
				fewestClicks = named(awards.fewestClicks),
				fewestRedos = named(awards.fewestRedos),
			},
			roundsPlayed = #self.rounds,
			solo = self.solo,
		})
	end
	self.round = nil
	self.hooks.onEnded(self)
end

function Match:requestEnd()
	self.endRequested = true
	self.skipResults = true
	if self.round then
		self.round.skip = true
	end
end

function Match:skipToNext()
	self.skipResults = true
end

function Match:abort()
	self.ended = true
	if self.round then
		self.round.skip = true
	end
end

-- Summary for lobby lists and late joiners.
function Match:summary()
	return {
		phase = self.phase,
		round = self.roundIndex,
		totalRounds = self.totalRounds,
		difficulty = self.round and self.round.difficulty or self.settings.difficulty,
	}
end

return Match
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">RaceSession</string>
            <string name="Source"><![CDATA[-- One player's authoritative browsing state for one round (or a free-roam session).
--
-- Every navigation is validated against the real graph: a "link" move is only legal if the
-- current page actually links to the destination. Clicks, redos, completion and timing are
-- all computed here from server time — the client can only ask to move.
--
-- Redo rules (race mode): going Back, jumping to a page from History, or restarting the route
-- from the starting page each spend one redo. Forward re-follows a link and counts as a click.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("WikiRaceShared")
local Temperature = require(Shared.Temperature)
local BrowserHistory = require(script.Parent.BrowserHistory)

local RaceSession = {}
RaceSession.__index = RaceSession

RaceSession.Ops = { link = true, back = true, forward = true, refresh = true, history = true, restart = true }

-- options: { graph, start, target?, redos? (nil/-1 = unlimited), mode = "race"|"free", startTime, maxClicks? }
function RaceSession.new(options)
	local graph = options.graph
	assert(graph.nodes[options.start], "unknown start page")
	local self = setmetatable({
		graph = graph,
		mode = options.mode or "race",
		start = options.start,
		target = options.target,
		history = BrowserHistory.new(options.start),
		clicks = 0,
		redosUsed = 0,
		redosAvailable = (options.redos == nil or options.redos < 0) and math.huge or options.redos,
		maxClicks = options.maxClicks or math.huge,
		startTime = options.startTime or 0,
		finished = false,
		completed = false,
		gaveUp = false,
		finishTime = nil,
		reachedBurning = false,
		route = { options.start },
		visitedCount = 1,
		visitedSet = { [options.start] = true },
	}, RaceSession)
	if self.target then
		self.startDistance = graph:distance(self.start, self.target)
		self.bestDistance = self.startDistance
		self.lastDistance = self.startDistance
	end
	return self
end

function RaceSession:current(): string
	return self.history:current()
end

function RaceSession:distance(): number?
	if not self.target then
		return nil
	end
	return self.graph:distance(self:current(), self.target)
end

function RaceSession:temperature(): string?
	if not self.target then
		return nil
	end
	if self.completed then
		return "Completed"
	end
	return Temperature.fromDistance(self.lastDistance)
end

function RaceSession:redosLeft(): number
	return math.max(0, self.redosAvailable - self.redosUsed)
end

function RaceSession:_costsRedo(): boolean
	return self.mode == "race"
end

function RaceSession:canBack(): boolean
	if not self.history:canBack() then
		return false
	end
	return not self:_costsRedo() or self:redosLeft() > 0
end

function RaceSession:canForward(): boolean
	return self.history:canForward()
end

function RaceSession:_spendRedo(): (boolean, string?)
	if not self:_costsRedo() then
		return true
	end
	if self:redosLeft() <= 0 then
		return false, "NoRedos"
	end
	self.redosUsed += 1
	return true
end

function RaceSession:_arrive(now: number)
	local current = self:current()
	table.insert(self.route, current)
	if #self.route > 400 then
		table.remove(self.route, 1)
	end
	if not self.visitedSet[current] then
		self.visitedSet[current] = true
		self.visitedCount += 1
	end
	if not self.target then
		return
	end
	local distance = self.graph:distance(current, self.target)
	self.lastDistance = distance
	if distance < (self.bestDistance or math.huge) then
		self.bestDistance = distance
	end
	if distance == 1 then
		self.reachedBurning = true
	end
	if distance == 0 then
		self.completed = true
		self.finished = true
		self.finishTime = math.max(0, now - self.startTime)
	end
end

-- Applies one navigation op. Returns ok, errorCode.
function RaceSession:apply(op: string, argument: any, now: number): (boolean, string?)
	if not RaceSession.Ops[op] then
		return false, "BadOp"
	end
	if self.finished then
		return false, "Finished"
	end
	if self.mode == "race" and now < self.startTime then
		return false, "NotStarted"
	end
	local current = self:current()

	if op == "refresh" then
		return true
	elseif op == "link" then
		if type(argument) ~= "string" or not self.graph:hasEdge(current, argument) then
			return false, "NotALink"
		end
		if self.clicks >= self.maxClicks then
			return false, "TooManyClicks"
		end
		self.clicks += 1
		self.history:push(argument)
	elseif op == "back" then
		if not self.history:canBack() then
			return false, "NoBack"
		end
		local ok, err = self:_spendRedo()
		if not ok then
			return false, err
		end
		self.history:back()
	elseif op == "forward" then
		if not self.history:canForward() then
			return false, "NoForward"
		end
		self.clicks += 1
		self.history:forward()
	elseif op == "history" then
		if type(argument) ~= "string" or argument == current or not self.history:hasVisited(argument) then
			return false, "NotInHistory"
		end
		local ok, err = self:_spendRedo()
		if not ok then
			return false, err
		end
		self.history:push(argument)
	elseif op == "restart" then
		if current == self.start then
			return false, "AlreadyAtStart"
		end
		local ok, err = self:_spendRedo()
		if not ok then
			return false, err
		end
		self.history:push(self.start)
	end

	self:_arrive(now)
	return true
end

function RaceSession:giveUp(now: number): boolean
	if self.finished then
		return false
	end
	self.finished = true
	self.gaveUp = true
	self.giveUpTime = math.max(0, now - self.startTime)
	return true
end

-- Called when the round ends for anyone still racing.
function RaceSession:timeOut()
	if not self.finished then
		self.finished = true
		self.timedOut = true
	end
end

-- Server Rig: swap the target mid-round. Progress is re-measured from the current page.
function RaceSession:retarget(newTarget: string, redos: number?)
	self.target = newTarget
	local distance = self.graph:distance(self:current(), newTarget)
	self.startDistance = distance
	self.bestDistance = distance
	self.lastDistance = distance
	self.reachedBurning = false
	if redos ~= nil then
		self.redosAvailable = self.redosUsed + math.max(0, redos)
	end
end

-- State the owning player sees. Never includes the numeric distance.
function RaceSession:snapshot()
	return {
		pageId = self:current(),
		clicks = self.clicks,
		redosUsed = self.redosUsed,
		redosLeft = self.redosAvailable == math.huge and -1 or self:redosLeft(),
		temperature = self:temperature(),
		canBack = self:canBack(),
		canForward = self:canForward(),
		history = self.history:recentList(15),
		finished = self.finished,
		completed = self.completed,
		gaveUp = self.gaveUp,
		finishTime = self.finishTime,
		atStart = self:current() == self.start,
	}
end

return RaceSession
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Scoring</string>
            <string name="Source"><![CDATA[-- Deterministic scoring. Integer math only, fixed tie-breakers (ending in userId), so the same
-- inputs always produce the same placements and scores on every server.
--
-- Round score (completed) = (600 base + placement 100..500 + time 0..400 + efficiency 0..400
--                            − 50 per redo, max 250) × difficulty multiplier
-- Round score (not completed) = progress toward the target 0..250 (halved when giving up,
--                               except in Give Up Mode) × difficulty multiplier
-- No single statistic decides a match: placement, speed, efficiency and redos all contribute.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("WikiRaceShared")
local Difficulty = require(Shared.Difficulty)

local Scoring = {}

Scoring.Base = 600
Scoring.PlacementMax = 500
Scoring.PlacementMin = 100
Scoring.TimeMax = 400
Scoring.EfficiencyMax = 400
Scoring.RedoPenalty = 50
Scoring.RedoPenaltyCap = 250
Scoring.ProgressMax = 250

local function clamp01(x: number): number
	if x ~= x then
		return 0
	end
	return math.clamp(x, 0, 1)
end

local function compareCompleted(a, b)
	if a.time ~= b.time then
		return a.time < b.time
	end
	if a.clicks ~= b.clicks then
		return a.clicks < b.clicks
	end
	if a.redos ~= b.redos then
		return a.redos < b.redos
	end
	return a.userId < b.userId
end

local function compareUnfinished(a, b)
	if (a.gaveUp or false) ~= (b.gaveUp or false) then
		return not a.gaveUp
	end
	local aBest, bBest = a.bestDistance or math.huge, b.bestDistance or math.huge
	if aBest ~= bBest then
		return aBest < bBest
	end
	local aFinal, bFinal = a.finalDistance or math.huge, b.finalDistance or math.huge
	if aFinal ~= bFinal then
		return aFinal < bFinal
	end
	if a.clicks ~= b.clicks then
		return a.clicks < b.clicks
	end
	return a.userId < b.userId
end

-- Sorts results in place and assigns `placement` (1-based).
function Scoring.rankRound(results)
	table.sort(results, function(a, b)
		if a.completed ~= b.completed then
			return a.completed
		end
		if a.completed then
			return compareCompleted(a, b)
		end
		return compareUnfinished(a, b)
	end)
	for index, result in results do
		result.placement = index
	end
	return results
end

-- ctx: { difficulty, playerCount, timeLimit (seconds, or nil for unlimited), referenceSeconds }
function Scoring.roundScore(result, ctx)
	local def = Difficulty.get(ctx.difficulty)
	local multiplier = def.multiplier
	local breakdown = {}

	if result.completed then
		local count = math.max(1, ctx.playerCount or 1)
		local placementPoints = Scoring.PlacementMax
		if count > 1 then
			local step = (Scoring.PlacementMax - Scoring.PlacementMin) / (count - 1)
			placementPoints = Scoring.PlacementMax - (result.placement - 1) * step
		end
		local reference = ctx.timeLimit or ctx.referenceSeconds or 300
		local timePoints = Scoring.TimeMax * clamp01(1 - result.time / reference)
		local optimal = math.max(1, result.optimal or result.startDistance or 1)
		-- After a Server Rig the route is measured from the rig point (effectiveClicks).
		local clicks = result.effectiveClicks or result.clicks
		local efficiencyPoints = Scoring.EfficiencyMax * clamp01(optimal / math.max(clicks, optimal))
		local redoPenalty = math.min(Scoring.RedoPenaltyCap, (result.redos or 0) * Scoring.RedoPenalty)
		breakdown.base = Scoring.Base
		breakdown.placement = math.floor(placementPoints)
		breakdown.time = math.floor(timePoints)
		breakdown.efficiency = math.floor(efficiencyPoints)
		breakdown.redos = -redoPenalty
		local raw = breakdown.base + breakdown.placement + breakdown.time + breakdown.efficiency + breakdown.redos
		breakdown.multiplier = multiplier
		return math.max(0, math.floor(raw * multiplier + 0.5)), breakdown
	end

	local startDistance = result.startDistance or 0
	local best = result.bestDistance or startDistance
	local progress = 0
	if startDistance > 1 and startDistance ~= math.huge and best ~= math.huge then
		progress = clamp01((startDistance - best) / (startDistance - 1))
	end
	local points = Scoring.ProgressMax * progress
	if result.gaveUp and not def.giveUpMode then
		points *= 0.5
	end
	breakdown.progress = math.floor(points)
	breakdown.multiplier = multiplier
	return math.max(0, math.floor(points * multiplier + 0.5)), breakdown
end

-- Ranks and scores a whole round in place.
function Scoring.scoreRound(results, ctx)
	Scoring.rankRound(results)
	ctx = table.clone(ctx)
	ctx.playerCount = #results
	for _, result in results do
		result.score, result.breakdown = Scoring.roundScore(result, ctx)
	end
	return results
end

-- totals: { { userId, score, completedRounds, totalTime, totalClicks, totalRedos, ... } }
function Scoring.standings(totals)
	table.sort(totals, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		if a.completedRounds ~= b.completedRounds then
			return a.completedRounds > b.completedRounds
		end
		if a.totalTime ~= b.totalTime then
			return a.totalTime < b.totalTime
		end
		if a.totalClicks ~= b.totalClicks then
			return a.totalClicks < b.totalClicks
		end
		if a.totalRedos ~= b.totalRedos then
			return a.totalRedos < b.totalRedos
		end
		return a.userId < b.userId
	end)
	for index, entry in totals do
		entry.placement = index
	end
	return totals
end

-- Special awards across a match. rounds: list of per-round result lists. totals: standings.
function Scoring.awards(rounds, totals)
	local fastest, fewestClicks = nil, nil
	for roundIndex, results in rounds do
		for _, result in results do
			if result.completed then
				local entry = {
					userId = result.userId,
					time = result.time,
					clicks = result.clicks,
					round = roundIndex,
				}
				if
					not fastest
					or entry.time < fastest.time
					or (
						entry.time == fastest.time
						and (
							entry.clicks < fastest.clicks
							or (entry.clicks == fastest.clicks and entry.userId < fastest.userId)
						)
					)
				then
					fastest = entry
				end
				if
					not fewestClicks
					or entry.clicks < fewestClicks.clicks
					or (
						entry.clicks == fewestClicks.clicks
						and (
							entry.time < fewestClicks.time
							or (entry.time == fewestClicks.time and entry.userId < fewestClicks.userId)
						)
					)
				then
					fewestClicks = entry
				end
			end
		end
	end

	local fewestRedos = nil
	for _, entry in totals do
		if entry.completedRounds > 0 then
			if
				not fewestRedos
				or entry.totalRedos < fewestRedos.redos
				or (
					entry.totalRedos == fewestRedos.redos
					and (
						entry.completedRounds > fewestRedos.completed
						or (entry.completedRounds == fewestRedos.completed and entry.userId < fewestRedos.userId)
					)
				)
			then
				fewestRedos = { userId = entry.userId, redos = entry.totalRedos, completed = entry.completedRounds }
			end
		end
	end

	return { fastestTime = fastest, fewestClicks = fewestClicks, fewestRedos = fewestRedos }
end

return Scoring
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AchievementService</string>
            <string name="Source"><![CDATA[-- Server-side achievement evaluation. Unlocks are driven only by authoritative race results.

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Achievements = require(Shared.Achievements)
local Net = require(Shared.Net)
local Router = require(script.Parent.Router)
local DataService = require(script.Parent.DataService)

local AchievementService = {}

local SPEED_READER_SECONDS = 45
local COMPLETIONIST = { "SuperEasy", "Easy", "Medium", "Hard", "Extreme" }

function AchievementService.unlock(player: Player, id: string): boolean
	local def = Achievements.ById[id]
	local data = DataService.get(player)
	if not def or not data or data.achievements[id] then
		return false
	end
	DataService.update(player, function(profile)
		profile.achievements[id] = os.time()
		profile.coins += def.coins or 0
	end)
	Router.push(player, Net.Events.Achievement, { id = id })
	local badgeId = Config.Badges[id]
	if badgeId and badgeId ~= 0 then
		task.spawn(pcall, BadgeService.AwardBadge, BadgeService, player.UserId, badgeId)
	end
	return true
end

local function checkCounters(player: Player, stats)
	for _, def in Achievements.List do
		if def.goal and def.stat and (stats[def.stat] or 0) >= def.goal then
			AchievementService.unlock(player, def.id)
		end
	end
end

-- result: authoritative round result for this player; ctx: { difficulty, optimal, rigged }
function AchievementService.onRoundResult(player: Player, result, ctx)
	local data = DataService.get(player)
	if not data then
		return
	end
	if result.reachedBurning then
		AchievementService.unlock(player, "burning")
	end
	if ctx.rigged then
		AchievementService.unlock(player, "rigged")
	end
	if result.gaveUp then
		AchievementService.unlock(player, "honorable_surrender")
	end
	if result.completed then
		AchievementService.unlock(player, "first_race")
		if result.time and result.time < SPEED_READER_SECONDS then
			AchievementService.unlock(player, "speed_reader")
		end
		if result.effectiveClicks and ctx.optimal and result.effectiveClicks <= ctx.optimal then
			AchievementService.unlock(player, "minimalist")
		end
		if (result.redos or 0) == 0 then
			AchievementService.unlock(player, "perfect_run")
		end
		if ctx.difficulty == "Extreme" then
			AchievementService.unlock(player, "extreme_explorer")
		elseif ctx.difficulty == "GiveUp" then
			AchievementService.unlock(player, "give_up_legend")
		end
		local all = true
		for _, key in COMPLETIONIST do
			if (data.stats.difficultyCompletions[key] or 0) == 0 then
				all = false
			end
		end
		if all then
			AchievementService.unlock(player, "completionist")
		end
	end
	checkCounters(player, data.stats)
end

function AchievementService.onMatchWon(player: Player)
	AchievementService.unlock(player, "first_win")
	local data = DataService.get(player)
	if data then
		checkCounters(player, data.stats)
	end
end

function AchievementService.onStatsChanged(player: Player)
	local data = DataService.get(player)
	if data then
		checkCounters(player, data.stats)
	end
end

return AchievementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ChaosService</string>
            <string name="Source"><![CDATA[-- Paid social chaos.
--
-- SERVER RIG (developer product, 199 R$): a loud, server-wide, fully announced effect. Every
-- active race on THIS server is forced into Give Up Mode (new absurd target, zero redos) and
-- rounds starting during a short window are rigged too. Lobby settings are never modified, so
-- every later round returns to the host's configuration. It grants the buyer no stats and
-- removes nobody's progress.
--
-- RIG A PLAYER (developer product, 49 R$ → one "rig credit"): a short, harmless visual/sound
-- gag on one lobby-mate or friend. Jumpscare effects need the Jumpscare Pack game pass (which
-- also allows free jumpscares on a cooldown). Targets can opt out in Settings; hosts can
-- disable targeted chaos per lobby; senders and targets both have cooldowns.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)

local Router = require(script.Parent.Router)
local Validate = require(script.Parent.Validate)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local LobbyService = require(script.Parent.LobbyService)
local ChaosState = require(script.Parent.ChaosState)

local ChaosService = {}

local rigQueue = {}
local rigCooldownUntil = 0
local queueRunning = false
local senderCooldown = {}
local jumpscareCooldown = {}
local targetProtectedUntil = {}
local pendingIntent = {} -- [userId] = { target, effect, at }
local friendCache = {}

local function now()
	return workspace:GetServerTimeNow()
end

local function applyServerRig(entry)
	local t = now()
	ChaosState.rigId += 1
	ChaosState.riggedUntil = t + Config.Chaos.ServerRigWindowSeconds
	ChaosState.riggedBy = entry.name
	rigCooldownUntil = t + Config.Chaos.ServerRigCooldownSeconds

	Router.pushAll(Net.Events.ServerRigged, {
		by = entry.name,
		userId = entry.userId,
		at = t,
		windowEndsAt = ChaosState.riggedUntil,
	})
	for _, lobby in LobbyService.allLobbies() do
		if lobby.match then
			lobby.match:requestRig(entry.name, ChaosState.rigId)
		end
	end
end

local function runQueue()
	if queueRunning then
		return
	end
	queueRunning = true
	task.spawn(function()
		while #rigQueue > 0 do
			local wait = rigCooldownUntil - now()
			if wait > 0 then
				task.wait(wait)
			end
			local entry = table.remove(rigQueue, 1)
			applyServerRig(entry)
		end
		queueRunning = false
	end)
end

function ChaosService.queueServerRig(player: Player)
	table.insert(rigQueue, { userId = player.UserId, name = player.DisplayName })
	local wait = rigCooldownUntil - now()
	if wait > 0 or #rigQueue > 1 then
		Router.toast(
			player,
			("Server Rig queued — it fires in %d seconds!"):format(math.ceil(math.max(wait, 1))),
			"info"
		)
	end
	runQueue()
end

local function isFriend(a: Player, b: Player): boolean
	local key = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	local cached = friendCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
	friendCache[key] = ok and result == true
	return friendCache[key]
end

-- Returns the effect that will actually play, or nil + reason.
local function validateRig(sender: Player, target: Player?, effectId: string?)
	if not target or target == sender then
		return nil, "Pick someone else to rig."
	end
	local effect = effectId and Catalog.ChaosById[effectId]
	if not effect then
		return nil, "Unknown effect."
	end
	local senderLobby = LobbyService.lobbyOf(sender)
	local sameLobby = senderLobby ~= nil and senderLobby == LobbyService.lobbyOf(target)
	if not sameLobby and not isFriend(sender, target) then
		return nil, "You can only rig lobby-mates or friends in this server."
	end
	if sameLobby and senderLobby.settings.allowChaos == false then
		return nil, "The host turned off targeted chaos in this lobby."
	end
	local targetData = DataService.get(target)
	if not targetData or targetData.settings.chaos == false then
		return nil, ("%s has incoming chaos turned off."):format(target.DisplayName)
	end
	if effect.requires and not MonetizationService.ownsPass(sender, effect.requires) then
		return nil, "That effect needs the " .. Config.GamePasses[effect.requires].name .. "."
	end
	local t = now()
	if (senderCooldown[sender.UserId] or 0) > t then
		return nil, ("Cooldown: wait %ds."):format(math.ceil(senderCooldown[sender.UserId] - t))
	end
	if (targetProtectedUntil[target.UserId] or 0) > t then
		return nil,
			("%s was just rigged. Give them %ds!"):format(
				target.DisplayName,
				math.ceil(targetProtectedUntil[target.UserId] - t)
			)
	end
	local played = effect
	if effect.jumpscare and targetData.settings.jumpscares == false then
		-- Respect the target's setting: swap in the harmless dramatic warning.
		played = Catalog.ChaosById.warning
	end
	return played, nil, effect
end

local function deliver(sender: Player, target: Player, effect)
	local t = now()
	senderCooldown[sender.UserId] = t + Config.Chaos.RigPlayerSenderCooldown
	targetProtectedUntil[target.UserId] = t + Config.Chaos.RigPlayerTargetProtection
	Router.push(target, Net.Events.ChaosEffect, {
		effect = effect.id,
		from = sender.DisplayName,
		duration = Config.Chaos.EffectSeconds,
	})
	Router.toast(sender, ("%s %s rigged!"):format(effect.emoji, target.DisplayName), "success")
	local lobby = LobbyService.lobbyOf(sender)
	if lobby then
		for _, userId in lobby.members do
			local member = Players:GetPlayerByUserId(userId)
			if member and member ~= sender and member ~= target then
				Router.toast(
					member,
					("%s %s rigged %s!"):format(effect.emoji, sender.DisplayName, target.DisplayName),
					"muted"
				)
			end
		end
	end
end

-- Uses a free jumpscare (pass holders) or a rig credit.
local function tryRig(sender: Player, targetUserId: number?, effectId: string?)
	local target = targetUserId and Players:GetPlayerByUserId(targetUserId)
	local effect, err, requested = validateRig(sender, target, effectId)
	if not effect then
		return nil, err
	end
	local t = now()
	if
		requested.jumpscare
		and MonetizationService.ownsPass(sender, "Jumpscares")
		and (jumpscareCooldown[sender.UserId] or 0) <= t
	then
		jumpscareCooldown[sender.UserId] = t + Config.Chaos.JumpscareSenderCooldown
		deliver(sender, target, effect)
		return { delivered = true, free = true, substituted = effect ~= requested }
	end
	local data = DataService.get(sender)
	if not data or data.rigCredits <= 0 then
		return { needsPurchase = true }
	end
	DataService.update(sender, function(profile)
		profile.rigCredits -= 1
	end)
	deliver(sender, target, effect)
	return { delivered = true, substituted = effect ~= requested }
end

function ChaosService.init()
	MonetizationService.registerProduct("ServerRig", function(player)
		ChaosService.queueServerRig(player)
		return true
	end)

	MonetizationService.registerProduct("RigPlayer", function(player)
		DataService.update(player, function(profile)
			profile.rigCredits += 1
		end)
		-- Fire the rig the buyer set up before the purchase prompt, if it's still valid.
		local intent = pendingIntent[player.UserId]
		pendingIntent[player.UserId] = nil
		if intent and os.clock() - intent.at < 180 then
			task.defer(function()
				local result, err = tryRig(player, intent.target, intent.effect)
				if not result then
					Router.toast(player, "Rig credit saved: " .. tostring(err), "info")
				end
			end)
		end
		return true
	end)

	Router.on(Net.Actions.SetRigIntent, function(player, payload)
		local target = Validate.userId(payload.userId)
		local effect = Validate.string(payload.effect, 24)
		if not target or not effect then
			return nil, "Invalid rig"
		end
		pendingIntent[player.UserId] = { target = target, effect = effect, at = os.clock() }
		return true
	end, { rate = 2, burst = 4 })

	Router.on(Net.Actions.RigPlayer, function(player, payload)
		return tryRig(player, Validate.userId(payload.userId), Validate.string(payload.effect, 24))
	end, { rate = 1, burst = 3 })

	Players.PlayerRemoving:Connect(function(player)
		pendingIntent[player.UserId] = nil
		senderCooldown[player.UserId] = nil
		jumpscareCooldown[player.UserId] = nil
		targetProtectedUntil[player.UserId] = nil
	end)
end

return ChaosService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ChaosState</string>
            <string name="Source"><![CDATA[-- Shared, server-only state for the Server Rig effect. Written by ChaosService, read by
-- matches when a round starts. It never touches lobby settings: a rigged round simply runs in
-- Give Up Mode, and every later round goes back to the host's configuration.

local ChaosState = {
	rigId = 0,
	riggedUntil = 0,
	riggedBy = nil,
}

function ChaosState.isRigActive(now: number): boolean
	return now < ChaosState.riggedUntil
end

return ChaosState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[-- Cosmetic ownership, purchases (Wiki Coins) and equipping. Purely visual: nothing here can
-- affect race calculations.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)
local Router = require(script.Parent.Router)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local Validate = require(script.Parent.Validate)

local CosmeticService = {}

function CosmeticService.owns(player: Player, itemId: string): boolean
	local item = Catalog.ById[itemId]
	local data = DataService.get(player)
	if not item or not data then
		return false
	end
	if item.requires then
		return MonetizationService.ownsPass(player, item.requires)
	end
	if item.achievement then
		return data.achievements[item.achievement] ~= nil
	end
	if item.price == 0 then
		return true
	end
	return data.owned[itemId] == true
end

-- Equipped items the player no longer owns fall back to the slot default.
function CosmeticService.equipped(player: Player)
	local data = DataService.get(player)
	local result = Catalog.defaults()
	if not data then
		return result
	end
	for slot, itemId in data.equipped do
		local item = Catalog.ById[itemId]
		if item and item.slot == slot and CosmeticService.owns(player, itemId) then
			result[slot] = itemId
		end
	end
	return result
end

-- What OTHER players see: frame, title, badge, victory/podium effects and VIP flag.
function CosmeticService.look(player: Player)
	local equipped = CosmeticService.equipped(player)
	local title = Catalog.ById[equipped.title]
	local badge = Catalog.ById[equipped.badge]
	return {
		frame = equipped.frame,
		title = title and title.text or nil,
		badge = badge and badge.glyph or nil,
		victory = equipped.victory,
		podium = equipped.podium,
		vip = MonetizationService.ownsPass(player, "VIP"),
	}
end

function CosmeticService.addCoins(player: Player, amount: number)
	if amount <= 0 then
		return
	end
	DataService.update(player, function(data)
		data.coins += math.floor(amount)
	end)
end

function CosmeticService.init()
	DataService.addSnapshotProvider(function(player, snap)
		snap.equipped = CosmeticService.equipped(player)
		local owned = {}
		for _, item in Catalog.Items do
			if CosmeticService.owns(player, item.id) then
				owned[item.id] = true
			end
		end
		snap.ownedAll = owned
	end)

	for key, product in Config.Products do
		if product.coins then
			MonetizationService.registerProduct(key, function(player)
				CosmeticService.addCoins(player, product.coins)
				Router.toast(
					player,
					("+%d Wiki Coins! Thanks for supporting Wiki Race."):format(product.coins),
					"success"
				)
				return true
			end)
		end
	end

	Router.on(Net.Actions.EquipItem, function(player, payload)
		local itemId = Validate.string(payload.itemId, 40)
		local item = itemId and Catalog.ById[itemId]
		if not item then
			return nil, "Unknown item"
		end
		if not CosmeticService.owns(player, itemId) then
			return nil, "You don't own that yet"
		end
		DataService.update(player, function(data)
			data.equipped[item.slot] = itemId
		end)
		return CosmeticService.equipped(player)
	end, { rate = 4, burst = 10 })

	Router.on(Net.Actions.BuyItem, function(player, payload)
		local itemId = Validate.string(payload.itemId, 40)
		local item = itemId and Catalog.ById[itemId]
		local data = DataService.get(player)
		if not item or not data then
			return nil, "Unknown item"
		end
		if item.requires then
			return nil, "This item comes with the " .. Config.GamePasses[item.requires].name .. " pass"
		end
		if item.achievement then
			return nil, "Unlock this with an achievement"
		end
		if CosmeticService.owns(player, itemId) then
			return nil, "Already owned"
		end
		if data.coins < item.price then
			return nil, ("You need %d more Wiki Coins"):format(item.price - data.coins)
		end
		DataService.update(player, function(profile)
			profile.coins -= item.price
			profile.owned[itemId] = true
			profile.equipped[item.slot] = itemId
		end)
		task.spawn(DataService.saveNow, player)
		return { itemId = itemId, coins = data.coins }
	end, { rate = 2, burst = 4 })
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Persistent player profiles.
--
-- * Session-locked: a profile is claimed by one server (JobId) at a time, so two servers can
--   never overwrite each other's progress.
-- * Autosaved, saved on leave and on shutdown (BindToClose).
-- * If DataStores are unavailable (e.g. an unpublished place in Studio) the game keeps working
--   with in-memory profiles and tells the player progress won't be saved.
-- * Only the server writes profiles. Clients receive read-only snapshots.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Ranks = require(Shared.Ranks)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)
local Router = require(script.Parent.Router)

local DataService = {}
DataService.ProfileLoaded = Signal.new()

local store = nil
local memoryMode = false
local records = {} -- [Player] = { data, dirty, offline, loaded }
local snapshotProviders = {}
local pushScheduled = {}

local function template()
	return {
		version = 1,
		stats = {
			races = 0,
			matches = 0,
			wins = 0,
			roundWins = 0,
			completions = 0,
			giveUps = 0,
			totalClicks = 0,
			totalRedos = 0,
			fastestTime = nil,
			fewestClicks = nil,
			bestRoundScore = 0,
			totalScore = 0,
			difficultyCompletions = {},
			burningReached = 0,
			freeRoamPages = 0,
			rigsSurvived = 0,
			recordsSet = 0,
		},
		achievements = {},
		coins = 0,
		owned = {},
		equipped = Catalog.defaults(),
		settings = {
			sfx = 0.8,
			jumpscares = true,
			chaos = true,
			reducedMotion = false,
			hints = true,
		},
		rigCredits = 0,
		receipts = {},
		receiptOrder = {},
		firstJoin = os.time(),
	}
end

-- Adds any fields introduced by newer versions without touching existing values.
local function reconcile(data, defaults)
	for key, value in defaults do
		if data[key] == nil then
			data[key] = type(value) == "table" and table.clone(value) or value
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local function keyFor(userId: number): string
	return "user_" .. userId
end

local function takeSession(key: string)
	local claimed = false
	local ok, result = pcall(function()
		return store:UpdateAsync(key, function(old)
			old = old or template()
			local lock = old._lock
			if lock and lock.job ~= game.JobId and os.time() - (lock.t or 0) < Config.Data.SessionLockSeconds then
				claimed = false
				return nil -- someone else holds it; don't write
			end
			old._lock = { job = game.JobId, t = os.time() }
			claimed = true
			return old
		end)
	end)
	return ok, claimed, result
end

local function loadProfile(player: Player)
	if memoryMode then
		return reconcile(template(), template()), false
	end
	local key = keyFor(player.UserId)
	for attempt = 1, 7 do
		local ok, claimed, result = takeSession(key)
		if ok and claimed and type(result) == "table" then
			return reconcile(result, template()), false
		end
		if not player.Parent then
			return nil, false
		end
		if ok and not claimed and attempt >= 5 then
			-- The other server is almost certainly gone; steal the stale lock.
			local stolen = false
			local stealOk, stealResult = pcall(function()
				return store:UpdateAsync(key, function(old)
					old = old or template()
					old._lock = { job = game.JobId, t = os.time() }
					stolen = true
					return old
				end)
			end)
			if stealOk and stolen and type(stealResult) == "table" then
				return reconcile(stealResult, template()), false
			end
		end
		task.wait(math.min(2 ^ attempt * 0.5, 10))
	end
	return reconcile(template(), template()), true
end

local function saveProfile(player: Player, release: boolean): boolean
	local record = records[player]
	if not record or record.offline or memoryMode or not record.loaded then
		return true
	end
	local data = record.data
	local key = keyFor(player.UserId)
	local lostLock = false
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			if old and old._lock and old._lock.job ~= game.JobId then
				lostLock = true
				return nil
			end
			if release then
				data._lock = nil
			else
				data._lock = { job = game.JobId, t = os.time() }
			end
			return data
		end)
	end)
	if not ok then
		warn(("[WikiRace] Save failed for %s: %s"):format(player.Name, tostring(err)))
		return false
	end
	if lostLock then
		warn(("[WikiRace] %s's profile is owned by another server; not overwriting."):format(player.Name))
		record.offline = true
		return false
	end
	record.dirty = false
	return true
end

function DataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.ProfileStore)
	end)
	if ok then
		store = result
		-- Probe access; unpublished places in Studio throw here.
		local probeOk = pcall(function()
			store:GetAsync("__probe")
		end)
		if not probeOk then
			memoryMode = true
		end
	else
		memoryMode = true
	end
	if memoryMode then
		warn("[WikiRace] DataStores unavailable — using in-memory profiles (progress will not persist).")
	end

	local function onPlayerAdded(player: Player)
		local data, offline = loadProfile(player)
		if not player.Parent or not data then
			return
		end
		data.lastJoin = os.time()
		records[player] = { data = data, dirty = true, offline = offline or memoryMode, loaded = true }
		DataService.ProfileLoaded:Fire(player, data)
		DataService.pushProfile(player)
		if offline then
			Router.toast(
				player,
				"Couldn't load your saved progress. Playing with a temporary profile this session.",
				"error"
			)
		elseif memoryMode and RunService:IsStudio() then
			Router.toast(player, "Studio: DataStores disabled — stats reset when you stop.", "info")
		end
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		saveProfile(player, true)
		records[player] = nil
		pushScheduled[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveSeconds)
			for player, record in records do
				if record.dirty then
					task.spawn(saveProfile, player, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and memoryMode then
			return
		end
		local pending = 0
		for player in records do
			pending += 1
			task.spawn(function()
				saveProfile(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Router.on(Net.Actions.UpdateSettings, function(player, payload)
		local data = DataService.get(player)
		if not data then
			return nil, "Profile still loading"
		end
		local settings = data.settings
		if type(payload.sfx) == "number" and payload.sfx == payload.sfx then
			settings.sfx = math.clamp(payload.sfx, 0, 1)
		end
		for _, key in { "jumpscares", "chaos", "reducedMotion", "hints" } do
			if type(payload[key]) == "boolean" then
				settings[key] = payload[key]
			end
		end
		DataService.markChanged(player)
		return settings
	end, { rate = 2, burst = 6 })
end

function DataService.isPersistent(): boolean
	return not memoryMode
end

function DataService.get(player: Player)
	local record = records[player]
	return record and record.data or nil
end

function DataService.waitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 15)
	while player.Parent and os.clock() < deadline do
		local data = DataService.get(player)
		if data then
			return data
		end
		task.wait(0.1)
	end
	return DataService.get(player)
end

-- Mutates a profile through a callback, marks it dirty and schedules a client refresh.
function DataService.update(player: Player, mutate)
	local record = records[player]
	if not record then
		return false
	end
	mutate(record.data)
	record.dirty = true
	DataService.markChanged(player)
	return true
end

function DataService.markChanged(player: Player)
	local record = records[player]
	if record then
		record.dirty = true
	end
	if pushScheduled[player] then
		return
	end
	pushScheduled[player] = true
	task.delay(0.2, function()
		pushScheduled[player] = nil
		if player.Parent then
			DataService.pushProfile(player)
		end
	end)
end

function DataService.saveNow(player: Player): boolean
	return saveProfile(player, false)
end

-- Other services add fields (game passes, derived ownership) to the client snapshot.
function DataService.addSnapshotProvider(provider)
	table.insert(snapshotProviders, provider)
end

function DataService.snapshot(player: Player)
	local data = DataService.get(player)
	if not data then
		return nil
	end
	local rank, nextRank, progress, xp = Ranks.fromStats(data.stats)
	local snap = {
		userId = player.UserId,
		coins = data.coins,
		owned = data.owned,
		equipped = data.equipped,
		settings = data.settings,
		stats = data.stats,
		achievements = data.achievements,
		rigCredits = data.rigCredits,
		rank = {
			key = rank.key,
			name = rank.name,
			emoji = rank.emoji,
			xp = xp,
			floor = rank.xp,
			next = nextRank and nextRank.xp or nil,
			nextName = nextRank and nextRank.name or nil,
			progress = progress,
		},
		persistent = not memoryMode and not (records[player] and records[player].offline),
	}
	for _, provider in snapshotProviders do
		provider(player, snap)
	end
	return snap
end

function DataService.pushProfile(player: Player)
	local snap = DataService.snapshot(player)
	if snap then
		Router.push(player, Net.Events.Profile, snap)
	end
end

-- Read-only lookup of an offline player's saved profile (used by "inspect player").
function DataService.readOffline(userId: number)
	if memoryMode or not store then
		return nil
	end
	local ok, result = pcall(function()
		return store:GetAsync(keyFor(userId))
	end)
	if ok and type(result) == "table" then
		return reconcile(result, template())
	end
	return nil
end

-- Idempotent developer-product bookkeeping.
function DataService.hasReceipt(player: Player, purchaseId: string): boolean
	local data = DataService.get(player)
	return data ~= nil and data.receipts[purchaseId] == true
end

function DataService.recordReceipt(player: Player, purchaseId: string)
	DataService.update(player, function(data)
		data.receipts[purchaseId] = true
		table.insert(data.receiptOrder, purchaseId)
		while #data.receiptOrder > Config.Data.MaxReceiptHistory do
			local oldest = table.remove(data.receiptOrder, 1)
			data.receipts[oldest] = nil
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">FreeRoamService</string>
            <string name="Source"><![CDATA[-- Free Roam practice: untimed browsing with search, categories, random pages, and full
-- back/forward/refresh/history. Search and arbitrary jumps are only available here — never
-- during a race, where the only way to move is to follow a real link.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Net = require(Shared.Net)

local Router = require(script.Parent.Router)
local Validate = require(script.Parent.Validate)
local WikiService = require(script.Parent.WikiService)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)
local LobbyService = require(script.Parent.LobbyService)
local RaceSession = require(script.Parent.Parent.Race.RaceSession)

local FreeRoamService = {}

local sessions = {} -- [userId] = RaceSession (mode "free")
local rng = Random.new()

local function result(session)
	return {
		page = WikiService.repo:payload(session:current()),
		state = session:snapshot(),
	}
end

local function countVisit(player: Player, before: number, session)
	if session.visitedCount <= before then
		return
	end
	local visits = 0
	DataService.update(player, function(data)
		data.stats.freeRoamPages += 1
		visits = data.stats.freeRoamPages
		if visits % 10 == 0 then
			data.coins += Config.Coins.FreeRoamPerTenPages
		end
	end)
	AchievementService.onStatsChanged(player)
end

-- Arbitrary jumps (search results, categories, random) are free-roam only.
local function jump(session, pageId: string)
	session.history:push(pageId)
	session:_arrive(os.clock())
end

function FreeRoamService.init()
	local A = Net.Actions

	Router.on(A.StartFreeRoam, function(player, payload)
		local pageId = Validate.id(payload.pageId)
		if not pageId or not WikiService.repo:exists(pageId) then
			pageId = WikiService.repo:randomId(rng)
		end
		local session = RaceSession.new({ graph = WikiService.graph, start = pageId, mode = "free" })
		sessions[player.UserId] = session
		return result(session)
	end, { rate = 1, burst = 3 })

	Router.on(A.FreeNavigate, function(player, payload)
		local session = sessions[player.UserId]
		if not session then
			return nil, "Free Roam isn't open."
		end
		local op = Validate.string(payload.op, 12)
		local before = session.visitedCount
		if op == "open" then
			local pageId = Validate.id(payload.pageId)
			if not pageId or not WikiService.repo:exists(pageId) then
				return nil, "That page doesn't exist."
			end
			jump(session, pageId)
		elseif op == "random" then
			jump(session, WikiService.repo:randomId(rng))
		else
			if not op or not RaceSession.Ops[op] or op == "restart" then
				return nil, "Unknown action."
			end
			local argument = nil
			if op == "link" or op == "history" then
				argument = Validate.id(payload.pageId)
			end
			local ok, err = session:apply(op, argument, os.clock())
			if not ok then
				return nil, err == "NotALink" and "That link isn't on this page." or "Can't go there."
			end
		end
		countVisit(player, before, session)
		return result(session)
	end, { rate = 8, burst = 14 })

	Router.on(A.Search, function(player, payload)
		if LobbyService.isRacing(player) then
			return nil, "Search is disabled during races — follow the links!"
		end
		local query = Validate.string(payload.query, 60)
		if not query then
			return {}
		end
		return WikiService.repo:search(query, 12)
	end, { rate = 5, burst = 10 })

	Router.on(A.GetCategory, function(player, payload)
		if LobbyService.isRacing(player) then
			return nil, "Categories can't be browsed during a race."
		end
		local name = Validate.string(payload.name, 60)
		if not name then
			return { categories = WikiService.repo:categoryList() }
		end
		local category = WikiService.repo:category(name)
		if not category then
			return nil, "Unknown category."
		end
		return category
	end, { rate = 3, burst = 6 })

	Router.on(A.StartSoloRace, function(player, payload)
		local difficulty = payload.difficulty
		if not Difficulty.isValid(difficulty) then
			return nil, "Pick a difficulty."
		end
		local fixedStart = nil
		if payload.fromCurrent == true then
			local session = sessions[player.UserId]
			fixedStart = session and session:current()
		end
		return LobbyService.startSolo(player, difficulty, fixedStart)
	end, { rate = 0.5, burst = 2 })

	Players.PlayerRemoving:Connect(function(player)
		sessions[player.UserId] = nil
	end)
end

return FreeRoamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ImageService</string>
            <string name="Source"><![CDATA[-- Serves page photos. Photos live in 1024×1024 sprite atlases (16 tiles of 256 px) uploaded to
-- Roblox by tools/images/upload_atlases.py. Decal ids are resolved to image ids on the server
-- with InsertService (works for assets owned by the game's creator), then cached.

local InsertService = game:GetService("InsertService")

local Images = script.Parent.Parent.Images
local Manifest = require(Images.Manifest)
local AssetIds = require(Images.AssetIds)

local ImageService = {}
ImageService.resolved = {} -- atlas index → "rbxassetid://…"
ImageService.photos = Manifest.photos or {}

local function resolveDecal(decalId: number): string?
	local ok, model = pcall(InsertService.LoadAsset, InsertService, decalId)
	if not ok or not model then
		return nil
	end
	local texture
	for _, child in model:GetDescendants() do
		if child:IsA("Decal") or child:IsA("Texture") then
			texture = child.Texture
			break
		end
	end
	model:Destroy()
	return texture
end

function ImageService.init()
	for index, entry in AssetIds do
		if type(entry) == "table" and entry.image then
			ImageService.resolved[index] = "rbxassetid://" .. tostring(entry.image)
		end
	end
	task.spawn(function()
		for index, entry in AssetIds do
			if type(entry) == "table" and entry.decal and not ImageService.resolved[index] then
				ImageService.resolved[index] = resolveDecal(entry.decal)
				task.wait(0.05)
			end
		end
	end)
end

-- photoResolver for WikiRepository: node → { image, x, y, size, credit } or nil.
function ImageService.resolve(node)
	local photo = node.photo
	if not photo then
		return nil
	end
	local image = ImageService.resolved[photo.atlas]
	if not image then
		return nil
	end
	local size = Manifest.tileSize or 256
	local perRow = Manifest.perRow or 4
	local slot = photo.slot - 1
	return {
		image = image,
		x = (slot % perRow) * size,
		y = (slot // perRow) * size,
		size = size,
		credit = photo.credit,
	}
end

return ImageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Global leaderboards (OrderedDataStores) for wins, completions and rank XP, plus the
-- GetLeaderboards / GetProfile requests. Writes are throttled per player; reads are cached.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Ranks = require(Shared.Ranks)
local Net = require(Shared.Net)
local Router = require(script.Parent.Router)
local DataService = require(script.Parent.DataService)
local CosmeticService = require(script.Parent.CosmeticService)
local RecordService = require(script.Parent.RecordService)
local Validate = require(script.Parent.Validate)

local LeaderboardService = {}

local ordered = {} -- board → OrderedDataStore
local boards = { wins = {}, completions = {}, xp = {} }
local lastWrite = {}
local nameCache = {}
local profileCache = {}

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function valuesFor(data)
	return {
		wins = data.stats.wins,
		completions = data.stats.completions,
		xp = Ranks.xpFromStats(data.stats),
	}
end

local function refresh()
	for board, store in ordered do
		local ok, pages = pcall(store.GetSortedAsync, store, false, Config.Leaderboards.Size)
		if ok then
			local rows = {}
			for index, entry in pages:GetCurrentPage() do
				local userId = tonumber(entry.key)
				if userId then
					table.insert(rows, { rank = index, userId = userId, name = nameOf(userId), value = entry.value })
				end
			end
			boards[board] = rows
		end
	end
	if next(ordered) == nil then
		-- Studio / no DataStores: build boards from players on this server.
		for _, board in { "wins", "completions", "xp" } do
			local rows = {}
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data then
					table.insert(
						rows,
						{ userId = player.UserId, name = player.DisplayName, value = valuesFor(data)[board] }
					)
				end
			end
			table.sort(rows, function(a, b)
				return a.value > b.value
			end)
			for index, row in rows do
				row.rank = index
			end
			boards[board] = rows
		end
	end
end

function LeaderboardService.submit(player: Player)
	local data = DataService.get(player)
	if not data or next(ordered) == nil then
		return
	end
	local now = os.clock()
	if lastWrite[player.UserId] and now - lastWrite[player.UserId] < 60 then
		return
	end
	lastWrite[player.UserId] = now
	local values = valuesFor(data)
	task.spawn(function()
		for board, store in ordered do
			pcall(store.SetAsync, store, tostring(player.UserId), values[board])
		end
	end)
end

local function publicProfile(userId: number)
	local player = Players:GetPlayerByUserId(userId)
	local data, look, name, displayName
	if player then
		data = DataService.get(player)
		look = CosmeticService.look(player)
		name, displayName = player.Name, player.DisplayName
	else
		local cached = profileCache[userId]
		if cached and os.clock() - cached.at < 120 then
			return cached.profile
		end
		data = DataService.readOffline(userId)
		name = nameOf(userId)
		displayName = name
	end
	if not data then
		return nil
	end
	local rank, _, progress, xp = Ranks.fromStats(data.stats)
	local profile = {
		userId = userId,
		name = name,
		displayName = displayName,
		online = player ~= nil,
		stats = data.stats,
		achievements = data.achievements,
		equipped = player and CosmeticService.equipped(player) or data.equipped,
		look = look,
		rank = { name = rank.name, emoji = rank.emoji, xp = xp, progress = progress },
	}
	if not player then
		profileCache[userId] = { profile = profile, at = os.clock() }
	end
	return profile
end

function LeaderboardService.init()
	if DataService.isPersistent() then
		for board, storeName in
			{
				wins = Config.Leaderboards.Stores.Wins,
				completions = Config.Leaderboards.Stores.Completions,
				xp = Config.Leaderboards.Stores.XP,
			}
		do
			local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, storeName)
			if ok then
				ordered[board] = store
			end
		end
	end
	task.spawn(function()
		while true do
			refresh()
			task.wait(next(ordered) and Config.Leaderboards.RefreshSeconds or 30)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastWrite[player.UserId] = nil
		LeaderboardService.submit(player)
	end)

	Router.on(Net.Actions.GetLeaderboards, function()
		if next(ordered) == nil then
			refresh()
		end
		return { boards = boards, records = RecordService.all() }
	end, { rate = 1, burst = 3 })

	Router.on(Net.Actions.GetProfile, function(player, payload)
		local userId = Validate.userId(payload.userId) or player.UserId
		local profile = publicProfile(userId)
		if not profile then
			return nil, "That profile isn't available right now"
		end
		return profile
	end, { rate = 2, burst = 5 })
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">LobbyDirectory</string>
            <string name="Source"><![CDATA[-- Cross-server lobby directory backed by MemoryStore.
--
-- Every server publishes its lobbies (with a short TTL) so the public lobby browser can list
-- lobbies on other servers and lobby codes work across servers: joining a code that lives
-- elsewhere teleports the player straight into that server, where they auto-join by code.
-- Disabled in Studio (no JobId / teleports), where lobbies are simply local.

local MemoryStoreService = game:GetService("MemoryStoreService")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("WikiRaceShared").Config)

local LobbyDirectory = {}

local enabled = false
local map = nil
local remoteCache = { list = {}, at = 0 }

local function entryFor(lobby)
	return {
		jobId = game.JobId,
		placeId = game.PlaceId,
		code = lobby.code,
		name = lobby.name,
		isPublic = lobby.isPublic,
		count = #lobby.members,
		max = Config.Lobby.MaxPlayers,
		difficulty = lobby.settings.difficulty,
		rounds = lobby.settings.rounds,
		timer = lobby.settings.timer,
		customSeconds = lobby.settings.customSeconds,
		state = lobby.state,
	}
end

function LobbyDirectory.init(getLobbies)
	if RunService:IsStudio() or game.JobId == "" then
		return
	end
	local ok, result = pcall(MemoryStoreService.GetSortedMap, MemoryStoreService, "WikiRaceLobbies_v1")
	if not ok then
		warn("[WikiRace] Lobby directory unavailable: " .. tostring(result))
		return
	end
	map = result
	enabled = true
	task.spawn(function()
		while true do
			for _, lobby in getLobbies() do
				if not lobby.solo and #lobby.members > 0 then
					pcall(map.SetAsync, map, lobby.code, entryFor(lobby), Config.Lobby.DirectoryTTL)
				end
				task.wait(0.2)
			end
			task.wait(Config.Lobby.DirectoryRefresh)
		end
	end)
end

function LobbyDirectory.publish(lobby)
	if enabled and not lobby.solo then
		task.spawn(pcall, map.SetAsync, map, lobby.code, entryFor(lobby), Config.Lobby.DirectoryTTL)
	end
end

function LobbyDirectory.remove(code: string)
	if enabled then
		task.spawn(pcall, map.RemoveAsync, map, code)
	end
end

-- Public lobbies on OTHER servers (cached for a few seconds).
function LobbyDirectory.listRemote()
	if not enabled then
		return {}
	end
	if os.clock() - remoteCache.at < 8 then
		return remoteCache.list
	end
	remoteCache.at = os.clock()
	local ok, items = pcall(map.GetRangeAsync, map, Enum.SortDirection.Ascending, 100)
	if not ok then
		return remoteCache.list
	end
	local list = {}
	for _, item in items do
		local value = item.value
		if
			type(value) == "table"
			and value.isPublic
			and value.jobId ~= game.JobId
			and value.count < value.max
			and value.count > 0
		then
			value.remote = true
			table.insert(list, value)
		end
	end
	remoteCache.list = list
	return list
end

function LobbyDirectory.lookup(code: string)
	if not enabled then
		return nil
	end
	local ok, value = pcall(map.GetAsync, map, code)
	if ok and type(value) == "table" and value.jobId ~= game.JobId then
		return value
	end
	return nil
end

function LobbyDirectory.teleport(player: Player, entry): (boolean, string?)
	local options = Instance.new("TeleportOptions")
	options.ServerInstanceId = entry.jobId
	options:SetTeleportData({ lobbyCode = entry.code })
	local ok, err = pcall(TeleportService.TeleportAsync, TeleportService, entry.placeId, { player }, options)
	if not ok then
		return false, tostring(err)
	end
	return true
end

return LobbyDirectory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[-- Lobbies (up to 10 players), matchmaking, host permissions and match routing.
--
-- * Public lobbies appear in the browser (this server + other servers via LobbyDirectory).
--   "Standing" public lobbies exist on every server and survive being empty; any lobby migrates
--   its host when the host leaves, keeping settings and players, and public lobbies can also
--   auto-start when every member is ready — so they never depend on one permanent host.
-- * Private lobbies are joined with a 6-character code or a friend invite.
-- * Only the host may change settings, kick, transfer host, start/end the match or skip results.
-- * All race requests (Navigate / GiveUp) are routed to the player's current match.

local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Ranks = require(Shared.Ranks)
local Net = require(Shared.Net)

local Router = require(script.Parent.Router)
local Validate = require(script.Parent.Validate)
local DataService = require(script.Parent.DataService)
local CosmeticService = require(script.Parent.CosmeticService)
local LobbyDirectory = require(script.Parent.LobbyDirectory)
local BannedFilter = require(script.Parent.Parent.Wiki.BannedFilter)
local Match = require(script.Parent.Parent.Race.Match)
local RaceSession = require(script.Parent.Parent.Race.RaceSession)

local LobbyService = {}

local lobbies = {} -- id → lobby
local byCode = {} -- code → lobby
local membership = {} -- userId → lobby
local dirty = {}
local flushScheduled = false
local listDirty = false
local lastListPush = 0
local nextId = 0
local codeRng = Random.new()

local function defaultSettings(overrides)
	local settings = {
		difficulty = "Easy",
		timer = Config.Race.DefaultTimer,
		customSeconds = Config.Race.DefaultCustomSeconds,
		rounds = Config.Race.DefaultRounds,
		showMeters = true,
		showPages = false,
		allowChaos = true,
	}
	for key, value in overrides or {} do
		settings[key] = value
	end
	return settings
end

local function newCode(): string
	local alphabet = Config.Lobby.CodeAlphabet
	for _ = 1, 50 do
		local chars = table.create(Config.Lobby.CodeLength)
		for i = 1, Config.Lobby.CodeLength do
			local index = codeRng:NextInteger(1, #alphabet)
			chars[i] = string.sub(alphabet, index, index)
		end
		local code = table.concat(chars)
		if not byCode[code] and not BannedFilter.isBanned(code) then
			return code
		end
	end
	error("could not allocate lobby code")
end

local function filterName(player: Player, raw: string?): string
	local fallback = player.DisplayName .. "'s Lobby"
	local name = raw and Validate.string(raw, Config.Lobby.NameMaxLength)
	if not name then
		return fallback
	end
	name = name:gsub("[%c]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" or BannedFilter.isBanned(name) then
		return fallback
	end
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(name, player.UserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok or type(result) ~= "string" or result == "" then
		return fallback
	end
	return result
end

local function markDirty(lobby)
	dirty[lobby] = true
	listDirty = true
	if flushScheduled then
		return
	end
	flushScheduled = true
	task.defer(function()
		flushScheduled = false
		local batch = dirty
		dirty = {}
		for changed in batch do
			if lobbies[changed.id] then
				local snap = LobbyService.snapshot(changed)
				for _, userId in changed.members do
					local player = Players:GetPlayerByUserId(userId)
					if player then
						Router.push(player, Net.Events.LobbyState, snap)
					end
				end
			end
		end
	end)
end

local function playerCard(lobby, userId: number)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return nil
	end
	local data = DataService.get(player)
	local rank = data and Ranks.fromStats(data.stats) or Ranks.List[1]
	return {
		userId = userId,
		name = player.Name,
		displayName = player.DisplayName,
		isHost = lobby.hostId == userId,
		ready = lobby.ready[userId] == true,
		look = CosmeticService.look(player),
		rank = { name = rank.name, emoji = rank.emoji },
	}
end

function LobbyService.snapshot(lobby)
	local members = {}
	for _, userId in lobby.members do
		local card = playerCard(lobby, userId)
		if card then
			table.insert(members, card)
		end
	end
	return {
		id = lobby.id,
		code = lobby.code,
		name = lobby.name,
		isPublic = lobby.isPublic,
		standing = lobby.standing,
		solo = lobby.solo,
		hostId = lobby.hostId,
		state = lobby.state,
		settings = lobby.settings,
		members = members,
		maxPlayers = Config.Lobby.MaxPlayers,
		match = lobby.match and lobby.match:summary() or nil,
		autoStartAt = lobby.autoStartAt,
	}
end

local function summary(lobby)
	return {
		id = lobby.id,
		code = lobby.isPublic and lobby.code or nil,
		name = lobby.name,
		count = #lobby.members,
		max = Config.Lobby.MaxPlayers,
		difficulty = lobby.settings.difficulty,
		rounds = lobby.settings.rounds,
		timer = lobby.settings.timer,
		customSeconds = lobby.settings.customSeconds,
		state = lobby.state,
		standing = lobby.standing,
		match = lobby.match and lobby.match:summary() or nil,
	}
end

function LobbyService.listPublic()
	local list = {}
	for _, lobby in lobbies do
		if lobby.isPublic and not lobby.solo then
			table.insert(list, summary(lobby))
		end
	end
	table.sort(list, function(a, b)
		if a.count ~= b.count then
			return a.count > b.count
		end
		return a.id < b.id
	end)
	for _, remote in LobbyDirectory.listRemote() do
		table.insert(list, remote)
	end
	return list
end

local function pushListToBrowsers(force: boolean)
	if not listDirty and not force then
		return
	end
	if not force and os.clock() - lastListPush < 1 then
		return
	end
	listDirty = false
	lastListPush = os.clock()
	local list = nil
	for _, player in Players:GetPlayers() do
		if not membership[player.UserId] then
			list = list or LobbyService.listPublic()
			Router.push(player, Net.Events.LobbyList, list)
		end
	end
end

local function createLobby(options)
	nextId += 1
	local lobby = {
		id = "L" .. nextId,
		code = newCode(),
		name = options.name,
		isPublic = options.isPublic == true,
		standing = options.standing == true,
		solo = options.solo == true,
		hostId = nil,
		members = {},
		ready = {},
		kicked = {},
		settings = defaultSettings(options.settings),
		state = "Waiting",
		match = nil,
		createdAt = os.time(),
	}
	lobbies[lobby.id] = lobby
	byCode[lobby.code] = lobby
	LobbyDirectory.publish(lobby)
	listDirty = true
	return lobby
end

local function destroyLobby(lobby)
	if lobby.match then
		lobby.match:abort()
	end
	lobbies[lobby.id] = nil
	byCode[lobby.code] = nil
	LobbyDirectory.remove(lobby.code)
	listDirty = true
end

function LobbyService.lobbyOf(player: Player)
	return membership[player.UserId]
end

function LobbyService.allLobbies()
	local list = {}
	for _, lobby in lobbies do
		table.insert(list, lobby)
	end
	return list
end

local function cancelAutoStart(lobby)
	if lobby.autoStartAt then
		lobby.autoStartAt = nil
		markDirty(lobby)
	end
end

local function leave(player: Player, reason: string?)
	local lobby = membership[player.UserId]
	if not lobby then
		return
	end
	membership[player.UserId] = nil
	local index = table.find(lobby.members, player.UserId)
	if index then
		table.remove(lobby.members, index)
	end
	lobby.ready[player.UserId] = nil
	if lobby.match then
		lobby.match:onPlayerLeft(player.UserId)
	end
	if lobby.hostId == player.UserId then
		-- Host migration: the longest-standing member inherits the lobby and its settings.
		lobby.hostId = lobby.members[1]
		local newHost = lobby.hostId and Players:GetPlayerByUserId(lobby.hostId)
		if newHost then
			for _, userId in lobby.members do
				local member = Players:GetPlayerByUserId(userId)
				if member then
					Router.toast(member, ("👑 %s is now the host."):format(newHost.DisplayName), "info")
				end
			end
		end
	end
	cancelAutoStart(lobby)
	if #lobby.members == 0 then
		if lobby.match then
			lobby.match:abort()
		end
		if lobby.standing then
			lobby.hostId = nil
			lobby.state = lobby.match and lobby.state or "Waiting"
		else
			destroyLobby(lobby)
		end
	else
		for _, userId in lobby.members do
			local member = Players:GetPlayerByUserId(userId)
			if member and reason ~= "silent" then
				Router.toast(member, ("%s left the lobby."):format(player.DisplayName), "muted")
			end
		end
	end
	if player.Parent then
		Router.push(player, Net.Events.LobbyLeft, { reason = reason or "left" })
	end
	markDirty(lobby)
end

local function join(player: Player, lobby)
	if membership[player.UserId] == lobby then
		return LobbyService.snapshot(lobby)
	end
	if #lobby.members >= Config.Lobby.MaxPlayers then
		return nil, "That lobby is full."
	end
	local kickedUntil = lobby.kicked[player.UserId]
	if kickedUntil and os.clock() < kickedUntil then
		return nil, "You were removed from that lobby. Try again later."
	end
	leave(player, "silent")
	table.insert(lobby.members, player.UserId)
	membership[player.UserId] = lobby
	lobby.ready[player.UserId] = false
	if not lobby.hostId then
		lobby.hostId = player.UserId
	end
	cancelAutoStart(lobby)
	for _, userId in lobby.members do
		local member = Players:GetPlayerByUserId(userId)
		if member and member ~= player then
			Router.toast(member, ("%s joined the lobby."):format(player.DisplayName), "muted")
		end
	end
	if lobby.match then
		Router.toast(player, "A match is in progress — you'll join at the next round.", "info")
	end
	markDirty(lobby)
	return LobbyService.snapshot(lobby)
end

local function isHost(player: Player, lobby): boolean
	return lobby ~= nil and lobby.hostId == player.UserId
end

local function startMatch(lobby, options)
	if lobby.match or lobby.state ~= "Waiting" then
		return nil, "A match is already running."
	end
	if #lobby.members == 0 then
		return nil, "Nobody is here!"
	end
	lobby.autoStartAt = nil
	lobby.state = "InMatch"
	local match
	match = Match.new(lobby, {
		onEnded = function()
			if lobby.match == match then
				lobby.match = nil
				lobby.state = "Waiting"
				for userId in lobby.ready do
					lobby.ready[userId] = false
				end
				markDirty(lobby)
			end
		end,
		onChanged = function()
			markDirty(lobby)
		end,
	}, options)
	lobby.match = match
	match:start()
	markDirty(lobby)
	return true
end

local function checkAutoStart(lobby)
	if not lobby.isPublic or lobby.solo or lobby.state ~= "Waiting" or #lobby.members < 2 then
		cancelAutoStart(lobby)
		return
	end
	for _, userId in lobby.members do
		if not lobby.ready[userId] then
			cancelAutoStart(lobby)
			return
		end
	end
	if lobby.autoStartAt then
		return
	end
	local startAt = workspace:GetServerTimeNow() + Config.Lobby.PublicAutoStartSeconds
	lobby.autoStartAt = startAt
	markDirty(lobby)
	task.delay(Config.Lobby.PublicAutoStartSeconds, function()
		if lobby.autoStartAt == startAt and lobbies[lobby.id] then
			startMatch(lobby)
		end
	end)
end

-- Settings patch validation: anything invalid is rejected, never coerced into something odd.
local function validatePatch(lobby, patch)
	local clean = {}
	if patch.difficulty ~= nil then
		if not Difficulty.isValid(patch.difficulty) then
			return nil, "Invalid difficulty"
		end
		clean.difficulty = patch.difficulty
	end
	if patch.timer ~= nil then
		if not Validate.oneOf(patch.timer, Config.Race.TimerOptions) then
			return nil, "Invalid timer"
		end
		clean.timer = patch.timer
	end
	if patch.customSeconds ~= nil then
		local seconds = Validate.integer(patch.customSeconds, Config.Race.CustomTimerMin, Config.Race.CustomTimerMax)
		if not seconds then
			return nil,
				("Custom time must be a whole number of seconds between %d and %d"):format(
					Config.Race.CustomTimerMin,
					Config.Race.CustomTimerMax
				)
		end
		clean.customSeconds = seconds
	end
	if patch.rounds ~= nil then
		if not Validate.oneOf(patch.rounds, Config.Race.RoundOptions) then
			return nil, "Invalid round count"
		end
		clean.rounds = patch.rounds
	end
	for _, key in { "showMeters", "showPages", "allowChaos" } do
		if patch[key] ~= nil then
			if type(patch[key]) ~= "boolean" then
				return nil, "Invalid " .. key
			end
			clean[key] = patch[key]
		end
	end
	return clean
end

local function autoJoinFromInvite(player: Player)
	local ok, joinData = pcall(player.GetJoinData, player)
	if not ok or type(joinData) ~= "table" then
		return
	end
	local code = nil
	if type(joinData.TeleportData) == "table" and type(joinData.TeleportData.lobbyCode) == "string" then
		code = joinData.TeleportData.lobbyCode
	elseif type(joinData.LaunchData) == "string" then
		code = joinData.LaunchData:match("^lobby:(%w+)$")
	end
	if not code then
		return
	end
	DataService.waitFor(player, 20)
	local lobby = byCode[string.upper(code)]
	if lobby and player.Parent then
		local snap, err = join(player, lobby)
		if snap then
			Router.push(player, Net.Events.LobbyState, snap)
		else
			Router.toast(player, err, "error")
		end
	end
end

-- Solo race (from Free Roam): a private one-player lobby that starts immediately.
function LobbyService.startSolo(player: Player, difficulty: string, fixedStart: string?)
	local current = membership[player.UserId]
	if current and current.match and current.match.round and current.match.round.sessions[player.UserId] then
		return nil, "Finish your current race first."
	end
	if fixedStart then
		local generator = require(script.Parent.WikiService).generator
		local probe = generator:generate(difficulty, { fixedStart = fixedStart })
		if not probe then
			return nil, "No target is far enough from this page for that difficulty. Try another page!"
		end
	end
	local lobby = createLobby({
		name = player.DisplayName .. "'s Solo Race",
		isPublic = false,
		solo = true,
		settings = {
			difficulty = difficulty,
			rounds = 1,
			timer = "300",
			showMeters = true,
			showPages = true,
			allowChaos = false,
		},
	})
	local snap, err = join(player, lobby)
	if not snap then
		destroyLobby(lobby)
		return nil, err
	end
	startMatch(lobby, { solo = true, fixedStart = fixedStart })
	return LobbyService.snapshot(lobby)
end

-- Returns true if the player is currently in a round (used to block search mid-race).
function LobbyService.isRacing(player: Player): boolean
	local lobby = membership[player.UserId]
	local match = lobby and lobby.match
	local round = match and match.round
	local session = round and round.sessions[player.UserId]
	return session ~= nil and not session.finished
end

function LobbyService.init()
	for _, standing in Config.Lobby.StandingLobbies do
		createLobby({
			name = standing.name,
			isPublic = true,
			standing = true,
			settings = { difficulty = standing.difficulty, timer = standing.timer, rounds = standing.rounds },
		})
	end

	LobbyDirectory.init(LobbyService.allLobbies)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(autoJoinFromInvite, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		leave(player, "disconnected")
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			pushListToBrowsers(false)
		end
	end)

	local A = Net.Actions

	Router.on(A.ListLobbies, function()
		return LobbyService.listPublic()
	end, { rate = 1, burst = 4 })

	Router.on(A.QuickPlay, function(player)
		local best = nil
		for _, lobby in lobbies do
			if lobby.isPublic and not lobby.solo and #lobby.members < Config.Lobby.MaxPlayers then
				local score = #lobby.members * 10 + (lobby.state == "Waiting" and 5 or 0) + (lobby.standing and 1 or 0)
				if not best or score > best.score then
					best = { lobby = lobby, score = score }
				end
			end
		end
		local lobby = best and best.lobby
		if not lobby then
			lobby = createLobby({ name = "Quick Race", isPublic = true })
		end
		return join(player, lobby)
	end, { rate = 1, burst = 3 })

	Router.on(A.CreateLobby, function(player, payload)
		local count = 0
		for _ in lobbies do
			count += 1
		end
		if count >= Config.Lobby.MaxLobbiesPerServer + #Config.Lobby.StandingLobbies then
			return nil, "This server has too many lobbies. Try joining one!"
		end
		local isPublic = Validate.boolean(payload.isPublic)
		local lobby = createLobby({
			name = filterName(player, payload.name),
			isPublic = isPublic == true,
		})
		local snap, err = join(player, lobby)
		if not snap then
			destroyLobby(lobby)
			return nil, err
		end
		lobby.hostId = player.UserId
		markDirty(lobby)
		return LobbyService.snapshot(lobby)
	end, { rate = 0.5, burst = 2 })

	Router.on(A.JoinLobby, function(player, payload)
		local lobby = nil
		if payload.lobbyId then
			local id = Validate.string(payload.lobbyId, 16)
			lobby = id and lobbies[id]
			if lobby and not lobby.isPublic then
				return nil, "That lobby is private. Ask for its code!"
			end
		elseif payload.code then
			local code = Validate.string(payload.code, 12)
			code = code and string.upper(code):gsub("[^%w]", "")
			lobby = code and byCode[code]
			if not lobby and code then
				local remote = LobbyDirectory.lookup(code)
				if remote then
					if remote.count >= remote.max then
						return nil, "That lobby is full."
					end
					Router.push(player, Net.Events.Teleporting, { name = remote.name })
					local ok, err = LobbyDirectory.teleport(player, remote)
					if not ok then
						return nil, "Couldn't reach that lobby's server: " .. tostring(err)
					end
					return { teleporting = true }
				end
			end
		end
		if not lobby or lobby.solo then
			return nil, "Couldn't find that lobby. Check the code and try again."
		end
		return join(player, lobby)
	end, { rate = 1, burst = 4 })

	Router.on(A.LeaveLobby, function(player)
		leave(player, "left")
		return true
	end, { rate = 1, burst = 3 })

	Router.on(A.UpdateLobby, function(player, payload)
		local lobby = membership[player.UserId]
		if not isHost(player, lobby) then
			return nil, "Only the host can change settings."
		end
		if type(payload.settings) == "table" then
			local clean, err = validatePatch(lobby, payload.settings)
			if not clean then
				return nil, err
			end
			for key, value in clean do
				lobby.settings[key] = value
			end
		end
		if payload.isPublic ~= nil and not lobby.standing and not lobby.solo then
			local isPublic = Validate.boolean(payload.isPublic)
			if isPublic == nil then
				return nil, "Invalid visibility"
			end
			lobby.isPublic = isPublic
		end
		if payload.name ~= nil and not lobby.standing then
			lobby.name = filterName(player, payload.name)
		end
		cancelAutoStart(lobby)
		LobbyDirectory.publish(lobby)
		markDirty(lobby)
		return LobbyService.snapshot(lobby)
	end, { rate = 3, burst = 8 })

	Router.on(A.SetReady, function(player, payload)
		local lobby = membership[player.UserId]
		local ready = Validate.boolean(payload.ready)
		if not lobby or ready == nil then
			return nil, "Not in a lobby"
		end
		lobby.ready[player.UserId] = ready
		markDirty(lobby)
		checkAutoStart(lobby)
		return true
	end, { rate = 2, burst = 5 })

	Router.on(A.KickPlayer, function(player, payload)
		local lobby = membership[player.UserId]
		local target = Validate.userId(payload.userId)
		if not isHost(player, lobby) then
			return nil, "Only the host can remove players."
		end
		if not target or target == player.UserId or not table.find(lobby.members, target) then
			return nil, "That player isn't in your lobby."
		end
		local targetPlayer = Players:GetPlayerByUserId(target)
		lobby.kicked[target] = os.clock() + 120
		if targetPlayer then
			leave(targetPlayer, "kicked")
		end
		return true
	end, { rate = 1, burst = 3 })

	Router.on(A.TransferHost, function(player, payload)
		local lobby = membership[player.UserId]
		local target = Validate.userId(payload.userId)
		if not isHost(player, lobby) then
			return nil, "Only the host can do that."
		end
		if not target or not table.find(lobby.members, target) then
			return nil, "That player isn't in your lobby."
		end
		lobby.hostId = target
		local newHost = Players:GetPlayerByUserId(target)
		for _, userId in lobby.members do
			local member = Players:GetPlayerByUserId(userId)
			if member and newHost then
				Router.toast(member, ("👑 %s is now the host."):format(newHost.DisplayName), "info")
			end
		end
		markDirty(lobby)
		return true
	end, { rate = 1, burst = 3 })

	Router.on(A.StartMatch, function(player)
		local lobby = membership[player.UserId]
		if not isHost(player, lobby) then
			return nil, "Only the host can start the match."
		end
		return startMatch(lobby)
	end, { rate = 1, burst = 2 })

	Router.on(A.EndMatch, function(player)
		local lobby = membership[player.UserId]
		if not isHost(player, lobby) then
			return nil, "Only the host can end the match."
		end
		if not lobby.match then
			return nil, "No match is running."
		end
		lobby.match:requestEnd()
		return true
	end, { rate = 1, burst = 2 })

	Router.on(A.NextRound, function(player)
		local lobby = membership[player.UserId]
		if not isHost(player, lobby) or not lobby.match then
			return nil, "Only the host can skip ahead."
		end
		lobby.match:skipToNext()
		return true
	end, { rate = 1, burst = 2 })

	Router.on(A.Navigate, function(player, payload)
		local lobby = membership[player.UserId]
		if not lobby or not lobby.match then
			return nil, "You're not in a race."
		end
		local op = Validate.string(payload.op, 12)
		if not op or not RaceSession.Ops[op] then
			return nil, "Unknown action."
		end
		local argument = nil
		if op == "link" or op == "history" then
			argument = Validate.id(payload.pageId)
			if not argument then
				return nil, "Unknown page."
			end
		end
		return lobby.match:navigate(player, op, argument)
	end, { rate = 8, burst = 14 })

	Router.on(A.GiveUp, function(player)
		local lobby = membership[player.UserId]
		if not lobby or not lobby.match then
			return nil, "You're not in a race."
		end
		return lobby.match:giveUp(player)
	end, { rate = 1, burst = 2 })
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Game passes and developer products.
--
-- * Game pass ownership is checked on the server with UserOwnsGamePassAsync (cached), never
--   taken from the client.
-- * Developer products are granted only inside ProcessReceipt, idempotently: each PurchaseId is
--   recorded in the buyer's profile and saved before PurchaseGranted is returned.
-- * Other services register product handlers (e.g. ChaosService registers Server Rig), which
--   keeps this module free of gameplay logic.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Router = require(script.Parent.Router)
local DataService = require(script.Parent.DataService)
local Validate = require(script.Parent.Validate)

local MonetizationService = {}

local passCache = {} -- [userId] = { [passKey] = bool }
local productHandlers = {} -- [productKey] = fn(player, receiptInfo) -> granted
local productKeyById = {}

local function studioGrant(): boolean
	return RunService:IsStudio() and Config.Studio.GrantAllGamePasses
end

local function refreshPasses(player: Player)
	local owned = {}
	for key, pass in Config.GamePasses do
		if studioGrant() then
			owned[key] = true
		elseif pass.id and pass.id ~= 0 then
			local ok, result =
				pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			owned[key] = ok and result == true
		else
			owned[key] = false
		end
	end
	passCache[player.UserId] = owned
	DataService.markChanged(player)
end

function MonetizationService.ownsPass(player: Player, passKey: string): boolean
	local owned = passCache[player.UserId]
	if not owned then
		refreshPasses(player)
		owned = passCache[player.UserId]
	end
	return owned[passKey] == true
end

function MonetizationService.passesFor(player: Player)
	return passCache[player.UserId] or {}
end

function MonetizationService.registerProduct(productKey: string, handler)
	assert(Config.Products[productKey], "unknown product " .. productKey)
	productHandlers[productKey] = handler
end

local function grant(player: Player, productKey: string, purchaseId: string): boolean
	local handler = productHandlers[productKey]
	if not handler then
		warn("[WikiRace] No handler registered for product " .. productKey)
		return false
	end
	local ok, granted = pcall(handler, player, { PurchaseId = purchaseId, ProductKey = productKey })
	if not ok then
		warn(("[WikiRace] Product %s handler error: %s"):format(productKey, tostring(granted)))
		return false
	end
	return granted == true
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.waitFor(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if DataService.hasReceipt(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local productKey = productKeyById[receiptInfo.ProductId]
	if not productKey then
		warn("[WikiRace] Receipt for unknown product id " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not grant(player, productKey, purchaseId) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.recordReceipt(player, purchaseId)
	if not DataService.saveNow(player) and DataService.isPersistent() then
		-- The grant is recorded in memory, so a retry won't double-grant; ask Roblox to retry.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	for key, product in Config.Products do
		if product.id and product.id ~= 0 then
			productKeyById[product.id] = key
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerAdded:Connect(refreshPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(refreshPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		passCache[player.UserId] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Config.GamePasses do
			if pass.id == passId then
				-- Re-verify with Roblox instead of trusting the event payload alone.
				task.spawn(function()
					refreshPasses(player)
					if MonetizationService.ownsPass(player, key) then
						Router.toast(player, ("%s unlocked! Enjoy your new cosmetics."):format(pass.name), "success")
					end
				end)
			end
		end
	end)

	DataService.addSnapshotProvider(function(player, snap)
		snap.passes = MonetizationService.passesFor(player)
	end)

	-- Studio-only: simulate a developer product purchase without real Robux, so every
	-- product flow can be tested before product IDs exist.
	Router.on(Net.Actions.DebugPurchase, function(player, payload)
		if not (RunService:IsStudio() and Config.Studio.AllowDebugPurchases) then
			return nil, "Not available"
		end
		local productKey = Validate.string(payload.product, 32)
		if not productKey or not Config.Products[productKey] then
			return nil, "Unknown product"
		end
		local purchaseId = "studio-" .. HttpService:GenerateGUID(false)
		if not grant(player, productKey, purchaseId) then
			return nil, "Purchase could not be applied"
		end
		DataService.recordReceipt(player, purchaseId)
		return true
	end, { rate = 1, burst = 3 })
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[-- Token-bucket rate limiter keyed by player (or any key).

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(ratePerSecond: number, burst: number)
	return setmetatable({ rate = ratePerSecond, burst = burst, buckets = {} }, RateLimiter)
end

function RateLimiter:allow(key, now: number): boolean
	local bucket = self.buckets[key]
	if not bucket then
		bucket = { tokens = self.burst, at = now }
		self.buckets[key] = bucket
	end
	bucket.tokens = math.min(self.burst, bucket.tokens + (now - bucket.at) * self.rate)
	bucket.at = now
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	return false
end

function RateLimiter:forget(key)
	self.buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RecordService</string>
            <string name="Source"><![CDATA[-- Global world records (server-authoritative only).
--
-- Boards: fastest overall, fastest per difficulty, fewest clicks, and per-challenge fastest
-- times ("pair:<start>><target>") for future challenge-specific leaderboards. Submissions come
-- only from finished rounds computed by the server; rigged rounds never count. Records are
-- compared inside UpdateAsync so two servers can't clobber each other, and new records are
-- broadcast to every server with MessagingService.

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Net = require(Shared.Net)
local Router = require(script.Parent.Router)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)

local RecordService = {}

local GLOBAL_KEY = "global_v1"
local TOPIC = "WikiRaceRecords_v1"

local store = nil
local cache = {} -- board → record
local pairCache = {}

local function better(board: string, candidate, existing): boolean
	if not existing then
		return true
	end
	if board == "fewest_clicks" then
		if candidate.clicks ~= existing.clicks then
			return candidate.clicks < existing.clicks
		end
		return candidate.ms < existing.ms
	end
	return candidate.ms < existing.ms
end

local function refresh()
	if not store then
		return
	end
	local ok, result = pcall(store.GetAsync, store, GLOBAL_KEY)
	if ok and type(result) == "table" then
		cache = result
	end
end

function RecordService.init()
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, Config.Data.RecordStore)
	if ok and DataService.isPersistent() then
		store = result
	end
	refresh()
	pcall(function()
		MessagingService:SubscribeAsync(TOPIC, function(message)
			local data = message.Data
			if type(data) == "table" and type(data.board) == "string" and type(data.record) == "table" then
				if better(data.board, data.record, cache[data.board]) then
					cache[data.board] = data.record
				end
				Router.pushAll(Net.Events.RecordBroken, data)
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Leaderboards.RefreshSeconds)
			refresh()
		end
	end)
end

function RecordService.all()
	return cache
end

local function commit(board: string, record)
	if not store then
		if better(board, record, cache[board]) then
			cache[board] = record
			return true
		end
		return false
	end
	local won = false
	local ok = pcall(function()
		store:UpdateAsync(GLOBAL_KEY, function(old)
			old = old or {}
			if better(board, record, old[board]) then
				old[board] = record
				won = true
				return old
			end
			cache = old
			won = false
			return nil
		end)
	end)
	if ok and won then
		cache[board] = record
	end
	return ok and won
end

local function commitPair(pairKey: string, record)
	local existing = pairCache[pairKey]
	if existing and existing.ms <= record.ms then
		return false
	end
	if not store then
		pairCache[pairKey] = record
		return true
	end
	local won = false
	pcall(function()
		store:UpdateAsync("pair_" .. pairKey, function(old)
			if old and old.ms <= record.ms then
				pairCache[pairKey] = old
				won = false
				return nil
			end
			won = true
			return record
		end)
	end)
	if won then
		pairCache[pairKey] = record
	end
	return won
end

-- Called by Match with a finished, server-scored result.
function RecordService.submit(player: Player, result, ctx)
	if not result.completed or ctx.rigged or not result.time then
		return
	end
	local record = {
		ms = math.floor(result.time * 1000 + 0.5),
		clicks = result.clicks,
		userId = player.UserId,
		name = player.DisplayName,
		start = ctx.startTitle,
		target = ctx.targetTitle,
		difficulty = ctx.difficulty,
		at = os.time(),
	}
	local boards = { "fastest_overall", "fewest_clicks" }
	if table.find(Difficulty.RecordBoards, ctx.difficulty) then
		table.insert(boards, "fastest_" .. ctx.difficulty)
	end
	task.spawn(function()
		local brokeAny = false
		for _, board in boards do
			if better(board, record, cache[board]) and commit(board, record) then
				brokeAny = true
				local payload = { board = board, record = record }
				Router.pushAll(Net.Events.RecordBroken, payload)
				pcall(MessagingService.PublishAsync, MessagingService, TOPIC, payload)
			end
		end
		if ctx.pairKey then
			commitPair(ctx.pairKey, record)
		end
		if brokeAny and player.Parent then
			DataService.update(player, function(data)
				data.stats.recordsSet += 1
			end)
			AchievementService.unlock(player, "record_breaker")
		end
	end)
end

return RecordService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Router</string>
            <string name="Source"><![CDATA[-- Single entry point for client requests. Every action is registered with a handler and a
-- per-player rate limit; payloads are type-checked and handler errors never leak to clients.
-- Handlers return `data` on success or `nil, "message"` on failure.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Net = require(Shared.Net)
local RateLimiter = require(script.Parent.RateLimiter)

local Router = {}

local handlers = {}
local requestRemote, pushRemote

local function dispatch(player: Player, action: any, payload: any)
	if type(action) ~= "string" then
		return { ok = false, error = "Bad request" }
	end
	local entry = handlers[action]
	if not entry then
		return { ok = false, error = "Unknown request" }
	end
	if payload ~= nil and type(payload) ~= "table" then
		return { ok = false, error = "Bad request" }
	end
	if not entry.limiter:allow(player.UserId, os.clock()) then
		return { ok = false, error = "Slow down!", code = "RateLimited" }
	end
	local ok, result, message = pcall(entry.fn, player, payload or {})
	if not ok then
		warn(("[WikiRace] %s failed for %s: %s"):format(action, player.Name, tostring(result)))
		return { ok = false, error = "Something went wrong on the server. Please try again.", code = "ServerError" }
	end
	if result == nil and message ~= nil then
		return { ok = false, error = message }
	end
	return { ok = true, data = result }
end

function Router.init()
	requestRemote, pushRemote = Net.createServerRemotes(ReplicatedStorage)
	requestRemote.OnServerInvoke = dispatch
	Players.PlayerRemoving:Connect(function(player)
		for _, entry in handlers do
			entry.limiter:forget(player.UserId)
		end
	end)
end

-- options: { rate = requests per second, burst = bucket size }
function Router.on(action: string, fn, options)
	assert(Net.Actions[action], "unregistered action name: " .. action)
	options = options or {}
	handlers[action] = { fn = fn, limiter = RateLimiter.new(options.rate or 4, options.burst or 8) }
end

function Router.push(player: Player, event: string, data: any)
	if pushRemote and player.Parent then
		pushRemote:FireClient(player, event, data)
	end
end

function Router.pushMany(players: { Player }, event: string, data: any)
	for _, player in players do
		Router.push(player, event, data)
	end
end

function Router.pushAll(event: string, data: any)
	if pushRemote then
		pushRemote:FireAllClients(event, data)
	end
end

function Router.toast(player: Player, text: string, kind: string?)
	Router.push(player, Net.Events.Toast, { text = text, kind = kind or "info" })
end

return Router
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[-- Input validation for everything that arrives from a client. Every helper returns the
-- sanitized value or nil; never trust a client-provided type, range or length.

local Validate = {}

function Validate.string(value: any, maxLength: number?): string?
	if type(value) ~= "string" then
		return nil
	end
	if #value == 0 or #value > (maxLength or 64) then
		return nil
	end
	if not utf8.len(value) then
		return nil
	end
	return value
end

function Validate.id(value: any): string?
	-- Page ids are slugs: lowercase letters, digits and underscores.
	local s = Validate.string(value, 80)
	if s and s:match("^[%w_]+$") then
		return s
	end
	return nil
end

function Validate.integer(value: any, minimum: number, maximum: number): number?
	if type(value) ~= "number" or value ~= value or value % 1 ~= 0 then
		return nil
	end
	if value < minimum or value > maximum then
		return nil
	end
	return value
end

function Validate.number(value: any, minimum: number, maximum: number): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return math.clamp(value, minimum, maximum)
end

function Validate.boolean(value: any): boolean?
	if type(value) == "boolean" then
		return value
	end
	return nil
end

function Validate.oneOf(value: any, options: { any }): any
	for _, option in options do
		if value == option then
			return value
		end
	end
	return nil
end

function Validate.userId(value: any): number?
	return Validate.integer(value, -10000, 1e15)
end

return Validate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WikiService</string>
            <string name="Source"><![CDATA[-- Owns the single server-wide wiki repository, graph and challenge generator.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("WikiRaceShared").Config)
local Wiki = script.Parent.Parent.Wiki
local WikiRepository = require(Wiki.WikiRepository)
local ChallengeGenerator = require(Wiki.ChallengeGenerator)
local ImageService = require(script.Parent.ImageService)

local WikiService = {}

function WikiService.init()
	local started = os.clock()
	local pages = WikiRepository.collectPages(ServerStorage:WaitForChild("WikiData"))
	ImageService.init()
	local repo = WikiRepository.new(pages, {
		images = Config.PageImages,
		photos = ImageService.photos,
		photoResolver = ImageService.resolve,
	})
	WikiService.repo = repo
	WikiService.graph = repo.graph
	WikiService.generator = ChallengeGenerator.new(repo.graph)
	local stats = repo.graph:stats()
	print(
		("[WikiRace] Wiki ready: %d pages, %d links, %d redirects, main component %d (%.0f ms). Filter removed %d pages / %d sentences."):format(
			stats.pages,
			stats.edges,
			stats.redirects,
			stats.mainComponent,
			(os.clock() - started) * 1000,
			repo.filterReport.pages,
			repo.filterReport.sentences
		)
	)
	for _, warning in repo.graph.warnings do
		warn("[WikiRace] " .. warning)
	end
end

return WikiService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Wiki</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">BannedFilter</string>
            <string name="Source"><![CDATA[-- Removes banned subjects from the wiki BEFORE the graph is built.
--
-- This is not a visual filter: banned pages, their redirects, every link to them, every sentence
-- that mentions them and every category/related entry naming them are stripped from the raw data.
-- Because the graph is built from the cleaned data, no route can pass through a banned page.
-- This module is server-only (ServerScriptService) and never replicated to clients.

local TextUtil = require(script.Parent.TextUtil)

local BannedFilter = {}

-- Normalized (lowercase, accent-folded, punctuation → spaces) whole-word phrases.
-- Includes names, surname-only references, common abbreviations and misspellings.
BannedFilter.Phrases = {
	-- Timothée Chalamet
	"timothee chalamet",
	"timothy chalamet",
	"chalamet",
	-- John F. Kennedy
	"john f kennedy",
	"john fitzgerald kennedy",
	"john kennedy",
	"jack kennedy",
	"president kennedy",
	"jfk",
	"j f k",
	"kennedy",
	-- Jacob Elordi
	"jacob elordi",
	"elordi",
	-- Armin Arlert (Attack on Titan)
	"armin arlert",
	"armin arlelt",
	"arlert",
	"armin",
}

local function hasBannedPhrase(normalized: string): boolean
	for _, phrase in BannedFilter.Phrases do
		if TextUtil.containsPhrase(normalized, phrase) then
			return true
		end
	end
	return false
end

function BannedFilter.isBanned(text: any): boolean
	if type(text) ~= "string" or text == "" then
		return false
	end
	return hasBannedPhrase(TextUtil.normalize(text))
end

-- A chunk of markup is dirty if its visible text, or any link target inside it, is banned.
local function markupIsDirty(markup: string, bannedTargets): boolean
	if hasBannedPhrase(TextUtil.normalize(TextUtil.plain(markup))) then
		return true
	end
	for _, target in TextUtil.linkTargets(markup) do
		local normalized = TextUtil.normalize(target)
		if bannedTargets[normalized] or hasBannedPhrase(normalized) then
			return true
		end
	end
	return false
end

-- Drops every sentence that mentions a banned subject or links to a banned page.
function BannedFilter.scrubMarkup(markup: string?, bannedTargets, report): string
	if type(markup) ~= "string" or markup == "" then
		return ""
	end
	bannedTargets = bannedTargets or {}
	-- Fast path: a chunk with no banned mention or link anywhere is kept verbatim.
	if not markupIsDirty(markup, bannedTargets) then
		return markup
	end
	local kept = {}
	for _, sentence in TextUtil.splitSentences(markup) do
		if markupIsDirty(sentence, bannedTargets) then
			if report then
				report.sentences += 1
			end
		elseif sentence ~= "" then
			table.insert(kept, sentence)
		end
	end
	return table.concat(kept, " ")
end

local function pageIsBanned(page): boolean
	if BannedFilter.isBanned(page.title) or BannedFilter.isBanned(page.id) then
		return true
	end
	for _, alias in page.aliases or {} do
		if BannedFilter.isBanned(alias) then
			-- A redirect that names a banned subject means the page itself is about that
			-- subject (e.g. an abbreviation redirect), so the whole page goes.
			return true
		end
	end
	return false
end

-- Returns cleaned copies of the raw pages and a report of what was removed.
function BannedFilter.cleanPages(rawPages)
	local report = { pages = 0, aliases = 0, sentences = 0, sections = 0, infobox = 0, related = 0, tags = 0 }
	local bannedTargets = {}
	local keptRaw = {}

	for _, page in rawPages do
		if type(page) ~= "table" or type(page.title) ~= "string" then
			continue
		end
		if pageIsBanned(page) then
			report.pages += 1
			bannedTargets[TextUtil.normalize(page.title)] = true
			for _, alias in page.aliases or {} do
				bannedTargets[TextUtil.normalize(alias)] = true
			end
		else
			table.insert(keptRaw, page)
		end
	end

	local cleaned = {}
	for _, page in keptRaw do
		local copy = table.clone(page)

		copy.aliases = {}
		for _, alias in page.aliases or {} do
			if BannedFilter.isBanned(alias) then
				report.aliases += 1
			else
				table.insert(copy.aliases, alias)
			end
		end

		copy.tags = {}
		for _, tag in page.tags or {} do
			if BannedFilter.isBanned(tag) then
				report.tags += 1
			else
				table.insert(copy.tags, tag)
			end
		end

		copy.summary = BannedFilter.scrubMarkup(page.summary, bannedTargets, report)

		copy.sections = {}
		for _, section in page.sections or {} do
			local heading, body = section[1] or section.heading, section[2] or section.body
			if BannedFilter.isBanned(heading) then
				report.sections += 1
				continue
			end
			local scrubbed = BannedFilter.scrubMarkup(body, bannedTargets, report)
			if scrubbed ~= "" then
				table.insert(copy.sections, { heading, scrubbed })
			else
				report.sections += 1
			end
		end

		copy.infobox = {}
		for _, row in page.infobox or {} do
			local label, value = row[1], row[2]
			if BannedFilter.isBanned(label) or markupIsDirty(value or "", bannedTargets) then
				report.infobox += 1
			else
				table.insert(copy.infobox, { label, value })
			end
		end

		copy.related = {}
		for _, related in page.related or {} do
			local normalized = TextUtil.normalize(related)
			if bannedTargets[normalized] or hasBannedPhrase(normalized) then
				report.related += 1
			else
				table.insert(copy.related, related)
			end
		end

		table.insert(cleaned, copy)
	end

	return cleaned, report
end

-- Final defensive audit over a built graph: returns ids of any node that still contains a
-- banned phrase anywhere (title, aliases, tags, text runs, related titles).
function BannedFilter.auditGraph(graph): { string }
	local violations = {}
	local function runsDirty(runs)
		for _, run in runs do
			if BannedFilter.isBanned(run.t) then
				return true
			end
		end
		return false
	end
	for id, node in graph.nodes do
		local dirty = BannedFilter.isBanned(node.title) or BannedFilter.isBanned(id)
		for _, alias in node.aliases do
			dirty = dirty or BannedFilter.isBanned(alias)
		end
		for _, tag in node.tags do
			dirty = dirty or BannedFilter.isBanned(tag)
		end
		dirty = dirty or runsDirty(node.summary)
		for _, section in node.sections do
			dirty = dirty or BannedFilter.isBanned(section.heading)
			for _, paragraph in section.paragraphs do
				dirty = dirty or runsDirty(paragraph)
			end
		end
		for _, row in node.infobox do
			dirty = dirty or BannedFilter.isBanned(row.label) or runsDirty(row.runs)
		end
		if dirty then
			table.insert(violations, id)
		end
	end
	table.sort(violations)
	return violations
end

return BannedFilter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ChallengeGenerator</string>
            <string name="Source"><![CDATA[-- Generates start → target challenges from the real wiki graph.
--
-- Rules enforced here (and re-checked by `validate` before any round starts):
--   * start ≠ target, both exist, both in the graph's main strongly-connected component
--   * the true shortest-path distance is ≥ 4 (never starts Warm/Hot/Burning)
--   * Medium / Hard / Extreme / Give Up start Freezing (≥ 5)
--   * difficulty bands for distance, page fame and target in-degree
--   * start and target usually come from different subject groups ("interesting pairs")
--   * recently used targets/starts are avoided
-- Candidates that fail are discarded and regenerated; constraints relax step by step, but the
-- distance floor is never relaxed.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Categories = require(Shared.Categories)
local BannedFilter = require(script.Parent.BannedFilter)

local ChallengeGenerator = {}
ChallengeGenerator.__index = ChallengeGenerator

local MAX_TARGET_ATTEMPTS = 40

function ChallengeGenerator.new(graph)
	local self = setmetatable({ graph = graph }, ChallengeGenerator)
	self._categoryMembers = {}
	for _, id in graph.mainIds do
		local node = graph.nodes[id]
		self._categoryMembers[node.category] = self._categoryMembers[node.category] or {}
		table.insert(self._categoryMembers[node.category], id)
	end
	local total = 0
	for _, template in Categories.PairTemplates do
		total += template.weight
	end
	self._templateWeight = total
	return self
end

function ChallengeGenerator:floor(difficultyKey: string): number
	return Difficulty.floor(difficultyKey, Config.Race.MinStartDistance, Config.Race.FreezingDistance)
end

local function inRange(value, range)
	return range == nil or (value >= range[1] and value <= range[2])
end

local function shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Relaxation levels: 0 strict, 1 drop templates, 2 drop fame/in-degree, 3 widen distance band.
function ChallengeGenerator:_targetOk(id, def, level, params)
	local graph = self.graph
	local node = graph.nodes[id]
	if not node or not graph:inMain(id) then
		return false
	end
	if params.excludeTargets and params.excludeTargets[id] then
		return false
	end
	if level < 2 then
		if not inRange(node.fame, def.targetFame) then
			return false
		end
		local inDegree = #node.inList
		if def.minTargetInDegree and inDegree < def.minTargetInDegree then
			return false
		end
		if def.maxTargetInDegree and inDegree > def.maxTargetInDegree then
			return false
		end
	end
	return true
end

function ChallengeGenerator:_startOk(id, targetId, def, level, params)
	local node = self.graph.nodes[id]
	if id == targetId or not node or not self.graph:inMain(id) then
		return false
	end
	if params.excludeStarts and params.excludeStarts[id] then
		return false
	end
	if level < 2 and not inRange(node.fame, def.startFame) then
		return false
	end
	if def.crossGroup == "require" and level < 3 then
		if node.group == self.graph.nodes[targetId].group then
			return false
		end
	end
	return true
end

function ChallengeGenerator:_pickTemplate(rng)
	local roll = rng:NextNumber() * self._templateWeight
	for _, template in Categories.PairTemplates do
		roll -= template.weight
		if roll <= 0 then
			return template
		end
	end
	return Categories.PairTemplates[1]
end

local function membersOf(self, categoryList)
	local ids = {}
	for _, category in categoryList do
		for _, id in self._categoryMembers[category] or {} do
			table.insert(ids, id)
		end
	end
	return ids
end

-- Picks a start for a fixed target given the distance map, honoring the difficulty band.
function ChallengeGenerator:_pickStart(targetId, distances, def, level, params, preferredStarts, rng)
	local floor = params.floor
	local maxDistance = level >= 3 and 99 or def.maxDistance
	local minDistance = math.max(floor, level >= 3 and floor or def.minDistance)
	local candidates = {}
	local farthest = 0
	local pool = preferredStarts or self.graph.mainIds
	for _, id in pool do
		local distance = distances[id]
		if distance and distance >= minDistance and distance <= maxDistance then
			if self:_startOk(id, targetId, def, level, params) then
				table.insert(candidates, { id = id, distance = distance })
				farthest = math.max(farthest, distance)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local preferred = candidates
	if def.preferFarthest then
		preferred = {}
		for _, candidate in candidates do
			if candidate.distance == farthest then
				table.insert(preferred, candidate)
			end
		end
	elseif def.preferDistance then
		local exact = {}
		for _, candidate in candidates do
			if candidate.distance == def.preferDistance then
				table.insert(exact, candidate)
			end
		end
		if #exact > 0 and rng:NextNumber() < 0.75 then
			preferred = exact
		end
	end
	-- Crossing subject groups makes routes more interesting; prefer it where the rules allow.
	if def.crossGroup == "prefer" and level < 1 then
		local crossing = {}
		local targetGroup = self.graph.nodes[targetId].group
		for _, candidate in preferred do
			if self.graph.nodes[candidate.id].group ~= targetGroup then
				table.insert(crossing, candidate)
			end
		end
		if #crossing > 0 then
			preferred = crossing
		end
	end
	return preferred[rng:NextInteger(1, #preferred)]
end

function ChallengeGenerator:_build(startId, targetId, difficultyKey, pairLabel)
	local graph = self.graph
	local path = graph:shortestPath(startId, targetId)
	return {
		start = startId,
		target = targetId,
		distance = path and (#path - 1) or math.huge,
		path = path,
		difficulty = difficultyKey,
		pair = pairLabel or (graph.nodes[startId].category .. " → " .. graph.nodes[targetId].category),
	}
end

-- params: { rng = Random, excludeTargets = set?, excludeStarts = set?, fixedStart = id? }
function ChallengeGenerator:generate(difficultyKey: string, params)
	assert(Difficulty.isValid(difficultyKey), "unknown difficulty")
	params = table.clone(params or {})
	local rng = params.rng or Random.new()
	local def = Difficulty.get(difficultyKey)
	params.floor = self:floor(difficultyKey)

	if params.fixedStart then
		return self:_generateFromStart(difficultyKey, params, rng)
	end

	for level = 0, 3 do
		for _ = 1, MAX_TARGET_ATTEMPTS do
			local template = level == 0 and self:_pickTemplate(rng) or nil
			local targetPool = template and membersOf(self, template.to) or self.graph.mainIds
			if #targetPool == 0 then
				continue
			end
			local targetId = targetPool[rng:NextInteger(1, #targetPool)]
			if not self:_targetOk(targetId, def, level, params) then
				continue
			end
			local distances = self.graph:distancesTo(targetId)
			local startPool = template and membersOf(self, template.from) or nil
			local pick = self:_pickStart(targetId, distances, def, level, params, startPool, rng)
			if pick then
				local challenge = self:_build(pick.id, targetId, difficultyKey)
				local ok = self:validate(challenge, difficultyKey)
				if ok then
					challenge.relaxation = level
					return challenge
				end
			end
		end
	end
	return nil, "no valid challenge found"
end

-- Solo race "from this page": the start is fixed; find a target at the right distance.
function ChallengeGenerator:_generateFromStart(difficultyKey, params, rng)
	local startId = params.fixedStart
	if not self.graph:inMain(startId) then
		return nil, "that page can't be used as a starting page"
	end
	local def = Difficulty.get(difficultyKey)
	local forward = self.graph:distancesFrom(startId)
	for level = 0, 3 do
		local maxDistance = level >= 3 and 99 or def.maxDistance
		local minDistance = math.max(params.floor, level >= 3 and params.floor or def.minDistance)
		local candidates, farthest = {}, 0
		for _, id in self.graph.mainIds do
			local distance = forward[id]
			if
				distance
				and distance >= minDistance
				and distance <= maxDistance
				and self:_targetOk(id, def, level, params)
			then
				if
					def.crossGroup ~= "require"
					or level >= 3
					or self.graph.nodes[id].group ~= self.graph.nodes[startId].group
				then
					table.insert(candidates, { id = id, distance = distance })
					farthest = math.max(farthest, distance)
				end
			end
		end
		if def.preferFarthest then
			local filtered = {}
			for _, candidate in candidates do
				if candidate.distance == farthest then
					table.insert(filtered, candidate)
				end
			end
			candidates = filtered
		end
		shuffle(candidates, rng)
		for _, candidate in candidates do
			local challenge = self:_build(startId, candidate.id, difficultyKey)
			if self:validate(challenge, difficultyKey) then
				challenge.relaxation = level
				return challenge
			end
		end
	end
	return nil, "no target is far enough from that page"
end

-- Server Rig: pick ONE new target that is Freezing (or as far as possible, never closer than the
-- difficulty floor) from every player's current page.
function ChallengeGenerator:generateRigTarget(currentPages: { string }, params)
	params = params or {}
	local rng = params.rng or Random.new()
	local floor = self:floor("GiveUp")
	local maps = {}
	for _, pageId in currentPages do
		maps[pageId] = maps[pageId] or self.graph:distancesFrom(pageId)
	end
	local best, bestScore = {}, -1
	for _, id in self.graph.mainIds do
		if params.excludeTargets and params.excludeTargets[id] then
			continue
		end
		local minimum = math.huge
		for _, distances in maps do
			local distance = distances[id]
			if distance == nil then
				minimum = -1
				break
			end
			minimum = math.min(minimum, distance)
		end
		if minimum >= floor then
			-- Obscure targets with few ways in are funnier.
			local score = minimum * 10 + (self.graph.nodes[id].fame * 2) - math.min(#self.graph.nodes[id].inList, 8)
			if score > bestScore then
				best, bestScore = { id }, score
			elseif score == bestScore then
				table.insert(best, id)
			end
		end
	end
	if #best == 0 then
		return nil
	end
	return best[rng:NextInteger(1, #best)]
end

-- Authoritative validation. Called for every generated challenge and again by the match
-- right before a round starts.
function ChallengeGenerator:validate(challenge, difficultyKey: string?)
	local graph = self.graph
	if type(challenge) ~= "table" then
		return false, "missing challenge"
	end
	local startId, targetId = challenge.start, challenge.target
	if type(startId) ~= "string" or type(targetId) ~= "string" then
		return false, "missing pages"
	end
	if startId == targetId then
		return false, "start equals target"
	end
	local startNode, targetNode = graph.nodes[startId], graph.nodes[targetId]
	if not startNode or not targetNode then
		return false, "unknown page"
	end
	if not graph:inMain(startId) or not graph:inMain(targetId) then
		return false, "page outside main component"
	end
	if BannedFilter.isBanned(startNode.title) or BannedFilter.isBanned(targetNode.title) then
		return false, "banned page"
	end
	local distance = graph:distance(startId, targetId)
	if distance == math.huge then
		return false, "target unreachable"
	end
	local floor = self:floor(difficultyKey or challenge.difficulty or "Easy")
	if distance < floor then
		return false, ("start too close (%d < %d)"):format(distance, floor)
	end
	challenge.distance = distance
	return true
end

return ChallengeGenerator
]]></string>
