	{
		title = "BRICS",
		category = "Organization",
		fame = 3,
		emoji = "🏛️",
		source = "wikipedia",
		description = "Intergovernmental organization",
		tags = { "More articles" },
		summary = "**BRICS** is an [[International organization|international organization]] currently comprising ten countries: Brazil, China, Egypt, Ethiopia, India, Indonesia, Iran, Russia, South Africa and the United Arab Emirates.",
		sections = {
			{
				"Overview",
				"Its conceptual origins were articulated by Russian foreign minister Yevgeny Primakov in 1998, and can be traced to informal forums and dialogue groups such as RIC (Russia, India, and China) and IBSA (India, Brazil, and South Africa). BRIC was originally a term coined by British economist Jim O'Neill, and later championed by his employer Goldman Sachs in 2001, to designate a group of emerging markets. The bloc's inaugural summit was held in 2009 and featured the founding countries of Brazil, Russia, India, and China; they adopted the acronym **BRIC** and formed an informal diplomatic group where their governments could meet annually at formal summits and coordinate multilateral policies. South Africa joined the organization in September 2010, which was then renamed BRICS, and attended the third summit in 2011 as a full member.",
			},
		},
		infobox = {
			{ "Named after", "First five member states' initials in English" },
			{ "Type", "[[International organization|Intergovernmental organization]]" },
			{ "Fields", "[[International relations|International politics]]" },
		},
	},
