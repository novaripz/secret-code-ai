	{
		title = "Jordan River",
		category = "Geography",
		fame = 2,
		emoji = "🏞️",
		source = "wikipedia",
		description = "River that flows to the Dead Sea",
		tags = { "Rivers", "Asia" },
		aliases = { "River Jordan" },
		summary = "The **Jordan River** or **River Jordan**, also known as Nahr Al-Sharieat, is a 251 km [[Endorheic basin|endorheic]] river in the [[Levant]] that flows roughly north to south through the Sea of Galilee and drains to the Dead Sea. The river passes by or through [[Jordan]], [[Syria]], [[Israel]], and [[Palestine]].",
		sections = {
			{
				"Overview",
				"Jordan and the [[Israeli-occupied territories|Israeli-occupied]] Golan Heights border the river to the east, while Israel and the Israeli-occupied [[West Bank]] lie to its west. Both Jordan and the West Bank derive their names in relation to the river. The river holds major significance in Islam, Judaism, and Christianity. According to the Bible, the Israelites crossed it into the Promised Land and Jesus of Nazareth was baptized by John the Baptist in it. Some of the companions of Muhammad are thought to have been buried along its banks.",
			},
		},
		infobox = {
			{ "Length", "251 km" },
			{ "Source", "Confluence of Hasbani River and Dan River" },
			{ "Mouth", "Dead Sea" },
		},
