	{
		title = "Cook Strait",
		category = "Geography",
		fame = 3,
		emoji = "🌊",
		source = "wikipedia",
		description = "Strait between the North and South Islands of New Zealand",
		tags = { "Bodies of water", "Straits" },
		summary = '**Cook Strait** is a [[Strait|strait]] that separates the [[North Island|North]] and [[South Island|South Islands]] of New Zealand. The strait connects the [[Tasman Sea]] on the northwest with the South Pacific Ocean on the southeast. It is 22 km wide at its narrowest point, and has been described as "one of the most dangerous and unpredictable waters in the world". Regular ferry services run across the strait between Picton in the Marlborough Sounds and Wellington.',
		sections = {
			{
				"Overview",
				"The strait is named after [[James Cook]], the first European commander to sail through it, in 1770. The waters of Cook Strait are dominated by strong tidal flows. The tidal flow through Cook Strait is unusual in that the tidal elevation at the ends of the strait are almost exactly out of phase with one another, so high water on one side meets low water on the other.",
			},
		},
		infobox = {
			{ "Depth", "128 m" },
