		title = "Money",
		category = "Concept",
		fame = 1,
		emoji = "💵",
		tags = { "Economics" },
		aliases = { "Currency", "Cash" },
		summary = "**Money** is anything widely accepted in exchange for goods and services, such as [[Coin|coins]], banknotes or digital balances.",
		sections = {
			{
				"History",
				"People have used shells, [[Salt|salt]], [[Cocoa bean|cocoa beans]] and [[Gold|gold]] as money. [[China]] printed the first paper money.",
			},
		},
		infobox = { { "Forms", "[[Coin|Coins]], notes, digital" }, { "First paper money", "[[China]]" } },
	},
	{
		title = "Map",
		category = "Object",
		fame = 2,
		emoji = "🗺️",
		tags = { "Geography", "Navigation" },
		aliases = { "Maps" },
		summary = "A **map** is a drawing of an area showing places and routes. The oldest known maps are carved on clay and stone.",
		sections = {
			{
				"Modern maps",
				"Today's digital maps use [[GPS]] and [[Satellite|satellite]] images. A treasure map is the favorite of every [[Pirate|pirate]].",
			},
		},
		infobox = { { "Maker", "Cartographer" }, { "Related", "[[Compass]]" } },
	},
	{
		title = "Calendar",
		category = "Object",
		fame = 2,
		emoji = "📅",
		tags = { "Timekeeping" },
		aliases = { "Calendars" },
		summary = "A **calendar** is a system for organizing days into weeks, months and years. Most of the world uses the Gregorian calendar, introduced in 1582.",
		sections = {
			{
				"History",
				"[[Julius Caesar]] introduced the Julian calendar. Ancient peoples tracked the [[Sun]] and [[Moon]] to measure [[Time|time]].",
			},
		},
		infobox = { { "Days per year", "365 (366 in leap years)" }, { "Measures", "[[Time]]" } },
		related = { "Stonehenge" },
	},
}
]]></string>
        </Properties>
