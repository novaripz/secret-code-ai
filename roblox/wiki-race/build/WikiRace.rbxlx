	{
		title = "Shape",
		category = "Mathematics",
		fame = 2,
		emoji = "➗",
		source = "wikipedia",
		description = "Form of an object",
		tags = { "Geometry" },
		summary = "A **shape** is a [[Graphics|graphical representation]] of an object's form or its external boundary, outline, or external [[Surface (mathematics)|surface]]. It is distinct from other object properties, such as [[Color|color]], texture, or [[Material|material]] type. In [[Geometry|geometry]], shape excludes information about the object's [[Position (geometry)|position]], size, orientation and chirality. A **figure** is a representation including both shape and size (as in, e.g., figure of the Earth).",
		sections = {
			{
				"Overview",
				"A **plane shape** or **plane figure** is constrained to lie on a [[Euclidean plane|plane]], in contrast to solid 3D shapes. A **two-dimensional shape** or **two-dimensional figure** (also: **2D shape** or **2D figure**) may lie on a more general curved [[Surface (mathematics)|surface]] (a two-dimensional space).",
