			{ "Years active", "166–160 BC" },
			{ "Died", "c. 159? BC" },
			{ "Occupation", "Playwright" },
			{ "Language", "[[Latin]] [[Berbers]]" },
			{ "Genre", "Fabula palliata" },
		},
