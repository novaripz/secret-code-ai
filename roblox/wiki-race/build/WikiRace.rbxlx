      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Mathematics</string>
          <string name="Source"><![CDATA[-- Mathematics, numbers, shapes and puzzles.
return {
	{
		title = "Mathematics",
		category = "Mathematics",
		fame = 1,
		emoji = "➗",
		tags = { "Formal sciences" },
		aliases = { "Math", "Maths" },
		summary = "**Mathematics** is the study of [[Number|numbers]], shapes, patterns and logic. It is the language of [[Physics|physics]] and [[Engineering|engineering]].",
		sections = {
			{
				"Branches",
				"Major branches include [[Algebra|algebra]], [[Geometry|geometry]], [[Calculus|calculus]] and [[Statistics|statistics]].",
			},
			{
				"History",
				"Mathematicians of [[Ancient Greece]] such as [[Pythagoras]] and [[Euclid]] laid its foundations.",
			},
		},
		infobox = { { "Symbols", "+ − × ÷ =" }, { "Related", "[[Algorithm|Algorithms]]" } },
		related = { "Physics", "Fractal", "Rubik's Cube", "Sudoku" },
	},
	{
		title = "Number",
		category = "Mathematics",
		fame = 2,
		emoji = "🔢",
		tags = { "Mathematics" },
		aliases = { "Numbers" },
		summary = "A **number** is a mathematical object used to count, measure and label. Special numbers include [[Zero|zero]], [[Pi|pi]] and [[Infinity|infinity]].",
		sections = {
			{
				"Kinds",
				"There are whole numbers, fractions, [[Prime number|primes]] and numbers written in [[Binary number|binary]].",
			},
		},
		infobox = { { "Smallest prime", "2" }, { "Related", "[[Zero]]" } },
		related = { "Sudoku" },
	},
	{
		title = "Zero",
		category = "Mathematics",
		fame = 2,
		emoji = "0️⃣",
		tags = { "Numbers" },
		aliases = { "0" },
		summary = "**Zero** is the [[Number|number]] representing nothing. Treating zero as a number was developed by mathematicians in [[India]] around the 5th century.",
		sections = {
			{
				"Importance",
				"Zero makes place-value notation possible and is one of the two digits of [[Binary number|binary]].",
			},
		},
		infobox = { { "Symbol", "0" }, { "Origin", "[[India]]" } },
	},
	{
		title = "Pi",
		category = "Mathematics",
		fame = 2,
		emoji = "🥧",
		tags = { "Mathematical constants" },
		aliases = { "π" },
		summary = "**Pi** (π) is the ratio of a [[Circle|circle]]'s circumference to its diameter, about 3.14159. Its digits go on forever without repeating.",
		sections = { { "Pi Day", "Pi Day is celebrated on March 14 (3/14), often by eating pie." } },
		infobox = { { "Value", "3.14159…" }, { "Related", "[[Circle]]" } },
	},
	{
		title = "Infinity",
		category = "Mathematics",
		fame = 2,
		emoji = "♾️",
		tags = { "Mathematical concepts" },
		summary = "**Infinity** (∞) is the idea of something without end. Mathematicians have shown that some infinities are bigger than others.",
		sections = {
			{
				"Examples",
				"There are infinitely many [[Prime number|prime numbers]], and the digits of [[Pi|pi]] never end.",
			},
		},
		infobox = { { "Symbol", "∞" }, { "Related", "[[Number]]" } },
	},
	{
		title = "Prime number",
		category = "Mathematics",
		fame = 3,
		emoji = "🔢",
		tags = { "Number theory" },
		aliases = { "Prime", "Primes" },
		summary = "A **prime number** is a whole [[Number|number]] greater than 1 divisible only by 1 and itself: 2, 3, 5, 7, 11, 13…",
		sections = {
			{
				"Proof",
				"[[Euclid]] proved there are [[Infinity|infinitely]] many primes. Primes protect online banking through encryption on the [[Internet]].",
			},
		},
		infobox = { { "Smallest", "2" }, { "Count", "[[Infinity|Infinite]]" } },
	},
	{
		title = "Fibonacci number",
		category = "Mathematics",
		fame = 3,
		emoji = "🐚",
		tags = { "Number sequences" },
		aliases = { "Fibonacci sequence", "Fibonacci" },
		summary = "The **Fibonacci numbers** form a sequence in which each number is the sum of the two before it: 0, 1, 1, 2, 3, 5, 8, 13…",
		sections = {
			{
				"Nature",
				"They appear in [[Sunflower|sunflower]] seed spirals and pinecones. Their ratios approach the [[Golden ratio|golden ratio]].",
			},
		},
		infobox = { { "Named after", "Leonardo of Pisa" }, { "Related", "[[Golden ratio]]" } },
	},
	{
		title = "Golden ratio",
		category = "Mathematics",
		fame = 3,
		emoji = "🐚",
		tags = { "Mathematical constants" },
		aliases = { "Golden mean", "φ" },
		summary = "The **golden ratio** (φ ≈ 1.618) is a proportion that appears in [[Geometry|geometry]], [[Art|art]] and nature.",
		sections = {
			{ "Connection", "Successive [[Fibonacci number|Fibonacci numbers]] get closer and closer to it." },
		},
		infobox = { { "Value", "≈ 1.618" }, { "Symbol", "φ" } },
	},
	{
		title = "Geometry",
		category = "Mathematics",
		fame = 2,
		emoji = "📐",
		tags = { "Mathematics" },
		summary = "**Geometry** is the branch of [[Mathematics|mathematics]] about shapes, sizes and space, such as the [[Triangle|triangle]] and the [[Circle|circle]].",
		sections = { { "History", "[[Euclid]]'s book Elements taught geometry for over 2,000 years." } },
		infobox = { { "Founder", "[[Euclid]]" }, { "Shapes", "[[Triangle]], [[Circle]]" } },
		related = { "Fractal" },
	},
	{
		title = "Triangle",
		category = "Mathematics",
		fame = 3,
		emoji = "🔺",
		tags = { "Shapes", "Geometry" },
		aliases = { "Triangles" },
		summary = "A **triangle** is a [[Geometry|geometric]] shape with three sides and three angles that always add up to 180°.",
		sections = {
			{
				"Uses",
				"Triangles are rigid, so engineers use them in [[Bridge|bridges]] and roofs. Right triangles obey the [[Pythagorean theorem]].",
			},
		},
		infobox = { { "Sides", "3" }, { "Angle sum", "180°" } },
	},
	{
		title = "Circle",
		category = "Mathematics",
		fame = 3,
		emoji = "⭕",
		tags = { "Shapes", "Geometry" },
		summary = "A **circle** is the set of all points at the same distance from a center. Its circumference divided by its diameter is [[Pi|pi]].",
		sections = { { "Uses", "The [[Wheel|wheel]] is humanity's most useful circle." } },
		infobox = { { "Formula", "Area = πr²" }, { "Related", "[[Pi]]" } },
	},
	{
		title = "Pythagoras",
		category = "Person",
		fame = 2,
		emoji = "📐",
		tags = { "Mathematicians", "Ancient Greeks" },
		summary = "**Pythagoras** was a philosopher of [[Ancient Greece]] best known for the [[Pythagorean theorem]] about right triangles.",
		sections = { { "Music", "He discovered that musical harmony follows simple [[Number|number]] ratios." } },
		infobox = { { "Born", "~570 BC" }, { "Known for", "[[Pythagorean theorem]]" } },
	},
	{
		title = "Pythagorean theorem",
		category = "Mathematics",
		fame = 3,
		emoji = "📐",
		tags = { "Theorems", "Geometry" },
		aliases = { "Pythagoras theorem", "a² + b² = c²" },
		summary = "The **Pythagorean theorem** says that in a right [[Triangle|triangle]], the square of the longest side equals the sum of the squares of the other two: a² + b² = c².",
		sections = {
			{ "History", "Named after [[Pythagoras]], it was known to Babylonian mathematicians even earlier." },
		},
		infobox = { { "Formula", "a² + b² = c²" }, { "Named after", "[[Pythagoras]]" } },
	},
	{
		title = "Euclid",
		category = "Person",
		fame = 3,
		emoji = "📏",
		tags = { "Mathematicians", "Ancient Greeks" },
		summary = "**Euclid** was a Greek mathematician in Alexandria, [[Egypt]], known as the father of [[Geometry|geometry]].",
		sections = {
			{ "Elements", "His textbook Elements proved that there are infinitely many [[Prime number|primes]]." },
		},
		infobox = { { "Lived", "~300 BC" }, { "Work", "Elements" } },
	},
	{
		title = "Algebra",
		category = "Mathematics",
		fame = 2,
		emoji = "✖️",
		tags = { "Mathematics" },
		summary = "**Algebra** is the branch of [[Mathematics|mathematics]] that uses letters and symbols to represent unknown [[Number|numbers]] in equations.",
		sections = {
			{
				"Name",
				"The word comes from a 9th-century book by al-Khwarizmi, whose name also gave us '[[Algorithm|algorithm]]'.",
			},
		},
		infobox = { { "Name origin", "Arabic 'al-jabr'" }, { "Related", "[[Algorithm]]" } },
	},
	{
		title = "Calculus",
		category = "Mathematics",
		fame = 3,
		emoji = "📈",
		tags = { "Mathematics" },
		summary = "**Calculus** is the mathematics of change, invented independently by [[Isaac Newton]] and Gottfried Leibniz in the 1600s.",
		sections = {
			{ "Uses", "It describes motion, [[Gravity|gravity]] and growth, and is used to fly [[Rocket|rockets]]." },
		},
		infobox = { { "Inventors", "[[Isaac Newton]], Leibniz" }, { "Branches", "Differential, integral" } },
	},
	{
		title = "Statistics",
		category = "Mathematics",
		fame = 3,
		emoji = "📊",
		tags = { "Mathematics" },
		summary = "**Statistics** is the science of collecting and analyzing data. It is closely related to [[Probability|probability]].",
		sections = {
			{
				"Uses",
				"Statistics predict [[Weather|weather]], track sports stats and help test [[Vaccine|vaccines]].",
			},
		},
		infobox = { { "Key idea", "Average" }, { "Related", "[[Probability]]" } },
	},
	{
		title = "Probability",
		category = "Mathematics",
		fame = 3,
		emoji = "🎲",
		tags = { "Mathematics" },
		aliases = { "Chance" },
		summary = "**Probability** measures how likely something is to happen, from 0 (impossible) to 1 (certain).",
		sections = {
			{
				"Origin",
				"It began with gamblers asking mathematicians about dice games. It is central to [[Quantum mechanics|quantum mechanics]] and [[Statistics|statistics]].",
			},
		},
		infobox = { { "Range", "0 to 1" }, { "Coin flip", "½" } },
	},
	{
		title = "Fractal",
		category = "Mathematics",
		fame = 3,
		emoji = "❄️",
		tags = { "Geometry" },
		aliases = { "Fractals" },
		summary = "A **fractal** is a pattern that repeats itself at every scale. Coastlines, snowflakes and ferns look fractal.",
		sections = {
			{
				"Art",
				"Computer-drawn fractals like the Mandelbrot set are famous examples of mathematical [[Art|art]].",
			},
		},
		infobox = { { "Named", "1975" }, { "Example", "Mandelbrot set" } },
	},
	{
		title = "Rubik's Cube",
		category = "Object",
		fame = 2,
		emoji = "🧊",
		tags = { "Puzzles", "Toys" },
		aliases = { "Rubiks Cube", "Rubik's cube" },
		summary = "The **Rubik's Cube** is a 3D puzzle invented in 1974 by Hungarian professor Ernő Rubik. It has over 43 quintillion possible positions.",
		sections = {
			{
				"Speedcubing",
				"The world record for solving one is under 4 seconds; mathematicians proved any position can be solved in 20 moves.",
			},
		},
		infobox = { { "Invented", "1974" }, { "Positions", "43 quintillion" } },
		related = { "Mathematics", "Speedrunning" },
	},
	{
		title = "Sudoku",
		category = "Object",
		fame = 3,
		emoji = "🔢",
		tags = { "Puzzles" },
		summary = "**Sudoku** is a number-placement puzzle on a 9×9 grid. It became a worldwide craze after appearing in [[Japan]].",
		sections = { { "Math", "Despite using [[Number|numbers]], it requires only logic, not arithmetic." } },
		infobox = { { "Grid", "9×9" }, { "Popularized in", "[[Japan]]" } },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Music</string>
          <string name="Source"><![CDATA[-- Music, genres, musicians and instruments.
return {
	{
		title = "Music",
		category = "Music",
		fame = 1,
		emoji = "🎵",
		tags = { "Arts" },
		summary = "**Music** is the art of arranging sounds in time through melody, harmony and rhythm. Every known culture makes music.",
		sections = {
			{
				"Genres",
				"Genres include [[Classical music|classical]], [[Jazz|jazz]], [[Rock music|rock]], [[Pop music|pop]], [[Hip hop|hip hop]] and [[Reggae|reggae]].",
			},
			{
				"Instruments",
				"Common instruments include the [[Piano|piano]], [[Guitar|guitar]], [[Violin|violin]] and [[Drum|drums]].",
			},
		},
		infobox = { { "Oldest instrument", "~40,000-year-old bone flute" }, { "Top award", "[[Grammy Award]]" } },
		related = { "Film" },
	},
