	{
		title = "Lime (fruit)",
		category = "Plant",
		fame = 3,
		emoji = "🍎",
		source = "wikipedia",
		description = "Citrus fruit",
		tags = { "Eudicots", "Sapindales" },
		aliases = { "Lime" },
		summary = "A **lime** is the fruit of several species of [[Citrus|citrus]], most of which are hybrids within the genus [[Citrus]] (family Rutaceae). Limes are generally small, round to oval fruits with green flesh and skin and a distinctly sour taste due to their high [[Citric acid|citric acid]] content. They are widely cultivated in tropical and subtropical regions for culinary, medicinal, and ornamental purposes.",
		sections = {
			{
				"Overview",
				"Limes are a rich source of vitamin C and are used to accent the flavours of foods and beverages. In 2023, world production of limes (combined with [[Lemon|lemons]]) was 23.6 million [[Tonne|tonnes]], led by India and Mexico.",
			},
