	{
		title = "Louis Agassiz",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "Swiss-American naturalist (1807–1873)",
		tags = { "Biology", "Modern" },
		aliases = { "Jean Louis Rodolphe Agassiz" },
		summary = "**Jean Louis Rodolphe Agassiz** was a Swiss-born American [[Biologist|biologist]] and [[Geologist|geologist]] who is recognized as a scholar of Earth's [[Natural history|natural history]].",
		sections = {
			{
				"Overview",
				"Spending his early life in [[Switzerland]], he received a [[Doctor of Philosophy|PhD]] at the University of Erlangen and a medical degree at the [[LMU Munich|Ludwig-Maximilians-Universität München]]. After studying with [[Georges Cuvier]] and [[Alexander von Humboldt]] in Paris, Agassiz was appointed professor of [[Natural history|natural history]] at the University of Neuchâtel. He emigrated to the [[United States]] in 1847 after visiting [[Harvard University]]. He went on to become professor of zoology and geology at Harvard, to head its Lawrence Scientific School, and to found its Museum of Comparative Zoology. Agassiz is known for observational data gathering and analysis. He made institutional and scientific contributions to zoology, geology, and related areas, including multivolume research books running to thousands of pages.",
			},
		},
		related = { "Barbara McClintock", "Joseph Dalton Hooker" },
