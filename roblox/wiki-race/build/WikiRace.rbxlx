		aliases = { "Computers", "PC" },
		summary = "A **computer** is a machine that follows instructions called programs to process information. Modern computers are built from billions of [[Transistor|transistors]].",
		sections = {
			{
				"History",
				"[[Charles Babbage]] designed a mechanical computer in the 1830s, and [[Alan Turing]] described the theory of computing in 1936.",
			},
			{
				"Software",
				"Programs are written in a [[Programming language|programming language]] and store data as [[Binary number|binary numbers]].",
			},
		},
		infobox = { { "Input", "[[Keyboard]], [[Computer mouse|mouse]]" }, { "Connected by", "[[Internet]]" } },
		related = { "Smartphone", "Artificial intelligence", "Linux" },
	},
