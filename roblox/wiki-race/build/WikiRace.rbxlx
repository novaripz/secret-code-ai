	{
		title = "History of art",
		category = "History",
		fame = 1,
		emoji = "🎨",
		source = "wikipedia",
		description = "none",
		tags = { "History by subject matter", "History of art" },
		summary = "The **history of art** focuses on objects made by humans for any number of spiritual, narrative, philosophical, symbolic, conceptual, documentary, decorative, and even functional and other purposes, but with a primary emphasis on its [[Aesthetics|aesthetic]] visual form. [[Visual arts|Visual art]] can be classified in [[Art|diverse ways]], such as separating [[Fine art|fine arts]] from [[Applied arts|applied arts]]; inclusively focusing on human creativity; or focusing on different media such as [[Architecture|architecture]], [[Sculpture|sculpture]], [[Painting|painting]], [[Film|film]], [[Photography|photography]], and graphic arts. In recent years, technological advances have led to video art, [[Digital art|computer art]], [[Performance art|performance art]], [[Animation|animation]], [[Television|television]], and [[Video game|videogames]].",
		sections = {
			{
				"Overview",
				"The history of art is often told as a chronology of [[Masterpiece|masterpieces]] created during each [[Civilization|civilization]]. It can thus be framed as a story of [[High culture|high culture]], epitomized by the Wonders of the World. On the other hand, [[Vernacular|vernacular]] art expressions can also be integrated into art historical narratives, referred to as folk arts or [[Craft|craft]]. The more closely that an art historian engages with these latter forms of low culture, the more likely it is that they will identify their work as examining visual culture or [[Material culture|material culture]], or as contributing to fields related to art history, such as [[Anthropology|anthropology]] or [[Archaeology|archaeology]]. In the latter cases, art objects may be referred to as [[Artifact (archaeology)|archeological artifacts]].",
			},
		},
		related = { "History of video games" },
