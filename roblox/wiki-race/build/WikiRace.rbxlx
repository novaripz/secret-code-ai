		fame = 1,
		emoji = "🌊",
		tags = { "Bodies of water" },
		aliases = { "Oceans", "Sea" },
		summary = "The **ocean** is the huge body of salt water covering most of [[Earth]]. The largest and deepest part is the [[Pacific Ocean]].",
		sections = {
			{
				"Life",
				"Oceans hold [[Coral reef|coral reefs]], [[Shark|sharks]], [[Octopus|octopuses]] and the largest animal ever, the [[Blue whale|blue whale]].",
			},
			{ "Chemistry", "Seawater contains about 3.5% [[Salt|salt]]." },
		},
		infobox = { { "Covers", "71% of [[Earth]]" }, { "Deepest point", "[[Mariana Trench]]" } },
		related = { "Mermaid", "Plastic" },
	},
	{
