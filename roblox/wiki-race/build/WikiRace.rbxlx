	{
		title = "Arnold Schwarzenegger",
		category = "Athlete",
		fame = 3,
		emoji = "🏅",
		source = "wikipedia",
		description = "Austrian and American bodybuilder, actor and politician (born 1947)",
		tags = { "Individual sports", "Body-building" },
		aliases = { "Arnold Alois Schwarzenegger" },
		summary = "**Arnold Alois Schwarzenegger** is an Austrian and American actor, businessman, film producer, politician, and former professional bodybuilder who served as the 38th governor of California from 2003 to 2011.",
		sections = {
			{
				"Overview",
				'Schwarzenegger began lifting weights at the age of 15 and won the Mr. Universe bodybuilding championship at the age of 20. He won the Mr. Olympia title seven times, tying with Phil Heath for the second-highest number of wins. Nicknamed the "Austrian Oak" in his bodybuilding days, he is regarded as one of the greatest bodybuilders of all time. He has written books and articles about bodybuilding, including the autobiographical Arnold: The Education of a Bodybuilder (1977) and The New Encyclopedia of Modern Bodybuilding (1998). The Arnold Sports Festival, the second-most prestigious bodybuilding event after the Mr. Olympia competition, is named after him. He appeared in the bodybuilding documentary Pumping Iron (1977), which set him on his way to a career in films. After retiring from bodybuilding, Schwarzenegger gained worldwide fame in the 1980s as a Hollywood action star.',
			},
