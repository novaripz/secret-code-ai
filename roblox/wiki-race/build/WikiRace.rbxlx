	{
		title = "Amir Khusrau",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Indian poet, writer, singer and scholar (1253–1325)",
		tags = { "Asia", "Southern Asia" },
		aliases = { "Abu'l Hasan Yamīn ud-Dīn Khusrau", "Amir Khusrow", "Amir Khusro" },
		summary = "**Abu'l Hasan Yamīn ud-Dīn Khusrau** (1253 – October 1325), better known as **Amīr Khusrau**, sometimes spelled as **Amir Khusrow** or **Amir Khusro**, was an Indo-Persian Sufi singer, musician, court poet and scholar, who lived during the period of the [[Delhi Sultanate]].",
		sections = {
			{
				"Overview",
				'He is an iconic figure in the cultural history of the [[Indian subcontinent]]. He was a mystic and a spiritual disciple of Nizamuddin Auliya of [[Delhi]], India. He wrote poetry primarily in [[Persian language|Persian]], but also in [[Hindustani language|Hindavi]] and [[Punjabi language|Punjabi]]. A vocabulary in verse, the Ḳhāliq Bārī, containing [[Arabic]], Persian and Hindavi terms is often attributed to him. Khusrau is sometimes referred to as the "voice of India" or "Parrot of India" (Tuti-e-Hind). Khusrau is regarded as the "father of qawwali" (a devotional form of singing of the Sufis in the Indian subcontinent), and introduced the [[Ghazal|ghazal]] style of song into India, both of which still exist widely in India and Pakistan. Khusrau was an expert in many styles of Persian poetry which were developed in [[Greater Iran|medieval Persia]], from Khāqānī\'s qasidas to [[Nizami Ganjavi|Nizami\'s]] khamsa. He used 11 metrical schemes with 35 distinct divisions.',
			},
		},
		related = { "Du Fu", "Li Bai", "Ouyang Xiu", "Su Shi" },
		infobox = {
			{ "Born", "1253" },
			{ "Birthplace", "Patiyali, [[Delhi Sultanate]] (now in [[Uttar Pradesh]], [[India]])" },
			{ "Died", "1325" },
			{ "Genre", "[[Ghazal]], Qawwali, Ruba'i, Tarana" },
			{ "Occupation", "Sufi, singer, poet, composer, author, scholar" },
		},
	},
	{
		title = "Anawrahta",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Emperor of the Bagan Dynasty, Myanmar",
		tags = { "Asia", "Southeastern Asia" },
		aliases = { "Anawrahta Minsaw" },
		summary = "**Anawrahta Minsaw** was the founder of the Pagan Empire. Considered the father of the Burmese nation, Anawrahta turned a small principality in the dry zone of Upper Burma into the first Burmese Empire that formed the basis of modern-day Burma (Myanmar). Historically verifiable Burmese history begins with his accession to the Pagan throne in 1044.",
		sections = {
			{
				"Overview",
				"Anawrahta unified the entire [[Irrawaddy River|Irrawaddy valley]] for the first time in history, and placed peripheral regions such as the Shan States and Arakan (Rakhine) under Pagan's suzerainty. He successfully stopped the advance of the [[Khmer Empire]] into the Tenasserim coastline and into the Upper Menam valley, making Pagan one of the two great kingdoms in [[Mainland Southeast Asia|mainland Southeast Asia]]. A strict disciplinarian, Anawrahta implemented a series of key social, religious and economic reforms that would have a lasting impact in Burmese history. His social and religious reforms later developed into the modern-day Burmese culture. By building a series of weirs, he turned parched, arid regions around Pagan into the main rice granaries of Upper Burma, giving Upper Burma an enduring economic base from which to dominate the Irrawaddy valley and its periphery in the following centuries.",
			},
		},
		related = { "Stefan Dušan" },
		infobox = {
			{ "Type", "monarch" },
			{ "Born", "11 May 1014 Tuesday, 11th waxing of Nayon 376 ME" },
			{ "Birthplace", "Pagan (Bagan)" },
			{ "Died", "11 April 1077 Tuesday, 3rd waning of Kason 439 ME" },
		},
	},
	{
		title = "Andrea Palladio",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Venetian architect (1508–1580)",
		tags = { "Other visual arts", "Architects" },
		summary = "**Andrea Palladio** was an Italian [[Renaissance]] [[Architect|architect]] active in the Venetian Republic. Palladio, influenced by Roman and Greek architecture, primarily [[Vitruvius]], is widely considered to be one of the most influential individuals in the history of architecture. While he designed churches and palaces, he was best known for country houses and villas. His teachings, summarized in the architectural treatise, The Four Books of Architecture, gained him wide recognition.",
		sections = {
			{
				"Overview",
				'The city of Vicenza, with its 23 buildings designed by Palladio, and his 24 villas in the Veneto are listed by [[UNESCO]] as part of a [[World Heritage Site]] named City of Vicenza and the Palladian Villas of the Veneto. The churches of Palladio are to be found within the "Venice and its Lagoon" UNESCO World Heritage Site.',
			},
