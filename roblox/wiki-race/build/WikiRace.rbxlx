		tags = { "Indo-European languages", "Iranian languages" },
		summary = "**Pashto** is an Eastern Iranian language, belonging to the [[Indo-European languages|Indo-European language family]], natively spoken in northwestern [[Pakistan]] and southern and eastern [[Afghanistan]]. It is one of the two official languages of Afghanistan. In historical [[Persian literature]], it was also referred to as **Afghani**.",
		sections = {
			{
				"Overview",
