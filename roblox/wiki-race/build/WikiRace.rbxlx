	{
		title = "American comic book",
		category = "Book",
		fame = 2,
		emoji = "📖",
		source = "wikipedia",
		description = "Comic book originating in the US",
		tags = { "More articles" },
		summary = "An **American comic book** is a thin periodical literary work originating in the United States, commonly between 24 and 64 pages, containing [[Comics|comics]]. While the form originated in 1933, American [[Comic book|comic books]] first gained popularity after the 1938 publication of Action Comics, which included the debut of the [[Superhero|superhero]] [[Superman]]. This was followed by a superhero boom that lasted until the end of [[World War II]]. After the war, while superheroes were marginalized, the comic book industry rapidly expanded and genres such as horror, crime, science fiction and romance became popular.",
		sections = {
			{
				"Overview",
				'The 1950s saw a gradual decline, due to a shift away from print media in the wake of [[Television|television]] and the impact of the Comics Code Authority. The late 1950s and the 1960s saw a superhero revival and superheroes remained the dominant character archetype throughout the late 20th century into the 21st century. Some fans collect comic books, helping drive up their value. Some have sold for more than US$1 million. Comic shops cater to fans selling comic books, plastic sleeves ("bags") and cardboard backing ("boards") to protect the comic books. An American comic book is also known as a floppy comic. It is typically thin and stapled, unlike traditional [[Book|books]]. American comic books are one of the three major comic book industries globally, starting with [[Japan|Japanese]] [[Manga|manga]] and the Franco-Belgian comic books.',
			},
		},
	},
	{
		title = "Anabasis (Xenophon)",
		category = "Book",
		fame = 3,
		emoji = "📚",
		source = "wikipedia",
		description = "4th-century BC work by Xenophon on the expedition of the Ten Thousand",
		tags = { "Specific works of nonfiction", "Nonfiction of antiquity" },
		aliases = { "Anabasis" },
		summary = "**Anabasis** is the most famous work of the [[Ancient Greece|Ancient Greek]] professional soldier and writer [[Xenophon]]. It gives an account of the expedition of the Ten Thousand, an army of Greek mercenaries hired by Cyrus the Younger to help him seize the throne of [[Achaemenid Empire|Persia]] from his brother, Artaxerxes II, in 401 BC.",
		sections = {
			{
				"Overview",
				"The seven books making up the Anabasis were composed c. 370 BC. Although as an Ancient Greek vocabulary word meaning 'embarkation', 'ascent' or 'mounting up', the title Anabasis has been rendered by some translators as **The March Up Country** or as **The March of the Ten Thousand**. The story of the army's journey across [[Anatolia|Asia Minor]] and [[Mesopotamia]] is Xenophon's best known work and \"one of the great adventures in human history\".",
			},
