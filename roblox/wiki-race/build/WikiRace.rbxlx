	{
		title = "American Broadcasting Company",
		category = "Company",
		fame = 2,
		emoji = "🏢",
		source = "wikipedia",
		description = "American broadcast television network",
		tags = { "More articles" },
		aliases = { "American Broadcasting Companies, Inc.", "ABC Television Network" },
		summary = "**ABC** (formerly and historically known as the **American Broadcasting Company**, and whose legal entity, **American Broadcasting Companies, Inc.** does business as the **ABC Television Network**) is an American commercial broadcasting [[Television broadcaster|television network]] that serves as the flagship property of the Disney Television Group division of [[The Walt Disney Company]].",
		sections = {
			{
				"Overview",
				"ABC launched as a radio network in 1943, as the successor to the NBC Blue Network, which had been purchased by Edward J. Noble. It extended its operations to television in 1948, following in the footsteps of established broadcast networks [[CBS]] and [[NBC]], as well as the lesser-known DuMont. In the mid-1950s, ABC merged with United Paramount Theatres (UPT), a chain of movie theaters that formerly operated as a subsidiary of [[Paramount Pictures]]. Leonard Goldenson, who had been the head of UPT, made the then-new television network profitable by helping to develop and green-light many successful television series.",
			},
		},
		related = { "Ball-and-stick model" },
		infobox = {
			{ "Type", "[[Television broadcaster|television network]]" },
			{ "Country", "United States" },
			{ "Language", "English" },
			{ "Owner", "[[The Walt Disney Company]]" },
			{ "Part of", "Disney Television Group" },
			{ "Founded", "*As the Blue Network 1 January 1927, *Present broadcaster 15 May 1943" },
			{ "Founder", "Edward J. Noble, Louis Blanche" },
		},
	},
	{
		title = "Australian Broadcasting Corporation",
		category = "Company",
		fame = 3,
		emoji = "🏢",
		source = "wikipedia",
		description = "Public broadcaster",
		tags = { "More articles" },
		summary = "The **Australian Broadcasting Corporation** (**ABC**) is Australia's principal public broadcaster. It operates across television, radio, and the web to provide news and current affairs, emergency information, entertainment and factual programming to regional and metropolitan Australia. The ABC is funded by tax revenue and grants from the federal government, though it also generates minor funding via ABC Commercial. It has a government-appointed board of directors and a remit to be politically independent and accountable.",
		sections = {
			{
				"Overview",
				"The ABC was founded in 1932, replacing the private Australian Broadcasting Company, which provided programming for certain radio stations. It was initially financed with a licence fee, but the Chifley government saw this as inefficient due to Australia's small population and vast service area; it became taxpayer-funded in 1949. The ABC is one of two public service broadcasters in Australia, alongside the SBS. Its news division, ABC News, is Australia's most trusted and most relied-on news outlet, providing content to its television, radio, and online platforms. ABC Television operates five free-to-air channels, including ABC TV and ABC Entertains, while ABC Australia broadcasts to the Asia-Pacific.",
			},
		},
		related = { "Terrestrial animal", "Filter feeder" },
		infobox = {
			{ "Type", "Public service broadcaster" },
			{ "Founded", "1 July 1932" },
			{ "Founder", "Lyons government" },
			{ "Headquarters", "700 Harris Street" },
			{ "Owner", "Australian Government" },
		},
	},
	{
		title = "BBC News",
		category = "Company",
		fame = 3,
		emoji = "🎆",
		source = "wikipedia",
		description = "News division of the British Broadcasting Corporation",
		tags = { "More articles" },
		summary = "**BBC News** is an operational business division of the [[BBC|British Broadcasting Corporation]] (BBC) responsible for the gathering and broadcasting of news and current affairs in the UK and around the world. The department is the world's largest broadcast news organisation and generates about 120 hours of radio and television output each day, as well as online news coverage. The service has over 5,500 journalists working across its output including in 50 foreign news bureaus where more than 250 foreign correspondents are stationed. Deborah Turness has been the CEO of news and current affairs since September 2022.",
		sections = {
			{
				"Overview",
				"In 2019, it was reported in an Ofcom report that the BBC spent £136m on news during the period April 2018 to March 2019. BBC News' domestic, global and online news divisions are housed within the largest live newsroom in Europe, in Broadcasting House in central London. Parliamentary coverage is produced and broadcast from studios in London. Through BBC English Regions, the BBC also has regional centres across England and national news centres in Northern Ireland, Scotland and Wales. All nations and English regions produce their own local news programmes and other current affairs and sport programmes. The BBC is a quasi-autonomous corporation authorised by royal charter, making it operationally independent of the government. As of 2024, the BBC reaches an average of 450 million people per week, with the BBC World Service accounting for 320 million people.",
			},
		},
		related = { "Terrestrial animal", "Filter feeder" },
		infobox = {
