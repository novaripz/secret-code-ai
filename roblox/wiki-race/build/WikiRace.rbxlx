	{
		title = "Latvia",
		category = "Country",
		fame = 1,
		emoji = "🗺️",
		source = "wikipedia",
		description = "Country in Northern Europe",
		tags = { "Europe", "Northern Europe" },
		aliases = { "Republic of Latvia" },
		summary = "**Latvia**, officially the **Republic of Latvia**, is a country in the Baltic region of [[Northern Europe|northern Europe]]. It is one of the three [[Baltic states]], along with [[Estonia]] to the north and [[Lithuania]] to the south. It borders [[Russia]] to the east and [[Belarus]] to the southeast and shares a [[Maritime boundary|maritime border]] with [[Sweden]] to the west. Latvia covers an area of 64573 km², with a population of 1.83million. The country has a [[Temperate climate|temperate seasonal climate]]. Its capital and largest city is [[Riga]]. Latvians, who are the titular nation and comprise 65.5% of the country's population, belong to the ethnolinguistic group of the [[Balts]] and speak Latvian.",
		sections = {
			{
				"Overview",
				"Russians are the most prominent minority in the country, at almost a quarter of the population; 37.7% of the population speak [[Russian language|Russian]] as their native tongue. After centuries of Teutonic, Swedish, Polish-Lithuanian, and [[Russian Empire|Russian]] rule, the independent Republic of Latvia was established on 18 November 1918 after breaking away from the Russian Empire in the aftermath of [[World War I]]. The country became increasingly autocratic after the coup in 1934 established the dictatorship of Kārlis Ulmanis. As a result of extensive immigration during the Soviet occupation, ethnic Russians became the most prominent minority in the country. The peaceful Singing Revolution started in 1987 among the Baltic Soviet republics and ended with the restoration of both de facto and official independence on 21 August 1991. Latvia has since been a democratic [[Unitary state|unitary]] [[Parliamentary republic|parliamentary republic]].",
			},
		},
		infobox = {
			{ "Capital", "[[Riga]]" },
			{ "Largest city", "capital" },
			{ "Official languages", "Latviana" },
			{ "People are called", "Latvian" },
			{ "Government", "[[Unitary parliamentary republic]]" },
			{ "Established", "18 November 1918" },
			{ "Area", "64,589 km²" },
		},
