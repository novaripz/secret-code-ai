	{
		title = "Jumping",
		category = "Sport",
		fame = 2,
		emoji = "🍎",
		source = "wikipedia",
		description = "Form of movement pushing against gravity",
		tags = { "Sports", "Athletics" },
		aliases = { "Leaping" },
		summary = "**Jumping** or **leaping** is a form of locomotion or movement in which an [[Organism|organism]] or non-living (e.g., [[Robot|robotic]]) mechanical system propels itself through the air along a ballistic trajectory. Jumping can be distinguished from running, galloping and other gaits where the entire body is temporarily airborne by the relatively long duration of the aerial phase and high angle of initial launch.",
		sections = {
			{
				"Overview",
				"Some animals, such as the [[Kangaroo|kangaroo]], employ jumping (commonly called hopping in this instance) as their primary form of an [[Animal locomotion|locomotion]], while others, such as frogs, use it only as a means to escape predators. Jumping is also a key feature of various activities and sports, including the [[Long jump|long jump]], [[High jump|high jump]] and show jumping.",
			},
		},
