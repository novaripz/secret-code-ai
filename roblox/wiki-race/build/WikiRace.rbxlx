		tags = { "Society", "Groups" },
		summary = "A **secret society** is an [[Organization|organization]] about which the activities, events, inner functioning, membership, and sometimes also existence, are concealed. The term usually excludes covert groups, such as intelligence agencies or guerrilla warfare insurgencies, that hide their activities and memberships but maintain a public presence.",
		sections = {
