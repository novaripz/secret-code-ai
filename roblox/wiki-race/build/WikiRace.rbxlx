	{
		title = "Sorghum",
		category = "Plant",
		fame = 2,
		emoji = "🌿",
		source = "wikipedia",
		description = "Species of grain",
		tags = { "Monocots", "Poales" },
		aliases = { "Sorghum bicolor", "Broomcorn", "Great millet" },
		summary = "**Sorghum bicolor**, commonly called **sorghum** and also known as **broomcorn**, **great millet**, **Indian millet**, **Guinea corn**, **jowar**, or **milo**, is a species in the [[Poaceae|grass]] genus Sorghum. It is typically an [[Annual plant|annual]], but some cultivars are [[Perennial|perennial]]. It grows in clumps that may reach over 4 m high. The [[Grain|grain]] is 2 to 4 mm in diameter.",
		sections = {
			{
				"Overview",
				"The species originated and was domesticated in [[Sudan]]. Native to Africa and the [[Indian subcontinent]], it is cultivated in tropical and subtropical regions for its [[Grain|grain]]. It is the world's fifth-most important [[Cereal|cereal]] crop. The grain is used as food by humans, while the plant is used for animal feed and ethanol production.",
			},
		},
		related = { "Oryza sativa" },
		infobox = {
			{ "Scientific name", "Sorghum bicolor" },
		},
