		tags = { "Musical instruments", "String instruments" },
		aliases = { "Guitars", "Acoustic guitar" },
		summary = "The **guitar** is a stringed instrument usually with six strings, played by strumming or plucking. It is central to [[Rock music|rock]], folk and flamenco from [[Spain]].",
		sections = { { "Electric", "The [[Electric guitar|electric guitar]] uses pickups and amplifiers." } },
		infobox = { { "Strings", "6" }, { "Origin", "[[Spain]]" } },
	},
	{
