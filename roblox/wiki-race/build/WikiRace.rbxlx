			{ "Type", "icy round moon" },
			{ "Discovered by", "[[Galileo Galilei]] Simon Marius" },
			{ "Discovered", "8 January 1610" },
			{ "Radius", "1,560.8 km (0.245 [[Earth|Earths]])" },
			{ "Volume", "1.593×10^10 km3 (0.015 Earths)" },
