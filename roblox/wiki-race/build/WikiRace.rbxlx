	{
		title = "Thales of Miletus",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Ancient Greek philosopher (c. 626 – c. 545 BC)",
		tags = { "Philosophers", "Ancient" },
		summary = "**Thales of Miletus** was a [[Pre-Socratic philosophy|pre-Socratic]] Greek philosopher from Miletus in [[Ionia]], [[Anatolia|Asia Minor]]. Thales was one of the Seven Sages, founding figures of [[Ancient Greece]].",
		sections = {
			{
				"Overview",
				"Beginning in eighteenth-century historiography, many came to regard him as the first philosopher in the [[Ancient Greek philosophy|Greek tradition]], breaking from the prior use of [[Mythology|mythology]] to explain the world and instead using [[Natural philosophy|natural philosophy]]. He is thus otherwise referred to as the first to have engaged in [[Mathematics|mathematics]], [[History of science|science]], and [[Deductive reasoning|deductive reasoning]]. Thales's view that all of [[Nature|nature]] is based on the existence of a single ultimate substance, which he [[Theory|theorized]] to be water, was widely influential among the philosophers of his time. Thales thought the Earth floated on water. In mathematics, Thales is the namesake of Thales's theorem, and the intercept theorem can also be referred to as Thales's theorem. Thales was said to have calculated the heights of the pyramids and the distance of ships from the shore. In science, Thales was an astronomer who reportedly [[Weather forecasting|predicted the weather]] and a [[Solar eclipse|solar eclipse]].",
			},
		},
		related = { "Heraclitus", "Plato" },
		infobox = {
			{ "Born", "c. 626/623 BC" },
			{ "Birthplace", "Miletus, Ionian League" },
			{ "Died", "c. 548/545 BC (aged c. 78)" },
			{ "Era", "[[Pre-Socratic philosophy]]" },
			{ "Region", "[[Western philosophy]]" },
			{ "Main interests", "[[Metaphysics]], [[Mathematics|mathematics]], [[Astronomy|astronomy]]" },
		},
	},
	{
		title = "Themistocles",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Athenian politician and general (c. 524–459 BC)",
		tags = { "Eastern Europe", "Greece" },
		summary = "**Themistocles** was an [[Classical Athens|Athenian]] politician and general. He was one of a new breed of non-aristocratic politicians who rose to prominence in the early years of the Athenian democracy. As a politician, Themistocles was a populist, having the support of lower-class Athenians, and generally being at odds with the Athenian nobility. Elected archon in 493 BC, he convinced the [[Polis|polis]] to increase the naval power of Athens, a recurring theme in his political career. During the first Persian invasion of Greece, he fought at the Battle of Marathon (490 BC), and may have been one of the ten Athenian strategoi (generals) in that battle.",
		sections = {
			{
				"Overview",
				"In the years after Marathon, and in the run-up to the second Persian invasion of 480–479 BC, Themistocles became the most prominent politician in Athens. He continued to advocate for a strong Athenian navy, and in 483 BC he persuaded the Athenians to build a fleet of 200 triremes; these proved crucial in the forthcoming conflict with Persia. During the second invasion, he commanded the Athenian navy at the battles of Artemisium and Salamis in 480 BC. Due to his subterfuge, the Allies successfully lured the Persian fleet into the Straits of Salamis, and the decisive Greek victory there was the turning point of the war. The invasion was conclusively repulsed the following year after the Persian defeat at the land battle of Plataea. After the conflict ended, Themistocles continued his pre-eminence among Athenian politicians.",
			},
		},
		related = { "Philip II of Macedon", "Pericles" },
		infobox = {
			{ "Died", "c. 459 BC (aged 64–65)" },
			{ "Birthplace", "Phrearrhii (modern-day [[Greece]])" },
			{ "Born", "c. 524 BC" },
		},
	},
	{
		title = "Theodor Mommsen",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German classical scholar and historian (1817–1903)",
		tags = { "Historians and archaeologists", "Modern" },
		aliases = { "Christian Matthias Theodor Mommsen" },
		summary = "**Christian Matthias Theodor Mommsen** was a German [[Classics|classical scholar]], [[Historian|historian]], [[Jurist|jurist]], [[Journalist|journalist]], politician and archaeologist. He is widely regarded as one of the greatest classicists of the 19th century. He received the 1902 Nobel Prize in Literature for his historical writings, including The History of Rome, after having been nominated by 18 members of the Prussian Academy of Sciences. He was also a prominent German politician, as a member of the Prussian and German parliaments. His works on [[Roman law]] and on the law of obligations had a significant impact on the German civil code.",
		related = {
			"A. J. P. Taylor",
			"Charles A. Beard",
			"Eric Hobsbawm",
			"Frederick Jackson Turner",
			"Heinrich Schliemann",
			"Leopold von Ranke",
		},
		infobox = {
			{ "Born", "30 November 1817" },
			{ "Birthplace", "Garding, Duchy of Schleswig, Denmark" },
			{ "Died", "1 November 1903" },
			{ "Field", "[[Classics|Classical scholar]], [[Jurist|jurist]], [[Ancient history|ancient historian]]" },
			{ "Education", "Gymnasium Christianeum University of Kiel" },
		},
