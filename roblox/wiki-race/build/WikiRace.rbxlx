	{
		title = "Max Weber",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German social scientist (1864–1920)",
		tags = { "Social scientists" },
		aliases = { "Maximilian Carl Emil Weber" },
		summary = "**Maximilian Carl Emil Weber** was a German [[Sociology|sociologist]], historian, [[Jurist|jurist]], and [[Political economy|political economist]] who was one of the central figures in the development of sociology and the [[Social science|social sciences]] more generally. His ideas continue to influence [[Social theory|social theory]] and [[Social research|research]].",
		sections = {
			{
				"Overview",
				'Born in Erfurt in 1864, Weber studied law and history in [[Humboldt University of Berlin|Berlin]], [[University of Göttingen|Göttingen]], and [[Heidelberg University|Heidelberg]]. After earning his doctorate in law in 1889 and [[Habilitation|habilitation]] in 1891, he taught in Berlin, [[University of Freiburg|Freiburg]], and Heidelberg. He married his cousin Marianne Schnitger two years later. In 1897, he had a breakdown after his father died following an argument. Weber ceased teaching and travelled until the early 1900s. He recovered and wrote The Protestant Ethic and the Spirit of Capitalism. During the [[World War I|First World War]], he initially supported Germany\'s war effort but became critical of it and supported democratisation. He also gave the lectures "Science as a Vocation" and "Politics as a Vocation". After the war, Weber co-founded the German Democratic Party, unsuccessfully ran for office, and advised the drafting of the Weimar Constitution. Meanwhile, he resumed teaching in [[University of Vienna|Vienna]] and [[LMU Munich|Munich]].',
			},
		},
		related = { "Edward Bernays", "Maria Montessori" },
		infobox = {
			{ "Born", "21 April 1864" },
			{ "Birthplace", "Erfurt, Province of Saxony, [[Kingdom of Prussia]]" },
			{ "Died", "14 June 1920" },
			{ "Main interests", "History, economics, sociology, law, religion" },
		},
	},
	{
		title = "Maxim Gorky",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Russian and Soviet writer (1868–1936)",
		tags = { "Eastern Europe", "Russia" },
		summary = "He was nominated five times for the [[Nobel Prize in Literature]]. Before his success as an author, he travelled widely across the [[Russian Empire]], changing jobs frequently; these experiences would later influence his writing. He associated with fellow Russian writers [[Leo Tolstoy]] and [[Anton Chekhov]], both mentioned by Gorky in his memoirs.",
		sections = {
			{
				"Overview",
				'Gorky was active in the emerging Marxist socialist movement and later supported the [[Bolsheviks]]. He publicly opposed the Tsarist regime and for a time closely associated himself with Vladimir Lenin and Alexander Bogdanov\'s Bolshevik wing of the Russian Social Democratic Labour Party. During [[World War I]], Gorky supported pacifism and internationalism and anti-war protests. For a significant part of his life, he was exiled from Russia and later the Soviet Union, being critical both of Tsarism and of the Bolsheviks during the Russian Civil War and the 1920s, condemning the latter for political repressions. After his return he was officially declared the "founder of Socialist Realism".',
			},
		},
		related = { "Mikhail Lermontov", "Fyodor Dostoevsky" },
		infobox = {
