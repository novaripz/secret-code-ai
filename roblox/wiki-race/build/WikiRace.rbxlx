	{
		title = "Malacostraca",
		category = "Animal",
		fame = 3,
		emoji = "🐾",
		source = "wikipedia",
		description = "Largest class of crustaceans",
		tags = { "Arthropods", "Crustaceans" },
		summary = "**Malacostraca** is the second largest of the six [[Class (taxonomy)|classes]] of pancrustaceans after [[Insect|insects]], containing about 40,000 living [[Species|species]], divided among 16 [[Order (taxonomy)|orders]]. Its members, the **malacostracans**, display a great diversity of body forms and include [[Crab|crabs]], [[Lobster|lobsters]], spiny lobsters, [[Crayfish|crayfish]], shrimp, [[Krill|krill]], prawns, isopods, amphipods, mantis shrimp, and many other less familiar animals. They are abundant in all marine environments and have colonised freshwater and terrestrial habitats. They are [[Segmentation (biology)|segmented]] animals, united by a common [[Body plan|body plan]] comprising 20 body segments (rarely 21), and divided into a head, thorax, and abdomen.",
		related = { "Woodlouse" },
		infobox = {
