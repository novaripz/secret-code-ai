		aliases = { "Vervain", "Verveine" },
		summary = "**Verbena**, also known as **vervain** or (in obsolete spelling) **verveine**, is a [[Genus|genus]] in the family Verbenaceae. It contains about 150 species of [[Annual plant|annual]] and [[Perennial|perennial]] herbaceous or semi-woody [[Flowering plant|flowering plants]]. The majority of the species are [[Native species|native]] to the Americas and Asia; however, Verbena officinalis, the common vervain or common verbena, is the [[Type species|type species]] and native to Europe.",
		related = { "Olive", "Oleaceae" },
		infobox = {
			{ "Scientific name", "Verbena" },
		},
	},
	{
		title = "Vicia faba",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Species of plant in the pea and bean family",
		tags = { "Eudicots", "Fabales" },
		aliases = { "Broad bean", "Fava bean", "Faba bean" },
		summary = "**Vicia faba**, commonly known as the **broad bean**, **fava bean**, or **faba bean**, is a species of vetch, a [[Flowering plant|flowering plant]] in the [[Pea|pea]] and [[Bean|bean]] family [[Fabaceae]]. It is widely cultivated as a crop for human consumption, and also as a cover crop. Varieties with smaller, harder seeds that are fed to horses or other animals are called **field bean**, **tic bean** or **tick bean**. This [[Legume|legume]] is commonly consumed in many national and regional cuisines.",
		sections = {
			{
				"Overview",
				"Some people have favism, a hemolytic response to the consumption of broad beans, a condition linked to a metabolic disorder known as G6PDD. Otherwise the beans, with the outer seed coat removed, can be eaten raw or cooked. With young seed pods, the outer seed coat can be eaten, and in very young pods, the entire seed pod can be eaten.",
			},
