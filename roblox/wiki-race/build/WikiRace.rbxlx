		tags = { "Computer scientists" },
		aliases = { "Dennis MacAlistair Ritchie" },
		summary = "**Dennis MacAlistair Ritchie** (September 9, 1941 – c. October 12, 2011) was an American computer scientist. He created, together with long-time colleague Ken Thompson, the [[Unix]] [[Operating system|operating system]], [[C (programming language)|C programming language]], and B programming language.",
		related = { "Donald Knuth", "Douglas Engelbart", "Edsger W. Dijkstra", "Konrad Zuse", "Steve Wozniak" },
