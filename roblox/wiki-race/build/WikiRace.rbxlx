return {
	{
		title = "Dimetrodon",
		category = "Animal",
		fame = 3,
		emoji = "🐾",
		source = "wikipedia",
		description = "Genus of carnivorous synapsids from the Permian",
		tags = { "Reptiles", "Dinosaurs and prehistoric reptiles" },
		summary = "**Dimetrodon** is an extinct [[Genus|genus]] of sphenacodontid [[Synapsida|synapsid]] that lived during the Cisuralian to early Guadalupian epoch of the [[Permian]] period, around 294.1–271 million years ago. With most species measuring 1.7–4.6 m long and weighing 28–250 kg, the most prominent feature of Dimetrodon is the large neural spine sail on its back formed by elongated spines extending from the vertebrae. It was an obligate quadruped (it could walk only on four legs) and had a tall, curved skull with large teeth of different sizes set along the jaws. Most fossils have been found in the [[Southwestern United States]], the majority of these coming from a geological deposit called the Red Beds of Texas and Oklahoma.",
		sections = {
			{
				"Overview",
				"More recently, its fossils have also been found in [[Germany]] and over a dozen species have been named since the [[Genus|genus]] was first erected in 1878. Dimetrodon is often mistaken for a [[Dinosaur|dinosaur]] or portrayed as a contemporary of dinosaurs in [[Popular culture|popular culture]], but it became extinct by the middle [[Permian]], some 40 million years before the appearance of dinosaurs. Although [[Reptile|reptile]]-like in appearance and physiology, Dimetrodon is much more closely related to [[Mammal|mammals]], as it belongs to the closest [[Sister group|sister]] [[Family (taxonomy)|family]] to therapsids, the latter of which contains the direct ancestor of mammals.",
			},
		},
		related = { "Diplodocus", "Triceratops" },
		infobox = {
			{ "Scientific name", "Dimetrodon" },
		},
	},
	{
		title = "Dingo",
		category = "Animal",
		fame = 3,
		emoji = "🐾",
		source = "wikipedia",
		description = "Canid species native to Australia",
		tags = { "Mammals", "Carnivora" },
		summary = "The **dingo** is a lineage of [[Dog|dog]] found in [[Australia]]. It is a medium-sized canine that possesses a lean, hardy body adapted for speed, agility, and stamina. Its three main coat colourations are light ginger or tan, black and tan, or creamy white. The skull is wedge-shaped and appears large in proportion to the body.",
		sections = {
			{
				"Overview",
				"Its taxonomic classification is debated: it is variously considered a form of [[Dog|domestic dog]] (Canis familiaris or Canis lupus familiaris) not warranting recognition as a [[Subspecies|subspecies]], or a subspecies of dog (**Canis familiaris dingo**) or [[Wolf|wolf]] (**Canis lupus dingo**), or a full species in its own right (**Canis dingo**). The dingo is closely related to the New Guinea singing dog: their lineage split early from the lineage that led to today's domestic dogs, and can be traced back through [[Maritime Southeast Asia]] to Asia. The oldest remains of dingoes discovered in Australia are around 3,500 years old. A dingo pack usually consists of a mated pair, their offspring from the current year, and sometimes offspring from the previous year.",
			},
		},
		infobox = {
			{ "Scientific name", "Canis familiaris" },
		},
