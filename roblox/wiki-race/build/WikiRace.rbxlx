		fame = 2,
		emoji = "🌋",
		tags = { "Natural disasters" },
		summary = "An **earthquake** is a sudden shaking of the ground caused by rocks slipping along faults in [[Earth]]'s crust.",
		sections = {
			{
				"Measurement",
				"Scientists measure earthquakes with seismometers; undersea quakes can cause a [[Tsunami|tsunami]].",
			},
		},
		infobox = { { "Measured by", "Seismometer" }, { "Largest recorded", "1960, Chile (9.5)" } },
	},
	{
