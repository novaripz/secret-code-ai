	{
		title = "Coconut",
		category = "Plant",
		fame = 3,
		emoji = "🥥",
		source = "wikipedia",
		description = "Species of plant in the palm family",
		tags = { "Flowering plants", "Monocots" },
		aliases = { "Cocos nucifera", "Cocos" },
		summary = 'The **coconut** (**Cocos nucifera**) is a member of the palm [[Family (taxonomy)|family]] ([[Arecaceae]]) and the only living [[Species|species]] of the [[Genus|genus]] **Cocos**. The term "coconut" (or the archaic "**cocoanut**") can denote the whole **coconut palm** [[Tree|tree]] or the large hard [[Fruit|fruit]]. Originally native to the Central Indo-Pacific, they are ubiquitous in coastal tropical regions.',
		sections = {
			{
				"Overview",
				'The coconut tree provides food, fuel, cosmetics, folk medicine, and building materials. The inner flesh of the mature fruit forms a regular part of the diets of many people in the [[Tropics|tropics]] and [[Subtropics|subtropics]]. Coconut endosperm contains a large quantity of a liquid, "coconut water". Mature coconuts can be processed for oil and coconut milk from the flesh, [[Charcoal|charcoal]] from the hard shell, and coir from the fibrous husk. Dried coconut flesh is called copra, and the oil and milk derived from it are commonly used in cooking and in soaps and cosmetics. The hard shells, fibrous husks and long pinnate leaves are used to make products for furnishing and decoration. The coconut has cultural and religious significance for many [[Austronesian peoples]], appearing in their mythologies, songs, and oral traditions.',
			},
		},
		related = { "Amaryllis", "Philodendron" },
		infobox = {
			{ "Scientific name", "Cocos nucifera" },
		},
	},
	{
		title = "Colchicum",
		category = "Plant",
		fame = 3,
