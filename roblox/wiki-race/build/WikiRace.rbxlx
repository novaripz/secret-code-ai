	{
		title = "Physical geography",
		category = "Geography",
		fame = 1,
		emoji = "🏔️",
		source = "wikipedia",
		description = "Study of processes and patterns in the natural environment",
		tags = { "Basics" },
		aliases = { "Physiography" },
		summary = "**Physical geography** (also known as **physiography**) is one of the three main branches of [[Geography|geography]]. Physical geography is the branch of [[Natural science|natural science]] which deals with the processes and patterns in the [[Natural environment|natural environment]] such as the [[Atmosphere|atmosphere]], [[Hydrosphere|hydrosphere]], [[Biosphere|biosphere]], and geosphere. This focus contrasts with the branch of [[Human geography|human geography]], which focuses on the built environment, and [[Technical geography|technical geography]], which focuses on the use, study, and creation of tools for obtaining, analyzing, interpreting, and understanding spatial information. The three branches have significant overlap, however.",
	},
	{
		title = "Polish People's Republic",
		category = "Geography",
		fame = 2,
		emoji = "👥",
		source = "wikipedia",
		description = "Polish communist state from 1947 to 1989",
		tags = { "More articles" },
		summary = "The **Polish People's Republic** (1952–1989), formerly the **Republic of Poland** (1947–1952), was the [[Poland|Polish]] [[State (polity)|state]] that existed as the predecessor of the modern-day electoral Third Polish Republic. With a population of approximately 37.9 million near the end of its existence, it was the second most populous communist and [[Eastern Bloc]] country in Europe. It was also where the [[Warsaw Pact]] was founded. The largest city and capital was [[Warsaw]], followed by the industrial city of [[Łódź]] and cultural capital of [[Kraków]]. The country was bordered by the [[Baltic Sea]] to the north, the [[Soviet Union]] to the east, Czechoslovakia to the south, and [[East Germany]] to the west.",
		sections = {
			{
				"Overview",
				"The Polish People's Republic was a unitary [[Communist state|communist state]] established in the country after the Red Army's takeover of Polish territory from German occupation in World War II. Communist control was strengthened through electoral fraud in the 1946 Polish people's referendum and the 1947 Polish parliamentary election. The Polish United Workers' Party (PZPR) became the dominant political faction in a [[One-party state|one-party state]], but the country had more [[Liberalism|liberal]] policies than other socialist states due to its strategic location in the [[Cold War]] and internal opposition. The state's official name was the \"Republic of Poland\" between 1947 and 1952 in accordance with the temporary Small Constitution of 1947. The name \"People's Republic\" was introduced and defined by the Constitution of 1952.",
			},
		},
		infobox = {
			{
				"Conservation status",
				"[[Satellite state]] of the [[Soviet Union]], member of the [[Warsaw Pact]] and Comecon",
			},
