			{ "Capital", "Coimbra (until 1255) [[Lisbon]] (1255–1910)" },
			{ "Currency", "Portuguese dinheiro, (until 1433) Portuguese real (1433–1910)" },
			{ "People are called", "Portuguese" },
		},
