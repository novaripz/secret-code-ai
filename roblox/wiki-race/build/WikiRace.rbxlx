			{ "Established", "26 April 1879" },
			{ "Area", "150.91 km²" },
		},
	},
	{
		title = "Second Temple",
		category = "Landmark",
		fame = 2,
		emoji = "⛩️",
		source = "wikipedia",
		description = "Temple in Jerusalem (c. 516 BCE–70 CE)",
		tags = { "More articles" },
		summary = "The **Second Temple** was the temple in Jerusalem that replaced Solomon's Temple, which was destroyed during the Babylonian siege of Jerusalem in 587 BCE. The Second Temple was constructed around 516 BCE and later enhanced by Herod the Great around 18 BCE, consequently also being known as **Herod's Temple** thereafter. Defining the [[Second Temple period]] and standing as a pivotal symbol of Jewish identity, it was the basis and namesake of Second Temple Judaism.",
		sections = {
			{
				"Overview",
				'In 539 BCE, the Persian conquest of Babylon enabled the [[Achaemenid Empire]] to expand across the [[Fertile Crescent]] by annexing the [[Neo-Babylonian Empire]], including the territory of the former [[Kingdom of Judah]], which had been annexed as the Babylonian province of Yehud during the reign of the Babylonian king [[Nebuchadnezzar II]], who concurrently [[Babylonian captivity|exiled part of Judah\'s population to Babylon]]. Following this campaign, the Persian king [[Cyrus the Great]] issued the "Edict of Cyrus" (sometimes identified with the Cyrus Cylinder), which is described in the Hebrew Bible as a royal proclamation that authorized and encouraged the repatriation of displaced populations in the region. This event is called the return to Zion in Ezra–Nehemiah, marking the resurgence of Jewish life in what had become the self-governing Persian province of Yehud.',
			},
		},
		related = { "Australian Bureau of Statistics" },
		infobox = {
			{ "Location", "[[Temple Mount]]" },
			{ "Completed", "c. 516 BCE (original) c. 18 CE (Herodian)" },
			{ "Region", "Land of Israel" },
			{ "Country", "[[Achaemenid Empire]] (first) [[Roman Empire]] (last)" },
		},
	},
	{
		title = "Serengeti National Park",
		category = "Landmark",
		fame = 3,
		emoji = "🌳",
		source = "wikipedia",
		description = "National park in Tanzania",
		tags = { "Parks and preserves", "Africa" },
		summary = "The **Serengeti National Park** is a large [[National park|national park]] in northern [[Tanzania]] that stretches over 14763 km². It is located in eastern Mara Region and northeastern Simiyu Region and contains over 15000 km² of [[Savanna|savanna]]. The park was established in 1940.",
		sections = {
			{
				"Overview",
				"The Serengeti is known for the largest annual animal migration in the world of over 1.5 million western white-bearded wildebeest and 250,000 Grant's zebra, along with between 400-500,000 Thomson's gazelle and smaller herds of common eland. The national park is also home to the largest [[Lion|lion]] population in Africa. It is under threat from [[Deforestation|deforestation]], population growth, [[Poaching|poaching]], and ranching.",
			},
		},
		related = { "Park", "World Heritage Site" },
		infobox = {
