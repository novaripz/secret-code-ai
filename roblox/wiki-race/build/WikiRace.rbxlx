	{
		title = "Fern",
		category = "Plant",
		fame = 2,
		emoji = "🌿",
		source = "wikipedia",
		description = "Class of vascular plants",
		tags = { "Non-flowering plants", "Pteridophytes" },
		aliases = { "Ferns", "Polypodiopsida", "Polypodiophyta" },
		summary = "**Ferns** (**Polypodiopsida** or **Polypodiophyta**) are a group of [[Vascular plant|vascular plants]] that reproduce via [[Spore|spores]] and have neither seeds nor flowers. Some ferns produce coiled fiddleheads, which expand into fronds.",
		sections = {
			{
				"Overview",
				"The group includes over 10,500 extant species. The Polypodiopsida consist of both the leptosporangiate (Polypodiidae) and eusporangiate ferns, the latter group including horsetails, whisk ferns, marattioid ferns and ophioglossoid ferns. The fern [[Crown group|crown group]] is estimated to have originated c. 423 million years ago (mya), during the late [[Silurian]] period and the rapid radiation of land plants, but Polypodiales, the group that makes up 80% of living fern diversity, did not appear and diversify until the [[Cretaceous]] (c. 143 to 66 mya), contemporaneous with the heightened diversification of flowering plants. Some fern species, such as bracken (Pteridium aquilinum) and water fern (Azolla filiculoides), are significant [[Weed|weeds]] worldwide, and brackens are [[Carcinogen|carcinogenic]]. Ferns are not of major economic importance, but some are used as food, medicine, and [[Ornamental plant|ornamental plants]].",
			},
		},
		infobox = {
			{ "Scientific name", "Polypodiopsida" },
		},
	},
	{
		title = "Ficus sycomorus",
