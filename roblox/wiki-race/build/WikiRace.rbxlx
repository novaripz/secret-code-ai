			{ "Died", "29 June 1940" },
			{ "Field", "Painting, drawing, watercolor, printmaking" },
			{ "Movement", "[[Expressionism]], [[Bauhaus]], [[Surrealism]]" },
		},
	},
	{
		title = "Paul Samuelson",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American economist and Nobel Laureate (1915–2009)",
		tags = { "Economists" },
		aliases = { "Paul Anthony Samuelson" },
		summary = '**Paul Anthony Samuelson** (May 15, 1915 – December 13, 2009) was an American economist who was the first American to win the Nobel Memorial Prize in Economic Sciences. When awarding the prize in 1970, the Swedish Royal Academies stated that he "has done more than any other contemporary economist to raise the level of scientific analysis in economic theory".',
		sections = {
			{
				"Overview",
				'Samuelson was one of the most influential economists of the latter half of the 20th century. In 1996, he was awarded the [[National Medal of Science]]. Samuelson considered [[Mathematics|mathematics]] to be the "natural language" for economists and contributed significantly to the mathematical foundations of economics with his book Foundations of Economic Analysis. He was author of the best-selling economics textbook of all time: Economics: An Introductory Analysis, first published in 1948. It was the second American textbook that attempted to explain the principles of Keynesian economics. Samuelson wrote a weekly column for Newsweek magazine along with Chicago School economist [[Milton Friedman]], where they represented opposing sides: Samuelson, as a self described "Cafeteria Keynesian", claimed taking the Keynesian perspective but only accepting what he felt was good in it.',
			},
		},
		related = { "Karl Marx", "Adam Smith" },
		infobox = {
