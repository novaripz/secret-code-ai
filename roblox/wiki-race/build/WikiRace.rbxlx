			{ "Worked at", "University of Graz Charles-Ferdinand University (Prague) [[University of Vienna]]" },
			{ "Education", "[[University of Vienna]] (Ph.D., 1860; [[Habilitation|Dr. phil. hab.]], 1861)" },
			{ "Teacher", "Andreas von Ettingshausen" },
