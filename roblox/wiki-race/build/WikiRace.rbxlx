	{
		title = "Iridaceae",
		category = "Plant",
		fame = 3,
		emoji = "👪",
		source = "wikipedia",
		description = "Family of flowering plants comprising irises, gladioli, and crocuses",
		tags = { "Flowering plants", "Monocots" },
		summary = "**Iridaceae** is a family of plants in order Asparagales, taking its name from the [[Iris (plant)|irises]]. It has a nearly global distribution, with 69 accepted genera with a total of about 2500 species. It includes a number of economically important cultivated plants, such as species of Freesia, [[Gladiolus]], and Crocus, as well as the crop [[Saffron|saffron]].",
		sections = {
			{
				"Overview",
				"Members of this family are [[Perennial|perennial plants]], with a [[Bulb|bulb]], corm or [[Rhizome|rhizome]]. The plants grow erect, and have leaves that are generally grass-like, with a sharp central fold. Some examples of members of this family are the **blue flag** and **yellow flag**.",
			},
