	{
		title = "Spinning top",
		category = "Concept",
		fame = 3,
		emoji = "🧸",
		source = "wikipedia",
		description = "Spinning toy",
		tags = { "Entertainment", "Toys" },
		aliases = { "Top" },
		summary = "A **spinning top**, or simply a **top**, is a [[Toy|toy]] with a squat body and a sharp point at the bottom, designed to be [[Rotation|spun]] on its vertical axis, balancing on the tip due to the gyroscopic effect.",
		sections = {
			{
				"Overview",
				"Once set in motion, a top will usually wobble for a few seconds, spin upright for a while, then start to wobble again with increasing amplitude as it loses energy, and finally tip over and roll on its side. Tops exist in many variations and materials, chiefly [[Wood|wood]], [[Metal|metal]], and [[Plastic|plastic]], often with a metal tip. They may be set in motion by twirling a handle with the fingers, by pulling a [[Rope|rope]] coiled around the body, or through a built-in auger (spiral plunger). Such toys have been used since [[Classical antiquity|antiquity]] in solitary or competitive [[Game|games]], where each player tries to keep one's top spinning for as long as possible or achieve some other goal. Some tops have faceted bodies with symbols or inscriptions, and are used like [[Dice|dice]] to inject randomness into games or for [[Divination|divination]] and [[Ritual|ritual]] purposes.",
			},
		},
		related = { "Action figure", "Doll" },
