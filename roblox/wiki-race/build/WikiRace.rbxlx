	{
		title = "Jammu and Kashmir (union territory)",
		category = "Geography",
		fame = 2,
		emoji = "🏔️",
		source = "wikipedia",
		description = "Region administered by India",
		tags = { "More articles" },
		aliases = { "Jammu and Kashmir" },
		summary = "**Jammu and Kashmir** (abbr. **J&K**) is a region administered by [[India]] as a [[Union territory|union territory]] consisting of the southern portion of the larger [[Kashmir]] region, which has been the subject of a [[Kashmir|border dispute]] between India and Pakistan since 1947 and between India and China since 1959.",
		sections = {
			{
				"Overview",
				"The Line of Control separates Jammu and Kashmir from the [[Kashmir|Pakistani-administered]] territories of Azad Kashmir and [[Gilgit-Baltistan]] in the west and north respectively. It lies to the north of the Indian states of [[Himachal Pradesh]] and [[Punjab, India|Punjab]] and to the west of [[Ladakh]] which is administered by India as a union territory. Insurgency in Jammu and Kashmir has persisted in protest over autonomy and rights. In 2019, the Jammu and Kashmir Reorganisation Act was passed, reconstituting the former state of Jammu and Kashmir into two union territories: Ladakh in the east and the residuary Jammu and Kashmir in the west. [[Srinagar]] and Jammu jointly serve as the capital of the region, which is divided into two divisions and 20 districts. Jammu and Kashmir holds substantial mineral deposits, including [[Sapphire|sapphire]], borax, and [[Graphite|graphite]].",
			},
		},
		infobox = {
			{ "Area", "56160 km²" },
			{ "Population", "12,267,013" },
		},
