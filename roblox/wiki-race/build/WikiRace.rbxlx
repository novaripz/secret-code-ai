	{
		title = "Canal",
		category = "Vehicle",
		fame = 1,
		emoji = "🛶",
		source = "wikipedia",
		description = "Artificial channel for water",
		tags = { "Transportation", "Maritime transport" },
		aliases = { "Canals", "Artificial waterways" },
		summary = "**Canals** or **artificial waterways** are [[Waterway|waterways]] or engineered [[Channel (geography)|channels]] built for [[Drainage|drainage]] management (e.g. [[Flood management|flood control]] and [[Irrigation|irrigation]]) or for conveyancing water transport [[Watercraft|vehicles]] (e.g. water taxi). They carry free, calm surface flow under [[Atmospheric pressure|atmospheric pressure]], and can be thought of as artificial [[River|rivers]].",
		sections = {
			{
				"Overview",
				"In most cases, a canal has a series of [[Dam|dams]] and locks that create [[Reservoir|reservoirs]] of low speed current flow. These reservoirs are referred to as slack water levels, often just called levels. A canal can be called a **navigation canal** when it parallels a natural river and shares part of the latter's [[Discharge (hydrology)|discharges]] and [[Drainage basin|drainage basin]], and leverages its resources by building dams and locks to increase and lengthen its stretches of slack water levels while staying in its [[Valley|valley]]. A canal can cut across a [[Drainage divide|drainage divide]] atop a ridge, generally requiring an external water source above the highest [[Elevation|elevation]]. The best-known example of such a canal is the [[Panama Canal]]. Many canals have been built at elevations, above valleys and other waterways. Canals with sources of water at a higher level can deliver water to a destination such as a city where water is needed.",
			},
		},
		related = { "Passenger ship" },
	},
