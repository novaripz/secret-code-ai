		emoji = "🌊",
		tags = { "Natural disasters" },
		summary = "A **tsunami** is a series of giant ocean waves usually caused by an undersea [[Earthquake|earthquake]] or [[Volcano|volcanic]] eruption.",
		sections = {
			{
				"Name",
				"The word comes from Japanese and means 'harbor wave'. Warning buoys across the [[Pacific Ocean]] watch for them.",
			},
		},
		infobox = { { "Speed", "Up to 800 km/h" }, { "Cause", "[[Earthquake]]" } },
	},
