	{
		title = "Sweet potato",
		category = "Plant",
		fame = 2,
		emoji = "🥔",
		source = "wikipedia",
		description = "Species of edible plant",
		tags = { "Eudicots", "Solanales" },
		aliases = { "Sweetpotato", "Ipomoea batatas" },
		summary = "The **sweet potato** or **sweetpotato** (**Ipomoea batatas**) is a [[Dicotyledon|dicotyledonous]] plant in the morning glory family, Convolvulaceae. Its sizeable, [[Starch|starchy]], sweet-tasting tuberous roots are used as a [[Root vegetable|root vegetable]], which is a [[Staple food|staple food]] in parts of the world. Cultivars of the sweet potato have been bred to bear tubers with flesh and skin of various colors. Moreover, the young shoots and leaves are occasionally eaten as [[Leaf vegetable|greens]]. The sweet potato and the [[Potato|potato]] are only distantly related, both being in the order Solanales. Although darker sweet potatoes are often known as yams in parts of North America, they are even more distant from actual [[Yam (vegetable)|yams]], which are monocots in the order Dioscoreales.",
		sections = {
			{
				"Overview",
				"The sweet potato is [[Native species|native]] to the tropical regions of South America in modern [[Ecuador]]. The genus Ipomoea that contains the sweet potato also includes several garden flowers called morning glories, but that term is not usually extended to I. batatas. Some [[Cultivar|cultivars]] of I. batatas are grown as [[Ornamental plant|ornamental plants]] under the name tuberous morning glory and sometimes used in a horticultural context. Sweet potatoes can also be called yams in North America.",
			},
		},
		related = { "Bell pepper" },
		infobox = {
			{ "Scientific name", "Ipomoea batatas" },
			{ "Conservation status", "Data Deficient" },
		},
	},
	{
		title = "Tagetes",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of flowering plant",
		tags = { "Eudicots", "Asterales" },
		summary = "**Tagetes** is a [[Genus|genus]] of 50 species of [[Annual plant|annual]] or [[Perennial|perennial]], mostly [[Herbaceous plant|herbaceous plants]] in the family [[Asteraceae]]. They are among several groups of plants known in English as **marigolds**. The genus Tagetes was formally named by [[Carl Linnaeus]] in 1753. Linnaeus cited Joseph Pitton de Tournefort (1700), Johann Jacob Dillenius (1732), Gaspard Bauhin (1623) and Fabio Colonna (1606) as authors who used the name 'Tagetes' before. In 1754 he published the formal description in his Genera Plantarum, referring to Tournefort, Sébastien Vaillant (1720) and Dillenius for the name 'Tagetes'.",
		sections = {
			{
				"Overview",
				"Originally called **cempōhualxōchitl**, by the Nahua people, these plants are native to Central and Southern [[Mexico]] and several other [[Latin America|Latin American]] countries. Some species have become naturalized around the world. One species, T. minuta, is considered a noxious [[Invasive species|invasive species]] in some areas.",
			},
		},
		related = { "Chicory", "Dahlia" },
		infobox = {
			{ "Scientific name", "Tagetes" },
		},
	},
	{
		title = "Tamarind",
		category = "Plant",
		fame = 3,
		emoji = "🌳",
		source = "wikipedia",
		description = "Leguminous tree bearing edible fruit",
		tags = { "Eudicots", "Fabales" },
		aliases = { "Tamarindus indica" },
		summary = "**Tamarind** (**Tamarindus indica**) is a [[Legume|leguminous]] tree bearing edible fruit that is indigenous to tropical Africa and naturalized in [[Asia]]. The genus Tamarindus is [[Monotypic taxon|monotypic]], meaning that it contains only this species. It belongs to the family [[Fabaceae]].",
		sections = {
			{
				"Overview",
				"The tamarind tree produces brown, pod-like [[Fruit|fruits]] that contain a sweet, tangy pulp, which is used in cuisines around the world. The pulp is also used in [[Traditional medicine|traditional medicine]] and as a [[Dye|dye]]. The wood can be used for [[Woodworking|woodworking]], and tamarind seed oil can be extracted from the seeds. Its young leaves are used in [[Indian cuisine|Indian]] and Filipino cuisine. Because tamarind has multiple uses, it is cultivated worldwide in tropical and [[Subtropics|subtropical zones]].",
			},
		},
		related = { "Peanut" },
		infobox = {
			{ "Scientific name", "Tamarindus indica" },
			{ "Conservation status", "Least Concern" },
		},
	},
	{
		title = "Taraxacum",
		category = "Plant",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of flowering plants",
		tags = { "Eudicots", "Asterales" },
		aliases = { "Dandelions" },
		summary = "**Taraxacum** is a [[Genus|genus]] of [[Flowering plant|flowering plants]] in the family [[Asteraceae]] which consists of species commonly known as **dandelions**. The scientific and hobby study of the genus is known as taraxacology. The genus has a near-[[Cosmopolitan distribution|cosmopolitan distribution]], absent only from tropical and polar areas. Two of the most common species worldwide, T. officinale (the common dandelion) and T. erythrospermum (the red-seeded dandelion), are [[Europe|European]] species introduced into North America, where they are non native. Dandelions thrive in temperate regions and can be found in yards, gardens, sides of roads, among crops, and in many other habitats.",
		sections = {
			{
				"Overview",
				"Like other members of the family Asteraceae, they have very small flowers collected together into a composite flower head. Each single flower in a head is called a floret. In part due to their abundance, along with being a generalist species, dandelions are one of the most vital early spring nectar sources for a wide host of pollinators. Many Taraxacum species produce seeds [[Asexual reproduction|asexually]] by apomixis, where the seeds are produced without [[Pollination|pollination]], resulting in offspring that are genetically identical to the parent plant.",
			},
		},
		related = { "Campanulaceae", "Tagetes" },
		infobox = {
			{ "Scientific name", "Taraxacum" },
		},
	},
