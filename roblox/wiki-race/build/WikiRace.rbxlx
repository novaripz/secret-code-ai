	{
		title = "Svante Arrhenius",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Swedish scientist (1859–1927)",
		tags = { "Chemistry", "Modern" },
		aliases = { "Svante August Arrhenius" },
		summary = "**Svante August Arrhenius** (19 February 1859 – 2 October 1927) was a Swedish [[Scientist|scientist]]. Originally a [[Physicist|physicist]], but often referred to as a [[Chemist|chemist]], Arrhenius was one of the founders of the science of [[Physical chemistry|physical chemistry]]. In 1903, he received the [[Nobel Prize in Chemistry]], becoming the first [[Sweden|Swedish]] Nobel laureate. In 1905, he became the director of the Nobel Institute, where he remained until his death.",
		sections = {
			{
				"Overview",
				"Arrhenius was the first to use the principles of [[Physical chemistry|physical chemistry]] to estimate the extent to which increases in the atmospheric carbon dioxide are responsible for the Earth's increasing surface temperature. His work played an important role in the emergence of modern [[Climatology|climate science]]. In the 1960s, Charles David Keeling reliably measured the level of carbon dioxide present in the air showing it was increasing and that, according to the greenhouse hypothesis, it was sufficient to cause significant global warming. The Arrhenius equation, [[Acid–base reaction|Arrhenius acid]], Arrhenius base, [[Moon|lunar]] [[Impact crater|crater]] Arrhenius, [[Mars|Martian]] crater Arrhenius, the mountain of Arrheniusfjellet, and the Arrhenius Labs at Stockholm University were so named to commemorate his contributions to science.",
			},
		},
		related = { "Peter Debye" },
		infobox = {
			{ "Born", "19 February 1859" },
			{ "Birthplace", "Vik Castle, Uppsala County, Sweden" },
			{ "Died", "2 October 1927" },
			{ "Education", "Uppsala University" },
			{
				"Known for",
				"Calculation of the greenhouse effect, Arrhenius equation, [[Acid–base reaction|Acid-base reaction]]",
			},
			{ "Fields", "[[Physics]] [[Chemistry]]" },
			{ "Worked at", "Stockholm University" },
		},
	},
