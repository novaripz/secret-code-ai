return {
	{
		title = "Tropical rainforest climate",
		category = "Concept",
		fame = 2,
		emoji = "🌡️",
		source = "wikipedia",
		description = "Type of tropical climate in which there is no dry season",
		tags = { "More articles" },
		aliases = { "Equatorial climate" },
		summary = "A **tropical rainforest climate**, in some cases classified as an **equatorial climate,** is a [[Tropical climate|tropical climate]] sub-type usually found within 10 to 15 degrees latitude of the [[Equator|equator]]. There are some other areas at higher latitudes, such as the coast of southeast Florida, United States, and Okinawa, Japan that fall into the tropical rainforest climate category. They experience high mean annual temperatures, small temperature ranges, and rain that falls throughout the year. Regions with this climate are typically designated **Af** by the [[Köppen climate classification]].",
		sections = {
			{
				"Overview",
				"A tropical rainforest climate is typically hot, very humid, and wet with no [[Dry season|dry season]]. The difference in temperature between day and night may be larger than the average change in temperature during the year. As the name implies, the most common [[Biome|biome]] within this climate is [[Tropical rainforest|tropical rainforest]]. However, a significant portion of what is considered “tropical rainforest” lies in other [[Tropical climate|A-type climates]], and some regions in this climate are not forest but rather flooded grasslands and savannas.",
			},
		},
	},
	{
		title = "Tropical savanna climate",
		category = "Concept",
		fame = 2,
		emoji = "🌡️",
		source = "wikipedia",
		description = "Climate subtype",
		tags = { "More articles" },
		aliases = { "Tropical wet and dry climate", "Aw" },
		summary = '**Tropical savanna climate** or **tropical wet and dry climate** is a [[Tropical climate|tropical climate]] sub-type that corresponds to the [[Köppen climate classification]] categories **Aw** (for a dry "winter") and **As** (for a dry "summer").',
		sections = {
			{
				"Overview",
				"This latter fact is in a direct contrast to a [[Tropical monsoon climate|tropical monsoon climate]], whose driest month sees less than 60. In essence, a tropical savanna climate tends to either see less overall rainfall than a tropical monsoon climate or have more pronounced dry season(s). For example, if the total rainfall is less than 1,000 mm, the equation above yields a number greater than 60 mm (and so excludes the possibility of being a tropical monsoon climate). It is impossible for a tropical savanna climate to have more than 2,500 mm as such would result in a negative value in that equation. In tropical savanna climates, the dry season can become severe, and often drought conditions prevail during the course of the year. Tropical savanna climates often feature tree-studded grasslands due to its dryness, rather than thick jungle.",
			},
		},
		related = { "Sanseido" },
	},
	{
		title = "Troposphere",
		category = "Concept",
		fame = 2,
		emoji = "🌍",
		source = "wikipedia",
		description = "Lowest layer of Earth's atmosphere",
		tags = { "More articles" },
		summary = "The **troposphere** is the lowest layer of the [[Atmosphere of Earth|atmosphere of Earth]]. It contains 80% of the total mass of the [[Atmosphere|planetary atmosphere]] and 99% of the total mass of [[Water vapor|water vapor]] and [[Aerosol|aerosols]], and is where most [[Weather|weather]] phenomena occur. From the planetary surface of the Earth, the average height of the troposphere is 18 km in the [[Tropics|tropics]]; 11 km in the [[Middle latitudes|middle latitudes]]; and 6 km in the high latitudes of the [[Polar regions|polar regions]] in winter; thus the average height of the troposphere is 13 km.",
		sections = {
			{
				"Overview",
				"The term troposphere derives from the Greek words tropos (rotating) and [[Sphere|sphaira]] (sphere) indicating that rotational [[Turbulence|turbulence]] mixes the layers of air and so determines the structure and the phenomena of the troposphere. The rotational [[Friction|friction]] of the troposphere against the planetary surface affects the flow of the air, and so forms the planetary boundary layer (PBL) that varies in height from hundreds of meters up to 2 km. The measures of the PBL vary according to the latitude, the [[Landform|landform]], and the time of day when the meteorological measurement is realized. Atop the troposphere is the tropopause, which is the functional atmospheric border that demarcates the troposphere from the [[Stratosphere|stratosphere]]. As such, because the tropopause is an inversion layer in which air-temperature increases with altitude, the temperature of the tropopause remains constant.",
			},
		},
	},
	{
		title = "Trust (law)",
		category = "Concept",
		fame = 3,
		emoji = "⚖️",
		source = "wikipedia",
		description = "Three-party fiduciary relationship",
		tags = { "Law", "Subjects" },
		aliases = { "Trust" },
		summary = 'A **trust** is a legal relationship in which the owner of [[Property|property]], or any transferable right, gives it to another to manage and use solely for the benefit of a designated person. In the English [[Common law|common law]], the party who entrusts the property is known as the "settlor," the party to whom it is entrusted is known as the "trustee," the party for whose benefit the property is entrusted is known as the "beneficiary," and the entrusted property is known as the "corpus" or "trust property." A testamentary trust is an irrevocable trust established and funded pursuant to the terms of a deceased person\'s will. An **inter vivos trust** is a trust created during the settlor\'s life.',
		sections = {
			{
				"Overview",
				"The trustee is the legal owner of the assets held in trust on behalf of the trust and its beneficiaries. The beneficiaries are equitable owners of the trust property. Trustees have a fiduciary duty to manage the trust for the benefit of the equitable owners. Trustees must provide regular accountings of trust income and expenditures. A court of competent jurisdiction can remove a trustee who breaches their duty. Some breaches can be charged and tried as criminal offenses. A trustee can be a natural person, business entity or public body. A trust in the US may be subject to federal and state taxation. The trust is governed by the terms under which it was created. In most jurisdictions, this requires a contractual trust agreement or deed. It is possible for a single individual to assume the role of more than one of these parties, and for multiple individuals to share a single role.",
			},
		},
	},
	{
		title = "Trust (social science)",
		category = "Concept",
		fame = 3,
		emoji = "🔬",
		source = "wikipedia",
		description = "Assumption of and reliance on the honesty of another party",
		tags = { "Psychology", "Interpersonal relations" },
		summary = "**Trust** is the belief that another person will do what is expected and is built through repeated consistency. It brings with it a willingness for one party (the **trustor**) to become vulnerable to another party (the **trustee**), on the presumption that the trustee will act in ways that benefit the trustor. In addition, the trustor does not have control over the actions of the trustee; however, those actions influence the trustor's positive, neutral, or negative evaluations regarding the trustworthiness of the trustee.",
		sections = {
			{
				"Overview",
				"Scholars distinguish between **generalized trust** (also known as **social trust**), which is the extension of trust to a relatively large circle of unfamiliar others, and **particularized trust**, which is contingent on a specific situation or a specific relationship. As the outcome of trust is uncertain and depends on what one chooses to [[Belief|believe]], the trustor can only evaluate and develop expectations based on the trustee’s actions. Such expectations are formed with a view to the [[Motivation|motivations]] of the trustee, dependent on their characteristics, the situation, and their interaction. The trustor’s risk perception of failure or harm to themselves stems from the uncertainty of the trustee’s behavior. In the [[Social science|social sciences]], the subtleties of trust are a subject of ongoing research.",
			},
		},
