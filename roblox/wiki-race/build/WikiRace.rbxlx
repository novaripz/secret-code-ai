				"Birthplace",
				"[[Varanasi|Banaras]], Jaunpur Sultanate (present-day [[Varanasi]], [[Uttar Pradesh]], [[India]])",
			},
			{ "Main interests", "Mysticism, theism, [[Syncretism|syncretism]], [[Poetry|poetry]]" },
			{ "Region", "[[South Asia]]" },
			{ "Language", "Sadhukkadi, [[Bhojpuri language|Bhojpuri]]" },
			{ "Era", "Bhakti movement" },
		},
