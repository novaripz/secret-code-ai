	{
		title = "Positivism",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		source = "wikipedia",
		description = "Empiricist philosophical theory",
		tags = { "Philosophy", "Philosophical schools and traditions" },
		summary = "**Positivism** is a philosophical school that holds that all genuine knowledge is either true by definition or positive—the latter meaning a posteriori facts derived by [[Reason|reason]] and [[Logic|logic]] from [[Perception|sensory experience]]. Other [[Epistemology|ways of knowing]], such as [[Intuition|intuition]], [[Introspection|introspection]], or religious faith, are rejected or considered meaningless.",
		sections = {
			{
				"Overview",
				"Although the positivist approach has been a recurrent theme in the history of Western thought, modern positivism was first articulated in the early 19th century by [[Auguste Comte]]. His school of [[Sociology|sociological]] positivism holds that society, like the physical world, operates according to [[Scientific law|scientific laws]]. After Comte, positivist schools arose in [[Logic|logic]], [[Psychology|psychology]], [[Economics|economics]], [[Historiography|historiography]], and other fields of thought. Generally, positivists attempted to introduce scientific methods to their respective fields. Since the turn of the 20th century, positivism, although still popular, has declined under criticism within the social sciences by antipositivists and [[Critical theory|critical theorists]], among others, for its alleged scientism, [[Reductionism|reductionism]], overgeneralizations, and methodological limitations. Positivism also exerted a substantial influence on Kardecism.",
			},
		},
	},
