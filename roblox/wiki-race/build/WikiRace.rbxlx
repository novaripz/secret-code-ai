		emoji = "🔤",
		tags = { "Languages" },
		aliases = { "English" },
		summary = "**English** is a language that began in England, [[United Kingdom]], and is now spoken by about 1.5 billion people.",
		sections = {
			{
				"Words",
				"[[William Shakespeare]] invented or popularized hundreds of English words. Its alphabet has 26 letters.",
			},
		},
		infobox = { { "Speakers", "~1.5 billion" }, { "Script", "Latin [[Alphabet|alphabet]]" } },
	},
