	{
		title = "Lise Meitner",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Austrian-Swedish nuclear physicist (1878–1968)",
		tags = { "Physics", "Modern" },
		summary = "After completing her doctoral research in 1906, Meitner became the second woman to earn a doctorate in physics from the [[University of Vienna]]. She spent much of her scientific career in Berlin, where she was a physics professor and a department head at the Kaiser Wilhelm Institute for Chemistry. She was the first woman to become a full professor of physics in Germany. On 13–14 July 1938, she fled to the Netherlands with the help of Dirk Coster. She lived in Stockholm for many years, ultimately becoming a Swedish citizen in 1949, while insisting on keeping her Austrian citizenship, but relocated to Britain in the 1950s to be with family members.",
		sections = {
			{
				"Overview",
				'Meitner was informed of their findings by Hahn, and in late December, with her nephew, fellow physicist Otto Robert Frisch, she worked out the physics of this process by correctly interpreting Hahn and Strassmann\'s experimental data. On 13 January 1939, Frisch replicated the process Hahn and Strassmann had observed. In Meitner and Frisch\'s report in the February 1939 issue of [[Nature (journal)|Nature]], they gave the process the name "fission". Meitner did not share the 1944 [[Nobel Prize in Chemistry]] for nuclear fission, which was awarded to her long-time collaborator Otto Hahn. Several scientists and journalists have called her exclusion "unjust". According to the Nobel Prize archive, she was nominated 19 times for the Nobel Prize in Chemistry between 1924 and 1948, and 30 times for the Nobel Prize in Physics between 1937 and 1967.',
			},
		},
		related = { "C. V. Raman" },
		infobox = {
