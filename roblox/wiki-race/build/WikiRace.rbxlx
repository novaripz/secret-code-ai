		aliases = { "Seven Sisters", "Messier 45" },
		summary = "The **Pleiades**, also known as **Seven Sisters** and **Messier 45** (M45), is an [[Asterism (astronomy)|asterism]] of an [[Open cluster|open star cluster]] containing young [[Stellar classification|B-type stars]] in the northwest of the constellation Taurus.",
		sections = {
