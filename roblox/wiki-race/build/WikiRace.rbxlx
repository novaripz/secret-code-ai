		fame = 2,
		emoji = "🧪",
		source = "wikipedia",
		description = "Industry (branch), which is engaged in the manufacturing of chemical products",
		tags = { "Business and economics" },
		summary = "The **chemical industry** comprises the [[Company|companies]] and other organizations that develop and produce industrial, specialty and other chemicals. Central to the modern [[World economy|world economy]], the chemical industry converts raw materials ([[Petroleum|oil]], [[Natural gas|natural gas]], [[Atmosphere of Earth|air]], [[Water|water]], [[Metal|metals]], and [[Mineral|minerals]]) into commodity chemicals for industrial and consumer [[Product (business)|products]]. It includes industries for petrochemicals such as [[Polymer|polymers]] for plastics and synthetic fibers; [[Inorganic compound|inorganic chemicals]] such as [[Acid|acids]] and alkalis; agricultural chemicals such as [[Fertilizer|fertilizers]], [[Pesticide|pesticides]] and herbicides; and other categories such as industrial gases, speciality chemicals and [[Pharmaceutical industry|pharmaceuticals]].",
		sections = {
			{
				"Overview",
				"Various professionals are involved in the chemical industry including chemical engineers, chemists and lab technicians.",
