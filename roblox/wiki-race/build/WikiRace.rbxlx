		description = "American psychoanalyst and essayist (1902–1994)",
		tags = { "Psychologists" },
		aliases = { "Erik Homburger Erikson" },
		summary = "**Erik Homburger Erikson** was a German-American child psychoanalyst and visual artist known for his theory on psychosocial development of human beings. He coined the phrase identity crisis.",
		sections = {
			{
				"Overview",
				"Despite lacking a university degree, Erikson served as a professor at prominent institutions, including Harvard, [[University of California, Berkeley]], and Yale. A [[Review of General Psychology]] survey, published in 2002, ranked Erikson as the 12th most eminent psychologist of the 20th century.",
