	{
		title = "Georg Wilhelm Friedrich Hegel",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German philosopher (1770–1831)",
		tags = { "Philosophers", "Modern" },
		summary = "**Georg Wilhelm Friedrich Hegel** (27 August 1770 – 14 November 1831) was a German [[Philosophy|philosopher]] and a major figure in the tradition of [[German idealism]]. His influence on [[Western philosophy]] extends across a wide range of topics—from metaphysical issues in [[Epistemology|epistemology]] and [[Ontology|ontology]], to [[Political philosophy|political philosophy]], to philosophy of art and [[Philosophy of religion|philosophy of religion]].",
		sections = {
			{
				"Overview",
				'Hegel was born in [[Stuttgart]]. His life spanned the transitional period between the Enlightenment and the Romantic movement. His thought was shaped by the [[French Revolution]] and the Napoleonic wars, events which he interpreted from a philosophical perspective. His academic career culminated in his appointment to the chair of philosophy at the [[Humboldt University of Berlin|University of Berlin]], where he remained a prominent intellectual figure until his death. Throughout his work, Hegel strove to correct what he argued were untenable [[Mind–body dualism|dualisms]] common in modern philosophy. His principal achievement was the development of a comprehensive philosophical system, often termed absolute idealism, to account for reality as a unified whole. Central to this system is the concept of "spirit", which Hegel presented as humankind coming to know itself through a historical process of rational development.',
			},
		},
		related = { "Jacques Derrida" },
		infobox = {
			{ "Born", "27 August 1770" },
