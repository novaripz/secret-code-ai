		infobox = { { "Safety brake", "1852" }, { "Inventor", "Elisha Otis" } },
	},
	{
		title = "Transport",
		category = "Vehicle",
		fame = 1,
		emoji = "🚦",
		tags = { "Transport" },
		aliases = { "Transportation", "Vehicle", "Vehicles" },
		summary = "**Transport** is moving people and goods from place to place. Vehicles include the [[Car|car]], [[Train|train]], [[Ship|ship]] and [[Airplane|airplane]].",
		sections = {
			{
				"History",
				"For thousands of years people traveled on foot or by [[Horse|horse]]. The [[Steam engine|steam engine]] and the [[Wheel|wheel]] changed everything.",
