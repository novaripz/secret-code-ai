		summary = "A **trans-Neptunian object** (**TNO**), also written **transneptunian object**, is any [[Minor planet|minor planet]] in the [[Solar System]] that [[Orbit|orbits]] the [[Sun]] at a greater average distance than [[Neptune]], which has an orbital semi-major axis of 30.1 [[Astronomical unit|astronomical units]] (AU).",
		sections = {
