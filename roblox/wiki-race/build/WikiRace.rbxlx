		tags = { "More articles" },
		aliases = { "Source" },
		summary = "In [[Computing|computing]], **source code**, or simply **code** or **source**, is human readable plain text that can eventually result in controlling the behavior of a [[Computer|computer]]. Sometimes, code is compiled directly to [[Machine code|machine code]] so that it can be run in the native language of the computer without further processing. Many modern environments, though, involve compiling to an intermediate representation such as bytecode that can either run via an interpreter or be compiled on-demand to machine code via just-in-time compilation.",
