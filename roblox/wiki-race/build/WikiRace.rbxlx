		description = "Public university in Switzerland, founded 1833",
		tags = { "More articles" },
		aliases = { "UZH" },
		summary = "The **University of Zurich** (**UZH**, ) is a [[Public university|public]] [[Research university|research university]] in [[Zurich]], Switzerland. It is the largest university in Switzerland, with its appr. 28,700 enrolled students. It was founded in 1833 from the existing [[College|colleges]] of theology, [[Law|law]], [[Medicine|medicine]] which go back to 1525, and a new faculty of [[Philosophy|philosophy]].",
		sections = {
			{
				"Overview",
				"Currently, the university has seven schools: [[Philosophy]], [[Medicine|Human Medicine]], Economic Sciences, [[Law]], [[Mathematics]] and [[Natural science|Natural Sciences]], Theology and Veterinary Medicine. The university offers the widest range of subjects and courses of any Swiss higher education institution.",
			},
