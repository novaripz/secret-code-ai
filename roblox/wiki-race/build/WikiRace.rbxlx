		fame = 1,
		emoji = "⚖️",
		source = "wikipedia",
		description = "Forms of media that reach large audiences",
		tags = { "Mass media" },
		summary = "**Mass media** refers to the forms of [[Means of communication|media]] that reach large audiences via mass communication. It includes [[Broadcasting|broadcast media]], [[Digital media|digital media]], [[Publishing|print media]], [[Social media|social media]], [[Streaming media|streaming media]], [[Advertising|advertising]], and events.",
		sections = {
			{
				"Overview",
				"Mass media encompasses [[News|news]], advocacy, [[Entertainment|entertainment]], and public service announcements, and intersects with the study of [[Marketing|marketing]], propaganda, [[Public relations|public relations]], political communication, [[Journalism|journalism]], [[Art|art]], [[Drama|drama]], [[Computing|computing]], and [[Technology|technology]]. The influence of mass media on individuals and groups has also been analysed from the standpoint of [[Anthropology|anthropology]], [[Economics|economics]], [[History|history]], [[Law|law]], [[Philosophy|philosophy]], [[Psychology|psychology]], and [[Sociology|sociology]]. Mass media is often controlled by media conglomerates, which may include mass media organisations, companies, and networks, and may be susceptible to media capture.",
			},
