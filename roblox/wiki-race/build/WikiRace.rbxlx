			{ "Largest city", "capital" },
			{ "Official languages", "[[Modern Standard Arabic|Arabic]]" },
			{ "Government", "Unitary [[Presidential system|presidential republic]] under a provisional government" },
			{ "Established", "8 March 1920" },
			{ "Area", "185180 km²" },
			{ "Currency", "Syrian pound" },
		},
