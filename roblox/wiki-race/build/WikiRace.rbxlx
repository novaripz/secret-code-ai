	{
		title = "Brine",
		category = "Concept",
		fame = 2,
		emoji = "🧂",
		source = "wikipedia",
		description = "Concentrated solution of salt in water",
		tags = { "More articles" },
		aliases = { "Briny water" },
		summary = "**Brine** (or **briny water**) is a high-concentration [[Solution (chemistry)|solution]] of [[Salt|salt]] (typically [[Sodium chloride|sodium chloride]] or [[Calcium chloride|calcium chloride]]) in [[Water|water]]. In diverse contexts, brine may refer to the salt solutions ranging from about 3.5% (a typical concentration of [[Seawater|seawater]], on the lower end of that of solutions used for brining foods) up to about 26% (a typical saturated solution, depending on temperature). Brine forms naturally due to [[Evaporation|evaporation]] of ground saline water but it is also generated in the mining of sodium chloride. Brine is used for food processing and cooking ([[Pickling|pickling]] and brining), for de-icing of roads and other structures, and in a number of technological processes.",
		sections = {
			{
				"Overview",
				"It is also a by-product of many industrial processes, such as [[Desalination|desalination]], so it requires wastewater treatment for proper disposal or further utilization ([[Fresh water|fresh water]] recovery).",
			},
		},
	},
