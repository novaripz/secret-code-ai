		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French mathematician and physicist (1768–1830)",
		tags = { "Mathematicians", "Modern" },
		aliases = { "Jean-Baptiste Joseph Fourier" },
		summary = "**Jean-Baptiste Joseph Fourier** was a French mathematician and [[Physicist|physicist]] born in Auxerre, Burgundy and best known for initiating the investigation of [[Fourier series]], which eventually developed into [[Fourier analysis]] and [[Harmonic analysis|harmonic analysis]], and their applications to problems of [[Heat transfer|heat transfer]] and [[Vibration|vibrations]]. The [[Fourier transform]] and Fourier's law of conduction are also named in his honour. Fourier is also generally credited with the discovery of the [[Greenhouse effect|greenhouse effect]].",
