	{
		title = "Tetrapod",
		category = "Animal",
		fame = 1,
		emoji = "🐾",
		source = "wikipedia",
		description = "Clade of the first four-limbed vertebrates and their descendants",
		tags = { "Vertebrates", "Vertebrates, general classification" },
		aliases = { "Tetrapoda" },
		summary = "A **tetrapod** is any [[Vertebrate|vertebrate]] [[Animal|animal]] of the [[Clade|clade]] **Tetrapoda**. The main diagnostic and defining trait (synapomorphy) of tetrapods is having four limbs, connected to the shoulder- and pelvic girdles, for which the group is named. As a clade, Tetrapoda is defined such that it includes every organism which descended from four-limbed ancestors, including those which have lost some or all of these limbs, e.g. [[Snake|snakes]].",
		sections = {
			{
				"Overview",
				'Tetrapods include all [[Neontology|extant]] and [[Extinction|extinct]] [[Amphibian|amphibians]] and [[Amniote|amniotes]], with the latter in turn [[Evolution|evolving]] into two major clades, the sauropsids ([[Reptile|reptiles]], including [[Dinosaur|dinosaurs]] and therefore [[Bird|birds]]) and [[Synapsida|synapsids]] (extinct "pelycosaurs", therapsids and all extant [[Mammal|mammals]], including [[Human|humans]]). Hox gene mutations have resulted in some tetrapods becoming limbless ([[Snake|snakes]], legless lizards, and [[Caecilian|caecilians]]) or two-limbed ([[Cetacean|cetaceans]], [[Sirenia|sirenians]], some lizards, [[Kiwi (bird)|kiwis]], and the extinct [[Moa|moa]] and elephant birds). Nevertheless, they still qualify as tetrapods through their ancestry, and some retain a pair of vestigial spurs that are remnants of the hindlimbs. Early tetrapodomorphs were transitional between lobe-finned fishes and true four-limbed tetrapods, though most still fit the body plan expected of other lobe-finned fishes.',
			},
		},
		infobox = {
			{ "Scientific name", "Tetrapoda" },
		},
	},
	{
