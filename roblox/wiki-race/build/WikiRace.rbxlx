	{
		title = "Apollonius of Perga",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Ancient Greek geometer and astronomer (c. 240–190 BC)",
		tags = { "Pre-modern figures", "Ancient history" },
		summary = "**Apollonius of Perga** ( Apollṓnios ho Pergaîos; c. 240 BC) was an ancient Greek geometer and [[Astronomer|astronomer]] known for his work on conic sections. Beginning from the earlier contributions of [[Euclid]] and [[Archimedes]] on the topic, he brought them to the state prior to the invention of [[Analytic geometry|analytic geometry]]. His definitions of the terms [[Ellipse|ellipse]], [[Parabola|parabola]], and [[Hyperbola|hyperbola]] are the ones in use today. With his predecessors Euclid and Archimedes, Apollonius is generally considered among the greatest [[Mathematician|mathematicians]] of [[Classical antiquity|antiquity]].",
		sections = {
			{
				"Overview",
				"Aside from geometry, Apollonius worked on numerous other topics, including astronomy. Most of this work has not survived, where exceptions are typically fragments referenced by other authors like Pappus of Alexandria. His hypothesis of [[Orbital eccentricity|eccentric orbits]] to explain the apparently aberrant motion of the [[Planet|planets]], commonly believed until the [[Middle Ages]], was superseded during the [[Renaissance]]. The Apollonius crater on the [[Moon]] is named in his honor.",
			},
		},
		related = { "Zhang Heng" },
