			{ "Family", "[[Turkic languages|Turkic]]" },
			{
				"Writing system",
				"[[Latin script|Latin]] (Uzbek alphabet), [[Cyrillic script|Cyrillic]], [[Persian alphabet|Perso-Arabic]], Uzbek Braille (Uzbek alphabets)",
