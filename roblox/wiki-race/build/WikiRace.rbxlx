	{
		title = "Kale",
		category = "Plant",
		fame = 2,
		emoji = "🥬",
		source = "wikipedia",
		description = "Form of cabbage with green or purple leaves",
		tags = { "Eudicots", "Brassicales" },
		aliases = { "Leaf cabbage" },
		summary = "**Kale**, also called **leaf cabbage**, belongs to a group of cabbage ([[Brassica oleracea]]) [[Cultivar|cultivars]] primarily grown for their [[Leaf vegetable|edible leaves]], but it is also used as an [[Ornamental plant|ornamental plant]]. Its multiple different cultivars vary quite a bit in appearance; the leaves can be bumpy, curly, or flat, and the color ranges from purple to green.",
