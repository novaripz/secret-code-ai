	{
		title = "Melilla",
		category = "City",
		fame = 3,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Spanish autonomous city in northwestern Africa",
		tags = { "More articles" },
		summary = "**Melilla** is an [[Autonomous communities of Spain|autonomous city]] of [[Spain]] on the [[North Africa|North African]] coast. It lies on the eastern side of the Cape Three Forks, on the Morocco–Spain border, adjacent to the Moroccan port town of Beni Ansar, and faces the [[Mediterranean Sea]]. It has an area of 12.3 km².",
		sections = {
			{
				"Overview",
				"The trading outpost of Rusadir was established on the current site by seafaring Phoenicians. Passed over among several powers during Antiquity and the middle ages, the place was forsaken amid strife between the Kingdoms of Fez and Tlemcen, and it was seized by Christians in 1497, constituting a condominium between the House of Medina Sidonia and the [[Crown of Castile]] until 1556. Integrated in the Hispanic Monarchy, the fortress of Melilla la Vieja remained a military praesidium with limited civilian population for much of the early modern period. After the expansion of Melilla's perimetre to its current limits in the wake of the Treaty of Wad Ras (1860), the area in between Melilla la Vieja and the outer forts was urbanised and populated by mainland Spaniards, Sephardi Jews and Riffians, and the local economy thrived from the mining (iron ore) operations in the eastern Rif.",
			},
		},
		infobox = {
			{ "Type", "[[Autonomous communities of Spain|Autonomous city]]" },
			{ "Area", "12.3 km²" },
			{ "Population", "87,067" },
		},
	},
	{
		title = "Memphis, Egypt",
		category = "City",
		fame = 2,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Ancient capital of Inebu-hedj, Egypt",
		tags = { "Historical cities", "Africa" },
		aliases = { "Memphis", "Men-nefer" },
		summary = '**Memphis**, or **Men-nefer**, was the ancient capital of Inebu-hedj, the first nome of Lower Egypt that was known as mḥw ("North"). Its ruins are located in the vicinity of the present-day village of **Mit Rahina**, in Badrashin markaz (county), Giza Governorate, Egypt.',
		sections = {
			{
				"Overview",
				"Along with the pyramid fields that stretch across a desert plateau for more than 30 km on its west, including the famous Pyramids of Giza, Memphis and its necropolis have been listed as a [[World Heritage Site]]. The site is open to the public as an open-air museum. According to legends related in the early third century BC by Manetho, a priest and historian who lived in the [[Ptolemaic Kingdom]] during the [[Hellenistic period]] of Egyptian history, the city was founded by [[Pharaoh|King]] Menes. It was the capital of [[Ancient Egypt|ancient Egypt]] (Kemet or Kumat) during both the Early Dynastic Period and Old Kingdom and remained an important city throughout ancient Egyptian history. It occupied a strategic position at the mouth of the [[Nile Delta]], and was a hub of bustling activity.",
			},
		},
