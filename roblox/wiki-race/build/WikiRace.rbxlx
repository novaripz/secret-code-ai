	{
		title = "Rhododendron",
		category = "Plant",
		fame = 2,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of flowering plants",
		tags = { "Eudicots", "Ericales" },
		summary = '**Rhododendron**, from [[Ancient Greek]] ῥ (rhódon), meaning "rose", and (déndron), meaning "tree", is a very large [[Genus|genus]] of about 1,024 [[Species|species]] of woody plants in the [[Ericaceae|heath family]] (Ericaceae). They can be either [[Evergreen|evergreen]] or [[Deciduous|deciduous]]. Most species are native to [[East Asia|eastern Asia]] and the [[Himalayas|Himalayan]] region, but smaller numbers occur elsewhere in [[Asia]], and in [[North America]], [[Europe]] and [[Australia]].',
		sections = {
			{
				"Overview",
				'It is the national flower of [[Nepal]], the state flower of [[Washington (state)|Washington]] and [[West Virginia]] in the [[United States]], the state flower of Nagaland and [[Himachal Pradesh]] in [[India]], the provincial flower of Jeju Province in [[South Korea]] and [[Jiangxi]] in [[China]], and the state tree of [[Sikkim]] and [[Uttarakhand]] in [[India]]. Most species have brightly coloured flowers which bloom from late winter through to early summer. [[Azalea|Azaleas]] make up two subgenera of Rhododendron. They are distinguished from "true" rhododendrons by having only five anthers per flower.',
			},
		},
		related = { "Diospyros" },
		infobox = {
			{ "Scientific name", "Rhododendron" },
		},
	},
