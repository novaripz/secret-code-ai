	{
		title = "Petrochemical",
		category = "Technology",
		fame = 2,
		emoji = "🧪",
		source = "wikipedia",
		description = "Chemical product derived from petroleum",
		tags = { "Industry", "Material and chemical" },
		aliases = { "Petrochemicals", "Petchems" },
		summary = "**Petrochemicals** (sometimes abbreviated as **petchems**) are the [[Product (chemistry)|chemical products]] obtained from [[Petroleum|petroleum]] by refining. Some [[Chemical compound|chemical compounds]] made from petroleum are also obtained from other [[Fossil fuel|fossil fuels]], such as [[Coal|coal]] or [[Natural gas|natural gas]], or renewable sources such as [[Maize|maize]], palm fruit or [[Sugarcane|sugar cane]].",
		sections = {
			{
				"Overview",
				"The two most common petrochemical classes are [[Alkene|olefins]] (including [[Ethylene|ethylene]] and [[Propylene|propylene]]) and aromatics (including [[Benzene|benzene]], toluene and xylene isomers). [[Oil refinery|Oil refineries]] produce olefins and aromatics by fluid catalytic cracking of petroleum fractions. [[Chemical plant|Chemical plants]] produce olefins by steam cracking of natural gas liquids like [[Ethane|ethane]] and [[Propane|propane]]. Aromatics are produced by catalytic reforming of naphtha. Olefins and aromatics are the building-blocks for a wide range of materials such as [[Solvent|solvents]], [[Detergent|detergents]], and [[Adhesive|adhesives]]. Olefins are the basis for [[Polymer|polymers]] and oligomers used in [[Plastic|plastics]], [[Resin|resins]], [[Fiber|fibers]], elastomers, [[Lubricant|lubricants]], and gels. Global ethylene production was 190 million tonnes and propylene was 120 million tonnes in 2019. Aromatics production is approximately 70 million tonnes.",
			},
		},
		related = { "Abrasive" },
	},
	{
		title = "Petroleum",
		category = "Technology",
		fame = 1,
