	{
		title = "Atmospheric chemistry",
		category = "Concept",
		fame = 2,
		emoji = "🧪",
		source = "wikipedia",
		description = "Branch of atmospheric science in which the chemistry of the atmosphere is studied",
		tags = { "More articles" },
		summary = "**Atmospheric chemistry** is a branch of [[Atmospheric science|atmospheric science]] that studies the [[Chemistry|chemistry]] of the [[Atmosphere of Earth|Earth's atmosphere]] and that of other planets. This multidisciplinary approach of research draws on [[Environmental chemistry|environmental chemistry]], [[Physics|physics]], [[Meteorology|meteorology]], computer modeling, [[Oceanography|oceanography]], [[Geology|geology]] and volcanology, [[Climatology|climatology]] and other disciplines to understand both natural and human-induced changes in atmospheric composition. Key areas of research include the behavior of trace gasses, the formation of pollutants, and the role of aerosols and greenhouse gasses.",
		sections = {
			{
				"Overview",
				"Through a combination of observations, laboratory experiments, and computer modeling, atmospheric chemists investigate the causes and consequences of atmospheric changes.",
			},
