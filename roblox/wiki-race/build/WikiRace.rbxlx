	{
		title = "Lake Baikal",
		category = "Geography",
		fame = 2,
		emoji = "🏞️",
		source = "wikipedia",
		description = "Freshwater rift lake in Russia",
		tags = { "Lakes", "Asia" },
		summary = "**Lake Baikal** is a rift lake and the deepest lake in the world. It is situated in southern [[Siberia]], Russia, between the [[Federal subjects of Russia|federal subjects]] of Irkutsk Oblast to the northwest and the Republic of Buryatia to the southeast.",
		sections = {
			{
				"Overview",
				"At 31722 km²—slightly larger than [[Belgium]]—Lake Baikal is the world's seventh-largest lake by surface area, as well as the second-largest lake in [[Eurasia]] after the [[Caspian Sea]]. However, because it is also the deepest lake, with a maximum depth of 1642 m, Lake Baikal is the world's largest [[Fresh water|freshwater]] lake by volume, containing 23615.39 km³ of water or 22–23% of the world's fresh surface water, more than all of the [[North America|North American]] [[Great Lakes]] combined. It is also the world's [[Ancient lake|oldest lake]] at 25–30 million years, and among the clearest. It is estimated that the lake contains around 19% of the unfrozen [[Fresh water|fresh water]] on the planet. Lake Baikal is home to thousands of species of plants and animals, many of them [[Endemism|endemic]] to the region.",
			},
		},
		related = { "Lake Balkhash" },
		infobox = {
