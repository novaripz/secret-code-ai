	{
		title = "Walt Whitman",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American poet, essayist and journalist (1819–1892)",
		tags = { "Americas", "US and Canada" },
		aliases = { "Walter Whitman Jr." },
		summary = "**Walter Whitman Jr.** was an American poet, essayist, and journalist; he also wrote two novels. He is considered one of the most influential poets in [[American literature]] and [[World literature|world literature]]. Whitman incorporated both transcendentalism and [[Literary realism|realism]] in his writings and is often called the father of free verse. His work was controversial in his time, particularly his 1855 poetry collection [[Leaves of Grass]], which was described by some as obscene for its overt sensuality.",
		sections = {
			{
				"Overview",
				"Whitman was born in Huntington on Long Island and lived in [[Brooklyn]] as a child and through much of his career. At age 11, he left formal schooling to go to work. He worked as a journalist, a teacher, and a government clerk. Whitman's major poetry collection, Leaves of Grass, first published in 1855, was financed with his own money and became well known. The work was an attempt to reach out to the common person with an American [[Epic poetry|epic]]. Whitman continued expanding and revising Leaves of Grass until his death in 1892. His poetry often focused on both loss and healing. After suffering a stroke towards the end of his life, Whitman moved to Camden, New Jersey, where his health further declined. When he died at age 72, his funeral was a public event. Whitman's influence on poetry remains strong.",
			},
		},
		related = { "Kurt Vonnegut", "Stephen King" },
		infobox = {
			{ "Born", "31 May 1819" },
			{ "Birthplace", "Huntington, New York, U.S." },
			{ "Died", "26 March 1892" },
			{ "Occupation", "Poet, essayist, journalist" },
		},
	},
	{
		title = "Walter Cronkite",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American broadcast journalist (1916–2009)",
		tags = { "Journalists" },
		aliases = { "Walter Leland Cronkite Jr." },
		summary = '**Walter Leland Cronkite Jr.** (November 4, 1916 – July 17, 2009) was an American broadcast journalist who served as anchorman for the CBS Evening News from 1962 to 1981. During the 1960s and 1970s, he was often cited as "the most trusted man in America" after being so named in an opinion poll. Cronkite received numerous honors including two Peabody Awards, a George Polk Award, an Emmy Award, and the [[Presidential Medal of Freedom]].',
		sections = {
			{
				"Overview",
				'He was also known for his extensive coverage of the American space program, from Project Mercury to the [[Apollo program|Moon landings]] to the [[Space Shuttle]]. He was the only non-[[NASA]] recipient of an Ambassador of Exploration award. Cronkite is known for his departing catchphrase, "And that\'s the way it is," followed by the date of the broadcast.',
			},
