		tags = { "Eudicots", "Myrtales" },
		aliases = { "Cloves", "Syzygium aromaticum" },
		summary = "**Cloves** are the aromatic [[Flower|flower]] buds of a tree in the family [[Myrtaceae]], **Syzygium aromaticum**. They are native to the [[Maluku Islands]], or Moluccas, in [[Indonesia]], and are commonly used as a [[Spice|spice]], [[Flavoring|flavoring]], or fragrance in consumer products, such as toothpaste, [[Soap|soaps]], or [[Cosmetics|cosmetics]]. Freshly harvested cloves are available throughout the year owing to different [[Harvest|harvest]] seasons across various countries.",
