		emoji = "🌱",
		source = "wikipedia",
		description = "Plant with a growth habit of trailing or scandent stems or runners",
		tags = { "More articles" },
		summary = "A **vine** is any plant with a growth habit of trailing or scandent (that is, climbing) stems, lianas, or runners. The word vine can also refer to such stems or runners themselves, for instance, when used in wicker work.",
		sections = {
