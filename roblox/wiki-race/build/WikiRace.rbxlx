	{
		title = "Boyar",
		category = "History",
		fame = 2,
		emoji = "📜",
		source = "wikipedia",
		description = "Feudal aristocratic rank",
		tags = { "Post-classical" },
		aliases = { "Bolyar" },
		summary = "A **boyar** or **bolyar** was a member of the highest rank of the [[Feudalism|feudal]] [[Nobility|nobility]] in many Eastern European states, including [[First Bulgarian Empire|Bulgaria]], [[Kievan Rus']] (and later [[Russian nobility|Russia]]), Moldavia and Wallachia (and later [[Romania]]), Lithuania and among Baltic Germans. Comparable to Dukes/Grand Dukes, Boyars were second only to the ruling princes, grand princes or [[Tsar|tsars]] from the 10th to the 17th centuries.",
