		emoji = "⛏️",
		tags = { "Sandbox games", "Video games" },
		summary = "**Minecraft** is a sandbox [[Video game|video game]] in which players mine blocks and build anything they can imagine. It is the best-selling game of all time.",
		sections = {
			{
				"Gameplay",
				"Players gather resources like [[Diamond|diamonds]], survive monsters such as the [[Creeper|Creeper]], and craft tools.",
