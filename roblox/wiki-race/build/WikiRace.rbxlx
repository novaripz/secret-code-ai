		infobox = { { "Arena", "[[Colosseum]]" }, { "Era", "~264 BC–AD 404" } },
	},
	{
		title = "Ancient Greece",
		category = "History",
		fame = 1,
		emoji = "🏺",
		tags = { "Ancient civilizations" },
		aliases = { "Ancient Greeks" },
		summary = "**Ancient Greece** was a civilization of city-states such as [[Athens]] and Sparta that flourished from about 800 BC. It gave the world [[Democracy|democracy]], philosophy and the [[Olympic Games]].",
		sections = {
			{
				"Thinkers",
				"Philosophers [[Socrates]] and [[Aristotle]] and mathematicians like [[Pythagoras]] and [[Euclid]] lived there.",
