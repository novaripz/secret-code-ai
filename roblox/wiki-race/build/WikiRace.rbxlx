		title = "Mir",
		category = "Space",
		fame = 3,
		emoji = "🚉",
		source = "wikipedia",
		description = "Soviet/Russian space station (1986–2001)",
		tags = { "Space", "Crewed spacecraft" },
		summary = "**Mir** was a [[International Space Station|space station]] operated in [[Low Earth orbit|low Earth orbit]] from 1986 to 2001, first by the [[Soviet Union]] and later by the [[Russia|Russian Federation]]. Mir was the first modular space station and was assembled in orbit from 1986 to 1996. At the time it was the largest [[Satellite|artificial satellite]] in orbit, only being succeeded by the [[International Space Station]] (ISS) after Mir's deorbiting in 2001. The station served as a microgravity research laboratory in which crews conducted experiments in [[Biology|biology]], human biology, physics, [[Astronomy|astronomy]], [[Meteorology|meteorology]], and spacecraft systems with a goal of developing technologies required for permanent occupation of [[Outer space|space]].",
		sections = {
			{
				"Overview",
				"Mir was the first continuously inhabited long-term research station in orbit and previously held the record for the longest continuous human presence in space at 3,644 days, until it was surpassed by the ISS in 2010. It holds the record for the longest single human spaceflight, Valeri Polyakov, who spent 437 days on the station from 1994 until 1995. Mir's typical crew size was 3, though larger short-term crews made an appearance, peaking at ten during STS-71. Occupied for twelve and a half years out of its fifteen-year lifespan, 105 [[Astronaut|cosmonauts]] and astronauts from 12 different nations visited the station, and conducted 80 spacewalks.",
			},
		},
		related = { "Vostok 1", "Soyuz (spacecraft)" },
