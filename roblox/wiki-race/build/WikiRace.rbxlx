	{
		title = "Cepheid variable",
		category = "Space",
		fame = 3,
		emoji = "⭐",
		source = "wikipedia",
		description = "Type of variable star that pulsates radially",
		tags = { "Astronomy", "Stellar astronomy" },
		summary = "A **Cepheid variable** is a type of [[Variable star|variable star]] that pulsates radially, varying in both diameter and temperature. It changes in brightness, with a well-defined stable [[Frequency|period]] (typically 1–100 days) and amplitude. Cepheids are important cosmic benchmarks for scaling [[Cosmic distance ladder|galactic and extragalactic distances]]; a strong direct relationship exists between a Cepheid variable's [[Luminosity|luminosity]] and its [[Periodic function|pulsation period]].",
		sections = {
			{
				"Overview",
				"This characteristic of classical Cepheids was discovered in 1908 by Henrietta Swan Leavitt when she studied thousands of variable stars in the Magellanic Clouds. The discovery establishes the true luminosity of a Cepheid by observing its pulsation period. This in turn gives the distance to the star by comparing its known luminosity to its observed brightness, calibrated by direct observation of the parallax distance to the closest Cepheids such as RS Puppis and [[Polaris]]. Cepheids change brightness due to the –mechanism, which occurs when the opacity of a star's atmosphere increases with temperature rather than decreasing. The main gas involved is thought to be [[Helium|helium]]. On this analysis, the Cepheid cycle is driven by the fact that doubly ionized helium, the form found at high temperatures, is more opaque than singly ionized helium.",
			},
		},
	},
	{
		title = "Ceres (dwarf planet)",
		category = "Space",
		fame = 2,
		emoji = "🪐",
