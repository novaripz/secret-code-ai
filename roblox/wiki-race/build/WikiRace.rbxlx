	{
		title = "Loricariidae",
		category = "Animal",
		fame = 3,
		emoji = "👪",
		source = "wikipedia",
		description = "Largest family of catfish",
		tags = { "Fishes", "Siluriformes" },
		summary = '**Loricariidae** is the largest [[Family (taxonomy)|family]] of [[Catfish|catfish]] (order Siluriformes), with over 90 [[Genus|genera]] and just over 680 [[Species|species]]. Loricariids originate from [[Fresh water|freshwater]] habitats of [[Costa Rica]], [[Panama]], and tropical and subtropical [[South America]]. These fish are noted for the bony plates covering their bodies and their suckermouths. Several [[Genus|genera]] are sold as "plecos", notably the suckermouth catfish, Hypostomus plecostomus, and are popular as [[Aquarium|aquarium]] fish.',
