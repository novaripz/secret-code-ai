		tags = { "Southeast Asia", "Vietnam" },
		aliases = { "Hai Phong" },
		summary = "**Haiphong** or **Hai Phong** is the third-largest city in [[Vietnam]], with an area of 3194.72 km². It includes Bạch Long Vĩ and Cát Bà islands in the Gulf of Tonkin. Haiphong has a population of 4,664,124 in 2025. Haiphong holds the historical distinction of being the first city in both Vietnam and [[Mainland Southeast Asia]] to be electrified.",
