	{
		title = "Metaphysics (Aristotle)",
		category = "Book",
		fame = 3,
		emoji = "📚",
		source = "wikipedia",
		description = "One of the principal works of Aristotle",
		tags = { "Specific works of nonfiction", "Nonfiction of antiquity" },
		summary = "**Metaphysics** is one of the principal works of [[Aristotle]], in which he develops the doctrine that he calls First Philosophy. The work is a compilation of various texts treating abstract subjects, notably [[Substance theory|substance theory]], different kinds of [[Causality|causation]], form and matter, the existence of mathematical objects and the cosmos, which together constitute much of the branch of [[Philosophy|philosophy]] later known as [[Metaphysics|metaphysics]].",
