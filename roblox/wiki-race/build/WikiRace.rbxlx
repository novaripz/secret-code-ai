		summary = "**Tango** is a passionate partner dance and music style born in the port neighborhoods of [[Buenos Aires]], [[Argentina]], in the late 1800s.",
		sections = {
			{ "Instrument", "Its signature sound comes from the bandoneón, a kind of accordion from [[Germany]]." },
