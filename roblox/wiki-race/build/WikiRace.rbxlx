	{
		title = "Abbas Kiarostami",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Iranian filmmaker (1941–2016)",
		tags = { "Directors", "Asia" },
		summary = "**Abbas Kiarostami** was an Iranian film director, screenwriter, poet, photographer, and film producer. An active filmmaker from 1970, Kiarostami had been involved in the production of over forty films, including shorts and documentaries. Kiarostami attained critical acclaim for directing the Koker trilogy (1987–1994), Close-Up (1990), The Wind Will Carry Us (1999), and Taste of Cherry (1997), which was awarded the [[Palme d'Or]] at the Cannes Film Festival that year. In later works, Certified Copy (2010) and Like Someone in Love (2012), he filmed for the first time outside Iran: in Italy and Japan, respectively.",
		sections = {
			{
				"Overview",
				"His films Where Is the Friend's House? (1987), Close-Up, and The Wind Will Carry Us were ranked among the 100 best foreign films in a 2018 critics' poll by [[BBC]] Culture. Close-Up was also ranked one of the 50 greatest movies of all time in the famous decennial Sight & Sound poll conducted in 2012. He is widely regarded as one of the greatest and most influential filmmakers of Iran, and of all time. Kiarostami worked extensively as a screenwriter, film editor, art director, and producer and had designed credit titles and publicity material. He was also a poet, photographer, painter, illustrator, and graphic designer. He was part of a generation of filmmakers in the Iranian New Wave, a Persian cinema movement that started in the late 1960s and emphasized the use of poetic dialogue and allegorical storytelling dealing with political and philosophical issues.",
			},
		},
		related = { "Akira Kurosawa", "Yasujirō Ozu" },
		infobox = {
			{ "Born", "22 June 1940" },
			{ "Birthplace", "[[Tehran]], Imperial State of Iran" },
			{ "Died", "4 July 2016" },
			{ "Education", "University of Tehran" },
			{ "Occupation", "Filmmaker, Screenwriter, photographer, producer, painter, poet" },
			{ "Movement", "Iranian New Wave" },
			{ "Years active", "1962–2016" },
		},
	},
	{
		title = "Abbas the Great",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Shah of Safavid Iran from 1587 to 1629",
		tags = { "Asia and Oceania", "Central Asia, Iran, Caucasus" },
		aliases = { "Abbas I" },
		summary = "**Abbas I**, commonly known as **Abbas the Great**, was the fifth [[Safavid Iran|Safavid]] shah of Iran from 1588 to 1629. The third son of Shah Mohammad Khodabanda, he is generally considered one of the most important rulers in Iranian history and the greatest ruler of the Safavid dynasty.",
		sections = {
			{
				"Overview",
				"Although Abbas would reign over Safavid Iran at its military, political and economic height, he came to the throne during a period of instability in the empire. Meanwhile, Iran's main enemies, its archrival, the [[Ottoman Empire]], and the [[Khanate of Bukhara|Uzbeks]], exploited this political chaos to seize territory for themselves. In 1588, one of the Qizilbash leaders, Murshid Quli Khan, overthrew Shah Mohammed in a coup and placed the 16-year-old Abbas on the throne. However, Abbas soon seized power for himself. This allowed Abbas to eclipse the power of the Qizilbash in the civil administration, the royal house, and the military. By the end of the 1603–1618 Ottoman War, Abbas had regained possession over [[South Caucasus]] and [[Dagestan]], as well as swaths of Western Armenia and [[Mesopotamia]].",
			},
		},
		related = { "Hong Taiji", "Quang Trung" },
		infobox = {
			{ "Born", "27 January 1571" },
			{ "Birthplace", "[[Herat]], [[Safavid Iran]] (modern-day [[Afghanistan]])" },
			{ "Died", "19 January 1629 (aged 57)" },
		},
	},
	{
		title = "Abd Allah al-Mahdi Billah",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Isma'ili Imam and first Fatimid Caliph from 909 to 934",
		tags = { "Post-classical", "Africa" },
		aliases = { "Abū Muḥammad ʿAbd Allāh ibn al-Ḥusayn", "Al-Mahdī biʾllāh" },
		summary = "**Abū Muḥammad ʿAbd Allāh ibn al-Ḥusayn**, better known by his [[Regnal name|regnal name]] **al-Mahdī biʾllāh**, was the founder of the Isma'ili [[Fatimid Caliphate]], the only major Shi'a caliphate in [[History of Islam|Islamic history]], and the eleventh Imam of the Isma'ili branch of Shi'ism.",
		sections = {
			{
				"Overview",
				"He was born as **Saʿīd ibn al-Ḥusayn** in Askar Mukram to a family that led the secret Isma'ili missionary network (da'wa), propagating on behalf of the hidden imam, Muhammad ibn Isma'il, who would return as the prophesied Islamic messiah (mahdi). Orphaned at a young age, he moved to Salamiya, the family's base of operations, where he was adopted by his uncle. In the mid-890s Sa'id succeeded to the leadership of the expanding da'wa, which had expanded and gained adherents across the then Muslim world. However, his claims of not merely being a trustee of the hidden imam, but of him and his ancestors holding the imamate itself, led in 899 to a schism in the Isma'ili movement: those who did not recognise his claims split off to become the Qarmatians.",
			},
		},
		related = { "Baybars", "Askia Muhammad I" },
		infobox = {
			{ "Born", "31 July 874" },
			{ "Birthplace", "Askar Mukram, Khuzistan (modern Iran)" },
			{ "Died", "4 March 934 (aged 59)" },
		},
	},
	{
		title = "Abd al-Malik ibn Marwan",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Umayyad caliph from 685 to 705",
		tags = { "Western Asia", "Caliphates" },
		aliases = { "Abd al-Malik ibn Marwan ibn al-Hakam" },
		summary = "**Abd al-Malik ibn Marwan ibn al-Hakam**, was the fifth Umayyad caliph, ruling from April 685 until his death in October 705. A member of the first generation of born Muslims, his early life in [[Medina]] was occupied with religious pursuits. He held administrative and military posts under Caliph [[Mu'awiya I]], founder of the Umayyad Caliphate, and his own father, Caliph Marwan I. By the time of Abd al-Malik's accession, Umayyad authority had collapsed across the Caliphate as a result of the Second Fitna and had been reconstituted in Syria and Egypt during his father's reign.",
		sections = {
			{
				"Overview",
				"Following a failed invasion of Iraq in 686, Abd al-Malik focused on securing Syria before making further attempts to conquer the greater part of the Caliphate from his principal rival, the [[Mecca]]-based caliph Abd Allah ibn al-Zubayr. To that end, he concluded an unfavorable truce with the reinvigorated [[Byzantine Empire]] in 689, quelled a coup attempt in [[Damascus]] by his kinsman, al-Ashdaq, the following year, and reincorporated into the army the rebellious Qaysi tribes of the Jazira (Upper Mesopotamia) in 691. The war with Byzantium resumed, resulting in Umayyad advances into [[Anatolia]] and Armenia, the destruction of [[Carthage]] and the recapture of Kairouan, the launchpad for the later conquests of [[Maghreb|western North Africa]] and the [[Al-Andalus|Iberian Peninsula]], in 698.",
			},
		},
		related = { "Uthman", "Umar" },
		infobox = {
			{ "Born", "July/August 644 or June/July 647" },
			{ "Birthplace", "[[Medina]], Hejaz, Rashidun Caliphate" },
			{ "Died", "9 October 705 (aged 58–61)" },
		},
	},
	{
		title = "Abd al-Rahman I",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "Emir of Córdoba from 756 to 788",
		tags = { "Western Europe", "Iberia" },
		aliases = { "Abd al-Rahman ibn Mu'awiya" },
		summary = "**Abd al-Rahman ibn Mu'awiya**, commonly known as **Abd al-Rahman I**, was the founder and first emir of the Emirate of Córdoba, ruling from 756 to 788. He established the [[Umayyad dynasty]] in [[Al-Andalus|al-Andalus]], which continued for nearly three centuries (including the succeeding Caliphate of Córdoba).",
		sections = {
			{
				"Overview",
				'Abd al-Rahman was a member of the Umayyad dynasty in [[Damascus]], and his establishment of a government in Iberia represented a break with the Abbasids, who had overthrown the Umayyads in Damascus in 750. He was also known by the surnames al-Dakhil ("the Immigrant"), Saqr Quraysh ("the Falcon of Quraysh").',
			},
