	{
		title = "Hermann Weyl",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "German mathematician (1885–1955)",
		tags = { "Mathematicians", "Modern" },
		aliases = { "Hermann Klaus Hugo Weyl" },
		summary = "**Hermann Klaus Hugo Weyl** was a German [[Mathematician|mathematician]], theoretical physicist, logician and [[Philosophy|philosopher]]. Although much of his working life was spent in [[Zurich|Zürich]], [[Switzerland]], and then [[Princeton, New Jersey]], he is associated with the [[University of Göttingen]] tradition of mathematics, represented by [[Carl Friedrich Gauss]], [[David Hilbert]] and Hermann Minkowski.",
		sections = {
			{
				"Overview",
				'His research has had major significance for [[Theoretical physics|theoretical physics]] as well as purely mathematical disciplines such as [[Number theory|number theory]]. He was one of the most influential mathematicians of the twentieth century, and an important member of the [[Institute for Advanced Study]] during its early years. Weyl contributed to an exceptionally wide range of fields, including works on [[Space|space]], [[Time|time]], [[Matter|matter]], [[Philosophy|philosophy]], [[Logic|logic]], [[Symmetry|symmetry]] and the [[History of mathematics|history of mathematics]]. He was one of the first to conceive of combining [[Theory of relativity|general relativity]] with the laws of [[Electromagnetism|electromagnetism]]. Freeman Dyson wrote that Weyl alone bore comparison with the "last great universal mathematicians of the nineteenth century", [[Henri Poincaré]] and [[David Hilbert]]. Michael Atiyah commented that whenever he examined a mathematical topic, he found that Weyl had preceded him.',
			},
		},
		related = { "Karl Pearson" },
