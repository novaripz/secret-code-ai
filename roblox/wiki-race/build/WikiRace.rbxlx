	{
		title = "Frank Lloyd Wright",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American architect (1867–1959)",
		tags = { "Other visual arts", "Architects" },
		aliases = { "Frank Lloyd Wright Sr." },
		summary = '**Frank Lloyd Wright Sr.** (June 8, 1867 – April 9, 1959) was an American architect, designer, writer, and educator. He designed more than 1,000 structures over a creative period of 70 years. Wright played a key role in the architectural movements of the twentieth century, influencing architects worldwide through his works and mentoring hundreds of apprentices in his Taliesin Fellowship. Wright believed in designing in harmony with humanity and the environment, a philosophy he called organic architecture. This philosophy was exemplified in Fallingwater (1935), which has been called "the best all-time work of American architecture".',
		sections = {
			{
				"Overview",
				'Wright was a pioneer of what came to be called the Prairie School movement of architecture and also developed the concept of the Usonian home within Broadacre City, his vision for urban planning in the United States. Wright also designed original and innovative offices, churches, schools, skyscrapers, hotels, museums, and other commercial projects. Wright-designed interior elements (including leaded glass windows, floors, furniture and even tableware) were integrated into these structures. He wrote several books and numerous articles and was a popular lecturer in the United States and in Europe. Wright was recognized in 1991 by the [[American Institute of Architects]] as "the greatest American architect of all time". In 2019, a selection of his work became a listed [[World Heritage Site]] under the name The 20th-Century Architecture of Frank Lloyd Wright.',
			},
		},
		related = { "Andrea Palladio", "Frank Gehry", "Mimar Sinan" },
		infobox = {
			{ "Born", "8 June 1867" },
			{ "Birthplace", "Richland Center, Wisconsin, U.S." },
			{ "Died", "9 April 1959" },
			{ "Education", "[[University of Wisconsin–Madison]]" },
		},
	},
	{
		title = "Frantz Fanon",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French West Indian psychiatrist and philosopher (1925-1961)",
		tags = { "Philosophers", "Modern" },
		aliases = { "Frantz Omar Fanon" },
		summary = "**Frantz Omar Fanon**, an [[Algeria|Algerian]] psychiatrist and [[Political philosophy|political philosopher]], developed ideas which have become influential in the fields of post-colonial studies and [[Critical theory|critical theory]]. As well as an intellectual, Fanon was a political radical and Pan-Africanist, concerned with the psychopathology of [[Colonization|colonization]] and the human, social, and cultural consequences of [[Decolonization|decolonization]].",
		sections = {
			{
				"Overview",
				'In the course of his work as a physician and psychiatrist, Fanon supported the Algerian War of independence (1954-1962) from France and joined the Algerian National Liberation Front. Jansen and Osterhammel characterise Fanon as "the most influential anticolonial thinker of his time". For more than five decades, the life and works of Fanon have inspired national liberation movements and other freedom and political movements in [[Sri Lanka]], [[South Africa]], and the [[United States]]. Fanon formulated a model for community psychology, believing that many mental health patients would have an improved prognosis if they were integrated into their family and community instead of being treated with institutionalized care. He also helped found the field of institutional psychotherapy while working at Saint-Alban under François Tosquelles and Jean Oury.',
			},
		},
		related = { "Jürgen Habermas" },
		infobox = {
			{ "Birthplace", "Fort-de-France, [[Martinique]], [[French Third Republic|France]]" },
			{ "Died", "6 December 1961" },
			{ "Education", "University of Lyon (MD, 1951)" },
			{ "Notable works", "Black Skin, White Masks (1952) The Wretched of the Earth (1961)" },
			{ "Region", "Africana philosophy" },
			{ "Era", "[[Contemporary philosophy]]" },
		},
	},
	{
		title = "Franz Boas",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "German-born American anthropologist (1858–1942)",
		tags = { "Social scientists" },
		aliases = { "Franz Uri Boas" },
		summary = '**Franz Uri Boas** (July 9, 1858 – December 21, 1942) was a German-American anthropologist and ethnomusicologist. He was a pioneer of modern [[Anthropology|anthropology]] who has been called the "Father of American Anthropology". His work is associated with the movements known as historical particularism and [[Cultural relativism|cultural relativism]].',
		sections = {
			{
				"Overview",
				"Studying in Germany, Boas was awarded a doctorate in 1881 in [[Physics|physics]] while also studying [[Geography|geography]]. He then participated in a geographical expedition to northern Canada, where he became fascinated with the culture and language of the [[Baffin Island]] Inuit. He went on to do field work with the indigenous cultures and languages of the Pacific Northwest. In 1887 he emigrated to the United States, where he first worked as a museum curator at the Smithsonian, and in 1899 became a professor of anthropology at [[Columbia University]], where he remained for the rest of his career. Through his students, many of whom went on to found anthropology departments and research programmes inspired by their mentor, Boas profoundly influenced the development of American anthropology.",
			},
		},
		related = { "Claude Lévi-Strauss", "Margaret Mead" },
		infobox = {
			{ "Born", "9 July 1858" },
			{ "Birthplace", "Minden, Prussia (now in North Rhine-Westphalia, Germany)" },
			{ "Died", "21 December 1942" },
			{ "Teacher", "Gustav Karsten" },
			{ "Worked at", "Clark University, [[Columbia University]]" },
			{ "Known for", "[[Cultural relativism]], four-field approach" },
			{
				"Education",
				"[[Heidelberg University|University of Heidelberg]], [[University of Bonn]], University of Kiel",
			},
		},
	},
	{
		title = "Franz Kafka",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Austrian and Czech writer (1883–1924)",
		tags = { "Western Europe", "Germany and Austria" },
		summary = "**Franz Kafka** (3 July 1883 – 3 June 1924) was a German-language Jewish Czech writer and novelist born in [[Prague]], in the Austro-Hungarian Empire. Widely regarded as a major figure of 20th-century literature, his works fuse elements of [[Literary realism|realism]] and the fantastique, and typically feature isolated protagonists facing bizarre or surreal predicaments and incomprehensible bureaucratic powers. The term Kafkaesque has entered the lexicon to describe situations like those depicted in his writings. His best-known works include the novella [[The Metamorphosis]] (1915) and the novels The Trial (1924) and The Castle (1926).",
		sections = {
			{
				"Overview",
				"He is also celebrated for his brief fables and aphorisms, which frequently incorporated comedic elements alongside the darker themes of his longer works. His work has widely influenced artists, philosophers, composers, filmmakers, literary historians, religious scholars, and cultural theorists. Kafka was born into a middle-class German-speaking Jewish Czech family in Prague, the capital of the [[Kingdom of Bohemia|Bohemia]], in [[Austria-Hungary]]. He trained as a lawyer, and after completing his legal education was employed in various legal and insurance jobs. His professional obligations led to internal conflict as he felt that his true vocation was writing.",
			},
		},
		related = { "Bertolt Brecht", "Brothers Grimm", "Heinrich Heine", "Hermann Hesse", "Rainer Maria Rilke" },
		infobox = {
			{ "Born", "3 July 1883" },
			{ "Birthplace", "[[Prague]], Austria-Hungary" },
			{ "Died", "3 June 1924" },
			{ "Occupation", "Novelist short story writer insurance officer" },
			{ "Education", "German Charles-Ferdinand University" },
			{ "Citizenship", "Austria (until 1918) [[Czechoslovakia]] (from 1918)" },
			{ "Style", "[[Literary modernism|Modernism]]" },
		},
	},
	{
		title = "François Rabelais",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "French writer and humanist (died 1553)",
		tags = { "Europe", "France" },
		summary = "**François Rabelais** was a French writer who has been called the first great French prose author. A [[Renaissance humanism|humanist]] of the French Renaissance and Greek scholar, he attracted opposition from both Protestant theologian John Calvin and from the hierarchy of the Catholic Church. Though in his day he was best known as a physician, scholar, diplomat, and Catholic priest, later he became better known as a satirist for his depictions of the grotesque, and for his larger-than-life characters.",
		sections = {
			{
				"Overview",
				'Living in the religious and political turmoil of the [[Reformation]], Rabelais treated the great questions of his time in his novels. Rabelais admired [[Erasmus]] and like him is considered a Christian humanist. Rabelais is widely known for the first two volumes relating the childhoods of the giants Gargantua and Pantagruel written in the style of [[Bildungsroman|bildungsroman]]; his later works—the Third Book (which prefigures the philosophical novel) and the Fourth Book are considerably more erudite in tone. His literary legacy gave rise to the word Rabelaisian, an adjective meaning "marked by gross robust humor, extravagance of caricature, or bold naturalism."',
			},
		},
		related = { "Voltaire", "Molière" },
		infobox = {
			{ "Born", "Between 1483 and 1494" },
			{ "Birthplace", "Seuilly, Touraine, France" },
			{ "Died", "Between January and 14 March 1553" },
			{ "Occupation", "Writer, physician, humanist, Catholic priest" },
			{ "Education", "University of Poitiers University of Montpellier" },
			{ "Movement", "[[Renaissance humanism]]" },
			{ "Notable works", "Gargantua and Pantagruel" },
		},
	},
	{
		title = "François Truffaut",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "French filmmaker (1932–1984)",
		tags = { "Europe", "France" },
		aliases = { "François Roland Truffaut" },
		summary = "**François Roland Truffaut** was a French filmmaker, actor, and critic. Widely regarded as one of the founders of the French New Wave, he came under the tutelage of film critic André Bazin as a young man and was hired to write for the latter's Cahiers du Cinéma, where Truffaut became a proponent of the auteur theory, which posits that a film's director is its true author.",
		sections = {
			{
				"Overview",
				"The 400 Blows (1959), starring Jean-Pierre Léaud as Truffaut's alter ego Antoine Doinel, was a defining film of the New Wave. Truffaut's films Stolen Kisses (1968), Bed and Board (1970) and Love on the Run (1979) continued to chronicle the story of the couple Antoine and Christine (Claude Jade). Truffaut contributed to another significant milestone of the movement with his work on Breathless (1960), a film directed by his Cahiers colleague [[Jean-Luc Godard]]. Truffaut's other notable films include Shoot the Piano Player (1960), Jules and Jim (1962), The Soft Skin (1964), Two English Girls (1971) and The Last Metro (1980). Truffaut's Day for Night (1973) earned him the BAFTA Award for Best Film and the Academy Award for Best Foreign Language Film.",
			},
		},
		related = { "David Lean", "Michelangelo Antonioni" },
		infobox = {
