	{
		title = "The Canterbury Tales",
		category = "Book",
		fame = 3,
		emoji = "📚",
		source = "wikipedia",
		description = "Story collection by Geoffrey Chaucer",
		tags = { "Specific works of poetry", "Poetic works of antiquity" },
		summary = "**The Canterbury Tales** are an anthology of twenty-four short stories written in [[Middle English]] by [[Geoffrey Chaucer]] between 1387 and 1400. They are mostly in [[Verse (poetry)|verse]], and are presented as part of a fictional storytelling contest held by a group of pilgrims travelling from [[London]] to Canterbury in order to visit the shrine of Saint Thomas Becket at Canterbury Cathedral.",
		sections = {
			{
				"Overview",
				"The Canterbury Tales are widely regarded as Chaucer's [[Masterpiece|magnum opus]], and they are revered as one of the paramount works of [[English literature]]. The Tales had a major effect upon the development of English literature itself. They may have been responsible for the popularisation of the English [[Vernacular|vernacular]] in mainstream English literature, as opposed to [[French language|French]] or [[Latin]]. Most scholars think the Tales were incomplete at the end of Chaucer's life. In the General Prologue, some 30 pilgrims are introduced. According to the Prologue, Chaucer's intention was to write four stories from the perspective of each pilgrim, two each on the way to and from their ultimate destination, Saint Thomas Becket's shrine (making for a total of about 120 stories).",
			},
		},
		related = { "Songs of Innocence and of Experience" },
