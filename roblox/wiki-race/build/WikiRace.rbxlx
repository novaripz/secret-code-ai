	{
		title = "Lamb and mutton",
		category = "Food",
		fame = 3,
		emoji = "🍖",
		source = "wikipedia",
		description = "Meat of domestic sheep",
		tags = { "Food types", "Meat and other animal products" },
		aliases = { "Sheep meat" },
		summary = '**Lamb and mutton**, collectively **sheep meat** (or sheepmeat), is [[Meat|meat]] from the [[Sheep|domestic sheep]], Ovis aries. It is generally divided into three types: **lamb**, from sheep in their first year; **hogget**, from sheep in their second; and **mutton**, from older sheep. The name "mutton" comes from [[French language]] mouton, sheep.',
		sections = {
			{
				"Overview",
				'Lamb is the most expensive of the three types, and in recent decades, sheep meat has increasingly only been retailed as "lamb", sometimes stretching the accepted distinctions given above. The stronger-tasting mutton is now hard to find in many areas, despite the efforts of the Mutton Renaissance Campaign in the UK. In Australia, the term **prime lamb** is often used to refer to lambs raised for meat.',
			},
		},
	},
	{
		title = "Lard",
		category = "Food",
		fame = 3,
		emoji = "🍽️",
		source = "wikipedia",
		description = "Semi-solid white pork fat product",
		tags = { "Food types", "Meat and other animal products" },
		summary = "**Lard** is a semi-solid white [[Fat|fat]] product obtained by rendering the fatty tissue of a pig. It is distinguished from tallow, a similar product derived from fat of [[Cattle|cattle]] or [[Sheep|sheep]].",
		sections = {
			{
				"Overview",
				"Lard can be rendered by steaming, boiling, or dry heat. The culinary qualities of lard vary somewhat depending on the origin and processing method; if properly rendered, it may be nearly odorless and tasteless. It has a high saturated fatty acid content and no trans fat. At retail, refined lard is usually sold as paper-wrapped blocks. Many cuisines use lard as a [[Cooking|cooking]] fat or shortening, or as a spread in the same ways as [[Butter|butter]]. It is an ingredient in various savoury dishes such as [[Sausage|sausages]], pâtés, and fillings. As a replacement for butter, it provides flakiness to [[Pastry|pastry]]. In western cuisine, it has ceded its popularity to [[Vegetable oil|vegetable oils]], but many cooks and bakers still favor it over other fats for certain uses.",
			},
		},
	},
	{
		title = "Lunch",
		category = "Food",
		fame = 3,
		emoji = "🍽️",
		source = "wikipedia",
		description = "Midday meal",
		tags = { "Cooking, food and drink", "Basics" },
		summary = "**Lunch** is a [[Meal|meal]] typically consumed around the middle of the day, following [[Breakfast|breakfast]] and preceding [[Dinner|dinner]]. It varies in form, size, and significance across cultures and historical periods. In some societies, lunch constitutes the main meal of the day and may consist of multiple courses, while in others it is lighter and more utilitarian in nature.",
		sections = {
			{
				"Overview",
				"The foods consumed at lunch differ widely according to local dietary customs, ranging from simple items such as [[Sandwich|sandwiches]] or [[Salad|salads]] to more elaborate meals involving rice, [[Noodle|noodles]], or [[Soup|soups]]. Regional and cultural practices continue to shape lunch traditions, which are further influenced by factors such as religion, geography, and economic context.",
			},
		},
	},
	{
		title = "Margarine",
		category = "Food",
		fame = 3,
		emoji = "🍽️",
		source = "wikipedia",
		description = "Semi-solid oily spread often used as a butter substitute",
		tags = { "Food types", "Dairy and analogues" },
		summary = '**Margarine** is a spread used for flavoring, baking, and cooking. It is most often used as a substitute for [[Butter|butter]]. Although originally made from animal fats, most margarine consumed today is made from [[Vegetable oil|vegetable oil]]. The spread was originally named oleomargarine from [[Latin]] for oleum (olive oil) and [[Greek language|Greek]] margarite ("pearl", indicating luster). The name was later shortened to margarine, or sometimes oleo (particularly in the Deep South region of the United States).',
		sections = {
			{
				"Overview",
				"Margarine consists of a water-in-fat emulsion, with tiny droplets of water dispersed uniformly throughout a fat phase in a stable solid form. While butter is made by concentrating the butterfat of milk through centrifugation, modern margarine is made through a more intensive processing of refined [[Vegetable oil|vegetable oil]] and water. Margarine can be used as an ingredient in other food products, such as pastries, doughnuts, cakes, biscuits and cookies.",
			},
