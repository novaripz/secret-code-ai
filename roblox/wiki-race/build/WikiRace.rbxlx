			{ "Genre", "Fiction" },
			{ "Movement", "Literary impressionism, [[Literary modernism|Modernism]], Neo-romanticism" },
			{ "Notable works", "Heart of Darkness (1899) Lord Jim (1900) Nostromo (1904) The Secret Agent (1907)" },
