	{
		title = "Muskrat",
		category = "Animal",
		fame = 3,
		emoji = "🐾",
		source = "wikipedia",
		description = "Species of rodent",
		tags = { "Mammals", "Rodents" },
		aliases = { "Common muskrat", "Ondatra zibethicus" },
		summary = "The **muskrat** or **common muskrat** (**Ondatra zibethicus**) is a medium-sized [[Semiaquatic|semiaquatic]] [[Rodent|rodent]].",
		sections = {
			{
				"Overview",
				"Adult muskrats weigh 0.6–2 kg, with a body length (excluding the tail) of 20–35 cm. They are covered with short, thick fur of medium to dark brown color. Their long tails, covered with scales rather than hair, are laterally compressed and generate a small amount of thrust, with their webbed hind feet being the main means of propulsion and the unique tail mainly important in directional stability. Muskrats spend most of their time in the water and can swim underwater for 12 to 17 minutes. They live in families of a male and female pair and their young. They build nests to protect themselves from the cold and predators, often burrowed into the bank with an underwater entrance. Muskrats feed mostly on cattail and other aquatic vegetation but also eat small animals.",
			},
		},
		related = { "Mouse", "Beaver" },
		infobox = {
			{ "Scientific name", "Ondatra zibethicus" },
			{ "Conservation status", "Least Concern" },
		},
	},
	{
		title = "Mustelidae",
		category = "Animal",
		fame = 2,
		emoji = "👪",
		source = "wikipedia",
		description = "Family of mammals",
		tags = { "Mammals", "Carnivora" },
		summary = "The **Mustelidae** are a diverse family of [[Carnivora|carnivoran]] mammals, including [[Weasel|weasels]], badgers, [[Otter|otters]], [[Sea otter|sea otters]], polecats, [[Marten|martens]], grisons and [[Wolverine|wolverines]]. Otherwise known as **mustelids**, they form the largest family in the suborder Caniformia of the [[Order (taxonomy)|order]] Carnivora with between 66 to 70 species in nine subfamilies.",
		related = { "European badger" },
		infobox = {
