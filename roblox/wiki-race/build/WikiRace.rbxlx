			{ "Birthplace", "[[Kabul]], Kabulistan, [[Mughal Empire]] (present-day [[Afghanistan]])" },
			{ "Died", "27 January 1556" },
		},
	},
	{
		title = "Humphry Davy",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "British chemist and inventor (1778–1829)",
		tags = { "Chemistry", "Modern" },
		aliases = { "Sir Humphry Davy, 1st Baronet" },
		summary = "**Sir Humphry Davy, 1st Baronet** (17 December 1778 – 29 May 1829) was a British chemist and inventor who invented the Davy lamp and an early form of arc lamp. He is also remembered for isolating, by using electricity, several [[Chemical element|elements]] for the first time: [[Potassium|potassium]] and [[Sodium|sodium]] in 1807 and [[Calcium|calcium]], [[Strontium|strontium]], [[Barium|barium]], [[Magnesium|magnesium]] and [[Boron|boron]] the following year, as well as for discovering the elemental nature of [[Chlorine|chlorine]] and [[Iodine|iodine]]. Davy also studied the forces involved in these separations, inventing the new field of [[Electrochemistry|electrochemistry]]. He is credited with discovering clathrate hydrates. In 1799, he experimented with [[Nitrous oxide|nitrous oxide]] and was astonished at how it made him laugh.",
		sections = {
			{
				"Overview",
				'He nicknamed it "laughing gas" and wrote about its potential as an anaesthetic to relieve pain during surgery. Davy was a baronet, President of the Royal Society (PRS), Member of the Royal Irish Academy (MRIA), a founder member and Fellow of the Geological Society of London, a member of the Royal Geological Society of Cornwall, and a member of the [[American Philosophical Society]]. [[Jöns Jacob Berzelius|Berzelius]] called Davy\'s 1806 Bakerian Lecture "On Some Chemical Agencies of Electricity" "one of the best memoirs which has ever enriched the theory of chemistry."',
			},
		},
		infobox = {
			{ "Born", "17 December 1778" },
			{ "Birthplace", "Penzance, Cornwall, England" },
			{ "Died", "29 May 1829" },
