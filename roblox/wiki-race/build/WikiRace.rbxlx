	{
		title = "Antonio Gramsci",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Italian Marxist philosopher, writer, and politician (1891–1937)",
		tags = { "Political writers", "Modern" },
		aliases = { "Antonio Francesco Gramsci" },
		summary = "**Antonio Francesco Gramsci** was an Italian Marxist philosopher, [[Journalist|journalist]] and politician. He was a founding member and one-time leader of the Italian Communist Party. A vocal critic of [[Benito Mussolini]] and fascism, he was imprisoned in 1926, and remained in prison until shortly before his death in 1937.",
		sections = {
			{
				"Overview",
				"During his imprisonment, Gramsci wrote more than 30 notebooks and 3,000 pages of history and analysis. His Prison Notebooks are considered a highly original contribution to 20th-century [[Political philosophy|political theory]]. Gramsci drew insights from varying sources—not only other Marxists but also thinkers such as [[Niccolò Machiavelli]], [[Vilfredo Pareto]], [[Charles Darwin]], [[Sigmund Freud]], [[Friedrich Nietzsche]], Georg Hegel, [[Pierre-Joseph Proudhon|Pierre Joseph Proudhon]], Georges Sorel, and Benedetto Croce. The notebooks cover a wide range of topics, including the [[History of Italy|history of Italy]] and Italian nationalism, the [[French Revolution]], fascism, Taylorism and Fordism, [[Civil society|civil society]], the [[State (polity)|state]], historical materialism, [[Folklore|folklore]], religion, and [[High culture|high]] and [[Popular culture|popular culture]].",
			},
		},
