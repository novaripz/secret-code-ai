			{ "Citizenship", "Austria Ireland (nat. 1948)" },
			{ "Education", "[[University of Vienna]] (grad. 1910, 1914)" },
			{ "Fields", "[[Physics]]" },
			{ "Teacher", "Friedrich Hasenöhrl" },
		},
	},
