	{
		title = "Sahel",
		category = "Geography",
		fame = 1,
		emoji = "🏔️",
		source = "wikipedia",
		description = "Biogeographical region in Africa",
		tags = { "Land relief", "Africa" },
		aliases = { "Sahel region", "Sahelian acacia savanna" },
		summary = "The **Sahel region**, or **Sahelian acacia savanna**, is a biogeographical region in Africa. It is the transition zone between the more humid Sudanian savannas to its south and the drier [[Sahara]] to the north. The Sahel has a [[Semi-arid climate|hot semi-arid climate]] and stretches across the southernmost latitudes of [[North Africa]] between the Atlantic Ocean and the [[Red Sea]]. Although geographically located in the [[Tropics|tropics]], the Sahel does not have a [[Tropical climate|tropical climate]].",
		sections = {
			{
				"Overview",
				"The Sahel has one of the world's fastest-growing populations due to its high human birthrate, with approximately 80 million people in 2018. The western Sahel in particular has experienced frequent food and water shortages due to droughts caused by its [[Semi-arid climate|semi-arid climate]], as well as high levels of [[Corruption Perceptions Index|government corruption]]. As a result, the Sahel is viewed as both an ecoregion and a geopolitical space shaped by internal instability and external strategic competition.",
			},
