	{
		title = "Kādambarī",
		category = "Book",
		fame = 3,
		emoji = "📖",
		source = "wikipedia",
		description = "7th century Sanskrit literature. novel by Banabhatta",
		tags = { "Specific works of fiction", "Fiction of antiquity" },
		summary = "**Kādambarī** is a romantic novel in [[Sanskrit]]. It was substantially composed by Bāṇabhaṭṭa in the first half of the 7th century CE, who did not survive to see it through completion. The novel was completed by Banabhatta's son Bhushanabhatta, according to the plan laid out by his late father. It is conventionally divided into Purvabhaga (earlier part) written by Banabhatta, and Uttarabhaga (latter part) by Bhushanabhatta. (An alternate tradition gives the son's name as Pulindabhatta.)",
		sections = {
			{
				"Overview",
				"The standard editions of the original Sanskrit text are by Peterson and Kane. There are translations into English by Kale, Layne and Ridding; and an abridgement into [[Gujarati language|Gujarati]] by Bhalan (edited by Keshavlal Dhruv). This novel has an extremely intricate plot which is difficult to summarize concisely. Its central thread is that of a romantic attachment (and eventual union) between the hero Chandrapeeda and the heroine Kadambari. However, there are several competing subplots; indeed, the heroine does not make her appearance until past the midpoint. Many of the characters appear in multiple incarnations, some as humans and some as demigods or animals. The narration proceeds in a succession of nested frames; a large part of it is a retelling by a parrot of a story which was told to it by a sage.",
			},
		},
		related = { "Candide", "Gulliver's Travels" },
	},
	{
		title = "La Princesse de Clèves",
		category = "Book",
		fame = 3,
		emoji = "📖",
		source = "wikipedia",
		description = "1678 novel attributed to Madame de La Fayette",
		tags = { "Specific works of fiction", "Fiction of early printed book era" },
		summary = "**La Princesse de Clèves** is a French [[Book|novel]] which was published anonymously in March 1678. It was regarded by many as the beginning of the modern tradition of the psychological novel and a classic work. Its author is generally held to be Madame de La Fayette.",
		sections = {
			{
				"Overview",
				"The action takes place between October 1558 and November 1559 primarily at the royal court of Henry II of France, as well as in a few other locations in France. The novel recreates that era with remarkable precision. Nearly every character—though not the heroine—is a historical figure. Events and intrigues unfold with great faithfulness to the documentary record, and the novel is generally regarded as one of the first examples of Western [[Historical fiction|historical fiction]].",
			},
		},
		related = { "Candide", "Gulliver's Travels" },
