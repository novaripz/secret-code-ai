		tags = { "Biology", "Modern" },
		aliases = { "Sir Joseph Dalton Hooker" },
		summary = "**Sir Joseph Dalton Hooker** (30 June 1817 – 10 December 1911) was an English botanist and explorer in the 19th century. He was a founder of geographical botany and [[Charles Darwin]]'s closest friend. For 20 years he served as director of the Royal Botanical Gardens, Kew, succeeding his father, William Jackson Hooker, and was awarded the highest honours of British science.",
