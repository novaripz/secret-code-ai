			{ "Education", "Bainbridge's Commercial Academy" },
			{ "Era", "[[19th-century philosophy]]" },
			{ "Region", "[[Western philosophy]]" },
			{
				"Main interests",
				"[[Mathematics]], [[Logic|logic]], [[Philosophy of mathematics|philosophy of mathematics]]",
			},
		},
	},
	{
		title = "George Eastman",
		category = "Person",
		fame = 3,
		emoji = "👤",
		source = "wikipedia",
		description = "American entrepreneur, inventor, and photographer (1854–1932)",
		tags = { "Inventors and engineers", "Modern" },
		summary = "**George Eastman ** (July 12, 1854 – March 14, 1932) was an American innovator and entrepreneur who founded the Eastman Kodak Company and helped to bring the photographic use of roll film into the mainstream. After a decade of experiments in photography, he patented and sold a roll film camera, making amateur photography accessible to the general public for the first time. Working as the treasurer and later president of Kodak, he oversaw the expansion of the company and the film industry.",
		sections = {
			{
				"Overview",
				'Eastman was a major philanthropist, establishing the Eastman School of Music, Rochester Philharmonic Orchestra, and schools of dentistry and medicine at the University of Rochester and Eastman Dental Hospital at [[University College London]], and making large contributions to the Rochester Institute of Technology (RIT), the construction of several buildings at the second campus of [[Massachusetts Institute of Technology]] (MIT) on the Charles River, and Tuskegee University and Hampton University, two historically black universities in [[Southern United States|the South]]. With interests in improving health, he provided funds for clinics in [[London]] and other European cities to serve low-income residents. In his final two years, Eastman was in intense pain caused by a disorder affecting his spine. On March 14, 1932, he shot himself in the heart, leaving a note which read, "To my friends: my work is done. Why wait?"',
			},
		},
		related = { "John Bardeen", "Charles Algernon Parsons" },
		infobox = {
			{ "Born", "12 July 1854" },
			{ "Birthplace", "Waterville, New York, U.S." },
			{ "Died", "14 March 1932" },
			{ "Occupation", "Businessman, inventor, philanthropist" },
			{ "Known for", "Photography pioneer, Founder of Eastman Kodak" },
		},
	},
	{
		title = "George Eliot",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English novelist and poet (1819–1880)",
		tags = { "Western Europe", "UK and Ireland" },
		aliases = { "Mary Ann Evans", "Mary Anne", "Marian" },
		summary = "**Mary Ann Evans** (22 November 1819 – 22 December 1880; alternatively **Mary Anne** or **Marian**), known by her pen name **George Eliot**, was an English novelist, poet, journalist, translator, and one of the leading writers of the [[Victorian era]]. She wrote seven novels: Adam Bede (1859), The Mill on the Floss (1860), Silas Marner (1861), Romola (1862–1863), Felix Holt, the Radical (1866), [[Middlemarch]] (1871–1872) and Daniel Deronda (1876). Her novels are known for their [[Literary realism|realism]], psychological insight, sense of place, and detailed depiction of the countryside.",
		sections = {
			{
				"Overview",
				'Middlemarch was described by the novelist [[Virginia Woolf]] as "one of the few English novels written for grown-up people" and by Martin Amis and Julian Barnes as the greatest novel in the English language. Scandalously and unconventionally for the era, she lived with the married George Henry Lewes as his conjugal partner, from 1854 to 1878, and called him her husband. He remained married to his wife, Agnes Jervis, and supported their children, even after Jervis left him to live with another man and have children with him. In May 1880, 18 months after Lewes\'s death, Eliot married her longtime friend John Cross, a man much younger than she, and changed her name to **Mary Ann Cross**.',
			},
		},
		related = { "Kazuo Ishiguro" },
		infobox = {
			{ "Born", "22 November 1819" },
			{ "Birthplace", "Nuneaton, Warwickshire, England" },
			{ "Died", "22 December 1880" },
			{ "Occupation", "Novelist, poet, journalist, translator" },
			{ "Notable works", "[[Middlemarch]] (1871–1872)" },
		},
	},
	{
		title = "George III",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "King of Great Britain and Ireland from 1760 to 1820",
		tags = { "Western Europe", "Great Britain and United Kingdom" },
		summary = "**George III** (George William Frederick; 4 June 1738 – 29 January 1820) was King of Great Britain and Ireland from 25 October 1760 until his death in 1820. During his reign, the Acts of Union 1800 merged [[Kingdom of Great Britain|Great Britain]] and [[Kingdom of Ireland|Ireland]] into the [[United Kingdom of Great Britain and Ireland|United Kingdom]]. He was concurrently duke and prince-elector of Hanover in the [[Holy Roman Empire]] before becoming King of Hanover on 12 October 1814. He was the first monarch of the House of Hanover who was born in Great Britain, spoke English as his first language, and never visited Hanover.",
		sections = {
			{
				"Overview",
				"George was born during the reign of his paternal grandfather, King George II, as the first son of Frederick, Prince of Wales, and Princess Augusta of Saxe-Gotha. Following his father's death in 1751, Prince George became heir apparent and Prince of Wales. He succeeded to the throne on George II's death in 1760. The following year, he married Princess Charlotte of Mecklenburg-Strelitz, with whom he had 15 children. George III's life and reign were marked by a series of military conflicts involving his kingdoms, much of the rest of Europe, and places farther afield in Africa, the Americas and Asia. Early in his reign, Great Britain defeated [[Kingdom of France|France]] in the Seven Years' War, becoming the dominant European power in North America and India. However, Britain lost [[Thirteen Colonies|13 of its North American colonies]] in the [[American Revolution|American War of Independence]].",
			},
		},
		related = { "Henry VIII", "William Pitt the Younger" },
		infobox = {
			{ "Birthplace", "Norfolk House, London, England" },
			{ "Died", "29 January 1820" },
		},
	},
	{
		title = "George Lucas",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American filmmaker and entrepreneur (born 1944)",
		tags = { "Directors", "US and Canada" },
		aliases = { "George Walton Lucas Jr." },
		summary = "**George Walton Lucas Jr.** is an American filmmaker, philanthropist, and entrepreneur. He created the [[Star Wars]] franchise and its fictional universe, the Indiana Jones franchise, and founded Lucasfilm, LucasArts, Industrial Light & Magic, and THX. Lucas also served as chairman of Lucasfilm before selling it to [[The Walt Disney Company]] in 2012. The recipient of two Emmy Awards and nominations for four [[Academy Awards]] and two Golden Globe Awards, he is considered to be one of the most significant figures of the 20th-century [[New Hollywood]] movement, and a pioneer of the modern [[Blockbuster (entertainment)|blockbuster]]. Despite this, he has remained an independent filmmaker for most of his career.",
		sections = {
			{
				"Overview",
				"After graduating from the University of Southern California in 1967, Lucas moved to San Francisco and co-founded American Zoetrope with filmmaker [[Francis Ford Coppola]]. He wrote and directed THX 1138 (1971), based on his student short Electronic Labyrinth: THX 1138 4EB, which was a critical success but a financial failure. His next work as a writer-director was American Graffiti (1973), inspired by his youth in early 1960s Modesto, California, and produced through the newly founded Lucasfilm. The film was critically and commercially successful and received five Academy Award nominations, including Best Director and Best Picture. Lucas's next film, the [[Epic film|epic]] space opera Star Wars (1977), later retitled A New Hope, had a troubled production but was a surprise hit, becoming the highest-grossing film at the time, winning six Academy Awards and sparking a cultural phenomenon.",
			},
		},
		related = { "Andrei Tarkovsky", "Cecil B. DeMille", "James Cameron", "Werner Herzog" },
		infobox = {
			{ "Born", "14 May 1944" },
			{ "Birthplace", "Modesto, California, U.S." },
			{ "Occupation", "Film director, screenwriter, producer, philanthropist, entrepreneur" },
			{ "Years active", "1965–present" },
			{ "Education", "Modesto Junior College, University of Southern California (BFA)" },
		},
	},
	{
		title = "George Orwell",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English author and journalist (1903–1950)",
		tags = { "Western Europe", "UK and Ireland" },
		aliases = { "Eric Arthur Blair" },
		summary = "**Eric Arthur Blair** (25 June 1903 – 21 January 1950) was an English novelist, poet, essayist, journalist, and critic who wrote under the [[Pen name|pen name]] of **George Orwell**. His work is characterised by lucid [[Prose|prose]], [[Social criticism|social criticism]], opposition to all [[Totalitarianism|totalitarianism]] (both authoritarian communism and fascism), and support of democratic socialism.",
		sections = {
			{
				"Overview",
				"Orwell is best known for his allegorical novella Animal Farm (1945) and the dystopian novel [[Nineteen Eighty-Four]] (1949), although his works also encompass [[Literary criticism|literary criticism]], poetry, fiction and [[Polemic|polemical]] journalism. His non-fiction works, including The Road to Wigan Pier (1937), documenting his experience of working-class life in industrial [[Northern England]], and Homage to Catalonia (1938), an account of his experiences soldiering for the Republican faction of the Spanish Civil War (1936–1939), are as critically respected as his essays on politics, literature, [[Language|language]] and culture.",
			},
		},
		related = { "William Golding" },
		infobox = {
			{ "Born", "25 June 1903" },
			{ "Birthplace", "Motihari, Bengal Presidency, India (modern-day [[Bihar]])" },
			{ "Died", "21 January 1950" },
