			{ "Occupation", "Writer, poet, visual artist, philosopher" },
			{ "Known for", "Leading author of the Modern Arabic literature" },
			{ "Style", "[[Artistic symbol|Symbolic]], [[Prose poetry|prose poetry]]" },
