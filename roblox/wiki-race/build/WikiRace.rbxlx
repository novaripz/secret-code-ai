		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Genus of plants",
		tags = { "Eudicots", "Lamiales" },
		aliases = { "Lavender" },
		summary = "**Lavandula** (common name **lavender**) is a [[Genus|genus]] of 47 known species of [[Perennial|perennial]] [[Flowering plant|flowering plants]] in the sage family, [[Lamiaceae]]. It is [[Native species|native]] to regions of the [[Iberian Peninsula]] and [[Mediterranean Sea|Mediterranean coastline]] (including the [[Adriatic Sea|Adriatic coast]] and coastal [[North Africa]]), the [[Middle East]], extending to the [[Indian subcontinent]].",
		sections = {
			{
				"Overview",
				"Many members of the genus are cultivated extensively in [[Temperate climate|temperate climates]] as [[Ornamental plant|ornamental plants]] for garden and landscape use, for use as culinary herbs, and commercially for the extraction of [[Essential oil|essential oils]]. Lavender is used in [[Traditional medicine|traditional medicine]] and as an ingredient in cosmetics.",
			},
		},
		related = { "Olive", "Oleaceae" },
		infobox = {
			{ "Scientific name", "Lavandula" },
