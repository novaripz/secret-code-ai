            <string name="Source"><![CDATA[-- Imported from English Wikipedia lead sections (CC BY-SA 4.0), filtered for Wiki Race.
-- Generated by tools/wiki/build_pages.py — edit the generator, not this file.
return {
	{
		title = "Plain",
		category = "Science",
		fame = 1,
		emoji = "🌾",
		source = "wikipedia",
		description = "Expanse of land that is mostly flat",
		tags = { "Geomorphology", "Landforms" },
		aliases = { "Flatland" },
		summary = "In [[Geography|geography]], a **plain**, commonly known as **flatland**, is a flat expanse of land that generally has few rapid or steep changes in [[Elevation|elevation]]. Natural vegetation in plains can include [[Prairie|prairies]]/[[Grassland|grasslands]], [[Forest|forests]], savanah, [[Tundra|tundra]], and [[Desert|desert]] biomes, among others. Plains occur as lowlands along [[Valley|valleys]] or at the base of [[Mountain|mountains]], as coastal plains, and as [[Plateau|plateaus]] or [[Highland|uplands]]. Plains are one of the major [[Landform|landforms]] on earth, being present on all continents and covering more than one-third of the world's land area. Plains in many areas are important for [[Agriculture|agriculture]]. There are various types of plains, and [[Biome|biomes]] on them.",
	},
	{
		title = "Planck units",
		category = "Science",
		fame = 3,
		emoji = "🔬",
		source = "wikipedia",
		description = "Units defined only by physical constants",
		tags = { "Measurement" },
		summary = "In [[Particle physics|particle physics]] and [[Physical cosmology|physical cosmology]], **Planck units** are a system of units of measurement defined exclusively in terms of four universal [[Physical constant|physical constants]]: [[Speed of light|c]], G, [[Planck constant|ħ]], and kB. Expressing one of these physical constants in terms of Planck units yields a numerical value of 1. They are a system of [[Natural units|natural units]], defined using fundamental properties of [[Nature|nature]] (specifically, properties of [[Vacuum|free space]]) rather than properties of a chosen prototype object. Originally proposed in 1899 by German physicist [[Max Planck]], they are relevant in research on unified theories such as [[Quantum gravity|quantum gravity]].",
		sections = {
			{
				"Overview",
				"The term **Planck scale** refers to quantities of space, time, energy and other units that are similar in magnitude to corresponding Planck units. This region may be characterized by particle [[Energy|energies]] of around ×10^19 GeV or ×10^9 J, [[Time|time]] intervals of around ×10^−43 s and [[Length|lengths]] of around ×10^-35 m (approximately the energy-equivalent of the Planck mass, the Planck time and the Planck length, respectively). At the Planck scale, the predictions of the [[Standard Model]], [[Quantum field theory|quantum field theory]] and [[Theory of relativity|general relativity]] are not expected to apply, and [[Quantum gravity|quantum effects of gravity]] are expected to dominate. One example is represented by the conditions in the [[Chronology of the universe|first 10−43 seconds]] of our universe after the [[Big Bang]], approximately 13.8 billion years ago. The four universal constants that, by definition, have a numerical value 1 when expressed in these units are:",
			},
		},
	},
	{
		title = "Plankton",
		category = "Science",
		fame = 1,
		emoji = "💧",
		source = "wikipedia",
		description = "Organisms living in water or air that drift in the current or wind",
		tags = { "Organisms" },
		summary = "**Plankton** are [[Organism|organisms]] that drift in [[Hydrosphere|water]] (or [[Atmosphere|air]]) but are unable to actively propel themselves against [[Ocean current|currents]] (or [[Wind|wind]]). Marine plankton include drifting organisms that inhabit the saltwater of [[Ocean|oceans]] and the [[Brackish water|brackish]] waters of estuaries. [[Fresh water|Freshwater]] plankton are similar to marine plankton, but are found in lakes and rivers. An individual plankton organism in the plankton is called a **plankter**.",
		sections = {
			{
				"Overview",
				"Plankton includes organisms from species across all the major biological kingdoms, ranging in size from the [[Microscopic scale|microscopic]] (such as [[Bacteria|bacteria]], [[Archaea|archaea]], [[Protozoa|protozoa]] and microscopic [[Algae|algae]] and [[Mushroom|fungi]]) to larger organisms (such as jellyfish and ctenophores). This is because plankton are defined by their [[Ecological niche|ecological niche]] and level of motility rather than by any [[Phylogenetics|phylogenetic]] or [[Taxonomy (biology)|taxonomic]] classification. The plankton category differentiates organisms from those that can swim against a current, called nekton, and those that live on the deep sea floor, called benthos. Organisms that float on or near the water's surface are called neuston. Neuston that drift as water currents or wind take them, and lack the swimming ability to counter this, form a special subgroup of plankton.",
			},
		},
	},
	{
		title = "Plant hormone",
		category = "Science",
		fame = 3,
		emoji = "🌱",
		source = "wikipedia",
		description = "Chemical compounds that regulate plant growth and development",
		tags = { "Biochemistry and molecular biology" },
		aliases = { "Plant hormones", "Phytohormones" },
		summary = '**Plant hormones** (or **phytohormones**) are signal molecules, produced within [[Plant|plants]], that occur in extremely low [[Concentration|concentrations]]. Plant hormones control all aspects of plant growth and development, including embryogenesis, the regulation of [[Organ (biology)|organ]] size, pathogen defense, stress tolerance and [[Reproduction|reproductive]] development. Unlike in [[Animal|animals]] (in which hormone production is restricted to specialized glands) each plant cell is capable of producing hormones. Went and Thimann coined the term "phytohormone" and used it in the title of their 1937 book.',
		sections = {
			{
				"Overview",
				'Phytohormones occur across the [[Plant|plantkingdom]], and even in [[Algae|algae]], where they have similar functions to those seen in [[Vascular plant|vascular plants ("higher plants")]]. Some phytohormones also occur in [[Microorganism|microorganisms]], such as unicellular [[Mushroom|fungi]] and [[Bacteria|bacteria]], however in these cases they do not play a hormonal role and can better be regarded as secondary metabolites.',
			},
		},
