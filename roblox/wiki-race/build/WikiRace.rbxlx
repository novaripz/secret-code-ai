		tags = { "Dimensional space", "Length and distance" },
		summary = "The **astronomical unit** (symbol: **au** or **AU**) is a [[Unit of length|unit of length]] defined as 149597870700 metres. Historically, the astronomical unit was conceived as the average Earth-Sun distance (the average of Earth's aphelion and perihelion), before its modern redefinition in 2012.",
		sections = {
