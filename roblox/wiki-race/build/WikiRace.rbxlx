	{
		title = "Guilt (emotion)",
		category = "Concept",
		fame = 3,
		emoji = "😊",
		source = "wikipedia",
		description = "Cognitive or an emotional experience",
		tags = { "Psychology", "Emotions and traits" },
		aliases = { "Guilt" },
		summary = "**Guilt** is a moral emotion that occurs when a person [[Belief|believes]] or realizes—accurately or not—that they have compromised their own standards of conduct or have violated universal [[Morality|moral]] standards and bear significant responsibility for that violation. Feeling guilty is unpleasant for people while they experience it, but it can prompt positive, pro-social efforts to restore relationships and make amends.",
		sections = {
			{
				"Overview",
				"Guilt is closely related to the concepts of remorse, regret, and [[Shame|shame]]. Guilt is an important factor in perpetuating obsessive–compulsive disorder symptoms.",
