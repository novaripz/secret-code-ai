	{
		title = "Alfredo Di Stéfano",
		category = "Athlete",
		fame = 3,
		emoji = "🏅",
		source = "wikipedia",
		description = "Argentine footballer (1926–2014)",
		tags = { "Team sports", "Association football" },
		aliases = { "Alfredo Stéfano Di Stéfano Laulhé" },
		summary = '**Alfredo Stéfano Di Stéfano Laulhé** (4 July 1926 – 7 July 2014) was an Argentine and Spanish professional [[Association football|footballer]] and manager who played as a forward. Nicknamed "**Saeta Rubia**" ("The Blond Arrow"), he played in all five of Madrid\'s [[UEFA Champions League|European Cup]] victories during the 1950s and 1960s. He played international football for Argentina and Colombia before becoming a naturalised citizen of Spain and playing for its national team. He is widely regarded as one of the greatest footballers of all time and the greatest Real Madrid player ever.',
		sections = {
			{
				"Overview",
				"Di Stéfano began his club career at age 17 with Argentina's River Plate in 1943. Due to a footballers' strike in Argentina in 1949, he transferred to Millonarios of [[Bogotá]] in the Colombian league until 1953, when he left for Real Madrid. He scored a total of 216 league goals for Real Madrid, a club record at the time. In 1964, Di Stefano signed with Espanyol and played for them for the remainder of his career until retiring at the age of 40 in 1966. At the international level, Di Stéfano helped Argentina win the [[Copa América]] in 1947. However, although having played for three different national teams, he never played a single match at the [[FIFA World Cup]] during his career. His 49 goals in the [[UEFA Champions League|European Cup]] was the highest of any player at the time. He was awarded the [[Ballon d'Or]] in 1957 and 1959.",
			},
		},
		related = { "Jackie Robinson", "Kareem Abdul-Jabbar" },
