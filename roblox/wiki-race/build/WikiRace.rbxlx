	{
		title = "Satyendra Nath Bose",
		category = "Person",
		fame = 1,
		emoji = "👤",
		source = "wikipedia",
		description = "Indian theoretical physicist (1894–1974)",
		tags = { "Physics", "Modern" },
		summary = "**Satyendra Nath Bose** was an Indian theoretical physicist and [[Mathematician|mathematician]]. He is best known for his work on [[Quantum mechanics|quantum mechanics]] in the early 1920s, in developing the foundation for [[Bose–Einstein statistics]], and the theory of the [[Bose–Einstein condensate]]. A [[Royal Society|Fellow]] of the [[Royal Society]], he was awarded India's second highest civilian award, the [[Padma Vibhushan]], in 1954 by the [[Government of India]].",
		sections = {
			{
				"Overview",
				"The eponymous particles class described by Bose's statistics, [[Boson|bosons]], were named by [[Paul Dirac]]. A [[Polymath|polymath]], he had a wide range of interests in varied fields, including [[Physics|physics]], [[Mathematics|mathematics]], [[Chemistry|chemistry]], [[Biology|biology]], [[Mineralogy|mineralogy]], [[Philosophy|philosophy]], [[The arts|arts]], [[Literature|literature]], and [[Music|music]]. He served on many research and development committees in [[Indian independence movement|India after independence]].",
			},
		},
