	{
		title = "Web browser",
		category = "Technology",
		fame = 1,
		emoji = "🌐",
		source = "wikipedia",
		description = "Software used to access websites",
		tags = { "Computing and information technology", "Computer software" },
		aliases = { "Browser" },
		summary = "A **web browser**, often abbreviated as **browser**, is an application for accessing [[Website|websites]]. When a user requests a [[Web page|web page]] from a particular website, the browser retrieves its [[Computer file|files]] from a [[Web server|web server]] and then displays the page on the user's screen. Browsers can also display content stored locally on the user's device.",
		sections = {
			{
				"Overview",
				"Browsers are used on a range of devices, including desktops, [[Laptop|laptops]], [[Tablet computer|tablets]], [[Smartphone|smartphones]], smartwatches, smart televisions and [[Video game console|consoles]]. As of 2026, the most used browsers worldwide are Google Chrome (~69% market share), Safari (~16%), Edge (~5%), Firefox (~2%), Samsung Browser (~2%), and Opera (~2%). As of 2023, an estimated 5.4 billion people had used a browser.",
			},
