          <string name="Source"><![CDATA[-- Everyday concepts, celebrations, internet culture and organizations.
return {
	{
		title = "Time",
		category = "Concept",
		fame = 1,
		emoji = "⏳",
		tags = { "Physics", "Philosophy" },
		summary = "**Time** is the ongoing sequence of events from past to future. It is measured with a [[Clock|clock]] and organized with a [[Calendar|calendar]].",
		sections = {
			{
				"Physics",
				"According to the [[Theory of relativity|theory of relativity]], time passes more slowly near strong [[Gravity|gravity]].",
			},
		},
		infobox = { { "Unit", "Second" }, { "Measured by", "[[Clock]]" } },
	},
	{
		title = "Language",
		category = "Concept",
		fame = 1,
		emoji = "🗣️",
		tags = { "Linguistics" },
		aliases = { "Languages" },
		summary = "**Language** is a system of words and grammar that people use to communicate. About 7,000 languages are spoken today.",
		sections = {
			{
				"Most spoken",
				"The most widely spoken language is [[English language|English]], followed by Mandarin Chinese. Writing systems range from the [[Alphabet|alphabet]] to [[Hieroglyphs|hieroglyphs]].",
			},
		},
		infobox = { { "Languages spoken", "~7,000" }, { "Written with", "[[Alphabet]]" } },
	},
	{
		title = "English language",
