	{
		title = "Thebes, Greece",
		category = "City",
		fame = 2,
		emoji = "🏙️",
		source = "wikipedia",
		description = "City in Boeotia, Greece",
		tags = { "More articles" },
		summary = "**Thebes** is a city in Boeotia, Central Greece, and one of the oldest continuously inhabited cities in the world. It is the largest city in Boeotia and a major center for the region.",
		sections = {
			{
				"Overview",
				"Ancient Thebes was the largest and leading [[Polis|polis]] of the Boeotian League. It sided with the [[Achaemenid Empire|Persians]] during the 480 BC invasion under Xerxes I. Theban forces under the command of Epaminondas defeated Spartans at the Battle of Leuctra in 371 BC, giving rise to a short-lived Theban hegemony. In 338 BC, [[Macedonia (ancient kingdom)|Macedon]] defeated an alliance of Thebes and Athens at the Battle of Chaeronea, and later Thebes was destroyed by [[Alexander the Great]] in 335 BC. During the [[Byzantine Empire|Byzantine]] period, the city was famous for its silks. The modern city contains an archaeological museum, the remains of the Cadmea (Bronze Age and forward citadel), and scattered ancient remains. The Holy Church of Luke the Evangelist is also in Thebes and contains Luke's tomb and relics.",
			},
		},
		related = { "The Right Honourable" },
		infobox = {
			{ "Type", "municipality" },
			{ "People are called", "Theban" },
		},
	},
	{
		title = "Thiruvananthapuram",
		category = "City",
		fame = 3,
		emoji = "🏙️",
		source = "wikipedia",
		description = "Metropolis and capital of Kerala, India",
		tags = { "Southern Asia", "India" },
		aliases = { "Trivandrum" },
		summary = "**Thiruvananthapuram**, also known as **Trivandrum**, is the [[Capital city|capital]] city of the Indian state of [[Kerala]]. As of 2011, the Thiruvananthapuram Municipal Corporation had a population of 957,730 over an area of 214.86 km2, making it the most populous city in Kerala. The larger Thiruvananthapuram metropolitan area has over 1.7 million inhabitants within an area of 543 km2, making it the second-most populous [[Metropolitan area|metropolitan area]] in Kerala after Kochi. Thiruvananthapuram is one of the few cities in India that serves as a state capital and is also centre for heritage, maritime activities, information technology, research and development, space research, defence, automotive technology, and biosciences.",
		sections = {
			{
				"Overview",
				"It is also among the few cities in the world where both an international airport and an international seaport are located within the city in close proximity to the city center. Located on the west coast of India near the extreme south of the mainland, Thiruvananthapuram is a port city located 10 nmi from a heavily trafficked east–west shipping channel. The city is home to India's first deep-water trans-shipment port, the Vizhinjam International Seaport Thiruvananthapuram. The city is characterised by its undulating terrain of low coastal hills. Thiruvananthapuram is also known for its cultural heritage, being associated with the musical contributions of Swathi Thirunal Rama Varma and the artistic legacy of painter Raja Ravi Varma.",
			},
		},
		infobox = {
			{ "Founder", "Marthanda Varma" },
			{ "Government", "Municipal [[Corporation]]" },
			{ "Area", "214 km²" },
			{ "Elevation", "38.93 m" },
			{ "Population", "957,730" },
		},
