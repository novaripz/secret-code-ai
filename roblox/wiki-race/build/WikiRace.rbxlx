		emoji = "🟰",
		source = "wikipedia",
		description = "Differential equation for the description of waves or standing wave",
		tags = { "Physics", "Waves" },
		summary = "The **wave equation** is a second-order linear [[Partial differential equation|partial differential equation]] for the description of [[Wave|waves]] or [[Standing wave|standing wave]] fields such as mechanical waves (e.g. [[Water|water]] waves, sound waves and seismic waves) or [[Electromagnetic radiation|electromagnetic waves]] (including [[Light|light]] waves). It arises in fields like [[Acoustics|acoustics]], [[Electromagnetism|electromagnetism]], and [[Fluid dynamics|fluid dynamics]].",
		sections = {
			{
				"Overview",
				"This article focuses on waves in [[Classical physics|classical physics]]. Quantum physics uses an operator-based [[Schrödinger equation|wave equation]] often as a relativistic wave equation.",
			},
