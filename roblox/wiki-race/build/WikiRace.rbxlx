			{ "Capital", "Đông Kinh (1428–1527 and 1592–1789) Tây Kinh (temp) (1543–1592)" },
			{ "Official languages", "Literary Chinese (written)" },
			{ "Currency", "Copper-alloy and zinc cash coins" },
