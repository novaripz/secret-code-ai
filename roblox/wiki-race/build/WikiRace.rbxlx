		tags = { "Law", "Basics" },
		summary = 'An **injunction** is an equitable remedy in the form of a special court order compelling a party to do or refrain from doing certain acts. It was developed by the English courts of equity but its origins go back to [[Roman law]] and the equitable remedy of the "interdict".',
		sections = {
			{
