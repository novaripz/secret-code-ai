      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Nature</string>
          <string name="Source"><![CDATA[-- Animals and plants.
return {
	{
		title = "Animal",
		category = "Animal",
		fame = 1,
		emoji = "🐾",
		tags = { "Biology", "Zoology" },
		aliases = { "Animals", "Fauna" },
		summary = "An **animal** is a living thing that eats other organisms, can usually move, and is made of many [[Cell (biology)|cells]]. Animals are studied in [[Biology|biology]].",
		sections = {
			{
				"Groups",
				"Major groups include [[Mammal|mammals]], [[Bird|birds]], [[Fish|fish]], [[Reptile|reptiles]] and [[Insect|insects]].",
			},
			{ "Numbers", "Scientists have described about 1.5 million animal species, most of them insects." },
		},
		infobox = { { "Kingdom", "Animalia" }, { "Oldest groups", "Sponges, [[Jellyfish|jellyfish]]" } },
		related = { "Plant" },
	},
	{
		title = "Mammal",
		category = "Animal",
		fame = 2,
		emoji = "🐘",
		tags = { "Animal groups" },
		aliases = { "Mammals" },
		summary = "A **mammal** is a warm-blooded [[Animal|animal]] with hair that feeds its young on milk. [[Human|Humans]], [[Dog|dogs]] and [[Blue whale|whales]] are mammals.",
		sections = {
			{
				"Oddities",
				"The [[Platypus|platypus]] is a mammal that lays eggs, and bats are the only mammals that truly fly.",
			},
		},
		infobox = { { "Species", "~6,400" }, { "Largest", "[[Blue whale]]" } },
		related = { "Polar bear" },
	},
	{
		title = "Bird",
		category = "Animal",
		fame = 2,
