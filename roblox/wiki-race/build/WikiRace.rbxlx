]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Everyday</string>
          <string name="Source"><![CDATA[-- Everyday concepts, celebrations, internet culture and organizations.
return {
	{
		title = "Time",
		category = "Concept",
		fame = 1,
		emoji = "⏳",
		tags = { "Physics", "Philosophy" },
		summary = "**Time** is the ongoing sequence of events from past to future. It is measured with a [[Clock|clock]] and organized with a [[Calendar|calendar]].",
		sections = {
			{
				"Physics",
				"According to the [[Theory of relativity|theory of relativity]], time passes more slowly near strong [[Gravity|gravity]].",
			},
		},
		infobox = { { "Unit", "Second" }, { "Measured by", "[[Clock]]" } },
	},
	{
		title = "Language",
		category = "Concept",
		fame = 1,
		emoji = "🗣️",
		tags = { "Linguistics" },
		aliases = { "Languages" },
		summary = "**Language** is a system of words and grammar that people use to communicate. About 7,000 languages are spoken today.",
		sections = {
			{
				"Most spoken",
				"The most widely spoken language is [[English language|English]], followed by Mandarin Chinese. Writing systems range from the [[Alphabet|alphabet]] to [[Hieroglyphs|hieroglyphs]].",
			},
		},
		infobox = { { "Languages spoken", "~7,000" }, { "Written with", "[[Alphabet]]" } },
	},
	{
		title = "English language",
		category = "Concept",
		fame = 2,
		emoji = "🔤",
		tags = { "Languages" },
		aliases = { "English" },
		summary = "**English** is a language that began in England, [[United Kingdom]], and is now spoken by about 1.5 billion people.",
		sections = {
			{
				"Words",
				"[[William Shakespeare]] invented or popularized hundreds of English words. Its alphabet has 26 letters.",
			},
		},
		infobox = { { "Speakers", "~1.5 billion" }, { "Script", "Latin [[Alphabet|alphabet]]" } },
	},
	{
		title = "Alphabet",
		category = "Concept",
		fame = 2,
		emoji = "🔤",
		tags = { "Writing systems" },
		aliases = { "Alphabets", "ABC" },
		summary = "An **alphabet** is a set of letters used to write a [[Language|language]]. The word comes from the first two Greek letters, alpha and beta.",
		sections = {
			{
				"History",
				"Most alphabets descend from the Phoenician script, possibly inspired by Egyptian [[Hieroglyphs|hieroglyphs]].",
			},
		},
		infobox = { { "English letters", "26" }, { "Name from", "Alpha + beta" } },
	},
	{
		title = "Sleep",
		category = "Concept",
		fame = 2,
		emoji = "😴",
		tags = { "Biology", "Health" },
		summary = "**Sleep** is a natural resting state in which the body and [[Brain|brain]] recover. Humans spend about a third of their lives asleep.",
		sections = {
			{
				"Animals",
				"[[Koala|Koalas]] sleep up to 20 hours a day; giraffes need only about two. During sleep, people [[Dream|dream]].",
			},
		},
		infobox = { { "Adults need", "7–9 hours" }, { "Related", "[[Dream]]" } },
	},
	{
		title = "Dream",
		category = "Concept",
		fame = 2,
		emoji = "💭",
		tags = { "Psychology" },
		aliases = { "Dreams", "Dreaming" },
		summary = "A **dream** is a series of images and stories the mind creates during [[Sleep|sleep]].",
		sections = { { "Art", "Surrealist painters such as [[Salvador Dalí]] tried to paint their dreams." } },
		infobox = { { "Happens during", "REM [[Sleep|sleep]]" }, { "Organ", "[[Brain]]" } },
	},
	{
		title = "Friendship",
		category = "Concept",
		fame = 2,
		emoji = "🤝",
		tags = { "Relationships" },
		aliases = { "Friend", "Friends" },
		summary = "**Friendship** is a relationship of mutual trust and affection between people. Studies show good friends help people live longer.",
		sections = {
			{
				"Online",
				"Many friendships now start on [[Social media|social media]] and in online [[Video game|games]].",
			},
		},
		infobox = { { "Holiday", "International Day of Friendship (30 July)" }, { "Related", "[[Social media]]" } },
	},
	{
		title = "Emoji",
		category = "Concept",
		fame = 1,
		emoji = "😀",
		tags = { "Internet culture", "Writing systems" },
		aliases = { "Emojis", "Emoticon" },
		summary = "An **emoji** is a small picture used in text messages, like 😂 or 🔥. Emoji began on Japanese mobile phones in 1999.",
		sections = {
			{
				"Popularity",
				"The 'face with tears of joy' 😂 was named word of the year in 2015. Some compare emoji to [[Hieroglyphs|hieroglyphs]].",
			},
		},
		infobox = { { "Origin", "[[Japan]], 1999" }, { "Count", "~3,700" } },
	},
	{
		title = "Internet meme",
		category = "Concept",
		fame = 2,
		emoji = "🐸",
		tags = { "Internet culture" },
		aliases = { "Meme", "Memes" },
		summary = "An **internet meme** is an idea, image or video that spreads rapidly online, often with humorous variations.",
		sections = {
			{
				"Examples",
				"Famous memes include [[Cat|cats]] with captions, 'sus' from [[Among Us]] and the Rickroll. The word 'meme' was coined by a biologist studying [[Evolution|evolution]].",
			},
		},
		infobox = { { "Word coined", "1976" }, { "Spreads via", "[[Social media]]" } },
	},
	{
		title = "Birthday",
		category = "Concept",
		fame = 2,
		emoji = "🎂",
		tags = { "Celebrations" },
		aliases = { "Birthdays" },
		summary = "A **birthday** is the anniversary of a person's birth, often celebrated with a [[Cake|cake]], candles and gifts.",
		sections = {
			{ "Math", "In a room of just 23 people, there is a 50% [[Probability|chance]] two share a birthday." },
		},
		infobox = {
			{ "Traditions", "[[Cake]], [[Candle|candles]], [[Balloon|balloons]]" },
			{ "Song", "'Happy Birthday to You'" },
		},
	},
	{
		title = "Christmas",
		category = "Event",
		fame = 1,
		emoji = "🎄",
		tags = { "Holidays" },
		aliases = { "Xmas" },
		summary = "**Christmas** is a holiday celebrated on 25 December, with decorated trees, gifts and Santa Claus.",
		sections = {
			{
				"Traditions",
				"[[Queen Victoria]] popularized Christmas trees in Britain; modern Santa's red coat was spread by [[Coca-Cola]] advertising.",
			},
		},
		infobox = { { "Date", "25 December" }, { "Symbol", "Christmas tree" } },
	},
	{
		title = "Halloween",
		category = "Event",
		fame = 1,
		emoji = "🎃",
		tags = { "Holidays" },
		summary = "**Halloween** is celebrated on 31 October with costumes, carved pumpkins and trick-or-treating.",
		sections = {
			{
				"Costumes",
				"Popular costumes include [[Vampire|vampires]], [[Werewolf|werewolves]] and [[Mummy|mummies]].",
			},
		},
		infobox = { { "Date", "31 October" }, { "Origin", "Celtic festival of Samhain" } },
	},
	{
		title = "Valentine's Day",
		category = "Event",
		fame = 2,
		emoji = "💝",
		tags = { "Holidays" },
		aliases = { "Valentines Day" },
		summary = "**Valentine's Day**, on 14 February, is a celebration of love, marked with cards, [[Rose|roses]] and [[Chocolate|chocolate]].",
		sections = { { "Symbol", "The ❤️ [[Heart|heart]] shape is its main symbol." } },
		infobox = { { "Date", "14 February" }, { "Gifts", "[[Rose|Roses]], [[Chocolate|chocolate]]" } },
	},
	{
		title = "New Year's Eve",
		category = "Event",
		fame = 2,
		emoji = "🎆",
		tags = { "Holidays" },
		aliases = { "New Year", "New Year's Day" },
		summary = "**New Year's Eve** on 31 December is celebrated at midnight with countdowns and [[Fireworks|fireworks]].",
		sections = { { "Famous parties", "Crowds gather in [[Times Square]] and around the [[Sydney Opera House]]." } },
		infobox = { { "Date", "31 December" }, { "Tradition", "[[Fireworks]]" } },
	},
	{
		title = "Fireworks",
		category = "Invention",
		fame = 2,
		emoji = "🎆",
		tags = { "Inventions", "Celebrations" },
		aliases = { "Firework" },
		summary = "**Fireworks** are explosive devices that burst into colorful light and sound. They were invented in [[China]] more than 1,000 years ago.",
		sections = {
			{
				"Chemistry",
				"Metal salts make the [[Color|colors]]: copper for blue, strontium for red. The first [[Rocket|rockets]] were fireworks.",
			},
		},
		infobox = { { "Origin", "[[China]]" }, { "Used on", "[[New Year's Eve]]" } },
	},
	{
		title = "Kite",
		category = "Object",
		fame = 3,
		emoji = "🪁",
		tags = { "Toys" },
		aliases = { "Kites" },
		summary = "A **kite** is a light frame covered with material, flown in the wind on a string. Kites were invented in [[China]] about 2,500 years ago.",
		sections = {
			{ "Science", "[[Benjamin Franklin]] used a kite in a thunderstorm to study [[Lightning|lightning]]." },
		},
		infobox = { { "Origin", "[[China]]" }, { "Needs", "Wind" } },
	},
	{
		title = "Pirate",
		category = "Concept",
		fame = 1,
		emoji = "🏴‍☠️",
		tags = { "Maritime history" },
		aliases = { "Pirates", "Piracy" },
		summary = "A **pirate** is a robber who attacks [[Ship|ships]] at sea. The golden age of piracy in the Caribbean lasted from about 1650 to 1730.",
		sections = {
			{
				"Myths",
				"Walking the plank and treasure [[Map|maps]] are mostly inventions of fiction. The anime [[One Piece]] follows a pirate crew, and a [[Parrot|parrot]] is the classic pirate pet.",
			},
		},
		infobox = { { "Flag", "Jolly Roger" }, { "Golden age", "1650–1730" } },
	},
	{
		title = "Clown",
		category = "Concept",
		fame = 2,
		emoji = "🤡",
		tags = { "Entertainment", "Circus" },
		aliases = { "Clowns" },
		summary = "A **clown** is a comic performer with face paint, a red nose and oversized shoes, traditionally part of the [[Circus|circus]].",
		sections = {
			{
				"Fear",
				"Some people have coulrophobia, a fear of clowns — fueled by villains like the [[Joker (character)|Joker]].",
			},
		},
		infobox = { { "Famous prop", "Red nose" }, { "Found at", "[[Circus]]" } },
	},
	{
		title = "Circus",
		category = "Event",
		fame = 3,
		emoji = "🎪",
		tags = { "Entertainment" },
		summary = "A **circus** is a traveling show with acrobats, [[Clown|clowns]], jugglers and sometimes trained animals, performed in a big tent.",
		sections = {
			{
				"History",
				"The modern circus was created in [[London]] in 1768. The word comes from the Roman chariot-racing arenas of the [[Roman Empire]].",
			},
		},
		infobox = { { "Founded", "1768, [[London]]" }, { "Performers", "[[Clown|Clowns]], acrobats" } },
	},
	{
		title = "Starbucks",
		category = "Company",
		fame = 2,
		emoji = "☕",
		tags = { "Coffee companies", "Companies of the United States" },
		summary = "**Starbucks** is an American chain of [[Coffee|coffee]] shops founded in Seattle in 1971, with more than 38,000 stores worldwide.",
		sections = {
			{ "Name", "It is named after a character in the novel Moby-Dick, a story about a [[Blue whale|whale]]." },
		},
		infobox = { { "Founded", "1971" }, { "Sells", "[[Coffee]]" } },
	},
	{
		title = "IKEA",
		category = "Company",
		fame = 2,
		emoji = "🪑",
		tags = { "Furniture companies" },
		summary = "**IKEA** is a Swedish company that sells flat-pack furniture you assemble yourself, plus its famous meatballs.",
		sections = { { "Scale", "IKEA's catalog was once the most printed [[Book|book]] in the world." } },
		infobox = { { "Founded", "1943, Sweden" }, { "Famous for", "Flat-pack furniture" } },
	},
	{
		title = "International Olympic Committee",
		category = "Organization",
		fame = 3,
		emoji = "⭕",
		tags = { "Sports organizations" },
		aliases = { "IOC" },
		summary = "The **International Olympic Committee** organizes the modern [[Olympic Games]]. It is based in Lausanne, Switzerland.",
		sections = { { "Founder", "It was founded in [[Paris]] in 1894 by Pierre de Coubertin." } },
		infobox = { { "Founded", "1894, [[Paris]]" }, { "Organizes", "[[Olympic Games]]" } },
	},
	{
		title = "Red Cross",
		category = "Organization",
		fame = 2,
		emoji = "➕",
		tags = { "Humanitarian organizations" },
		aliases = { "International Red Cross" },
		summary = "The **Red Cross** is a worldwide humanitarian movement that helps people affected by war and disasters.",
		sections = {
			{
				"History",
				"It was founded in 1863 in Geneva. Its symbol is a red cross on white, the reverse of the Swiss flag.",
			},
		},
		infobox = { { "Founded", "1863" }, { "Nobel Peace Prizes", "3" } },
		related = { "United Nations", "World Health Organization" },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Food</string>
          <string name="Source"><![CDATA[-- Food, dishes and drinks.
return {
	{
		title = "Food",
		category = "Food",
		fame = 1,
		emoji = "🍽️",
		tags = { "Food and drink" },
		aliases = { "Cuisine", "Foods" },
		summary = "**Food** is anything eaten to provide energy and nutrients. Most food comes from [[Plant|plants]] and [[Animal|animals]].",
		sections = {
			{
				"Cuisines",
				"Every culture has its own cuisine — [[Pizza|pizza]] from [[Italy]], [[Sushi|sushi]] from [[Japan]], [[Taco|tacos]] from [[Mexico]].",
			},
			{ "Modern eating", "[[Fast food]] restaurants now serve billions of meals every year." },
		},
		infobox = {
			{ "Main groups", "Grains, fruits, vegetables, protein, dairy" },
			{ "Staples", "[[Rice]], [[Wheat]], [[Maize]]" },
		},
		related = { "Cooking", "Dumpling", "Ice cream" },
	},
	{
		title = "Cooking",
		category = "Concept",
		fame = 2,
		emoji = "🍳",
		tags = { "Food and drink" },
		summary = "**Cooking** is preparing [[Food|food]] using heat. Humans have cooked with fire for hundreds of thousands of years.",
		sections = {
			{
				"Methods",
				"Food can be baked into [[Bread|bread]], fried like [[French fries]], or grilled like [[Barbecue|barbecue]]. Some dishes, like [[Sushi|sushi]], are served raw.",
			},
		},
		infobox = { { "Oldest method", "Roasting over fire" }, { "Related", "[[Chemistry]]" } },
	},
	{
		title = "Fast food",
		category = "Food",
		fame = 1,
		emoji = "🍔",
		tags = { "Restaurants" },
		aliases = { "Junk food" },
		summary = "**Fast food** is food prepared and served quickly, often at chain restaurants such as [[McDonald's]].",
		sections = {
			{
				"Menu",
				"Typical fast food includes the [[Hamburger|hamburger]], [[French fries]], [[Fried chicken|fried chicken]] and soft drinks like [[Coca-Cola]].",
			},
		},
		infobox = { { "Popularized in", "[[United States]]" }, { "Biggest chain", "[[McDonald's]]" } },
	},
	{
		title = "Hamburger",
		category = "Food",
		fame = 1,
		emoji = "🍔",
		tags = { "Sandwiches", "Fast food" },
		aliases = { "Burger", "Burgers", "Cheeseburger" },
		summary = "A **hamburger** is a [[Sandwich|sandwich]] of a cooked ground-beef patty in a sliced bun. It became an icon of the [[United States]] and of [[Fast food|fast food]].",
		sections = {
			{
				"Name",
				"It is named after Hamburg in [[Germany]], not after ham. Popular toppings include [[Cheese|cheese]] and [[Ketchup|ketchup]].",
			},
		},
		infobox = { { "Origin", "[[United States]]" }, { "Sold by", "[[McDonald's]]" } },
	},
	{
		title = "French fries",
		category = "Food",
		fame = 1,
		emoji = "🍟",
		tags = { "Potato dishes", "Fast food" },
		aliases = { "Fries", "Chips", "Frites" },
		summary = "**French fries** are strips of deep-fried [[Potato|potato]]. Despite the name, [[Belgium]] and [[France]] both claim to have invented them.",
		sections = {
			{
				"Serving",
				"Fries are usually served with [[Ketchup|ketchup]], and they are one of the best-selling items at [[McDonald's]].",
			},
		},
		infobox = { { "Made from", "[[Potato]]" }, { "Origin", "[[Belgium]] or [[France]]" } },
	},
	{
		title = "Hot dog",
		category = "Food",
		fame = 2,
		emoji = "🌭",
		tags = { "Sandwiches", "Fast food" },
		aliases = { "Hot dogs", "Frankfurter" },
		summary = "A **hot dog** is a grilled or steamed sausage served in a sliced bun. It is a classic food at [[Baseball|baseball]] games in the [[United States]].",
		sections = {
			{ "Contest", "A famous hot-dog-eating contest is held every Fourth of July in [[New York City]]." },
		},
		infobox = { { "Origin", "[[Germany]] / [[United States]]" }, { "Toppings", "Mustard, [[Ketchup|ketchup]]" } },
	},
	{
		title = "Pizza",
		category = "Food",
		fame = 1,
		emoji = "🍕",
		tags = { "Italian cuisine", "Baked dishes" },
		aliases = { "Pizzas" },
		summary = "**Pizza** is a flat round [[Bread|bread]] topped with [[Tomato|tomato]] sauce and [[Cheese|cheese]], baked in a hot oven. Modern pizza was born in [[Naples]], [[Italy]].",
		sections = {
			{
				"Margherita",
				"The Margherita pizza — tomato, [[Mozzarella|mozzarella]] and basil — shows the colors of the Italian flag.",
			},
			{ "Worldwide", "Pizza is now eaten everywhere, and pineapple topping remains fiercely debated." },
		},
		infobox = {
			{ "Origin", "[[Naples]], [[Italy]]" },
			{ "Main ingredients", "[[Bread|Dough]], [[Tomato]], [[Cheese]]" },
		},
		related = { "Pasta" },
	},
	{
		title = "Pasta",
		category = "Food",
		fame = 1,
		emoji = "🍝",
		tags = { "Italian cuisine" },
		aliases = { "Spaghetti", "Macaroni", "Lasagna" },
		summary = "**Pasta** is a food made from [[Wheat|wheat]] dough shaped into forms like spaghetti, penne and lasagna. It is a staple of [[Italy]].",
		sections = {
			{
				"Myth",
				"A popular myth says [[Marco Polo]] brought pasta from [[China]], but Italians were eating it before his travels. Pasta is related to the [[Noodle|noodle]].",
			},
		},
		infobox = { { "Origin", "[[Italy]]" }, { "Shapes", "~350" } },
	},
	{
		title = "Noodle",
		category = "Food",
		fame = 2,
		emoji = "🍜",
		tags = { "Asian cuisine" },
		aliases = { "Noodles" },
		summary = "A **noodle** is a long thin strip of dough, boiled or fried. The oldest known noodles, found in [[China]], are 4,000 years old.",
		sections = {
			{
				"Dishes",
				"Noodles star in [[Ramen|ramen]] and countless stir-fries. Italian [[Pasta|pasta]] is a close cousin.",
			},
		},
		infobox = { { "Origin", "[[China]]" }, { "Relatives", "[[Pasta]]" } },
	},
	{
		title = "Ramen",
		category = "Food",
		fame = 2,
		emoji = "🍜",
		tags = { "Japanese cuisine" },
		summary = "**Ramen** is a Japanese [[Noodle|noodle]] soup with a rich broth and toppings like egg and pork. Instant ramen was invented in [[Japan]] in 1958.",
		sections = { { "Pop culture", "[[Naruto]] Uzumaki's favorite food is ramen." } },
		infobox = { { "Country", "[[Japan]]" }, { "Instant version", "1958" } },
	},
	{
		title = "Sushi",
		category = "Food",
		fame = 1,
		emoji = "🍣",
		tags = { "Japanese cuisine" },
		summary = "**Sushi** is a Japanese dish of vinegared [[Rice|rice]] with raw [[Fish|fish]], seafood or vegetables.",
		sections = {
			{
				"History",
				"It began as a way of preserving fish in fermented rice. Today conveyor-belt sushi restaurants are common in [[Japan]] and beyond.",
			},
		},
		infobox = { { "Country", "[[Japan]]" }, { "Main ingredients", "[[Rice]], [[Fish]]" } },
	},
	{
		title = "Taco",
		category = "Food",
		fame = 1,
		emoji = "🌮",
		tags = { "Mexican cuisine" },
		aliases = { "Tacos" },
		summary = "A **taco** is a folded [[Maize|corn]] tortilla filled with meat, beans, cheese or vegetables. It is a traditional dish of [[Mexico]].",
		sections = { { "Toppings", "Tacos are often topped with salsa and [[Guacamole|guacamole]]." } },
		infobox = { { "Country", "[[Mexico]]" }, { "Shell", "[[Maize|Corn]] tortilla" } },
	},
	{
		title = "Guacamole",
		category = "Food",
		fame = 3,
		emoji = "🥑",
		tags = { "Mexican cuisine", "Dips" },
		summary = "**Guacamole** is a dip made from mashed [[Avocado|avocado]], lime, onion and chili. It was first made by the [[Aztecs]].",
		sections = { { "Serving", "It is eaten with tortilla chips and on [[Taco|tacos]]." } },
		infobox = { { "Origin", "[[Mexico]]" }, { "Main ingredient", "[[Avocado]]" } },
	},
	{
		title = "Empanada",
		category = "Food",
		fame = 3,
		emoji = "🥟",
		tags = { "Latin American cuisine", "Pastries" },
		aliases = { "Empanadas" },
		summary = "An **empanada** is a folded pastry stuffed with meat, cheese or vegetables, then baked or fried. It is loved in [[Argentina]] and [[Spain]].",
		sections = {
			{
				"Varieties",
				"In [[Buenos Aires]], each region's empanadas are recognized by the pattern of their folded edges.",
			},
		},
		infobox = { { "Origin", "[[Spain]]" }, { "Popular in", "[[Argentina]]" } },
	},
	{
		title = "Ice cream",
		category = "Food",
		fame = 1,
		emoji = "🍦",
		tags = { "Desserts", "Frozen desserts" },
		aliases = { "Gelato" },
		summary = "**Ice cream** is a frozen dessert made from milk, cream and [[Sugar|sugar]]. The most popular flavor worldwide is [[Vanilla|vanilla]], followed by [[Chocolate|chocolate]].",
		sections = {
			{ "History", "Early frozen desserts were enjoyed in ancient [[China]] and Persia using snow and ice." },
		},
		infobox = { { "Main ingredients", "Milk, cream, [[Sugar]]" }, { "Top flavor", "[[Vanilla]]" } },
	},
	{
		title = "Chocolate",
		category = "Food",
