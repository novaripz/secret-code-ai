		tags = { "Eudicots", "Cucurbitales" },
		aliases = { "Citrullus lanatus" },
		summary = "The **watermelon** (**Citrullus lanatus**) is a species of [[Flowering plant|flowering plant]] in the family [[Cucurbitaceae]]. It is a scrambling and trailing [[Vine|vine]]-like plant [[Plant breeding|cultivated]] worldwide.",
		sections = {
			{
				"Overview",
				"Watermelons are grown in [[Tropics|tropical]] to [[Temperate climate|temperate]] regions for its large edible [[Berry (botany)|berry]] having a firm rind and no internal divisions; [[Botany|botanically]], it is a pepo. The sweet, juicy flesh is usually deep red to pink, with many seeds that are black when mature and white when immature. Seedless varieties exist. The fruit can be eaten raw or pickled, and the rind is edible after cooking. It may also be consumed as a juice or an ingredient in mixed beverages. The modern watermelon originated in [[Sudan]] where it was first domesticated and cultivated. Kordofan melons are the closest relatives and may be progenitors of modern, cultivated watermelons.",
			},
		},
		related = { "Cucumis melo" },
		infobox = {
