  <Item class="StarterPlayer" referent="63">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="64">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">WikiRaceClient</string>
        </Properties>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Net</string>
              <string name="Source"><![CDATA[-- Client networking: one RemoteFunction for requests, one RemoteEvent for server pushes.
-- Requests never throw; they return ok, data | errorMessage, errorCode.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local SharedNet = require(Shared.Net)
local Signal = require(Shared.Signal)

local Net = {}
Net.Actions = SharedNet.Actions
Net.Events = SharedNet.Events

local requestRemote, pushRemote
local signals = {}
local buffered = {} -- events received before anyone listened

function Net.init()
	requestRemote, pushRemote = SharedNet.waitForRemotes(ReplicatedStorage)
	pushRemote.OnClientEvent:Connect(function(event, data)
		local signal = signals[event]
		if signal and #signal._handlers > 0 then
			signal:Fire(data)
		else
			buffered[event] = buffered[event] or {}
			table.insert(buffered[event], data)
			if #buffered[event] > 20 then
				table.remove(buffered[event], 1)
			end
		end
	end)
end

function Net.on(event: string, handler)
	assert(SharedNet.Events[event], "unknown event " .. tostring(event))
	local signal = signals[event]
	if not signal then
		signal = Signal.new()
		signals[event] = signal
	end
	local connection = signal:Connect(handler)
	local pending = buffered[event]
	if pending then
		buffered[event] = nil
		for _, data in pending do
			task.spawn(handler, data)
		end
	end
	return connection
end

function Net.request(action: string, payload): (boolean, any, string?)
	assert(SharedNet.Actions[action], "unknown action " .. tostring(action))
	local ok, response = pcall(requestRemote.InvokeServer, requestRemote, action, payload)
	if not ok then
		return false, "Connection problem — please try again.", "Network"
	end
	if type(response) ~= "table" then
		return false, "Unexpected server response.", "Protocol"
	end
	if response.ok then
		return true, response.data
	end
	return false, response.error or "Request failed.", response.code
end

return Net
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[-- UI sound playback. Sound IDs come from Config.Sounds; the equipped sound pack changes pitch
-- and volume. Unconfigured sounds fall back to a few sounds bundled with the Roblox client, so
-- the game is never completely silent while you're still uploading the generated SFX.

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)

local Sound = {}

local FALLBACK = {
	click = { "rbxasset://sounds/clickfast.wav", 1.1 },
	hover = { "rbxasset://sounds/clickfast.wav", 1.6, 0.25 },
	tick = { "rbxasset://sounds/clickfast.wav", 1.8, 0.5 },
	link = { "rbxasset://sounds/electronicpingshort.wav", 1.4, 0.4 },
	back = { "rbxasset://sounds/electronicpingshort.wav", 0.9, 0.4 },
	countdown = { "rbxasset://sounds/electronicpingshort.wav", 1, 0.7 },
	go = { "rbxasset://sounds/electronicpingshort.wav", 1.5, 0.9 },
	tempUp = { "rbxasset://sounds/electronicpingshort.wav", 1.25, 0.5 },
	tempDown = { "rbxasset://sounds/electronicpingshort.wav", 0.75, 0.4 },
	burning = { "rbxasset://sounds/electronicpingshort.wav", 1.9, 0.9 },
	complete = { "rbxasset://sounds/electronicpingshort.wav", 1.6, 1 },
	achievement = { "rbxasset://sounds/electronicpingshort.wav", 1.3, 0.8 },
	coin = { "rbxasset://sounds/electronicpingshort.wav", 2, 0.6 },
	award = { "rbxasset://sounds/electronicpingshort.wav", 1.2, 0.8 },
	error = { "rbxasset://sounds/clickfast.wav", 0.5, 0.6 },
}

local folder = Instance.new("Folder")
folder.Name = "WikiRaceSounds"
folder.Parent = SoundService

local templates = {}
local volume = 0.8
local pitchMultiplier = 1
local volumeMultiplier = 1

local function template(name: string)
	if templates[name] ~= nil then
		return templates[name]
	end
	local id = Config.Sounds[name]
	local fallback = FALLBACK[name]
	local sound = nil
	if id and id ~= "" then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound:SetAttribute("BasePitch", 1)
		sound:SetAttribute("BaseVolume", 0.7)
	elseif fallback then
		sound = Instance.new("Sound")
		sound.SoundId = fallback[1]
		sound:SetAttribute("BasePitch", fallback[2] or 1)
		sound:SetAttribute("BaseVolume", fallback[3] or 0.7)
	end
	if sound then
		sound.Name = name
		sound.Parent = folder
	end
	templates[name] = sound or false
	return templates[name]
end

function Sound.setVolume(value: number)
	volume = math.clamp(value, 0, 1)
end

function Sound.setPack(itemId: string?)
	local item = itemId and Catalog.ById[itemId]
	pitchMultiplier = item and item.pitch or 1
	volumeMultiplier = item and item.volume or 1
end

-- options: { pitch = multiplier, volume = multiplier }
function Sound.play(name: string, options)
	if volume <= 0 then
		return
	end
	local base = template(name)
	if not base then
		return
	end
	local sound = base:Clone()
	sound.PlaybackSpeed = (base:GetAttribute("BasePitch") or 1) * pitchMultiplier * ((options and options.pitch) or 1)
	sound.Volume = (base:GetAttribute("BaseVolume") or 0.7)
		* volume
		* volumeMultiplier
		* ((options and options.volume) or 1)
	sound.Parent = folder
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(12, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Looping sound (e.g. heartbeat while Burning). Returns a stop function.
function Sound.loop(name: string, options)
	local base = template(name)
	if not base or volume <= 0 then
		return function() end
	end
	local sound = base:Clone()
	sound.Looped = true
	sound.PlaybackSpeed = (base:GetAttribute("BasePitch") or 1) * pitchMultiplier * ((options and options.pitch) or 1)
	sound.Volume = (base:GetAttribute("BaseVolume") or 0.7)
		* volume
		* volumeMultiplier
		* ((options and options.volume) or 1)
	sound.Parent = folder
	sound:Play()
	return function()
		sound:Stop()
		sound:Destroy()
	end
end

return Sound
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Store</string>
              <string name="Source"><![CDATA[-- Client-side state container. Holds the latest server snapshots; screens listen to `changed`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage:WaitForChild("WikiRaceShared").Signal)

local Store = {
	profile = nil,
	lobby = nil,
	lobbies = {},
	records = {},
	boot = nil,
	race = nil,
	titles = {}, -- page id → title (for history dropdowns)
	changed = Signal.new(),
}

function Store.set(key: string, value)
	Store[key] = value
	Store.changed:Fire(key, value)
end

function Store.rememberTitle(id: string?, title: string?)
	if id and title then
		Store.titles[id] = title
	end
end

function Store.titleOf(id: string): string
	return Store.titles[id] or (id:gsub("_", " "):gsub("^%l", string.upper))
end

function Store.myUserId(): number
	return game:GetService("Players").LocalPlayer.UserId
end

function Store.isHost(): boolean
	return Store.lobby ~= nil and Store.lobby.hostId == Store.myUserId()
end

function Store.setting(key: string, default)
	local profile = Store.profile
	if profile and profile.settings and profile.settings[key] ~= nil then
		return profile.settings[key]
	end
	return default
end

return Store
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="70">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Wiki Race client bootstrap: builds the UI, wires server pushes to screens, then boots.

local StarterGui = game:GetService("StarterGui")

local Core = script.Parent.Core
local UI = script.Parent.UI
local Net = require(Core.Net)
local Store = require(Core.Store)
local App = require(UI.App)
local Reveal = require(UI.Overlays.Reveal)
local RoundResults = require(UI.Overlays.RoundResults)
local FinalResults = require(UI.Overlays.FinalResults)
local Chaos = require(UI.Overlays.Chaos)
local Announcer = require(UI.Overlays.Announcer)

local E = Net.Events

-- A UI game: hide the default character HUD, keep chat for socializing.
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

Net.init()
App.init()

local screens = {}
for _, name in { "Menu", "Lobbies", "LobbyRoom", "Race", "FreeRoam", "Profile", "Shop", "Leaderboards", "Settings" } do
	local module = require(UI.Screens[name])
	screens[name] = module.new(App)
	App.register(name, screens[name])
end

-- Server pushes ---------------------------------------------------------------------------

Net.on(E.Profile, function(profile)
	Store.set("profile", profile)
	App.applyProfile(profile)
end)

Net.on(E.Toast, function(data)
	App.toast(data.text, data.kind)
end)

Net.on(E.LobbyList, function(list)
	Store.set("lobbies", list)
end)

Net.on(E.LobbyState, function(snapshot)
	local previous = Store.lobby
	Store.set("lobby", snapshot)
	if snapshot.solo then
		return -- solo races go straight to the race screen
	end
	local current = App.current
	if current == "Race" or current == "FreeRoam" and snapshot.state == "InMatch" then
		return
	end
	if not previous or previous.id ~= snapshot.id or current == "Menu" or current == "Lobbies" then
		App.show("LobbyRoom")
	end
end)

Net.on(E.LobbyLeft, function(data)
	Store.set("lobby", nil)
	Reveal.cancel()
	RoundResults.hide()
	if data.reason == "kicked" then
		App.toast("You were removed from the lobby by the host.", "error")
	end
	if App.current == "LobbyRoom" or App.current == "Race" then
		App.show("Menu")
	end
end)

Net.on(E.RoundGenerating, function(data)
	RoundResults.hide()
	FinalResults.hide()
	screens.Race:onGenerating(data)
end)

Net.on(E.RoundStart, function(data)
	RoundResults.hide()
	FinalResults.hide()
	screens.Race:onRoundStart(data)
	local profile = Store.profile
	if profile and profile.settings and profile.settings.hints and (profile.stats.races or 0) < 3 then
		task.delay(math.max(0, data.raceStartAt - workspace:GetServerTimeNow()) + 0.5, function()
			App.toast(
				"💡 Click the blue links to hop between articles. Watch the meter heat up as you get closer!",
				"info"
			)
		end)
	end
end)

Net.on(E.Opponents, function(data)
	screens.Race:onOpponents(data)
end)

Net.on(E.RoundClosing, function(data)
	screens.Race:onClosing(data)
end)

Net.on(E.RoundRigged, function(data)
	screens.Race:onRigged(data)
end)

Net.on(E.RoundResults, function(data)
	Reveal.cancel()
	RoundResults.show(App, data)
end)

Net.on(E.MatchResults, function(data)
	RoundResults.hide()
	FinalResults.show(App, data, function(action)
		if action == "again" then
			App.request(Net.Actions.StartMatch, {})
			App.show("LobbyRoom")
		elseif action == "freeroam" then
			task.spawn(Net.request, Net.Actions.LeaveLobby, {})
			Store.set("lobby", nil)
			App.show("FreeRoam")
		else
			App.home()
		end
	end)
end)

Net.on(E.MatchAborted, function(data)
	Reveal.cancel()
	RoundResults.hide()
	App.toast(data.reason or "The match ended.", "error")
	App.home()
end)

Net.on(E.ServerRigged, function(data)
	Chaos.serverRigged(App, data)
end)

Net.on(E.ChaosEffect, function(data)
	Chaos.effect(App, data)
end)

Net.on(E.Achievement, function(data)
	Announcer.achievement(App, data.id)
end)

Net.on(E.RecordBroken, function(data)
	local records = table.clone(Store.records or {})
	records[data.board] = data.record
	Store.set("records", records)
	Announcer.record(App, data)
end)

Net.on(E.Teleporting, function(data)
	App.loading(("Teleporting to “%s”…"):format(data.name or "lobby"))
end)

-- Boot ------------------------------------------------------------------------------------

local function boot()
	local hide = App.loading("Opening the encyclopedia…")
	local ok, data = Net.request(Net.Actions.Bootstrap, {})
	hide()
	if not ok then
		App.loading("Couldn't reach the server: " .. tostring(data), { retry = boot })
		return
	end
	Store.set("boot", data)
	Store.set("records", data.records or {})
	Store.set("lobbies", data.lobbies or {})
	if data.profile then
		Store.set("profile", data.profile)
		App.applyProfile(data.profile)
	end
	if data.lobby and not data.lobby.solo then
		Store.set("lobby", data.lobby)
		App.show("LobbyRoom")
	else
		App.show("Menu")
	end
	if data.profile and not data.profile.persistent and not data.studio then
		App.toast("Stats couldn't be loaded this session; progress may not save.", "error")
	end
end

boot()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="71">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Anim</string>
              <string name="Source"><![CDATA[-- Animation helpers. All durations shrink when the player enables Reduced Motion.

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Anim = {}
Anim.reduced = false

local function scaled(seconds: number): number
	return Anim.reduced and seconds * 0.35 or seconds
end

function Anim.tween(
	instance: Instance,
	seconds: number,
	goals,
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?,
	delayTime: number?
)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(
			scaled(seconds),
			style or Enum.EasingStyle.Quint,
			direction or Enum.EasingDirection.Out,
			0,
			false,
			delayTime or 0
		),
		goals
	)
	tween:Play()
	return tween
end

-- Ensures a GuiObject has a UIScale child and returns it.
function Anim.scaleOf(guiObject: GuiObject): UIScale
	local existing = guiObject:FindFirstChild("AnimScale")
	if existing then
		return existing :: UIScale
	end
	local scale = Instance.new("UIScale")
	scale.Name = "AnimScale"
	scale.Parent = guiObject
	return scale
end

function Anim.pop(guiObject: GuiObject, amount: number?)
	local scale = Anim.scaleOf(guiObject)
	scale.Scale = amount or 1.12
	Anim.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Anim.punchIn(guiObject: GuiObject, from: number?)
	local scale = Anim.scaleOf(guiObject)
	scale.Scale = from or 0.6
	return Anim.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Anim.fadeText(label: TextLabel, visible: boolean, seconds: number?)
	return Anim.tween(label, seconds or 0.25, { TextTransparency = visible and 0 or 1 })
end

-- Slides a GuiObject in from an offset relative to its current position.
function Anim.slideIn(guiObject: GuiObject, fromOffset: UDim2, seconds: number?, delayTime: number?)
	local target = guiObject.Position
	guiObject.Position = target + fromOffset
	return Anim.tween(
		guiObject,
		seconds or 0.45,
		{ Position = target },
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		delayTime
	)
end

-- Animated number counter on a TextLabel.
function Anim.countTo(label: TextLabel, from: number, to: number, seconds: number, format)
	format = format or function(n)
		return tostring(math.floor(n + 0.5))
	end
	local duration = scaled(seconds)
	local started = os.clock()
	local token = {}
	label:SetAttribute("CountToken", tostring(token))
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if label:GetAttribute("CountToken") ~= tostring(token) or not label.Parent then
			connection:Disconnect()
			return
		end
		local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
		local eased = 1 - (1 - alpha) ^ 3
		label.Text = format(from + (to - from) * eased)
		if alpha >= 1 then
			connection:Disconnect()
		end
	end)
end

-- Shakes a GuiObject around its current position.
function Anim.shake(guiObject: GuiObject, intensity: number, seconds: number)
	if Anim.reduced then
		return
	end
	local origin = guiObject.Position
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - started
		if elapsed >= seconds or not guiObject.Parent then
			guiObject.Position = origin
			connection:Disconnect()
			return
		end
		local falloff = 1 - elapsed / seconds
		guiObject.Position = origin
			+ UDim2.fromOffset(
				(math.random() - 0.5) * 2 * intensity * falloff,
				(math.random() - 0.5) * 2 * intensity * falloff
			)
	end)
end

-- Repeating pulse; returns a stop function.
function Anim.pulse(instance: Instance, property: string, low, high, period: number)
	local info = TweenInfo.new(period / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true);
	(instance :: any)[property] = low
	local tween = TweenService:Create(instance, info, { [property] = high })
	tween:Play()
	return function()
		tween:Cancel()
	end
end

-- Continuous rotation for UIGradients (animated frames/themes). Returns a stop function.
function Anim.spin(instance: Instance, degreesPerSecond: number)
	local connection = RunService.RenderStepped:Connect(function(dt)
		if not instance.Parent then
			return
		end
		(instance :: any).Rotation = ((instance :: any).Rotation + degreesPerSecond * dt) % 360
	end)
	instance.Destroying:Connect(function()
		connection:Disconnect()
	end)
	return function()
		connection:Disconnect()
	end
end

return Anim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">App</string>
              <string name="Source"><![CDATA[-- App shell: ScreenGuis, responsive scaling, themed/animated background, screen router,
-- toasts, modals, loading states, purchases and cosmetic application.

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Signal = require(Shared.Signal)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Anim = require(script.Parent.Anim)
local Fx = require(script.Parent.Fx)
local Net = require(script.Parent.Parent.Core.Net)
local Store = require(script.Parent.Parent.Core.Store)
local Sound = require(script.Parent.Parent.Core.Sound)

local App = {}
App.screens = {}
App.current = nil
App.history = {}
App.compact = false
App.layoutChanged = Signal.new()

local player = Players.LocalPlayer

local function makeGui(name: string, order: number)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	local root = Kit.frame({ Name = "Root", Size = UDim2.fromScale(1, 1) })
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Name = "Scale"
	scale.Parent = root
	return gui, root, scale
end

local scales = {}

local function updateScale()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local scale = math.clamp(viewport.Y / 760, 0.72, 1.35)
	scale = math.min(scale, math.max(0.6, viewport.X / 960))
	for _, uiScale in scales do
		uiScale.Scale = scale
	end
	local designWidth = viewport.X / scale
	local compact = designWidth < 1120
		or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and designWidth < 1250)
	App.scale = scale
	App.designSize = Vector2.new(designWidth, viewport.Y / scale)
	if compact ~= App.compact then
		App.compact = compact
		App.layoutChanged:Fire(compact)
	end
end

function App.init()
	local _, background, bgScale = makeGui("WikiRaceBackground", 1)
	local mainGui, root, rootScale = makeGui("WikiRace", 10)
	local _, overlay, overlayScale = makeGui("WikiRaceOverlay", 20)
	local _, fxRoot = makeGui("WikiRaceFx", 30)
	scales = { rootScale, overlayScale, bgScale }
	App.gui = mainGui
	App.root = root
	App.overlay = overlay
	App.fx = fxRoot
	App.background = background

	App:_buildBackground(background)

	App.toasts = Kit.frame({
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 100,
		Parent = overlay,
	}, { Kit.list("y", 8, "Center", "Top") })

	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
	end)
	updateScale()
	GuiService.AutoSelectGuiEnabled = true
end

-- Background: theme gradient + pattern + lobby cosmetic layer.
function App:_buildBackground(parent)
	local base = Kit.make("Frame", {
		Name = "Base",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = parent,
		Theme = { BackgroundColor3 = "bg" },
	})
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Parent = base
	local function paint()
		gradient.Color = ColorSequence.new(Theme.current.bg, Theme.current.bg2)
	end
	paint()
	Theme.changed:Connect(paint)
	App.bgGradient = gradient
	App.pattern =
		Kit.frame({ Name = "Pattern", Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = parent })
	App.lobbyLayer =
		Kit.frame({ Name = "LobbyLayer", Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = parent })
	self:_applyPattern()
	Theme.changed:Connect(function()
		self:_applyPattern()
	end)
end

function App:_applyPattern()
	for _, child in App.pattern:GetChildren() do
		child:Destroy()
	end
	if App.stopPattern then
		App.stopPattern()
		App.stopPattern = nil
	end
	local t = Theme.current
	if t.pattern == "grid" then
		for i = 0, 24 do
			Kit.make("Frame", {
				Size = UDim2.new(0, 1, 1, 0),
				Position = UDim2.fromScale(i / 24, 0),
				BackgroundColor3 = t.accent,
				BackgroundTransparency = 0.85,
				BorderSizePixel = 0,
				Parent = App.pattern,
			})
			Kit.make("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				Position = UDim2.fromScale(0, i / 24),
				BackgroundColor3 = t.accent2,
				BackgroundTransparency = 0.88,
				BorderSizePixel = 0,
				Parent = App.pattern,
			})
		end
	elseif t.pattern == "scanlines" then
		for i = 0, 80 do
			Kit.make("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				Position = UDim2.fromScale(0, i / 80),
				BackgroundColor3 = t.accent,
				BackgroundTransparency = 0.9,
				BorderSizePixel = 0,
				Parent = App.pattern,
			})
		end
	elseif t.pattern == "stars" then
		for _ = 1, 90 do
			local star = Kit.make("Frame", {
				Size = UDim2.fromOffset(math.random(1, 3), math.random(1, 3)),
				Position = UDim2.fromScale(math.random(), math.random()),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = math.random() * 0.6,
				BorderSizePixel = 0,
				Parent = App.pattern,
			}, { Kit.round() })
			if t.animated and math.random() < 0.3 then
				Anim.pulse(star, "BackgroundTransparency", 0.1, 0.9, 1 + math.random() * 3)
			end
		end
	end
	if t.animated then
		App.stopPattern = Anim.spin(App.bgGradient, 6)
	else
		App.bgGradient.Rotation = 90
	end
end

-- Lobby background cosmetic (shown on menu + lobby screens).
function App.setLobbyBackground(itemId: string?, visible: boolean)
	local layer = App.lobbyLayer
	if App.lobbyBgId ~= itemId then
		App.lobbyBgId = itemId
		for _, child in layer:GetChildren() do
			child:Destroy()
		end
		if App.stopLobbyBg then
			App.stopLobbyBg()
			App.stopLobbyBg = nil
		end
		if itemId == "lobby_aurora" then
			for i = 1, 3 do
				local band = Kit.make("Frame", {
					Size = UDim2.fromScale(1.6, 0.35),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.2 + i * 0.12),
					BackgroundColor3 = ({
						Color3.fromRGB(34, 211, 153),
						Color3.fromRGB(56, 189, 248),
						Color3.fromRGB(168, 85, 247),
					})[i],
					BackgroundTransparency = 0.75,
					BorderSizePixel = 0,
					Rotation = -8 + i * 5,
					Parent = layer,
				}, { Kit.round() })
				local g = Instance.new("UIGradient")
				g.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.2),
					NumberSequenceKeypoint.new(1, 1),
				})
				g.Parent = band
				Anim.pulse(band, "Rotation", band.Rotation - 4, band.Rotation + 4, 8 + i * 2)
			end
		elseif itemId == "lobby_grid" then
			for i = 0, 16 do
				local line = Kit.make("Frame", {
					Size = UDim2.new(1, 0, 0, 2),
					Position = UDim2.fromScale(0, i / 16),
					BackgroundColor3 = Color3.fromRGB(236, 72, 153),
					BackgroundTransparency = 0.7,
					BorderSizePixel = 0,
					Parent = layer,
				})
				Anim.pulse(line, "BackgroundTransparency", 0.55, 0.92, 2 + (i % 4))
			end
		elseif itemId == "lobby_starfield" then
			App.stopLobbyBg = Fx.emitter(layer, {
				colors = { Color3.new(1, 1, 1), Color3.fromRGB(199, 210, 254) },
				direction = "down",
				rate = 12,
				lifetime = 6,
				minSize = 2,
				maxSize = 4,
			})
		elseif itemId == "lobby_vip" then
			App.stopLobbyBg = Fx.emitter(layer, {
				glyph = "★",
				colors = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 240, 180) },
				rate = 6,
				lifetime = 5,
				minSize = 8,
				maxSize = 14,
			})
		end
	end
	layer.Visible = visible
end

function App.register(name: string, screen)
	App.screens[name] = screen
	screen.frame.Visible = false
end

function App.show(name: string, args)
	local nextScreen = App.screens[name]
	if not nextScreen then
		return
	end
	local previous = App.current and App.screens[App.current]
	if App.current == name then
		if nextScreen.show then
			nextScreen:show(args)
		end
		return
	end
	if App.current then
		table.insert(App.history, App.current)
		if #App.history > 10 then
			table.remove(App.history, 1)
		end
	end
	if previous then
		if previous.hide then
			previous:hide()
		end
		previous.frame.Visible = false
	end
	App.current = name
	nextScreen.frame.Visible = true
	local lobbyScreens = {
		Menu = true,
		Lobbies = true,
		LobbyRoom = true,
		Profile = true,
		Shop = true,
		Leaderboards = true,
		Settings = true,
	}
	App.setLobbyBackground(
		Store.profile and Store.profile.equipped and Store.profile.equipped.lobbyBg or "lobby_default",
		lobbyScreens[name] == true
	)
	nextScreen.frame.Position = UDim2.fromOffset(0, 16)
	Anim.tween(nextScreen.frame, 0.35, { Position = UDim2.fromOffset(0, 0) })
	if nextScreen.show then
		nextScreen:show(args)
	end
end

function App.back(fallback: string?)
	local previous = table.remove(App.history)
	while previous and (previous == "Race" or previous == App.current) do
		previous = table.remove(App.history)
	end
	App.show(previous or fallback or "Menu")
	-- Don't let "back" itself push onto history.
	table.remove(App.history)
end

-- Where a player belongs when no modal flow is active.
function App.home()
	if Store.lobby then
		App.show("LobbyRoom")
	else
		App.show("Menu")
	end
end

-- Toasts ------------------------------------------------------------------------------------

local TOAST_TOKENS = { success = "success", error = "danger", finish = "gold", info = "accent", muted = "textFaint" }

function App.toast(text: string, kind: string?)
	kind = kind or "info"
	local toast = Kit.panel({
		Name = "Toast",
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 100,
		Parent = App.toasts,
	}, { Kit.padding(10, 16, 10, 16) }, "surface2")
	local bar = Kit.make("Frame", {
		Size = UDim2.new(0, 4, 1, -12),
		Position = UDim2.fromOffset(-8, 6),
		BorderSizePixel = 0,
		ZIndex = 101,
		Parent = toast,
		Theme = { BackgroundColor3 = TOAST_TOKENS[kind] or "accent" },
	}, { Kit.round() })
	local _ = bar
	local label = Kit.text({
		text = text,
		style = "small",
		font = "fontBold",
		Size = UDim2.new(1, 0, 0, 0),
		auto = Enum.AutomaticSize.Y,
		ZIndex = 101,
		Parent = toast,
	})
	label.TextWrapped = true
	Anim.punchIn(toast, 0.8)
	if kind == "error" then
		Sound.play("error")
	elseif kind == "finish" then
		Sound.play("finishOther")
	end
	local children = 0
	for _, child in App.toasts:GetChildren() do
		if child:IsA("GuiObject") then
			children += 1
		end
	end
	if children > 4 then
		for _, child in App.toasts:GetChildren() do
			if child:IsA("GuiObject") and child ~= toast then
				child:Destroy()
				break
			end
		end
	end
	task.delay(kind == "error" and 5 or 3.4, function()
		if toast.Parent then
			Anim.tween(label, 0.25, { TextTransparency = 1 })
			Anim.tween(toast, 0.25, { BackgroundTransparency = 1 })
			task.delay(0.26, function()
				toast:Destroy()
			end)
		end
	end)
end

-- Modal -------------------------------------------------------------------------------------

-- opts: { title, width, build(body, close), buttons = { { text, variant, onClick(close) } }, dismissable }
function App.modal(opts)
	local shade = Kit.make("TextButton", {
		Name = "Modal",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 80,
		Parent = App.overlay,
	})
	Anim.tween(shade, 0.25, { BackgroundTransparency = 0.45 })
	local card = Kit.panel({
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(opts.width or 460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 81,
		Parent = shade,
	}, { Kit.padding(20), Kit.list("y", 12) }, "surface")
	card.BackgroundTransparency = 0
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		Anim.tween(shade, 0.2, { BackgroundTransparency = 1 })
		Anim.tween(Anim.scaleOf(card), 0.2, { Scale = 0.9 })
		task.delay(0.2, function()
			shade:Destroy()
		end)
		if opts.onClose then
			opts.onClose()
		end
	end
	if opts.title then
		Kit.text({ text = opts.title, style = "h1", size = 24, Parent = card, order = 0, ZIndex = 82 })
	end
	local body = Kit.frame({
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 82,
		Parent = card,
	}, { Kit.list("y", 10) })
	if opts.build then
		opts.build(body, close)
	end
	if opts.buttons then
		local row = Kit.frame(
			{ Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, Parent = card },
			{ Kit.list("x", 10, "Right", "Center") }
		)
		for index, spec in opts.buttons do
			Kit.button({
				text = spec.text,
				emoji = spec.emoji,
				variant = spec.variant or "secondary",
				Size = UDim2.fromOffset(spec.width or 150, 44),
				order = index,
				ZIndex = 83,
				Parent = row,
				onClick = function(button)
					if spec.onClick then
						spec.onClick(close, button)
					else
						close()
					end
				end,
			})
		end
	end
	shade.Activated:Connect(function()
		if opts.dismissable ~= false then
			close()
		end
	end)
	Anim.punchIn(card, 0.85)
	Sound.play("whoosh", { volume = 0.5 })
	return close, body
end

function App.confirm(title: string, message: string, confirmText: string, onConfirm, variant: string?)
	App.modal({
		title = title,
		build = function(body)
			Kit.text({
				text = message,
				style = "body",
				tone = "textDim",
				Size = UDim2.new(1, 0, 0, 0),
				auto = Enum.AutomaticSize.Y,
				Parent = body,
				ZIndex = 82,
			})
		end,
		buttons = {
			{ text = "Cancel" },
			{
				text = confirmText,
				variant = variant or "primary",
				onClick = function(close)
					close()
					onConfirm()
				end,
			},
		},
	})
end

-- Loading ------------------------------------------------------------------------------------

-- Returns hide(). opts: { retry = fn, cancel = fn, subtle = bool }
function App.loading(text: string, opts)
	opts = opts or {}
	local shade = Kit.make("Frame", {
		Name = "Loading",
		Active = true, -- sink clicks while loading
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = opts.subtle and 0.7 or 0.35,
		ZIndex = 90,
		Parent = App.overlay,
	})
	local card = Kit.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 91,
		Parent = shade,
	}, { Kit.padding(22), Kit.list("y", 14, "Center", "Center") }, "surface")
	card.BackgroundTransparency = 0
	local spinner = Kit.spinner(44, card)
	spinner.LayoutOrder = 1
	spinner.ZIndex = 92
	local label = Kit.text({
		text = text,
		style = "h3",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		auto = Enum.AutomaticSize.Y,
		Parent = card,
		order = 2,
		ZIndex = 92,
	})
	local actions = Kit.frame({
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 3,
		Visible = opts.retry ~= nil or opts.cancel ~= nil,
		Parent = card,
	}, { Kit.list("x", 10, "Center", "Center") })
	local hidden = false
	local function hide()
		if hidden then
			return
		end
		hidden = true
		Anim.tween(shade, 0.2, { BackgroundTransparency = 1 })
		task.delay(0.2, function()
			shade:Destroy()
		end)
	end
	if opts.cancel then
		Kit.button({
			text = "Cancel",
			Parent = actions,
			order = 1,
			ZIndex = 93,
			Size = UDim2.fromOffset(130, 42),
			onClick = function()
				hide()
				opts.cancel()
			end,
		})
	end
	if opts.retry then
		Kit.button({
			text = "Retry",
			emoji = "⟳",
			variant = "primary",
			Parent = actions,
			order = 2,
			ZIndex = 93,
			Size = UDim2.fromOffset(130, 42),
			onClick = function()
				hide()
				opts.retry()
			end,
		})
	end
	Anim.punchIn(card, 0.9)
	return hide, label
end

-- Runs a request with a loading state and friendly error handling. Returns ok, data.
function App.request(action: string, payload, loadingText: string?)
	local hide = loadingText and App.loading(loadingText, { subtle = true }) or nil
	local ok, data = Net.request(action, payload)
	if hide then
		hide()
	end
	if not ok then
		App.toast(tostring(data), "error")
	end
	return ok, data
end

-- Purchases ---------------------------------------------------------------------------------

function App.purchaseProduct(productKey: string)
	local product = Config.Products[productKey]
	if not product then
		return
	end
	if product.id and product.id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, product.id)
	elseif Store.boot and Store.boot.debugPurchases then
		App.confirm(
			"Studio test purchase",
			("Simulate buying %s (%d R$)? No Robux will be charged."):format(product.name, product.price),
			"Simulate",
			function()
				local ok = App.request(Net.Actions.DebugPurchase, { product = productKey }, "Processing…")
				if ok then
					Sound.play("purchase")
					App.toast(product.name .. " purchased (Studio test).", "success")
				end
			end
		)
	else
		App.toast("This product isn't available yet.", "error")
	end
end

function App.promptPass(passKey: string)
	local pass = Config.GamePasses[passKey]
	if pass and pass.id and pass.id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.id)
	elseif Store.boot and Store.boot.studio then
		App.toast("Studio: game passes are auto-granted (see Config.Studio).", "info")
	else
		App.toast("This game pass isn't available yet.", "error")
	end
end

function App.owns(itemId: string): boolean
	local profile = Store.profile
	return profile ~= nil and profile.ownedAll ~= nil and profile.ownedAll[itemId] == true
end

function App.hasPass(passKey: string): boolean
	local profile = Store.profile
	return profile ~= nil and profile.passes ~= nil and profile.passes[passKey] == true
end

-- Applies equipped cosmetics + settings from a profile snapshot.
local cursorStop = nil
local currentCursor = nil
function App.applyProfile(profile)
	local equipped = profile.equipped or Catalog.defaults()
	local themeItem = Catalog.ById[equipped.theme]
	Theme.set(themeItem and themeItem.theme or "classic")
	Sound.setPack(equipped.sound)
	Sound.setVolume(profile.settings and profile.settings.sfx or 0.8)
	Anim.reduced = profile.settings and profile.settings.reducedMotion == true
	if currentCursor ~= equipped.cursor then
		currentCursor = equipped.cursor
		if cursorStop then
			cursorStop()
			cursorStop = nil
		end
		local item = Catalog.ById[equipped.cursor]
		if item and item.glyph then
			local color = equipped.cursor == "cursor_vip" and Color3.fromRGB(255, 215, 0)
				or (equipped.cursor == "cursor_comet" and Color3.fromRGB(255, 140, 60) or Color3.fromRGB(255, 255, 255))
			cursorStop = Fx.cursorTrail(App.fx, item.glyph, color)
		end
	end
	if App.current then
		local lobbyScreens = {
			Menu = true,
			Lobbies = true,
			LobbyRoom = true,
			Profile = true,
			Shop = true,
			Leaderboards = true,
			Settings = true,
		}
		App.setLobbyBackground(equipped.lobbyBg, lobbyScreens[App.current] == true)
	end
end

return App
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="74">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">FlowText</string>
                <string name="Source"><![CDATA[-- Inline rich paragraph renderer with clickable links.
--
-- Roblox text can't contain clickable spans, so paragraphs are laid out manually: text runs are
-- split into words, measured with TextService (cached), wrapped into lines, and consecutive
-- words that share style/link are merged back into single labels/buttons. A link that wraps
-- across lines becomes several buttons that highlight together.

local TextService = game:GetService("TextService")

local FlowText = {}

local widthCache = {}
local cacheSize = 0

local function measure(text: string, font: Enum.Font, size: number): number
	local key = font.Name .. "|" .. size .. "|" .. text
	local width = widthCache[key]
	if width then
		return width
	end
	width = TextService:GetTextSize(text, size, font, Vector2.new(10000, 1000)).X
	cacheSize += 1
	if cacheSize > 6000 then
		widthCache = {}
		cacheSize = 0
	end
	widthCache[key] = width
	return width
end
FlowText.measure = measure

local function tokenize(runs)
	local tokens = {}
	for _, run in runs do
		local text = run.t or ""
		local position = 1
		while position <= #text do
			local s, e = string.find(text, "%S+", position)
			if not s then
				-- Trailing whitespace: attach to previous token.
				local last = tokens[#tokens]
				if last then
					last.trail ..= string.sub(text, position)
				end
				break
			end
			if s > position then
				local last = tokens[#tokens]
				if last then
					last.trail ..= string.sub(text, position, s - 1)
				end
			end
			table.insert(tokens, { word = string.sub(text, s, e), trail = "", link = run.l, bold = run.b == true })
			position = e + 1
		end
	end
	return tokens
end

--[[
	style = {
		font, boldFont: Enum.Font, size: number, lineHeight: number?,
		color, linkColor, linkHover: Color3, visited: { [id] = true }?,
		interactive: boolean, zIndex: number?,
	}
	Returns height, { buttons }.
]]
function FlowText.render(container: GuiObject, runs, style, width: number, onLink)
	for _, child in container:GetChildren() do
		child:Destroy()
	end
	width = math.max(40, width)
	local size = style.size
	local lineHeight = style.lineHeight or math.floor(size * 1.45)
	local tokens = tokenize(runs)
	local spaceWidth = measure("a a", style.font, size) - measure("aa", style.font, size)

	-- Line layout.
	local x, line = 0, 0
	for _, token in tokens do
		local font = token.bold and style.boldFont or style.font
		token.font = font
		token.wordWidth = measure(token.word, font, size)
		token.trailWidth = #token.trail > 0 and spaceWidth * #token.trail or 0
		if x > 0 and x + token.wordWidth > width then
			line += 1
			x = 0
		end
		token.line = line
		token.x = x
		x += token.wordWidth + token.trailWidth
	end

	-- Merge consecutive tokens with the same style/link on the same line.
	local segments = {}
	for _, token in tokens do
		local last = segments[#segments]
		if last and last.line == token.line and last.link == token.link and last.bold == token.bold then
			last.text ..= last.pendingTrail .. token.word
			last.pendingTrail = token.trail
		else
			table.insert(segments, {
				text = token.word,
				pendingTrail = token.trail,
				line = token.line,
				x = token.x,
				link = token.link,
				bold = token.bold,
				font = token.font,
			})
		end
	end

	local groups = {} -- link id → { buttons }
	local buttons = {}
	local zIndex = style.zIndex or 2
	for index, segment in segments do
		local segmentWidth = measure(segment.text, segment.font, size) + 2
		local position = UDim2.fromOffset(segment.x, segment.line * lineHeight)
		if segment.link then
			local visited = style.visited and style.visited[segment.link]
			local button = Instance.new("TextButton")
			button.Name = "Link"
			button.AutoButtonColor = false
			button.BackgroundTransparency = 1
			button.Text = segment.text
			button.Font = segment.font
			button.TextSize = size
			button.TextColor3 = style.linkColor
			button.TextTransparency = visited and 0.22 or 0
			button.TextXAlignment = Enum.TextXAlignment.Left
			button.Size = UDim2.fromOffset(segmentWidth, lineHeight)
			button.Position = position
			button.ZIndex = zIndex
			button.Active = style.interactive ~= false
			button:SetAttribute("PageId", segment.link)
			button.Parent = container
			local underline = Instance.new("Frame")
			underline.Name = "Underline"
			underline.BorderSizePixel = 0
			underline.BackgroundColor3 = style.linkHover
			underline.BackgroundTransparency = 1
			underline.AnchorPoint = Vector2.new(0, 1)
			underline.Position = UDim2.new(0, 0, 1, -math.floor((lineHeight - size) / 2) + 1)
			underline.Size = UDim2.new(1, -2, 0, 2)
			underline.ZIndex = zIndex
			underline.Parent = button
			-- Group key: contiguous link segments with the same target highlight together.
			local previous = segments[index - 1]
			local groupKey = segment.link
				.. "#"
				.. ((previous and previous.link == segment.link) and (previous.groupIndex or index) or index)
			segment.groupIndex = (previous and previous.link == segment.link) and (previous.groupIndex or index)
				or index
			groups[groupKey] = groups[groupKey] or {}
			table.insert(groups[groupKey], button)
			button:SetAttribute("Group", groupKey)
			table.insert(buttons, button)
		else
			local label = Instance.new("TextLabel")
			label.Name = "Text"
			label.BackgroundTransparency = 1
			label.Text = segment.text
			label.Font = segment.font
			label.TextSize = size
			label.TextColor3 = style.color
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Size = UDim2.fromOffset(segmentWidth, lineHeight)
			label.Position = position
			label.ZIndex = zIndex
			label.Parent = container
		end
	end

	for _, button in buttons do
		local group = groups[button:GetAttribute("Group")]
		local function highlight(on: boolean)
			for _, member in group do
				member.TextColor3 = on and style.linkHover or style.linkColor
				local underline = member:FindFirstChild("Underline")
				if underline then
					underline.BackgroundTransparency = on and 0 or 1
				end
			end
		end
		button.MouseEnter:Connect(function()
			if button.Active then
				highlight(true)
			end
		end)
		button.MouseLeave:Connect(function()
			highlight(false)
		end)
		button.Activated:Connect(function()
			if button.Active and onLink then
				onLink(button:GetAttribute("PageId"), button, group)
			end
		end)
	end

	local height = (#tokens > 0) and (line + 1) * lineHeight or 0
	container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, height)
	return height, buttons
end

return FlowText
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">PlayerList</string>
                <string name="Source"><![CDATA[-- Live race sidebar: avatar, name, placement, time, clicks, redos, temperature and current
-- page (when the host allows it). Rows are created once per player and updated in place;
-- re-ordering animates rows to their new slots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("WikiRaceShared").Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Anim = require(UI.Anim)
local TemperatureMeter = require(script.Parent.TemperatureMeter)
local Store = require(UI.Parent.Core.Store)

local PlayerList = {}
PlayerList.__index = PlayerList

local ROW_HEIGHT = 74
local MEDALS = { "🥇", "🥈", "🥉" }

function PlayerList.new(parent: GuiObject, props)
	props = props or {}
	local self = setmetatable({ rows = {}, cards = {}, onInspect = props.onInspect }, PlayerList)
	self.frame = Kit.scroll({
		Name = "PlayerList",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position,
		Parent = parent,
		bar = 4,
	})
	self.frame.AutomaticCanvasSize = Enum.AutomaticSize.None
	return self
end

function PlayerList:setPlayers(cards)
	for _, row in self.rows do
		row.frame:Destroy()
	end
	self.rows = {}
	self.cards = {}
	for index, card in cards do
		self.cards[card.userId] = card
		self:_row(card, index)
	end
	self.frame.CanvasSize = UDim2.fromOffset(0, #cards * (ROW_HEIGHT + 6))
end

function PlayerList:_row(card, index: number)
	local isMe = card.userId == Store.myUserId()
	local frame = Kit.panel({
		Name = tostring(card.userId),
		Size = UDim2.new(1, -8, 0, ROW_HEIGHT),
		Position = UDim2.fromOffset(0, (index - 1) * (ROW_HEIGHT + 6)),
		Parent = self.frame,
	}, nil, isMe and "surface2" or "surface")
	if isMe then
		Kit.stroke("accent", 1.5, 0.2).Parent = frame
	end
	local place = Kit.text({
		text = "",
		style = "h3",
		size = 18,
		align = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.fromOffset(4, 8),
		Parent = frame,
	})
	local avatar = Kit.avatar(card.userId, 40, card.look, { Parent = frame, Position = UDim2.fromOffset(32, 8) })
	Kit.nameBlock(card.displayName .. (isMe and " (you)" or ""), card.look, {
		Parent = frame,
		Size = UDim2.new(1, -150, 0, 40),
		style = "h3",
		nameSize = 15,
	}).Position =
		UDim2.fromOffset(80, 6)
	local status = Kit.text({
		text = "Racing…",
		style = "tiny",
		tone = "textDim",
		truncate = true,
		wrap = false,
		Size = UDim2.new(1, -90, 0, 16),
		Position = UDim2.fromOffset(80, 50),
		Parent = frame,
	})
	local stats = Kit.text({
		text = "",
		style = "tiny",
		tone = "textDim",
		align = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(70, 40),
		Position = UDim2.new(1, -78, 0, 6),
		Parent = frame,
	})
	stats.TextYAlignment = Enum.TextYAlignment.Top
	local chipHolder = Kit.frame({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(110, 20),
		Parent = frame,
	}, { Kit.list("x", 0, "Right", "Center") })
	if self.onInspect then
		Kit.hoverable(avatar, function()
			self.onInspect(card.userId)
		end)
	end
	self.rows[card.userId] =
		{ frame = frame, place = place, status = status, stats = stats, chipHolder = chipHolder, lastTemp = false }
end

-- rows: live standings from the server (already visibility-filtered).
function PlayerList:update(rows)
	for index, row in rows do
		local entry = self.rows[row.userId]
		if entry then
			Anim.tween(entry.frame, 0.35, { Position = UDim2.fromOffset(0, (index - 1) * (ROW_HEIGHT + 6)) })
			entry.place.Text = row.placement and (MEDALS[row.placement] or ("#" .. row.placement)) or ""
			entry.stats.Text = ("🖱 %d\n♻ %d%s"):format(
				row.clicks,
				row.redos,
				row.time and ("\n⏱ " .. Format.time(row.time)) or ""
			)
			local statusText
			if row.left then
				statusText = "🔌 Disconnected"
			elseif row.completed then
				statusText = "🏁 Finished in " .. Format.time(row.time)
			elseif row.gaveUp then
				statusText = "🏳️ Gave up"
			elseif row.page then
				statusText = "📄 " .. row.page
			else
				statusText = "🔎 Racing…"
			end
			entry.status.Text = statusText
			Theme.bind(
				entry.status,
				{ TextColor3 = row.completed and "success" or (row.gaveUp and "textFaint" or "textDim") }
			)
			local temp = row.temperature or false
			if temp ~= entry.lastTemp then
				entry.lastTemp = temp
				for _, child in entry.chipHolder:GetChildren() do
					if child:IsA("GuiObject") then
						child:Destroy()
					end
				end
				local chip = TemperatureMeter.chip(row.temperature or nil, entry.chipHolder, 1)
				if row.temperature then
					Anim.pop(chip, 1.2)
				end
			end
		end
	end
end

return PlayerList
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">TemperatureMeter</string>
                <string name="Source"><![CDATA[-- Hot/cold meter: Freezing → Cold → Warm → Hot → Burning → Completed.
-- Every transition animates color, glow, pulse speed, particles and sound. Burning escalates:
-- fast heartbeat pulse, embers, shake and a hook for the race screen's edge glow.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Temperature = require(Shared.Temperature)
local Catalog = require(Shared.Catalog)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Sound = require(UI.Parent.Core.Sound)

local TemperatureMeter = {}
TemperatureMeter.__index = TemperatureMeter

local LEVELS = { "Freezing", "Cold", "Warm", "Hot", "Burning" }

-- onState(state, info) is called after every transition (used for screen-edge glow).
function TemperatureMeter.new(parent: GuiObject, props)
	props = props or {}
	local self =
		setmetatable({ state = nil, onState = props.onState, effect = "meter_classic", stops = {} }, TemperatureMeter)

	local root = Kit.panel({
		Name = "TemperatureMeter",
		Size = props.Size or UDim2.fromOffset(330, 60),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.order or 0,
		ClipsDescendants = false,
		Parent = parent,
	})
	self.frame = root
	self.scale = Anim.scaleOf(root)
	self.glow = Kit.stroke(Color3.new(1, 1, 1), 2, 0.4)
	self.glow.Name = "Glow"
	self.glow.Parent = root

	self.particles = Kit.frame({
		Name = "Particles",
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		ZIndex = 3,
		Parent = root,
	})

	self.label = Kit.text({
		text = "🧊 FREEZING",
		style = "h2",
		font = "fontHeavy",
		size = 19,
		Size = UDim2.new(0.5, -8, 0, 24),
		Position = UDim2.fromOffset(12, 7),
		Parent = root,
		ZIndex = 4,
	})
	self.blurb = Kit.text({
		text = "",
		style = "tiny",
		tone = "textDim",
		truncate = true,
		wrap = false,
		Size = UDim2.new(1, -24, 0, 14),
		Position = UDim2.fromOffset(12, 38),
		Parent = root,
		ZIndex = 4,
	})

	local track = Kit.frame({
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.new(0.5, -8, 0, 16),
		Parent = root,
		ZIndex = 4,
	}, { Kit.list("x", 4, "Left", "Center") })
	self.segments = {}
	for index, key in LEVELS do
		local info = Temperature.Info[key]
		local segment = Kit.make("Frame", {
			Name = key,
			Size = UDim2.new(0.2, -4, 1, 0),
			BackgroundColor3 = info.color,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			LayoutOrder = index,
			ZIndex = 4,
			Parent = track,
		}, { Kit.round() })
		self.segments[key] = segment
	end

	self:set("Freezing", false)
	return self
end

function TemperatureMeter:setEffect(itemId: string?)
	self.effect = itemId or "meter_classic"
	if self.state then
		local state = self.state
		self.state = nil
		self:set(state, false)
	end
end

function TemperatureMeter:_stopLoops()
	for _, stop in self.stops do
		stop()
	end
	table.clear(self.stops)
	self.scale.Scale = 1
end

function TemperatureMeter:set(state: string, animate: boolean?)
	if not Temperature.isValid(state) or state == self.state then
		return
	end
	local previous = self.state
	self.state = state
	local info = Temperature.Info[state]
	local level = info.level
	local previousLevel = previous and Temperature.level(previous) or level
	local cosmetic = Catalog.ById[self.effect]
	animate = animate ~= false

	self.label.Text = info.emoji .. " " .. string.upper(info.label)
	self.blurb.Text = info.blurb
	Anim.tween(self.label, animate and 0.4 or 0, { TextColor3 = info.color })
	Anim.tween(self.glow, animate and 0.4 or 0, { Color = info.color, Thickness = 1.5 + info.intensity * 3 })
	for key, segment in self.segments do
		local on = Temperature.level(key) <= math.min(level, 5)
		Anim.tween(
			segment,
			animate and 0.35 or 0,
			{ BackgroundTransparency = on and 0 or 0.8, Size = UDim2.new(0.2, -4, on and 1 or 0.7, 0) }
		)
	end

	self:_stopLoops()
	table.insert(self.stops, Anim.pulse(self.glow, "Transparency", 0.1, 0.1 + (1 - info.intensity) * 0.7, info.pulse))
	if state == "Burning" then
		table.insert(self.stops, Anim.pulse(self.scale, "Scale", 1, 1.045, info.pulse))
		table.insert(self.stops, Sound.loop("heartbeat", { volume = 0.8 }))
	end

	-- Particles per state, flavored by the equipped meter cosmetic.
	local glyph = cosmetic and cosmetic.particle or nil
	if state == "Freezing" or state == "Cold" then
		table.insert(
			self.stops,
			Fx.emitter(self.particles, {
				glyph = glyph or "❄",
				colors = { info.glow, Color3.new(1, 1, 1) },
				direction = "down",
				rate = state == "Freezing" and 3 or 5,
				lifetime = 2.4,
				minSize = 8,
				maxSize = 12,
			})
		)
	elseif state == "Hot" then
		table.insert(
			self.stops,
			Fx.emitter(self.particles, {
				glyph = glyph,
				colors = { info.color, info.glow },
				rate = 10,
				lifetime = 1.2,
			})
		)
	elseif state == "Burning" then
		table.insert(
			self.stops,
			Fx.emitter(self.particles, {
				glyph = glyph,
				colors = { info.color, info.glow, Color3.fromRGB(255, 240, 150) },
				rate = 26,
				lifetime = 0.9,
				minSize = 5,
				maxSize = 11,
			})
		)
	end

	if animate and previous then
		if level > previousLevel then
			Sound.play(
				state == "Burning" and "burning" or (state == "Completed" and "complete" or "tempUp"),
				{ pitch = 0.9 + level * 0.08 }
			)
			Anim.pop(self.frame, state == "Burning" and 1.22 or 1.1)
			Fx.flash(self.frame, info.glow, 0.45, state == "Burning" and 0.9 or 0.5)
			if state == "Burning" then
				Anim.shake(self.frame, 6, 0.6)
				Fx.burst(self.frame, {
					count = 22,
					colors = { info.color, info.glow },
					glyphs = { "🔥", "✦" },
					minDistance = 30,
					maxDistance = 120,
					gravity = -20,
				})
			elseif state == "Completed" then
				Fx.burst(self.frame, { count = 30, minDistance = 40, maxDistance = 180 })
			end
		elseif level < previousLevel then
			Sound.play(level <= 2 and "freeze" or "tempDown", { pitch = 0.8 + level * 0.05 })
			Anim.pop(self.frame, 0.94)
		end
	end
	if self.onState then
		self.onState(state, info)
	end
end

function TemperatureMeter:destroy()
	self:_stopLoops()
	self.frame:Destroy()
end

-- Small chip used in player lists.
function TemperatureMeter.chip(state: string?, parent: Instance?, order: number?)
	local info = state and Temperature.Info[state]
	local chip = Kit.chip(
		info and (info.emoji .. " " .. info.label) or "❔ Hidden",
		info and info.color or nil,
		{ Parent = parent, order = order, height = 20, textSize = 11 }
	)
	return chip
end

return TemperatureMeter
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">WikiBrowser</string>
                <string name="Source"><![CDATA[-- The in-game encyclopedia browser: toolbar (back / forward / refresh / address / history /
-- search / random), article with inline links, infobox with image, see-also, categories,
-- page-history popover, loading bar and error state. Used by races and Free Roam.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Categories = require(Shared.Categories)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Anim = require(UI.Anim)
local FlowText = require(script.Parent.FlowText)
local Sound = require(UI.Parent.Core.Sound)
local Store = require(UI.Parent.Core.Store)

local WikiBrowser = {}
WikiBrowser.__index = WikiBrowser

local INFOBOX_WIDTH = 270
local GAP = 22
local BODY_SIZE = 17
local NARROW = 620

-- opts: { mode = "race"|"free", onLink(id), onBack(), onForward(), onRefresh(), onHistory(id),
--         onRandom(), onSearch(query, callback(results)), onOpen(id), onCategory(name), transition }
function WikiBrowser.new(parent: GuiObject, opts)
	local self = setmetatable({
		opts = opts,
		mode = opts.mode or "race",
		interactive = true,
		visited = {},
		transition = opts.transition or "transition_fade",
	}, WikiBrowser)

	local root = Kit.panel({
		Name = "WikiBrowser",
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		Parent = parent,
		Theme = {
			BackgroundColor3 = "article",
			BackgroundTransparency = function()
				return 0
			end,
		},
	})
	self.frame = root

	-- Scale probe: converts AbsoluteSize (screen px) back into design units for text layout.
	self.probe = Kit.frame({ Name = "ScaleProbe", Size = UDim2.fromOffset(100, 1), Parent = root })

	-- Toolbar ----------------------------------------------------------------------------
	local toolbar = Kit.make("Frame", {
		Name = "Toolbar",
		Size = UDim2.new(1, 0, 0, 52),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = root,
		Theme = { BackgroundColor3 = "surface2" },
	}, { Kit.padding(6, 10, 6, 10), Kit.list("x", 6, "Left", "Center") })
	Kit.make("Frame", {
		Name = "ToolbarBorder",
		Position = UDim2.new(0, 0, 0, 52),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = root,
		Theme = { BackgroundColor3 = "border" },
	})

	self.backButton = Kit.iconButton("◀", function()
		if opts.onBack then
			opts.onBack()
		end
	end, { Parent = toolbar, order = 1, Size = UDim2.fromOffset(40, 38) })
	self.forwardButton = Kit.iconButton("▶", function()
		if opts.onForward then
			opts.onForward()
		end
	end, { Parent = toolbar, order = 2, Size = UDim2.fromOffset(40, 38) })
	self.refreshButton = Kit.iconButton("⟳", function()
		if opts.onRefresh then
			opts.onRefresh()
		end
	end, { Parent = toolbar, order = 3, Size = UDim2.fromOffset(40, 38) })

	local address = Kit.make("Frame", {
		Name = "Address",
		Size = UDim2.new(1, self.mode == "free" and -430 or -214, 0, 38),
		LayoutOrder = 4,
		BorderSizePixel = 0,
		Parent = toolbar,
		Theme = { BackgroundColor3 = "surface" },
	}, { Kit.round(), Kit.padding(0, 14, 0, 14) })
	Kit.stroke("border", 1, 0.4).Parent = address
	self.addressLabel = Kit.text({
		text = "🔒 wiki/",
		style = "small",
		tone = "textDim",
		truncate = true,
		wrap = false,
		Size = UDim2.fromScale(1, 1),
		font = "fontMono",
		Parent = address,
	})
	self.redoBadge = Kit.chip("♻ 0", nil, { Parent = toolbar, order = 5, height = 30 })
	self.historyButton = Kit.iconButton("🕘", function()
		self:toggleHistory()
	end, { Parent = toolbar, order = 6, Size = UDim2.fromOffset(44, 38) })

	if self.mode == "free" then
		self.searchBox = Kit.input({
			placeholder = "🔍 Search the wiki",
			Size = UDim2.fromOffset(170, 38),
			order = 7,
			textSize = 15,
			Parent = toolbar,
		})
		local searchToken = 0
		self.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			searchToken += 1
			local token = searchToken
			local query = self.searchBox.Text
			task.delay(0.25, function()
				if token ~= searchToken then
					return
				end
				if #query < 2 then
					self:showSearchResults(nil)
					return
				end
				opts.onSearch(query, function(results)
					if token == searchToken then
						self:showSearchResults(results)
					end
				end)
			end)
		end)
		Kit.iconButton("🎲", function()
			opts.onRandom()
		end, { Parent = toolbar, order = 8, Size = UDim2.fromOffset(44, 38) })
		self.redoBadge.Visible = false
	end

	-- Loading bar ------------------------------------------------------------------------
	self.loadingBar = Kit.make("Frame", {
		Name = "LoadingBar",
		Position = UDim2.new(0, 0, 0, 52),
		Size = UDim2.new(0, 0, 0, 3),
		BorderSizePixel = 0,
		ZIndex = 8,
		Visible = false,
		Parent = root,
		Theme = { BackgroundColor3 = "accent" },
	})

	-- Content ----------------------------------------------------------------------------
	self.scroll = Kit.make("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.new(0, 0, 0, 53),
		Size = UDim2.new(1, 0, 1, -53),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 7,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = root,
		Theme = { ScrollBarImageColor3 = "textFaint" },
	})
	self.content = Kit.frame({
		Name = "Page",
		Size = UDim2.new(1, -56, 0, 0),
		Position = UDim2.fromOffset(28, 22),
		Parent = self.scroll,
	})
	self.contentScale = Anim.scaleOf(self.content)

	self.cover = Kit.make("Frame", {
		Name = "Cover",
		Position = UDim2.new(0, 0, 0, 53),
		Size = UDim2.new(1, 0, 1, -53),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = root,
		Theme = { BackgroundColor3 = "article" },
	})

	-- Error card
	self.errorCard = Kit.panel({
		Name = "Error",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 170),
		Visible = false,
		ZIndex = 30,
		Parent = root,
	}, { Kit.padding(18), Kit.list("y", 10, "Center", "Center") })
	self.errorText = Kit.text({
		text = "",
		style = "body",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 60),
		Parent = self.errorCard,
		order = 1,
		ZIndex = 31,
	})
	self.errorRetry = Kit.button({
		text = "Retry",
		emoji = "⟳",
		variant = "primary",
		Parent = self.errorCard,
		order = 2,
		ZIndex = 31,
		onClick = function()
			self.errorCard.Visible = false
			if self.retry then
				self.retry()
			end
		end,
	})

	-- Dropdown panels (history, page history, search results)
	self.dropdown = Kit.panel({
		Name = "Dropdown",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 56),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 40,
		Parent = root,
	}, { Kit.padding(10), Kit.list("y", 4) })

	self.probe:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_scheduleLayout()
	end)
	self.scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_scheduleLayout()
	end)

	self:setNav({ canBack = false, canForward = false, history = {}, redosLeft = -1 })
	return self
end

function WikiBrowser:_unitScale(): number
	local scale = self.probe.AbsoluteSize.X / 100
	return scale > 0 and scale or 1
end

function WikiBrowser:_scheduleLayout()
	if self.layoutPending then
		return
	end
	self.layoutPending = true
	task.delay(0.08, function()
		self.layoutPending = false
		if self.page then
			self:_layout()
		end
	end)
end

function WikiBrowser:setInteractive(on: boolean)
	self.interactive = on
	for _, button in self.content:GetDescendants() do
		if button:IsA("TextButton") then
			button.Active = on
		end
	end
end

function WikiBrowser:setTransition(itemId: string)
	self.transition = itemId or "transition_fade"
end

function WikiBrowser:setNav(nav)
	self.nav = nav
	local redosLeft = nav.redosLeft or -1
	local backAllowed = nav.canBack
	Kit.setDisabled(self.backButton, not backAllowed)
	Kit.setDisabled(self.forwardButton, not nav.canForward)
	if self.mode == "race" then
		self.redoBadge.Visible = true
		self.redoBadge.Text = redosLeft < 0 and "♻ ∞" or ("♻ " .. redosLeft)
		Theme.bind(self.redoBadge, { BackgroundColor3 = redosLeft == 0 and "danger" or "surface3" })
	end
end

function WikiBrowser:setLoading(on: boolean)
	if on then
		self.loadingBar.Visible = true
		self.loadingBar.Size = UDim2.new(0, 0, 0, 3)
		Anim.tween(self.loadingBar, 0.9, { Size = UDim2.new(0.85, 0, 0, 3) }, Enum.EasingStyle.Quad)
	else
		Anim.tween(self.loadingBar, 0.12, { Size = UDim2.new(1, 0, 0, 3) })
		task.delay(0.15, function()
			self.loadingBar.Visible = false
		end)
	end
end

function WikiBrowser:showError(message: string, retry)
	self.errorText.Text = "⚠️ " .. message
	self.retry = retry
	self.errorRetry.Visible = retry ~= nil
	self.errorCard.Visible = true
	Anim.punchIn(self.errorCard, 0.85)
end

function WikiBrowser:_closeDropdown()
	self.dropdown.Visible = false
	self.dropdownKind = nil
end

function WikiBrowser:_openDropdown(kind: string, build)
	if self.dropdownKind == kind and self.dropdown.Visible then
		self:_closeDropdown()
		return
	end
	for _, child in self.dropdown:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	build(self.dropdown)
	self.dropdownKind = kind
	self.dropdown.Visible = true
	Anim.punchIn(self.dropdown, 0.92)
end

-- How many rows a horizontally wrapping list of items occupies.
local function wrapRows(widths, maxWidth: number, gap: number): number
	local rows, x = 1, 0
	for _, w in widths do
		if x > 0 and x + w > maxWidth then
			rows += 1
			x = 0
		end
		x += w + gap
	end
	return rows
end

local function dropdownRow(parent, text: string, order: number, onClick)
	local row = Kit.button({
		text = text,
		variant = "ghost",
		textSize = 14,
		Size = UDim2.new(1, 0, 0, 32),
		order = order,
		font = "font",
		Parent = parent,
		onClick = onClick,
		ZIndex = 41,
	})
	row.TextXAlignment = Enum.TextXAlignment.Left
	Kit.padding(0, 10, 0, 10).Parent = row
	return row
end

function WikiBrowser:toggleHistory()
	local history = (self.nav and self.nav.history) or {}
	self:_openDropdown("history", function(panel)
		Kit.text({ text = "Recently visited", style = "h3", Parent = panel, order = 0, ZIndex = 41 })
		if self.mode == "race" then
			Kit.text({
				text = "Jumping back uses 1 redo.",
				style = "tiny",
				tone = "textFaint",
				Parent = panel,
				order = 1,
				ZIndex = 41,
			})
		end
		local current = self.page and self.page.id
		for index, id in history do
			if id ~= current then
				dropdownRow(panel, "📄 " .. Store.titleOf(id), index + 1, function()
					self:_closeDropdown()
					if self.opts.onHistory then
						self.opts.onHistory(id)
					end
				end)
			end
		end
		if #history <= 1 then
			Kit.text({
				text = "Nothing yet — start clicking links!",
				style = "small",
				tone = "textDim",
				Parent = panel,
				order = 99,
				ZIndex = 41,
			})
		end
	end)
end

function WikiBrowser:showPageHistory()
	local page = self.page
	if not page then
		return
	end
	self:_openDropdown("revisions", function(panel)
		Kit.text({ text = "📝 Revision history", style = "h3", Parent = panel, order = 0, ZIndex = 41 })
		Kit.text({
			text = ("%d revisions · %d words · %d links out · %d links in"):format(
				page.meta.revisions,
				page.meta.words,
				page.meta.linksOut,
				page.meta.linksIn
			),
			style = "tiny",
			tone = "textFaint",
			Parent = panel,
			order = 1,
			ZIndex = 41,
		})
		for index, revision in page.history do
			Kit.text({
				text = ('<b>#%d</b> · %s · <font transparency="0.3">%s</font>\n%s'):format(
					revision.revision,
					revision.when,
					revision.editor,
					revision.note
				),
				rich = true,
				style = "small",
				Size = UDim2.new(1, 0, 0, 38),
				Parent = panel,
				order = index + 1,
				ZIndex = 41,
			})
		end
	end)
end

function WikiBrowser:showSearchResults(results)
	if not results then
		if self.dropdownKind == "search" then
			self:_closeDropdown()
		end
		return
	end
	self.dropdownKind = nil
	self:_openDropdown("search", function(panel)
		if #results == 0 then
			Kit.text({
				text = "No pages found.",
				style = "small",
				tone = "textDim",
				Parent = panel,
				order = 1,
				ZIndex = 41,
			})
		end
		for index, result in results do
			local label = result.emoji .. "  " .. result.title
			if result.redirectFrom then
				label ..= "  ↪ " .. result.redirectFrom
			end
			dropdownRow(panel, label, index, function()
				self:_closeDropdown()
				self.searchBox.Text = ""
				self.opts.onOpen(result.id)
			end)
		end
	end)
end

-- Renders a page payload with the equipped transition. direction: "forward"|"back"|"none"
function WikiBrowser:setPage(page, direction: string?)
	self.errorCard.Visible = false
	self:_closeDropdown()
	local changed = not self.page or self.page.id ~= page.id
	self.page = page
	self.visited[page.id] = true
	Store.rememberTitle(page.id, page.title)
	for _, related in page.related or {} do
		Store.rememberTitle(related.id, related.title)
	end
	self.addressLabel.Text = "🔒 wiki/" .. page.title:gsub(" ", "_")
	self:_layout()
	if changed then
		self.scroll.CanvasPosition = Vector2.zero
		self:_playTransition(direction or "forward")
	end
end

function WikiBrowser:_playTransition(direction: string)
	self.cover.BackgroundTransparency = 0.05
	Anim.tween(self.cover, 0.22, { BackgroundTransparency = 1 })
	local kind = self.transition
	local sign = direction == "back" and -1 or 1
	if kind == "transition_slide" then
		self.content.Position = UDim2.fromOffset(28 + 60 * sign, 22)
		Anim.tween(self.content, 0.28, { Position = UDim2.fromOffset(28, 22) })
	elseif kind == "transition_zoom" then
		self.contentScale.Scale = 0.94
		Anim.tween(self.contentScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	elseif kind == "transition_flip" then
		self.content.Rotation = -4 * sign
		self.contentScale.Scale = 1.04
		Anim.tween(self.content, 0.3, { Rotation = 0 }, Enum.EasingStyle.Back)
		Anim.tween(self.contentScale, 0.3, { Scale = 1 })
	end
end

function WikiBrowser:_onLink(pageId: string, button: TextButton, group)
	if not self.interactive or not self.opts.onLink then
		return
	end
	for _, member in group or { button } do
		Anim.pop(member, 1.15)
	end
	Sound.play("link")
	self.opts.onLink(pageId)
end

function WikiBrowser:_textStyle(size: number?)
	local t = Theme.current
	return {
		font = t.fontBody,
		boldFont = t.fontBodyBold,
		size = size or BODY_SIZE,
		color = t.articleText,
		linkColor = t.link,
		linkHover = t.linkHover,
		visited = self.visited,
		interactive = self.interactive,
	}
end

function WikiBrowser:_layout()
	local page = self.page
	local content = self.content
	for _, child in content:GetChildren() do
		if not child:IsA("UIScale") then
			child:Destroy()
		end
	end
	local unit = self:_unitScale()
	local width = math.floor(self.scroll.AbsoluteSize.X / unit) - 56 - 8
	if width < 60 then
		return
	end
	local narrow = width < NARROW
	local t = Theme.current
	local categoryInfo = Categories.get(page.category)
	local y = 0
	local onLink = function(id, button, group)
		self:_onLink(id, button, group)
	end

	-- Title block
	local titleSize = narrow and 28 or 34
	local titleLines = math.max(1, math.ceil(FlowText.measure(page.title, t.fontHeading, titleSize) / width))
	local titleHeight = titleLines * (titleSize + 10)
	local title = Kit.text({
		text = page.title,
		style = "title",
		size = titleSize,
		font = "fontHeading",
		Size = UDim2.new(1, 0, 0, titleHeight),
		Parent = content,
	})
	Theme.bind(title, { TextColor3 = "heading" })
	title.Position = UDim2.fromOffset(0, y)
	title.TextWrapped = true
	y += titleHeight + 2
	local subtitle = Kit.text({
		text = "From Wiki Race, the free encyclopedia",
		style = "small",
		tone = "textFaint",
		Size = UDim2.new(1, 0, 0, 18),
		Parent = content,
	})
	subtitle.Position = UDim2.fromOffset(0, y)
	y += 24

	local meta = Kit.frame(
		{ Name = "Meta", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 26), Parent = content },
		{ Kit.list("x", 6, "Left", "Center") }
	)
	Kit.chip(categoryInfo.emoji .. " " .. page.category, categoryInfo.color, { Parent = meta, order = 1 })
	Kit.chip(("🔗 %d links"):format(page.meta.linksOut), nil, { Parent = meta, order = 2 })
	local historyChip = Kit.chip(
		("📝 %d revisions · updated %s"):format(page.meta.revisions, page.meta.updated),
		nil,
		{ Parent = meta, order = 3 }
	)
	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.Parent = historyChip
	hit.Activated:Connect(function()
		Sound.play("click")
		self:showPageHistory()
	end)
	y += 36
	local rule = Kit.divider()
	rule.Position = UDim2.fromOffset(0, y)
	rule.Parent = content
	y += 14

	-- Infobox
	local infoboxWidth = narrow and width or INFOBOX_WIDTH
	local infobox = Kit.make("Frame", {
		Name = "Infobox",
		Size = UDim2.fromOffset(infoboxWidth, 0),
		BorderSizePixel = 0,
		Parent = content,
		Theme = { BackgroundColor3 = "infobox" },
	}, { Kit.corner() })
	Kit.stroke("border", 1, 0.3).Parent = infobox
	local iy = 10
	local heading = Kit.text({
		text = page.title,
		style = "h3",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 0, 24),
		Parent = infobox,
	})
	heading.Position = UDim2.fromOffset(10, iy)
	iy += 30
	local imageHeight = narrow and 120 or 160
	local imageFrame
	if page.image then
		imageFrame = Kit.make("ImageLabel", {
			Image = page.image,
			ScaleType = Enum.ScaleType.Crop,
			BackgroundColor3 = categoryInfo.color,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -20, 0, imageHeight),
			Position = UDim2.fromOffset(10, iy),
			Parent = infobox,
		}, { Kit.corner() })
	else
		imageFrame = Kit.make("Frame", {
			BackgroundColor3 = categoryInfo.color,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -20, 0, imageHeight),
			Position = UDim2.fromOffset(10, iy),
			Parent = infobox,
		}, { Kit.corner() })
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(categoryInfo.color, categoryInfo.color:Lerp(Color3.new(0, 0, 0), 0.45))
		gradient.Rotation = 60
		gradient.Parent = imageFrame
		Kit.make("TextLabel", {
			BackgroundTransparency = 1,
			Text = page.emoji or categoryInfo.emoji,
			TextScaled = true,
			Size = UDim2.fromScale(0.5, 0.62),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Font = Enum.Font.GothamBold,
			TextColor3 = Color3.new(1, 1, 1),
			Parent = imageFrame,
		})
	end
	iy += imageHeight + 6
	local caption = Kit.text({
		text = page.category,
		style = "tiny",
		tone = "textFaint",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 0, 16),
		Parent = infobox,
	})
	caption.Position = UDim2.fromOffset(10, iy)
	iy += 22
	local labelWidth = math.floor((infoboxWidth - 20) * 0.38)
	for _, row in page.infobox do
		local label = Kit.text({
			text = row.label,
			style = "tiny",
			font = "fontBold",
			Size = UDim2.fromOffset(labelWidth, 18),
			Parent = infobox,
		})
		label.Position = UDim2.fromOffset(10, iy)
		label.TextYAlignment = Enum.TextYAlignment.Top
		local valueFrame = Kit.frame({
			Position = UDim2.fromOffset(10 + labelWidth + 6, iy),
			Size = UDim2.fromOffset(infoboxWidth - labelWidth - 26, 0),
			Parent = infobox,
		})
		local height =
			FlowText.render(valueFrame, row.runs, self:_textStyle(14), infoboxWidth - labelWidth - 26, onLink)
		iy += math.max(20, height) + 6
	end
	iy += 6
	infobox.Size = UDim2.fromOffset(infoboxWidth, iy)

	-- Article column
	local columnX = 0
	local columnWidth = width
	local articleTop = y
	if narrow then
		infobox.Position = UDim2.fromOffset(0, y)
		articleTop = y + iy + 16
	else
		infobox.Position = UDim2.fromOffset(width - infoboxWidth, y)
		columnWidth = width - infoboxWidth - GAP
	end
	local ay = articleTop
	local function paragraph(runs)
		local holder = Kit.frame({
			Position = UDim2.fromOffset(columnX, ay),
			Size = UDim2.fromOffset(columnWidth, 0),
			Parent = content,
		})
		local height = FlowText.render(holder, runs, self:_textStyle(), columnWidth, onLink)
		ay += height + 12
	end
	paragraph(page.summary)
	for _, section in page.sections do
		ay += 6
		local sectionTitle = Kit.text({
			text = section.heading,
			style = "h2",
			size = 22,
			font = "fontHeading",
			Size = UDim2.fromOffset(columnWidth, 30),
			Parent = content,
		})
		Theme.bind(sectionTitle, { TextColor3 = "heading" })
		sectionTitle.Position = UDim2.fromOffset(columnX, ay)
		ay += 32
		local line = Kit.divider()
		line.Size = UDim2.fromOffset(columnWidth, 1)
		line.Position = UDim2.fromOffset(columnX, ay)
		line.Parent = content
		ay += 10
		for _, runs in section.paragraphs do
			paragraph(runs)
		end
	end
	local bottom = math.max(ay, narrow and ay or (y + iy))

	-- See also
	if page.related and #page.related > 0 then
		bottom += 10
		local seeAlso = Kit.text({
			text = "See also",
			style = "h2",
			size = 20,
			font = "fontHeading",
			Size = UDim2.fromOffset(width, 28),
			Parent = content,
		})
		Theme.bind(seeAlso, { TextColor3 = "heading" })
		seeAlso.Position = UDim2.fromOffset(0, bottom)
		bottom += 34
		local row = Kit.frame({
			Position = UDim2.fromOffset(0, bottom),
			Size = UDim2.fromOffset(width, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = content,
		})
		local layout = Kit.list("x", 8, "Left", "Top")
		layout.Wraps = true
		layout.Parent = row
		for index, related in page.related do
			local chip = Kit.button({
				text = related.emoji .. "  " .. related.title,
				variant = "secondary",
				textSize = 14,
				font = "fontBold",
				Size = UDim2.fromOffset(
					FlowText.measure(related.emoji .. "  " .. related.title, t.fontBold, 14) + 36,
					34
				),
				order = index,
				Parent = row,
				sound = false,
				onClick = function(button)
					self:_onLink(related.id, button)
				end,
			})
			Theme.bind(chip, { TextColor3 = "link" })
			chip.Active = self.interactive
		end
		local widths = {}
		for _, related in page.related do
			table.insert(widths, FlowText.measure(related.emoji .. "  " .. related.title, t.fontBold, 14) + 36)
		end
		bottom += wrapRows(widths, width, 8) * 42 + 6
	end

	-- Categories
	bottom += 12
	local catBox = Kit.make("Frame", {
		Name = "Categories",
		Position = UDim2.fromOffset(0, bottom),
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = content,
		Theme = { BackgroundColor3 = "surface2" },
	}, { Kit.corner(), Kit.padding(8, 10, 8, 10) })
	local catLayout = Kit.list("x", 6, "Left", "Center")
	catLayout.Wraps = true
	catLayout.Parent = catBox
	Kit.text({
		text = "Categories:",
		style = "tiny",
		font = "fontBold",
		Size = UDim2.fromOffset(78, 24),
		Parent = catBox,
		order = 0,
	})
	for index, name in page.categories do
		local chip = Kit.chip(name, nil, { Parent = catBox, order = index })
		if self.mode == "free" and self.opts.onCategory then
			local button = Instance.new("TextButton")
			button.BackgroundTransparency = 1
			button.Text = ""
			button.Size = UDim2.fromScale(1, 1)
			button.Parent = chip
			button.Activated:Connect(function()
				Sound.play("click")
				self.opts.onCategory(name)
			end)
			Theme.bind(chip, { TextColor3 = "link" })
		end
	end
	local catWidths = { 78 }
	for _, name in page.categories do
		table.insert(catWidths, FlowText.measure(name, t.fontBold, 13) + 20)
	end
	bottom += wrapRows(catWidths, width - 20, 6) * 30 + 22

	content.Size = UDim2.new(1, -56, 0, bottom)
	self.scroll.CanvasSize = UDim2.fromOffset(0, (bottom + 60) * 1)
	self:setInteractive(self.interactive)
end

function WikiBrowser:destroy()
	self.frame:Destroy()
end

return WikiBrowser
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Fx</string>
              <string name="Source"><![CDATA[-- Lightweight 2D visual effects built from GuiObjects: bursts, confetti, rain, embers, screen
-- flashes, vignettes and camera blur. Particle counts are capped and halved on Reduced Motion.

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Anim = require(script.Parent.Anim)

local Fx = {}

local CONFETTI_COLORS = {
	Color3.fromRGB(239, 68, 68),
	Color3.fromRGB(250, 204, 21),
	Color3.fromRGB(34, 197, 94),
	Color3.fromRGB(59, 130, 246),
	Color3.fromRGB(168, 85, 247),
	Color3.fromRGB(236, 72, 153),
}

local function count(n: number): number
	return Anim.reduced and math.ceil(n * 0.35) or n
end

local function particle(parent: Instance, glyph: string?, color: Color3, size: number)
	local p
	if glyph then
		p = Instance.new("TextLabel")
		p.Text = glyph
		p.TextColor3 = color
		p.TextScaled = true
		p.Font = Enum.Font.GothamBold
		p.BackgroundTransparency = 1
	else
		p = Instance.new("Frame")
		p.BackgroundColor3 = color
		p.BorderSizePixel = 0
	end
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.Size = UDim2.fromOffset(size, glyph and size or size * 0.6)
	p.ZIndex = 50
	p.Parent = parent
	return p
end

-- Radial burst from a point (scale coordinates inside parent).
function Fx.burst(parent: GuiObject, options)
	options = options or {}
	local origin = options.origin or UDim2.fromScale(0.5, 0.5)
	for _ = 1, count(options.count or 24) do
		local color = options.colors and options.colors[math.random(1, #options.colors)]
			or CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)]
		local glyph = options.glyphs and options.glyphs[math.random(1, #options.glyphs)] or nil
		local p = particle(parent, glyph, color, math.random(options.minSize or 8, options.maxSize or 16))
		p.Position = origin
		p.Rotation = math.random(0, 360)
		local angle = math.random() * math.pi * 2
		local distance = math.random(options.minDistance or 80, options.maxDistance or 260)
		local lifetime = (options.lifetime or 1.1) * (0.7 + math.random() * 0.6)
		local target = origin
			+ UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance + (options.gravity or 60))
		Anim.tween(
			p,
			lifetime,
			{ Position = target, Rotation = p.Rotation + math.random(-360, 360) },
			Enum.EasingStyle.Quad
		)
		if p:IsA("TextLabel") then
			Anim.tween(p, lifetime, { TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		else
			Anim.tween(p, lifetime, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.delay(lifetime + 0.05, function()
			p:Destroy()
		end)
	end
end

-- Things falling from the top edge for `duration` seconds (confetti, emoji rain, coins…).
function Fx.rain(parent: GuiObject, options)
	options = options or {}
	local duration = options.duration or 3
	local rate = count(options.rate or 18)
	local stopped = false
	task.spawn(function()
		local started = os.clock()
		while not stopped and os.clock() - started < duration and parent.Parent do
			for _ = 1, math.max(1, math.floor(rate / 10)) do
				local color = options.colors and options.colors[math.random(1, #options.colors)]
					or CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)]
				local glyph = options.glyphs and options.glyphs[math.random(1, #options.glyphs)] or nil
				local size = math.random(options.minSize or 10, options.maxSize or 18)
				local p = particle(parent, glyph, color, size)
				local x = math.random()
				p.Position = UDim2.new(x, 0, 0, -30)
				p.Rotation = math.random(0, 360)
				local fall = (options.fallTime or 2.4) * (0.75 + math.random() * 0.5)
				Anim.tween(p, fall, {
					Position = UDim2.new(x + (math.random() - 0.5) * 0.15, 0, 1, 40),
					Rotation = p.Rotation + math.random(-540, 540),
				}, Enum.EasingStyle.Linear)
				task.delay(fall, function()
					p:Destroy()
				end)
			end
			task.wait(0.1)
		end
	end)
	return function()
		stopped = true
	end
end

-- Rising sparks/embers or drifting frost inside a region; returns stop().
function Fx.emitter(parent: GuiObject, options)
	local stopped = false
	task.spawn(function()
		while not stopped and parent.Parent do
			if parent.Visible ~= false then
				local color = options.colors[math.random(1, #options.colors)]
				local p =
					particle(parent, options.glyph, color, math.random(options.minSize or 4, options.maxSize or 9))
				local x = math.random()
				local rising = options.direction ~= "down"
				p.Position = UDim2.new(x, 0, rising and 1 or 0, 0)
				local life = (options.lifetime or 1.2) * (0.7 + math.random() * 0.6)
				local goal = {
					Position = UDim2.new(x + (math.random() - 0.5) * 0.2, 0, rising and -0.2 or 1.2, 0),
					Rotation = math.random(-180, 180),
				}
				if p:IsA("TextLabel") then
					goal.TextTransparency = 1
				else
					goal.BackgroundTransparency = 1
				end
				Anim.tween(p, life, goal, Enum.EasingStyle.Sine)
				task.delay(life, function()
					p:Destroy()
				end)
			end
			task.wait(1 / count(options.rate or 10))
		end
	end)
	return function()
		stopped = true
	end
end

-- Full-area color flash.
function Fx.flash(parent: GuiObject, color: Color3, seconds: number?, peak: number?)
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - (peak or 0.6)
	flash.BorderSizePixel = 0
	flash.ZIndex = 60
	flash.Parent = parent
	Anim.tween(flash, seconds or 0.5, { BackgroundTransparency = 1 })
	task.delay((seconds or 0.5) + 0.05, function()
		flash:Destroy()
	end)
end

-- Soft glow around the screen edges. Returns an object with :set(color, intensity) and :destroy().
function Fx.vignette(parent: GuiObject)
	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 40
	holder.Parent = parent
	local edges = {}
	local specs = {
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.78), -90 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0.84, 0), 180 },
	}
	for _, spec in specs do
		local edge = Instance.new("Frame")
		edge.Size = spec[1]
		edge.Position = spec[2]
		edge.BorderSizePixel = 0
		edge.BackgroundColor3 = Color3.new(1, 0, 0)
		edge.BackgroundTransparency = 1
		edge.ZIndex = 40
		edge.Parent = holder
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[3]
		gradient.Transparency = NumberSequence.new(0, 1)
		gradient.Parent = edge
		table.insert(edges, edge)
	end
	return {
		frame = holder,
		set = function(_, color: Color3, intensity: number, seconds: number?)
			for _, edge in edges do
				Anim.tween(
					edge,
					seconds or 0.5,
					{ BackgroundColor3 = color, BackgroundTransparency = 1 - math.clamp(intensity, 0, 1) }
				)
			end
		end,
		destroy = function()
			holder:Destroy()
		end,
	}
end

-- Camera blur (client-only Lighting effect).
local blur = nil
function Fx.blur(size: number, seconds: number?)
	if not blur or not blur.Parent then
		blur = Instance.new("BlurEffect")
		blur.Name = "WikiRaceBlur"
		blur.Size = 0
		blur.Parent = Lighting
	end
	Anim.tween(blur, seconds or 0.4, { Size = size })
end

-- Cursor trail cosmetic: glyphs that follow the mouse over a parent. Returns stop().
function Fx.cursorTrail(parent: GuiObject, glyph: string, color: Color3)
	local UserInputService = game:GetService("UserInputService")
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return function() end
	end
	local last = Vector2.zero
	local connection = RunService.RenderStepped:Connect(function()
		local position = UserInputService:GetMouseLocation() - parent.AbsolutePosition
		if (position - last).Magnitude < 14 then
			return
		end
		last = position
		local p = particle(parent, glyph, color, math.random(8, 14))
		p.ZIndex = 200
		p.Position = UDim2.fromOffset(position.X, position.Y)
		Anim.tween(
			p,
			0.6,
			{ TextTransparency = 1, Position = p.Position + UDim2.fromOffset(0, 18), Rotation = math.random(-90, 90) }
		)
		task.delay(0.65, function()
			p:Destroy()
		end)
	end)
	return function()
		connection:Disconnect()
	end
end

Fx.ConfettiColors = CONFETTI_COLORS

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Component kit. Small, themed building blocks shared by every screen.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Catalog = require(Shared.Catalog)
local Theme = require(script.Parent.Theme)
local Anim = require(script.Parent.Anim)
local Sound = require(script.Parent.Parent.Core.Sound)

local Kit = {}

local TEXT_SIZES = {
	display = 54,
	title = 34,
	h1 = 28,
	h2 = 21,
	h3 = 18,
	body = 16,
	small = 14,
	tiny = 12,
}

function Kit.make(className: string, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		elseif key == "Theme" then
			Theme.bind(instance, value)
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.corner(radius: number?)
	local corner = Instance.new("UICorner")
	if radius then
		corner.CornerRadius = UDim.new(0, radius)
	else
		Theme.bind(corner, {
			CornerRadius = function(t)
				return UDim.new(0, t.corner)
			end,
		})
	end
	return corner
end

function Kit.round()
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	return corner
end

function Kit.stroke(token: any, thickness: number?, transparency: number?)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Transparency = transparency or 0
	stroke.Thickness = thickness or 1
	if typeof(token) == "Color3" then
		stroke.Color = token
	else
		Theme.bind(stroke, { Color = token or "border" })
	end
	return stroke
end

function Kit.padding(top: number, right: number?, bottom: number?, left: number?)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right or top)
	padding.PaddingBottom = UDim.new(0, bottom or top)
	padding.PaddingLeft = UDim.new(0, left or right or top)
	return padding
end

function Kit.list(direction: string?, padding: number?, hAlign: string?, vAlign: string?)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction == "x" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, padding or 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment[hAlign or "Left"]
	layout.VerticalAlignment = Enum.VerticalAlignment[vAlign or "Top"]
	return layout
end

function Kit.grid(cell: UDim2, padding: number?)
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = cell
	layout.CellPadding = UDim2.fromOffset(padding or 10, padding or 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	return layout
end

function Kit.frame(props, children)
	props = props or {}
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	if props.BorderSizePixel == nil then
		props.BorderSizePixel = 0
	end
	return Kit.make("Frame", props, children)
end

-- A themed surface panel with rounded corners and a hairline border.
function Kit.panel(props, children, surfaceToken: string?)
	props = props or {}
	props.BorderSizePixel = 0
	local themeMap = props.Theme or {}
	themeMap.BackgroundColor3 = themeMap.BackgroundColor3 or surfaceToken or "surface"
	if themeMap.BackgroundTransparency == nil and props.BackgroundTransparency == nil then
		themeMap.BackgroundTransparency = "surfaceTransparency"
	end
	props.Theme = themeMap
	local panel = Kit.make("Frame", props, children)
	Kit.corner().Parent = panel
	local stroke = Kit.stroke("border", nil, 0.35)
	Theme.bind(stroke, {
		Thickness = "strokeThickness",
	})
	stroke.Parent = panel
	return panel
end

-- Text label. style: display/title/h1/h2/h3/body/small/tiny. tone: text/textDim/textFaint/accent…
function Kit.text(props)
	local style = props.style or "body"
	local tone = props.tone or "text"
	local fontToken = props.font
		or (style == "display" and "fontDisplay")
		or ((style == "title" or style == "h1") and "fontHeavy")
		or ((style == "h2" or style == "h3") and "fontBold")
		or "font"
	local label = Kit.make("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		Text = props.text or "",
		TextSize = props.size or TEXT_SIZES[style] or 16,
		TextXAlignment = props.align or Enum.TextXAlignment.Left,
		TextYAlignment = props.valign or Enum.TextYAlignment.Center,
		TextWrapped = props.wrap ~= false,
		TextTruncate = props.truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
		RichText = props.rich == true,
		Size = props.Size or UDim2.new(1, 0, 0, (props.size or TEXT_SIZES[style] or 16) + 6),
		AutomaticSize = props.auto or Enum.AutomaticSize.None,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.order or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
		Theme = { TextColor3 = tone, Font = fontToken },
	})
	if typeof(props.color) == "Color3" then
		Theme.unbind(label, "TextColor3")
		label.TextColor3 = props.color
	end
	return label
end

local VARIANTS = {
	primary = { bg = "accent", text = "accentText", strokeT = 1 },
	secondary = { bg = "surface2", text = "text", strokeT = 0.2 },
	ghost = { bg = "surface", text = "textDim", strokeT = 0.6, bgT = 1 },
	danger = {
		bg = "danger",
		text = function()
			return Color3.new(1, 1, 1)
		end,
		strokeT = 1,
	},
	success = {
		bg = "success",
		text = function()
			return Color3.new(1, 1, 1)
		end,
		strokeT = 1,
	},
	gold = {
		bg = "gold",
		text = function()
			return Color3.fromRGB(40, 28, 0)
		end,
		strokeT = 1,
	},
}

-- Button with hover/press feedback and click sound.
-- props: text, emoji, variant, Size, textSize, onClick, sound, order, Position, AnchorPoint
function Kit.button(props)
	local variant = VARIANTS[props.variant or "secondary"]
	local text = props.text or ""
	if props.emoji then
		text = props.emoji .. (text ~= "" and "  " .. text or "")
	end
	local button = Kit.make("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		Text = text,
		TextSize = props.textSize or 16,
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.order or 0,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
		TextWrapped = true,
		Parent = props.Parent,
		Theme = {
			BackgroundColor3 = variant.bg,
			TextColor3 = variant.text,
			Font = props.font or "fontBold",
		},
	})
	if variant.bgT then
		button.BackgroundTransparency = variant.bgT
	end
	button:SetAttribute("BaseTransparency", variant.bgT or 0)
	Kit.corner().Parent = button
	local stroke = Kit.stroke("border", 1, variant.strokeT)
	stroke.Parent = button
	local scale = Anim.scaleOf(button)
	local hovering = false
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		hovering = true
		Anim.tween(scale, 0.18, { Scale = 1.035 })
		Anim.tween(stroke, 0.18, { Transparency = math.max(0, variant.strokeT - 0.5) })
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Anim.tween(scale, 0.2, { Scale = 1 })
		Anim.tween(stroke, 0.2, { Transparency = variant.strokeT })
	end)
	button.MouseButton1Down:Connect(function()
		if not button:GetAttribute("Disabled") then
			Anim.tween(scale, 0.08, { Scale = 0.95 })
		end
	end)
	button.MouseButton1Up:Connect(function()
		Anim.tween(scale, 0.25, { Scale = hovering and 1.035 or 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") or button:GetAttribute("Busy") then
			Sound.play("error", { volume = 0.5 })
			return
		end
		if props.sound ~= false then
			Sound.play(props.sound or "click")
		end
		if props.onClick then
			props.onClick(button)
		end
	end)
	return button
end

function Kit.setDisabled(button: GuiButton, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	TweenService:Create(button, TweenInfo.new(0.2), {
		BackgroundTransparency = disabled and 0.55 or (button:GetAttribute("BaseTransparency") or 0),
		TextTransparency = disabled and 0.45 or 0,
	}):Play()
end

-- Shows a busy state on a button while an async action runs.
function Kit.busy(button: TextButton, busy: boolean, busyText: string?)
	if busy then
		button:SetAttribute("Busy", true)
		button:SetAttribute("IdleText", button.Text)
		button.Text = busyText or "…"
	else
		button:SetAttribute("Busy", false)
		local idle = button:GetAttribute("IdleText")
		if idle then
			button.Text = idle
		end
	end
end

function Kit.iconButton(emoji: string, onClick, props)
	props = props or {}
	props.text = emoji
	props.textSize = props.textSize or 20
	props.Size = props.Size or UDim2.fromOffset(42, 42)
	props.onClick = onClick
	props.variant = props.variant or "secondary"
	props.font = "font"
	return Kit.button(props)
end

function Kit.chip(text: string, color: Color3?, props)
	props = props or {}
	local chip = Kit.make("TextLabel", {
		Name = "Chip",
		Text = text,
		TextSize = props.textSize or 13,
		Size = UDim2.fromOffset(0, props.height or 24),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = props.order or 0,
		BorderSizePixel = 0,
		BackgroundColor3 = color or Color3.fromRGB(100, 116, 139),
		BackgroundTransparency = props.transparency or 0.15,
		TextColor3 = props.textColor or Color3.new(1, 1, 1),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Parent = props.Parent,
		Theme = { Font = "fontBold" },
	})
	if not color then
		Theme.bind(chip, { BackgroundColor3 = "surface3", TextColor3 = "text" })
	end
	Kit.round().Parent = chip
	Kit.padding(0, 10, 0, 10).Parent = chip
	return chip
end

-- Circular avatar headshot with an optional cosmetic frame ring.
function Kit.avatar(userId: number, size: number, look, props)
	props = props or {}
	local holder = Kit.frame({
		Name = "Avatar",
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = props.order or 0,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Parent = props.Parent,
	})
	local image = Kit.make("ImageLabel", {
		Name = "Image",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(math.max(1, userId)),
		ScaleType = Enum.ScaleType.Crop,
		Parent = holder,
		Theme = { BackgroundColor3 = "surface3" },
	}, { Kit.round() })
	Kit.applyFrame(image, look and look.frame or "frame_none", math.max(2, size / 22))
	return holder
end

-- Applies a profile-frame cosmetic (UIStroke + gradient) to a round image.
function Kit.applyFrame(image: GuiObject, frameId: string, thickness: number)
	local old = image:FindFirstChild("FrameStroke")
	if old then
		old:Destroy()
	end
	local item = Catalog.ById[frameId]
	if not item or frameId == "frame_none" then
		return
	end
	local stroke = Instance.new("UIStroke")
	stroke.Name = "FrameStroke"
	stroke.Thickness = thickness
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = image
	local gradient = Instance.new("UIGradient")
	if item.rainbow then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 0)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 100)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 180, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		})
	elseif item.colors then
		gradient.Color = ColorSequence.new(item.colors[1], item.colors[2])
	end
	gradient.Parent = stroke
	if item.animated then
		Anim.spin(gradient, 90)
	end
end

-- Displays a name with badge glyph + optional title underneath.
function Kit.nameBlock(displayName: string, look, props)
	props = props or {}
	local holder = Kit.frame({
		Name = "NameBlock",
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		LayoutOrder = props.order or 0,
		Parent = props.Parent,
	}, { Kit.list("y", 0, props.hAlign, "Center") })
	local badge = look and look.badge and (" " .. look.badge) or ""
	local nameLabel = Kit.text({
		text = displayName .. badge,
		style = props.style or "h3",
		size = props.nameSize,
		truncate = true,
		wrap = false,
		align = props.align,
		Parent = holder,
		order = 1,
	})
	if look and look.vip then
		Theme.bind(nameLabel, { TextColor3 = "gold" })
	end
	if look and look.title then
		Kit.text({
			text = look.title,
			style = "tiny",
			tone = "accent",
			truncate = true,
			wrap = false,
			align = props.align,
			Parent = holder,
			order = 2,
			Size = UDim2.new(1, 0, 0, 14),
		})
	end
	return holder
end

function Kit.input(props)
	local box = Kit.make("TextBox", {
		Name = props.Name or "Input",
		Text = props.text or "",
		PlaceholderText = props.placeholder or "",
		ClearTextOnFocus = false,
		TextSize = props.textSize or 16,
		TextXAlignment = props.align or Enum.TextXAlignment.Left,
		Size = props.Size or UDim2.new(1, 0, 0, 42),
		Position = props.Position,
		LayoutOrder = props.order or 0,
		BorderSizePixel = 0,
		Parent = props.Parent,
		Theme = {
			BackgroundColor3 = "surface2",
			TextColor3 = "text",
			PlaceholderColor3 = "textFaint",
			Font = props.font or "font",
		},
	})
	Kit.corner().Parent = box
	local stroke = Kit.stroke("border", 1, 0.3)
	stroke.Parent = box
	Kit.padding(0, 12, 0, 12).Parent = box
	box.Focused:Connect(function()
		Theme.bind(stroke, { Color = "accent" })
		stroke.Transparency = 0
	end)
	box.FocusLost:Connect(function(enter)
		Theme.bind(stroke, { Color = "border" })
		stroke.Transparency = 0.3
		if props.onSubmit and enter then
			props.onSubmit(box.Text)
		end
	end)
	if props.onChange then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			props.onChange(box.Text)
		end)
	end
	return box
end

function Kit.scroll(props, children)
	props = props or {}
	local scroll = Kit.make("ScrollingFrame", {
		Name = props.Name or "Scroll",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = props.bar or 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = props.axis == "x" and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		ScrollingDirection = props.axis == "x" and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y,
		LayoutOrder = props.order or 0,
		Parent = props.Parent,
		Theme = { ScrollBarImageColor3 = "textFaint" },
	}, children)
	return scroll
end

function Kit.divider(order: number?)
	return Kit.make("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.3,
		LayoutOrder = order or 0,
		Theme = { BackgroundColor3 = "border" },
	})
end

function Kit.spinner(size: number, parent: Instance?)
	local ring = Kit.make("Frame", {
		Name = "Spinner",
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local stroke = Kit.stroke("accent", math.max(2, size / 10), 0)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = ring
	Kit.round().Parent = ring
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.7, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = stroke
	Anim.spin(gradient, 360)
	return ring
end

-- Toggle switch. Returns { frame, set(value), get(), setEnabled(bool) }.
function Kit.toggle(initial: boolean, onChange, props)
	props = props or {}
	local value = initial
	local enabled = true
	local track = Kit.make("TextButton", {
		Name = "Toggle",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(52, 28),
		BorderSizePixel = 0,
		LayoutOrder = props.order or 0,
		Parent = props.Parent,
	}, { Kit.round() })
	local knob = Kit.make("Frame", {
		Size = UDim2.fromOffset(22, 22),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	}, { Kit.round() })
	local function render(animate)
		local goal = { Position = value and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }
		Theme.bind(track, { BackgroundColor3 = value and "success" or "surface3" })
		if animate then
			Anim.tween(knob, 0.2, goal, Enum.EasingStyle.Back)
		else
			knob.Position = goal.Position
		end
		track.BackgroundTransparency = enabled and 0 or 0.5
	end
	render(false)
	track.Activated:Connect(function()
		if not enabled then
			Sound.play("error", { volume = 0.4 })
			return
		end
		value = not value
		Sound.play("click", { pitch = value and 1.2 or 0.9 })
		render(true)
		if onChange then
			onChange(value)
		end
	end)
	return {
		frame = track,
		set = function(v)
			value = v
			render(true)
		end,
		get = function()
			return value
		end,
		setEnabled = function(v)
			enabled = v
			render(false)
		end,
	}
end

-- Segmented control. options: { { value = x, label = "…" } }.
-- Returns { frame, set(value), setEnabled(bool), get() }.
function Kit.segmented(options, initial, onChange, props)
	props = props or {}
	local value = initial
	local enabled = true
	local frame = Kit.make("Frame", {
		Name = "Segmented",
		Size = props.Size or UDim2.new(1, 0, 0, 38),
		LayoutOrder = props.order or 0,
		BorderSizePixel = 0,
		Parent = props.Parent,
		Theme = { BackgroundColor3 = "surface2" },
	}, { Kit.corner(), Kit.padding(3), Kit.list("x", 3, "Left", "Center") })
	local buttons = {}
	local function render()
		for _, entry in buttons do
			local selected = entry.value == value
			Theme.bind(entry.button, {
				BackgroundColor3 = selected and "accent" or "surface2",
				TextColor3 = selected and "accentText" or "textDim",
			})
			entry.button.BackgroundTransparency = selected and 0 or 1
			entry.button.TextTransparency = enabled and 0 or 0.4
		end
	end
	for index, option in options do
		local button = Kit.make("TextButton", {
			Name = tostring(option.value),
			Text = option.label,
			AutoButtonColor = false,
			TextSize = props.textSize or 14,
			Size = UDim2.new(1 / #options, -3, 1, 0),
			BorderSizePixel = 0,
			LayoutOrder = index,
			TextWrapped = true,
			Parent = frame,
			Theme = { Font = "fontBold" },
		}, { Kit.corner() })
		table.insert(buttons, { value = option.value, button = button })
		button.Activated:Connect(function()
			if not enabled then
				Sound.play("error", { volume = 0.4 })
				return
			end
			if value == option.value then
				return
			end
			value = option.value
			Sound.play("click")
			render()
			if onChange then
				onChange(value)
			end
		end)
	end
	render()
	return {
		frame = frame,
		set = function(v)
			value = v
			render()
		end,
		get = function()
			return value
		end,
		setEnabled = function(v)
			enabled = v
			render()
		end,
	}
end

-- Horizontal progress bar. Returns { frame, set(alpha, animate), fill }.
function Kit.progress(props)
	props = props or {}
	local frame = Kit.make("Frame", {
		Name = "Progress",
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		BorderSizePixel = 0,
		LayoutOrder = props.order or 0,
		Position = props.Position,
		Parent = props.Parent,
		Theme = { BackgroundColor3 = "surface3" },
	}, { Kit.round() })
	local fill = Kit.make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
		Parent = frame,
		Theme = { BackgroundColor3 = props.token or "accent" },
	}, { Kit.round() })
	return {
		frame = frame,
		fill = fill,
		set = function(alpha, animate)
			local goal = { Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1) }
			if animate then
				Anim.tween(fill, 0.6, goal)
			else
				fill.Size = goal.Size
			end
		end,
	}
end

-- Makes any GuiObject clickable with hover lift, without adding children (so it is safe inside
-- UIListLayout / UIGridLayout containers). Inner buttons still take priority.
function Kit.hoverable(guiObject: GuiObject, onClick)
	local scale = Anim.scaleOf(guiObject)
	local pressed = false
	guiObject.Active = true
	guiObject.MouseEnter:Connect(function()
		Anim.tween(scale, 0.18, { Scale = 1.02 })
	end)
	guiObject.MouseLeave:Connect(function()
		pressed = false
		Anim.tween(scale, 0.2, { Scale = 1 })
	end)
	guiObject.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			pressed = true
			Anim.tween(scale, 0.08, { Scale = 0.97 })
		end
	end)
	guiObject.InputEnded:Connect(function(input)
		if
			pressed
			and (
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			pressed = false
			Anim.tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			Sound.play("click")
			onClick()
		end
	end)
	return guiObject
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="81">
            <Properties>
              <string name="Name">Overlays</string>
            </Properties>
            <Item class="ModuleScript" referent="82">
              <Properties>
                <string name="Name">Announcer</string>
                <string name="Source"><![CDATA[-- Achievement unlock cards and world-record banners.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Achievements = require(Shared.Achievements)
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Sound = require(UI.Parent.Core.Sound)

local Announcer = {}

local queue = {}
local running = false

local function runQueue(App)
	if running then
		return
	end
	running = true
	task.spawn(function()
		while #queue > 0 do
			local job = table.remove(queue, 1)
			job(App)
			task.wait(1.2)
		end
		running = false
	end)
end

function Announcer.achievement(App, id: string)
	local def = Achievements.ById[id]
	if not def then
		return
	end
	table.insert(queue, function()
		local card = Kit.panel({
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -20, 1, -20),
			Size = UDim2.fromOffset(360, 86),
			ZIndex = 97,
			Parent = App.overlay,
		}, { Kit.padding(12) }, "surface2")
		card.BackgroundTransparency = 0
		Kit.stroke("gold", 2, 0).Parent = card
		Kit.text({
			text = def.emoji,
			size = 42,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(56, 62),
			Parent = card,
		})
		Kit.text({
			text = "ACHIEVEMENT UNLOCKED",
			style = "tiny",
			tone = "gold",
			font = "fontHeavy",
			Size = UDim2.new(1, -66, 0, 14),
			Position = UDim2.fromOffset(64, 2),
			Parent = card,
		})
		Kit.text({
			text = def.name,
			style = "h3",
			size = 18,
			Size = UDim2.new(1, -66, 0, 22),
			Position = UDim2.fromOffset(64, 18),
			Parent = card,
		})
		Kit.text({
			text = def.description .. (def.coins and def.coins > 0 and ("  +" .. def.coins .. " 🪙") or ""),
			style = "tiny",
			tone = "textDim",
			Size = UDim2.new(1, -66, 0, 28),
			Position = UDim2.fromOffset(64, 40),
			Parent = card,
		})
		Anim.slideIn(card, UDim2.fromOffset(420, 0), 0.5)
		Sound.play("achievement")
		task.delay(0.3, function()
			Fx.burst(card, {
				count = 18,
				glyphs = { "✦", "★" },
				colors = { Color3.fromRGB(255, 215, 0), Color3.new(1, 1, 1) },
				maxDistance = 140,
			})
		end)
		task.delay(4, function()
			Anim.tween(card, 0.4, { Position = UDim2.new(1, 420, 1, -20) })
			task.delay(0.45, function()
				card:Destroy()
			end)
		end)
	end)
	runQueue(App)
end

local BOARD_NAMES = {
	fastest_overall = "Fastest race ever",
	fewest_clicks = "Fewest clicks ever",
}

function Announcer.record(App, data)
	local record = data.record
	local boardName = BOARD_NAMES[data.board]
	if not boardName then
		local key = string.gsub(data.board, "^fastest_", "")
		boardName = "Fastest " .. Difficulty.get(key).name
	end
	local value = data.board == "fewest_clicks" and (record.clicks .. " clicks") or Format.time(record.ms / 1000)
	table.insert(queue, function()
		local banner = Kit.panel({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 70),
			Size = UDim2.fromOffset(620, 64),
			ZIndex = 97,
			Parent = App.overlay,
		}, { Kit.padding(10) }, "surface2")
		banner.BackgroundTransparency = 0
		Kit.stroke("accent", 2, 0).Parent = banner
		Kit.text({
			text = ("🌍 NEW WORLD RECORD · %s: %s"):format(boardName, value),
			style = "h3",
			align = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 24),
			Parent = banner,
		})
		Kit.text({
			text = ("by %s · %s → %s"):format(record.name or "?", record.start or "?", record.target or "?"),
			style = "small",
			tone = "textDim",
			align = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 26),
			Parent = banner,
		})
		Anim.slideIn(banner, UDim2.fromOffset(0, -120), 0.5)
		Sound.play("fanfare", { volume = 0.6 })
		task.delay(4.5, function()
			Anim.tween(banner, 0.4, { Position = UDim2.new(0.5, 0, 0, -120) })
			task.delay(0.45, function()
				banner:Destroy()
			end)
		end)
	end)
	runQueue(App)
end

return Announcer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="83">
              <Properties>
                <string name="Name">Chaos</string>
                <string name="Source"><![CDATA[-- Chaos presentation: the server-wide SERVER RIGGED slam and targeted gag effects.
-- Every overlay here is non-blocking (never sinks input) and short; players can keep playing.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Temperature = require(Shared.Temperature)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Sound = require(UI.Parent.Core.Sound)
local Store = require(UI.Parent.Core.Store)

local Chaos = {}

local function layer(App, z: number)
	local frame = Kit.make("Frame", {
		Name = "Chaos",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = z,
		Parent = App.overlay,
	})
	return frame
end

function Chaos.serverRigged(App, data)
	local frame = layer(App, 95)
	Sound.play("siren")
	Sound.play("boom")
	-- Hazard stripes backdrop
	local backdrop = Kit.make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 0, 0),
		BackgroundTransparency = 1,
		Active = false,
		Parent = frame,
	})
	Anim.tween(backdrop, 0.15, { BackgroundTransparency = 0.25 })
	local stripes = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1.4, 0, 0, 170),
		Rotation = -6,
		Parent = frame,
	})
	stripes.BackgroundTransparency = 0
	stripes.BackgroundColor3 = Color3.fromRGB(250, 204, 21)
	local gradient = Instance.new("UIGradient")
	local keys = {}
	for i = 0, 20 do
		local alpha = i / 20
		table.insert(
			keys,
			ColorSequenceKeypoint.new(
				alpha,
				(i % 2 == 0) and Color3.fromRGB(250, 204, 21) or Color3.fromRGB(20, 20, 20)
			)
		)
	end
	gradient.Color = ColorSequence.new(keys)
	gradient.Parent = stripes
	Anim.slideIn(stripes, UDim2.fromScale(-1.5, 0), 0.35)
	local title = Kit.text({
		text = "SERVER RIGGED",
		style = "display",
		size = 96,
		align = Enum.TextXAlignment.Center,
		color = Color3.fromRGB(255, 50, 50),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.new(1, 0, 0, 110),
		Parent = frame,
	})
	title.TextStrokeTransparency = 0
	title.TextStrokeColor3 = Color3.new(0, 0, 0)
	Anim.punchIn(title, 4)
	local sub = Kit.text({
		text = ("🎰 %s just rigged the server. GIVE UP MODE ACTIVATED."):format(data.by or "Someone"),
		style = "h1",
		size = 26,
		align = Enum.TextXAlignment.Center,
		color = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = frame,
	})
	sub.TextStrokeTransparency = 0.3
	task.delay(0.1, function()
		Anim.shake(App.root, 18, 0.9)
		Fx.flash(frame, Color3.fromRGB(255, 0, 0), 0.5, 0.7)
		Fx.burst(
			frame,
			{ count = 50, glyphs = { "🎰", "💥", "🤡", "⚠️" }, minSize = 22, maxSize = 36, maxDistance = 500 }
		)
	end)
	Anim.pulse(title, "TextTransparency", 0, 0.35, 0.3)
	task.delay(3.4, function()
		Anim.tween(stripes, 0.4, { Position = UDim2.fromScale(2, 0.5) })
		for _, child in frame:GetDescendants() do
			if child:IsA("TextLabel") then
				Anim.tween(child, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
			end
		end
		Anim.tween(backdrop, 0.4, { BackgroundTransparency = 1 })
		task.delay(0.5, function()
			frame:Destroy()
		end)
	end)
end

local EFFECTS = {}

EFFECTS.clown = function(App, frame)
	Sound.play("boing")
	Fx.rain(frame, { glyphs = { "🤡", "🎈", "🤡" }, duration = 3.5, rate = 30, minSize = 26, maxSize = 44 })
end

EFFECTS.wobble = function(App)
	Sound.play("boing", { pitch = 0.8 })
	local root = App.root
	task.spawn(function()
		for i = 1, 8 do
			Anim.tween(root, 0.18, { Rotation = (i % 2 == 0) and 2 or -2 }, Enum.EasingStyle.Sine)
			task.wait(0.18)
		end
		Anim.tween(root, 0.2, { Rotation = 0 })
	end)
end

EFFECTS.fakeburn = function(App, frame)
	local info = Temperature.Info.Burning
	Sound.play("burning")
	local label = Kit.text({
		text = "☄️ BURNING!!! ☄️",
		style = "display",
		size = 72,
		align = Enum.TextXAlignment.Center,
		color = info.color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 90),
		Parent = frame,
	})
	label.TextStrokeTransparency = 0
	Anim.punchIn(label, 3)
	Anim.shake(label, 10, 1.6)
	Fx.emitter(frame, { colors = { info.color, info.glow }, rate = 40, lifetime = 1 })
	task.delay(1.8, function()
		label.Text = "…jk 🤡"
		label.TextColor3 = Color3.new(1, 1, 1)
		Sound.play("boing")
		Anim.punchIn(label, 0.5)
	end)
end

EFFECTS.airhorn = function(App, frame)
	Sound.play("airhorn")
	Anim.shake(App.root, 14, 1.2)
	Fx.burst(frame, { count = 30, glyphs = { "📯", "💨" }, minSize = 22, maxSize = 34, maxDistance = 420 })
end

EFFECTS.warning = function(App, frame, from)
	Sound.play("error")
	local box = Kit.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(520, 150),
		Parent = frame,
	}, { Kit.padding(16), Kit.list("y", 6, "Center", "Center") }, "surface")
	box.BackgroundTransparency = 0
	Kit.stroke("warning", 3, 0).Parent = box
	Kit.text({
		text = "⚠️ OFFICIAL WARNING ⚠️",
		style = "h1",
		tone = "warning",
		align = Enum.TextXAlignment.Center,
		Parent = box,
		order = 1,
	})
	Kit.text({
		text = ("%s has filed a report: you are TOO good at clicking links. Your wiki license is under review."):format(
			from
		),
		style = "body",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 50),
		Parent = box,
		order = 2,
	})
	Anim.punchIn(box, 0.6)
end

EFFECTS.scream = function(App, frame)
	local dark = Kit.make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		Active = false,
		Parent = frame,
	})
	local face = Kit.text({
		text = "😱",
		size = 400,
		align = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(600, 500),
		Parent = dark,
	})
	Sound.play("jumpscare")
	Anim.punchIn(face, 0.2)
	Anim.shake(face, 30, 0.8)
	task.delay(0.9, function()
		Anim.tween(dark, 0.3, { BackgroundTransparency = 1 })
		Anim.tween(face, 0.3, { TextTransparency = 1 })
	end)
end

EFFECTS.crash = function(App, frame, from)
	local blue = Kit.make(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(0, 90, 200), Active = false, Parent = frame }
	)
	Sound.play("jumpscare", { pitch = 0.7 })
	local text = Kit.text({
		text = ":(\n\nYour wiki ran into a problem and needs to restart.\nWe're just collecting some links for you.\n\n0% complete",
		style = "h2",
		size = 26,
		color = Color3.new(1, 1, 1),
		font = "fontMono",
		Position = UDim2.fromScale(0.12, 0.2),
		Size = UDim2.new(0.76, 0, 0.6, 0),
		Parent = blue,
	})
	text.TextYAlignment = Enum.TextYAlignment.Top
	task.delay(1.8, function()
		text.Text = ("…just kidding! 🤡\n\nRigged by %s."):format(from)
		Sound.play("boing")
	end)
	task.delay(3.1, function()
		Anim.tween(blue, 0.3, { BackgroundTransparency = 1 })
		Anim.tween(text, 0.3, { TextTransparency = 1 })
	end)
end

function Chaos.effect(App, data)
	local handler = EFFECTS[data.effect]
	if not handler then
		return
	end
	-- Respect local settings too (the server already swaps jumpscares for opted-out players).
	if (data.effect == "scream" or data.effect == "crash") and Store.setting("jumpscares", true) == false then
		handler = EFFECTS.warning
	end
	local frame = layer(App, 96)
	handler(App, frame, data.from or "Someone")
	local banner = Kit.chip(("🤡 Rigged by %s"):format(data.from or "someone"), Color3.fromRGB(220, 38, 38), {
		Parent = frame,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		height = 34,
		textSize = 16,
	})
	Anim.punchIn(banner, 0.6)
	task.delay((data.duration or 4) + 0.2, function()
		for _, child in frame:GetDescendants() do
			if child:IsA("TextLabel") then
				Anim.tween(child, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			elseif child:IsA("Frame") then
				Anim.tween(child, 0.3, { BackgroundTransparency = 1 })
			end
		end
		task.delay(0.35, function()
			frame:Destroy()
		end)
	end)
end

return Chaos
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="84">
              <Properties>
                <string name="Name">ChaosMenu</string>
                <string name="Source"><![CDATA[-- Purchase flows for the chaos products: "Rig a Player" (pick target + effect) and the
-- server-wide "Server Rig". Validation happens on the server; this is presentation only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local ChaosMenu = {}

function ChaosMenu.serverRig(App)
	App.modal({
		title = "🎰 RIG THE SERVER",
		width = 500,
		build = function(body)
			Kit.text({
				text = "Every race on this server is instantly forced into GIVE UP MODE: a brand-new absurd target, zero redos, maximum chaos.\n\nEveryone sees a giant SERVER RIGGED announcement with your name on it. It only lasts for the current round, and it never changes anyone's saved stats or lobby settings.",
				style = "body",
				tone = "textDim",
				Size = UDim2.new(1, 0, 0, 0),
				auto = Enum.AutomaticSize.Y,
				Parent = body,
			})
		end,
		buttons = {
			{ text = "Not today" },
			{
				text = ("Rig it — %d R$"):format(Config.Products.ServerRig.price),
				variant = "danger",
				width = 200,
				onClick = function(close)
					close()
					App.purchaseProduct("ServerRig")
				end,
			},
		},
	})
end

-- targets: optional list of { userId, displayName } (defaults to lobby members).
function ChaosMenu.rigPlayer(App, presetTarget: number?)
	local me = Players.LocalPlayer.UserId
	local candidates = {}
	for _, member in (Store.lobby and Store.lobby.members) or {} do
		if member.userId ~= me then
			table.insert(candidates, member)
		end
	end
	if #candidates == 0 then
		App.toast("Nobody to rig here — invite some friends!", "info")
		return
	end
	local selectedTarget = presetTarget or candidates[1].userId
	local selectedEffect = "clown"
	local credits = Store.profile and Store.profile.rigCredits or 0
	local hasJumpscares = App.hasPass("Jumpscares")

	App.modal({
		title = "🤡 Rig a player",
		width = 560,
		build = function(body)
			Kit.text({
				text = ("Harmless, short and very noticeable. Rig credits: %d · Jumpscare Pack: %s"):format(
					credits,
					hasJumpscares and "owned (free every 60s)" or "not owned"
				),
				style = "small",
				tone = "textDim",
				Parent = body,
			})
			Kit.text({ text = "Target", style = "small", font = "fontBold", Parent = body })
			local targetRow = Kit.frame(
				{ Size = UDim2.new(1, 0, 0, 44), Parent = body },
				{ Kit.list("x", 6, "Left", "Center") }
			)
			local targetButtons = {}
			local function paintTargets()
				for userId, button in targetButtons do
					Theme.bind(button, {
						BackgroundColor3 = userId == selectedTarget and "accent" or "surface2",
						TextColor3 = userId == selectedTarget and "accentText" or "text",
					})
				end
			end
			for index, member in candidates do
				targetButtons[member.userId] = Kit.button({
					text = member.displayName,
					Size = UDim2.fromOffset(130, 40),
					order = index,
					textSize = 14,
					Parent = targetRow,
					onClick = function()
						selectedTarget = member.userId
						paintTargets()
					end,
				})
			end
			paintTargets()
			Kit.text({ text = "Effect", style = "small", font = "fontBold", Parent = body })
			local grid = Kit.frame(
				{ Size = UDim2.new(1, 0, 0, 170), Parent = body },
				{ Kit.grid(UDim2.fromOffset(122, 76), 8) }
			)
			local effectCards = {}
			local function paintEffects()
				for id, card in effectCards do
					local stroke = card:FindFirstChild("Selected")
					if stroke then
						stroke.Enabled = id == selectedEffect
					end
				end
			end
			for index, effect in Catalog.ChaosEffects do
				local locked = effect.requires == "Jumpscares" and not hasJumpscares
				local card = Kit.panel(
					{ LayoutOrder = index, Parent = grid },
					{ Kit.padding(6), Kit.list("y", 2, "Center", "Center") }
				)
				local selectedStroke = Kit.stroke("accent", 3, 0)
				selectedStroke.Name = "Selected"
				selectedStroke.Enabled = false
				selectedStroke.Parent = card
				Kit.text({
					text = effect.emoji,
					size = 26,
					align = Enum.TextXAlignment.Center,
					Size = UDim2.new(1, 0, 0, 30),
					Parent = card,
					order = 1,
				})
				Kit.text({
					text = effect.name .. (locked and " 🔒" or ""),
					style = "tiny",
					font = "fontBold",
					align = Enum.TextXAlignment.Center,
					Size = UDim2.new(1, 0, 0, 28),
					Parent = card,
					order = 2,
				})
				effectCards[effect.id] = card
				Kit.hoverable(card, function()
					if locked then
						App.toast("Jumpscares need the Jumpscare Pack game pass.", "info")
						return
					end
					selectedEffect = effect.id
					paintEffects()
				end)
			end
			paintEffects()
			Kit.text({
				text = "Players who turned off incoming chaos can't be targeted. Jumpscares become a harmless warning for players who disabled them.",
				style = "tiny",
				tone = "textFaint",
				Size = UDim2.new(1, 0, 0, 30),
				Parent = body,
			})
		end,
		buttons = {
			{ text = "Cancel" },
			{
				text = "Rig!",
				emoji = "🤡",
				variant = "danger",
				width = 170,
				onClick = function(close)
					local ok, data =
						Net.request(Net.Actions.RigPlayer, { userId = selectedTarget, effect = selectedEffect })
					if not ok then
						App.toast(data, "error")
						return
					end
					close()
					if data and data.needsPurchase then
						Net.request(Net.Actions.SetRigIntent, { userId = selectedTarget, effect = selectedEffect })
						App.purchaseProduct("RigPlayer")
					elseif data and data.delivered then
						Sound.play("boing")
						if data.substituted then
							App.toast("They disabled jumpscares, so they got a dramatic warning instead.", "info")
						end
					end
				end,
			},
		},
	})
end

return ChaosMenu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="85">
              <Properties>
                <string name="Name">FinalResults</string>
                <string name="Source"><![CDATA[-- Final ceremony: dynamic podium (never empty slots), runner-ups, then special award cards.
-- Victory and podium cosmetics of the players on the podium play here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local FinalResults = {}

local PODIUM = {
	{ medal = "🥇", color = Color3.fromRGB(250, 204, 21), height = 230, label = "1st" },
	{ medal = "🥈", color = Color3.fromRGB(203, 213, 225), height = 175, label = "2nd" },
	{ medal = "🥉", color = Color3.fromRGB(217, 119, 6), height = 135, label = "3rd" },
}

local current = nil

function FinalResults.hide()
	if current then
		current:Destroy()
		current = nil
	end
	Fx.blur(0, 0.3)
end

local function victoryEffect(parent: GuiObject, itemId: string?)
	if itemId == "victory_emoji" then
		Fx.rain(
			parent,
			{ glyphs = { "🏆", "🎉", "⭐", "🥳" }, duration = 4, rate = 24, minSize = 20, maxSize = 32 }
		)
	elseif itemId == "victory_fireworks" then
		task.spawn(function()
			for _ = 1, 8 do
				Fx.burst(parent, {
					origin = UDim2.fromScale(0.15 + math.random() * 0.7, 0.1 + math.random() * 0.35),
					count = 34,
					glyphs = { "✦", "✺" },
					gravity = 30,
				})
				Sound.play("boom", { volume = 0.4, pitch = 1 + math.random() * 0.4 })
				task.wait(0.45)
			end
		end)
	elseif itemId == "victory_lightning" then
		task.spawn(function()
			for _ = 1, 4 do
				Fx.flash(parent, Color3.fromRGB(200, 220, 255), 0.25, 0.8)
				Fx.burst(parent, {
					origin = UDim2.fromScale(math.random(), 0.2),
					count = 12,
					glyphs = { "⚡" },
					colors = { Color3.fromRGB(255, 240, 120) },
					minSize = 24,
					maxSize = 40,
				})
				Sound.play("boom", { pitch = 1.6, volume = 0.5 })
				task.wait(0.6)
			end
		end)
	elseif itemId == "victory_vip" then
		local crown = Kit.text({
			text = "👑",
			size = 160,
			align = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, -0.3),
			Size = UDim2.fromOffset(220, 200),
			Parent = parent,
		})
		crown.ZIndex = 70
		Anim.tween(crown, 1.4, { Position = UDim2.fromScale(0.5, 0.22) }, Enum.EasingStyle.Bounce)
		task.delay(3.5, function()
			Anim.tween(crown, 0.6, { TextTransparency = 1 })
		end)
		Fx.rain(parent, { glyphs = { "★" }, colors = { Color3.fromRGB(255, 215, 0) }, duration = 3.5, rate = 20 })
	else
		Fx.rain(parent, { duration = 3.5, rate = 40 })
	end
end

-- Effects are parented to the podium area (not the clipped column) so they can rise above it.
local function podiumEffect(area: GuiObject, centerX: number, height: number, itemId: string?)
	local column = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, centerX, 1, 0),
		Size = UDim2.fromOffset(180, height + 200),
		Parent = area,
	})
	if itemId == "podium_sparkles" then
		Fx.emitter(column, {
			glyph = "✦",
			colors = { Color3.new(1, 1, 1), Color3.fromRGB(255, 240, 180) },
			rate = 8,
			lifetime = 1.4,
			minSize = 8,
			maxSize = 14,
		})
	elseif itemId == "podium_goldrain" then
		Fx.rain(column, { glyphs = { "🪙" }, duration = 5, rate = 10, minSize = 14, maxSize = 20 })
	elseif itemId == "podium_vip" then
		local carpet = Kit.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 16),
			Size = UDim2.new(1.3, 0, 0, 16),
			BackgroundColor3 = Color3.fromRGB(185, 28, 28),
			BorderSizePixel = 0,
			Parent = column,
		}, { Kit.corner(4) })
		local _ = carpet
	else
		local spot = Kit.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -height),
			Size = UDim2.new(1.4, 0, 0, 260),
			BackgroundColor3 = Color3.fromRGB(255, 250, 220),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			ZIndex = 0,
			Parent = column,
		})
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.55) })
		g.Parent = spot
	end
end

-- data: { standings, awards, roundsPlayed, solo }. onClose(action) where action = "lobby"|"again"
function FinalResults.show(App, data, onClose)
	FinalResults.hide()
	local me = Players.LocalPlayer.UserId
	local standings = data.standings
	local shade = Kit.make("Frame", {
		Name = "FinalResults",
		Active = true,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(4, 6, 14),
		BackgroundTransparency = 1,
		ZIndex = 55,
		Parent = App.overlay,
	})
	current = shade
	Anim.tween(shade, 0.5, { BackgroundTransparency = 0.08 })
	Fx.blur(14, 0.6)
	local stage = Kit.frame({ Size = UDim2.fromScale(1, 1), Parent = shade })

	local title = Kit.text({
		text = data.solo and "🏁 SOLO RACE COMPLETE" or "🏆 FINAL RESULTS",
		style = "display",
		size = 52,
		align = Enum.TextXAlignment.Center,
		color = Color3.fromRGB(255, 226, 120),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 64),
		Parent = stage,
	})
	Anim.punchIn(title, 1.6)
	Sound.play("fanfare")
	Kit.text({
		text = ("%d round%s played"):format(data.roundsPlayed, data.roundsPlayed == 1 and "" or "s"),
		style = "small",
		align = Enum.TextXAlignment.Center,
		color = Color3.fromRGB(180, 190, 210),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = stage,
	})

	-- Podium: exactly min(3, #players) columns, ordered 2nd · 1st · 3rd visually.
	local podiumCount = math.min(3, #standings)
	local hasRunnersUp = #standings > 3
	local podiumArea = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(hasRunnersUp and 0.36 or 0.5, 0, 1, -150),
		Size = UDim2.fromOffset(podiumCount * 200, 420),
		Parent = stage,
	})
	local visualOrder = podiumCount == 1 and { 1 } or (podiumCount == 2 and { 2, 1 } or { 2, 1, 3 })
	for slot, place in visualOrder do
		local entry = standings[place]
		local spec = PODIUM[place]
		local column = Kit.make("Frame", {
			Name = "Place" .. place,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, (slot - 1) * 200 + 10, 1, 0),
			Size = UDim2.fromOffset(180, 0),
			BackgroundColor3 = spec.color,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = podiumArea,
		}, { Kit.corner(10) })
		local centerX = (slot - 1) * 200 + 10 + 90
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = 90
		gradient.Color = ColorSequence.new(spec.color, spec.color:Lerp(Color3.new(0, 0, 0), 0.4))
		gradient.Parent = column
		Kit.text({
			text = spec.medal .. " " .. spec.label,
			style = "h1",
			size = 26,
			align = Enum.TextXAlignment.Center,
			color = Color3.fromRGB(30, 20, 0),
			Size = UDim2.new(1, 0, 0, 36),
			Position = UDim2.fromOffset(0, 10),
			Parent = column,
		})
		local stats = Kit.text({
			text = ("⏱ %s\n🖱 %d clicks · ♻ %d redos"):format(
				Format.time(entry.totalTime),
				entry.totalClicks,
				entry.totalRedos
			),
			style = "tiny",
			align = Enum.TextXAlignment.Center,
			color = Color3.fromRGB(40, 30, 10),
			Size = UDim2.new(1, -10, 0, 34),
			Position = UDim2.fromOffset(5, 48),
			Parent = column,
		})
		local _ = stats
		local riseDelay = ({ 2.0, 1.2, 0.5 })[place]
		task.delay(riseDelay, function()
			Sound.play(place == 1 and "podium" or "drumroll", { pitch = place == 1 and 1 or 1.2 })
			Anim.tween(column, 0.9, { Size = UDim2.fromOffset(180, spec.height) }, Enum.EasingStyle.Back)
			-- Player card drops onto the column.
			local cardHolder = Kit.frame({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0, centerX, 1, -(spec.height + 600)),
				Size = UDim2.fromOffset(180, 170),
				ZIndex = 5,
				Parent = podiumArea,
			}, { Kit.list("y", 4, "Center", "Bottom") })
			Kit.avatar(entry.userId, place == 1 and 92 or 76, entry.look, { Parent = cardHolder, order = 1 })
			Kit.nameBlock(entry.displayName .. (entry.userId == me and " (you)" or ""), entry.look, {
				Parent = cardHolder,
				order = 2,
				hAlign = "Center",
				align = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 36),
				nameSize = 17,
			})
			local score = Kit.text({
				text = "0",
				style = "h2",
				size = 22,
				font = "fontMono",
				align = Enum.TextXAlignment.Center,
				color = spec.color,
				Size = UDim2.new(1, 0, 0, 26),
				Parent = cardHolder,
				order = 3,
			})
			Anim.tween(
				cardHolder,
				0.8,
				{ Position = UDim2.new(0, centerX, 1, -(spec.height + 8)) },
				Enum.EasingStyle.Bounce,
				Enum.EasingDirection.Out,
				0.35
			)
			task.delay(0.8, function()
				Anim.countTo(score, 0, entry.score, 1.2, function(n)
					return Format.number(n) .. " pts"
				end)
				podiumEffect(podiumArea, centerX, spec.height, entry.look and entry.look.podium)
				if place == 1 then
					Fx.flash(stage, spec.color, 0.5, 0.45)
					victoryEffect(stage, entry.look and entry.look.victory)
					if entry.userId == me and not data.solo then
						Sound.play("achievement")
					end
				end
			end)
		end)
	end

	-- Runner-ups (4th and below), scrollable.
	if hasRunnersUp then
		local panel = Kit.panel({
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -30, 1, -150),
			Size = UDim2.new(0.3, 0, 0, 380),
			Parent = stage,
		}, { Kit.padding(12) }, "surface")
		panel.BackgroundTransparency = 0.05
		Kit.text({ text = "Runner-ups", style = "h2", Size = UDim2.new(1, 0, 0, 28), Parent = panel })
		local list = Kit.scroll(
			{ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), Parent = panel },
			{ Kit.list("y", 6) }
		)
		for index = 4, #standings do
			local entry = standings[index]
			local row = Kit.panel(
				{ Size = UDim2.new(1, -8, 0, 58), LayoutOrder = index, Parent = list },
				nil,
				entry.userId == me and "surface2" or "surface"
			)
			Kit.text({
				text = "#" .. index,
				style = "h3",
				Size = UDim2.fromOffset(40, 58),
				Position = UDim2.fromOffset(8, 0),
				Parent = row,
			})
			Kit.avatar(entry.userId, 38, entry.look, { Parent = row, Position = UDim2.fromOffset(46, 10) })
			Kit.nameBlock(
				entry.displayName,
				entry.look,
				{ Parent = row, Size = UDim2.new(1, -200, 0, 30), nameSize = 14 }
			).Position =
				UDim2.fromOffset(92, 4)
			Kit.text({
				text = ("⏱ %s · 🖱 %d · ♻ %d"):format(
					Format.time(entry.totalTime),
					entry.totalClicks,
					entry.totalRedos
				),
				style = "tiny",
				tone = "textDim",
				Size = UDim2.new(1, -200, 0, 16),
				Position = UDim2.fromOffset(92, 36),
				Parent = row,
			})
			Kit.text({
				text = Format.number(entry.score),
				style = "h3",
				font = "fontMono",
				align = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 0),
				Size = UDim2.fromOffset(90, 58),
				Parent = row,
			})
			Anim.slideIn(row, UDim2.fromOffset(60, 0), 0.4, 2.6 + (index - 4) * 0.1)
		end
	end

	-- Special awards (after the podium settles).
	local awards = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -72),
		Size = UDim2.fromOffset(780, 70),
		Parent = stage,
	}, { Kit.list("x", 14, "Center", "Center") })
	local AWARDS = {
		{
			key = "fastestTime",
			emoji = "⚡",
			title = "Fastest Time",
			value = function(a)
				return Format.time(a.time)
			end,
		},
		{
			key = "fewestClicks",
			emoji = "🎯",
			title = "Fewest Clicks",
			value = function(a)
				return a.clicks .. " clicks"
			end,
		},
		{
			key = "fewestRedos",
			emoji = "♻️",
			title = "Fewest Redos",
			value = function(a)
				return a.redos .. " redos"
			end,
		},
	}
	local shown = 0
	for _, spec in AWARDS do
		local award = data.awards and data.awards[spec.key]
		if award and not data.solo then
			shown += 1
			local cardDelay = 3.4 + shown * 0.45
			local card = Kit.panel(
				{ Size = UDim2.fromOffset(240, 66), LayoutOrder = shown, Parent = awards },
				{ Kit.padding(8) },
				"surface2"
			)
			card.BackgroundTransparency = 0
			card.Visible = false
			Kit.stroke("gold", 2, 0.2).Parent = card
			Kit.text({ text = spec.emoji, size = 30, Size = UDim2.fromOffset(40, 50), Parent = card })
			Kit.text({
				text = spec.title,
				style = "tiny",
				tone = "gold",
				font = "fontHeavy",
				Size = UDim2.new(1, -48, 0, 14),
				Position = UDim2.fromOffset(46, 2),
				Parent = card,
			})
			Kit.text({
				text = award.displayName,
				style = "h3",
				size = 16,
				truncate = true,
				wrap = false,
				Size = UDim2.new(1, -48, 0, 22),
				Position = UDim2.fromOffset(46, 16),
				Parent = card,
			})
			Kit.text({
				text = spec.value(award),
				style = "tiny",
				tone = "textDim",
				Size = UDim2.new(1, -48, 0, 14),
				Position = UDim2.fromOffset(46, 38),
				Parent = card,
			})
			task.delay(cardDelay, function()
				card.Visible = true
				card.Rotation = 90
				local scale = Anim.scaleOf(card)
				scale.Scale = 0.4
				Anim.tween(card, 0.6, { Rotation = 0 }, Enum.EasingStyle.Back)
				Anim.tween(scale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
				Sound.play("award", { pitch = 1 + shown * 0.08 })
				if award.userId == me then
					Fx.burst(
						card,
						{ count = 16, glyphs = { "✦" }, colors = { Color3.fromRGB(255, 215, 0) }, maxDistance = 120 }
					)
				end
			end)
		end
	end

	-- Buttons
	local buttons = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(600, 48),
		Parent = stage,
	}, { Kit.list("x", 12, "Center", "Center") })
	Kit.button({
		text = data.solo and "Back to Free Roam" or "Back to lobby",
		emoji = "←",
		Size = UDim2.fromOffset(220, 46),
		Parent = buttons,
		order = 1,
		onClick = function()
			FinalResults.hide()
			onClose(data.solo and "freeroam" or "lobby")
		end,
	})
	if not data.solo and Store.isHost() then
		Kit.button({
			text = "Play again",
			emoji = "🔁",
			variant = "primary",
			Size = UDim2.fromOffset(200, 46),
			Parent = buttons,
			order = 2,
			onClick = function()
				FinalResults.hide()
				onClose("again")
			end,
		})
	end
end

return FinalResults
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="86">
              <Properties>
                <string name="Name">Reveal</string>
                <string name="Source"><![CDATA[-- Round intro choreography, synced to server timestamps:
--   1. STARTING PAGE  — titles roll like a slot machine, slow down, then the start page lands.
--   2. YOUR TARGET    — a longer, louder roll with shake, then a zoom slam + flash + glow ring.
--   3. 3 · 2 · 1 · GO — the race clock starts exactly at raceStartAt.
-- Players joining after the race started skip straight to the page.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Categories = require(Shared.Categories)
local Difficulty = require(Shared.Difficulty)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Sound = require(UI.Parent.Core.Sound)

local Reveal = {}

local active = nil

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function waitUntil(t: number)
	local remaining = t - serverNow()
	if remaining > 0 then
		task.wait(remaining)
	end
end

-- Rolls titles on a label, slowing down (ease-out), finishing just before `deadline`.
local function roll(label: TextLabel, titles, deadline: number, pitchBase: number, shakeTarget: GuiObject?)
	local startTime = serverNow()
	local total = math.max(0.3, deadline - startTime)
	local index = math.random(1, math.max(1, #titles))
	while serverNow() < deadline - 0.06 do
		local progress = math.clamp((serverNow() - startTime) / total, 0, 1)
		index = index % math.max(1, #titles) + 1
		label.Text = titles[index] or "…"
		Sound.play("tick", { pitch = pitchBase + progress * 0.6, volume = 0.6 })
		if shakeTarget and progress > 0.55 then
			Anim.shake(shakeTarget, 3 + progress * 6, 0.08)
		end
		local interval = 0.04 + (progress ^ 2.2) * 0.34
		task.wait(math.min(interval, math.max(0.02, deadline - serverNow() - 0.05)))
	end
end

function Reveal.play(App, data, onDone)
	if active then
		active:Destroy()
		active = nil
	end
	if serverNow() >= data.raceStartAt - 0.2 then
		onDone()
		return
	end

	local overlay = Kit.make("Frame", {
		Name = "Reveal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 60,
		Parent = App.overlay,
	})
	active = overlay
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.5, 0.35),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	gradient.Parent = overlay
	Anim.tween(overlay, 0.4, { BackgroundTransparency = 0 })
	Fx.blur(20, 0.5)

	local center = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(900, 460),
		Parent = overlay,
	})

	local def = Difficulty.get(data.difficulty)
	local header = Kit.chip(
		("Round %s  ·  %s %s"):format(
			data.totalRounds == 0 and (data.round .. " · ∞") or (data.round .. "/" .. data.totalRounds),
			def.emoji,
			def.name
		),
		def.color,
		{
			Parent = center,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			height = 34,
			textSize = 16,
			textColor = Color3.fromRGB(20, 20, 20),
		}
	)
	Anim.punchIn(header)
	if data.rigged then
		local rig = Kit.chip(
			"🎰 SERVER RIGGED BY " .. string.upper(data.rigBy or "?") .. " — GIVE UP MODE",
			Color3.fromRGB(220, 38, 38),
			{
				Parent = center,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 42),
				height = 30,
			}
		)
		Anim.pulse(rig, "BackgroundTransparency", 0, 0.4, 0.5)
	end

	local caption = Kit.text({
		text = "STARTING PAGE",
		style = "h2",
		size = 20,
		align = Enum.TextXAlignment.Center,
		color = Color3.fromRGB(200, 210, 230),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.new(1, 0, 0, 26),
		Parent = center,
	})
	local big = Kit.text({
		text = "",
		style = "display",
		size = 58,
		align = Enum.TextXAlignment.Center,
		color = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(1, 0, 0, 80),
		Parent = center,
	})
	big.TextWrapped = true
	local sub = Kit.text({
		text = "",
		style = "body",
		align = Enum.TextXAlignment.Center,
		color = Color3.fromRGB(190, 200, 220),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 216),
		Size = UDim2.new(0.8, 0, 0, 44),
		Parent = center,
	})
	local startCard = Kit.chip("", Color3.fromRGB(51, 102, 204), {
		Parent = center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 290),
		height = 40,
		textSize = 18,
	})
	startCard.Visible = false
	local countdown = Kit.text({
		text = "",
		style = "display",
		size = 120,
		align = Enum.TextXAlignment.Center,
		color = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 330),
		Size = UDim2.new(1, 0, 0, 130),
		Parent = center,
	})

	local titles = data.rollTitles or {}
	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		Fx.blur(0, 0.35)
		Anim.tween(overlay, 0.35, { BackgroundTransparency = 1 })
		for _, child in overlay:GetDescendants() do
			if child:IsA("TextLabel") then
				Anim.tween(child, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			end
		end
		task.delay(0.4, function()
			overlay:Destroy()
			if active == overlay then
				active = nil
			end
		end)
		onDone()
	end

	task.spawn(function()
		-- Phase 1: start page.
		waitUntil(data.revealStartAt)
		Sound.play("whoosh")
		roll(big, titles, data.targetRevealAt - 0.9, 0.9, nil)
		big.Text = data.start.title
		local startInfo = Categories.get(data.start.category)
		sub.Text = (data.start.emoji or startInfo.emoji) .. "  " .. data.start.category
		Sound.play("revealStart")
		Anim.punchIn(big, 1.45)
		Fx.burst(center, {
			count = 18,
			origin = UDim2.new(0.5, 0, 0, 170),
			colors = { Color3.fromRGB(96, 165, 250), Color3.new(1, 1, 1) },
			maxDistance = 200,
		})
		waitUntil(data.targetRevealAt)
		if not overlay.Parent then
			return
		end

		-- Phase 2: target (bigger, louder, shakier).
		startCard.Text = "📄 START: " .. data.start.title
		startCard.Visible = true
		Anim.punchIn(startCard, 0.6)
		caption.Text = "🎯 YOUR TARGET"
		caption.TextColor3 = Color3.fromRGB(255, 90, 90)
		caption.TextSize = 24
		Anim.pop(caption, 1.3)
		sub.Text = ""
		big.TextColor3 = Color3.fromRGB(255, 214, 102)
		Sound.play("drumroll")
		roll(big, titles, data.countdownAt - 1.1, 1.1, center)
		big.Text = data.target.title
		local targetInfo = Categories.get(data.target.category)
		sub.Text = (data.target.emoji or targetInfo.emoji) .. "  " .. (data.target.blurb or data.target.category)
		Sound.play("revealTarget")
		Sound.play("boom", { volume = 0.8 })
		Anim.punchIn(big, 2.4)
		Fx.flash(overlay, Color3.fromRGB(255, 200, 80), 0.6, 0.55)
		Anim.shake(center, 14, 0.5)
		local ring = Kit.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, 170),
			Size = UDim2.fromOffset(60, 60),
			BackgroundTransparency = 1,
			Parent = center,
		}, { Kit.round() })
		local ringStroke = Kit.stroke(Color3.fromRGB(255, 200, 80), 6, 0)
		ringStroke.Parent = ring
		Anim.tween(ring, 0.8, { Size = UDim2.fromOffset(820, 820) })
		Anim.tween(ringStroke, 0.8, { Transparency = 1, Thickness = 1 })
		Fx.burst(center, {
			count = 40,
			origin = UDim2.new(0.5, 0, 0, 170),
			glyphs = { "🎯", "✦", "★" },
			colors = { Color3.fromRGB(255, 214, 102), Color3.fromRGB(255, 90, 90) },
			maxDistance = 360,
		})
		waitUntil(data.countdownAt)
		if not overlay.Parent then
			return
		end

		-- Phase 3: countdown synced to the server.
		for n = 3, 1, -1 do
			waitUntil(data.raceStartAt - n)
			countdown.Text = tostring(n)
			countdown.TextTransparency = 0
			Sound.play("countdown", { pitch = 1 + (3 - n) * 0.12 })
			Anim.punchIn(countdown, 1.8)
			Anim.tween(countdown, 0.9, { TextTransparency = 0.6 })
		end
		waitUntil(data.raceStartAt)
		countdown.Text = "GO!"
		countdown.TextTransparency = 0
		countdown.TextColor3 = Color3.fromRGB(74, 222, 128)
		Sound.play("go")
		Anim.punchIn(countdown, 2)
		task.wait(0.35)
		finish()
	end)

	-- Safety net: never leave the overlay up past the race start.
	task.delay(math.max(0, data.raceStartAt - serverNow()) + 1.2, finish)
end

function Reveal.cancel()
	if active then
		active:Destroy()
		active = nil
		Fx.blur(0, 0.2)
	end
end

return Reveal
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="87">
              <Properties>
                <string name="Name">RoundResults</string>
                <string name="Source"><![CDATA[-- Round results: placements animate in one by one with counting scores, plus the start/target,
-- the true shortest route, your own route, and a countdown to the next round.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local RoundResults = {}

local MEDALS = { "🥇", "🥈", "🥉" }
local current = nil

function RoundResults.hide()
	if current then
		local frame = current
		current = nil
		Anim.tween(frame, 0.25, { BackgroundTransparency = 1 })
		task.delay(0.25, function()
			frame:Destroy()
		end)
	end
end

function RoundResults.show(App, data)
	RoundResults.hide()
	local me = Players.LocalPlayer.UserId
	local shade = Kit.make("Frame", {
		Name = "RoundResults",
		Active = true,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = App.overlay,
	})
	current = shade
	Anim.tween(shade, 0.3, { BackgroundTransparency = 0.4 })
	local card = Kit.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.86, 0, 0.88, 0),
		Parent = shade,
	}, { Kit.padding(18) }, "surface")
	card.BackgroundTransparency = 0
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(1100, 820)
	constraint.Parent = card
	Anim.punchIn(card, 0.9)
	Sound.play("roundEnd")

	local def = Difficulty.get(data.difficulty)
	local title = data.totalRounds == 0 and ("Round %d results"):format(data.round)
		or ("Round %d of %d — results"):format(data.round, data.totalRounds)
	Kit.text({ text = title, style = "title", size = 30, Size = UDim2.new(1, -220, 0, 38), Parent = card })
	Kit.chip(def.emoji .. " " .. def.name, def.color, {
		Parent = card,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		height = 30,
		textColor = Color3.fromRGB(20, 20, 20),
	})
	local y = 44
	if data.rigged then
		Kit.chip(
			"🎰 This round was rigged by " .. tostring(data.rigBy),
			Color3.fromRGB(220, 38, 38),
			{ Parent = card, Position = UDim2.fromOffset(0, y), height = 26 }
		)
		y += 32
	end
	Kit.text({
		text = ("📄 %s   →   🎯 %s"):format(data.start.title, data.target.title),
		style = "h3",
		tone = "textDim",
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = card,
	})
	y += 28
	if data.optimalPath and #data.optimalPath > 0 then
		local route = Kit.text({
			text = ("Shortest route (%d links): %s"):format(
				#data.optimalPath - 1,
				table.concat(data.optimalPath, " → ")
			),
			style = "small",
			tone = "accent",
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, 36),
			Parent = card,
		})
		route.TextYAlignment = Enum.TextYAlignment.Top
		y += 40
	end

	-- Column headers
	local columns = {
		{ "#", 0.06 },
		{ "Player", 0.34 },
		{ "Time", 0.14 },
		{ "Clicks", 0.1 },
		{ "Redos", 0.1 },
		{ "Score", 0.14 },
		{ "", 0.12 },
	}
	local headerRow = Kit.frame({ Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 22), Parent = card })
	local x = 0
	for _, column in columns do
		Kit.text({
			text = column[1],
			style = "tiny",
			tone = "textFaint",
			font = "fontBold",
			Position = UDim2.fromScale(x, 0),
			Size = UDim2.new(column[2], 0, 1, 0),
			Parent = headerRow,
		})
		x += column[2]
	end
	y += 26

	local list = Kit.scroll(
		{ Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 1, -(y + 64)), Parent = card },
		{ Kit.list("y", 6) }
	)
	for index, row in data.rows do
		local isMe = row.userId == me
		local rowHeight = isMe and #row.route > 0 and 78 or 54
		local frame = Kit.panel(
			{ Size = UDim2.new(1, -8, 0, rowHeight), LayoutOrder = index, Parent = list },
			nil,
			isMe and "surface2" or "surface"
		)
		if isMe then
			Kit.stroke("accent", 2, 0.1).Parent = frame
		end
		local cx = 0
		local function cell(text: string, width: number, props)
			props = props or {}
			local label = Kit.text({
				text = text,
				style = props.style or "body",
				font = props.font,
				tone = props.tone,
				truncate = true,
				wrap = false,
				Position = UDim2.new(cx, 8, 0, 0),
				Size = UDim2.new(width, -8, 0, 54),
				Parent = frame,
			})
			cx += width
			return label
		end
		cell(
			row.completed and (MEDALS[row.placement] or ("#" .. row.placement)) or ("#" .. row.placement),
			0.06,
			{ style = "h3" }
		)
		local playerCell =
			Kit.frame({ Position = UDim2.new(cx, 4, 0, 7), Size = UDim2.new(0.34, -8, 0, 40), Parent = frame })
		Kit.avatar(row.userId, 40, row.look, { Parent = playerCell })
		local nameBlock = Kit.nameBlock(
			row.displayName .. (isMe and " (you)" or ""),
			row.look,
			{ Parent = playerCell, Size = UDim2.new(1, -50, 1, 0), nameSize = 15 }
		)
		nameBlock.Position = UDim2.fromOffset(50, 0)
		cx += 0.34
		local status = row.completed and Format.time(row.time)
			or (row.left and "🔌 left" or (row.gaveUp and "🏳️ gave up" or "⌛ DNF"))
		cell(status, 0.14, { tone = row.completed and "text" or "textFaint", font = "fontMono" })
		cell(tostring(row.clicks), 0.1, { font = "fontMono" })
		cell(tostring(row.redos), 0.1, { font = "fontMono" })
		local scoreLabel = cell("0", 0.14, { style = "h3", font = "fontMono" })
		local breakdown = row.breakdown or {}
		local detail = row.completed
				and ("+%d place · +%d time · +%d route · %d redos · ×%.1f"):format(
					breakdown.placement or 0,
					breakdown.time or 0,
					breakdown.efficiency or 0,
					breakdown.redos or 0,
					breakdown.multiplier or 1
				)
			or ("+%d progress · ×%.1f"):format(breakdown.progress or 0, breakdown.multiplier or 1)
		cell(detail, 0.12, { style = "tiny", tone = "textFaint" }).TextWrapped = true
		if isMe and #row.route > 0 then
			local routeText = Kit.text({
				text = "Your route: "
					.. table.concat(row.route, " → ")
					.. (row.routeLength > #row.route and " (…)" or ""),
				style = "tiny",
				tone = "textDim",
				truncate = true,
				wrap = false,
				Position = UDim2.fromOffset(12, 54),
				Size = UDim2.new(1, -24, 0, 18),
				Parent = frame,
			})
			local _ = routeText
		end
		Anim.slideIn(frame, UDim2.fromOffset(-60, 0), 0.4, 0.15 + index * 0.12)
		task.delay(0.15 + index * 0.12, function()
			Sound.play("tick", { pitch = 1 + index * 0.05 })
			Anim.countTo(scoreLabel, 0, row.score, 0.9, function(n)
				return Format.number(n)
			end)
			if isMe and row.placement == 1 and row.completed and #data.rows > 1 then
				Fx.burst(frame, { count = 24, maxDistance = 160 })
			end
		end)
	end

	-- Footer: countdown + host controls
	local footer = Kit.frame({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 52),
		Parent = card,
	})
	local countdown = Kit.text({
		text = "",
		style = "body",
		font = "fontBold",
		tone = "textDim",
		Size = UDim2.new(0.6, 0, 0, 22),
		Parent = footer,
	})
	local bar = Kit.progress({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(0.6, 0, 0, 8), Parent = footer })
	local total = math.max(1, data.nextAt - workspace:GetServerTimeNow())
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not shade.Parent then
			connection:Disconnect()
			return
		end
		local remaining = math.max(0, data.nextAt - workspace:GetServerTimeNow())
		bar.set(1 - remaining / total, false)
		countdown.Text = (data.isFinal and "🏆 Final results in %ds" or "Next round in %ds"):format(
			math.ceil(remaining)
		)
	end)
	if Store.isHost() and not (Store.lobby and Store.lobby.solo) then
		Kit.button({
			text = data.isFinal and "Show final results" or "Next round now",
			emoji = "▶",
			variant = "primary",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(220, 46),
			Parent = footer,
			onClick = function()
				App.request(Net.Actions.NextRound, {})
			end,
		})
	end
end

return RoundResults
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="88">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="89">
              <Properties>
                <string name="Name">FreeRoam</string>
                <string name="Source"><![CDATA[-- Free Roam practice: untimed browsing with search, categories, random pages, full browser
-- navigation, and "start a solo race" (random, or from the page you're reading).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Difficulty = require(Shared.Difficulty)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local WikiBrowser = require(UI.Components.WikiBrowser)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)

local FreeRoam = {}
FreeRoam.__index = FreeRoam

function FreeRoam.new(App)
	local self = setmetatable({ App = App, pending = false, started = false, difficulty = "Easy" }, FreeRoam)
	local frame = Kit.frame({ Name = "FreeRoam", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	local header = Kit.frame(
		{ Size = UDim2.new(1, -24, 0, 50), Position = UDim2.fromOffset(12, 10), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Menu",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			App.show("Menu")
		end,
	})
	Kit.text({ text = "🧭 Free Roam", style = "h1", Size = UDim2.fromOffset(240, 40), Parent = header, order = 2 })
	self.visitedLabel = Kit.chip("0 pages explored", nil, { Parent = header, order = 3, height = 30 })

	local main = Kit.frame({ Position = UDim2.fromOffset(12, 68), Size = UDim2.new(1, -24, 1, -78), Parent = frame })
	self.browserHolder = Kit.frame({ Size = UDim2.new(1, -312, 1, 0), Parent = main })
	self.browser = WikiBrowser.new(self.browserHolder, {
		mode = "free",
		onLink = function(id)
			self:navigate("link", id)
		end,
		onBack = function()
			self:navigate("back")
		end,
		onForward = function()
			self:navigate("forward")
		end,
		onRefresh = function()
			self:navigate("refresh")
		end,
		onHistory = function(id)
			self:navigate("history", id)
		end,
		onRandom = function()
			self:navigate("random")
		end,
		onOpen = function(id)
			self:navigate("open", id)
		end,
		onSearch = function(query, callback)
			task.spawn(function()
				local ok, results = Net.request(Net.Actions.Search, { query = query })
				callback(ok and results or {})
			end)
		end,
		onCategory = function(name)
			self:openCategory(name)
		end,
	})

	local side = Kit.panel({
		Name = "Side",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 300, 1, 0),
		Parent = main,
	}, { Kit.padding(14) })
	self.side = side
	local scroll = Kit.scroll(
		{ Size = UDim2.fromScale(1, 1), Parent = side },
		{ Kit.list("y", 10), Kit.padding(0, 8, 8, 0) }
	)
	Kit.text({ text = "Solo race", style = "h2", Parent = scroll, order = 1 })
	Kit.text({
		text = "Practice against the clock. Solo results count toward stats and world records.",
		style = "tiny",
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 30),
		Parent = scroll,
		order = 2,
	})
	local options = {}
	for _, key in Difficulty.Selectable do
		local def = Difficulty.get(key)
		table.insert(options, { value = key, label = def.emoji })
	end
	self.difficultyControl = Kit.segmented(options, "Easy", function(value)
		self.difficulty = value
		self.difficultyName.Text = Difficulty.get(value).name .. " — " .. Difficulty.get(value).description
	end, { Parent = scroll, order = 3, textSize = 16 })
	self.difficultyName = Kit.text({
		text = "Easy — " .. Difficulty.get("Easy").description,
		style = "tiny",
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 30),
		Parent = scroll,
		order = 4,
	})
	Kit.button({
		text = "Race from this page",
		emoji = "📍",
		variant = "primary",
		Size = UDim2.new(1, 0, 0, 44),
		Parent = scroll,
		order = 5,
		onClick = function(button)
			self:startSolo(true, button)
		end,
	})
	Kit.button({
		text = "Random solo race",
		emoji = "🎲",
		Size = UDim2.new(1, 0, 0, 44),
		Parent = scroll,
		order = 6,
		onClick = function(button)
			self:startSolo(false, button)
		end,
	})
	Kit.divider(7).Parent = scroll
	Kit.text({ text = "Browse categories", style = "h2", Parent = scroll, order = 8 })
	self.categoryList = Kit.frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 9,
		Parent = scroll,
	})
	local wrap = Kit.list("x", 6, "Left", "Top")
	wrap.Wraps = true
	wrap.Parent = self.categoryList

	App.layoutChanged:Connect(function(compact)
		self.side.Visible = not compact
		self.browserHolder.Size = compact and UDim2.fromScale(1, 1) or UDim2.new(1, -312, 1, 0)
	end)
	self.side.Visible = not App.compact
	if App.compact then
		self.browserHolder.Size = UDim2.fromScale(1, 1)
		Kit.iconButton("🏁", function()
			self.side.Visible = not self.side.Visible
		end, { Parent = header, order = 4 })
	end
	return self
end

function FreeRoam:_renderCategories()
	if self.categoriesRendered or not Store.boot then
		return
	end
	self.categoriesRendered = true
	for index, category in Store.boot.categories or {} do
		if index > 60 then
			break
		end
		Kit.button({
			text = ("%s (%d)"):format(category.name, category.count),
			textSize = 12,
			font = "font",
			Size = UDim2.fromOffset(0, 30),
			order = index,
			Parent = self.categoryList,
			onClick = function()
				self:openCategory(category.name)
			end,
		}).AutomaticSize =
			Enum.AutomaticSize.X
	end
end

function FreeRoam:show(args)
	self:_renderCategories()
	if not self.started then
		self.started = true
		self.browser:setLoading(true)
		task.spawn(function()
			local ok, data = Net.request(Net.Actions.StartFreeRoam, { pageId = args and args.pageId })
			self.browser:setLoading(false)
			if ok then
				self:_apply(data, "none")
			else
				self.started = false
				self.browser:showError(data, function()
					self:show(args)
				end)
			end
		end)
	end
end

function FreeRoam:_apply(data, direction)
	self.browser:setPage(data.page, direction)
	local state = data.state
	self.browser:setNav({
		canBack = state.canBack,
		canForward = state.canForward,
		history = state.history,
		redosLeft = -1,
	})
	local stats = Store.profile and Store.profile.stats
	self.visitedLabel.Text = ("🗺️ %d pages explored"):format(stats and stats.freeRoamPages or 0)
end

function FreeRoam:navigate(op: string, pageId: string?)
	if self.pending then
		return
	end
	self.pending = true
	self.browser:setLoading(true)
	task.spawn(function()
		local ok, data = Net.request(Net.Actions.FreeNavigate, { op = op, pageId = pageId })
		self.pending = false
		self.browser:setLoading(false)
		if ok then
			self:_apply(data, (op == "back" or op == "history") and "back" or "forward")
		else
			self.App.toast(data, "error")
		end
	end)
end

function FreeRoam:openCategory(name: string)
	task.spawn(function()
		local ok, data = Net.request(Net.Actions.GetCategory, { name = name })
		if not ok then
			self.App.toast(data, "error")
			return
		end
		self.App.modal({
			title = "📂 Category: " .. data.name,
			width = 520,
			build = function(body, close)
				Kit.text({ text = ("%d pages"):format(#data.pages), style = "small", tone = "textDim", Parent = body })
				local list = Kit.scroll({ Size = UDim2.new(1, 0, 0, 320), Parent = body }, { Kit.list("y", 4) })
				for index, page in data.pages do
					local row = Kit.button({
						text = page.emoji .. "  " .. page.title,
						variant = "ghost",
						textSize = 15,
						font = "font",
						Size = UDim2.new(1, -8, 0, 34),
						order = index,
						Parent = list,
						onClick = function()
							close()
							self:navigate("open", page.id)
						end,
					})
					row.TextXAlignment = Enum.TextXAlignment.Left
					Kit.padding(0, 10, 0, 10).Parent = row
				end
			end,
			buttons = { { text = "Close" } },
		})
	end)
end

function FreeRoam:startSolo(fromCurrent: boolean, button)
	Kit.busy(button, true, "Generating…")
	task.spawn(function()
		local ok, data =
			Net.request(Net.Actions.StartSoloRace, { difficulty = self.difficulty, fromCurrent = fromCurrent })
		Kit.busy(button, false)
		if ok then
			Store.set("lobby", data)
			Anim.pop(button)
		else
			self.App.toast(data, "error")
		end
	end)
end

return FreeRoam
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="90">
              <Properties>
                <string name="Name">Leaderboards</string>
                <string name="Source"><![CDATA[-- World records and global leaderboards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)

local Leaderboards = {}
Leaderboards.__index = Leaderboards

local TABS = {
	{ key = "records", label = "🌍 World Records" },
	{ key = "wins", label = "🥇 Wins" },
	{ key = "completions", label = "🎯 Completions" },
	{ key = "xp", label = "🎓 Rank XP" },
}

function Leaderboards.new(App)
	local self = setmetatable({ App = App, tab = "records", data = nil }, Leaderboards)
	local frame = Kit.frame({ Name = "Leaderboards", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame
	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 50), Position = UDim2.fromOffset(24, 14), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Back",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			App.back("Menu")
		end,
	})
	Kit.text({
		text = "🏆 Leaderboards",
		style = "title",
		Size = UDim2.fromOffset(330, 44),
		Parent = header,
		order = 2,
	})
	Kit.iconButton("⟳", function()
		self:load()
	end, { Parent = header, order = 3 })
	local tabs = Kit.frame(
		{ Position = UDim2.fromOffset(24, 72), Size = UDim2.new(1, -48, 0, 44), Parent = frame },
		{ Kit.list("x", 8, "Left", "Center") }
	)
	self.tabButtons = {}
	for index, tab in TABS do
		self.tabButtons[tab.key] = Kit.button({
			text = tab.label,
			Size = UDim2.fromOffset(190, 40),
			textSize = 15,
			order = index,
			Parent = tabs,
			onClick = function()
				self.tab = tab.key
				self:render()
			end,
		})
	end
	self.list = Kit.scroll(
		{ Position = UDim2.fromOffset(24, 126), Size = UDim2.new(1, -48, 1, -136), Parent = frame },
		{ Kit.list("y", 8), Kit.padding(2, 8, 12, 2) }
	)
	return self
end

function Leaderboards:show()
	self:load()
end

function Leaderboards:load()
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	Kit.text({ text = "Loading…", style = "h3", tone = "textDim", Parent = self.list })
	task.spawn(function()
		local ok, data = Net.request(Net.Actions.GetLeaderboards, {})
		if ok then
			self.data = data
			Store.set("records", data.records)
			self:render()
		else
			for _, child in self.list:GetChildren() do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			Kit.text({ text = "⚠️ " .. tostring(data), style = "h3", tone = "danger", Parent = self.list })
			Kit.button({
				text = "Retry",
				emoji = "⟳",
				Parent = self.list,
				onClick = function()
					self:load()
				end,
			})
		end
	end)
end

local function recordRow(parent, order: number, title: string, record, isClicks: boolean)
	local row = Kit.panel(
		{ Size = UDim2.new(1, -8, 0, 64), LayoutOrder = order, Parent = parent },
		{ Kit.padding(10, 14, 10, 14) }
	)
	Kit.text({ text = title, style = "h3", Size = UDim2.new(0.3, 0, 0, 22), Parent = row })
	if not record then
		Kit.text({
			text = "No record yet — set the first one!",
			style = "small",
			tone = "textFaint",
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(0.6, 0, 0, 18),
			Parent = row,
		})
		return row
	end
	local value = isClicks and (record.clicks .. " clicks · " .. Format.time(record.ms / 1000))
		or Format.time(record.ms / 1000)
	Kit.text({
		text = value,
		style = "h2",
		font = "fontMono",
		tone = "gold",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(240, 44),
		align = Enum.TextXAlignment.Right,
		Parent = row,
	})
	Kit.text({
		text = ("by %s · %s → %s · %s"):format(
			record.name or "?",
			record.start or "?",
			record.target or "?",
			Difficulty.get(record.difficulty).name
		),
		style = "small",
		tone = "textDim",
		truncate = true,
		wrap = false,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, -250, 0, 18),
		Parent = row,
	})
	return row
end

function Leaderboards:render()
	for key, button in self.tabButtons do
		button.BackgroundTransparency = key == self.tab and 0 or 0.5
		button:SetAttribute("BaseTransparency", key == self.tab and 0 or 0.5)
	end
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local data = self.data
	if not data then
		return
	end
	if self.tab == "records" then
		local records = data.records or {}
		local order = 0
		local function add(title, key, isClicks)
			order += 1
			local row = recordRow(self.list, order, title, records[key], isClicks)
			Anim.slideIn(row, UDim2.fromOffset(40, 0), 0.35, order * 0.04)
		end
		add("⚡ Fastest overall", "fastest_overall")
		for _, key in Difficulty.RecordBoards do
			local def = Difficulty.get(key)
			add(def.emoji .. " Fastest " .. def.name, "fastest_" .. key)
		end
		add("🎯 Fewest clicks", "fewest_clicks", true)
		return
	end
	local rows = data.boards and data.boards[self.tab] or {}
	if #rows == 0 then
		Kit.text({ text = "No entries yet. Go race!", style = "h3", tone = "textDim", Parent = self.list })
	end
	local me = game:GetService("Players").LocalPlayer.UserId
	for index, entry in rows do
		local row = Kit.panel(
			{ Size = UDim2.new(1, -8, 0, 54), LayoutOrder = index, Parent = self.list },
			{ Kit.padding(8, 14, 8, 14) },
			entry.userId == me and "surface2" or "surface"
		)
		local medal = ({ "🥇", "🥈", "🥉" })[entry.rank] or ("#" .. entry.rank)
		Kit.text({ text = medal, style = "h3", Size = UDim2.fromOffset(50, 38), Parent = row })
		Kit.avatar(entry.userId, 38, nil, { Parent = row, Position = UDim2.fromOffset(52, 0) })
		local name = Kit.text({
			text = entry.name,
			style = "h3",
			Position = UDim2.fromOffset(100, 0),
			Size = UDim2.new(1, -260, 0, 38),
			Parent = row,
		})
		Kit.hoverable(name, function()
			self.App.show("Profile", { userId = entry.userId })
		end)
		Kit.text({
			text = Format.number(entry.value),
			style = "h2",
			font = "fontMono",
			align = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(140, 38),
			Parent = row,
		})
		Anim.slideIn(row, UDim2.fromOffset(40, 0), 0.3, math.min(index, 20) * 0.03)
	end
end

return Leaderboards
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="91">
              <Properties>
                <string name="Name">Lobbies</string>
                <string name="Source"><![CDATA[-- Public lobby browser (this server + other servers), plus Create Lobby and Join-with-Code.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)

local Lobbies = {}
Lobbies.__index = Lobbies

function Lobbies.new(App)
	local self = setmetatable({ App = App }, Lobbies)
	local frame = Kit.frame({ Name = "Lobbies", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 56), Position = UDim2.fromOffset(24, 16), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.iconButton("←", function()
		App.show("Menu")
	end, { Parent = header, order = 1 })
	Kit.text({ text = "Lobbies", style = "title", Size = UDim2.fromOffset(200, 44), Parent = header, order = 2 })
	local spacer = Kit.frame({ Size = UDim2.new(1, -760, 0, 1), LayoutOrder = 3, Parent = header })
	local _ = spacer
	self.codeBox = Kit.input({
		placeholder = "Lobby code",
		Size = UDim2.fromOffset(150, 44),
		order = 4,
		Parent = header,
		font = "fontMono",
	})
	Kit.button({
		text = "Join",
		emoji = "🔑",
		Size = UDim2.fromOffset(100, 44),
		Parent = header,
		order = 5,
		onClick = function()
			self:joinCode(self.codeBox.Text)
		end,
	})
	Kit.button({
		text = "Create",
		emoji = "➕",
		variant = "primary",
		Size = UDim2.fromOffset(120, 44),
		Parent = header,
		order = 6,
		onClick = function()
			self:openCreate()
		end,
	})
	Kit.iconButton("⟳", function()
		self:refresh(true)
	end, { Parent = header, order = 7 })

	local list = Kit.scroll(
		{ Name = "List", Size = UDim2.new(1, -48, 1, -100), Position = UDim2.fromOffset(24, 84), Parent = frame },
		{ Kit.list("y", 8), Kit.padding(2, 8, 12, 2) }
	)
	self.list = list
	self.empty = Kit.text({
		text = "",
		style = "h3",
		tone = "textDim",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 80),
		Parent = list,
		order = 9999,
	})

	Store.changed:Connect(function(key)
		if key == "lobbies" and frame.Visible then
			self:render(Store.lobbies)
		end
	end)
	return self
end

function Lobbies:show()
	self:refresh(false)
end

function Lobbies:refresh(explicit: boolean)
	self.empty.Text = "Loading lobbies…"
	task.spawn(function()
		local ok, data = Net.request(Net.Actions.ListLobbies, {})
		if ok then
			Store.set("lobbies", data)
			self:render(data)
		else
			self.empty.Text = "Couldn't load lobbies. Tap ⟳ to retry."
			if explicit then
				self.App.toast(data, "error")
			end
		end
	end)
end

function Lobbies:render(lobbies)
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") and child ~= self.empty then
			child:Destroy()
		end
	end
	self.empty.Text = #lobbies == 0 and "No public lobbies right now. Create one!" or ""
	for index, lobby in lobbies do
		local def = Difficulty.get(lobby.difficulty)
		local row = Kit.panel(
			{ Name = "Lobby", Size = UDim2.new(1, 0, 0, 74), LayoutOrder = index, Parent = self.list },
			{ Kit.padding(12, 16, 12, 16) }
		)
		Kit.text({
			text = lobby.name,
			style = "h3",
			truncate = true,
			wrap = false,
			Size = UDim2.new(0.45, 0, 0, 24),
			Parent = row,
		})
		local meta = Kit.frame(
			{ Position = UDim2.fromOffset(0, 28), Size = UDim2.new(0.7, 0, 0, 24), Parent = row },
			{ Kit.list("x", 6, "Left", "Center") }
		)
		Kit.chip(def.emoji .. " " .. def.name, def.color, { Parent = meta, order = 1 })
		Kit.chip("🔁 " .. Format.roundsLabel(lobby.rounds) .. " rounds", nil, { Parent = meta, order = 2 })
		Kit.chip("⏱ " .. Format.timerLabel(lobby.timer, lobby.customSeconds), nil, { Parent = meta, order = 3 })
		local stateText = lobby.state == "InMatch"
				and ("🏁 Racing" .. (lobby.match and (" · round " .. lobby.match.round) or ""))
			or "🟢 Waiting"
		Kit.chip(stateText, nil, { Parent = meta, order = 4 })
		if lobby.remote then
			Kit.chip("🌐 Other server", nil, { Parent = meta, order = 5 })
		end
		local count = Kit.text({
			text = ("👥 %d/%d"):format(lobby.count, lobby.max),
			style = "h3",
			align = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -140, 0.5, 0),
			Size = UDim2.fromOffset(90, 30),
			Parent = row,
		})
		local _ = count
		local full = lobby.count >= lobby.max
		local join = Kit.button({
			text = full and "Full" or "Join",
			variant = full and "secondary" or "primary",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(120, 44),
			Parent = row,
			onClick = function(button)
				if lobby.remote then
					self:joinCode(lobby.code)
				else
					Kit.busy(button, true, "Joining…")
					local ok, data = Net.request(Net.Actions.JoinLobby, { lobbyId = lobby.id })
					Kit.busy(button, false)
					if ok then
						Store.set("lobby", data)
						self.App.show("LobbyRoom")
					else
						self.App.toast(data, "error")
						self:refresh(false)
					end
				end
			end,
		})
		Kit.setDisabled(join, full)
		Anim.slideIn(row, UDim2.fromOffset(40, 0), 0.35, math.min(index, 10) * 0.03)
	end
end

function Lobbies:joinCode(code: string?)
	code = (code or ""):upper():gsub("[^%w]", "")
	if #code ~= Config.Lobby.CodeLength then
		self.App.toast(("Lobby codes are %d characters."):format(Config.Lobby.CodeLength), "error")
		return
	end
	local ok, data = self.App.request(Net.Actions.JoinLobby, { code = code }, "Joining lobby " .. code .. "…")
	if ok and data then
		if data.teleporting then
			self.App.loading("Teleporting to that lobby's server…")
		else
			Store.set("lobby", data)
			self.App.show("LobbyRoom")
		end
	end
end

function Lobbies:openJoinCode()
	local box
	self.App.modal({
		title = "🔑 Join with code",
		build = function(body)
			Kit.text({
				text = "Ask your friend for their 6-character lobby code.",
				style = "small",
				tone = "textDim",
				Parent = body,
				ZIndex = 82,
			})
			box = Kit.input({ placeholder = "e.g. K7QX2M", Parent = body, font = "fontMono", textSize = 22 })
			box.ZIndex = 83
			box.TextXAlignment = Enum.TextXAlignment.Center
		end,
		buttons = {
			{ text = "Cancel" },
			{
				text = "Join",
				variant = "primary",
				onClick = function(close)
					close()
					self:joinCode(box.Text)
				end,
			},
		},
	})
end

function Lobbies:openCreate()
	local nameBox
	local visibility = "private"
	self.App.modal({
		title = "➕ Create a lobby",
		build = function(body)
			nameBox = Kit.input({ placeholder = "Lobby name (optional)", Parent = body })
			nameBox.ZIndex = 83
			Kit.text({ text = "Who can join?", style = "small", font = "fontBold", Parent = body, ZIndex = 82 })
			local seg = Kit.segmented(
				{
					{ value = "private", label = "🔒 Private (code / invite)" },
					{ value = "public", label = "🌐 Public (listed)" },
				},
				visibility,
				function(value)
					visibility = value
				end,
				{ Parent = body }
			)
			seg.frame.ZIndex = 83
			Kit.text({
				text = "You'll be the host: pick difficulty, timer, rounds and visibility options in the lobby.",
				style = "tiny",
				tone = "textFaint",
				Size = UDim2.new(1, 0, 0, 30),
				Parent = body,
				ZIndex = 82,
			})
		end,
		buttons = {
			{ text = "Cancel" },
			{
				text = "Create",
				variant = "primary",
				onClick = function(close)
					close()
					local ok, data = self.App.request(
						Net.Actions.CreateLobby,
						{ name = nameBox.Text ~= "" and nameBox.Text or nil, isPublic = visibility == "public" },
						"Creating lobby…"
					)
					if ok then
						Store.set("lobby", data)
						self.App.show("LobbyRoom")
					end
				end,
			},
		},
	})
end

return Lobbies
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="92">
              <Properties>
                <string name="Name">LobbyRoom</string>
                <string name="Source"><![CDATA[-- Lobby room: members, host controls, match settings, ready/start, invites and chaos buttons.
-- Every control sends a request; the server validates host permissions and pushes the new
-- lobby state back, which re-renders this screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Config = require(Shared.Config)
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Anim = require(UI.Anim)
local ChaosMenu = require(UI.Overlays.ChaosMenu)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local LobbyRoom = {}
LobbyRoom.__index = LobbyRoom

local SHORT_NAMES = {
	SuperEasy = "Super Easy",
	Easy = "Easy",
	Medium = "Medium",
	Hard = "Hard",
	Extreme = "Extreme",
	GiveUp = "Give Up",
}

function LobbyRoom.new(App)
	local self = setmetatable({ App = App, controls = {} }, LobbyRoom)
	local frame = Kit.frame({ Name = "LobbyRoom", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	-- Header -----------------------------------------------------------------------------
	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 60), Position = UDim2.fromOffset(24, 14), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Leave",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			self:leave()
		end,
	})
	self.nameLabel = Kit.text({
		text = "Lobby",
		style = "h1",
		truncate = true,
		wrap = false,
		Size = UDim2.new(1, -620, 0, 40),
		Parent = header,
		order = 2,
	})
	self.visibilityChip = Kit.chip("🔒 Private", nil, { Parent = header, order = 3, height = 32, textSize = 14 })
	local codePanel = Kit.panel(
		{ Size = UDim2.fromOffset(190, 48), LayoutOrder = 4, Parent = header },
		{ Kit.padding(4, 10, 4, 10), Kit.list("y", 0, "Center", "Center") }
	)
	Kit.text({
		text = "LOBBY CODE",
		style = "tiny",
		tone = "textFaint",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 12),
		Parent = codePanel,
		order = 1,
	})
	self.codeLabel = Kit.text({
		text = "······",
		style = "h2",
		font = "fontMono",
		size = 22,
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = codePanel,
		order = 2,
	})
	Kit.button({
		text = "Invite",
		emoji = "📨",
		variant = "primary",
		Size = UDim2.fromOffset(120, 44),
		Parent = header,
		order = 5,
		onClick = function()
			self:invite()
		end,
	})

	-- Body ---------------------------------------------------------------------------------
	local body = Kit.frame({ Size = UDim2.new(1, -48, 1, -170), Position = UDim2.fromOffset(24, 84), Parent = frame })
	self.body = body
	local playersPanel = Kit.panel(
		{ Name = "Players", Size = UDim2.new(0.58, -10, 1, 0), Parent = body },
		{ Kit.padding(14) }
	)
	self.playersPanel = playersPanel
	self.playersTitle =
		Kit.text({ text = "Players", style = "h2", Size = UDim2.new(1, 0, 0, 26), Parent = playersPanel })
	self.memberGrid = Kit.scroll(
		{ Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), Parent = playersPanel },
		{ Kit.grid(UDim2.fromOffset(150, 176), 10) }
	)

	local settingsPanel = Kit.panel({
		Name = "Settings",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.42, -10, 1, 0),
		Parent = body,
	}, { Kit.padding(14) })
	self.settingsPanel = settingsPanel
	local settingsScroll = Kit.scroll(
		{ Size = UDim2.fromScale(1, 1), Parent = settingsPanel },
		{ Kit.list("y", 10), Kit.padding(0, 10, 10, 0) }
	)
	self:_buildSettings(settingsScroll)

	-- Footer ------------------------------------------------------------------------------
	local footer = Kit.panel({
		Name = "Footer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -14),
		Size = UDim2.new(1, -48, 0, 66),
		Parent = frame,
	}, { Kit.padding(10, 14, 10, 14) })
	self.status = Kit.text({
		text = "",
		style = "body",
		font = "fontBold",
		tone = "textDim",
		Size = UDim2.new(0.34, 0, 1, 0),
		Parent = footer,
	})
	local buttons = Kit.frame({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.66, 0, 1, 0),
		Parent = footer,
	}, { Kit.list("x", 8, "Right", "Center") })
	self.rigPlayerButton = Kit.button({
		text = "Rig a player",
		emoji = "🤡",
		Size = UDim2.fromOffset(150, 46),
		Parent = buttons,
		order = 1,
		onClick = function()
			ChaosMenu.rigPlayer(App)
		end,
	})
	self.rigServerButton = Kit.button({
		text = ("RIG SERVER · %d R$"):format(Config.Products.ServerRig.price),
		emoji = "🎰",
		variant = "danger",
		Size = UDim2.fromOffset(200, 46),
		Parent = buttons,
		order = 2,
		onClick = function()
			ChaosMenu.serverRig(App)
		end,
	})
	self.readyButton = Kit.button({
		text = "Ready",
		emoji = "✅",
		variant = "success",
		Size = UDim2.fromOffset(130, 46),
		Parent = buttons,
		order = 3,
		onClick = function()
			self:toggleReady()
		end,
	})
	self.startButton = Kit.button({
		text = "START MATCH",
		emoji = "▶",
		variant = "primary",
		textSize = 18,
		Size = UDim2.fromOffset(190, 46),
		Parent = buttons,
		order = 4,
		onClick = function(button)
			Kit.busy(button, true, "Starting…")
			local ok, err = Net.request(Net.Actions.StartMatch, {})
			Kit.busy(button, false)
			if not ok then
				App.toast(err, "error")
			end
		end,
	})
	Anim.pulse(Anim.scaleOf(self.startButton), "Scale", 1, 1.04, 1.4)

	App.layoutChanged:Connect(function(compact)
		self:_layout(compact)
	end)
	self:_layout(App.compact)

	Store.changed:Connect(function(key)
		if key == "lobby" and frame.Visible then
			self:render()
		end
	end)
	return self
end

function LobbyRoom:_layout(compact: boolean)
	if compact then
		self.playersPanel.Size = UDim2.new(0.5, -6, 1, 0)
		self.settingsPanel.Size = UDim2.new(0.5, -6, 1, 0)
		self.memberGrid:FindFirstChildOfClass("UIGridLayout").CellSize = UDim2.fromOffset(130, 164)
	else
		self.playersPanel.Size = UDim2.new(0.58, -10, 1, 0)
		self.settingsPanel.Size = UDim2.new(0.42, -10, 1, 0)
		self.memberGrid:FindFirstChildOfClass("UIGridLayout").CellSize = UDim2.fromOffset(150, 176)
	end
end

local function sectionTitle(parent, text: string, order: number)
	return Kit.text({
		text = text,
		style = "small",
		font = "fontBold",
		tone = "textDim",
		Parent = parent,
		order = order,
	})
end

local function toggleRow(parent, label: string, hint: string, order: number, onChange)
	local row = Kit.frame({ Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, Parent = parent })
	Kit.text({ text = label, style = "body", font = "fontBold", Size = UDim2.new(1, -70, 0, 22), Parent = row })
	Kit.text({
		text = hint,
		style = "tiny",
		tone = "textFaint",
		Size = UDim2.new(1, -70, 0, 16),
		Position = UDim2.fromOffset(0, 22),
		Parent = row,
	})
	local toggle = Kit.toggle(false, onChange, { Parent = row })
	toggle.frame.AnchorPoint = Vector2.new(1, 0.5)
	toggle.frame.Position = UDim2.new(1, 0, 0.5, 0)
	return toggle
end

function LobbyRoom:_update(patch)
	task.spawn(function()
		local ok, err = Net.request(Net.Actions.UpdateLobby, { settings = patch })
		if not ok then
			self.App.toast(err, "error")
			self:render()
		end
	end)
end

function LobbyRoom:_buildSettings(parent)
	Kit.text({ text = "Match settings", style = "h2", Parent = parent, order = 0 })
	self.hostNote = Kit.text({ text = "", style = "tiny", tone = "textFaint", Parent = parent, order = 1 })

	sectionTitle(parent, "DIFFICULTY", 2)
	local difficultyOptions = {}
	for _, key in Difficulty.Selectable do
		table.insert(difficultyOptions, { value = key, label = SHORT_NAMES[key] })
	end
	self.controls.difficulty = Kit.segmented(difficultyOptions, "Easy", function(value)
		self:_update({ difficulty = value })
	end, { Parent = parent, order = 3, textSize = 12, Size = UDim2.new(1, 0, 0, 40) })
	self.difficultyHint = Kit.text({
		text = "",
		style = "tiny",
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 30),
		Parent = parent,
		order = 4,
	})

	sectionTitle(parent, "TIMER", 5)
	self.controls.timer = Kit.segmented(
		{
			{ value = "120", label = "2 min" },
			{ value = "300", label = "5 min" },
			{ value = "unlimited", label = "∞ Unlimited" },
			{ value = "custom", label = "Custom" },
		},
		"300",
		function(value)
			self:_update({ timer = value })
		end,
		{ Parent = parent, order = 6 }
	)
	local customRow = Kit.frame(
		{ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 7, Parent = parent },
		{ Kit.list("x", 8, "Left", "Center") }
	)
	self.customRow = customRow
	Kit.text({
		text = "Custom time (seconds):",
		style = "small",
		Size = UDim2.fromOffset(170, 30),
		Parent = customRow,
		order = 1,
	})
	self.customBox = Kit.input({
		text = "180",
		Size = UDim2.fromOffset(90, 36),
		order = 2,
		Parent = customRow,
		font = "fontMono",
		onSubmit = function(text)
			local seconds = tonumber(text)
			if
				not seconds
				or seconds % 1 ~= 0
				or seconds < Config.Race.CustomTimerMin
				or seconds > Config.Race.CustomTimerMax
			then
				self.App.toast(
					("Enter whole seconds between %d and %d."):format(
						Config.Race.CustomTimerMin,
						Config.Race.CustomTimerMax
					),
					"error"
				)
				self:render()
				return
			end
			self:_update({ customSeconds = seconds, timer = "custom" })
		end,
	})
	self.customPreview = Kit.text({
		text = "",
		style = "small",
		tone = "textDim",
		Size = UDim2.fromOffset(80, 30),
		Parent = customRow,
		order = 3,
	})

	sectionTitle(parent, "ROUNDS", 8)
	local roundRow = Kit.frame(
		{ Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 9, Parent = parent },
		{ Kit.list("x", 8, "Left", "Center") }
	)
	self.roundMinus = Kit.iconButton("−", function()
		self:_stepRounds(-1)
	end, { Parent = roundRow, order = 1 })
	self.roundLabel = Kit.text({
		text = "3 rounds",
		style = "h3",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(130, 36),
		Parent = roundRow,
		order = 2,
	})
	self.roundPlus = Kit.iconButton("+", function()
		self:_stepRounds(1)
	end, { Parent = roundRow, order = 3 })
	self.roundUnlimited = Kit.button({
		text = "∞ Unlimited",
		Size = UDim2.fromOffset(130, 40),
		Parent = roundRow,
		order = 4,
		onClick = function()
			self:_update({ rounds = 0 })
		end,
	})

	sectionTitle(parent, "VISIBILITY", 10)
	self.controls.showMeters = toggleRow(
		parent,
		"Show player meters",
		"Everyone sees opponents' Freezing…Burning status",
		11,
		function(value)
			self:_update({ showMeters = value })
		end
	)
	self.controls.showPages = toggleRow(
		parent,
		"Show current pages",
		"Everyone sees which article opponents are on",
		12,
		function(value)
			self:_update({ showPages = value })
		end
	)
	self.controls.allowChaos = toggleRow(
		parent,
		"Allow targeted chaos",
		"Lets players rig each other with 🤡 effects",
		13,
		function(value)
			self:_update({ allowChaos = value })
		end
	)
	self.controls.isPublic = toggleRow(parent, "Public lobby", "Listed in the lobby browser", 14, function(value)
		task.spawn(function()
			local ok, err = Net.request(Net.Actions.UpdateLobby, { isPublic = value })
			if not ok then
				self.App.toast(err, "error")
			end
		end)
	end)
end

function LobbyRoom:_stepRounds(delta: number)
	local lobby = Store.lobby
	if not lobby then
		return
	end
	local options = {}
	for _, value in Config.Race.RoundOptions do
		if value > 0 then
			table.insert(options, value)
		end
	end
	local current = lobby.settings.rounds
	local index = table.find(options, current) or (delta > 0 and 0 or #options + 1)
	index = math.clamp(index + delta, 1, #options)
	self:_update({ rounds = options[index] })
end

function LobbyRoom:_memberCard(member, index: number, lobby)
	local me = Players.LocalPlayer.UserId
	local card = Kit.panel(
		{ Name = tostring(member.userId), LayoutOrder = index, Parent = self.memberGrid },
		{ Kit.padding(10), Kit.list("y", 4, "Center", "Top") },
		member.userId == me and "surface2" or "surface"
	)
	if member.look and member.look.vip then
		Kit.stroke("gold", 2, 0.1).Parent = card
	end
	local avatarHolder = Kit.frame({ Size = UDim2.fromOffset(70, 70), LayoutOrder = 1, Parent = card })
	Kit.avatar(member.userId, 70, member.look, { Parent = avatarHolder })
	if member.isHost then
		Kit.text({
			text = "👑",
			size = 24,
			Size = UDim2.fromOffset(30, 30),
			Position = UDim2.fromOffset(46, -8),
			Parent = avatarHolder,
		})
	end
	Kit.nameBlock(member.displayName, member.look, {
		Parent = card,
		order = 2,
		hAlign = "Center",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 36),
		nameSize = 15,
	})
	Kit.chip(
		member.rank.emoji .. " " .. member.rank.name,
		nil,
		{ Parent = card, order = 3, height = 20, textSize = 11 }
	)
	local readyText = lobby.isPublic and (member.ready and "✅ Ready" or "⏳ Not ready")
		or (member.isHost and "Host" or "")
	Kit.text({
		text = readyText,
		style = "tiny",
		tone = member.ready and "success" or "textFaint",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 16),
		Parent = card,
		order = 4,
	})
	Kit.hoverable(card, function()
		self:_memberMenu(member, lobby)
	end)
	Anim.punchIn(card, 0.9)
end

function LobbyRoom:_memberMenu(member, lobby)
	local App = self.App
	local me = Players.LocalPlayer.UserId
	local isHost = lobby.hostId == me
	App.modal({
		title = member.displayName,
		width = 380,
		build = function(body, close)
			Kit.button({
				text = "View profile",
				emoji = "👤",
				Size = UDim2.new(1, 0, 0, 44),
				Parent = body,
				onClick = function()
					close()
					App.show("Profile", { userId = member.userId })
				end,
			})
			if member.userId ~= me then
				Kit.button({
					text = "Rig this player",
					emoji = "🤡",
					Size = UDim2.new(1, 0, 0, 44),
					Parent = body,
					onClick = function()
						close()
						ChaosMenu.rigPlayer(App, member.userId)
					end,
				})
			end
			if isHost and member.userId ~= me then
				Kit.button({
					text = "Make host",
					emoji = "👑",
					Size = UDim2.new(1, 0, 0, 44),
					Parent = body,
					onClick = function()
						close()
						App.request(Net.Actions.TransferHost, { userId = member.userId })
					end,
				})
				Kit.button({
					text = "Remove from lobby",
					emoji = "🚪",
					variant = "danger",
					Size = UDim2.new(1, 0, 0, 44),
					Parent = body,
					onClick = function()
						close()
						App.request(Net.Actions.KickPlayer, { userId = member.userId })
					end,
				})
			end
		end,
		buttons = { { text = "Close" } },
	})
end

function LobbyRoom:render()
	local lobby = Store.lobby
	if not lobby then
		return
	end
	local me = Players.LocalPlayer.UserId
	local isHost = lobby.hostId == me
	local settings = lobby.settings

	self.nameLabel.Text = lobby.name
	self.visibilityChip.Text = lobby.isPublic and "🌐 Public" or "🔒 Private"
	self.codeLabel.Text = lobby.code
	self.playersTitle.Text = ("Players  %d/%d"):format(#lobby.members, lobby.maxPlayers)

	for _, child in self.memberGrid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for index, member in lobby.members do
		self:_memberCard(member, index, lobby)
	end

	-- Settings
	self.hostNote.Text = isHost and "You're the host — changes apply to the next match."
		or "Only the host can change these."
	self.controls.difficulty.set(settings.difficulty)
	self.difficultyHint.Text = Difficulty.get(settings.difficulty).description
	self.controls.timer.set(settings.timer)
	self.customRow.Visible = settings.timer == "custom"
	self.customBox.Text = tostring(settings.customSeconds)
	self.customPreview.Text = "= " .. Format.clock(settings.customSeconds)
	self.roundLabel.Text = settings.rounds == 0 and "∞ Unlimited"
		or (settings.rounds .. (settings.rounds == 1 and " round" or " rounds"))
	self.controls.showMeters.set(settings.showMeters)
	self.controls.showPages.set(settings.showPages)
	self.controls.allowChaos.set(settings.allowChaos)
	self.controls.isPublic.set(lobby.isPublic)
	for key, control in self.controls do
		control.setEnabled(isHost and not (key == "isPublic" and (lobby.standing or lobby.solo)))
	end
	self.customBox.TextEditable = isHost
	for _, button in { self.roundMinus, self.roundPlus, self.roundUnlimited } do
		Kit.setDisabled(button, not isHost)
	end

	-- Footer
	local myReady = false
	for _, member in lobby.members do
		if member.userId == me then
			myReady = member.ready
		end
	end
	self.readyButton.Visible = lobby.isPublic and lobby.state == "Waiting"
	self.readyButton.Text = myReady and "✅  Ready!" or "⏳  Ready up"
	Theme.bind(self.readyButton, {
		BackgroundColor3 = myReady and "success" or "surface2",
		TextColor3 = myReady and function()
			return Color3.new(1, 1, 1)
		end or "text",
	})
	self.startButton.Visible = isHost and lobby.state == "Waiting"
	self.rigPlayerButton.Visible = settings.allowChaos and #lobby.members > 1

	local status
	if lobby.state == "InMatch" then
		local match = lobby.match
		status = ("🏁 Match in progress%s — you'll join at the next round."):format(
			match and (" · round " .. match.round) or ""
		)
	elseif lobby.autoStartAt then
		status = "🚀 Everyone's ready — starting soon!"
	elseif isHost then
		status = #lobby.members > 1 and "👑 Start whenever you're ready."
			or "👑 Invite friends, or start a solo match."
	elseif lobby.isPublic then
		status = lobby.hostId and "Ready up! The race starts when everyone is ready or the host starts it."
			or "Waiting for players…"
	else
		status = "⏳ Waiting for the host to start…"
	end
	self.status.Text = status
end

function LobbyRoom:toggleReady()
	local lobby = Store.lobby
	if not lobby then
		return
	end
	local me = Players.LocalPlayer.UserId
	local ready = false
	for _, member in lobby.members do
		if member.userId == me then
			ready = member.ready
		end
	end
	task.spawn(function()
		local ok, err = Net.request(Net.Actions.SetReady, { ready = not ready })
		if not ok then
			self.App.toast(err, "error")
		elseif not ready then
			Sound.play("tempUp")
		end
	end)
end

function LobbyRoom:invite()
	local lobby = Store.lobby
	if not lobby then
		return
	end
	local player = Players.LocalPlayer
	local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
	if ok and canInvite then
		local options = Instance.new("ExperienceInviteOptions")
		options.PromptMessage = ("Race me in Wiki Race! Lobby code: %s"):format(lobby.code)
		options.LaunchData = "lobby:" .. lobby.code
		pcall(SocialService.PromptGameInvite, SocialService, player, options)
	else
		self.App.toast(("Share this code with friends: %s"):format(lobby.code), "info")
	end
end

function LobbyRoom:leave()
	task.spawn(function()
		Net.request(Net.Actions.LeaveLobby, {})
	end)
	Store.set("lobby", nil)
	self.App.show("Menu")
end

function LobbyRoom:show()
	self:render()
end

return LobbyRoom
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="93">
              <Properties>
                <string name="Name">Menu</string>
                <string name="Source"><![CDATA[-- Main menu: the first minute has to explain the game — start page, target page, click links,
-- get there first — then offer every way in (Quick Play, lobbies, codes, Free Roam).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Format = require(Shared.Format)
local Temperature = require(Shared.Temperature)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Anim = require(UI.Anim)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)

local Menu = {}
Menu.__index = Menu

function Menu.new(App)
	local self = setmetatable({ App = App }, Menu)
	local frame = Kit.frame({ Name = "Menu", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	-- Top bar ------------------------------------------------------------------------------
	local top = Kit.frame(
		{ Name = "TopBar", Size = UDim2.new(1, -32, 0, 56), Position = UDim2.fromOffset(16, 12), Parent = frame },
		{ Kit.list("x", 8, "Right", "Center") }
	)
	self.coins = Kit.chip("🪙 0", nil, { Parent = top, order = 1, height = 36, textSize = 16 })
	self.rank = Kit.chip("🌱 Rookie", nil, { Parent = top, order = 2, height = 36, textSize = 15 })
	Kit.iconButton("🛍️", function()
		App.show("Shop")
	end, { Parent = top, order = 3 })
	Kit.iconButton("🏆", function()
		App.show("Leaderboards")
	end, { Parent = top, order = 4 })
	Kit.iconButton("⚙️", function()
		App.show("Settings")
	end, { Parent = top, order = 5 })
	local me = Players.LocalPlayer
	self.avatar = Kit.avatar(me.UserId, 44, nil, { Parent = top, order = 6 })
	Kit.hoverable(self.avatar, function()
		App.show("Profile", { userId = me.UserId })
	end)

	-- Body -------------------------------------------------------------------------------------
	local body = Kit.scroll({
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -80),
		Position = UDim2.fromOffset(0, 76),
		Parent = frame,
	})
	self.body = body
	local columns = Kit.frame({
		Name = "Columns",
		Size = UDim2.new(1, -64, 0, 0),
		Position = UDim2.fromOffset(32, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = body,
	})
	self.columns = columns
	self.layout = Kit.list("x", 28, "Center", "Top")
	self.layout.Parent = columns

	-- Hero column
	local hero = Kit.frame({
		Name = "Hero",
		Size = UDim2.new(0.58, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = columns,
	}, { Kit.list("y", 14) })
	self.hero = hero
	local logo = Kit.text({
		text = "WIKI RACE",
		style = "display",
		size = 76,
		Size = UDim2.new(1, 0, 0, 84),
		Parent = hero,
		order = 1,
	})
	local logoGradient = Instance.new("UIGradient")
	logoGradient.Parent = logo
	local function paintLogo()
		local t = Theme.current
		logoGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, t.accent),
			ColorSequenceKeypoint.new(0.5, t.accent2),
			ColorSequenceKeypoint.new(1, t.accent),
		})
	end
	paintLogo()
	Theme.changed:Connect(paintLogo)
	Theme.bind(logo, {
		TextColor3 = function()
			return Color3.new(1, 1, 1)
		end,
	})
	task.spawn(function()
		while logo.Parent do
			logoGradient.Offset = Vector2.new(-1, 0)
			Anim.tween(logoGradient, 3.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear)
			task.wait(4.5)
		end
	end)
	Kit.text({
		text = "Start on one page. Reach another. Only by clicking links.",
		style = "h2",
		size = 22,
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 30),
		Parent = hero,
		order = 2,
	})

	local steps = Kit.frame({ Name = "Steps", Size = UDim2.new(1, 0, 0, 150), Parent = hero }, { Kit.list("x", 12) })
	steps.LayoutOrder = 3
	local STEPS = {
		{ "📄", "Your start page", "Everyone begins on the same random article." },
		{ "🎯", "Your target", "A page from a totally different corner of the wiki." },
		{ "🔗", "Click links only", "No search. Hop article to article. Fastest wins." },
	}
	for index, step in STEPS do
		local card = Kit.panel(
			{ Size = UDim2.new(1 / 3, -8, 1, 0), LayoutOrder = index, Parent = steps },
			{ Kit.padding(14), Kit.list("y", 4) }
		)
		Kit.text({ text = step[1], size = 34, Size = UDim2.new(1, 0, 0, 40), Parent = card, order = 1 })
		Kit.text({ text = ("%d. %s"):format(index, step[2]), style = "h3", Parent = card, order = 2 })
		Kit.text({
			text = step[3],
			style = "small",
			tone = "textDim",
			Size = UDim2.new(1, 0, 0, 44),
			Parent = card,
			order = 3,
		})
		Anim.slideIn(card, UDim2.fromOffset(0, 30), 0.6, 0.1 * index)
	end

	-- Temperature legend: teaches the hot/cold meter up front.
	local legend = Kit.panel(
		{ Name = "Legend", Size = UDim2.new(1, 0, 0, 64), Parent = hero },
		{ Kit.padding(10, 14, 10, 14), Kit.list("x", 6, "Left", "Center") }
	)
	legend.LayoutOrder = 4
	Kit.text({
		text = "The meter tells you how close you are:",
		style = "small",
		font = "fontBold",
		Size = UDim2.fromOffset(150, 40),
		Parent = legend,
		order = 0,
	})
	for index, key in { "Freezing", "Cold", "Warm", "Hot", "Burning" } do
		local info = Temperature.Info[key]
		Kit.chip(
			info.emoji .. " " .. info.label,
			info.color,
			{ Parent = legend, order = index, height = 28, textSize = 12 }
		)
	end

	self.recordTeaser = Kit.text({
		text = "",
		style = "small",
		tone = "textFaint",
		Size = UDim2.new(1, 0, 0, 20),
		Parent = hero,
		order = 5,
	})

	-- Actions column
	local actions = Kit.panel({
		Name = "Actions",
		Size = UDim2.new(0.42, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = columns,
	}, { Kit.padding(18), Kit.list("y", 10) })
	self.actions = actions
	Kit.text({ text = "Play", style = "h1", Parent = actions, order = 0 })
	local quick = Kit.button({
		text = "QUICK PLAY",
		emoji = "⚡",
		variant = "primary",
		textSize = 22,
		Size = UDim2.new(1, 0, 0, 64),
		Parent = actions,
		order = 1,
		onClick = function(button)
			Kit.busy(button, true, "Finding a race…")
			local ok, data = Net.request(Net.Actions.QuickPlay, {})
			Kit.busy(button, false)
			if ok then
				Store.set("lobby", data)
				App.show("LobbyRoom")
			else
				App.toast(data, "error")
			end
		end,
	})
	Anim.pulse(Anim.scaleOf(quick), "Scale", 1, 1.03, 1.6)
	Kit.button({
		text = "Browse Lobbies",
		emoji = "🌐",
		Size = UDim2.new(1, 0, 0, 50),
		Parent = actions,
		order = 2,
		onClick = function()
			App.show("Lobbies")
		end,
	})
	Kit.button({
		text = "Create Lobby",
		emoji = "➕",
		Size = UDim2.new(1, 0, 0, 50),
		Parent = actions,
		order = 3,
		onClick = function()
			App.screens.Lobbies:openCreate()
		end,
	})
	Kit.button({
		text = "Join with Code",
		emoji = "🔑",
		Size = UDim2.new(1, 0, 0, 50),
		Parent = actions,
		order = 4,
		onClick = function()
			App.screens.Lobbies:openJoinCode()
		end,
	})
	Kit.divider(5).Parent = actions
	Kit.button({
		text = "Free Roam Practice",
		emoji = "🧭",
		Size = UDim2.new(1, 0, 0, 50),
		Parent = actions,
		order = 6,
		onClick = function()
			App.show("FreeRoam")
		end,
	})
	self.footer = Kit.text({
		text = "",
		style = "tiny",
		tone = "textFaint",
		align = Enum.TextXAlignment.Center,
		Parent = actions,
		order = 7,
	})

	App.layoutChanged:Connect(function(compact)
		self:_layout(compact)
	end)
	self:_layout(App.compact)
	Store.changed:Connect(function(key)
		if key == "profile" or key == "records" or key == "boot" then
			self:refresh()
		end
	end)
	return self
end

function Menu:_layout(compact: boolean)
	if compact then
		self.layout.FillDirection = Enum.FillDirection.Vertical
		self.hero.Size = UDim2.new(1, 0, 0, 0)
		self.actions.Size = UDim2.new(1, 0, 0, 0)
	else
		self.layout.FillDirection = Enum.FillDirection.Horizontal
		self.hero.Size = UDim2.new(0.58, -14, 0, 0)
		self.actions.Size = UDim2.new(0.42, -14, 0, 0)
	end
end

function Menu:refresh()
	local profile = Store.profile
	if profile then
		self.coins.Text = "🪙 " .. Format.number(profile.coins)
		self.rank.Text = profile.rank.emoji .. " " .. profile.rank.name
		local look = { frame = profile.equipped and profile.equipped.frame }
		local image = self.avatar:FindFirstChild("Image")
		if image then
			Kit.applyFrame(image, look.frame or "frame_none", 2)
		end
	end
	local record = Store.records and Store.records.fastest_overall
	if record then
		self.recordTeaser.Text = ("🌍 World record: %s by %s (%s → %s)"):format(
			Format.time(record.ms / 1000),
			record.name,
			record.start or "?",
			record.target or "?"
		)
	else
		self.recordTeaser.Text = "🌍 No world record yet — it could be yours."
	end
	if Store.boot then
		self.footer.Text = ("%s pages in the wiki · 10 players per lobby"):format(
			Format.number(Store.boot.pageCount or 0)
		)
	end
end

function Menu:show()
	self:refresh()
end

return Menu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="94">
              <Properties>
                <string name="Name">Profile</string>
                <string name="Source"><![CDATA[-- Player profile: avatar + cosmetics, rank progress, statistics, difficulty completions and
-- achievements. Works for yourself and for inspecting any other player.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Achievements = require(Shared.Achievements)
local Catalog = require(Shared.Catalog)
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Anim = require(UI.Anim)
local Net = require(UI.Parent.Core.Net)

local Profile = {}
Profile.__index = Profile

function Profile.new(App)
	local self = setmetatable({ App = App }, Profile)
	local frame = Kit.frame({ Name = "Profile", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame
	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 50), Position = UDim2.fromOffset(24, 14), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Back",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			App.back("Menu")
		end,
	})
	self.title =
		Kit.text({ text = "Profile", style = "title", Size = UDim2.fromOffset(500, 44), Parent = header, order = 2 })
	self.content = Kit.scroll(
		{ Position = UDim2.fromOffset(24, 74), Size = UDim2.new(1, -48, 1, -84), Parent = frame },
		{ Kit.list("y", 14), Kit.padding(0, 10, 20, 0) }
	)
	return self
end

local function statTile(parent, emoji: string, label: string, value: string, order: number)
	local tile = Kit.panel(
		{ Size = UDim2.fromOffset(170, 84), LayoutOrder = order, Parent = parent },
		{ Kit.padding(10), Kit.list("y", 2) }
	)
	Kit.text({
		text = emoji .. " " .. label,
		style = "tiny",
		tone = "textFaint",
		font = "fontBold",
		Parent = tile,
		order = 1,
	})
	Kit.text({ text = value, style = "h1", size = 26, font = "fontMono", Parent = tile, order = 2 })
	return tile
end

function Profile:show(args)
	local userId = args and args.userId or Players.LocalPlayer.UserId
	for _, child in self.content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local loading = Kit.text({ text = "Loading profile…", style = "h3", tone = "textDim", Parent = self.content })
	task.spawn(function()
		local ok, profile = Net.request(Net.Actions.GetProfile, { userId = userId })
		loading:Destroy()
		if not ok then
			Kit.text({ text = "⚠️ " .. tostring(profile), style = "h3", tone = "danger", Parent = self.content })
			Kit.button({
				text = "Retry",
				emoji = "⟳",
				Parent = self.content,
				onClick = function()
					self:show(args)
				end,
			})
			return
		end
		self:render(profile)
	end)
end

function Profile:render(profile)
	local isMe = profile.userId == Players.LocalPlayer.UserId
	self.title.Text = isMe and "Your profile" or (profile.displayName .. "'s profile")
	local stats = profile.stats
	local look = profile.look or {}
	local equipped = profile.equipped or {}

	-- Identity card
	local card = Kit.panel(
		{ Size = UDim2.new(1, 0, 0, 170), LayoutOrder = 1, Parent = self.content },
		{ Kit.padding(18) }
	)
	Kit.avatar(profile.userId, 128, { frame = equipped.frame }, { Parent = card })
	local titleItem = Catalog.ById[equipped.title or ""]
	local badgeItem = Catalog.ById[equipped.badge or ""]
	local nameBlock = Kit.nameBlock(profile.displayName, {
		title = titleItem and titleItem.text or look.title,
		badge = badgeItem and badgeItem.glyph or look.badge,
		vip = look.vip,
	}, { Parent = card, Size = UDim2.new(1, -170, 0, 60), style = "title", nameSize = 30 })
	nameBlock.Position = UDim2.fromOffset(150, 0)
	Kit.text({
		text = "@" .. profile.name .. (profile.online and "  · 🟢 online" or ""),
		style = "small",
		tone = "textFaint",
		Position = UDim2.fromOffset(150, 62),
		Size = UDim2.new(1, -170, 0, 18),
		Parent = card,
	})
	local rank = profile.rank
	Kit.chip(
		rank.emoji .. " " .. rank.name .. " · " .. Format.number(rank.xp) .. " XP",
		nil,
		{ Parent = card, Position = UDim2.fromOffset(150, 90), height = 30, textSize = 15 }
	)
	local bar = Kit.progress({ Position = UDim2.fromOffset(150, 132), Size = UDim2.new(1, -170, 0, 10), Parent = card })
	bar.set(rank.progress or 1, true)

	-- Stats grid
	Kit.text({ text = "Statistics", style = "h2", Parent = self.content, order = 2 })
	local grid = Kit.frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = self.content,
	})
	local wrap = Kit.list("x", 10, "Left", "Top")
	wrap.Wraps = true
	wrap.Parent = grid
	local tiles = {
		{ "🏁", "Races", Format.number(stats.races) },
		{ "🥇", "Match wins", Format.number(stats.wins) },
		{ "🏆", "Round wins", Format.number(stats.roundWins) },
		{ "🎯", "Completions", Format.number(stats.completions) },
		{ "⚡", "Fastest", stats.fastestTime and Format.time(stats.fastestTime) or "—" },
		{ "🖱", "Fewest clicks", stats.fewestClicks and tostring(stats.fewestClicks) or "—" },
		{ "🖱", "Total clicks", Format.number(stats.totalClicks) },
		{ "♻", "Redos used", Format.number(stats.totalRedos) },
		{ "🏳️", "Give-ups", Format.number(stats.giveUps) },
		{ "🎮", "Matches", Format.number(stats.matches) },
		{ "☄️", "Times Burning", Format.number(stats.burningReached) },
		{ "🌍", "World records", Format.number(stats.recordsSet or 0) },
	}
	for index, tile in tiles do
		local t = statTile(grid, tile[1], tile[2], tile[3], index)
		Anim.slideIn(t, UDim2.fromOffset(0, 20), 0.35, index * 0.03)
	end

	-- Difficulty completions
	Kit.text({ text = "Completions by difficulty", style = "h2", Parent = self.content, order = 4 })
	local diffRow = Kit.frame(
		{ Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 5, Parent = self.content },
		{ Kit.list("x", 8) }
	)
	for index, key in Difficulty.Order do
		local def = Difficulty.get(key)
		local count = (stats.difficultyCompletions or {})[key] or 0
		local tile = Kit.panel(
			{ Size = UDim2.new(1 / #Difficulty.Order, -7, 1, 0), LayoutOrder = index, Parent = diffRow },
			{ Kit.padding(8), Kit.list("y", 0, "Center", "Center") }
		)
		Kit.text({
			text = def.emoji .. " " .. def.name,
			style = "tiny",
			font = "fontBold",
			align = Enum.TextXAlignment.Center,
			Parent = tile,
			order = 1,
		})
		Kit.text({
			text = tostring(count),
			style = "h2",
			font = "fontMono",
			align = Enum.TextXAlignment.Center,
			Parent = tile,
			order = 2,
		})
	end

	-- Achievements
	local unlocked = 0
	for _ in profile.achievements or {} do
		unlocked += 1
	end
	Kit.text({
		text = ("Achievements  %d/%d"):format(unlocked, #Achievements.List),
		style = "h2",
		Parent = self.content,
		order = 6,
	})
	local achGrid = Kit.frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 7,
		Parent = self.content,
	})
	local achWrap = Kit.list("x", 10, "Left", "Top")
	achWrap.Wraps = true
	achWrap.Parent = achGrid
	for index, def in Achievements.List do
		local done = profile.achievements and profile.achievements[def.id] ~= nil
		local tile = Kit.panel(
			{ Size = UDim2.fromOffset(250, 76), LayoutOrder = index, Parent = achGrid },
			{ Kit.padding(10) },
			done and "surface2" or "surface"
		)
		if done then
			Kit.stroke("gold", 1.5, 0.2).Parent = tile
		end
		local icon = Kit.text({
			text = done and def.emoji or "🔒",
			size = 30,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(40, 56),
			Parent = tile,
		})
		icon.TextTransparency = done and 0 or 0.4
		Kit.text({
			text = def.name,
			style = "h3",
			size = 15,
			Size = UDim2.new(1, -48, 0, 20),
			Position = UDim2.fromOffset(46, 0),
			Parent = tile,
			tone = done and "text" or "textDim",
		})
		Kit.text({
			text = def.description,
			style = "tiny",
			tone = "textFaint",
			Size = UDim2.new(1, -48, 0, 28),
			Position = UDim2.fromOffset(46, 20),
			Parent = tile,
		})
		if def.goal and not done then
			local p =
				Kit.progress({ Position = UDim2.new(0, 46, 1, -8), Size = UDim2.new(1, -48, 0, 5), Parent = tile })
			p.set(math.min(1, (stats[def.stat] or 0) / def.goal), false)
		end
	end

	-- Equipped cosmetics
	Kit.text({ text = "Cosmetics", style = "h2", Parent = self.content, order = 8 })
	local cosRow = Kit.frame({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 9,
		Parent = self.content,
	})
	local cosWrap = Kit.list("x", 8, "Left", "Top")
	cosWrap.Wraps = true
	cosWrap.Parent = cosRow
	for index, slot in Catalog.SlotOrder do
		local item = Catalog.ById[equipped[slot] or ""]
		if item then
			Kit.chip(
				Catalog.Slots[slot].name .. ": " .. item.name,
				nil,
				{ Parent = cosRow, order = index, height = 28 }
			)
		end
	end
	if isMe then
		Kit.button({
			text = "Customize in the Shop",
			emoji = "🛍️",
			variant = "primary",
			Size = UDim2.fromOffset(260, 44),
			Parent = self.content,
			order = 10,
			onClick = function()
				self.App.show("Shop")
			end,
		})
	end
end

return Profile
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="95">
              <Properties>
                <string name="Name">Race</string>
                <string name="Source"><![CDATA[-- The race screen. Everything competitive is decided by the server; this screen renders the
-- current page, the meter, the clock and opponents, and sends navigation requests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Difficulty = require(Shared.Difficulty)
local Format = require(Shared.Format)
local Temperature = require(Shared.Temperature)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local WikiBrowser = require(UI.Components.WikiBrowser)
local TemperatureMeter = require(UI.Components.TemperatureMeter)
local PlayerList = require(UI.Components.PlayerList)
local Reveal = require(UI.Overlays.Reveal)
local ChaosMenu = require(UI.Overlays.ChaosMenu)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local Race = {}
Race.__index = Race

local SIDEBAR_WIDTH = 300

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

function Race.new(App)
	local self = setmetatable({ App = App, pending = false, round = nil, state = nil }, Race)
	local frame = Kit.frame({ Name = "Race", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	-- Top bar ------------------------------------------------------------------------------
	local top = Kit.panel(
		{ Name = "TopBar", Size = UDim2.new(1, -24, 0, 76), Position = UDim2.fromOffset(12, 10), Parent = frame },
		nil,
		"surface"
	)
	self.top = top
	local left = Kit.frame(
		{ Size = UDim2.new(0.3, 0, 1, 0), Parent = top },
		{ Kit.padding(10, 12, 10, 12), Kit.list("y", 6, "Left", "Center") }
	)
	self.roundChip = Kit.chip("Round 1/3", nil, { Parent = left, order = 1, height = 26, textSize = 14 })
	self.difficultyChip = Kit.chip("Easy", nil, { Parent = left, order = 2, height = 26, textSize = 14 })

	local center = Kit.frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.36, 0),
		Size = UDim2.new(0.16, 0, 1, 0),
		Parent = top,
	}, { Kit.list("y", 0, "Center", "Center") })
	self.timer = Kit.text({
		text = "5:00",
		style = "title",
		size = 34,
		font = "fontMono",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 38),
		Parent = center,
		order = 1,
	})
	self.timerCaption = Kit.text({
		text = "remaining",
		style = "tiny",
		tone = "textFaint",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 14),
		Parent = center,
		order = 2,
	})

	local targetCard = Kit.panel({
		Name = "Target",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.45, 0, 0.5, 0),
		Size = UDim2.new(0.24, 0, 0, 58),
		Parent = top,
	}, nil, "surface2")
	self.targetCard = targetCard
	Kit.stroke("danger", 2, 0.2).Parent = targetCard
	self.targetEmoji = Kit.text({
		text = "🎯",
		size = 30,
		align = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(46, 58),
		Parent = targetCard,
	})
	Kit.text({
		text = "🎯 TARGET",
		style = "tiny",
		tone = "danger",
		font = "fontHeavy",
		Size = UDim2.new(1, -56, 0, 14),
		Position = UDim2.fromOffset(50, 8),
		Parent = targetCard,
	})
	self.targetTitle = Kit.text({
		text = "…",
		style = "h3",
		size = 17,
		truncate = true,
		wrap = false,
		Size = UDim2.new(1, -56, 0, 26),
		Position = UDim2.fromOffset(50, 24),
		Parent = targetCard,
	})
	Kit.hoverable(targetCard, function()
		self:showTargetInfo()
	end)

	self.meter = TemperatureMeter.new(top, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0.29, -12, 0, 60),
		onState = function(state, info)
			self:_onTemperature(state, info)
		end,
	})

	self.sidebarToggle = Kit.iconButton("👥", function()
		self:toggleSidebar()
	end, {
		Parent = top,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.3, -50, 1, -8),
		Size = UDim2.fromOffset(40, 36),
	})

	-- Main area ---------------------------------------------------------------------------
	local main = Kit.frame({
		Name = "Main",
		Position = UDim2.fromOffset(12, 96),
		Size = UDim2.new(1, -24, 1, -106),
		Parent = frame,
	})
	self.main = main
	self.browserHolder =
		Kit.frame({ Name = "BrowserHolder", Size = UDim2.new(1, -(SIDEBAR_WIDTH + 12), 1, 0), Parent = main })
	self.browser = WikiBrowser.new(self.browserHolder, {
		mode = "race",
		onLink = function(pageId)
			self:navigate("link", pageId)
		end,
		onBack = function()
			self:navigate("back")
		end,
		onForward = function()
			self:navigate("forward")
		end,
		onRefresh = function()
			self:navigate("refresh")
		end,
		onHistory = function(pageId)
			self:navigate("history", pageId)
		end,
	})

	local sidebar = Kit.panel({
		Name = "Sidebar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0),
		ZIndex = 10,
		Parent = main,
	}, { Kit.padding(10) })
	sidebar.BackgroundTransparency = 0
	self.sidebar = sidebar
	Kit.text({ text = "Racers", style = "h3", Size = UDim2.new(1, 0, 0, 24), Parent = sidebar })
	self.playerList = PlayerList.new(sidebar, {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 1, -230),
		onInspect = function(userId)
			App.show("Profile", { userId = userId })
		end,
	})
	local mine = Kit.panel({
		Name = "Mine",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 190),
		Parent = sidebar,
	}, { Kit.padding(10), Kit.list("y", 8) }, "surface2")
	local statsRow = Kit.frame(
		{ Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = mine },
		{ Kit.list("x", 6, "Center", "Center") }
	)
	self.clicksStat = self:_stat(statsRow, "🖱", "Clicks", 1)
	self.redosStat = self:_stat(statsRow, "♻", "Redos", 2)
	self.startStat = self:_stat(statsRow, "📄", "Start", 3)
	self.restartButton = Kit.button({
		text = "Restart route (1 redo)",
		emoji = "↺",
		Size = UDim2.new(1, 0, 0, 38),
		textSize = 14,
		Parent = mine,
		order = 2,
		onClick = function()
			self:navigate("restart")
		end,
	})
	self.giveUpButton = Kit.button({
		text = "Give up",
		emoji = "🏳️",
		variant = "danger",
		Size = UDim2.new(1, 0, 0, 38),
		textSize = 14,
		Parent = mine,
		order = 3,
		onClick = function()
			self:giveUp()
		end,
	})
	local extra = Kit.frame(
		{ Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 4, Parent = mine },
		{ Kit.list("x", 6, "Center", "Center") }
	)
	self.rigButton = Kit.button({
		text = "Rig",
		emoji = "🤡",
		Size = UDim2.new(0.5, -3, 1, 0),
		textSize = 13,
		Parent = extra,
		order = 1,
		onClick = function()
			ChaosMenu.rigPlayer(App)
		end,
	})
	self.endButton = Kit.button({
		text = "End match",
		emoji = "⏹",
		Size = UDim2.new(0.5, -3, 1, 0),
		textSize = 13,
		Parent = extra,
		order = 2,
		onClick = function()
			App.confirm(
				"End the match?",
				"The current round will finish now and final results will be shown.",
				"End match",
				function()
					App.request(Net.Actions.EndMatch, {})
				end,
				"danger"
			)
		end,
	})

	-- Banner (finished / spectating / generating)
	self.banner = Kit.panel({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 100),
		Size = UDim2.fromOffset(520, 64),
		Visible = false,
		ZIndex = 30,
		Parent = frame,
	}, { Kit.padding(10) }, "surface2")
	self.bannerText = Kit.text({
		text = "",
		style = "h2",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = self.banner,
		ZIndex = 31,
	})

	self.vignette = Fx.vignette(frame)

	App.layoutChanged:Connect(function(compact)
		self:_layout(compact)
	end)
	self:_layout(App.compact)

	RunService.Heartbeat:Connect(function()
		if frame.Visible then
			self:_tickTimer()
		end
	end)
	return self
end

function Race:_stat(parent, emoji: string, caption: string, order: number)
	local holder = Kit.frame(
		{ Size = UDim2.new(1 / 3, -4, 1, 0), LayoutOrder = order, Parent = parent },
		{ Kit.list("y", 0, "Center", "Center") }
	)
	local value = Kit.text({
		text = emoji .. " 0",
		style = "h3",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = holder,
		order = 1,
	})
	Kit.text({
		text = caption,
		style = "tiny",
		tone = "textFaint",
		align = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 14),
		Parent = holder,
		order = 2,
	})
	return value
end

function Race:_layout(compact: boolean)
	self.compact = compact
	self.sidebarToggle.Visible = compact
	if compact then
		self.browserHolder.Size = UDim2.fromScale(1, 1)
		self.sidebar.Visible = self.sidebarOpen == true
		self.sidebar.Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0)
	else
		self.browserHolder.Size = UDim2.new(1, -(SIDEBAR_WIDTH + 12), 1, 0)
		self.sidebar.Visible = true
	end
end

function Race:toggleSidebar()
	self.sidebarOpen = not self.sidebarOpen
	self.sidebar.Visible = self.sidebarOpen
	if self.sidebarOpen then
		Anim.slideIn(self.sidebar, UDim2.fromOffset(80, 0), 0.25)
	end
end

function Race:_showBanner(text: string?, token: string?)
	if not text then
		self.banner.Visible = false
		return
	end
	self.bannerText.Text = text
	Theme.bind(self.bannerText, { TextColor3 = token or "text" })
	self.banner.Visible = true
	Anim.punchIn(self.banner, 0.8)
end

function Race:_onTemperature(state: string, info)
	if not self.vignette then
		return -- the meter reports its initial state before the screen finishes building
	end
	if state == "Burning" then
		self.vignette:set(info.color, 0.55)
	elseif state == "Hot" then
		self.vignette:set(info.color, 0.25)
	elseif state == "Completed" then
		self.vignette:set(info.color, 0.35)
	else
		self.vignette:set(info.color, 0)
	end
end

function Race:_tickTimer()
	local round = self.round
	if not round then
		return
	end
	local now = serverNow()
	if now < round.raceStartAt then
		local limit = round.endsAt and (round.endsAt - round.raceStartAt) or nil
		self.timer.Text = limit and Format.clock(limit) or "∞"
		self.timerCaption.Text = "get ready"
		return
	end
	if self.state and (self.state.completed or self.state.gaveUp) then
		self.timerCaption.Text = self.state.completed and "finished" or "gave up"
		if self.state.finishTime then
			self.timer.Text = Format.time(self.state.finishTime)
		end
		return
	end
	local closingAt = self.closingAt
	if round.endsAt then
		local remaining = math.max(0, round.endsAt - now)
		self.timer.Text = Format.clock(remaining)
		self.timerCaption.Text = "remaining"
		local urgent = remaining <= 15
		Theme.bind(self.timer, { TextColor3 = urgent and "danger" or "text" })
		local second = math.ceil(remaining)
		if urgent and second ~= self.lastTickSecond and remaining > 0 then
			self.lastTickSecond = second
			Sound.play("tick", { pitch = 1 + (15 - second) * 0.03 })
			Anim.pop(self.timer, 1.08)
		end
	elseif closingAt then
		local remaining = math.max(0, closingAt - now)
		self.timer.Text = Format.clock(remaining)
		self.timerCaption.Text = "closing!"
		Theme.bind(self.timer, { TextColor3 = "danger" })
	else
		self.timer.Text = Format.clock(now - round.raceStartAt)
		self.timerCaption.Text = "elapsed · unlimited"
		Theme.bind(self.timer, { TextColor3 = "text" })
	end
end

function Race:showTargetInfo()
	local round = self.round
	if not round then
		return
	end
	local target = round.target
	self.App.modal({
		title = "🎯 " .. target.title,
		build = function(body)
			Kit.chip(target.category, nil, { Parent = body })
			Kit.text({
				text = target.blurb or "",
				style = "body",
				tone = "textDim",
				Size = UDim2.new(1, 0, 0, 0),
				auto = Enum.AutomaticSize.Y,
				Parent = body,
			})
			Kit.text({
				text = "Reach this article by clicking links. The meter heats up as you get closer.",
				style = "tiny",
				tone = "textFaint",
				Parent = body,
			})
		end,
		buttons = { { text = "Got it", variant = "primary" } },
	})
end

function Race:setTarget(preview)
	self.round.target = preview
	self.targetTitle.Text = preview.title
	self.targetEmoji.Text = preview.emoji or "🎯"
	Store.rememberTitle(preview.id, preview.title)
end

function Race:setDifficulty(key: string)
	local def = Difficulty.get(key)
	self.difficultyChip.Text = def.emoji .. " " .. def.name
	self.difficultyChip.BackgroundColor3 = def.color
	self.difficultyChip.TextColor3 = Color3.fromRGB(20, 20, 20)
	Theme.unbind(self.difficultyChip)
end

function Race:onGenerating(data)
	self.App.show("Race")
	self:_showBanner(("🎲 Generating round %d…"):format(data.round), "textDim")
end

function Race:onRoundStart(data)
	self.App.show("Race")
	self:_showBanner(nil)
	self.round = {
		index = data.round,
		totalRounds = data.totalRounds,
		raceStartAt = data.raceStartAt,
		endsAt = data.endsAt,
		start = data.start,
		target = data.target,
		difficulty = data.difficulty,
		solo = data.solo,
	}
	self.closingAt = nil
	self.lastTickSecond = nil
	self.roundChip.Text = data.totalRounds == 0 and ("Round %d · ∞"):format(data.round)
		or ("Round %d/%d"):format(data.round, data.totalRounds)
	self:setDifficulty(data.difficulty)
	self:setTarget(data.target)
	self.startStat.Text = "📄 " .. string.sub(data.start.title, 1, 10)
	local profile = Store.profile
	self.browser:setTransition(profile and profile.equipped and profile.equipped.transition)
	self.meter:setEffect(profile and profile.equipped and profile.equipped.meter)
	self.playerList:setPlayers(data.players)
	self.browser:setPage(data.page, "none")
	self:applyState(data.state, false)
	self.browser:setInteractive(false)
	local me = Players.LocalPlayer.UserId
	self.endButton.Visible = Store.lobby ~= nil and Store.lobby.hostId == me and not data.solo
	self.rigButton.Visible = not data.solo and #data.players > 1
	Reveal.play(self.App, data, function()
		self.browser:setInteractive(not (self.state and self.state.finished))
	end)
end

function Race:applyState(state, animate: boolean?)
	if not state then
		return
	end
	local previous = self.state
	self.state = state
	if state.temperature then
		self.meter:set(state.temperature, animate ~= false)
	end
	self.browser:setNav({
		canBack = state.canBack,
		canForward = state.canForward,
		history = state.history,
		redosLeft = state.redosLeft,
	})
	if previous and state.clicks ~= previous.clicks then
		Anim.pop(self.clicksStat, 1.2)
	end
	self.clicksStat.Text = "🖱 " .. state.clicks
	self.redosStat.Text = "♻ "
		.. state.redosUsed
		.. (state.redosLeft >= 0 and ("/" .. (state.redosUsed + state.redosLeft)) or "")
	local canRedo = state.redosLeft ~= 0 and not state.atStart and not state.finished
	Kit.setDisabled(self.restartButton, not canRedo)
	Kit.setDisabled(self.giveUpButton, state.finished)
	if state.completed and not (previous and previous.completed) then
		self:_celebrate(state)
	elseif state.gaveUp and not (previous and previous.gaveUp) then
		self.browser:setInteractive(false)
		self:_showBanner("🏳️ You gave up — watching the others finish", "textDim")
	end
end

function Race:_celebrate(state)
	self.browser:setInteractive(false)
	Sound.play("complete")
	Fx.burst(self.App.fx, { count = 70, maxDistance = 420 })
	Fx.flash(self.frame, Temperature.Info.Completed.color, 0.6, 0.5)
	self:_showBanner(
		("🏁 TARGET REACHED in %s · %d clicks"):format(Format.time(state.finishTime), state.clicks),
		"success"
	)
end

function Race:navigate(op: string, pageId: string?)
	if self.pending or not self.round then
		return
	end
	if serverNow() < self.round.raceStartAt then
		return
	end
	if op == "restart" or (op == "history") then
		-- These spend a redo; make it explicit.
		if self.state and self.state.redosLeft == 0 then
			self.App.toast("You're out of redos!", "error")
			return
		end
	end
	self.pending = true
	self.browser:setLoading(true)
	task.spawn(function()
		local ok, data = Net.request(Net.Actions.Navigate, { op = op, pageId = pageId })
		self.pending = false
		self.browser:setLoading(false)
		if not ok then
			self.App.toast(data, "error")
			if op ~= "refresh" then
				Anim.shake(self.browserHolder, 5, 0.25)
			end
			return
		end
		self.browser:setPage(data.page, (op == "back" or op == "history" or op == "restart") and "back" or "forward")
		if op == "back" or op == "history" or op == "restart" then
			Sound.play("back")
		end
		self:applyState(data.state, true)
	end)
end

function Race:giveUp()
	local def = self.round and Difficulty.get(self.round.difficulty)
	local message = (def and def.giveUpMode)
			and "Give Up Mode doesn't penalize surrender. Your closest distance still counts."
		or "You'll keep partial points for how close you got (halved for giving up)."
	self.App.confirm("Give up this round?", message, "🏳️ Give up", function()
		task.spawn(function()
			local ok, data = Net.request(Net.Actions.GiveUp, {})
			if ok then
				Sound.play("tempDown")
				self:applyState(data.state, true)
			else
				self.App.toast(data, "error")
			end
		end)
	end, "danger")
end

function Race:onOpponents(data)
	self.playerList:update(data.rows)
	if self.round then
		self.round.endsAt = data.endsAt
	end
	self.closingAt = data.closingAt
end

function Race:onClosing(data)
	self.closingAt = data.closesAt
	if not (self.state and self.state.finished) then
		self.App.toast("⏳ Half the lobby has finished — the round closes in 90 seconds!", "finish")
	end
end

function Race:onRigged(data)
	if not self.round then
		return
	end
	self.round.endsAt = data.endsAt
	self.round.difficulty = data.difficulty
	self:setDifficulty(data.difficulty)
	self:setTarget(data.target)
	Anim.shake(self.targetCard, 12, 0.8)
	Fx.flash(self.targetCard, Color3.fromRGB(255, 40, 40), 0.8, 0.9)
	Anim.pop(self.targetCard, 1.25)
	if data.state then
		self:applyState(data.state, true)
	end
end

function Race:hide()
	self.vignette:set(Color3.new(0, 0, 0), 0, 0.1)
end

return Race
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="96">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[-- Player settings (saved to the profile on the server).

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)

local Settings = {}
Settings.__index = Settings

function Settings.new(App)
	local self = setmetatable({ App = App, controls = {} }, Settings)
	local frame = Kit.frame({ Name = "Settings", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame
	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 50), Position = UDim2.fromOffset(24, 14), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Back",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			App.back("Menu")
		end,
	})
	Kit.text({ text = "⚙️ Settings", style = "title", Size = UDim2.fromOffset(300, 44), Parent = header, order = 2 })

	local panel = Kit.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.new(0, 640, 1, -100),
		Parent = frame,
	}, { Kit.padding(20) })
	local scroll = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = panel }, { Kit.list("y", 14) })

	Kit.text({ text = "Sound effects volume", style = "h3", Parent = scroll, order = 1 })
	self.controls.sfx = Kit.segmented(
		{
			{ value = 0, label = "🔇 Off" },
			{ value = 0.25, label = "25%" },
			{ value = 0.5, label = "50%" },
			{ value = 0.8, label = "80%" },
			{ value = 1, label = "100%" },
		},
		0.8,
		function(value)
			Sound.setVolume(value)
			Sound.play("tempUp")
			self:save({ sfx = value })
		end,
		{ Parent = scroll, order = 2 }
	)

	local function toggleRow(order: number, key: string, title: string, hint: string)
		local row = Kit.frame({ Size = UDim2.new(1, 0, 0, 50), LayoutOrder = order, Parent = scroll })
		Kit.text({ text = title, style = "h3", Size = UDim2.new(1, -80, 0, 24), Parent = row })
		Kit.text({
			text = hint,
			style = "small",
			tone = "textDim",
			Size = UDim2.new(1, -80, 0, 20),
			Position = UDim2.fromOffset(0, 26),
			Parent = row,
		})
		local toggle = Kit.toggle(true, function(value)
			self:save({ [key] = value })
		end, { Parent = row })
		toggle.frame.AnchorPoint = Vector2.new(1, 0.5)
		toggle.frame.Position = UDim2.new(1, 0, 0.5, 0)
		self.controls[key] = toggle
	end
	toggleRow(
		3,
		"jumpscares",
		"Allow incoming jumpscares",
		"When off, jumpscares sent to you become a harmless warning."
	)
	toggleRow(4, "chaos", "Allow targeted chaos", "When off, nobody can rig you with gag effects.")
	toggleRow(5, "reducedMotion", "Reduced motion", "Shorter animations, fewer particles, no screen shake.")
	toggleRow(6, "hints", "Show hints", "Tips during your first races.")

	Kit.divider(7).Parent = scroll
	Kit.text({ text = "How to play", style = "h3", Parent = scroll, order = 8 })
	Kit.text({
		text = "• You get a start page and a target page.\n• Click links inside articles to travel. Search is disabled during races.\n• The meter shows how many links away you are: Freezing (5+), Cold (4), Warm (3), Hot (2), Burning (the target is linked on this page!).\n• Back, jumping through History, and Restart each use a redo.\n• Score blends placement, speed, route efficiency, redos and difficulty.",
		style = "small",
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 0),
		auto = Enum.AutomaticSize.Y,
		Parent = scroll,
		order = 9,
	})
	return self
end

function Settings:show()
	local settings = Store.profile and Store.profile.settings or {}
	self.controls.sfx.set(settings.sfx or 0.8)
	for _, key in { "jumpscares", "chaos", "reducedMotion", "hints" } do
		if settings[key] ~= nil then
			self.controls[key].set(settings[key])
		end
	end
end

function Settings:save(patch)
	task.spawn(function()
		local ok, err = Net.request(Net.Actions.UpdateSettings, patch)
		if not ok then
			self.App.toast(err, "error")
		end
	end)
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="97">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[-- Cosmetic shop: categories, item grid, live preview, price, ownership and equipped state,
-- plus a Robux tab for game passes, coin packs and chaos products.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("WikiRaceShared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Achievements = require(Shared.Achievements)
local Format = require(Shared.Format)
local Temperature = require(Shared.Temperature)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Themes = require(UI.Themes)
local Anim = require(UI.Anim)
local Fx = require(UI.Fx)
local Net = require(UI.Parent.Core.Net)
local Store = require(UI.Parent.Core.Store)
local Sound = require(UI.Parent.Core.Sound)
local ChaosMenu = require(UI.Overlays.ChaosMenu)

local Shop = {}
Shop.__index = Shop

local TAB_EMOJI = {
	UI = "🎨",
	Profile = "🖼️",
	Victory = "🏆",
	Lobby = "🌌",
	Effects = "✨",
	Sounds = "🔊",
	Badges = "🏅",
	Titles = "🏷️",
	Robux = "💎",
}

function Shop.new(App)
	local self = setmetatable({ App = App, category = "UI", selected = nil }, Shop)
	local frame = Kit.frame({ Name = "Shop", Size = UDim2.fromScale(1, 1), Parent = App.root })
	self.frame = frame

	local header = Kit.frame(
		{ Size = UDim2.new(1, -48, 0, 50), Position = UDim2.fromOffset(24, 14), Parent = frame },
		{ Kit.list("x", 10, "Left", "Center") }
	)
	Kit.button({
		text = "Back",
		emoji = "←",
		Size = UDim2.fromOffset(110, 44),
		Parent = header,
		order = 1,
		onClick = function()
			App.back("Menu")
		end,
	})
	Kit.text({ text = "🛍️ Shop", style = "title", Size = UDim2.fromOffset(200, 44), Parent = header, order = 2 })
	self.coins = Kit.chip("🪙 0", nil, { Parent = header, order = 3, height = 36, textSize = 17 })
	Kit.text({
		text = "Everything here is cosmetic. Stats can't be bought.",
		style = "small",
		tone = "textFaint",
		Size = UDim2.fromOffset(340, 20),
		Parent = header,
		order = 4,
	})

	local tabs = Kit.scroll(
		{ axis = "x", Position = UDim2.fromOffset(24, 72), Size = UDim2.new(1, -48, 0, 46), Parent = frame, bar = 0 },
		{ Kit.list("x", 6, "Left", "Center") }
	)
	self.tabButtons = {}
	local tabNames = table.clone(Catalog.ShopCategories)
	table.insert(tabNames, "Robux")
	for index, name in tabNames do
		local button = Kit.button({
			text = name,
			emoji = TAB_EMOJI[name],
			Size = UDim2.fromOffset(118, 40),
			textSize = 14,
			order = index,
			Parent = tabs,
			onClick = function()
				self.category = name
				self.selected = nil
				self:render()
			end,
		})
		self.tabButtons[name] = button
	end

	local body = Kit.frame({ Position = UDim2.fromOffset(24, 126), Size = UDim2.new(1, -48, 1, -136), Parent = frame })
	self.grid = Kit.scroll(
		{ Size = UDim2.new(0.62, -8, 1, 0), Parent = body },
		{ Kit.grid(UDim2.fromOffset(170, 150), 10), Kit.padding(4) }
	)
	self.preview = Kit.panel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.38, -8, 1, 0),
		Parent = body,
	}, { Kit.padding(16) })

	Store.changed:Connect(function(key)
		if key == "profile" and frame.Visible then
			self:render()
		end
	end)
	return self
end

function Shop:show()
	self:render()
end

local function itemStatus(App, item)
	local profile = Store.profile
	local equipped = profile and profile.equipped and profile.equipped[item.slot] == item.id
	if equipped then
		return "equipped"
	elseif App.owns(item.id) then
		return "owned"
	elseif item.requires then
		return "pass"
	elseif item.achievement then
		return "achievement"
	end
	return "buy"
end

local function previewVisual(parent, item)
	local box = Kit.make("Frame", {
		Size = UDim2.new(1, 0, 0, 150),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = 1,
		Parent = parent,
		Theme = { BackgroundColor3 = "surface2" },
	}, { Kit.corner() })
	local slot = item.slot
	if slot == "theme" then
		local t = Themes[item.theme]
		box.BackgroundColor3 = t.bg
		local mock = Kit.make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0.86, 0, 0.78, 0),
			BackgroundColor3 = t.article,
			BorderSizePixel = 0,
			Parent = box,
		}, { Kit.corner(t.corner) })
		Kit.make(
			"Frame",
			{ Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = t.surface2, BorderSizePixel = 0, Parent = mock },
			{ Kit.corner(t.corner) }
		)
		Kit.make("TextLabel", {
			Text = "Pizza",
			Font = t.fontHeading,
			TextSize = 20,
			TextColor3 = t.heading,
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(10, 26),
			Size = UDim2.new(1, -20, 0, 24),
			Parent = mock,
		})
		Kit.make("TextLabel", {
			RichText = true,
			Text = ('A flat bread from <font color="#%s"><u>Naples</u></font>, <font color="#%s"><u>Italy</u></font>.'):format(
				t.link:ToHex(),
				t.link:ToHex()
			),
			Font = t.fontBody,
			TextSize = 14,
			TextColor3 = t.articleText,
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(10, 52),
			Size = UDim2.new(1, -20, 0, 20),
			Parent = mock,
		})
		Kit.make("Frame", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -10, 1, -8),
			Size = UDim2.fromOffset(70, 20),
			BackgroundColor3 = t.accent,
			BorderSizePixel = 0,
			Parent = mock,
		}, { Kit.corner(t.corner) })
	elseif slot == "frame" or slot == "title" or slot == "badge" then
		local me = Players.LocalPlayer
		local look = {
			frame = slot == "frame" and item.id or nil,
			title = slot == "title" and item.text or nil,
			badge = slot == "badge" and item.glyph or nil,
		}
		Kit.avatar(
			me.UserId,
			84,
			look,
			{ Parent = box, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10) }
		)
		local nameBlock = Kit.nameBlock(
			me.DisplayName,
			look,
			{ Parent = box, hAlign = "Center", align = Enum.TextXAlignment.Center, Size = UDim2.new(1, -20, 0, 40) }
		)
		nameBlock.Position = UDim2.new(0, 10, 0, 100)
	elseif slot == "meter" then
		local info = Temperature.Info.Burning
		Kit.text({
			text = "☄️ BURNING",
			style = "h2",
			color = info.color,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(0, 50),
			Parent = box,
		})
		Fx.emitter(box, { glyph = item.particle, colors = { info.color, info.glow }, rate = 20, lifetime = 1 })
	elseif slot == "cursor" or slot == "victory" or slot == "podium" or slot == "lobbyBg" or slot == "transition" then
		Kit.text({
			text = TAB_EMOJI[item.category] or "✨",
			size = 56,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = box,
		})
	elseif slot == "sound" then
		Kit.text({
			text = "🔊",
			size = 56,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = box,
		})
	end
	return box
end

local function demo(box, item)
	if item.slot == "victory" then
		if item.emojis then
			Fx.rain(box, { glyphs = item.emojis, duration = 1.5, rate = 30, minSize = 16, maxSize = 24 })
		else
			Fx.burst(box, { count = 40, maxDistance = 140 })
		end
	elseif item.slot == "podium" then
		Fx.rain(box, { glyphs = item.id == "podium_goldrain" and { "🪙" } or { "✦" }, duration = 1.5, rate = 20 })
	elseif item.slot == "cursor" then
		Fx.burst(box, { count = 20, glyphs = { item.glyph or "✦" }, maxDistance = 100 })
	elseif item.slot == "sound" then
		local previous = Store.profile and Store.profile.equipped and Store.profile.equipped.sound
		Sound.setPack(item.id)
		Sound.play("tempUp")
		task.delay(0.25, function()
			Sound.play("burning")
			task.delay(0.6, function()
				Sound.setPack(previous)
			end)
		end)
	elseif item.slot == "transition" then
		local scale = Anim.scaleOf(box)
		scale.Scale = 0.85
		Anim.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	elseif item.slot == "lobbyBg" then
		Fx.emitter(box, { colors = { Color3.new(1, 1, 1) }, direction = "down", rate = 10, lifetime = 2 })
	end
end

function Shop:_renderPreview(item)
	local App = self.App
	local panel = self.preview
	for _, child in panel:GetChildren() do
		if child:IsA("GuiObject") or child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	Kit.list("y", 10).Parent = panel
	if not item then
		Kit.text({ text = "Select an item to preview it.", style = "h3", tone = "textDim", Parent = panel })
		return
	end
	local box = previewVisual(panel, item)
	Kit.text({ text = item.name, style = "h1", size = 24, Parent = panel, order = 2 })
	Kit.chip(Catalog.Slots[item.slot].name, nil, { Parent = panel, order = 3 })
	Kit.text({
		text = item.description,
		style = "body",
		tone = "textDim",
		Size = UDim2.new(1, 0, 0, 44),
		Parent = panel,
		order = 4,
	})
	if item.slot ~= "theme" and item.slot ~= "frame" and item.slot ~= "title" and item.slot ~= "badge" then
		Kit.button({
			text = "Preview",
			emoji = "▶",
			Size = UDim2.new(1, 0, 0, 40),
			Parent = panel,
			order = 5,
			onClick = function()
				demo(box, item)
			end,
		})
	end
	local status = itemStatus(App, item)
	local actionText, variant, handler
	if status == "equipped" then
		actionText, variant = "✓ Equipped", "success"
	elseif status == "owned" then
		actionText, variant = "Equip", "primary"
		handler = function(button)
			Kit.busy(button, true, "Equipping…")
			local ok, err = Net.request(Net.Actions.EquipItem, { itemId = item.id })
			Kit.busy(button, false)
			if ok then
				Sound.play("coin")
			else
				App.toast(err, "error")
			end
		end
	elseif status == "pass" then
		local pass = Config.GamePasses[item.requires]
		actionText, variant = ("Get %s · R$ %d"):format(pass.name, pass.price), "gold"
		handler = function()
			App.promptPass(item.requires)
		end
	elseif status == "achievement" then
		local def = Achievements.ById[item.achievement]
		actionText, variant = ("🔒 Unlock: %s"):format(def and def.name or "achievement"), "secondary"
	else
		actionText, variant = ("Buy · 🪙 %s"):format(Format.number(item.price)), "primary"
		handler = function(button)
			local coins = Store.profile and Store.profile.coins or 0
			if coins < item.price then
				App.toast(
					("You need %s more Wiki Coins. Earn them by racing!"):format(Format.number(item.price - coins)),
					"error"
				)
				return
			end
			Kit.busy(button, true, "Buying…")
			local ok, err = Net.request(Net.Actions.BuyItem, { itemId = item.id })
			Kit.busy(button, false)
			if ok then
				Sound.play("purchase")
				Fx.burst(box, { count = 30, glyphs = { "🪙", "✦" }, maxDistance = 140 })
				App.toast(item.name .. " unlocked & equipped!", "success")
			else
				App.toast(err, "error")
			end
		end
	end
	local action = Kit.button({
		text = actionText,
		variant = variant,
		textSize = 17,
		Size = UDim2.new(1, 0, 0, 50),
		Parent = panel,
		order = 6,
		onClick = function(button)
			if handler then
				handler(button)
			end
		end,
	})
	if status == "equipped" or status == "achievement" then
		Kit.setDisabled(action, true)
	end
end

function Shop:_itemCard(item, index: number)
	local status = itemStatus(self.App, item)
	local card = Kit.panel(
		{ LayoutOrder = index, Parent = self.grid },
		{ Kit.padding(10) },
		self.selected == item.id and "surface2" or "surface"
	)
	if self.selected == item.id then
		Kit.stroke("accent", 2, 0).Parent = card
	end
	local swatch = Kit.make(
		"Frame",
		{ Size = UDim2.new(1, 0, 0, 62), BorderSizePixel = 0, Parent = card, Theme = { BackgroundColor3 = "surface3" } },
		{ Kit.corner() }
	)
	if item.slot == "theme" then
		local t = Themes[item.theme]
		swatch.BackgroundColor3 = t.bg
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, t.bg),
			ColorSequenceKeypoint.new(0.5, t.accent),
			ColorSequenceKeypoint.new(1, t.accent2),
		})
		g.Parent = swatch
	elseif item.slot == "frame" then
		Kit.avatar(
			Players.LocalPlayer.UserId,
			50,
			{ frame = item.id },
			{ Parent = swatch, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }
		)
	else
		local glyph = item.glyph
			or item.particle
			or (item.emojis and item.emojis[1])
			or (item.text and "🏷️")
			or TAB_EMOJI[item.category]
			or "✨"
		Kit.text({
			text = glyph,
			size = 32,
			align = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = swatch,
		})
	end
	Kit.text({
		text = item.name,
		style = "h3",
		size = 15,
		truncate = true,
		wrap = false,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 20),
		Parent = card,
	})
	local statusText = ({
		equipped = "✓ Equipped",
		owned = "Owned",
		pass = "⭐ " .. (item.requires and Config.GamePasses[item.requires].name or ""),
		achievement = "🔒 Achievement",
		buy = "🪙 " .. Format.number(item.price),
	})[status]
	Kit.text({
		text = statusText,
		style = "small",
		tone = status == "equipped" and "success" or (status == "buy" and "gold" or "textDim"),
		font = "fontBold",
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = card,
	})
	Kit.hoverable(card, function()
		self.selected = item.id
		self:render()
	end)
end

function Shop:_renderRobux()
	local App = self.App
	local index = 0
	local function card(emoji: string, title: string, description: string, priceText: string, owned: boolean, onBuy)
		index += 1
		local c = Kit.panel({ LayoutOrder = index, Parent = self.grid }, { Kit.padding(10), Kit.list("y", 4) })
		Kit.text({ text = emoji .. " " .. title, style = "h3", size = 15, Parent = c, order = 1 })
		Kit.text({
			text = description,
			style = "tiny",
			tone = "textDim",
			Size = UDim2.new(1, 0, 0, 44),
			Parent = c,
			order = 2,
		})
		local button = Kit.button({
			text = owned and "✓ Owned" or priceText,
			variant = owned and "success" or "gold",
			textSize = 14,
			Size = UDim2.new(1, 0, 0, 34),
			Parent = c,
			order = 3,
			onClick = function()
				if not owned then
					onBuy()
				end
			end,
		})
		if owned then
			Kit.setDisabled(button, true)
		end
	end
	for key, pass in Config.GamePasses do
		local info = Catalog.GamePassInfo[key]
		card(info.emoji, pass.name, info.tagline, "R$ " .. pass.price, App.hasPass(key), function()
			App.promptPass(key)
		end)
	end
	for _, key in { "Coins500", "Coins1500", "Coins5000" } do
		local product = Config.Products[key]
		card(
			"🪙",
			product.name,
			"Wiki Coins for cosmetics. Coins can't buy stats.",
			"R$ " .. product.price,
			false,
			function()
				App.purchaseProduct(key)
			end
		)
	end
	card(
		"🎰",
		"Server Rig",
		"Force every race on this server into Give Up Mode. Loud. Public. Chaotic.",
		"R$ " .. Config.Products.ServerRig.price,
		false,
		function()
			ChaosMenu.serverRig(App)
		end
	)
	card(
		"🤡",
		"Rig a Player",
		("One rig credit for a harmless gag on a friend. You have %d."):format(
			Store.profile and Store.profile.rigCredits or 0
		),
		"R$ " .. Config.Products.RigPlayer.price,
		false,
		function()
			App.purchaseProduct("RigPlayer")
		end
	)
	self:_renderPreview(nil)
	for _, child in self.preview:GetChildren() do
		if child:IsA("TextLabel") then
			child.Text = "Game passes are one-time purchases with cosmetic perks. VIP never changes race calculations."
		end
	end
	local vipInfo = Catalog.GamePassInfo.VIP
	for i, perk in vipInfo.perks do
		Kit.text({ text = "⭐ " .. perk, style = "small", Parent = self.preview, order = 10 + i })
	end
	for i, perk in Catalog.GamePassInfo.Jumpscares.perks do
		Kit.text({ text = "😱 " .. perk, style = "small", Parent = self.preview, order = 20 + i })
	end
end

function Shop:render()
	local profile = Store.profile
	self.coins.Text = "🪙 " .. Format.number(profile and profile.coins or 0)
	for name, button in self.tabButtons do
		local selected = name == self.category
		button.BackgroundTransparency = selected and 0 or 0.5
		button:SetAttribute("BaseTransparency", selected and 0 or 0.5)
	end
	for _, child in self.grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if self.category == "Robux" then
		self:_renderRobux()
		return
	end
	local selectedItem = nil
	local index = 0
	for _, item in Catalog.Items do
		if item.category == self.category then
			index += 1
			if not self.selected then
				self.selected = item.id
			end
			if self.selected == item.id then
				selectedItem = item
			end
			self:_itemCard(item, index)
		end
	end
	self:_renderPreview(selectedItem)
end

return Shop
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Theme controller. UI code binds instance properties to theme tokens once; changing theme
-- walks the bindings and re-applies values (tweened for colors) instead of rebuilding UI.

local TweenService = game:GetService("TweenService")

local Themes = require(script.Parent.Themes)
local Signal = require(game:GetService("ReplicatedStorage"):WaitForChild("WikiRaceShared").Signal)

local Theme = {}
Theme.current = Themes.classic
Theme.id = "classic"
Theme.changed = Signal.new()

local bindings = setmetatable({}, { __mode = "k" }) -- instance → { [property] = token | fn }

local function resolve(token)
	if type(token) == "function" then
		return token(Theme.current)
	end
	return Theme.current[token]
end

local function apply(instance: Instance, property: string, token, animate: boolean?)
	local value = resolve(token)
	if value == nil then
		return
	end
	if animate and typeof(value) == "Color3" then
		TweenService:Create(instance, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { [property] = value }):Play()
	else
		(instance :: any)[property] = value
	end
end

-- Theme.bind(label, { TextColor3 = "text", Font = "fontBold" })
-- A token may also be a function(theme) → value for derived styles.
function Theme.bind(instance: Instance, map)
	local entry = bindings[instance]
	if not entry then
		entry = {}
		bindings[instance] = entry
	end
	for property, token in map do
		entry[property] = token
		apply(instance, property, token, false)
	end
	return instance
end

function Theme.unbind(instance: Instance, property: string?)
	if property then
		local entry = bindings[instance]
		if entry then
			entry[property] = nil
		end
	else
		bindings[instance] = nil
	end
end

function Theme.get(token: string)
	return Theme.current[token]
end

function Theme.set(themeId: string)
	local nextTheme = Themes[themeId]
	if not nextTheme or themeId == Theme.id then
		return
	end
	Theme.current = nextTheme
	Theme.id = themeId
	for instance, entry in bindings do
		if instance.Parent then
			for property, token in entry do
				apply(instance, property, token, true)
			end
		end
	end
	Theme.changed:Fire(nextTheme)
end

return Theme
]]></string>
