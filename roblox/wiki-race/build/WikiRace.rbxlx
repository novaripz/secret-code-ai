	{
		title = "John Steinbeck",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "American writer and novelist (1902–1968)",
		tags = { "Americas", "US and Canada" },
		aliases = { "John Ernst Steinbeck" },
		summary = '**John Ernst Steinbeck** was an American writer and novelist. He won the 1962 Nobel Prize in Literature "for his realistic and imaginative writings, combining as they do sympathetic humor and keen social perception". He has been called "a giant of American letters". One of the most widely read authors of the 20th century, he was also an independent journalist and war correspondent during [[World War II]] and the Vietnam War.',
		sections = {
			{
				"Overview",
				"During his writing career, he authored 33 books, with one book coauthored alongside Edward Ricketts, including 16 novels, 6 non-fiction books, and 2 collections of short stories. He is widely known for the comic novels Tortilla Flat (1935) and Cannery Row (1945), the multigeneration epic East of Eden (1952), and the novellas The Red Pony (1933) and Of Mice and Men (1937). The [[Pulitzer Prize]]–winning [[The Grapes of Wrath]] (1939) is considered Steinbeck's [[Masterpiece|masterpiece]] and part of the [[Western canon|American literary canon]]. By the 75th anniversary of its publishing date, it had sold 14 million copies. Much of Steinbeck's work employs settings in his native central California, particularly in the Salinas Valley and the California Coast Ranges region. His works frequently explored the themes of fate and injustice, especially as applied to downtrodden or everyman [[Protagonist|protagonists]].",
			},
		},
		related = { "Edgar Allan Poe", "Robert A. Heinlein" },
		infobox = {
			{ "Born", "27 February 1902" },
			{ "Died", "20 December 1968" },
			{ "Birthplace", "Salinas, California, U.S." },
			{ "Education", "[[Stanford University]]" },
			{ "Occupation", "Novelist short story writer war correspondent" },
			{ "Notable works", "Of Mice and Men (1937) [[The Grapes of Wrath]] (1939) East of Eden (1952)" },
		},
	},
	{
		title = "John Stuart Mill",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "English politician and philosopher (1806–1873)",
		tags = { "Philosophers", "Modern" },
		summary = '**John Stuart Mill** (20 May 1806 – 7 May 1873) was an English [[Philosophy|philosopher]], political economist, and politician. He was a paradigmatic philosopher of [[Liberalism|liberalism]] and has been described as "the most influential English-speaking philosopher of the nineteenth century" by the [[Stanford Encyclopedia of Philosophy]]. He conceived of [[Liberty|liberty]] as justifying the freedom of the individual in opposition to unlimited state and [[Social control|social control]], and formulated the Harm principle. He also advocated proportional representation, the emancipation of women, and the development of labour organisations and farm cooperatives, and has been classified as both a [[Classical liberalism|Classical Liberal]] and Social Liberal.',
		sections = {
			{
				"Overview",
				"The Columbia Encyclopedia describes Mill as occasionally coming \"close to socialism, a theory repugnant to his predecessors\". He was a proponent of the [[Utilitarianism|utilitarianism]] of his predecessor [[Jeremy Bentham]], and contributed to the investigation of [[Scientific method|scientific methodology]]. A member of the Liberal Party and co-author of the early feminist work The Subjection of Women (1869), Mill was also the second [[Member of Parliament (United Kingdom)|Member of Parliament]] to call for [[Women's suffrage|women's suffrage]] after Henry Hunt in 1832. The contentions of his essay On Liberty (1859) remain highly influential: and a copy of the work is passed to the president of the Liberal Democrats (the successor party to Mill's own) as a symbol of office.",
			},
		},
		infobox = {
			{ "Born", "20 May 1806" },
			{ "Birthplace", "Pentonville, Middlesex, England" },
			{ "Died", "7 May 1873" },
			{ "Education", "[[University College London]]" },
		},
	},
	{
		title = "John von Neumann",
		category = "Person",
		fame = 2,
		emoji = "👤",
		source = "wikipedia",
		description = "Hungarian and American mathematician and physicist (1903–1957)",
		tags = { "Mathematicians", "Modern" },
		summary = "**John von Neumann** was a Hungarian and American mathematician, physicist, computer scientist and engineer. Von Neumann had perhaps the widest coverage of any mathematician of his time, integrating pure and [[Applied science|applied sciences]] and making major contributions to many fields, including [[Mathematics|mathematics]], [[Physics|physics]], [[Economics|economics]], [[Computing|computing]], and [[Statistics|statistics]]. He was a pioneer in building the mathematical framework of [[Quantum mechanics|quantum physics]], in the development of [[Functional analysis|functional analysis]], and in [[Game theory|game theory]], introducing or codifying concepts including cellular automata, the universal constructor and the [[Computer|digital computer]]. His analysis of the structure of self-replication preceded the discovery of the structure of [[DNA]].",
		sections = {
			{
				"Overview",
				"During [[World War II]], von Neumann worked on the Manhattan Project. At the peak of his influence in the 1950s, he chaired a number of [[United States Department of Defense|Defense Department]] committees including the Strategic Missile Evaluation Committee and the ICBM Scientific Advisory Committee. He was also a member of the influential Atomic Energy Commission in charge of all atomic energy development in the country. He played a key role alongside Bernard Schriever and Trevor Gardner in the design and development of the United States' first intercontinental ballistic missile (ICBM) programs. At that time he was considered the nation's foremost expert on nuclear weaponry and the leading defense scientist at the [[United States Department of Defense|U.S. Department of Defense]]. Von Neumann's contributions and intellectual ability drew praise from colleagues in physics, mathematics, and beyond.",
			},
		},
		infobox = {
			{ "Born", "28 December 1903" },
			{ "Birthplace", "[[Budapest]], Kingdom of Hungary, Austria-Hungary" },
			{ "Died", "8 February 1957" },
			{ "Citizenship", "Hungary, United States" },
			{
				"Education",
				"Pázmány Péter University, [[Humboldt University of Berlin|University of Berlin]], [[ETH Zurich|ETH Zürich]]",
			},
		},
	},
