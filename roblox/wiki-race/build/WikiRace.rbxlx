		fame = 1,
		emoji = "🧒",
		source = "wikipedia",
		description = "Human between birth and puberty",
		tags = { "Stages of life" },
		summary = "A **child** is a [[Human|human]] being between the stages of birth and puberty, or between the developmental period of infancy and puberty. The term may also refer to an unborn human being. Children generally have fewer rights and responsibilities than adults. They are generally classed as unable to make serious decisions.",
		sections = {
			{
				"Overview",
