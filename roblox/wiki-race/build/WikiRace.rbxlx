	{
		title = "Theaceae",
		category = "Plant",
		fame = 3,
		emoji = "👪",
		source = "wikipedia",
		description = "Family of flowering plants",
		tags = { "Eudicots", "Ericales" },
		summary = "**Theaceae**, the **tea** family, is a [[Family (taxonomy)|family]] of [[Flowering plant|flowering plants]] comprising shrubs and trees, including the economically important [[Tea|tea]] plant, and the ornamental camellias. It can be described as having from seven to 40 [[Genus|genera]], depending on the source and the method of circumscription used. The family Ternstroemiaceae has been included within Theaceae; however, the APG III system of 2009 places it instead in Pentaphylacaceae. Most but not all species are [[Native species|native]] to China and East Asia.",
		related = { "Brazil nut", "Kiwifruit" },
