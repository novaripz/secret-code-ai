		category = "Geography",
		fame = 2,
		emoji = "🌊",
		tags = { "Oceans" },
		aliases = { "Pacific" },
		summary = "The **Pacific Ocean** is the largest and deepest [[Ocean|ocean]], larger than all the land on Earth combined.",
		sections = {
			{
				"Features",
				"It contains the [[Mariana Trench]] and is ringed by volcanoes known as the Ring of Fire, which also causes many [[Tsunami|tsunamis]].",
			},
		},
		infobox = { { "Area", "165 million km²" }, { "Named by", "Ferdinand Magellan" } },
	},
	{
