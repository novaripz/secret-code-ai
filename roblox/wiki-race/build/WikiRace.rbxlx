	{
		title = "On the Origin of Species",
		category = "Book",
		fame = 2,
		emoji = "📖",
		source = "wikipedia",
		description = "1859 book on evolution by Charles Darwin",
		tags = { "Specific works of nonfiction", "Nonfiction of modern era" },
		summary = "**On the Origin of Species by Means of Natural Selection, or the Preservation of Favoured Races in the Struggle for Life** is a work of scientific literature by the English naturalist [[Charles Darwin]] that is considered to be the foundation of [[Evolutionary biology|evolutionary biology]]. It was published on 24 November 1859. Darwin's book introduced the [[Scientific theory|scientific theory]] that populations [[Evolution|evolve]] over the course of generations through a process of [[Evolution|natural selection]], although Lamarckism was also included as a mechanism of lesser importance. The book presented a body of evidence that [[Biodiversity|the diversity of life]] arose by [[Common descent|common descent]] through a branching pattern of evolution.",
		sections = {
			{
				"Overview",
				"Darwin included evidence that he had collected on the Beagle expedition in the 1830s and his subsequent findings from research, correspondence, and experimentation. Various evolutionary ideas had already been proposed to explain [[History of biology|new findings in biology]]. There was growing support for such ideas among dissident anatomists and the general public, but during the first half of the 19th century the English scientific establishment was closely tied to the Church of England, while science was part of natural theology. Ideas about the transmutation of species were controversial as they conflicted with the beliefs that species were unchanging parts of a designed hierarchy and that humans were unique, unrelated to other animals. The political and theological implications were intensely debated, but transmutation was not accepted by the scientific mainstream.",
			},
		},
		related = { "Quotations from Chairman Mao Tse-tung", "The Structure of Scientific Revolutions" },
		infobox = {
			{ "Author", "[[Charles Darwin]]" },
			{ "Country", "[[United Kingdom of Great Britain and Ireland]]" },
			{ "Language", "English" },
			{ "Published", "24 November 1859 (John Murray)" },
		},
	},
	{
