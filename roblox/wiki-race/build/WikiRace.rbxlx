		tags = { "Housing", "Rooms and spaces" },
		aliases = { "Bedchamber" },
		summary = "A **bedroom** or **bedchamber** is a [[Room|room]] situated within a residential or accommodation unit, primarily used for [[Sleep|sleeping]]. A typical [[Western world|Western]] bedroom contains as bedroom furniture one or two [[Bed|beds]], a clothes closet, and bedside table and dressing table, both of which usually contain drawers. In dwellings with multiple stories, bedrooms are often on the upper floors. Beds range from a crib for an infant; a single or twin bed for a toddler, child, teenager or single adult; to bigger sizes like a full, double, queen, king or California king). Beds and bedrooms are often devised to create barriers to insects and vermin, especially mosquitoes, and to dampen or contain light or noise to aid sleep and privacy.",
		related = { "Garage (residential)", "Sauna" },
