		description = "Region of lands around the Mediterranean Sea that have a Mediterranean climate",
		tags = { "More articles" },
		aliases = { "Mediterranean region", "Mediterranea" },
		summary = "In [[Biogeography|biogeography]], the **Mediterranean basin**, also known as the **Mediterranean region** or sometimes **Mediterranea**, is the region of lands around the [[Mediterranean Sea]] that mostly have a [[Mediterranean climate]], with mild to cool, rainy [[Winter|winters]] and warm to hot, dry [[Summer|summers]], which supports characteristic Mediterranean forests, woodlands, and scrub vegetation.",
	},
	{
		title = "Mekong",
		category = "Geography",
		fame = 3,
		emoji = "🏞️",
		source = "wikipedia",
		description = "Major river in Southeast Asia",
		tags = { "Rivers", "Asia" },
		aliases = { "Mekong River" },
		summary = "The **Mekong** or **Mekong River** is a transboundary river in [[East Asia]] and [[Southeast Asia]]. It is the world's twelfth-longest river and the third-longest in Asia with an estimated length of 4909 km and a drainage area of 795000 km², discharging 475 km³ of water annually. From its headwaters in the [[Tibetan Plateau]], the river runs through Southwest China (where it is officially called the **Lancang River**), [[Myanmar]], [[Laos]], [[Thailand]], [[Cambodia]], and southern Vietnam. The extreme seasonal variations in flow and the presence of [[Rapids|rapids]] and [[Waterfall|waterfalls]] in the Mekong make navigation difficult, though the river remains a major trade route between [[Tibet]] and Southeast Asia.",
		sections = {
			{
				"Overview",
