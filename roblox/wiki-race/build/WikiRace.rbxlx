	[5] = { decal = 116761622050320 },
	[6] = { decal = 103832052215043 },
	[7] = { decal = 70949545417213 },
	[8] = { decal = 95838803732210 },
	[9] = { decal = 87732457700810 },
	[10] = { decal = 72362685474573 },
	[11] = { decal = 77439807952661 },
	[12] = { decal = 105618077700977 },
	[13] = { decal = 115775519257227 },
	[14] = { decal = 98067582867638 },
	[15] = { decal = 126288355422536 },
	[16] = { decal = 81145412221152 },
	[17] = { decal = 97984239982699 },
	[18] = { decal = 100775360654078 },
	[19] = { decal = 135067039910595 },
	[20] = { decal = 92083405345198 },
	[21] = { decal = 98621176839750 },
	[22] = { decal = 138992216577523 },
