-- UI themes. Every themed property in the UI is bound to one of these token names, so
-- switching theme restyles the live UI without rebuilding anything. Themes are cosmetic only.

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local base = {
	corner = 12,
	strokeThickness = 1,
	surfaceTransparency = 0,
	pattern = "none",
	animated = false,
	font = Enum.Font.GothamMedium,
	fontBold = Enum.Font.GothamBold,
	fontHeavy = Enum.Font.GothamBlack,
	fontDisplay = Enum.Font.GothamBlack,
	fontBody = Enum.Font.SourceSans,
	fontBodyBold = Enum.Font.SourceSansBold,
	fontHeading = Enum.Font.Merriweather,
	fontMono = Enum.Font.RobotoMono,
	success = rgb(34, 197, 94),
	warning = rgb(245, 158, 11),
	danger = rgb(239, 68, 68),
	gold = rgb(250, 204, 21),
	silver = rgb(203, 213, 225),
	bronze = rgb(217, 119, 6),
}

local function theme(overrides)
	local t = table.clone(base)
	for k, v in overrides do
		t[k] = v
	end
	return t
end

