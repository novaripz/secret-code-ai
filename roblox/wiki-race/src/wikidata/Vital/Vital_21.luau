		tags = { "Asia", "Japan" },
		summary = "The **University of Tokyo** is a public research university in Bunkyō, Tokyo, Japan. Founded in 1877 as the nation's first modern university by the merger of several [[Edo period|pre-westernisation era]] institutions, its direct precursors include the Tenmongata, founded in 1684, and the Shōheizaka Institute.",
		sections = {
			{
