# Copy to .env.local and fill in what you use. Restart the server after changes.

# --- AI provider (at least one) -------------------------------------------
# Claude is the recommended engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=off          # disable server-side model fallbacks

# OpenAI-compatible providers (used when no Anthropic key is set, or when forced)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Force a provider: anthropic | openai | gemini | openrouter | groq
# AI_PROVIDER=

# --- Storage and execution ----------------------------------------------
# Where projects, snapshots and branches live on disk.
# DATA_DIR=.data
# Set to false to turn off running commands (npm, rojo, selene, ...) in project trees.
# ALLOW_COMMANDS=true
# Chromium for browser smoke tests and screenshots (auto-detected if unset).
# CHROMIUM_PATH=
# Origin the server uses to reach itself (defaults to http://127.0.0.1:$PORT).
# INTERNAL_ORIGIN=

# --- Roblox Open Cloud (optional) ----------------------------------------
# Needs universe-places:write for publishing and asset:write for uploads.
# ROBLOX_OPEN_CLOUD_API_KEY=

# --- Access control (optional) -------------------------------------------
# When set, every page and API requires this password.
# APP_PASSWORD=
# SESSION_SECRET=change-me-to-a-long-random-string
